SiiNunit
{
# For modders: Please do not modify this file if you want to add a new entry. Create in
# this directory a new file "<base_name>.<idofyourmod>.sii" where <base_name> is name of
# base file without the extension (e.g. "city" for "/def/city.sii") and <idofyourmod> is
# some string which is unlikely to conflict with other mod.

tr_semaphore_model : tr_sem_mdl.col_br_la
{
	name: "us la / column bridge"

	model_desc: "/asset/props/gate/la_movable_traffic_light.pmd"
	model_coll: "/asset/props/gate/la_movable_traffic_light.pmc"

	draw_distance: 500
}

tr_semaphore_model : tr_sem_mdl.la_monr_br
{
	name: "la_monroe_bridge_02_mov"
	model_desc: "/model/panorama/la_monroe/la_monroe_bridge_02_mov.pmd"

	draw_distance: 1500

	state_anim: 4
	state_anim[0]: ""																	# orange_to_red
	state_anim[1]: "/model/panorama/la_monroe/la_monroe_bridge_02_up_anim.pma" 			# red
	state_anim[2]: "/model/panorama/la_monroe/la_monroe_bridge_02_down_anim.pma" 		# orange_to_green
	state_anim[3]: "" 																	# green

	sounds[]: "OY|/sound/world/sounds/refs/artificial/machines/swing_bridge_loop_1.soundref"
	sounds[]: "OY|/sound/world/sounds/refs/artificial/machines/crane_3.soundref"
}

tr_semaphore_model : tr_sem_mdl.la_dr_br
{
	name: "la_draw_bridge_1-1_mov"
	model_desc: "/prefab/bridge/la_draw_bridge_1-1_mov.pmd"

	draw_distance: 1500

	state_anim: 4
	state_anim[0]: "/prefab/bridge/la_draw_bridge_1-1_up.pma" 							# orange_to_red
	state_anim[1]: ""																	# red
	state_anim[2]: "/prefab/bridge/la_draw_bridge_1-1_up.pma"							# orange_to_green
	state_anim[3]: ""																	# green

	sounds[]: "OY|/sound/world/sounds/refs/artificial/machines/swing_bridge_loop_1.soundref"
	sounds[]: "OY|/sound/world/sounds/refs/artificial/machines/crane_3.soundref"
}

}
