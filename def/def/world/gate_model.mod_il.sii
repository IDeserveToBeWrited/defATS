SiiNunit
{

## illinois gates ##

gate_model : gate_model.slide.sld_05
{
	# one animation, collision animated

	name: "slide_05_long_il"

	category: "slide"

	model_desc: "/model/barrier/metal/il_construction_fence_gate_ani.pmd"
	model_coll: "/model/barrier/metal/il_construction_fence_gate_ani.pmc"

	state_anim: 4

	# orange_to_red
	state_anim[0]: "/model/barrier/metal/il_construction_fence_gate_ani_open.pma"

	# red
	state_anim[1]: ""

	# orange_to_green
	state_anim[2]: "/model/barrier/metal/il_construction_fence_gate_ani_open.pma"

	# green
	state_anim[3]: ""

	#sound
	sounds[]: "OY|/sound/world/gate_iron.soundref"

	# approximate length of animation is 10.4, so we use interval overrides

	interval_overrides: 4
	interval_overrides[0]: 0.5 # green
	interval_overrides[1]: 5.0 # orange_to_red 
	interval_overrides[2]: 5.0 # red 
	interval_overrides[3]: 5.0 # orange_to_green
}

