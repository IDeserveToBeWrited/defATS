SiiNunit
{
ui_truck_scene_config : _nameless.config {

	icon_path:"/model/ui/empty_dark_scene.mat"
	scene_name: "@@truck_preference_screen@@"

	light_direction: (-1.5, -7.0, -1.5)
	light_ambient: (0.35, 0.35, 0.35)
	light_diffuse: (2.0, 2.0, 2.0)
	light_specular: (1.0, 1.0, 1.0)

	camera_aim: ( 0.0, 1.2, 0.090 )
	camera_elevation_limit: (-0.20, 0.0)

	camera_relative_bounds: (7.5, 7.5, 7.5)
	camera_aim_y_bounds: (-8.0, 10.0)

	mouse_rot_sens : 0.2
	camera_zoom_sens : 0.1
	camera_fov: 80

	camera_default_azimuth: -2.554
	camera_default_elevation: 0.0
	camera_default_zoom: -5.3
	camera_zoom_min : -7
	camera_zoom_max : -5.3

	truck_position: (0.0, 0.0, 0.0)

	scene_model_path: "/model/ui/dark_studio_shop.pmd"
	scene_cinematic_camera: "/def/camera/ui/carousel_shifted.sii"
	scene_model_look: "default"
	scene_model_variant: "c_cabin"
	
	scene_model_position:(0.0, 0.0, 0.0)
	
	floor_reflection: true

	vehicle_reflection: "/model/ui/texture/enviroment/dark_scene_ref.tobj"
	
	part_order[]: part2
		part_order[]: part1

	
@include "vehicle_pin_data.sui"
}
}
