# Dumper Empty

traffic_vehicle : traffic.dumper
{
	accessories[]: .dumper.chassis
	accessories[]: .dumper.fwheel
	accessories[]: .dumper.rwheel

	max_speed: 20

	tags[]: dumper

	vehicle_mass: 25000

	spawn_ratio: 0.2

	allow_parked: false

@include "drivers_generic.sui"

}

vehicle_accessory: .dumper.chassis
{
	data_path: "/def/vehicle/ai/dumper/chassis_empty.sii"
}

vehicle_wheel_accessory: .dumper.fwheel
{
	offset: 0
	data_path: "/def/vehicle/ai_wheel/front_dumper.sii"
}

vehicle_wheel_accessory: .dumper.rwheel
{
	offset: 0
	data_path: "/def/vehicle/ai_wheel/rear_dumper.sii"
}

