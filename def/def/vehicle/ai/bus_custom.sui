#XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX South Dakota | Sioux Falls City XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

traffic_vehicle : traffic.bus.city_24.sdsf
{
	accessories[]: .bus.city_24.sdsf.chassis
	accessories[]: .bus.city_24.sdsf.fwheel
	accessories[]: .bus.city_24.sdsf.rwheel

	max_speed: 100
	vehicle_mass: 16000
	engine_power: 200

	spawn_condition[]: .traffic.bus.city_24.sdsf.condition.city

	tags[]: bus
	tags[]: parked
	tags[]: context

	#driver
@include "drivers_generic.sui"

}

vehicle_accessory: .bus.city_24.sdsf.chassis
{
	data_path: "/def/vehicle/ai/bus_city_24/chassis_sdsf.sii"
}

vehicle_wheel_accessory: .bus.city_24.sdsf.fwheel
{
	offset: 0
	data_path: "/def/vehicle/ai_wheel/front_bus3.sii"
}

vehicle_wheel_accessory: .bus.city_24.sdsf.rwheel
{
	offset: 0
	data_path: "/def/vehicle/ai_wheel/rear_bus3.sii"
}

traffic_spawn_condition: .traffic.bus.city_24.sdsf.condition.city
 {
	# spawns only in specified city
	type: city
    	str_param[]: "sioux_falls"
 }