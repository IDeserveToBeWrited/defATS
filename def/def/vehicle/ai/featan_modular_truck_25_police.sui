	tags[]: highway

	spawn_condition[]: .traffic.featan.pickup.midclass_25.us_rg.condition

@include "drivers_police.sui"

}

traffic_spawn_condition: .traffic.featan.pickup.midclass_25.us_rg.condition
{
	type: area
