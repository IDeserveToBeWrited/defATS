# XXXXXXXXXXXXXXXXXXXXXXXXXXXX Park Ranger XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

traffic_vehicle : traffic.featan.pickup.midclass_25.us_rg
{
	accessories[]: .featan.pickup.midclass_25.us_rg.chassis
	accessories[]: .featan.pickup.midclass_25.us_rg.fwheel
	accessories[]: .featan.pickup.midclass_25.us_rg.rwheel

	max_speed: 160
	vehicle_mass: 2900
	spawn_ratio: 1.0


	sound_move[]: "/sound/traffic/car_v8_1.soundref"
	sound_move[]: "/sound/traffic/car_v8_2.soundref"
	sound_horn[]: "/sound/traffic/car_horn_4.soundref"

