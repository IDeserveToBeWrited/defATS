# XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX PICKUP_BED_LONG XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

traffic_vehicle : traffic.featan.pickup_long.midclass_25
{
	accessories[]: .featan.pickup_long.midclass_25.chassis
	accessories[]: .featan.pickup_long.midclass_25.fwheel
	accessories[]: .featan.pickup_long.midclass_25.rwheel

	max_speed: 160
	vehicle_mass: 2900

	sound_move[]: "/sound/traffic/car_v8_1.soundref"
	sound_move[]: "/sound/traffic/car_v8_2.soundref"
	sound_horn[]: "/sound/traffic/car_horn_4.soundref"




@include "drivers_generic.sui"

}

vehicle_accessory: .featan.pickup_long.midclass_25.chassis
{
	data_path: "/def/vehicle/ai/featan_modular_truck_25/chassis_long.sii"
}

vehicle_wheel_accessory: .featan.pickup_long.midclass_25.fwheel
{
	offset: 0
	data_path: "/def/vehicle/ai_wheel/front_20in_o.sii"
}

vehicle_wheel_accessory: .featan.pickup_long.midclass_25.rwheel
{
	offset: 0
	data_path: "/def/vehicle/ai_wheel/rear_20in_o.sii"
}


