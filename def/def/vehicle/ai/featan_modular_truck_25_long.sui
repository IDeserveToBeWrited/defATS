
traffic_vehicle : traffic.featan.service
{
	accessories[]: .featan.service.chassis
	accessories[]: .featan.service.fwheel
	accessories[]: .featan.service.rwheel

	max_speed: 160

	sound_move[]: "/sound/traffic/car_v8_2.soundref"
	sound_horn[]: "/sound/traffic/car_horn_3.soundref"
	
	tags[]: pickup
	tags[]: empty
	tags[]: suv

	variant[]: traffic.featan.highway
	


	vehicle_mass: 3000

	spawn_ratio: 0.1
	
@include "drivers_generic.sui"
	
}

vehicle_accessory: .featan.service.chassis
{
	data_path: "/def/vehicle/ai/featan_modular_truck_25/service.sii"
}

vehicle_wheel_accessory: .featan.service.fwheel
{
	offset: 0
		data_path: "/def/vehicle/ai_wheel/front_offroad.sii"
}

vehicle_wheel_accessory: .featan.service.rwheel
{
	offset: 0
	data_path: "/def/vehicle/ai_wheel/rear_offroad.sii"
}

