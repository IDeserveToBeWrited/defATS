# XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX Civilian - Sport XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

traffic_vehicle : traffic.dylamic.sport
{
	accessories[]: .dylamic.sport.chassis
	accessories[]: .dylamic.sport.fwheel
	accessories[]: .dylamic.sport.rwheel

	max_speed: 280
	vehicle_mass: 1980

	sound_move[]: "/sound/traffic/car_v8_1.soundref"
	sound_move[]: "/sound/traffic/car_v8_2.soundref"
	sound_horn[]: "/sound/traffic/car_horn_4.soundref"
        
           color[]: (0.0343, 0.0343, 0.0343) #black
        color[]: (0.9909, 0.5522, 0.017)  #Standart YELLOW
        color[]: (0.3325, 0.3663, 0.3864) #GRAY
        color[]:(0.0631, 0.1171, 0.1873)  #blue 
	color[]: (0.4639, 0.1500, 0.0003) #Orange
        color[]: (0.3185, 0, 0.0006)      #RED






	tags[]: expensive
	tags[]: luxury

@include "drivers_generic.sui"
	
}

vehicle_accessory: .dylamic.sport.chassis
{
	data_path: "/def/vehicle/ai/dylamic_sport_premium_25/chassis.sii"
}

vehicle_wheel_accessory: .dylamic.sport.fwheel
{
	offset: 0
	data_path: "/def/vehicle/ai_wheel/front_20in.sii"
}

vehicle_wheel_accessory: .dylamic.sport.rwheel
{
	offset: 0
	data_path: "/def/vehicle/ai_wheel/rear_20in.sii"
}


