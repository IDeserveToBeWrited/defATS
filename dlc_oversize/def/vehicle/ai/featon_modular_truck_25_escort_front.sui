traffic_vehicle : traffic.featan.pickup.midclass_25.escort_front
{
	accessories[]: .featan.pickup.midclass_25.escort_front.chassis
	accessories[]: .featan.pickup.midclass_25.escort_front.fwheel
	accessories[]: .featan.pickup.midclass_25.escort_front.rwheel

	max_speed: 160
	vehicle_mass: 2900

	sound_move[]: "/sound/traffic/car_v8_1.soundref"
	sound_move[]: "/sound/traffic/car_v8_2.soundref"
	sound_horn[]: "/sound/traffic/car_horn_4.soundref"

# We want to be able to spawn this vehicle on demand, but forbid 'automatic' spawning as front escort.
	# In USA, the front escort is usually a police car (see traffic_storage_escort_front.sii)
	spawn_ratio: 0.001

	tags[]: escort


@include "drivers_generic.sui"

}

vehicle_accessory: .featan.pickup.midclass_25.escort_front.chassis
{
	data_path: "/def/vehicle/ai/featan_modular_truck_25/chassis_escort_front.sii"
}

vehicle_wheel_accessory: .featan.pickup.midclass_25.escort_front.fwheel
{
	offset: 0
	data_path: "/def/vehicle/ai_wheel/front_20in_o.sii"
}

vehicle_wheel_accessory: .featan.pickup.midclass_25.escort_front.rwheel
{
	offset: 0
	data_path: "/def/vehicle/ai_wheel/rear_20in_o.sii"
}