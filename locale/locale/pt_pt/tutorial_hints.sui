
    key[]: "hint_engine_title"
	val[]: "Ligue o motor"

    key[]: "hint_engine_text"
	val[]: "Usa $KEY_engine$ para ligar o motor."


    key[]: "hint_ignition_title"
	val[]: "Ligue a ignição"

    key[]: "hint_ignition_text"
	val[]: "Usa $KEY_engineelect|KEY_engine$ para ligar a ignição."


    key[]: "hint_driv_arc_title"
	val[]: "A Conduzir"

    key[]: "hint_driv_arc_text"
	val[]: "Usa $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ e $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ para avançar ou para retroceder.<br><offset vshift=8>Usa $SPECIAL_steering$ para virar a direção."


    key[]: "hint_driv_auto_title"
	val[]: "A Conduzir"

    key[]: "hint_driv_auto_text"
	val[]: "Usa $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ e $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ para avançar ou para retroceder.<br><offset vshift=8>Usa $SPECIAL_steering$ para virar a direção.<br><offset vshift=8>Pressiona $KEY_gearup$ e $KEY_geardown$ para mudar de velocidade."


    key[]: "hint_driv_seq_title"
	val[]: "A Conduzir"

    key[]: "hint_driv_seq_text"
	val[]: "Usa $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ e $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ para avançar ou para retroceder.<br><offset vshift=8>Usa $SPECIAL_steering$ para virar a direção.<br><offset vshift=8>Pressiona $KEY_gearup$ e $KEY_geardown$ para controlar a embraiagem."


    key[]: "hint_driv_hshift_title"
	val[]: "A Conduzir"

    key[]: "hint_driv_hshift_text"
	val[]: "Usa $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ e $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ para avançar ou para retroceder.<br><offset vshift=8>Usa $SPECIAL_steering$ para virar a direção.<br><offset vshift=8>Troca de mudanças com a <color value=@@clr_sel@@>alavanca<color value=@@clr_txt@@>."


    key[]: "hint_depot_deliv_title"
    val[]: "A aproximar-se do destino"

    key[]: "hint_depot_deliv_text"
    val[]: "Pare na área demarcada para seleccionar o nível de dificuldade do lugar de estacionamento e ganhar a experiência correspondente."


    key[]: "hint_fin_deliv_title"
    val[]: "Termine a entrega"

    key[]: "hint_fin_deliv_text"
    val[]: "Estacione no lugar seleccionado. Você pode pressionar $KEY_activate$ para saltar esta etapa quando estiver perto do ponto de entrega."


    key[]: "hint_fin_deliv2_title"
    val[]: "Termine a entrega"

    key[]: "hint_fin_deliv2_text"
    val[]: "Estacione no lugar seleccionado. Você pode activar um widget nas @@desktop_menu_category_options@@ para saltar a etapa de estacionamento."


    key[]: "hint_lights_title"
    val[]: "Ligue as luzes"

    key[]: "hint_lights_text"
    val[]: "Use a tecla $KEY_light$ para activar as luzes. Alterne entre os diferentes modos pressionando-a repetidamente."


    key[]: "hint_high_beam_title"
    val[]: "Accione os máximos"

    key[]: "hint_high_beam_text"
    val[]: "Use a tecla $KEY_hblight$ para ligar os máximos."


    key[]: "hint_wipers_title"
    val[]: "Ativar limpa-para-brisas"

    key[]: "hint_wipers_text"
    val[]: "Usa $KEY_wipers$ para ativares o limpa-para-brisas e alternares entre as diferentes definições de velocidade."


    key[]: "hint_zoom_title"
    val[]: "Olhando mais de perto"

    key[]: "hint_zoom_text"
    val[]: "Use a tecla $KEY_camzoom$ para aplicar zoom enquanto estiver no interior. Você pode definir o modo de zoom para manter pressionado ou alternar em @@desktop_menu_category_options@@."


    key[]: "hint_cam_int_title"
    val[]: "A olhar em volta"

    key[]: "hint_cam_int_text"
    val[]: "Use $KEY_cam1$ para mudar a câmara para a vista interior."


    key[]: "hint_cam_ext_title"
    val[]: "A olhar em volta"

    key[]: "hint_cam_ext_text"
    val[]: "Você pode alternar entre diferentes ângulos da câmara pressionando $KEY_camcycle$.<br><offset vshift=8>Use $KEY_cam2$ para mudar a câmara para a visão exterior."


    key[]: "hint_indicators_title"
    val[]: "Indicadores"

    key[]: "hint_indicators_text"
    val[]: "Use $KEY_lblinker$ e $KEY_rblinker$ para ligar os indicadores de mudança."


    key[]: "hint_tow_title"
    val[]: "Serviço de reboque"

    key[]: "hint_tow_text"
    val[]: "Se você não conseguir sair de uma situação difícil, pode usar o serviço de reboque. Para aceder, abra o menu @@quick_info_word@@ utilizando $KEY_advmouse$."


    key[]: "hint_diff_lock_title"
    val[]: "Bloqueio do diferencial"

    key[]: "hint_diff_lock_text"
    val[]: "Se você não conseguir iniciar o movimento, talvez o bloqueio do diferencial possa ajudar. Use a tecla $KEY_diflock$ para activá-lo ou habilite o bloqueio automático do diferencial em @@desktop_menu_category_options@@."


    key[]: "hint_diff_unlock_title"
    val[]: "Bloqueio do diferencial ativado"

    key[]: "hint_diff_unlock_text"
    val[]: "Você deve desligar o diferencial durante a condução normal, caso contrário, corre o risco de danificá-lo. Use a tecla $KEY_diflock$ para desactivá-lo ou active o bloqueio automático do diferencial em @@desktop_menu_category_options@@."


    key[]: "hint_wipers_off_title"
    val[]: "Desativar limpa-para-brisas"

    key[]: "hint_wipers_off_text"
    val[]: "Usa $KEY_wipers$ para desativares o limpa-para-brisas e alternares entre as diferentes definições de velocidade."


    key[]: "hint_world_map_title"
    val[]: "Vista do mapa"

    key[]: "hint_world_map_text"
    val[]: "Use $KEY_navmap$ para abrir o mapa mundo."


    key[]: "hint_pause_title"
    val[]: "@@quick_info_word@@"

    key[]: "hint_pause_text"
    val[]: "Use $KEY_advmouse$ para abrir @@quick_info_word@@ - uma visão geral do seu estado com atalhos convenientes."


    key[]: "hint_pause_border_title"
    val[]: "Regulamentações locais"

    key[]: "hint_pause_border_text"
    val[]: "Use $KEY_advmouse$ para abrir @@quick_info_word@@ e ver as regulamentações actuais da região que você inseriu."


    key[]: "hint_photo_trophy_title"
    val[]: "@@landmark_word@@"

    key[]: "hint_photo_trophy_text"
    val[]: "Abra @@quick_info_word@@ utilizando $KEY_advmouse$ para entrar em @@photo_mode_word@@ e capturar @@landmark_word@@ próximo <img src=/material/ui/map/photo_sight_not_captured.mat width=20 height=20>."


    key[]: "hint_viewpoint_title"
    val[]: "@@viewpoint_title@@ próximo"

    key[]: "hint_viewpoint_text"
    val[]: "@@viewpoint_title@@ <img src=/material/ui/map/viewpoint_unseen.mat width=20 height=20> está por perto - encontre-o e active-o para ver a cena."


    key[]: "hint_resting_title"
    val[]: "Área de descanso próxima"

    key[]: "hint_resting_text"
    val[]: "Os locais de descanso <img src=/material/ui/map/parking_ico.mat width=20 height=20> ajudam a recuperar da fadiga e a realizar a sua pausa obrigatória para continuar a viagem em segurança."


    key[]: "hint_gas_title"
    val[]: "Bomba de combustível próxima"

    key[]: "hint_gas_text"
    val[]: "As bombas de combustível <img src=/material/ui/map/gas_ico.mat width=20 height=20> podem ser usadas para reabastecer o seu veículo."


    key[]: "hint_car_job_title"
    val[]: "Primeiro trabalho de estafeta"

    key[]: "hint_car_job_text"
    val[]: "Conclui a entrega - conduz com cuidado, protege a mercadoria e chega à hora prevista. Tem em atenção a prioridade do cliente, que afeta a tua classificação e recompensa.<br><offset vshift=8>Pressiona $KEY_advmouse$ para veres os detalhes do trabalho."


    key[]: "hint_tour_board_title"
    val[]: "Posto de Turismo"

    key[]: "hint_tour_board_text"
    val[]: "Há um Posto de Turismo por perto. Ativa-o para desbloqueares o seu conteúdo em <color value=@@clr_sel@@>@@tourist_atlas_link@@</color> e guiares a tua exploração de marcos históricos e pontos de interesse próximos."


    key[]: "hint_tb_first_title"
    val[]: "Primeira localização explorada"

    key[]: "hint_tb_first_text"
    val[]: "Exploraste a primeira localização de um Posto de Turismo local. Podes ver os seus detalhes em <color value=@@clr_sel@@>@@tourist_atlas_link@@</color>. Explora todas as localizações para saberes mais e ganhares recompensas."


    key[]: "hint_tb_bef_compl_title"
    val[]: "Falta apenas uma localização"

    key[]: "hint_tb_bef_compl_text"
    val[]: "Falta apenas uma localização para explorares totalmente o teu primeiro Posto de Turismo local e ganhares o teu postal."


    key[]: "hint_tb_done_title"
    val[]: "Posto de Turismo Explorado"

    key[]: "hint_tb_done_text"
    val[]: "Exploraste com sucesso todas as localizações de um Posto de Turismo local. Podes ver os seus detalhes em <color value=@@clr_sel@@>@@tourist_atlas_link@@</color>. Como recompensa, já podes exibir o postal no teu veículo."


    key[]: "hint_vehicle_prio_title"
    val[]: "Prioridade do cliente - estado do veículo"

    key[]: "hint_vehicle_prio_text"
    val[]: "O cliente deu maior prioridade ao estado do veículo - a tua recompensa de bónus ou penalização será fortemente afetada pelo estado do veículo à chegada. Conduz com cuidado e estima o teu veículo.<br><offset vshift=8>Pressiona $KEY_advmouse$ para veres os detalhes do trabalho."


    key[]: "hint_cargo_prio_title"
    val[]: "Prioridade do cliente - manuseamento da carga"

    key[]: "hint_cargo_prio_text"
    val[]: "O cliente deu maior prioridade ao manuseamento da carga - a tua recompensa de bónus ou penalização será fortemente afetada pelo estado da carga que entregares. Conduz com cuidado e protege a tua mercadoria.<br><offset vshift=8>Pressiona $KEY_advmouse$ para veres os detalhes do trabalho."


    key[]: "hint_time_prio_title"
    val[]: "Prioridade do cliente - gestão do tempo"

    key[]: "hint_time_prio_text"
    val[]: "O cliente deu maior prioridade à gestão do tempo - a tua recompensa de bónus ou penalização será fortemente afetada pela tua capacidade de seres pontual. Conduz com cuidado e chega à hora que o cliente espera.<br><offset vshift=8>Pressiona $KEY_advmouse$ para veres os detalhes do trabalho."


    key[]: "hint_car_deliv_title"
    val[]: "Aproxima-te do destino"

    key[]: "hint_car_deliv_text"
    val[]: "Para na área marcada para terminares a entrega.<br>Lembra-te de que o cliente espera a entrega a uma hora específica."


    key[]: "hint_car_early_title"
	val[]: "Chegaste antes do previsto"

    key[]: "hint_car_early_text"
    val[]: "A entrega é esperada a uma hora específica e chegar antes do tempo irá resultar na insatisfação do cliente. Planeia a tua viagem e usa os locais de descanso disponíveis se for necessário."


#!{
    key[]: "hint_sm_throttle_title"
	val[]: "@@throttle_double_tap@@"
#!}

    key[]: "hint_sm_throttle_text"
    val[]: "Podes ativar o controlo inteligente do acelerador nas @@desktop_menu_category_options@@. Ao ativá-lo, o veículo irá manter uma aceleração mais baixa por predefinição. Depois de premires rapidamente o botão do acelerador duas vezes, o veículo irá manter a aceleração máxima até que o botão seja libertado."
