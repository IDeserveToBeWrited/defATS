#+ Text deviations for American Truck Simulator. Please, use only terms appropriate for USA (i.e. culture specific nuances, not American English).
#@{

#+ Music/radio player
#@{

#+ Hint shown if no music files are found. Also shown as tooltip when hovering over music_player button.

	key[]: "music_player_hint"
	val[]: "Wstaw swoją muzykę do katalogu <color value=@@clr_sel@@>American Truck Simulator/music <color value=@@clr_txt@@>w folderze <color value=@@clr_sel@@>Moje dokumenty<color value=@@clr_txt@@>, a zyskasz możliwość odsłuchania jej w grze."

#+ Tooltip shown when hovering over the radio_stream button.

	key[]: "radio_hint"
	val[]: "Edytuj plik <color value=@@clr_sel@@>live_streams.sii <color value=@@clr_txt@@>znajdujący się w katalogu <color value=@@clr_sel@@>American Truck Simulator <color value=@@clr_txt@@>w <color value=@@clr_sel@@>Moje dokumenty <color value=@@clr_txt@@>i słuchaj swojego ulubionego radia internetowego w grze!"

#+ Hint shown if no online radio streams are defined.

	key[]: "empty_radio_hint"
	val[]: "Proszę odnieść się do pliku <color value=@@clr_sel@@>readme.rtf <color value=@@clr_txt@@>w katalogu <color value=@@clr_sel@@>American Truck Simulator <color value=@@clr_txt@@>w <color value=@@clr_sel@@>Moje dokumenty<color value=@@clr_txt@@>, żeby sprawdzić informacje o własnej muzyce i radiostacjach."
#@}

