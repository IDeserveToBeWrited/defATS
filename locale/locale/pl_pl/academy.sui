#+ Book 3 Scenario urf
#@{

#### urf common
	key[]: "aca_scenario_book3_urf_title"
	val[]: "Piaskownica cofania"

	key[]: "aca_scenario_book3_urf_desc"
	val[]: "W tym scenariuszu zostaniesz umieszczony na pustym parkingu, aby ćwiczyć cofanie z naczepami typu B-double."

#### urf goal

	key[]: "aca_goal_book3_urf_start"
	val[]: "Pierwsze kroki"

	key[]: "aca_goal_book3_urf_move"
	val[]: "Eksperymentowanie"

	key[]: "aca_goal_book3_urf_stop"
	val[]: "Wykańczanie"

	key[]: "aca_goal_book3_urf_end"
	val[]: "Zakończenie scenariusza"

	#### urf msg - intro text

	key[]: "aca_msg_book3_urf_cutscene1"
	val[]: "Cofanie z naczepami typu B-double wymaga znacznie więcej uwagi niż z pojedynczą naczepą. Musisz planować z wyprzedzeniem to, gdzie ma się znaleźć tylna naczepa, zachowując jednocześnie kontrolę nad przednią naczepą i kabiną.<br><br>Myśl o tym tak, jakbyś sterował tylną naczepą za pomocą przedniej naczepy. Zatem to, w którą stronę skierujesz przód, zmieni trajektorię tyłu."

	key[]: "aca_msg_book3_urf_cutscene2"
	val[]: "In this case, we want to turn the rear trailer to the driver's side. <br><br>To do this, we steered the lead to the passenger's side."

	key[]: "aca_msg_book3_urf_cutscene3"
	val[]: "To jest moment, w którym większość ludzi popełnia swój pierwszy błąd. Gdy tylko tylna naczepa zacznie skręcać, musisz wyprostować ciężarówkę względem przedniej naczepy..."

	key[]: "aca_msg_book3_urf_cutscene4"
	val[]: "...w przeciwnym razie skończysz złożony w „scyzoryk” w ten sposób."

	key[]: "aca_msg_book3_urf_cutscene5"
	val[]: "Złożenie się w „scyzoryk” następuje, gdy kąt między dowolnymi dwoma pojazdami w zestawie wyniesie około 90°. Gdy to się stanie, nie da się już tego uratować – musisz podjechać do przodu i podjąć kolejną próbę.<br><br>Tak jak przy cofaniu z jedną naczepą, celem powinno być zawsze zapewnienie, aby wszystkie koła naczep były w ruchu. Gdy koła się zatrzymają, a naczepa obraca się w miejscu, to koniec."

	key[]: "aca_msg_book3_urf_cutscene6"
	val[]: "Możesz podjechać do przodu do miejsca, w którym ostatnio byłeś ustawiony poprawnie, a raczej do pozycji, w której możesz kontynuować pracę na biegu wstecznym bez ponownego popełniania tego samego błędu, lub po prostu podjechać do przodu, aż będziesz ustawiony prosto."

	key[]: "aca_msg_book3_urf_cutscene7"
	val[]: "Po raz kolejny, gdy tylna naczepa zacznie skręcać, ustaw ciężarówkę przed pierwszą naczepą i pozwól tylnej naczepie przez chwilę skręcać samoczynnie."

	key[]: "aca_msg_book3_urf_cutscene8"
	val[]: "Teraz, gdy tylna naczepa skręca płynnie, czas, aby reszta za nią podążała. Możesz regulować kąt między przyczepą a tyłem, aby kontrolować skręt i uczynić go ostrzejszym lub szerszym."

	key[]: "aca_msg_book3_urf_cutscene9"
	val[]: "Ostatnią częścią manewru jest wyprostowanie wszystkiego. Ustaw przednią naczepę przed tylną."

	key[]: "aca_msg_book3_urf_cutscene10"
	val[]: "Dobrym pomysłem jest pamiętanie o czasie, jakiego wymaga przemieszczenie przedniej naczepy, oraz o tym, że będziesz musiał również ustawić w linii ciężarówkę."

	key[]: "aca_msg_book3_urf_cutscene11"
	val[]: "Możesz spędzić tu tyle czasu, ile chcesz, eksperymentuj z różnymi manewrami, aż poczujesz, że mniej więcej wiesz, jak obchodzić się z naczepą podczas cofania."

#### urf Driving Instructions

	key[]: "aca_msg_book3_urf_start"
	val[]: "Przygotuj się do ruszenia."

	key[]: "aca_msg_book3_urf_move"
	val[]: "Wykorzystaj ten parking, aby wyczuć, jak prowadzi się zestaw z naczepami na biegu wstecznym. <br><br>@@aca_goal_tip@@ Dopiero zaczynasz przygodę z cofaniem naczepami? Rozważ ukończenie modułu „Podstawy jazdy ciężarówką”."

	key[]: "aca_msg_book3_urf_stop"
	val[]: "Poświęć na ćwiczenia tyle czasu, ile chcesz. <br><br>Gdy uznasz, że jesteś gotowy, możesz się zatrzymać i zabezpieczyć ciężarówkę, aby zakończyć scenariusz."

	key[]: "aca_msg_book3_urf_end"
	val[]: "Wyłącz silnik, aby zakończyć scenariusz."
#@}


#+ Book 3 Scenario sup
#@{

#### sup common
	key[]: "aca_scenario_book3_sup_title"
	val[]: "Parkowanie w wąskim miejscu"

	key[]: "aca_scenario_book3_sup_desc"
	val[]: "W tym scenariuszu Twoim zadaniem jest zaparkowanie zestawu typu B-double w wąskim miejscu."

#### sup goal

	key[]: "aca_goal_book3_sup_start"
	val[]: "Pierwsze kroki"

	key[]: "aca_goal_book3_sup_forward"
	val[]: "Ruszanie z miejsca"

	key[]: "aca_goal_book3_sup_check1"
	val[]: "Kontynuuj jazdę"

	key[]: "aca_goal_book3_sup_stop"
	val[]: "Zatrzymywanie się"

	key[]: "aca_goal_book3_sup_end"
	val[]: "Zabezpieczanie pojazdu"

#### sup msg - intro text

	key[]: "aca_msg_book3_sup_cutscene1"
	val[]: "Jazda z naczepami typu B-double może wydawać się onieśmielająca, ale nie ma w niej dużo więcej filozofii niż w jeździe z pojedynczą naczepą – musisz po prostu brać pod uwagę również tor jazdy tylnej naczepy!"

	key[]: "aca_msg_book3_sup_cutscene2"
	val[]: "Przed Tobą znajduje się ciasne miejsce parkingowe. Nie będziesz mieć wystarczająco dużo przestrzeni, aby idealnie się wyprostować przed wjazdem, więc musisz starannie zaplanować, jak zmieścić się tam z obiema naczepami."

	key[]: "aca_msg_book3_sup_cutscene3"
	val[]: "Skręć natychmiast w stronę dalszej krawędzi miejsca parkingowego i pojedź znacznie dalej niż punkt, w którym zazwyczaj zacząłbyś skręcać."

	key[]: "aca_msg_book3_sup_cutscene4"
	val[]: "Teraz, gdy Twoja tylna naczepa jest na właściwym torze, możesz skierować się w stronę miejsca docelowego; być może będziesz musiał jeszcze raz zjechać w stronę dalszej krawędzi, aby pomóc naprowadzić Twoją pierwszą naczepę."

	key[]: "aca_msg_book3_sup_cutscene5"
	val[]: "Kontynuuj wjazd na miejsce parkingowe, a obie naczepy wjadą za Tobą i wyprostują się w miarę jazdy."

	key[]: "aca_msg_book3_sup_cutscene6"
	val[]: "Zaparkuj w wyznaczonym miejscu i zabezpiecz ciężarówkę."

