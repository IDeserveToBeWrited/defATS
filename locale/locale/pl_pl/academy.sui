#!}
	key[]: "aca_msg_book3_justc_forward"
	val[]: "Nie ma wyjścia z tego zamieszania. Podjedź do przodu, aby uzyskać pozycję, nad którą dasz radę zapanować."

	key[]: "aca_msg_book3_justc_check1"
	val[]: "Rozpocznij cofanie."

