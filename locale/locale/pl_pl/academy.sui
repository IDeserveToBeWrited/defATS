key[]: "aca_msg_book2_slopy_moments1"
val[]: "Aby pomyślnie ukończyć ten scenariusz, utrzymuj naczepę podłączoną przez cały czas.<br><br><font face=/font/big_bold.font>Podłącz naczepę.</font>"

key[]: "aca_msg_book2_slopy_moments2"
val[]: "Teraz możesz kontynuować scenariusz"


