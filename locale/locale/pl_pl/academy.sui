#### 2_04 common
	key[]: "aca_scenario_book1_2_04_title"
	val[]: "Parkowanie obok przeszkody"

	key[]: "aca_scenario_book1_2_04_desc"
	val[]: "W tym scenariuszu nauczymy się parkować przy krawężniku, korzystając z lusterka bocznego."

#### 2_04 goal

	key[]: "aca_goal_book1_2_04_mirror"
	val[]: "Sprawdź lusterko boczne"

	key[]: "aca_goal_book1_2_04_check1"
	val[]: "Jazda w stronę krawężnika"

#!{
	key[]: "aca_goal_book1_2_04_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

