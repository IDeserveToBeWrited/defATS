	key[]: "aca_book_book2_help_stars_desc"
	val[]: "Gwiazdki zdobywa się poprzez spełnianie warunków bonusowych"

	key[]: "aca_book_book2_help_conditions_t"
	val[]: "Warunki"

	key[]: "aca_book_book2_help_direction_changes_desc"
	val[]: "Maksymalna liczba zmian pomiędzy ruchem do przodu i do tyłu"

	key[]: "aca_book_book2_help_time_desc"
	val[]: "Maksymalny czas dozwolony na ukończenie scenariusza w danym stanie"

	key[]: "aca_book_book2_help_camera_desc"
	val[]: "Wyłączne korzystanie z kamery wewnętrznej – kamery zewnętrzne mogą być nadal używane podczas postoju"

	key[]: "aca_book_book2_completed_t"
