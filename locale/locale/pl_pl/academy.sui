#### 2_09 msg - intro text

	key[]: "aca_msg_book1_2_09_cutscene1"
	val[]: "Parkowanie równoległe to podstawowa umiejętność, którą powinien znać każdy kierowca ciężarówki.<br>Przygotuj się do jazdy."

	key[]: "aca_msg_book1_2_09_cutscene2"
	val[]: "Podjedź na miejsce parkingowe.<br>Zwróć uwagę na otoczenie."

	key[]: "aca_msg_book1_2_09_cutscene3"
	val[]: "Ustaw się w linii z ciężarówką przed swoim miejscem parkingowym. Nie bądź zbyt blisko i zachowaj pewien dystans, aby mieć miejsce do manewru."

	key[]: "aca_msg_book1_2_09_cutscene4"
	val[]: "Skręć ostro w kierunku miejsca i zacznij cofać."

	key[]: "aca_msg_book1_2_09_cutscene5"
	val[]: "Patrząc w lusterko kierowcy, skieruj wzrok na krawężnik znajdujący się tuż przed ciężarówką za Tobą."

	key[]: "aca_msg_book1_2_09_cutscene6"
	val[]: "Gdy przedni zderzak ominie ciężarówkę przed Tobą, możesz ponownie skręcić koła, wyrównując z miejscem parkingowym."

	key[]: "aca_msg_book1_2_09_cutscene7"
	val[]: "Wyprostuj kierownicę i wyśrodkuj ciężarówkę na miejscu parkingowym.<br>Zaparkuj i zabezpiecz ciężarówkę."

#### 2_09 Driving Instructions

	key[]: "aca_msg_book1_2_09_start"
	val[]: "Przed Tobą jest kilka zaparkowanych ciężarówek. Zostało akurat jedno wolne miejsce do zaparkowania. <br><br><font face=/font/big_bold.font>Przygotuj się do ruszenia. </font>"

	key[]: "aca_msg_book1_2_09_check1"
	val[]: "Pamiętaj, aby zwracać uwagę na otoczenie. Wykorzystaj lusterka podczas tego manewru. <br><br><font face=/font/big_bold.font>Jedź do przodu. </font>"

	key[]: "aca_msg_book1_2_09_stopmid"
	val[]: "<color value=@@clr_white@@>Przejedź obok miejsca parkingowego do oznaczonego obszaru. Stamtąd możesz rozpocząć manewr cofania.<br><br><font face=/font/big_bold.font>Zatrzymaj się w oznaczonym miejscu. </font>"

	key[]: "aca_msg_book1_2_09_checkmirror"
	val[]: "Sprawdź otoczenie pod kątem przeszkód i upewnij się, że możesz swobodnie cofać.<br><br><font face=/font/big_bold.font>Spójrz w lusterko pasażera. </font>"

	key[]: "aca_msg_book1_2_09_backward"
	val[]: "Skręć koła i cofnij na miejsce parkingowe.<br><br><font face=/font/big_bold.font>Rozpocznij cofanie. </font>"

	key[]: "aca_msg_book1_2_09_stop"
	val[]: "Rozpocznij prostowanie ciężarówki, gdy będzie to właściwe. Nie przejeżdżaj przez krawężnik!<br><br><font face=/font/big_bold.font>Wyrównaj ciężarówkę z miejscem. </font>"
#!{
	key[]: "aca_msg_book1_2_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

