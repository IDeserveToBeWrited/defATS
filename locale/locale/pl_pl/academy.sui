#+ Book 2 blindside_parking
#@{
#### common
	key[]: "aca_scenario_book2_blindside_parking_title"
	val[]: "Parkowanie po niewidocznej stronie"

	key[]: "aca_scenario_book2_blindside_parking_desc"
	val[]: "W tym scenariuszu ponownie zajmiemy się cofaniem od „martwej strony”. To już trudny manewr w idealnych warunkach, ale teraz będziesz musiał poradzić sobie z bardziej rygorystycznymi warunkami."

#### intro text

	key[]: "aca_scenario_book2_blindside_parking_cutscene1"
	val[]: "Przed Tobą i po prawej stronie jest miejsce parkingowe, na które musisz cofnąć. Przejedź obok niego, a następnie wykonaj manewr cofania od „martwej strony”, aby wjechać na to miejsce."

	key[]: "aca_scenario_book2_blindside_parking_cutscene2"
	val[]: "Teraz masz mniej miejsca do pracy niż wcześniej, dlatego musisz kierować pojazdem precyzyjnie i rozważnie."

#@}


#+ Book 2 advanced_alley_parking
#@{
