#### 2_06 msg - intro text

	key[]: "aca_msg_book1_2_06_cutscene01"
	val[]: "W ostatnim scenariuszu tego rozdziału przejedziemy przez tor testowy ze skomplikowanym układem przeszkód."

	key[]: "aca_msg_book1_2_06_cutscene02"
	val[]: "Pierwszą przeszkodą jest slalom przez barierki. Przejedź, pamiętając o używaniu lusterek."

	key[]: "aca_msg_book1_2_06_cutscene04"
	val[]: "Następny jest ostry zakręt typu „agrafka”. Trzymaj swój zakręt szeroko, a nie powinno to sprawić Ci żadnych problemów."

	key[]: "aca_msg_book1_2_06_cutscene05"
	val[]: "Droga przed Tobą znacznie się zwęża. Postępuj ostrożnie i korzystaj z lusterka bocznego, aby sobie pomóc."

	key[]: "aca_msg_book1_2_06_cutscene06"
	val[]: "Następnie mamy serię łatwych zakrętów o 90°."

	key[]: "aca_msg_book1_2_06_cutscene08"
	val[]: "Podczas następnej części będziesz musiał cofać. Miej to na względzie, zbliżając się do barier."

	key[]: "aca_msg_book1_2_06_cutscene09"
	val[]: "Podążaj za oznaczeniami drogi i jedź wzdłuż zakrętów."

	key[]: "aca_msg_book1_2_06_cutscene10"
	val[]: "Wycofaj do barier, następnie się zatrzymaj i kontynuuj w do przodu, po czym w prawo."

	key[]: "aca_msg_book1_2_06_cutscene11"
	val[]: "This passage through the cones is very narrow. Drive slowly and use your mirrors to orient yourself within the passage."

	key[]: "aca_msg_book1_2_06_cutscene13"
	val[]: "Przed Tobą seria naprzemiennych zakrętów o 90° w lewo i w prawo."

	key[]: "aca_msg_book1_2_06_cutscene15"
	val[]: "Na tym przejeździe kolejowym możesz napotkać pociągi. Jeśli tak, zatrzymaj się i poczekaj. Następnie możesz skręcić w prawo na drogę serwisową."

	key[]: "aca_msg_book1_2_06_cutscene16"
	val[]: "Skręć w lewo na drogę. Możesz nabrać prędkości po zakończeniu skrętu."

	key[]: "aca_msg_book1_2_06_cutscene18"
	val[]: "Jeszcze kilka skrętów w lewo w mieście i będziesz na miejscu!"

	key[]: "aca_msg_book1_2_06_cutscene19"
	val[]: "Podjedź do barierek przed Tobą i przygotuj się na zaparkowanie na miejscu parkingowym po prawej stronie."

	key[]: "aca_msg_book1_2_06_cutscene20"
	val[]: "Wjedź tyłem na miejsce parkingowe, wyłącz silnik i zabezpiecz ciężarówkę."

#### 2_06 Driving Instructions



	key[]: "aca_msg_book1_2_06_forward"
	val[]: "Zbliżasz się do slalomu zbudowanego z barier.<br><br><font face=/font/big_bold.font>Przejedź przez slalom.</font>"

	key[]: "aca_msg_book1_2_06_forward2"
	val[]: "<font face=/font/big_bold.font>Podążaj ścieżką wokół ostrego zakrętu. </font>"

	key[]: "aca_msg_book1_2_06_check1"
	val[]: "Droga przed Tobą znacznie się zwęża. Możesz użyć lusterka bocznego, aby zorientować się w terenie.<br><br><font face=/font/big_bold.font>Postępuj ostrożnie.</font>"

	key[]: "aca_msg_book1_2_06_check2"
	val[]: "Po pokonaniu zakrętu należy wykonać skręt o 90°.<br><br><font face=/font/big_bold.font>Dostosuj odpowiednio prędkość.</font>"

	key[]: "aca_msg_book1_2_06_check3"
	val[]: "Przed Tobą jeszcze kilka łatwych zakrętów, w razie potrzeby dostosuj prędkość.<br><br><font face=/font/big_bold.font>Kontynuuj jazdę.</font>"

	key[]: "aca_msg_book1_2_06_check4"
	val[]: "The following section must be completed in reverse. Stop at the barriers ahead so that you can reverse to the right afterwards.<br><br><font face=/font/big_bold.font>Stop at the barriers.</font>"

	key[]: "aca_msg_book1_2_06_check5"
	val[]: "Cofnij się w kierunku obszaru za Tobą i w prawo.<br><br><font face=/font/big_bold.font>Rozpocznij cofanie.</font>"

	key[]: "aca_msg_book1_2_06_reverse"
	val[]: "Podążaj ścieżką wokół zakrętów.<br><br><font face=/font/big_bold.font>Cały czas cofaj.</font>"

	key[]: "aca_msg_book1_2_06_check6"
	val[]: "Za Tobą po lewej stronie znajdują się bariery. <br><br><font face=/font/big_bold.font>Odwróć się w stronę barier i bądź gotowy na zatrzymanie się.</font>"

	key[]: "aca_msg_book1_2_06_check7"
	val[]: "Zatrzymaj się i wrzuć bieg do jazdy w przód. Następnie podążaj w prawo.<br><br><font face=/font/big_bold.font>Jedź prosto.</font>"

	key[]: "aca_msg_book1_2_06_check8"
	val[]: "In front of you is a narrow winding path through some cones. Drive carefully and use your mirrors if necessary.<br><br><font face=/font/big_bold.font>Drive through the cones. </font>"

	key[]: "aca_msg_book1_2_06_check9"
	val[]: "Następne są kombinacje różnych zakrętów o 90°. Upewnij się, że podchodzisz do każdego zakrętu z szerokim łukiem.<br><br><font face=/font/big_bold.font>Kontynuuj jazdę.</font>"

	key[]: "aca_msg_book1_2_06_check10"
	val[]: "Zbliżając się do przejazdu kolejowego, obserwuj przejazd kolejowy. Sygnały mogą się włączyć, wskazując nadjeżdżający pociąg.<br><br><font face=/font/big_bold.font>Postępuj ostrożnie.</font>"

	key[]: "aca_msg_book1_2_06_check11"
	val[]: "Skręt na drogę serwisową jest częściowo zablokowany przez przeszkodę, dlatego trzymaj się lewej strony podczas zbliżania się, aby mieć więcej miejsca.<br><br><font face=/font/big_bold.font>Wykonaj skręt.</font>"

	key[]: "aca_msg_book1_2_06_check12"
	val[]: "Możesz wybrać, czy zastosować się do znaku stop, czy go zignorować. Obszar został zamknięty dla naszego użytku.<br><br><font face=/font/big_bold.font>Skręć w lewo.</font>"

	key[]: "aca_msg_book1_2_06_check13"
	val[]: "Możesz teraz nabrać prędkości, jednak będziesz musiał skręcić na najbliższym skrzyżowaniu.<br><br><font face=/font/big_bold.font>Kontynuuj jazdę.</font>"

	key[]: "aca_msg_book1_2_06_check14"
	val[]: "Wjedź do miasta, skręcając w lewo, a następnie wykonaj jeszcze dwa skręty w lewo do ostatniej strefy.<br><br><font face=/font/big_bold.font>Przejedź przez miasto.</font>"

	key[]: "aca_msg_book1_2_06_check15"
	val[]: "Po drugiej stronie parkingu znajdują się bariery. Podjedź do nich. <br><br><font face=/font/big_bold.font>Zatrzymaj się przy barierach. </font>"

	key[]: "aca_msg_book1_2_06_check16"
	val[]: "Za Tobą, po prawej stronie, znajduje się miejsce parkingowe.<br><br><font face=/font/big_bold.font>Wjedź tyłem na miejsce parkingowe.</font>"
#!{
	key[]: "aca_msg_book1_2_06_check17"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_06_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_2_06_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

#@}

#+ Book 1 Scenario 2_08
#@{

#### 2_08 common
	key[]: "aca_scenario_book1_2_08_title"
	val[]: "Prosty kurs szkoleniowy"

	key[]: "aca_scenario_book1_2_08_desc"
	val[]: "W tym scenariuszu wykorzystamy nabyte dotychczas umiejętności i wypróbujemy je w ramach prostego kursu szkoleniowego."

#### 2_08 goal
#!{
	key[]: "aca_goal_book1_2_08_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_08_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_2_08_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
#!}
	key[]: "aca_goal_book1_2_08_forward"
	val[]: "Wjazd na tor"

	key[]: "aca_goal_book1_2_08_check1"
	val[]: "Szeroki zakręt 180°"

	key[]: "aca_goal_book1_2_08_check2"
	val[]: "Jazda slalomem"

	key[]: "aca_goal_book1_2_08_check3"
	val[]: "Wąski zakręt 180°"

	key[]: "aca_goal_book1_2_08_check4"
	val[]: "Wąski łuk"

	key[]: "aca_goal_book1_2_08_check6"
	val[]: "Sekcja techniczna"

	key[]: "aca_goal_book1_2_08_check7"
	val[]: "Otwórz sekcję"



#### 2_08 msg - intro text

	key[]: "aca_msg_book1_2_08_cutscene1"
	val[]: "W tym scenariuszu zabierzemy Twoją ciężarówkę na krótką przejażdżkę, aby zobaczyć, jak sobie poradzisz, wykorzystując swoje nowo nabyte umiejętności.<br>Na torze występują różne rodzaje i kombinacje zakrętów. To nie wyścig i nie chodzi o czas. Bądź cierpliwy i dostosuj prędkość jazdy do zakrętów i przeszkód, na które trafisz."

	key[]: "aca_msg_book1_2_08_cutscene2"
	val[]: "Rozpocznij trasę szerokim, ostrym zakrętem."

	key[]: "aca_msg_book1_2_08_cutscene3"
	val[]: "Następnie natkniesz się na serię przeszkód, które poprowadzą Cię do nieregularnego slalomu."

	key[]: "aca_msg_book1_2_08_cutscene4"
	val[]: "Po wykonaniu kilku łatwych zakrętów o 90° napotkasz ciasny zakręt w kształcie agrafki. Ważne jest, aby odpowiednio się ustawić, zarówno aby wykonać zakręt, jak i płynnie wjechać w następną sekcję."

	key[]: "aca_msg_book1_2_08_cutscene5"
	val[]: "Podczas pokonywania długiego zakrętu należy uważać na pachołki, ponieważ widoczność ponad maską jest ograniczona."

	key[]: "aca_msg_book1_2_08_cutscene6"
	val[]: "Kolejny zestaw przeszkód wprowadzi Cię w szeroki slalom."

	key[]: "aca_msg_book1_2_08_cutscene7"
	val[]: "Trasa trochę się otwiera, ale nie spiesz się. Jeszcze kilka łatwych zakrętów i gotowe."

	key[]: "aca_msg_book1_2_08_cutscene8"
	val[]: "Stop in the designated area and secure the truck."


#### 2_08 Driving Instructions

	key[]: "aca_msg_book1_2_08_start"
	val[]: "Aby zakończyć ten scenariusz pomyślnie, nie możesz w nic uderzyć, wypaść z toru ani rozjechać pachołków.<br><br><font face=/font/big_bold.font>Przygotuj się do ruszenia. </font>"

	key[]: "aca_msg_book1_2_08_forward"
	val[]:"<font face=/font/big_bold.font>Jedź dalej szerokim ostrym zakrętem, aby wejść na trasę. </font>"

	key[]: "aca_msg_book1_2_08_check1"
	val[]: "<font face=/font/big_bold.font>Pokonaj ostry zakręt.</font>"

	key[]: "aca_msg_book1_2_08_check2"
	val[]: "Zbliżasz się do przeszkód ustawionych mniej więcej w slalomie.<br><br><font face=/font/big_bold.font>Dostosuj odpowiednio prędkość i kontynuuj jazdę.</font>"

	key[]: "aca_msg_book1_2_08_check3"
	val[]: "Następnie masz dwa łatwe zakręty o 90°, po których następuje ciasny zakręt w kształcie szpilki. Jedź powoli.<br><br><font face=/font/big_bold.font>Kontynuuj ciasny zakręt w kształcie szpilki.</font>"

	key[]: "aca_msg_book1_2_08_check4"
	val[]: "Wyjeżdżając z zakrętu, natrafisz na wąską ścieżkę przez zakręt. Musisz trzymać się z dala od wewnętrznej bariery, ale uważaj, aby nie uderzyć w żadne pachołki przed Tobą.<br><br><font face=/font/big_bold.font>Kontynuuj jazdę przez zakręt. </font>"

	key[]: "aca_msg_book1_2_08_check6"
	val[]: "Droga przed Tobą ma ciasne, techniczne skręty. Dostosuj prędkość i ostrożnie przejedź przez ten odcinek.<br><br><font face=/font/big_bold.font>Kontynuuj jazdę. </font>"

	key[]: "aca_msg_book1_2_08_check7"
	val[]: "Następna sekcja jest bardziej otwarta z kilkoma łatwymi zakrętami. Nie spiesz się.<br><br><font face=/font/big_bold.font>Kontynuuj jazdę.</font>"
#!{
	key[]: "aca_msg_book1_2_08_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_08_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

#@}

#+ Book 1 Scenario 2_09
#@{

#### 2_09 common
	key[]: "aca_scenario_book1_2_09_title"
	val[]: "Parkowanie równoległe"

	key[]: "aca_scenario_book1_2_09_desc"
	val[]: "W tym scenariuszu przyjrzymy się parkowaniu równoległemu między dwiema innymi ciężarówkami."

#### 2_09 goal

	key[]: "aca_goal_book1_2_09_stopmid"
	val[]: "Zatrzymywanie się przed miejscem parkingowym"

	key[]: "aca_goal_book1_2_09_checkmirror"
	val[]: "Sprawdzanie lusterka wstecznego"

	key[]: "aca_goal_book1_2_09_backward"
	val[]: "Cofanie na miejsce parkingowe"

	key[]: "aca_goal_book1_2_09_stop"
	val[]: "Wyrównanie ciężarówki wewnątrz miejsca parkingowego"

#!{
	key[]: "aca_goal_book1_2_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

