	val[]: "Skręt typu „uchwyt dzbanka”"

	key[]: "aca_goal_book1_3_15_check2"
	val[]: "Odcinki zakrzywione i proste"

	key[]: "aca_goal_book1_3_15_check3"
	val[]: "Skręt typu „haczyk guzikowy\""

	key[]: "aca_goal_book1_3_15_check4"
	val[]: "Odcinek prosty i łukowy"

	key[]: "aca_goal_book1_3_15_check5"
	val[]: "Zakręt kombinowany"



#### 3_15 msg - intro text

	key[]: "aca_msg_book1_3_15_cutscene01"
	val[]: "Przed Tobą znajdują się ciasne zakręty.<br>Pomogą Ci w manewrowaniu naczepą bardziej precyzyjnie."

	key[]: "aca_msg_book1_3_15_cutscene02"
	val[]: "@@aca_msg_book1_3_15_cutscene02_img@@<br>Pierwszy zakręt wymaga skrętu typu „uchwyt dzbanka”. Termin ten odnosi się do zakrętów, w których masz ograniczoną przestrzeń na drodze, w którą skręcasz, i musisz zamiast tego wykorzystać dodatkową przestrzeń na drodze, na której się obecnie znajdujesz."

	key[]: "aca_msg_book1_3_15_cutscene03"
	val[]: "Kontynuuj jazdę zgodnie z oznaczeniami pasa ruchu, aby oddalić ciężarówkę daleko i szeroko od wewnętrznego krawężnika.<br>Spowoduje to oddalenie naczepy od krawężnika, dzięki czemu będziesz mieć wystarczająco dużo miejsca na manewrowanie w kierunku wyznaczonego obszaru."

	key[]: "aca_msg_book1_3_15_cutscene04"
	val[]: "Wyjeżdżając z zakrętu, trzymaj się blisko przeszkody, aby naczepa mogła kontynuować jazdę po najszerszym możliwym łuku."

	key[]: "aca_msg_book1_3_15_cutscene05"
	val[]: "Wjeżdżając w długi zakręt, należy trzymać ciężarówkę bliżej środka drogi, aby koła naczepy nie dotykały krawężnika."

	key[]: "aca_msg_book1_3_15_cutscene06"
	val[]: "Kontynuuj wzdłuż drogi."

	key[]: "aca_msg_book1_3_15_cutscene07"
	val[]: "@@aca_msg_book1_3_15_cutscene07_img@@<br>Następny zakręt wymaga skrętu typu „haczyk guzikowy\". Jest to preferowana technika, ponieważ nie otwiera pasa za tobą dla nieuważnego kierowcy, który mógłby podjechać z prawej strony. Zawsze używaj jej, gdy masz wystarczająco dużo miejsca na drodze, w którą skręcasz."

	key[]: "aca_msg_book1_3_15_cutscene08"
	val[]: "Wjedź głęboko na skrzyżowanie i szybko skręć ostro w prawo."

	key[]: "aca_msg_book1_3_15_cutscene09"
	val[]: "Kiedy zbliżasz się do przeszkody, możesz wyprostować ciężarówkę i ponownie trzymać się lewej strony pasa ruchu.<br>Wszystko to ma na celu utrzymanie kół naczepy z dala od krawężnika."

	key[]: "aca_msg_book1_3_15_cutscene10"
	val[]: "Kontynuuj jazdę w kierunku następnego zakrętu."

	key[]: "aca_msg_book1_3_15_cutscene11"
	val[]: "Ponownie trzymaj się środka drogi, aby koła naczepy nie dotykały krawężnika."

	key[]: "aca_msg_book1_3_15_cutscene12"
	val[]: "Szczególnie kłopotliwy jest zakręt przed Tobą. W takich przypadkach nie będziesz mieć idealnych warunków ani do skrętu typu „uchwyt dzbanka”, ani do skrętu typu „haczyk guzikowy\" i musisz połączyć oba manewry, aby dotrzeć tam, gdzie chcesz."

	key[]: "aca_msg_book1_3_15_cutscene13"
	val[]: "Przed zakrętem wykonaj szeroki manewr, wjedź głęboko na skrzyżowanie i szybko skręć. Ponownie, idealnym rozwiązaniem jest trzymanie się jak najbliżej przeszkody, aby zakręt był jak najszerszy."

	key[]: "aca_msg_book1_3_15_cutscene14"
	val[]: "Zaparkuj w wyznaczonym obszarze, zabezpiecz ciężarówkę i wyłącz silnik."

	# Book 1 Scenario 3_15 formatting
#!{
	key[]: "aca_msg_book1_3_15_cutscene02_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/jug_handle.mat bottom=p256 right=p256 color=FFFFFFFF></align><offset vshift=256>"

	key[]: "aca_msg_book1_3_15_cutscene07_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/button_hook.mat bottom=p256 right=p256 color=FFFFFFFF></align><offset vshift=256>"

#!}


#### 3_15 Driving Instructions

	key[]: "aca_msg_book1_3_15_forward"
	val[]: "Pamiętaj, aby wykorzystać całą dostępną przestrzeń podczas pokonywania zakrętów.<br><br><font face=/font/big_bold.font>Rozpocznij jazdę i podążaj za oznaczeniami.</font>"

	key[]: "aca_msg_book1_3_15_check1"
	val[]: "Wykorzystaj całą dostępną przestrzeń, aby umieścić naczepę szeroko i trzymać ją z dala od wewnętrznego krawężnika.<br><br><font face=/font/big_bold.font>Wykonaj skręt typu „uchwyt dzbanka”.</font>"

	key[]: "aca_msg_book1_3_15_check2"
	val[]: "Na zakręcie trzymaj się środka drogi, a następnie jedź prosto do następnego zakrętu.<br><br><font face=/font/big_bold.font>Kontynuuj jazdę.</font>"

	key[]: "aca_msg_book1_3_15_check3"
	val[]: "Po lewej stronie jest mało miejsca, więc musisz wjechać jak najdalej na skrzyżowanie, żeby nrzyczepa nie uderzyła w krawężnik.<br><br><font face=/font/big_bold.font>Wykonaj skręt typu „haczyk guzikowy\".</font>"

	key[]: "aca_msg_book1_3_15_check4"
	val[]: "Jedź dalej do następnego zakrętu i go omiń.<br><br><font face=/font/big_bold.font>Kontynuuj jazdę.</font>"

	key[]: "aca_msg_book1_3_15_check5"
	val[]: "Ten zakręt jest jak dotąd najciaśniejszy i żaden z manewrów nie będzie wystarczający.<br><br><font face=/font/big_bold.font>Wykonaj zakręt tak szeroko, jak to możliwe.</font>"

	key[]: "aca_msg_book1_3_15_check6"
	val[]: "<font face=/font/big_bold.font>Kontynuuj jazdę do miejsca parkingowego przed sobą i skręć w prawo. </font>"
#!{
	key[]: "aca_msg_book1_3_15_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_15_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_15_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}


#@}

#+ Book 1 Scenario 3_16
#@{

#### 3_16 common
	key[]: "aca_scenario_book1_3_16_title"
	val[]: "Parkowanie skośne tyłem"

	key[]: "aca_scenario_book1_3_16_desc"
	val[]: "W tym scenariuszu zajmiemy się parkowaniem po skosie podczas cofania. Może się to zdarzyć na parkingach, zajazdach dla ciężarówek, a nawet u przewoźników. Często jest mało miejsca, ponieważ parkingi są zatłoczone, więc parkowanie jest tym trudniejsze z powodu braku miejsca."

#### 3_16 goal

	key[]: "aca_goal_book1_3_16_check1"
	val[]: "Skręcanie naczepy"
#!{
	key[]: "aca_goal_book1_3_16_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_16_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_16_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_16_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
 #!}
#### 3_16 msg - intro text

	key[]: "aca_msg_book1_3_16_cutscene1"
	val[]: "Parkowanie po przekątnej wydaje się na pierwszy rzut oka łatwiejsze, ale często może być trudniejsze niż typowe manewry parkowania „w alejce”."

	key[]: "aca_msg_book1_3_16_cutscene2"
	val[]: "Wycofaj w kierunku miejsca parkingowego. Na razie utrzymaj ciężarówkę i naczepę w linii prostej."

	key[]: "aca_msg_book1_3_16_cutscene3"
	val[]: "Podczas zbliżania się do miejsca, trzymaj naczepę jak najbliżej zaparkowanych ciężarówek. Ułatwi Ci to dalsze manewrowanie."

	key[]: "aca_msg_book1_3_16_cutscene4"
	val[]: "Zacznij skręcać naczepą na miejsce parkingowe. Trzymaj naczepę blisko ciężarówki po stronie kierowcy, gdyż będziesz potrzebować miejsca po drugiej stronie."

	key[]: "aca_msg_book1_3_16_cutscene5"
	val[]: "Gdy naczepa już znajdzie się w większości na miejscu parkingowym, zacznij skręcać ciężarówką by wjechał za naczepą."

	key[]: "aca_msg_book1_3_16_cutscene6"
	val[]: "Zaparkuj w wyznaczonym obszarze, zabezpiecz ciężarówkę i wyłącz silnik."

#### 3_16 Driving Instructions

	key[]: "aca_msg_book1_3_16_start"
	val[]: "Zaparkuj ciężarówkę na miejscu za sobą. Użyj obu lusterek, aby nawigować, gdy jedziesz tyłem.<br><br><font face=/font/big_bold.font>Przygotuj się do ruszenia. </font>"

	key[]: "aca_msg_book1_3_16_backward"
	val[]: "Sprawdź swoje otoczenie i skieruj się na miejsce parkingowe.<br><br><font face=/font/big_bold.font>Zacznij cofać.</font>"

	key[]: "aca_msg_book1_3_16_check1"
	val[]: "Zacznij poruszać się w kierunku ciężarówek za Tobą. Skręć naczepą w wyznaczone miejsce, kiedy nadejdzie odpowiedni moment. Miej na względzie zachodzenie naczepy.<br><br><font face=/font/big_bold.font>Skręć w wyznaczone miejsce. </font>"
#!{
	key[]: "aca_msg_book1_3_16_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_16_end"
	val[]: "@@aca_msg_book1_2_01_end@@"


 #!}


#@}

#+ Book 1 Scenario 3_17
#@{

#### 3_17 common
	key[]: "aca_scenario_book1_3_17_title"
	val[]: "Cofanie w zakręt"

	key[]: "aca_scenario_book1_3_17_desc"
	val[]: "W tym scenariuszu będziemy po raz pierwszy cofać naczepą w zakręt. Odkryjemy podstawowe zasady cofania i na co uważać podczas skręcania cofając."

#### 3_17 goal

	key[]: "aca_goal_book1_3_17_check1"
	val[]: "Skręcanie naczepy"
#!{
	key[]: "aca_goal_book1_3_17_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_17_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_17_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_17_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
 #!}
#### 3_17 msg - intro text

	key[]: "aca_msg_book1_3_17_cutscene01"
	val[]: "W tym scenariuszu będziesz musiał wycofać na miejsce parkingowe, które jest za Tobą po stronie kierowcy."

	key[]: "aca_msg_book1_3_17_cutscene02"
	val[]: "Oto kilka wskazówek, które pomogą Ci w manewrowaniu naczepą.<br>Pierwsza naczepa zawsze skręca w odwrotnym kierunku niż ciężarówka."

	key[]: "aca_msg_book1_3_17_cutscene03"
	val[]: "Drugim sposobem jest obserwacja osi ciężarówki i naczepy, dzięki czemu można zorientować się, w jakim kierunku zmierza naczepa."

	key[]: "aca_msg_book1_3_17_cutscene04"
	val[]: "Po trzecie, delikatne ruchy to droga do sukcesu, więc postaraj się nie przedobrzyć."

	key[]: "aca_msg_book1_3_17_cutscene05"
	val[]: "Skręć ciężarówką w przeciwną stronę niż wyznaczone miejsce. Naczepa zacznie wtedy skręcać w jego kierunku."

	key[]: "aca_msg_book1_3_17_cutscene06"
	val[]: "Podążaj za naczepą, korygując tor jazdy tak, aby pozostać na właściwym miejscu."

	key[]: "aca_msg_book1_3_17_cutscene07"
	val[]: "Zwracaj uwagę na koła naczepy i tylne koła ciężarówki. Pomogą Ci w ocenie kierunku zmierzania naczepy i popychania jej przez ciężarówkę."

	key[]: "aca_msg_book1_3_17_cutscene08"
	val[]: "Czwarta wskazówka jest taka, że zawsze łatwiej jest skręcić naczepą ostrzej, niż próbować ją wyprostować ze złamania. Celuj w zewnętrzną część miejsca, dopóki się do niego nie zbliżysz, a potem możesz skręcić trochę ostrzej, aby wyrównać naczepę."

	key[]: "aca_msg_book1_3_17_cutscene09"
	val[]: "Gdy naczepa wjeżdża na miejsce parkingowe, ustaw ciężarówkę przed naczepą. Staraj się unikać zbyt wielu korekt wewnątrz miejsca."

	key[]: "aca_msg_book1_3_17_cutscene10"
	val[]: "Wycofaj pomiędzy barierkami, sprawdzając obie strony."

	key[]: "aca_msg_book1_3_17_cutscene11"
	val[]: "Zabezpiecz ciężarówkę i wyłącz silnik."

#### 3_17 Driving Instructions

	key[]: "aca_msg_book1_3_17_start"
	val[]: "Pamiętaj o tych wskazówkach podczas cofania na zakręcie z naczepą:<br><br>- Naczepą skręca w kierunku przeciwnym do tego, w jaki sposób skręcasz ciężarówką<br><br>- Obserwuj koła naczepy, aby zobaczyć, w którą stronę jest skierowana<br><br>- Obserwuj tylne koło ciężarówki, aby zobaczyć, w którą stronę pcha naczepę<br><br>- Pozwól naczepie wykonać całą pracę, nie przesadzaj z ustawianiem jej<br><br>- Zawsze łatwiej jest skręcić naczepą ostrzej, niż ją wyprostować<br><br><font face=/font/big_bold.font>Przygotuj się do ruszenia. </font>"

	key[]: "aca_msg_book1_3_17_backward"
	val[]: "Spójrz za siebie, aby znaleźć miejsce, do którego musisz jechać. Zawsze sprawdzaj otoczenie, zanim zaczniesz cofać.<br><br><font face=/font/big_bold.font>Rozpocznij cofanie w kierunku miejsca parkingowego.</font>"

	key[]: "aca_msg_book1_3_17_check1"
	val[]: "<font face=/font/big_bold.font>Zacznij skręcać naczepą w stronę miejsca parkingowego i jedź jej śladem.</font>"

	key[]: "aca_msg_book1_3_17_stop"
	val[]: "<font face=/font/big_bold.font>Zatrzymaj się w wyznaczonym miejscu. </font>"
#!{
	key[]: "aca_msg_book1_3_17_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_18
#@{

#### 3_18 common
	key[]: "aca_scenario_book1_3_18_title"
	val[]: "Manewr parkowania w alejce"

	key[]: "aca_scenario_book1_3_18_desc"
	val[]: "W tym scenariuszu Twoim zadaniem będzie cofnięcie naczepy do alejki przy małej drodze."

#### 3_18 goal

	key[]: "aca_goal_book1_3_18_check1"
	val[]: "Skręcanie naczepy"
#!{
	key[]: "aca_goal_book1_3_18_start"
