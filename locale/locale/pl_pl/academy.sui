	key[]: "aca_msg_book3_backing_90_tight_forward"
	val[]: "Jedź do przodu do końca placu i zawróć."

	key[]: "aca_msg_book3_backing_90_tight_check1"
	val[]: "Pamiętaj, aby wykonać szeroki skręt."

	key[]: "aca_msg_book3_backing_90_tight_check2"
	val[]: "Jedź dalej do przodu, aż poczujesz, że masz wystarczająco dużo miejsca na manewrowanie, a następnie zacznij cofać."

	key[]: "aca_msg_book3_backing_90_tight_check3"
	val[]: "Cofnij na miejsce parkingowe."

