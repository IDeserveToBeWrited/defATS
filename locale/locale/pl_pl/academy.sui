	key[]: "aca_goal_book1_3_11_check1"
	val[]: "Wjazd na rondo"

	key[]: "aca_goal_book1_3_11_check2"
	val[]: "Jazda na rondzie"

	key[]: "aca_goal_book1_3_11_check3"
	val[]: "Jazda na rondzie"

	key[]: "aca_goal_book1_3_11_check5"
	val[]: "Wyjazd z ronda"

	key[]: "aca_goal_book1_3_11_check6"
	val[]: "Jazda do wyznaczonego obszaru"

#### 3_11 msg - intro text

	key[]: "aca_msg_book1_3_11_cutscene1"
	val[]: "Ronda można coraz częściej spotkać na ulicach Ameryki, dlatego ważne jest, aby wiedzieć, jak z nich korzystać."

	key[]: "aca_msg_book1_3_11_cutscene3"
	val[]: "Pozostań na zewnętrznej stronie pasa, gdy zbliżasz się do ronda. Pomoże to z zachodzeniem naczepy po wewnętrznej."

	key[]: "aca_msg_book1_3_11_cutscene4"
	val[]: "Jedź w kierunku środka ronda, gdy na nie wjedziesz. Następnie będziesz musiał przemieścić się na zewnątrz. W ten sposób utrzymasz naczepę z dala od środka skrzyżowania."

	key[]: "aca_msg_book1_3_11_cutscene5"
	val[]: "Spoglądaj w lusterko, aby upewnić się, że naczepa nie zbliża się zbytnio do środkowych barier."

	key[]: "aca_msg_book1_3_11_cutscene6"
	val[]: "Zjazd z ronda jest dość łatwy, ponieważ naczepa jest już ustawiona z dala od wewnętrznej strony zjazdu. Skręć szeroko na zjeździe, a naczepa powinna podążać za tobą."

	key[]: "aca_msg_book1_3_11_cutscene7"
	val[]: "Zaparkuj w wyznaczonym obszarze i zabezpiecz ciężarówkę."



#### 3_11 Driving Instructions
#!{
	key[]: "aca_msg_book1_3_11_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

	key[]: "aca_msg_book1_3_11_forward"
	val[]: "Przed Tobą znajduje się przygotowane rondo.<br><br><font face=/font/big_bold.font>Zbliż się do niego powoli. </font>"

	key[]: "aca_msg_book1_3_11_check1"
	val[]: "Wykonaj szeroki zakręt podczas wjazdu na rondo, aby naczepa mogła wjechać za Tobą bez przeszkód.<br><br><font face=/font/big_bold.font>Wjedź na rondo. </font>"

	key[]: "aca_msg_book1_3_11_check2"
	val[]: "Jedź w kierunku zewnętrznej krawędzi ronda. Będziesz musiał trzymać ciężarówkę jak najdalej od środka ronda, aby nie ryzykować otarcia naczepą o środkowe bariery.<br><br><font face=/font/big_bold.font>Kontynuuj przez rondo.</font>"

	key[]: "aca_msg_book1_3_11_check3"
	val[]: "Pozostań blisko zewnętrznych pachołków.<br><br><font face=/font/big_bold.font>Kontynuuj jazdę.</font>"

	key[]: "aca_msg_book1_3_11_check5"
	val[]: "<font face=/font/big_bold.font>Zjedź z ronda.</font>"

	key[]: "aca_msg_book1_3_11_check6"
	val[]: "<font face=/font/big_bold.font>Kontynuuj jazdę na miejsce parkingowe przed sobą.</font>"

	key[]: "aca_msg_book1_3_11_stop"
	val[]: "<font face=/font/big_bold.font>Zatrzymaj się w wyznaczonym miejscu.</font>"

	key[]: "aca_msg_book1_3_11_end"
	val[]: "<font face=/font/big_bold.font>Zabezpiecz ciężarówkę i wyłącz silnik.</font>"
#@}

#+ Book 1 Scenario 3_12
#@{

#### 3_12 common
	key[]: "aca_scenario_book1_3_12_title"
	val[]: "Manewrowanie w ciasnej przestrzeni"

	key[]: "aca_scenario_book1_3_12_desc"
	val[]: "W tym scenariuszu będziesz musiał zawrócić ciężarówkę w ciasnej przestrzeni, co będzie wymagało zwrócenia uwagi na otoczenie i inteligentnego wykorzystania przestrzeni."

