#### generic phrase

	key[]: "aca_goal_book1_3_03_chk_point"
	val[]: "Jazda wokół barierek"

#### 3_03 msg - intro text

	key[]: "aca_msg_book1_3_03_cutscene01"
	val[]: "Przed Tobą szereg skomplikowanych zakrętów i przeszkód.<br>Weź pod uwagę wszystko, czego się do tej pory nauczyłeś, a nie powinno to być zbyt trudne."

	key[]: "aca_msg_book1_3_03_cutscene02"
	val[]: "Pierwszy narożnik to łatwy skręt typu „haczyk guzikowy\". Trzymaj się szerokości, a nie powinno to stanowić problemu."

	key[]: "aca_msg_book1_3_03_cutscene03"
	val[]: "Kontynuuj jazdę w kierunku ronda."

	key[]: "aca_msg_book1_3_03_cutscene04"
	val[]: "Trzymaj naczepę z dala od wewnętrznej strony ronda, jadąc ciężarówką tak szeroko, jak to możliwe."

	key[]: "aca_msg_book1_3_03_cutscene05"
	val[]: "Zakręt o 90° w lewo nie jest szczególnie ciasny, ale uważaj, żeby nie uderzyć w żaden pachołek."

	key[]: "aca_msg_book1_3_03_cutscene06"
	val[]: "Ten zakręt jest znacznie ciaśniejszy. Użyj skrętu typu „uchwyt dzbanka”, aby go pokonać."

	key[]: "aca_msg_book1_3_03_cutscene07"
	val[]: "W tym zakręcie możesz skorzystać ze skrętu typu „haczyk guzikowy\", ale po drodze musisz ominąć kilka dodatkowych przeszkód."

	key[]: "aca_msg_book1_3_03_cutscene09"
	val[]: "Ostatni zakręt jest ponownie bardzo ciasny i do jego pokonania konieczne będzie połączenie skrętów typu „uchwyt dzbanka” i typu „haczyk guzikowy\"."

	key[]: "aca_msg_book1_3_03_cutscene10"
	val[]: "Park in the designated area, secure the truck and shut down the engine."


#### 3_03 Driving Instructions



	key[]: "aca_msg_book1_3_03_forward"
	val[]: "<font face=/font/big_bold.font>Przejdź do pierwszego zakrętu. </font>"

	key[]: "aca_msg_book1_3_03_check1"
	val[]: "Pierwszy zakręt to łatwy skręt typu „haczyk guzikowy\".<br><br><font face=/font/big_bold.font><color value=@@clr_txt@@>Kontynuuj skręt.</font>"

	key[]: "aca_msg_book1_3_03_check2"
	val[]: "Kontynuuj jazdę do ronda. Pamiętaj, aby ominąć je szeroką ścieżką.<br><br><font face=/font/big_bold.font>Jedź do ronda i jedź dookoła.</font>"

	key[]: "aca_msg_book1_3_03_check3"
	val[]: "Ten 90° zakręt jest nieco ciaśniejszy, uważaj, żeby nie uderzyć w pachołki.<br><br><font face=/font/big_bold.font>Wykonaj zakręt.</font>"

	key[]: "aca_msg_book1_3_03_check4"
	val[]: "Do tego skrętu najlepiej podejść, stosując skręt typu „uchwyt dzbanka”. Skręć szeroko przed wjazdem na skrzyżowanie.<br><br><font face=/font/big_bold.font>Wykonaj skręt typu „uchwyt dzbanka”.</font>"

	key[]: "aca_msg_book1_3_03_check5"
	val[]: "W tym zakręcie jest mnóstwo przeszkód, ale można go pokonać, używając skrętu typu „haczyk guzikowy\".<br><br><font face=/font/big_bold.font>Postępuj ostrożnie.</font>"

	key[]: "aca_msg_book1_3_03_check6"
	val[]: "To najostrzejszy zakręt, pokonuj go tak, jak uważasz za stosowne.<br><br><font face=/font/big_bold.font>Skręć na parking.</font>"
