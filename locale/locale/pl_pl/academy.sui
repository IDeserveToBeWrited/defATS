#+ Book 1 Scenario 1_02
#@{

#### 1_02 common

	key[]: "aca_scenario_book1_1_02_title"
	val[]: "Sterowanie kamerą"

	key[]: "aca_scenario_book1_1_02_desc"
	val[]: "W tym scenariuszu poznamy różne rodzaje kamer i dowiemy się, jak mogą one pomóc w sterowaniu ciężarówką i manewrowaniu nią."

#### 1_02 goal

	key[]: "aca_goal_book1_1_02_seat"
	val[]: "Pozycja za kierownicą"

	key[]: "aca_goal_book1_1_02_look_back"
	val[]: "Widok do tyłu"

	key[]: "aca_goal_book1_1_02_mirrors"
	val[]: "Sprawdzenie lusterek"

	key[]: "aca_goal_book1_1_02_cam_behind"
	val[]: "Przełącz na kamerę zewnętrzną"

	key[]: "aca_goal_book1_1_02_look_around"
	val[]: "Rozejrzyj się wokół ciężarówki"


#### 1_02 msg - intro text

	key[]: "aca_msg_book1_1_02_cutscene1"
	val[]: "W tym scenariuszu przyjrzymy się różnym dostępnym kamerom,<br>które są dostępne do użycia."

	key[]: "aca_msg_book1_1_02_cutscene2"
	val[]: "Łącznie można wybierać spośród siedmiu kamer. Przyjrzymy się teraz<br> kilku z nich i wyjaśnimy ich funkcje."

	key[]: "aca_msg_book1_1_02_cutscene3"
	val[]: "Różne kamery i ich różne kąty widzenia mogą okazać się pomocne podczas manewrowania w ciasnych miejscach."


#### 1_02 Driving Instructions

	key[]: "aca_msg_book1_1_02_seat"
	val[]: "Patrzenie, dokąd jedziesz, jest podstawą bezpiecznej i profesjonalnej jazdy. Jeśli aktualna pozycja za kierownicą Ci nie odpowiada, możesz ją zmienić w '@@adjust_link_t@@' (dostęp w menu pauzy).<br><br><font face=/font/big_bold.font>Potwierdź, kiedy będziesz gotowy@@imv_nrm_activate@@. </font>"

	key[]: "aca_msg_book1_1_02_look_back"
	val[]: "Podczas cofania lusterka nie zawsze zapewniają wyraźny widok. Może być konieczne spojrzenie przez okno za tobą, aby uzyskać lepszy widok.<br><br><font face=/font/big_bold.font>Obróć kamerę maksymalnie w stronę kierowcy, aby spojrzeć przez okno w stronę tylnej części naczepy.</font>@@aca_goal_tip@@ Musisz być w pojeździe."

	key[]: "aca_msg_book1_1_02_mirrors"
	val[]: "Użyj tego widoku, aby widzieć naczepę podczas manewrów cofania. Zawsze lepiej jest cofać na stronę kierowcy, aby móc wykorzystać ten widok. Cofając na stronę pasażera, masz znacznie bardziej ograniczony widok tego, co dzieje się za tobą.<br><br><font face=/font/big_bold.font>Spójrz w stronę pasażera. </font>"

	key[]: "aca_msg_book1_1_02_cam_behind"
	val[]: "Właśnie dlatego nie zaleca się wykonywania manewru cofania od strony pasażera; jak zauważyłeś, widoczność z tej strony jest ograniczona. Na szczęście masz dostęp do siedmiu kamer zewnętrznych. <br><br>Przycisk @@imv_nrm_camcycle@@ służy do przełączania kamery na następną w kolejności. Po przejściu przez wszystkie siedem kamer, wrócisz do kamery początkowej. <br><br><font face=/font/big_bold.font>Naciśnij @@imv_nrm_camcycle@@, aby przełączyć na kolejną kamerę. </font>"

	key[]: "aca_msg_book1_1_02_look_around"
	val[]: "Kamera zewnętrzna zapewnia najlepszą perspektywę na to, co dzieje się wokół ciężarówki.<br><br><font face=/font/big_bold.font>Rozejrzyj się wokół ciężarówki.</font>"

	key[]: "aca_msg_book1_1_02_cam_top"
	val[]: "<font face=/font/big_bold.font>Naciskając ponownie @@imv_nrm_camcycle@@ możesz przełączyć się na następną kamerę.</font>"

	key[]: "aca_msg_book1_1_02_cam_cabin"
	val[]: "Widok z góry zapewnia doskonałe spojrzenie na sytuację wokół ciężarówki, zdecydowanie ułatwiając parkowanie i jazdę w ciasnych przestrzeniach.<br><br><font face=/font/big_bold.font>Naciśnij @@imv_nrm_camcycle@@, aby przełączyć się na następną kamerę.</font>"

	key[]: "aca_msg_book1_1_02_cam_window"
	val[]: "Kamera z dachu zapewnia doskonałą widoczność na drogę daleko przed ciężarówką bez większych przeszkód.<br><br><font face=/font/big_bold.font>Naciśnij@@imv_nrm_camcycle@@, aby przełączyć się na ostatnią kamerę, na której się teraz skupimy.</font>"

	key[]: "aca_msg_book1_1_02_cam_interior"
	val[]: "Widok z tyłu stanowi skrót do widoku uzyskanego przez Ciebie wcześniej, obróciwszy kamerę wewnętrzną. Jak już wspomnieliśmy, jest on pomocny podczas cofania lub parkowania.<br><br>W grze istnieje więcej kamer, które możesz zobaczyć naciskając kolejno przycisk @@imv_nrm_camcycle@@.<br><br><font face=/font/big_bold.font>Naciśnij @@imv_nrm_cam1@@ aby powrócić do kamery wewnętrznej.</font>"

	key[]: "aca_msg_book1_1_02_end"
	val[]: "For an authentic driving school experience, we recommend staying with the 'Interior Camera' view as you go through each of the scenarios.<br><br><font face=/font/big_bold.font>Press @@imv_nrm_activate@@ to confirm and end the scenario.</font>@@aca_goal_tip@@ You can use the @@o_im_cam_zoom@@ feature for a better view of your surroundings. It's especially helpful when looking through the mirrors. Check the Options Screen - '@@options_bindings_screen@@' - to see and/or change corresponding controls."

#@}

#+ Book 1 Scenario 1_03
#@{

#### 1_03 common
	key[]: "aca_scenario_book1_1_03_title"
	val[]: "Pierwsza jazda"

	key[]: "aca_scenario_book1_1_03_desc"
	val[]: "W tym scenariuszu nauczymy się przygotowania ciężarówki do jazdy, a następnie po raz pierwszy pojedziemy do przodu."

#### 1_03 goal

	key[]: "aca_goal_book1_1_03_electrics"
	val[]: "Włączanie zapłonu"

	key[]: "aca_goal_book1_1_03_start"
	val[]: "Uruchamianie silnika"

	key[]: "aca_goal_book1_1_03_look_mirror"
	val[]: "Sprawdzenie otoczenia"

	key[]: "aca_goal_book1_1_03_brake"
	val[]: "Wciskanie hamulca"

	key[]: "aca_goal_book1_1_03_gear"
	val[]: "Zmiana biegów"

	key[]: "aca_goal_book1_1_03_park_br_off"
	val[]: "Zwalnianie hamulca ręcznego"

	key[]: "aca_goal_book1_1_03_forward"
	val[]: "Jazda do przodu"

	key[]: "aca_goal_book1_1_03_stop"
	val[]: "Zatrzymywanie się"

	key[]: "aca_goal_book1_1_03_park_br_on"
	val[]: "Zaciąganie hamulca ręcznego"

	key[]: "aca_goal_book1_1_03_gear_n"
	val[]: "Zmiana biegu na neutralny"

	key[]: "aca_goal_book1_1_03_end"
	val[]: "Wyłączanie silnika"

#### 1_03 msg - intro text

	key[]: "aca_msg_book1_1_03_cutscene1"
	val[]: "Przez kilka pierwszych przejazdów będziemy używać samego ciągnika siodłowego.<br>Ciężarówkę nazywa się ciągnikiem, gdy nie posiada ona własnej skrzyni ładunkowej, a zamiast tego polega na wykorzystaniu naczepy do transportu towarów i materiałów."

	key[]: "aca_msg_book1_1_03_cutscene2"
	val[]: "Ciężarówki są popularne, ponieważ zapewniają większą wszechstronność: można nimi zostawić pustą naczepę i zabrać załadowaną bez konieczności czekania lub nawet przerzucić się na inny rodzaj naczepy."

	key[]: "aca_msg_book1_1_03_cutscene3"
	val[]: "Podczas pierwszej jazdy Twoim zadaniem będzie jazda do przodu i zatrzymanie się za linią przerywaną.<br>Uruchom silnik, postępuj zgodnie z instrukcjami, aby przygotować ciężarówkę do jazdy. Po przygotowaniu jedź prosto."

	key[]: "aca_msg_book1_1_03_cutscene4"
	val[]: "Przejedź przez przerywaną linię, zatrzymaj się, wyłącz silnik i zabezpiecz ciężarówkę."

#### 1_03 Driving Instructions

	key[]: "aca_msg_book1_1_03_electrics"
	val[]: "Następnym krokiem w Twojej nauce będzie podjechanie ciężarówką po raz pierwszy.<br><br>Oczywiście, nie będziesz w stanie tego zrobić bez włączonego silnika, więc wpierw musisz włączyć zapłon.<br><br><font face=/font/big_bold.font>Naciśnij $input engineelect$, aby włączyć zapłon.</font>@@aca_goal_tip@@ Domyślnie silnik w grze włącza się automatycznie razem z całą aparaturą. Możesz dostosować ten stan rzeczy w opcjach gry w oknie „Rozgrywka” – @@auto_engine_start@@."

	key[]: "aca_msg_book1_1_03_start"
	val[]: "Zapłon aktywuje elektronikę ciężarówki. Być może zauważyłeś, że na desce rozdzielczej migają lampki ostrzegawcze – to normalne. Jeśli pozostają włączone po uruchomieniu silnika, prawdopodobnie oznacza to problem z ciężarówką. Wyjątkiem jest lampka hamulca ręcznego, która zgaśnie, gdy zwolnimy hamulce ręczne.<br><br>Na szczęście ta ciężarówka jest w dobrym stanie i jesteśmy gotowi do działania.<br><br><font face=/font/big_bold.font>Naciśnij @@imv_nrm_engine@@, aby uruchomić silnik.</font>"

	key[]: "aca_msg_book1_1_03_look_mirror"
	val[]: "Teraz, gdy silnik jest już uruchomiony, zanim się ruszysz, należy sprawdzić otoczenie.<br><br><font face=/font/big_bold.font>Rozejrzyj się wokół ciężarówki, a także w lusterkach kierowcy i pasażera, aby upewnić się, że obszar wokół ciężarówki jest czysty.</font>@@aca_goal_tip@@ Musisz znajdować się w środku pojazdu."

	key[]: "aca_msg_book1_1_03_brake"
	val[]: "Może się to wydawać oczywiste, ale przed ruszeniem powinieneś wiedzieć jak się zatrzymać.<br><br><font face=/font/big_bold.font>Aby wcisnąć hamulec, naciśnij $input backward$. </font>"

	key[]: "aca_msg_book1_1_03_gear_arcade"
	val[]: "Teraz dowiesz się jak zmienić kierunek jazdy.<br><br>Nie musisz zmieniać biegów ręcznie, uproszczona automatyczna skrzynia biegów zrobi to za ciebie.<font face=/font/big_bold.font><br><br>Użyj $input forward$, aby wrzucić bieg w przód. </font>"

	key[]: "aca_msg_book1_1_03_gear_automatic"
	val[]: "Teraz dowiesz się jak zmienić kierunek jazdy.<br><br>Używając realistycznej automatycznej skrzyni biegów możesz zmieniać między biegiem do jazdy w przód, neutralnym i wstecznym, tak jak w prawdziwych skrzyniach automatycznych.<br><br><font face=/font/big_bold.font>Naciśnij @@imv_nrm_gearup@@, aby wrzucić bieg do jazdy w przód. </font>"

	key[]: "aca_msg_book1_1_03_gear_manual"
	val[]: "Teraz dowiesz się jak zmienić kierunek jazdy.<br><br>Używając sekwencyjnej skrzyni biegów możesz stopniowo zmieniać biegi jak w prawdziwych skrzyniach sekwencyjnych.<br><br>Zmiana biegów na wyższe podczas jazdy odbywa się w ten sam sposób, co wrzucanie biegu do jazdy w przód.<br><br><font face=/font/big_bold.font>Naciśnij @@imv_nrm_gearup@@,  aby wrzucić pierwszy bieg. </font>"

	key[]: "aca_msg_book1_1_03_gear_direct"
	val[]: "Teraz dowiesz się jak zmienić kierunek jazdy.<br><br>Używając wybieraka biegów i sprzęgła podczas gry, będziesz zmieniał biegi jak w prawdziwej ciężarówce ze skrzynią manualną.<br><br>Wciśnij do końca pedały sprzęgła i hamulca.<font face=/font/big_bold.font>Użyj wybieraka biegów, by wrzucić pierwszy bieg.<color value=@@clr_txt@@>Trzymaj pedały sprzęgła i hamulca wciśnięte.</font>"

	key[]: "aca_msg_book1_1_03_park_br_off"
	val[]: "Aby ruszyć, musisz najpierw zwolnić hamulec ręczny.<br><br><font face=/font/big_bold.font>Użyj @@imv_nrm_parkingbrake@@, aby zwolnić hamulec ręczny.</font> @@aca_goal_tip@@ W trybie kariery hamulec ręczny jest początkowo wyłączony. Możesz dostosować to zachowanie na ekranie opcji - „Rozrywka” - @@auto_park_brake@@."

	key[]: "aca_msg_book1_1_03_forward_arcade"
	val[]: "Teraz ciężarówka jest gotowa do jazdy do przodu. Rozpocznij jazdę i przejedź przez przerywaną linię.<br><br><font face=/font/big_bold.font>Użyj pedału gazu, aby ruszyć: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_automatic"
	val[]: "Teraz ciężarówka jest gotowa do jazdy do przodu. Rozpocznij jazdę i przejedź przez przerywaną linię.<br><br><font face=/font/big_bold.font>Użyj pedału gazu, aby ruszyć: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_manual"
	val[]: "Teraz ciężarówka jest gotowa do jazdy do przodu. Rozpocznij jazdę i przejedź przez przerywaną linię.<br><br><font face=/font/big_bold.font>Użyj pedału gazu, aby ruszyć: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_direct"
	val[]: "Ciężarówka jest gotowa do jazdy w przód. Poruszaj się wzdłuż przerywanej linii.<br><br><font face=/font/big_bold.font>Zwolnij pedał hamulca i zacznij powoli zwalniać pedał sprzęgła, jednocześnie wciskając pedał gazu, utrzymując obroty silnika na poziomie uniemożliwiającym zgaśnięcie silnika. Kiedy pedał sprzęgła jest w pełni zwolniony możesz zacząć przyspieszać i zmieniać biegi na wyższe. </font>"

	key[]: "aca_msg_book1_1_03_stop_arcade"
	val[]: "Wciśnij hamulec, żeby się zatrzymać.<br><br><font face=/font/big_bold.font>Użyj $input backward$, aby zatrzymać ciężarówkę. </font>"

	key[]: "aca_msg_book1_1_03_stop_automatic"
	val[]: "Wciśnij hamulec, żeby się zatrzymać.<br><br><font face=/font/big_bold.font>Użyj $input backward$, aby zatrzymać ciężarówkę. </font>"

	key[]: "aca_msg_book1_1_03_stop_manual"
	val[]: "Wciśnij hamulec, żeby się zatrzymać.<br><br><font face=/font/big_bold.font>Użyj $input backward$, aby zatrzymać ciężarówkę. </font>"

	key[]: "aca_msg_book1_1_03_stop_direct"
	val[]: "Przystępując do zatrzymania, wciśnij pedał sprzęgła <font face=/font/big_bold.font> i zatrzymaj ciężarówkę, używając pedału hamulca. <color value=@@clr_txt@@> Po wrzuceniu biegu jałowego możesz zwolnić pedał sprzęgła. </font>"

	key[]: "aca_msg_book1_1_03_park_br_on"
	val[]: "Teraz zabezpiecz ciężarówkę. Hamulec ręczny zapewnia, że ciężarówka nie ruszy się nieumyślnie po zaparkowaniu.<br><br><font face=/font/big_bold.font>Użyj @@imv_nrm_parkingbrake@@, aby aktywować hamulec ręczny.</font>"

	key[]: "aca_msg_book1_1_03_gear_n_arcade"
	val[]: "Dzięki uproszczonej automatycznej skrzyni biegów nie musisz zmieniać biegów, odbywa się to automatycznie.<br><br><font face=/font/big_bold.font>Naciśnij @@imv_nrm_activate@@, aby potwierdzić.</font>"

	key[]: "aca_msg_book1_1_03_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>Wrzuć bieg neutralny, naciskając @@imv_nrm_geardown@@. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>Wrzuć bieg neutralny, naciskając @@imv_nrm_geardown@@. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>Wrzuć bieg neutralny i puść pedał sprzęgła. </font>"

	key[]: "aca_msg_book1_1_03_end"
	val[]: "Teraz już wiesz, jak ruszyć ciężarówką i bezpiecznie ją zatrzymać. <br><br><font face=/font/big_bold.font>Naciśnij $input engineelect$, aby wyłączyć silnik. </font>"
#@}

#+ Book 1 Scenario 1_04
#@{

#### 1_04 common
	key[]: "aca_scenario_book1_1_04_title"
	val[]: "Cofanie"

	key[]: "aca_scenario_book1_1_04_desc"
	val[]: "W tym scenariuszu spróbujemy cofać po raz pierwszy. Porozmawiamy też o odpowiednim użyciu lusterek, aby zobaczyć co znajduje się z tyłu, na co uważać i jak się przygotować do jazdy wstecz."

#### 1_04 goal

	key[]: "aca_goal_book1_1_04_start"
	val[]: "Uruchamianie silnika"

	key[]: "aca_goal_book1_1_04_look_mirror"
	val[]: "Sprawdzenie lusterka po stronie pasażera"

	key[]: "aca_goal_book1_1_04_look_back"
	val[]: "Sprawdzenie lusterka po stronie kierowcy"

	key[]: "aca_goal_book1_1_04_gear_r"
	val[]: "Zmiana biegów"

	key[]: "aca_goal_book1_1_04_park_br_off"
	val[]: "Zwalnianie hamulca ręcznego"
#!{
	key[]: "aca_goal_book1_1_04_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_1_04_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_1_04_park_br_on"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

#!}
	key[]: "aca_goal_book1_1_04_gear_n"
	val[]: "Zmiana biegu na neutralny"

	key[]: "aca_goal_book1_1_04_end"
	val[]: "Wyłączanie silnika"

#### 1_04 msg - intro text

	key[]: "aca_msg_book1_1_04_cutscene1"
	val[]: "Ten scenariusz obejmuje cofanie w linii prostej. Będziesz musiał wycofać poza przerywaną linię i zatrzymać się."

	key[]: "aca_msg_book1_1_04_cutscene2"
	val[]: "Podczas cofania ciężarówką, konieczne jest stałe rozglądanie się, obserwowanie wszystkich lusterek i upewnianie się, że przestrzeń dookoła i z tyłu jest wolna."

	key[]: "aca_msg_book1_1_04_cutscene3"
	val[]: "Uruchom silnik, wrzuć wsteczny i rozpocznij jazdę."

	key[]: "aca_msg_book1_1_04_cutscene4"
	val[]: "Wycofaj przez przerywaną linię, zatrzymaj się, wyłącz silnik i zabezpiecz ciężarówkę."

#### 1_04 Driving Instructions

	key[]: "aca_msg_book1_1_04_start"
	val[]: "Przygotuj ciężarówkę do jazdy w sposób, w jaki nauczyłeś się tego w poprzednim scenariuszu.<br><br><font face=/font/big_bold.font>Gdy będziesz gotowy, włącz silnik.</font>"

	key[]: "aca_msg_book1_1_04_look_mirror"
	val[]: "Sprawdź lusterka, aby upewnić się, że wokół Ciebie jest pusto. Jeśli nie odpowiada Ci ich ustawienie, możesz je dostosować w '@@adjust_link_t@@'.<br><br><font face=/font/big_bold.font>Spójrz w lusterko po stronie pasażera.</font>@@aca_goal_tip@@ Musisz być w środku pojazdu."

	key[]: "aca_msg_book1_1_04_look_back"
	val[]: "Będziesz się poruszać poza przerywaną linię. Pas jest teraz wolny, lecz podczas normalnej jazdy niezbędne jest, aby stale zerkać w lusterka, by upewnić się, że droga jest wolna.<br><br><font face=/font/big_bold.font>Zerknij na lusterko od strony kierowcy.</font>"

	key[]: "aca_msg_book1_1_04_gear_r_arcade"
	val[]: "<font face=/font/big_bold.font>Użyj $input backward$, aby włączyć bieg wsteczny. </font>@@aca_goal_tip@@ Podczas cofania w większości ciężarówek automatycznie włącza się dźwięk cofania. Możesz go wyłączyć na ekranie opcji - „Dźwięk” - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_automatic"
	val[]: "<font face=/font/big_bold.font>Naciśnij @@imv_nrm_geardown@@, aby włączyć bieg wsteczny. </font>@@aca_goal_tip@@ Podczas cofania w większości ciężarówek automatycznie włącza się dźwięk cofania. Możesz go wyłączyć na ekranie opcji - „Dźwięk” - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_manual"
	val[]: "<font face=/font/big_bold.font>Naciśnij @@imv_nrm_geardown@@, aby włączyć bieg wsteczny. </font>@@aca_goal_tip@@ Podczas cofania w większości ciężarówek automatycznie włącza się dźwięk cofania. Możesz go wyłączyć na ekranie opcji - „Dźwięk” - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_direct"
	val[]: "<font face=/font/big_bold.font>Wciśnij sprzęgło do końca i przesuń dźwignię zmiany biegów na bieg wsteczny. </font>@@aca_goal_tip@@ Podczas cofania w większości ciężarówek automatycznie włącza się dźwięk cofania. Możesz go wyłączyć na ekranie opcji - „Dźwięk” - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_park_br_off"
	val[]: "Włączono teraz bieg wsteczny.<br><br><font face=/font/big_bold.font>Zwolnij hamulec ręczny za pomocą @@imv_nrm_parkingbrake@@. </font>"

	key[]: "aca_msg_book1_1_04_backward_arcade"
	val[]: "Rozpocznij ruch używając $input backward$.<br><br><font face=/font/big_bold.font>Wycofaj się poza linię przerywaną.</font>"

	key[]: "aca_msg_book1_1_04_backward_automatic"
	val[]: "Rozpocznij ruch, używając akceleratora: $input forward$.<br><br><font face=/font/big_bold.font>Cofaj się poza linię przerywaną.</font>"

	key[]: "aca_msg_book1_1_04_backward_manual"
	val[]: "Rozpocznij ruch, używając akceleratora: $input forward$.<br><br><font face=/font/big_bold.font>Cofaj się poza linię przerywaną.</font>"

	key[]: "aca_msg_book1_1_04_backward_direct"
	val[]: "Powoli zwolnij sprzęgło, utrzymując obroty silnika używając pedału gazu.<br><br><font face=/font/big_bold.font>Wycofaj za przerywaną linię.</font>"

	key[]: "aca_msg_book1_1_04_stop_arcade"
	val[]: "<font face=/font/big_bold.font>Zatrzymaj ciężarówkę za pomocą hamulca ręcznego: $input forward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_automatic"
	val[]: "<font face=/font/big_bold.font>Zatrzymaj ciężarówkę za pomocą hamulca ręcznego: $input backward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_manual"
	val[]: "<font face=/font/big_bold.font>Zatrzymaj ciężarówkę za pomocą hamulca ręcznego: $input backward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_direct"
	val[]: "<font face=/font/big_bold.font>Wciśnij sprzęgło do końca, a następnie zatrzymaj ciężarówkę za pomocą hamulca głównego. </font>"

	key[]: "aca_msg_book1_1_04_park_br_on"
	val[]: "<font face=/font/big_bold.font>Aktywuj hamulec ręczny za pomocą @@imv_nrm_parkingbrake@@. </font>"

	key[]: "aca_msg_book1_1_04_gear_n_arcade"
	val[]: "Dzięki uproszczonej automatycznej skrzyni biegów nie ma potrzeby zmiany biegów, ponieważ wszystko odbywa się automatycznie, w przeciwieństwie do rzeczywistości.<br><br><font face=/font/big_bold.font>Naciśnij @@imv_nrm_activate@@, aby potwierdzić.</font>"

	key[]: "aca_msg_book1_1_04_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>Zmień bieg na neutralny, naciskając @@imv_nrm_gearup@@.</font>@@aca_goal_tip@@ Nowoczesne ciężarówki automatycznie zmienią bieg na neutralny po zaciągnięciu hamulca ręcznego. Jednak dobrym nawykiem jest zawsze robienie tego samemu. W poniższych scenariuszach nie będziemy wymagać tego kroku."

	key[]: "aca_msg_book1_1_04_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>Zmień bieg na neutralny, naciskając @@imv_nrm_gearup@@.</font>@@aca_goal_tip@@ Nowoczesne ciężarówki automatycznie zmienią bieg na neutralny po zaciągnięciu hamulca ręcznego. Jednak dobrym nawykiem jest zawsze robienie tego samemu. W poniższych scenariuszach nie będziemy wymagać tego kroku."

	key[]: "aca_msg_book1_1_04_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>Przesuń dźwignię zmiany biegów na bieg neutralny, a następnie zwolnij sprzęgło.</font>@@aca_goal_tip@@ Nowoczesne ciężarówki automatycznie przełączą się na bieg neutralny po zaciągnięciu hamulca ręcznego. Jednak dobrym nawykiem jest zawsze robienie tego samemu. W poniższych scenariuszach nie będziemy wymagać tego kroku."

	key[]: "aca_msg_book1_1_04_end"
	val[]: "Pamiętaj, aby uważać na otoczenie, gdy cofasz, szczególnie w obszarach ze sporym ruchem.<br><br><font face=/font/big_bold.font>Wyłącz silnik, naciskając $input engineelect$. </font>"
#@}

