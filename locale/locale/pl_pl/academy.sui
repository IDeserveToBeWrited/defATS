	key[]: "aca_msg_book3_diag_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_diag_forward"
	val[]: "Jedź w stronę końca rzędu i znajdź swoje miejsce parkingowe."

	key[]: "aca_msg_book3_diag_check1"
	val[]: "Przejedź obok miejsca parkingowego, aby upewnić się, że tylna naczepa wejdzie w nie prawidłowo, a następnie wykonaj gwałtowny skręt, pilnując, by przód pierwszej naczepy nie uderzył w ciężarówkę obok Ciebie."

	key[]: "aca_msg_book3_diag_stop"
	val[]: "Kontynuuj powoli, prostując zestaw, a następnie zatrzymaj się w wyznaczonym obszarze."

