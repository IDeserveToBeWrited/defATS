#### 3_19 msg - intro text

	key[]: "aca_msg_book1_3_19_cutscene01"
	val[]: "Witaj w pierwszej części egzaminu końcowego. Tutaj sprawdzimy, jak dobrze nauczyłeś się kierować ciężarówką, po czasie spędzonym w Akademii."

	key[]: "aca_msg_book1_3_19_cutscene02"
	val[]: "Najpierw podczep naczepę. Następnie będziesz jeździć ciężarówką po całej trasie testowym."

	key[]: "aca_msg_book1_3_19_cutscene03"
	val[]: "Pierwsza część testu prowadzi bocznymi drogami w kierunku centrum miasta."

	key[]: "aca_msg_book1_3_19_cutscene04"
	val[]: "Trasa testu zawiera różnego rodzaju zakręty i przeszkody."

	key[]: "aca_msg_book1_3_19_cutscene05"
	val[]: "Niewielka część trasy przebiega przez centrum miasta."

	key[]: "aca_msg_book1_3_19_cutscene06"
	val[]: "Przetestujemy Twoje umiejętności manewrowania ciężarówką przez różne przeszkody i tory."

	key[]: "aca_msg_book1_3_19_cutscene07"
	val[]: "Spotkasz się z różnymi sytuacjami, które wystawią na próbę Twoją uwagę otoczenia."

	key[]: "aca_msg_book1_3_19_cutscene08"
	val[]: "Cofać będziesz przez obiekt przemysłowy."

	key[]: "aca_msg_book1_3_19_cutscene09"
	val[]: "Po przejechaniu przez drogi, centrum miasta i teren przemysłowy, udasz się do siedziby @@driving_academy@@."

	key[]: "aca_msg_book1_3_19_cutscene10"
	val[]: "Krótki przejazd drogą i już prawie jesteś na miejscu."

	key[]: "aca_msg_book1_3_19_cutscene11"
	val[]: "Aby ukończyć test, musisz zaparkować dokładnie. Możesz wybrać manewr, który najlepiej Ci odpowiada."

	key[]: "aca_msg_book1_3_19_cutscene12"
	val[]: "Nie ma powodu do obaw. Nauczyłeś się już wszystkiego, czego potrzebujesz na zaliczenie.<br><br>Powodzenia!"

#### 3_19 Driving Instructions



	key[]: "aca_msg_book1_3_19_forward"
	val[]: "Najpierw musisz znaleźć i podczepić naczepę. Jest zaparkowana przed Tobą po prawej stronie.<br><br><font face=/font/big_bold.font>Jedź w kierunku naczepy.</font>"

	key[]: "aca_msg_book1_3_19_coupling"
	val[]: "Skręć w lewo, a następnie cofnij w stronę naczepy i ustaw się w jej linii.<br><br><font face=/font/big_bold.font>Cofnij w stronę naczepy.</font>"

	key[]: "aca_msg_book1_3_19_park_br_on"
	val[]: "<font face=/font/big_bold.font>Zabezpiecz ciężarówkę. </font>"

	key[]: "aca_msg_book1_3_19_connect"
	val[]: "<font face=/font/big_bold.font>Naciśnij @@imv_nrm_attach@@, aby podczepić naczepę.</font>"

	key[]: "aca_msg_book1_3_19_park_br_off"
	val[]: "Naczepa jest podłączona, a ciężarówka jest gotowa do jazdy.<br><br><font face=/font/big_bold.font>Zwolnij hamulec ręczny. </font>"

	key[]: "aca_msg_book1_3_19_b_trailer"
	val[]: "Droga została zamknięta na potrzeby naszego testu. Możesz wybrać przestrzeganie lub ignorowanie znaków drogowych, jak uważasz za stosowne.<br><br><font face=/font/big_bold.font>Jedź w kierunku drogi. </font>"

	key[]: "aca_msg_book1_3_19_check01"
	val[]: "Przejdź przez pierwsze kilka zakrętów. <br><br><font face=/font/big_bold.font>Kontynuuj jazdę. </font>"

	key[]: "aca_msg_book1_3_19_check02"
	val[]: "Za następnym zakrętem czeka Cię slalom ustawiony z pachołków drogowych.<br><br><font face=/font/big_bold.font>Uważaj, aby ostrożnie poruszać się między pachołkami drogowymi.</font>"

	#key[]: "aca_msg_book1_3_19_check02a"
	#val[]: "Continue through the roundabout into the town.<br><br><font face=/font/big_bold.font>Negotiate the roundabout.</font>"

	key[]: "aca_msg_book1_3_19_check02b"
	val[]: "Czeka Cię jeszcze kilka zakrętów o 90°. <br><br><font face=/font/big_bold.font>Kontynuuj jazdę. </font>"

	key[]: "aca_msg_book1_3_19_check03"
	val[]: "Następny zakręt jest wyjątkowo ciasny i żeby go pokonać, będziesz musiał przejechać całą drogę.<br><br><font face=/font/big_bold.font>Skręć w prawo i przejedź przez alejkę.</font>"

	key[]: "aca_msg_book1_3_19_check04"
	val[]: "Skręć w lewo z alejki, a następnie skręć w prawo na drogę główną.<br><br><font face=/font/big_bold.font>Kontynuuj jazdę.</font>"

	key[]: "aca_msg_book1_3_19_check05"
	val[]: "Możesz chwilę odpocząć jadąc główną drogą. <br><br><font face=/font/big_bold.font>Jedź prosto. </font>"

	key[]: "aca_msg_book1_3_19_check06"
	val[]: "Na drodze serwisowej znajduje się kilka ostrych zakrętów.<br><br><font face=/font/big_bold.font>Należy ostrożnie pokonywać zakręty.</font>"

	key[]: "aca_msg_book1_3_19_check07"
	val[]: "Wjeżdżasz w bardziej skomplikowany slalom. Jedź powoli i korzystaj z lusterek. <br><br><font face=/font/big_bold.font>Kontynuuj jazdę i ostrożnie pokonuj slalom.</font>"

	key[]: "aca_msg_book1_3_19_check08"
	val[]: "Skręć w lewo do strefy przemysłowej, uważaj na słup oświetleniowy.<br><br><font face=/font/big_bold.font>Skręć w lewo.</font>"

	key[]: "aca_msg_book1_3_19_check09"
	val[]: "Przygotuj się do cofania.<br><br><font face=/font/big_bold.font>Skręć w prawo i zatrzymaj się w wydzielonym obszarze.</font>"

	key[]: "aca_msg_book1_3_19_check10"
	val[]: "Jedź tyłem i podążaj za trasą po lewej stronie za Tobą.<br><br><font face=/font/big_bold.font>Rozpocznij cofanie.</font>"

	key[]: "aca_msg_book1_3_19_check11"
	val[]: "Podążaj w lewo. <br><br><font face=/font/big_bold.font>Kontynuuj cofanie. </font>"

	key[]: "aca_msg_book1_3_19_check12"
	val[]: "<font face=/font/big_bold.font>Jedź prosto i skręć w prawo. </font>"

	key[]: "aca_msg_book1_3_19_check13"
	val[]: "<font face=/font/big_bold.font>Kontynuuj w kierunku bramy. </font>"

	key[]: "aca_msg_book1_3_19_check14"
	val[]: "Poczekaj na otwarcie bramy, a następnie wróć na główną drogę.<br><br><font face=/font/big_bold.font>Kontynuuj jazdę.</font>"

	key[]: "aca_msg_book1_3_19_check15"
	val[]: "Uważaj, żeby nie uderzyć w znak.<br><br><font face=/font/big_bold.font>Skręć i kontynuuj jazdę.</font>"

	key[]: "aca_msg_book1_3_19_check16"
	val[]: "<font face=/font/big_bold.font>Skręć w lewo do Akademii. </font>"

	key[]: "aca_msg_book1_3_19_check17"
	val[]: "<font face=/font/big_bold.font>Kontynuuj prosto.</font>"

	key[]: "aca_msg_book1_3_19_check18"
	val[]: "Trzymaj się zewnętrznej strony, ponieważ za zakrętem znajduje się ostry zakręt.<br><br><font face=/font/big_bold.font>Podążaj za zakrętem.</font>"

	key[]: "aca_msg_book1_3_19_check19"
	val[]: "<font face=/font/big_bold.font>Skręć w lewo i zaparkuj po lewej stronie.</font>"

	key[]: "aca_msg_book1_3_19_check20"
	val[]: "<font face=/font/big_bold.font>Wycofaj na miejsce parkingowe.</font>"
#!{
	key[]: "aca_msg_book1_3_19_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_19_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_19_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
 #!}


#@}


#+ Book 1 Scenario 3_20
#@{

#### 3_20 common
	key[]: "aca_scenario_book1_3_20_title"
	val[]: "Egzamin końcowy (część 2)"

	key[]: "aca_scenario_book1_3_20_desc"
	val[]: "Czeka Cię ostatnia część egzaminu końcowego, w której zostaną ocenione umiejętności parkowania, których nauczyłeś się w poprzednich scenariuszach. Parkuj ostrożnie i dokładnie, a będziesz gotowy wyruszyć na drogi Ameryki jako wykwalifikowany kierowca ciężarówki!"

#### 3_20 goal
#!{
	key[]: "aca_goal_book1_3_20_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_20_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_20_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_20_forward"
	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}


	key[]: "aca_goal_book1_3_20_park1"
	val[]: "Manewr offsetowy"

	key[]: "aca_goal_book1_3_20_park2"
	val[]: "Parkowanie skośne"

	key[]: "aca_goal_book1_3_20_park3"
	val[]: "Jazda przez plac parkingowy"

	key[]: "aca_goal_book1_3_20_park4"
	val[]: "Parkowanie równoległe"

	key[]: "aca_goal_book1_3_20_park5"
	val[]: "Końcowe parkowanie"


#### 3_20 msg - intro text

	key[]: "aca_msg_book1_3_20_cutscene01"
	val[]: "Witamy w drugiej części egzaminu końcowego. Przeniesiemy się na pobliski plac parkingowy i sprawdzimy Twoje umiejętności cofania i manewrowania na miejscach parkingowych."

	key[]: "aca_msg_book1_3_20_cutscene02"
	val[]: "Czeka na Ciebie kilka kolejnych wyzwań parkingowych, w których będziesz mógł sprawdzić swoje umiejętności."

	key[]: "aca_msg_book1_3_20_cutscene03"
	val[]: "Miejsce jest ograniczone, więc zachowaj ostrożność i nie spiesz się."

	key[]: "aca_msg_book1_3_20_cutscene04"
	val[]: "Dobrze wykorzystaj przestrzeń wokół siebie i korzystaj z dostępnych lusterek. Powodzenia!"




#### 3_20 outro text

	key[]: "aca_msg_book1_3_20_outro01"
	val[]: "Congratulations, you've successfully completed the exams for Truck Driving Basics, and learned all the skills necessary to properly manoeuvre your truck."

	key[]: "aca_msg_book1_3_20_outro02"
	val[]: "This is the first step in your journey towards realizing your dream of becoming a professional truck driver."

	key[]: "aca_msg_book1_3_20_outro03"
	val[]: "Jesteś teraz gotów wyruszyć na drogi Ameryki i zmierzyć się z pierwszymi wyzwaniami..."

	key[]: "aca_msg_book1_3_20_outro04"
	val[]: "...but the adventure has just begun."


#### 3_20 Driving Instructions

	key[]: "aca_msg_book1_3_20_start"
	val[]: "Pamiętaj, aby zachować ostrożność i się nie spieszyć. Nic się nie stanie, jeśli nie uda Ci się za pierwszym razem, ważne jest, aby nie uszkodzić ciężarówki ani osób wokół Ciebie. <font face=/font/big_bold.font><br><br>Przygotuj się do ruszenia. </font>"

	key[]: "aca_msg_book1_3_20_forward"
	val[]: "<font face=/font/big_bold.font>Podjedź do przodu na pierwszą część egzaminu.</font>"

	key[]: "aca_msg_book1_3_20_park1"
	val[]: "Twoim pierwszym zadaniem jest zademonstrowanie manewru parkowania offsetowego. Miejsce, w którym musisz cofnąć naczepą, znajduje się po lewej stronie.<br><br><font face=/font/big_bold.font>Wykonaj manewr parkowania offsetowego.</font>"

	key[]: "aca_msg_book1_3_20_park2"
	val[]: "Następnym zadaniem jest wycofanie w szereg stojących ciężarówek. Uważaj, żeby nie uderzyć w inne ciężarówki!<br><br><font face=/font/big_bold.font>Wykonaj manewr parkowania po skosie.</font>"

	key[]: "aca_msg_book1_3_20_park3"
	val[]: "Kontynuuj jazdę przez plac parkingowy. Uważaj na nieoczekiwane sytuacje.<br><br><font face=/font/big_bold.font>Kontynuuj jazdę.</font>"

	key[]: "aca_msg_book1_3_20_park4"
	val[]: "Teraz spróbujmy zaparkować równolegle między dwoma ciężarówkami przy krawężniku przed Tobą.<br><br><font face=/font/big_bold.font>Wykonaj manewr parkowania równoległego.</font>"

	key[]: "aca_msg_book1_3_20_park5"
	val[]: "Ostatni manewr parkowania po lewej! Możesz wybrać, jak chcesz, aby do niego podjechać.<br><br><font face=/font/big_bold.font>Wjedź tyłem na wyznaczony obszar.</font>"

	key[]: "aca_msg_book1_3_20_park6"
	val[]: "Prawie gotowe. Opuść obszar testowy i zaparkuj ciężarówkę.<br><br><font face=/font/big_bold.font>Wyjdź z obszaru testowego po lewej stronie.</font>"

	key[]: "aca_msg_book1_3_20_stop"
	val[]: "Możesz zaparkować ciężarówkę po prawej stronie, razem z innymi.<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_20_end"
	val[]: "@@aca_msg_book1_2_01_end@@"


#!}

#@}


#+ Book 1 Scenario 3_22
#@{

#### 3_22 common
	key[]: "aca_scenario_book1_3_22_title"
	val[]: "Parkowanie równoległe z naczepą"

	key[]: "aca_scenario_book1_3_22_desc"
	val[]: "W tym scenariuszu przyjrzymy się parkowaniu równoległemu z podczepioną naczepą."

#### 3_22 goal


	key[]: "aca_goal_book1_3_22_stopmid"
	val[]: "Zatrzymywanie się w wyznaczonym miejscu"
#!{
	key[]: "aca_goal_book1_3_22_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_22_check1"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_22_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_22_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_22_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
  #!}
#### 3_22 msg - intro text

	key[]: "aca_msg_book1_3_22_cutscene1"
	val[]: "Parkowanie równoległe z naczepą to istotna umiejętność dla każdego kierowcy ciężarówki.<br>Niezależnie od tego, czy parkuje na ulicy w dużym mieście, czy zatrzymuje się na parkingu na wsi, każdy kierowca ciężarówki powinien umieć to zrobić."

	key[]: "aca_msg_book1_3_22_cutscene2"
	val[]: "Gdy przejeżdżasz obok miejsca parkingowego, patrz uważnie by upewnić się, że jest tam dość miejsca na ciężarówkę oraz naczepę. Tutaj upewniliśmy się, że się zmieścisz."

	key[]: "aca_msg_book1_3_22_cutscene3"
	val[]: "Ustaw się w linii z ciężarówką przed miejscem parkingowym. Nie bądź zbyt blisko i zachowaj pewien dystans, aby mieć miejsce do manewru."

	key[]: "aca_msg_book1_3_22_cutscene4"
	val[]: "Skręć stanowczo od miejsca parkingowego i zacznij cofać. Chodzi o to, aby naczepa natychmiast wjechała na miejsce parkingowe."

	key[]: "aca_msg_book1_3_22_cutscene5"
	val[]: "Gdy naczepa jest już dobrze skierowana w tamtą stronę, możesz zacząć podążać za nią."

	key[]: "aca_msg_book1_3_22_cutscene6"
	val[]: "Rozpocznij odjazd naczepy od krawężnika zanim koła naczepy po stronie kierowcy znajdą się na tym miejscu."

	key[]: "aca_msg_book1_3_22_cutscene7"
	val[]: "Wyprostuj ciężarówkę z naczepą, a następnie ustaw się w środku miejsca parkingowego.<br><br>Zaparkuj, wyłącz silnik i zabezpiecz ciężarówkę."

#### 3_22 Driving Instructions

	key[]: "aca_msg_book1_3_22_start"
	val[]: "Możesz dostrzec miejsce parkingowe przed sobą, pomiędzy innymi ciężarówkami. Podczas parkowania nie zapomnij sprawdzić lusterek i zachowaj bezpieczną odległość pomiędzy ciężarówką i przeszkodami wokół.<br><br><font face=/font/big_bold.font>Przygotuj się do ruszenia.</font>"

	key[]: "aca_msg_book1_3_22_check1"
	val[]: "Jedź przez plac, aby znaleźć swoje miejsce parkingowe.<br><br><font face=/font/big_bold.font>Jedź do przodu. </font>"

	key[]: "aca_msg_book1_3_22_stopmid"
	val[]: "<color value=@@clr_white@@>Przejedź obok wybranego miejsca parkingowego do oznaczonego obszaru. Stąd możesz rozpocząć manewr cofania.<br><br><font face=/font/big_bold.font>Zatrzymaj się w oznaczonym obszarze. </font>"

	key[]: "aca_msg_book1_3_22_backward"
	val[]: "Skręć ciężarówką od miejsca, aby zacząć skręcać naczepą w jego kierunku. Nie skręcaj zbyt ostro, bo wjedziesz na krawężnik.<br><br><font face=/font/big_bold.font>Zacznij cofać. </font>"

	key[]: "aca_msg_book1_3_22_stop"
	val[]: "Wyrównaj naczepę z miejscem. W razie potrzeby poruszaj się do przodu lub do tyłu, jednocześnie odpowiednio skręcając, by poprawić swoją pozycję.<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_22_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
 #!}

#@}

#+ Book 1 Scenario 3_21
#@{
#### 3_21 common
	key[]: "aca_scenario_book1_3_21_title"
	val[]: "Cofanie z ustawieniem 45°"

	key[]: "aca_scenario_book1_3_21_desc"
	val[]: "W tym scenariuszu przyjrzymy się ustawieniu 45° przy cofaniu."

#### 3_21 goal
#!{
	key[]: "aca_goal_book1_3_21_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_21_forward"
	val[]: "@@aca_goal_book1_1_03_forward@@"

	key[]: "aca_goal_book1_3_21_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}
	key[]: "aca_goal_book1_3_21_check1"
	val[]: "Punkt kontrolny"

	key[]: "aca_goal_book1_3_21_check2"
	val[]: "Uzyskiwanie odpowiedniej odległości do cofania"

	key[]: "aca_goal_book1_3_21_stop"
	val[]: "Parkowanie w wyznaczonym miejscu"



#### 3_21 msg - intro text

	key[]: "aca_msg_book1_3_21_cutscene1"
	val[]: "W tej lekcji przyjrzymy się parkowaniu pod kątem 45°. Gdy sytuacja na to pozwala, jest to preferowana przez wielu metoda cofania na miejsce parkingowe. Zaczynając z naczepą skierowaną w stronę, w którą chcesz jechać, musisz wykonać mniej manewrów, aby zaparkować."

	key[]: "aca_msg_book1_3_21_cutscene2"
	val[]: "Dzięki takiemu rozwiązaniu możesz zajrzeć głębiej do miejsca parkingowego, co zwiększa Twoją widoczność."

	key[]: "aca_msg_book1_3_21_cutscene3"
	val[]: "Przejedź daleko za miejsce parkingowe i ustaw się pod kątem około 45°. Będziesz chciał, aby Twoja naczepa była skierowana na ciężarówkę po drugiej stronie miejsca parkingowego, do którego zamierzasz cofnąć."

	key[]: "aca_msg_book1_3_21_cutscene4"
	val[]: "Odwróć ciężarówkę od miejsca, aby pociągnąć przód naczepy dookoła, kierując tył w stronę miejsca parkingowego. Uważaj, aby nie przesadzić. Gdy zaczniesz skręcać, łatwiej jest wykonać zakręt ostrzejszy niż go poszerzyć."

	key[]: "aca_msg_book1_3_21_cutscene5"
	val[]: "Kiedy naczepa wjedzie na miejsce parkingowe, ustaw ciężarówkę przed nią i ustaw zestaw."

	key[]: "aca_msg_book1_3_21_cutscene6"
	val[]: "Zatrzymaj się w wyznaczonym miejscu i zabezpiecz ciężarówkę."

#### 3_21 Driving Instructions
#!{
	key[]: "aca_msg_book1_3_21_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

	key[]: "aca_msg_book1_3_21_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
	key[]: "aca_msg_book1_3_21_forward"
	val[]: "Po lewej stronie jest miejsce parkingowe. Przejedź daleko i ustaw się pod kątem 45°.<br><br><font face=/font/big_bold.font>Jedź prosto. </font>"

	key[]: "aca_msg_book1_3_21_check1"
	val[]: "Ustaw ciężarówkę zgodnie z oznaczeniami.<br><br><font face=/font/big_bold.font>Zatrzymaj się w oznaczonym obszarze.</font>"

	key[]: "aca_msg_book1_3_21_check2"
	val[]: "Wykorzystując wiedzę zdobytą w poprzednich scenariuszach, skieruj naczepę na miejsce parkingowe.<br><br><font face=/font/big_bold.font>Rozpocznij cofanie.</font>"

	key[]: "aca_msg_book1_3_21_stop"
	val[]: "Kontynuuj jazdę z naczepą w kierunku miejsca parkingowego.<br><br>@@aca_msg_book1_2_01_stop@@"


#@}

# Book 2 formatting
