#+ Washington TBs and POIs localization.
#@{
	key[]: "tb_wa1"
	val[]: "Półwysep Olympic"

	key[]: "tb_wa1_desc"
	val[]: "Półwysep Olympic ukazuje miejsce, w którym ocean, las i góry współistnieją w nieustannie zmieniającym się pięknie. Mgła unosi się nad skalistym wybrzeżem, a z gór spływają wodospady, podczas gdy w ukrytych dolinach kryją się małe historyczne miasteczka."

	key[]: "poi_wa1_01"
	val[]: "Zabytkowy urząd pocztowy Stanów Zjednoczonych"

	key[]: "poi_wa1_01_desc"
	val[]: "Budynek, ukończony w 1893 roku na skarpie górującej nad nabrzeżem Port Townsend, zaprojektowano jako obiekt federalny mieszczący urząd celny, co odzwierciedlało ówczesne ambicje miasta, by stać się rozwijającym się ośrodkiem handlu międzynarodowego."

	key[]: "poi_wa1_02"
	val[]: "Port Angeles"

	key[]: "poi_wa1_02_desc"
	val[]: "Port Angeles to nadmorskie miasto założone w XIX wieku jako port i punkt zaopatrzeniowy. Obecnie stanowi jedną z głównych bram do Parku Narodowego Olympic oraz jest portem promowym łączącym Stany Zjednoczone z Kanadą."

	key[]: "poi_wa1_03"
	val[]: "Lake Crescent"

	key[]: "poi_wa1_03_desc"
	val[]: "Lake Crescent, drugie pod względem głębokości jezioro w stanie Waszyngton, słynie z intensywnie niebieskiej, krystalicznie czystej wody, co jest efektem niskiego poziomu azotu. Położone na popularnym terenie rekreacyjnym, otoczone jest szlakami i lasami pierwotnymi."
	
	key[]: "poi_wa1_04"
	val[]: "Kalaloch Beach"

	key[]: "poi_wa1_04_desc"
	val[]: "Kalaloch Beach słynie z „Drzewa Życia” – świerka sitkajskiego o odsłoniętych korzeniach rozpiętych nad niewielkim strumieniem biegnącym ku brzegowi. W przeciwieństwie do typowych, wysokich świerków jest niższy, bardziej krępy i ukształtowany przez wiatr, dzięki czemu stanowi wyjątkowy i popularny lokalny punkt orientacyjny."

	key[]: "poi_wa1_05"
	val[]: "Park Narodowy Olympic"

	key[]: "poi_wa1_05_desc"
	val[]: "Park Narodowy Olympic chroni różnorodne ekosystemy, od surowego wybrzeża Pacyfiku i umiarkowanych lasów deszczowych po alpejskie szczyty. Po raz pierwszy objęto go ochroną jako pomnik narodowy w 1909 roku, a w 1938 roku władze federalne nadały mu status parku narodowego."

	key[]: "poi_wa1_06"
	val[]: "Greenhead Slough"

	key[]: "poi_wa1_06_desc"
	val[]: "Greenhead Slough to niewielka zatoczka i kanał na terenach podmokłych, położony wzdłuż autostrady nr 101 w pobliżu zatoki Willapa. Znajduje się on w obrębie przybrzeżnego siedliska estuaryjnego, które zostało zrekultywowane w celu zapewnienia warunków do tarła łososia oraz umożliwienia obserwacji licznych gatunków ptactwa wodnego."

	key[]: "poi_wa1_07"
	val[]: "Zatoka Dabob"

	key[]: "poi_wa1_07_desc"
	val[]: "Zatoka Dabob to głęboki fiord, w którym żyją łososie, skorupiaki i dzikie zwierzęta. Obszar przyrodniczy Zatoki Dabob, utworzony w 1984 roku, chroni rzadkie zbiorowiska roślinne słonych bagien i piaszczystych mierzei w ramach wysoce funkcjonalnego systemu terenów podmokłych podlegających pływom."


##########################################################################################

	key[]: "tb_wa2"
	val[]: "Wnętrze stanu"

	key[]: "tb_wa2_desc"
	val[]: "Wnętrze stanu Waszyngton zaprasza podróżnych na malownicze drogi prowadzące przez wiecznie zielone lasy i spokojne alpejskie jeziora. Mount Rainier góruje nad horyzontem, oferując ikoniczne widoki i spokojną podróż przez naturalne krajobrazy północno-zachodniego wybrzeża Pacyfiku."

	key[]: "poi_wa2_01"
	val[]: "Mount Rainier"

	key[]: "poi_wa2_01_desc"
	val[]: "Mount Rainier, najwyższy szczyt stanu Waszyngton, wznoszący się na wysokość 14 411 stóp, jest czynnym stratowulkanem. Jego lodowce zasilają rzeki, kształtują doliny oraz podtrzymują bogate lasy i siedliska dzikiej przyrody, dzięki czemu góra stanowi niezwykle ważny element naturalnego krajobrazu regionu."

	key[]: "poi_wa2_02"
	val[]: "Wenatchee National Forest"

	key[]: "poi_wa2_02_desc"
	val[]: "Wenatchee National Forest obejmuje góry, rzeki i alpejskie doliny. W 1933 roku członkowie Civilian Conservation Corps wytyczali tu szlaki i budowali wieże obserwacyjne do wykrywania pożarów, pozostawiając trwały ślad w historii rekreacyjnego wykorzystania i ochrony tych terenów."

	key[]: "poi_wa2_03"
	val[]: "Mount Baker–Snoqualmie National Forest"

	key[]: "poi_wa2_03_desc"
	val[]: "Mount Baker–Snoqualmie National Forest obejmuje jedne z najstarszych w Ameryce stanowisk monitorowania lodowców, na których od początku XX wieku śledzi się ruch lodu na obszarach wulkanicznych oraz zmiany klimatu w całych Górach Kaskadowych."
	
	key[]: "poi_wa2_04"
	val[]: "Wenatchee River"

	key[]: "poi_wa2_04_desc"
	val[]: "Wzdłuż rzeki Wenatchee pozostałości kanałów irygacyjnych i młynów z początku XIX wieku pokazują, w jaki sposób osadnicy wykorzystywali jej wody. Na długo przed pojawieniem się europejskich osadników rdzenne plemiona również korzystały z obfitujących w łososie wód rzeki jako źródła pożywienia i podstawy handlu."

	key[]: "poi_wa2_05"
	val[]: "Klawatti Peak"

	key[]: "poi_wa2_05_desc"
	val[]: "Klawatti Peak, zdobyty po raz pierwszy w połowie XX wieku, nadal należy do rzadko zdobywanych szczytów ze względu na strome, pokryte lodowcami zbocza. Stanowi dzięki temu wyjątkowe wyzwanie dla alpinistów szukających odosobnienia w Górach Kaskadowych Północnych."

	key[]: "poi_wa2_06"
	val[]: "Dry Falls Dam"

	key[]: "poi_wa2_06_desc"
	val[]: "Dry Falls Dam, zbudowana w celu regulowania lokalnych cieków wodnych, znajduje się na szczycie prehistorycznych bazaltowych klifów. Kontroluje sezonowe przepływy, a jednocześnie odsłania tarasy i kotły eworsyjne wyrzeźbione przez powodzie z epoki lodowcowej."

	key[]: "poi_wa2_07"
	val[]: "White Mountain Fire Overlook"

	key[]: "poi_wa2_07_desc"
	val[]: "Punkt widokowy wyposażono w tablice informacyjne poświęcone pożarowi White Mountain z 1988 roku – jednemu z największych pożarów lasów w najnowszej historii stanu Waszyngton, ukazujące ślady zniszczeń oraz sposób odradzania się lasu."

	key[]: "wa_cut_helen_desc"
	val[]: "Przed 1980 rokiem Mount St. Helens miała stożkowaty kształt i nazywano ją amerykańską górą Fudżi. Erupcja z 1980 roku obniżyła jej wierzchołek o 1300 stóp, tworząc krater w kształcie podkowy, dziś częściowo wypełniony kopułą lawową i lodowcem."


##########################################################################################


	key[]: "tb_wa3"
	val[]: "Kraina win"

	key[]: "tb_wa3_desc"
	val[]: "Na wschód od Gór Kaskadowych Kraina Win stanu Waszyngton rozciąga się na obszarze Columbia Valley AVA. Region obejmuje Selah Creek, Lewis and Clark State Park oraz tereny historycznie zamieszkiwane przez rdzenną ludność, a jego krajobraz tworzą suche, nasłonecznione tereny z łagodnymi wzgórzami i dolinami rzecznymi."

	key[]: "poi_wa3_01"
	val[]: "Clear Creek Falls"

	key[]: "poi_wa3_01_desc"
	val[]: "Punkt widokowy Clear Creek Falls Overlook jest popularnym miejscem postoju tuż na wschód od przełęczy White Pass Summit. Około mili dalej na wschód znajduje się zjazd prowadzący do Clear Lake Recreation Area, znanego z dobrych warunków do wędkowania i obserwacji miejscowej dzikiej przyrody."

	key[]: "poi_wa3_02"
	val[]: "Selah Creek Bridge"

	key[]: "poi_wa3_02_desc"
	val[]: "Fred G. Redmon Bridge, znany również jako Selah Creek Bridge, to dwułukowy most w hrabstwie Yakima. W chwili ukończenia był najdłuższym betonowym mostem łukowym w Ameryce oraz najwyższym mostem drogowym w stanie Waszyngton."

	key[]: "poi_wa3_03"
	val[]: "Pola winorośli"
	
	key[]: "poi_wa3_03_desc"
	val[]: "Doliny stanu Waszyngton i żyzne gleby sprzyjają uprawie wielu odmian winorośli, w tym Rieslinga, Cabernet i Merlota. Winnice stanowią ważny element rolnictwa stanu i lokalnego krajobrazu."

	key[]: "poi_wa3_04"
	val[]: "Ed Hendler Bridge"

	key[]: "poi_wa3_04_desc"
	val[]: "Most, zbudowany w 1978 roku i nazywany czasem Intercity Bridge, przecina rzekę Columbia, łącząc Pasco i Kennewick w południowo-wschodniej części stanu Waszyngton. Od chwili otwarcia jest uznawany za charakterystyczny obiekt i symbol regionu Tri-Cities."

	key[]: "poi_wa3_05"
	val[]: "Lewis and Clark State Park"

	key[]: "poi_wa3_05_desc"
	val[]: "Lewis and Clark State Park, jeden z pierwszych parków stanowych w stanie Waszyngton, chroni stare lasy położone wzdłuż historycznego szlaku rdzennych mieszkańców. Nazwany na cześć Corps of Discovery, przywołuje obraz gęstych lasów opisywanych przez Meriwethera Lewisa w jego dziennikach."

	key[]: "poi_wa3_06"
	val[]: "Columbia County Courthouse"

	key[]: "poi_wa3_06_desc"
	val[]: "Columbia County Courthouse przypomina czasy, gdy władze hrabstwa odgrywały kluczową rolę w codziennym życiu mieszkańców. W okresie szybkiego rozwoju i ograniczonych kontaktów ze stolicą stanu gmachy sądów stanowiły główny ośrodek lokalnej władzy i zajmowały się najpilniejszymi potrzebami obywateli."

	key[]: "poi_wa3_07"
	val[]: "Rdzenne plemiona Ameryki"

	key[]: "poi_wa3_07_desc"
	val[]: "Dolina Columbia i okoliczne tereny były zamieszkiwane przez rdzenną ludność, w tym plemiona Yakama, Walla Walla i Umatilla. Społeczności te nadal żyją w regionie, podtrzymując swoje tradycje kulturowe oraz zarządzając zasobami ziemi i wody."

##########################################################################################

#@}




#+ Oregon TBs and POIs localization.
#@{
	key[]: "tb_or1"
	val[]: "Wybrzeże Pacyfiku"

	key[]: "tb_or1_desc"
	val[]: "Wybrzeże Pacyfiku w Oregonie rozciąga się wśród surowych przylądków i malowniczych punktów widokowych. Heceta Head Lighthouse góruje nad wzburzonymi falami, a po drodze Silver Point, Ophir Wayside, Sisters Rocks i Kissing Rock wyrastają z bazaltowych klifów nad pacyficznym przybojem."

	key[]: "landmark_or_astoria_b_desc"
	val[]: "Most o długości czterech mil łączy Oregon i Waszyngton, oferując widoki na ujście rzeki Columbia i horyzont Pacyfiku."

	key[]: "poi_or1_01"
	val[]: "Silver Point Interpretive Overlook"

	key[]: "poi_or1_01_desc"
	val[]: "Ten punkt widokowy, położony tuż na południe od Cannon Beach, oferuje panoramiczne widoki na Haystack Rock i surowe wybrzeże, szczególnie efektowne o zachodzie słońca."

	key[]: "or_cut_lighthouse_desc"
	val[]: "Najwyższa latarnia morska w Oregonie, zbudowana w 1873 roku, stoi na bazaltowym cyplu w pobliżu Newport."

	key[]: "or_cut_newport_desc"
	val[]: "Most Yaquina Bay Bridge, ukończony w 1936 roku, jest jednym z najbardziej charakterystycznych obiektów nadmorskich w Oregonie. Zaprojektowany przez słynnego inżyniera Conde’a McCullougha, wyróżnia się eleganckim łukiem rozpiętym nad zatoką Yaquina Bay i do dziś pozostaje jednym z najbardziej rozpoznawalnych elementów trasy U.S. Route 101."

	key[]: "or_cut_thor_desc"
	val[]: "Naturalne zapadlisko na przylądku Cape Perpetua, do którego z impetem wpadają fale, tworząc wrażenie, jakby ocean spływał w głąb ziemi."

	key[]: "poi_or1_02"
	val[]: "Ophir Wayside"

	key[]: "poi_or1_02_desc"
	val[]: "Spokojne miejsce postoju w pobliżu Gold Beach, gdzie można rozprostować nogi, obserwować fale albo przeszukiwać plażę w poszukiwaniu wyrzuconego przez morze drewna i agatów."

	key[]: "poi_or1_03"
	val[]: "Sisters Rock Overlook"

	key[]: "poi_or1_03_desc"
	val[]: "Efektowne ostańce skalne wyrastają z morza u wybrzeża, a szlaki prowadzą w dół do niewielkich plaż ukrytych między klifami."

	key[]: "poi_or1_04"
	val[]: "Kissing Rock"

	key[]: "poi_or1_04_desc"
	val[]: "Przydrożny punkt postoju na południe od Gold Beach, gdzie dwie potężne formacje skalne pochylają się ku sobie nad piaskiem, tworząc popularne miejsce do robienia zdjęć."


##########################################################################################

	key[]: "tb_or2"
	val[]: "Dziki Wschód"

	key[]: "tb_or2_desc"
	val[]: "Region ten, często nazywany „Dzikim Wschodem Oregonu”, ukazuje krajobrazy kształtowane przez siły geologiczne przez setki milionów lat, z których wiele działa do dziś. W zestawieniu z tak ogromną skalą czasu historia człowieka jest krótka, choć naznaczona wydarzeniami równie dramatycznymi jak sam krajobraz."

	key[]: "landmark_or_deadman_p_desc"
	val[]: "W pobliżu Pendleton ten punkt widokowy oferuje widoki na Deadman Pass, której nazwa nawiązuje do wydarzenia z lat 70. XIX wieku, kiedy podczas wojny z Bannockami znaleziono martwego woźnicę. Kilkadziesiąt lat wcześniej przez te wzgórza przejeżdżały niezliczone wozy podążające szlakiem Oregon Trail."

	key[]: "or_cut_395_desc"
	val[]: "Trasa US-395, niegdyś znana jako Three Flags Highway, prowadziła od Kanady aż do Meksyku, łącząc pustynie, lasy i góry. Dziś kończy się przy I-15 w Kalifornii, choć w pobliżu San Diego nadal można znaleźć pozostałości jej pierwotnego przebiegu."

	key[]: "poi_or2_01"
	val[]: "Malheur National Forest"

	key[]: "poi_or2_01_desc"
	val[]: "Malheur National Forest leży w paśmie Blue Mountains. Ponad 150 milionów lat temu niektóre z najstarszych skał tego regionu stanowiły część wulkanicznych wysp na Pacyfiku, które później połączyły się z kontynentem."
	
	key[]: "poi_or2_02"
	val[]: "Badlands Wilderness"

	key[]: "poi_or2_02_desc"
	val[]: "Badlands Wilderness, położony tuż na wschód od Bend, to surowy wulkaniczny krajobraz ukształtowany przez dawne potoki lawy i nawiewany przez wiatr popiół. Poskręcane formacje lawowe, piaszczyste gleby i surowy teren tworzą jeden z najbardziej wyjątkowych wysoko położonych pustynnych krajobrazów w stanie."

	key[]: "poi_or2_03"
	val[]: "Lake Abert"

	key[]: "poi_or2_03_desc"
	val[]: "Lake Abert, po raz pierwszy naniesione na mapy w 1843 roku, od ponad 10 000 lat stanowiło miejsce obecności człowieka. Choć jego wody są zbyt słone dla ryb, jezioro pozostaje ważnym przystankiem dla ptaków migrujących szlakiem Pacific Flyway i w ostatnich dekadach kurczy się wskutek zmian klimatu."

	key[]: "poi_or2_04"
	val[]: "East Steens Tour Route"

	key[]: "poi_or2_04_desc"
	val[]: "East Steens Tour Route prowadzi drogą Highway 78 wzdłuż Steens Mountain i Alvord Desert. Jej największą atrakcją jest playa Alvord Desert, jedno z największych suchych den jeziornych w Oregonie, które w zależności od pory roku zmienia się z płytkiego jeziora w rozległą pustynną równinę."

	key[]: "poi_or2_05"
	val[]: "Doherty Slide"

	key[]: "poi_or2_05_desc"
	val[]: "Przejazd przez Doherty Slide, formację skalną powstałą w wyniku aktywności wulkanicznej, zajmuje mniej niż godzinę. Naturze potrzeba było jednak około 16 milionów lat, by ukształtować ten krajobraz w jego dzisiejszej postaci."


##########################################################################################

	key[]: "tb_or3"
	val[]: "Stan Ogdena"

	key[]: "tb_or3_desc"
	val[]: "Trasa prowadzi śródlądowym korytarzem Oregonu z północy na południe, przez lasy i wysoko położone tereny pustynne. Po raz pierwszy zbadana w latach 20. XIX wieku przez handlarza futrami Petera Skene’a Ogdena, później zyskała strategiczne znaczenie podczas II wojny światowej ze względu na zasoby drewna i szlaki transportowe."
	
	key[]: "poi_or3_01"
	val[]: "Springfield Flame"

	key[]: "poi_or3_01_desc"
	val[]: "Mierząca niemal 65 stóp wysokości rzeźba wyznacza północny wjazd do Springfield. Zaprojektowana w kształcie płomienia, ma służyć jako znak dla podróżnych i charakterystyczny punkt orientacyjny dla mieszkańców oraz turystów."

	key[]: "poi_or3_02"
	val[]: "Santiam Wagon Road"

	key[]: "poi_or3_02_desc"
	val[]: "Przełęcz na wschód stąd, niegdyś nazywana Wiley Pass na cześć Andrew Wileya, została zbadana w 1859 roku przez pionierów poszukujących tras prowadzących na tereny wypasowe. W 1864 roku zaplanowano tu drogę wojskową, jednak w większości nigdy jej nie zbudowano. W latach 1868–1914 działała natomiast płatna Santiam Wagon Road."

	key[]: "poi_or3_03"
	val[]: "Historyczna Droga Weteranów"

	key[]: "poi_or3_03_desc"
	val[]: "Przy północnym wjeździe na trasę, na południe od Biggs Junction, 9 listopada 2012 roku ustawiono ostatnie dwie z 18 tablic pamiątkowych. Wyznaczają one Camp Rufus jako północny punkt wjazdu na pierwszą w kraju drogę poświęconą weteranom II wojny światowej."

	key[]: "poi_or3_04"
	val[]: "Ogden State Scenic Viewpoint"

	key[]: "poi_or3_04_desc"
	val[]: "Punkt widokowy, nazwany na cześć Petera Skene’a Ogdena, XIX-wiecznego odkrywcy i głównego handlarza Hudson’s Bay Company, upamiętnia jego wyprawy po krainie rzeki Snake oraz rolę jednego z pierwszych badaczy Kotliny Wielkiego Jeziora Słonego."

	key[]: "landmark_or_fremont_b_desc"
	val[]: "Most oraz ulica Fremont Street w Portland noszą imię Johna C. Frémonta, jednego z pierwszych badaczy Las Californias i Oregon Country. Most ma najdłuższe główne przęsło w Oregonie i jest drugim najdłuższym na świecie mostem łukowym ze ściągiem."

	
##########################################################################################

#@}



#+ California TBs and POIs localization.
#@{
	key[]: "tb_ca1"
	val[]: "Złoty horyzont"

	key[]: "tb_ca1_desc"
	val[]: "Kultowe mosty wznoszą się nad lśniącymi wodami, łącząc Alcatraz, Santa Cruz oraz wzgórza i dzielnice regionu. Od tętniących życiem ulic i historycznych miejsc po skąpane w słońcu plaże i malownicze wybrzeże, Bay Area oferuje niepowtarzalne kalifornijskie wrażenia."

	key[]: "ca_cut_golden_gate_bridge_desc"
	val[]: "Most łączący zatokę San Francisco z Oceanem Spokojnym jest jednym z najbardziej rozpoznawalnych symboli San Francisco i Kalifornii. W chwili otwarcia w 1937 roku był najdłuższym i najwyższym mostem wiszącym na świecie."

	key[]: "poi_ca1_01"
	val[]: "Alcatraz"

	key[]: "poi_ca1_01_desc"
	val[]: "Na wyspie Alcatraz w latach 1934–1963 działało więzienie federalne. Słynęło z osadzania jednych z najbardziej znanych przestępców w kraju, a dziś jest miejscem historycznym i popularną atrakcją turystyczną."

	key[]: "ca_cut_richmond_desc"
	val[]: "Richmond–San Rafael Bridge przecina zatokę San Francisco, łącząc Richmond z San Rafael. Otwarty w 1956 roku, prowadzi ruch przez północną część zatoki i łączy konstrukcję wspornikową z kratownicową, stanowiąc ważne regionalne połączenie transportowe."
	
	key[]: "poi_ca1_02"
	val[]: "Treasure Island"

	key[]: "poi_ca1_02_desc"
	val[]: "Treasure Island to sztuczna wyspa zbudowana na potrzeby Golden Gate International Exposition w 1939 roku. Po okresie, gdy służyła jako baza marynarki wojennej, jest obecnie przebudowywana z myślą o funkcjach mieszkaniowych i komercyjnych."

	key[]: "poi_ca1_03"
	val[]: "Miasto surfingu"

	key[]: "poi_ca1_03_desc"
	val[]: "Pomnik Surfera w Santa Cruz upamiętnia surfingowe dziedzictwo i kulturę miasta. Ustawiony w pobliżu plaży, oddaje hołd lokalnym surferom oraz sportowi, który ukształtował tożsamość Santa Cruz i jego nadmorskiej społeczności."

	key[]: "poi_ca1_04"
	val[]: "Madonna Inn"

	key[]: "poi_ca1_04_desc"
	val[]: "Niegdyś popularna restauracja i charakterystyczne miejsce organizacji wydarzeń przy szczycie drogi Highway 152. Zamknięta od 2004 roku z powodu problemów związanych z drogą, do dziś często pojawia się w lokalnych opowieściach historycznych i na forach poświęconych historiom o duchach."



##########################################################################################

	key[]: "tb_ca2"
	val[]: "Trasa Shasta"

	key[]: "tb_ca2_desc"
	val[]: "Trasa Shasta wije się przez sosnowe lasy i połyskujące alpejskie jeziora u stóp Mount Shasta. Drogi wznoszą się i opadają, prowadząc przez ukryte doliny na południe, aż góry stopniowo ustępują miejsca pradawnym sekwojom północnej Kalifornii."

	key[]: "poi_ca2_01"
	val[]: "Shasta-Trinity National Forest"

	key[]: "poi_ca2_01_desc"
	val[]: "Shasta-Trinity National Forest, największy obszar tego typu w Kalifornii, przecina malownicza trasa Trinity Heritage Scenic Byway, biegnąca szlakami wykorzystywanymi w XIX wieku przez poszukiwaczy złota i osadników."

	key[]: "poi_ca2_02"
	val[]: "Big Lagoon"

	key[]: "poi_ca2_02_desc"
	val[]: "Big Lagoon to największa i najbardziej wysunięta na południe z trzech lagun w Humboldt Lagoons State Park. Te płytkie przybrzeżne zbiorniki leżą między skalistymi przylądkami, gdzie fale oceanu utworzyły piaszczyste bariery oddzielające laguny od Pacyfiku."

	key[]: "or_cut_sequoia_desc"
	val[]: "Redwood National Park chroni jedne z najwyższych i najstarszych sekwoi wiecznie zielonych na świecie, osiągających ponad 370 stóp wysokości i dożywających nawet 2000 lat. Wraz z pobliskimi parkami stanowymi chroni około 35% pozostałych na świecie starych lasów sekwojowych."
	
	key[]: "poi_ca2_03"
	val[]: "Smith River"

	key[]: "poi_ca2_03_desc"
	val[]: "Na terenie Six Rivers National Forest w północno-zachodniej Kalifornii ten obszar chroniony został ustanowiony przez Kongres w 1990 roku w celu zachowania jego walorów krajobrazowych, ekologicznych i kulturowych. Smith River jest jedyną dużą rzeką w Kalifornii, na której nie zbudowano zapór i która zachowała swobodny przepływ."

	key[]: "poi_ca2_04"
	val[]: "Whiskey Creek Bridge"

	key[]: "poi_ca2_04_desc"
	val[]: "Whiskey Creek Bridge, ukończony w 1961 roku, jest trójprzęsłową konstrukcją zespawaną z blachownic. Wyróżnia się jako wczesny przykład mostu, w którego konstrukcji zastosowano trzy różne gatunki stali, co wiązało się z innowacyjną wówczas techniką spawania."

	key[]: "poi_ca2_05"
	val[]: "Shasta Lake"

	key[]: "poi_ca2_05_desc"
	val[]: "Shasta Lake, największy zbiornik retencyjny w Kalifornii, powstał w wyniku budowy zapory Shasta Dam na rzece Sacramento. Ukończona w 1945 roku zapora zapewnia wodę i energię hydroelektryczną, a jezioro stanowi malownicze miejsce wypoczynku."

	key[]: "poi_ca2_06"
	val[]: "Mount Shasta"

	key[]: "poi_ca2_06_desc"
	val[]: "Od lat 20. XIX wieku Mount Shasta, drugi najwyższy szczyt Gór Kaskadowych, służył jako punkt orientacyjny dla podróżnych przemierzających biegnący u jej podnóża Siskiyou Trail. Trasa ta z czasem przekształciła się w autostradę Interstate 5, którą dziś każdego roku tysiące osób docierają w okolice góry."



##########################################################################################

	key[]: "tb_ca3"
	val[]: "Trasa Sierra Crossing"

	key[]: "tb_ca3_desc"
	val[]: "U podnóża majestatycznych gór Sierra Nevada, pośród otwartych dolin i łagodnych wzgórz, znajduje się Inn at Benton. Trasa Sierra Crossing wije się cichymi drogami przez wysoką pustynię, gdzie odległe szczyty i surowe grzbiety tworzą ponadczasową panoramę, zachęcając podróżnych do odkrywania rozległych krajobrazów regionu."

	key[]: "ca_cut_olmsted_point_desc"
	val[]: "Yosemite National Park, utworzony w 1890 roku, jest jednym z najczęściej odwiedzanych parków. Słynie z Yosemite Falls, najwyższego wodospadu w Ameryce Północnej, rozbudowanej sieci szlaków oraz mamutowców olbrzymich liczących ponad 3000 lat."

	key[]: "poi_ca3_01"
	val[]: "Tioga Road"

	key[]: "poi_ca3_01_desc"
	val[]: "Tioga Road to kultowa malownicza trasa biegnąca przez serce Yosemite National Park. Prowadzi przez najwyżej położoną przełęcz drogową w Kalifornii i łączy zachodnią oraz wschodnią stronę Sierra Nevada."

	key[]: "poi_ca3_02"
	val[]: "Mono Lake"

	key[]: "poi_ca3_02_desc"
	val[]: "Mono Lake ma ponad milion lat, co czyni je jednym z najstarszych jezior w Ameryce Północnej. Ponieważ nie ma naturalnego odpływu, przez tysiące lat gromadziły się w nim sole i minerały nanoszone przez strumienie spływające ze wschodnich stoków Sierra Nevada."
	
	key[]: "poi_ca3_03"
	val[]: "Lake Tahoe"

	key[]: "poi_ca3_03_desc"
	val[]: "Lake Tahoe powstało około 2 milionów lat temu w kotlinie Tahoe Basin, a jego obecny kształt został uformowany przez lodowce epoki lodowcowej. Jest największym jeziorem alpejskim w Ameryce Północnej i drugim pod względem głębokości jeziorem w Stanach Zjednoczonych."

	key[]: "poi_ca3_04"
	val[]: "Eldorado National Forest"

	key[]: "poi_ca3_04_desc"
	val[]: "Eldorado National Forest stanowi część ważnego obszaru zlewni, który dostarcza wodę milionom mieszkańców Kalifornii i wspiera gospodarstwa produkujące niemal połowę owoców i warzyw w kraju."

	key[]: "poi_ca3_05"
	val[]: "Inn at Benton Hot Springs"

	key[]: "poi_ca3_05_desc"
	val[]: "Benton, jedno z najstarszych miasteczek w hrabstwie Mono, zostało założone przez lud Paiute, który korzystał z miejscowych gorących źródeł. W latach 60. XIX wieku stało się przystankiem dla osadników i górników. Obecny zajazd, zbudowany w latach 40. XX wieku z miejscowego pumeksu, zastąpił hotel z 1904 roku, którego 10 pokoi korzystało z jednej wspólnej łazienki."



##########################################################################################

	key[]: "tb_ca4"
	val[]: "Słońce i piasek"

	key[]: "tb_ca4_desc"
	val[]: "Pustynia Doliny Śmierci rozciąga się pod bezkresnym niebem, pośród wydm, poszarpanych szczytów i spękanych równin. Zające wielkouchy przemykają po rozgrzanym słońcem piasku, czaszki znaczą odludne przejścia, a samotne drogi wiją się przez surowy, nieustępliwy krajobraz, który wystawia na próbę i budzi podziw wszystkich, którzy odważą się tu zapuścić."

	key[]: "poi_ca4_01"
	val[]: "Lone Pine"

	key[]: "poi_ca4_01_desc"
	val[]: "Lone Pine to niewielkie miasteczko w kalifornijskiej dolinie Owens Valley, u wschodnich podnóży Sierra Nevada. Znane z pobliskich Alabama Hills, od dawna stanowi bazę wypadową dla wędrowców, wspinaczy i filmowców odkrywających okoliczne góry i pustynne krajobrazy."

	key[]: "poi_ca4_02"
	val[]: "Death Valley National Park"

	key[]: "poi_ca4_02_desc"
	val[]: "Dolina Śmierci to jeden z najbardziej ekstremalnych krajobrazów Ameryki, obejmujący zarówno najniżej położone, jak i niezwykle wysokie, gorące i suche obszary. Na długo przed przybyciem pionierów w XIX wieku żyły tu rdzenne plemiona, polując i zbierając pożywienie w tym surowym, lecz bogatym historycznie regionie."

	key[]: "poi_ca4_03"
	val[]: "Father Crowley Vista Point"

	key[]: "poi_ca4_03_desc"
	val[]: "Ten punkt widokowy jest popularnym miejscem postoju podróżnych. Często zatrzymywał się tu ojciec John J. Crowley, znany jako „Desert Padre”. Położony w pobliżu zachodniej granicy parku, oferuje imponujące widoki na Rainbow Canyon, barwną formację ukształtowaną przez dawną aktywność wulkaniczną."
	
	key[]: "poi_ca4_04"
	val[]: "Mojave Valley Wells"

	key[]: "poi_ca4_04_desc"
	val[]: "W Valley Wells na pustyni Mojave osady powstałe wskutek wypływu wód gruntowych zachowały ślady terenów podmokłych istniejących tu w epoce lodowcowej. Te historyczne studnie pokazują, jak wody gruntowe umożliwiały niegdyś istnienie mokradeł i bujnej roślinności na tym obecnie suchym obszarze pustynnym."

	key[]: "poi_ca4_05"
	val[]: "The Colorado River Indian Reservation"

	key[]: "poi_ca4_05_desc"
	val[]: "Rezerwat rozciąga się wzdłuż rzeki Colorado na terenie Arizony i Kalifornii. Utworzony w 1865 roku dla plemion zamieszkujących okolice rzeki, jest dziś domem dla ludów Mohave, Chemehuevi, Hopi i Navajo oraz miejscem rozwoju rolnictwa i życia lokalnych społeczności."

##########################################################################################

#@}



#+ Idaho TBs and POIs localization.
#@{

    key[]: "tb_id1"
	val[]: "Treasure Valley"

	key[]: "tb_id1_desc"
	val[]: "Treasure Valley w południowo-zachodnim Idaho ma bogatą historię kształtowaną przez rdzenne plemiona, pierwszych handlarzy futrami oraz osadników przemierzających Oregon Trail. Nazwa doliny nawiązuje do bogactw i możliwości oferowanych przez ten region, który później rozwijał się dzięki rolnictwu, kolei i handlowi regionalnemu skupionemu wokół Boise."

	key[]: "poi_id1_01"
	val[]: "Salmon River"

	key[]: "poi_id1_01_desc"
	val[]: "Salmon River w Idaho płynie przez 425 mil głębokim, surowym kanionem. Zyskała przydomek „River of No Return”, ponieważ pierwsze łodzie nie były w stanie płynąć z powrotem w górę rzeki, pokonując jej silny i trudny nurt."

	key[]: "poi_id1_02"
	val[]: "Boise National Forest"

	key[]: "poi_id1_02_desc"
	val[]: "Boise National Forest rozciąga się na podatnym na erozję batolicie Idaho i obejmuje surowy krajobraz ukształtowany przez aktywność wulkaniczną. To geologiczne dziedzictwo najlepiej widać w stromych kanionach oraz licznych naturalnych gorących źródłach rozsianych po całym regionie."

	key[]: "poi_id1_03"
	val[]: "Horseshoe Bend"

	key[]: "poi_id1_03_desc"
	val[]: "Po odkryciu złota w Boise Basin w 1862 roku górnicy zimujący nad rzeką założyli Horseshoe Bend. Początkowo miejscowość nosiła nazwę Warrinersville, od nazwiska miejscowego właściciela tartaku, lecz w 1867 roku otrzymała obecną nazwę, stając się ważnym przystankiem dla poszukiwaczy złota."
	
	key[]: "poi_id1_04"
	val[]: "Toll Gate"

	key[]: "poi_id1_04_desc"
	val[]: "W 1864 roku nowa trasa przez kanion zastąpiła stromy szlak Syrup Creek. Przez 20 lat opłaty za przejazd finansowały jej utrzymanie, a słynny hotel i gospodarstwo mleczne Jamesa A. Portera stały się popularnym miejscem postoju dla podróżnych szukających odpoczynku i schronienia."

	key[]: "poi_id1_05"
	val[]: "Castle Rock"

	key[]: "poi_id1_05_desc"
	val[]: "W pobliżu Camas Prairie granitowe wychodnie Castle Rock służyły jako charakterystyczne punkty orientacyjne dla emigrantów podróżujących szlakiem Oregon Trail przez Goodale’s Cutoff. Trasa ta była używana od 1862 roku aż do nadejścia ery samochodów, a niezwykłe formacje skalne stanowiły efektowny widok dla podróżnych."

    key[]: "poi_id1_06"
	val[]: "Duck Valley Indian Reservation"

	key[]: "poi_id1_06_desc"
	val[]: "W 1886 roku prezydent Cleveland rozszerzył rezerwat Duck Valley na terytorium Idaho w ramach tzw. „Paddy Cap Extension”. Do 1934 roku poszczególne grupy, które przesiedliły się do rezerwatu, uzyskały oficjalne uznanie władz federalnych jako zjednoczone plemiona Shoshone-Paiute."


##########################################################################################

    key[]: "tb_id2"
	val[]: "The Magic Valley"

	key[]: "tb_id2_desc"
	val[]: "Na początku XX wieku I.B. Perrine przekształcił suche pustynne tereny Idaho w ziemie uprawne dzięki budowie Milner Dam. Ukończona w 1905 roku zapora wykorzystywała wodę z rzeki Snake, by niemal „magicznie” odmienić krajobraz. W ten sposób powstała Magic Valley, a wraz z nią prężnie rozwijające się rolnicze miasteczka, które istnieją do dziś."

	key[]: "id_cut_perrine_desc"
	val[]: "Shoshone Falls, mierzący 212 stóp i wyższy od Niagara Falls, to malowniczy punkt orientacyjny nad rzeką Snake, położony tuż na obrzeżach Twin Falls."

	key[]: "id_cut_galena_desc"
	val[]: "Założona w 1879 roku po odkryciu złóż ołowiu i srebra osada górnicza podupadła w latach 90. XIX wieku wraz ze spadkiem cen tych surowców. Dziś okolica jest popularnym ośrodkiem rekreacyjnym, znanym z historycznego Galena Lodge oraz pobliskiej malowniczej przełęczy Galena Summit."

	key[]: "poi_id2_01"
	val[]: "Bison Jump"

	key[]: "poi_id2_01_desc"
	val[]: "Bison Jump w pobliżu Challis to historyczne miejsce, w którym rdzenni mieszkańcy spędzali stada bizonów z urwisk, aby je upolować. Wykorzystywany przez ponad 2000 lat teren pozwala poznać dawne tradycje wspólnotowych polowań."
	
	key[]: "poi_id2_02"
	val[]: "Grand View Canyon"

	key[]: "poi_id2_02_desc"
	val[]: "Grand View Canyon, położony przy trasie Peaks to Craters Scenic Byway biegnącej drogą US-93, oferuje imponujące widoki na pasmo Lost River Range. Znajduje się w nim dziewięć najwyższych szczytów Idaho, dzięki czemu kanion jest jedną z największych atrakcji tej malowniczej trasy."

	key[]: "landmark_id_mackay_rs_desc"
	val[]: "Big Lost River, pierwotnie nazywana Goddin’s River na cześć trapera Thyery’ego Goddina, słynie z tego, że znika w porowatych pokrywach lawowych. Ta „zaginiona” woda płynie pod ziemią, by ostatecznie ponownie wypłynąć w spektakularnym Thousand Springs w pobliżu rzeki Snake."

    key[]: "poi_id2_03"
	val[]: "Miasta widma w okolicach Mackay"

	key[]: "poi_id2_03_desc"
	val[]: "Skupione wokół „Mine Hill” w White Knob Mining District miejscowości takie jak White Knob i Cliff Creek rozwijały się dzięki wydobyciu miedzi, złota i srebra aż do połowy XX wieku. Dziś stanowią ważne pozostałości historycznego przemysłu wydobywczego Idaho."

	key[]: "id_cut_craters_desc"
	val[]: "Craters of the Moon, ukształtowane przez erupcje wulkaniczne 15 000 lat temu, obejmuje rozległy krajobraz potoków lawowych i stożków żużlowych. Ten nieziemski teren jest tak niezwykły, że astronauci NASA wykorzystywali go niegdyś do treningów przed misjami księżycowymi."



##########################################################################################

#@}



#+ Montana TBs and POIs localization.
#@{

    key[]: "tb_mt1"
	val[]: "Szlak lodowców"

	key[]: "tb_mt1_desc"
	val[]: "Glacier Country jest domem dla jednych z ostatnich aktywnych lodowców w Górach Skalistych. Przez tysiące lat te pradawne masy lodu rzeźbiły głębokie doliny, ostre szczyty i dziewicze jeziora, kształtując krajobraz, który dziś wyróżnia zachodnią Montanę."

	key[]: "poi_mt1_01"
	val[]: "Kootenai Falls"

	key[]: "poi_mt1_01_desc"
	val[]: "Kootenai Falls to największy wodospad w Montanie, którego przepływu nie reguluje żadna zapora, i jedna z głównych atrakcji regionu. Na krótkim odcinku rzeka Kootenai obniża się o około 300 stóp, tworząc potężną, malowniczą kaskadę, która przyciąga turystów niezapomnianymi widokami."

	key[]: "poi_mt1_02"
	val[]: "Berne Roadside Park"

	key[]: "poi_mt1_02_desc"
	val[]: "Bad Rock Canyon był popularnym miejscem postoju podróżnych nad rzeką Flathead, znanym z możliwości wędkowania, malowniczych widoków oraz naturalnego źródła, którego wodą chłodzono niegdyś przegrzane chłodnice samochodów. W 1956 roku miejsce to stało się jednym z pierwszych obszarów obsługi podróżnych w Montanie i otrzymało nazwę Berne Roadside Park."

	key[]: "poi_mt1_03"
	val[]: "Heavens Peak"

	key[]: "poi_mt1_03_desc"
	val[]: "Heaven’s Peak, jeden z najbardziej charakterystycznych szczytów Glacier National Park, został nazwany w latach 90. XIX wieku przez poszukiwacza złota Louiego Meyera. Zachwyceni jego pięknem oraz górującą nad okolicą Garden Wall, odkrywcy uznali ten krajobraz za niepodobny do niczego, co wcześniej widzieli podczas swojej podróży."

	key[]: "mt_cut_glacier_national_park_desc"
	val[]: "Glacier National Park, nazywany „Koroną kontynentu”, został utworzony w 1910 roku. Jego krajobraz ukształtowały pradawne lodowce, a w 1932 roku, wraz z ukończeniem Going-to-the-Sun Road, park stał się znacznie łatwiej dostępny. Droga ta jest dziś historycznym zabytkiem inżynierii."

	key[]: "poi_mt1_04"
	val[]: "Blackfeet Indian Memorial"

	key[]: "poi_mt1_04_desc"
	val[]: "Na wschodnim skraju Glacier National Park znajduje się Blackfeet Nation. Blackfeet, znani jako „wojownicy równin”, zawdzięczają swoją nazwę prawdopodobnie mokasynom poczerniałym od popiołu. Do dziś kilka miejsc na terenie parku pozostaje dla nich świętych."

	key[]: "mt_cut_flathead_lake_desc"
	val[]: "Flathead Lake jest największym pod względem powierzchni naturalnym jeziorem słodkowodnym w kontynentalnej części Stanów Zjednoczonych. Zasilane wodą z topniejącego śniegu z okolicznych gór, ma wyjątkowo czystą wodę, która ulega całkowitej wymianie co kilka lat, dzięki czemu należy do najczystszych dużych jezior na świecie."

	key[]: "mt_cut_thompson_falls_desc"
	val[]: "Miasto, nazwane na cześć brytyjsko-kanadyjskiego handlarza futrami i kartografa Davida Thompsona, zaczęło się rozwijać po doprowadzeniu do niego linii kolejowej w 1881 roku. Rozrosło się jeszcze bardziej podczas pobliskiej gorączki złota Coeur d’Alene, stając się ważnym przystankiem dla górników podążających szlakiem Murray Trail."

	key[]: "landmark_mt_missoula_desc"
	val[]: "Neoklasycystyczny Missoula County Courthouse, zbudowany z piaskowca według projektu A.J. Gibsona w 1910 roku, zastąpił wcześniejszy, mniejszy budynek. Hrabstwo Missoula, utworzone w 1860 roku, jest jedną z najstarszych jednostek administracyjnych Montany i rozciąga się od Bitterroot po Góry Skaliste."

    key[]: "poi_mt1_05"
	val[]: "Lolo Creek"

	key[]: "poi_mt1_05_desc"
	val[]: "Korytarz między Lolo a Lolo Pass biegnie historycznym szlakiem wzdłuż Lolo Creek. Niegdyś przemierzali go Nez Perce, pierwsi osadnicy oraz wyprawa Lewisa i Clarka. Do dziś pozostaje ważnym obszarem dziedzictwa kulturowego i historycznego, z licznymi miejscami wyposażonymi w tablice informacyjne."

##########################################################################################

    key[]: "tb_mt2"
	val[]: "Wielkie Równiny"

	key[]: "tb_mt2_desc"
	val[]: "Wielkie Równiny Montany rozciągają się we wschodniej części stanu i charakteryzują się rozległymi terenami trawiastymi, łagodnie pofałdowanymi preriami oraz bezkresnym niebem. W regionie odkryto jedne z najważniejszych skamieniałości dinozaurów w Ameryce Północnej, pozwalające poznać krajobraz, który istniał tu miliony lat temu."

	key[]: "poi_mt2_01"
	val[]: "Formacja Hell Creek"

	key[]: "poi_mt2_01_desc"
	val[]: "Formacja Hell Creek, której główny obszar znajduje się wzdłuż Hell Creek w pobliżu Jordan w stanie Montana, zachowała ślady pradawnego subtropikalnego krajobrazu rzek, lasów i bagien. Datowana na 67–66 milionów lat, słynie na całym świecie z bogactwa skamieniałości dinozaurów, w tym słynnego tyranozaura (Tyrannosaurus rex)."

	key[]: "poi_mt2_02"
	val[]: "Yellowstone River"

	key[]: "poi_mt2_02_desc"
	val[]: "Yellowstone River jest najdłuższą swobodnie płynącą rzeką w kontynentalnej części Stanów Zjednoczonych. Ma swoje źródła w Yellowstone National Park i płynie przez 676 mil przez Wyoming i Montanę, zanim uchodzi do Missouri River. Na całej jej długości nie ma ani jednej zapory."

	key[]: "poi_mt2_03"
	val[]: "Glendisaurus"

	key[]: "poi_mt2_03_desc"
	val[]: "Glendisaurus, naturalnej wielkości pomnik triceratopsa w Glendive, upamiętnia bogate dziedzictwo regionu związane z dinozaurami. Mierzący około 10 stóp wysokości, stanowi popularny punkt orientacyjny na trasie Dinosaur Trail."
	
	key[]: "poi_mt2_04"
	val[]: "Missouri River"

	key[]: "poi_mt2_04_desc"
	val[]: "Missouri River, znana jako „Big Muddy”, jest najdłuższą rzeką w Stanach Zjednoczonych. Płynie przez 2341 mil od Gór Skalistych w Montanie do rzeki Mississippi i odegrała kluczową rolę w eksploracji, handlu oraz ekspansji amerykańskiego pogranicza na zachód."

	key[]: "mt_cut_fort_peck_spillway_desc"
	val[]: "Fort Peck Dam, zbudowana w czasie Wielkiego Kryzysu, jest największą na świecie zaporą ziemną wykonaną metodą namywania hydraulicznego. Ukończona jako jeden z największych projektów robót publicznych w historii Stanów Zjednoczonych, miała zapewnić miejsca pracy, chronić przed powodziami i wytwarzać energię hydroelektryczną."

    key[]: "poi_mt2_05"
	val[]: "Valley County Pioneer Museum"

	key[]: "poi_mt2_05_desc"
	val[]: "Muzeum przedstawia historię północno-wschodniej Montany poprzez ekspozycje poświęcone ludowi Assiniboine, kolei, rolnictwu, zaporze Fort Peck Dam oraz wyprawie Lewisa i Clarka. Mieści również obszerne archiwa i jedną z największych w kraju kolekcji związanych z ludem Assiniboine."

	key[]: "poi_mt2_06"
	val[]: "Sleeping Buffalo Rock"

	key[]: "poi_mt2_06_desc"
	val[]: "Te duże głazy narzutowe miały święte znaczenie dla rdzennych plemion. Zostały ukształtowane i przetransportowane przez pradawne lodowce. Mniejszy głaz, „Buffalo Rock”, został ukształtowany tak, by przypominać bizona, natomiast na większym, „Medicine Rock”, znajdują się liczne petroglify."



##########################################################################################

#@}



#+ Wyoming TBs and POIs localization.
#@{

    key[]: "tb_wy1"
	val[]: "Szlak bizonów"

	key[]: "tb_wy1_desc"
	val[]: "Północno-zachodnia część Wyoming, gdzie znajdują się Yellowstone i Grand Teton, leży na aktywnym systemie wulkanicznym zasilającym gejzery i gorące źródła, a jej szczyty i doliny zostały ukształtowane przez lodowce i uskoki tektoniczne. Wspólne działanie tych sił sprawia, że jest to jeden z najbardziej dynamicznych geologicznie i charakterystycznych krajobrazów amerykańskiego Zachodu."

	key[]: "landmark_wy_yellowsto_desc"
	val[]: "Yellowstone, utworzony w 1872 roku jako pierwszy park narodowy na świecie, leży nad potężnym uśpionym wulkanem. Znajduje się tu około połowy wszystkich aktywnych gejzerów na świecie, a park chroni również jeden z największych i najlepiej zachowanych ekosystemów strefy umiarkowanej na Ziemi."

	key[]: "poi_wy1_01"
	val[]: "Lower Geyser Basin"

	key[]: "poi_wy1_01_desc"
	val[]: "Lower Geyser Basin to największy obszar gejzeralny w Yellowstone, skupiający liczne gejzery, gorące źródła i otwory parowe. Zasilany ciepłem pochodzącym z magmy znajdującej się głęboko pod ziemią, stanowi jeden z najbardziej aktywnych geotermalnie obszarów parku."

	key[]: "poi_wy1_02"
	val[]: "Yellowstone Lake"

	key[]: "poi_wy1_02_desc"
	val[]: "Yellowstone Lake jest największym wysoko położonym jeziorem w Ameryce Północnej i stanowi siedlisko największej na kontynencie populacji dzikich pstrągów cutthroat. Naukowcy sądzą, że niegdyś jego wody odpływały w kierunku Oceanu Spokojnego, co umożliwiało rybom przekraczanie Wielkiego Działu Wodnego przez Two Ocean Pass."
	
	key[]: "poi_wy1_03"
	val[]: "Buffalo Bill Dam"

	key[]: "poi_wy1_03_desc"
	val[]: "Buffalo Bill Dam, ukończona w 1910 roku, była jedną z pierwszych betonowych zapór łukowych w Stanach Zjednoczonych. Mierząca 325 stóp wysokości, była wówczas najwyższą zaporą na świecie i stała się symbolem pionierskich osiągnięć inżynieryjnych."

	key[]: "poi_wy1_04"
	val[]: "Colters Hell"

	key[]: "poi_wy1_04_desc"
	val[]: "Colter’s Hell to historyczny obszar geotermalny nad rzeką Shoshone, nazwany w 1807 roku przez odkrywcę Johna Coltera. Pierwsi traperzy i ludzie gór porównywali jego parujące otwory i siarkowy zapach do „piekła”. Dziś aktywne pozostają jedynie gorące źródła i otwory parowe."

	key[]: "wy_cut_grand_teton_desc"
	val[]: "Grand Teton National Park wyróżnia się szczytami wyrzeźbionymi przez lodowce, które stromo wznoszą się nad doliną Jackson Hole. Traperzy, dla których góry te były dobrze widoczne z równin, nazywali je niegdyś „Pilot Knobs”. Do dziś należą one do najbardziej charakterystycznych symboli amerykańskiego Zachodu."

	key[]: "poi_wy1_05"
	val[]: "Crowheart Butte"

	key[]: "poi_wy1_05_desc"
	val[]: "Crowheart Butte to charakterystyczna formacja skalna, której nazwa nawiązuje do bitwy stoczonej w 1866 roku między plemionami Shoshone i Crow. Według tradycji, po zwycięstwie Shoshone wódz Washakie umieścił na szczycie formacji serce wodza Crow jako ostrzeżenie, nadając temu miejscu nazwę, która przetrwała do dziś."

##########################################################################################

    key[]: "tb_wy2"
	val[]: "Red Desert"

	key[]: "tb_wy2_desc"
	val[]: "Red Desert w Wyoming to rozległa, wysoko położona pustynna kotlina, której krajobraz tworzą piaski ukształtowane przez wiatr, równiny porośnięte bylicą oraz efektowne formacje z czerwonych skał. Jest jednym z największych niezamieszkanych obszarów Ameryki Północnej, ukształtowanym przez surowy klimat, dawne dna jezior i długie szlaki migracyjne."

	key[]: "poi_wy2_01"
	val[]: "Red Canyon"

	key[]: "poi_wy2_01_desc"
	val[]: "Red Canyon powstał podczas wypiętrzania pasma Wind River Range około 60 milionów lat temu. Jego charakterystyczne czerwone klify zbudowane są ze skał Chugwater, których intensywna barwa pochodzi od utlenionego żelaza i stała się inspiracją dla nazwy kanionu."

	key[]: "poi_wy2_02"
	val[]: "Krajobrazy potęgi"

	key[]: "poi_wy2_02_desc"
	val[]: "Boar’s Tusk, wulkaniczna formacja skalna wznosząca się ponad 400 stóp nad Red Desert w Wyoming, jest zerodowanym rdzeniem wulkanu, który powstał miliony lat temu. Góruje nad rozległymi Killpecker Sand Dunes, należącymi do jednego z największych aktywnych pól wydmowych w Ameryce Północnej."

	key[]: "poi_wy2_03"
	val[]: "Rock Springs"

	key[]: "poi_wy2_03_desc"
	val[]: "Rock Springs jest znane jako „Miasto 56 narodowości” ze względu na swoje różnorodne dziedzictwo imigranckie. Pod koniec XIX wieku przybywali tu ludzie z całego świata, by pracować w kopalniach węgla należących do Union Pacific. Miasto jest również związane ze słynnym bandytą Butchem Cassidym."
	
	key[]: "poi_wy2_04"
	val[]: "Chata Butcha Cassidy'ego"

	key[]: "poi_wy2_04_desc"
	val[]: "Butch Cassidy był słynnym amerykańskim bandytą, który przewodził „Wild Bunch”, gangowi znanemu z napadów na pociągi i banki na Dzikim Zachodzie. Przydomek „Butch” zyskał podczas pracy w sklepie mięsnym w Rock Springs. Jego najsłynniejszym napadem był rabunek pociągu w Wilcox w 1899 roku."

	key[]: "wy_cut_evanston_desc"
	val[]: "Evanston zostało założone w 1869 roku przez Union Pacific Railroad i nazwane na cześć geodety Jamesa A. Evansa. Miasto rozwinęło się jako ważny węzeł kolejowy, a później stało się regionalnym ośrodkiem rolnictwa oraz przemysłu naftowego i gazowego."

    key[]: "poi_wy2_05"
	val[]: "Lander Cutoff"

	key[]: "poi_wy2_05_desc"
	val[]: "Lander Cutoff, zbudowana po uchwaleniu Pacific Wagon Road Act z 1857 roku, była jedną z pierwszych dróg dla wozów na amerykańskim Zachodzie finansowanych przez rząd federalny. Nazwana na cześć inżyniera Fredericka W. Landera, zapewniała emigrantom podróżującym na zachód krótszą trasę."

	

##########################################################################################

#@}


#+ South Dakota TBs and POIs localization.
#@{

    key[]: "tb_sd1"
	val[]: "Black Hills"

	key[]: "tb_sd1_desc"
	val[]: "Zachodnią część Dakoty Południowej kształtują Black Hills i Badlands. Rozległe prerie ustępują tu miejsca porośniętym sosnami górom i granitowym iglicom, a po okolicy wędrują stada bizonów. Nieco dalej surowe Badlands odsłaniają niezwykły krajobraz wyrzeźbiony przez wiatr i wodę na przestrzeni milionów lat."

	key[]: "poi_sd1_01"
	val[]: "Black Hills National Forest"

	key[]: "poi_sd1_01_desc"
	val[]: "Region ten, znany Lakotom jako Paha Sapa, czyli „Wzgórza, które są czarne”, porastają rozległe lasy sosnowe. Znajduje się tu Black Elk Peak, najwyższy punkt Dakoty Południowej, wznoszący się na 7244 stopy. Szczyt, przemianowany na cześć słynnego uzdrowiciela Lakotów Black Elka, jest również najwyższym wzniesieniem na wschód od Gór Skalistych."

	key[]: "sd_cut_rush_desc"
	val[]: "Mount Rushmore, znany jako amerykańskie „Sanktuarium Demokracji”, został wykuty w Black Hills w latach 1927–1941. Monument przedstawia mierzące 60 stóp wysokości wizerunki prezydentów Washingtona, Jeffersona, Roosevelta i Lincolna, symbolizujących narodziny, rozwój, umacnianie się i przetrwanie kraju."

	key[]: "poi_sd1_02"
	val[]: "Beaver Creek Bridge"

	key[]: "poi_sd1_02_desc"
	val[]: "Zbudowany w 1929 roku stalowo-betonowy most łukowy o długości 225 stóp przerzucony jest nad kanionem w pobliżu Wind Cave National Park. Wznosi się 115 stóp nad dnem kanionu, jest jedynym tego typu mostem w Dakocie Południowej i został zaprojektowany tak, by harmonijnie wtapiać się w otaczające skały."

	key[]: "sd_cut_sturgis_desc"
	val[]: "Sturgis słynie z organizacji największego na świecie zlotu motocyklowego. Zapoczątkowana w 1938 roku przez lokalnego dealera motocykli Indian, Pappy’ego Hoela, coroczna 10-dniowa impreza przyciąga do Black Hills motocyklistów z całego świata na pokazy motocykli, wyścigi, koncerty i wspólne świętowanie."

	key[]: "sd_cut_deadwood_desc"
	val[]: "Deadwood rozwinęło się podczas gorączki złota w Black Hills w 1876 roku i stało się jednym z najbardziej osławionych miast Dzikiego Zachodu. W 1961 roku uznano je za National Historic Landmark i jest jedynym miastem w Stanach Zjednoczonych o takim statusie. Zachowało znaczną część swojej historycznej zabudowy centrum."

	key[]: "sd_cut_badlands_desc"
	val[]: "Badlands National Park obejmuje 244 000 akrów ostańców, skalnych turni i iglic, a także największy w kraju chroniony obszar prerii mieszanej. Chroni również jedno z najbogatszych na świecie stanowisk skamieniałości, ukazujące pradawne ssaki, które niegdyś przemierzały Wielkie Równiny."

	key[]: "poi_sd1_03"
	val[]: "Doane Robinson Tunnel"

	key[]: "poi_sd1_03_desc"
	val[]: "Doane Robinson, znany jako „Ojciec Mount Rushmore”, wymarzył sobie monumentalny pomnik w Black Hills, który miał przyciągać turystów do Dakoty Południowej. Jego dziedzictwo pozostaje żywe do dziś, a Mount Rushmore jest doskonale widoczny w obramowaniu malowniczego Doane Robinson Tunnel."

	key[]: "sd_cut_hot_springs_desc"
	val[]: "Hot Springs, pierwotnie nazywane przez Siuksów Minnekahta, czyli „gorące wody”, zostało założone w 1879 roku wokół źródeł mineralnych, którym przypisywano właściwości lecznicze. Po zmianie nazwy w 1882 roku miejscowość stała się uzdrowiskiem i do dziś słynie z historycznego Evans Plunge."

	key[]: "poi_sd1_04"
	val[]: "The Mammoth Site"

	key[]: "poi_sd1_04_desc"
	val[]: "The Mammoth Site to słynne na całym świecie stanowisko wykopaliskowe ze skamieniałościami z epoki lodowcowej, na którym odkryto szczątki 61 mamutów. Odkryte w 1974 roku pradawne zapadlisko kryje największe w Ameryce Północnej nagromadzenie szczątków mamutów kolumbijskich, a wykopaliska trwają tam do dziś."

##########################################################################################

    key[]: "tb_sd2"
	val[]: "Wielki podział"

	key[]: "tb_sd2_desc"
	val[]: "Region rzeki Missouri wyznacza naturalny podział środkowej części Dakoty Południowej: po jednej stronie rozciągają się rozległe równiny, a po drugiej łagodne wzgórza. Był ważnym szlakiem dla rdzennych ludów, handlarzy futrami oraz Lewisa i Clarka, a później stał się obszarem wielkich zapór, miasteczek pogranicza i bogatej historii związanej z rzeką."

	key[]: "poi_sd2_01"
	val[]: "Cztery wielkie jeziora"

	key[]: "poi_sd2_01_desc"
	val[]: "Jeziora Oahe, Sharpe, Francis Case i Lewis & Clark, utworzone przez zapory na rzece Missouri pod koniec lat 40. XX wieku, są dziś charakterystycznym elementem krajobrazu środkowej Dakoty Południowej. Łącznie te zbiorniki oferują ponad 440 mil linii brzegowej, wykorzystywanej do żeglowania, wędkowania i rekreacji."

	key[]: "poi_sd2_02"
	val[]: "Miasto widmo Bangor"

	key[]: "poi_sd2_02_desc"
	val[]: "Bangor było niegdyś siedzibą władz hrabstwa Walworth, lecz stało się miastem widmem po przeniesieniu jego budynków do pobliskiego Selby w 1899 roku. Dziś jedynie pomnik wskazuje miejsce, w którym niegdyś znajdowało się miasto."

	key[]: "landmark_sd_state_capitol_desc"
	val[]: "Pierre zostało założone w 1880 roku, a w 1889 roku, gdy Dakota Południowa została przyjęta do Unii, stało się stolicą stanu. Miasto wybrano ze względu na jego centralne położenie i przeprawę przez rzekę Missouri, a nazwę nadano mu na cześć francusko-amerykańskiego handlarza futrami Pierre’a Chouteau Jr."

	key[]: "sd_cut_corn_desc"
	val[]: "Corn Palace w Mitchell jest jedynym na świecie pałacem w całości dekorowanym kukurydzą. Co roku miejscowi artyści i rolnicy tworzą nowe murale z naturalnie barwionych kolb kukurydzy, zbóż i traw, dzięki czemu obiekt należy do najbardziej niezwykłych atrakcji Dakoty Południowej."

	key[]: "landmark_sd_largest_pheasant_desc"
	val[]: "W Huron znajduje się World’s Largest Pheasant, mierząca 40 stóp wysokości rzeźba z włókna szklanego i stali, zbudowana w 1959 roku. Ważąca 22 tony figura nawiązuje do wieloletniej reputacji regionu jako jednego z najlepszych w Ameryce miejsc do polowania na bażanty."

	key[]: "landmark_sd_dignity_of_earth_and_sky_desc"
	val[]: "Dignity of Earth & Sky to mierząca 50 stóp wysokości rzeźba ze stali nierdzewnej, górująca nad rzeką Missouri w pobliżu Chamberlain. Stworzona przez artystę Dale’a Lamphere’a, upamiętnia dziedzictwo, wytrwałość i kulturę ludów Lakota i Dakota."

##########################################################################################

#@}
