#+ Text deviations for American Truck Simulator. Please, use only terms appropriate for USA (i.e. culture specific nuances, not American English).
#@{

#+ Music/radio player
#@{

#+ Hint shown if no music files are found. Also shown as tooltip when hovering over music_player button.

	key[]: "music_player_hint"
	val[]: "Copiez vos musiques dans le dossier <color value=@@clr_sel@@>Euro Truck Simulator 2/music <color value=@@clr_txt@@>présent dans vos <color value=@@clr_sel@@>Documents <color value=@@clr_txt@@>et elles apparaîtront ici."

#+ Tooltip shown when hovering over the radio_stream button.

	key[]: "radio_hint"
	val[]: "Éditez le fichier <color value=@@clr_sel@@>live_streams.sii <color value=@@clr_txt@@>dans le dossier <color value=@@clr_sel@@>Euro Truck Simulator 2 <color value=@@clr_txt@@>présent dans vos <color value=@@clr_sel@@>Documents <color value=@@clr_txt@@>pour écouter vos webradios favorites en jeu !"

#+ Hint shown if no online radio streams are defined.

	key[]: "empty_radio_hint"
	val[]: "Veuillez vous reporter au fichier <color value=@@clr_sel@@>readme.rtf <color value=@@clr_txt@@>dans le dossier <color value=@@clr_sel@@>Euro Truck Simulator 2 <color value=@@clr_txt@@>présent dans vos <color value=@@clr_sel@@>Documents <color value=@@clr_txt@@>pour savoir comment ajouter vos musiques et flux radio."
#@}

