SiiNunit
{
#+ Mails delivered to the player.
#@{

/**
 * Test / debug mails
 */

	mail_text: mailtext.test1 {
		from: "Система" #+ Message sender
		subject: "Пробно съобщение" #+ Message subject
		body: "Здравейте!<br><br>Това е пробно съобщение от вашия администратор ;-)<br><br>Поздрави" #+ Message body
	}

/**
 * Bank mails
 */

	mail_text: mailtext.bank_start {
		from: "Банка" #+ Message sender
		subject: "Нуждаете се от пари? Ние сме насреща!" #+ Message subject
		body: "Уважаеми господине/госпожо,<br><br>Решихме, че може би ще Ви е интересно да знаете, че предлагаме изгодни заеми за нови бизнеси. Нуждаете ли се от финансиране, за да стартирате бизнеса си? Тук сме, за да Ви помогнем! Моля, посетете местния банков център $SHORTCUT1$<link url=screen.bank color=@@clr_link@@>за повече информация.<br><br>С уважение,<br>Мениджър продажби<br>Банка" #+ Message body
	}

	mail_text: mailtext.bank_credit {
		from: "Банка" #+ Message sender
		subject: "Можем да ви помогнем да се разрастнете" #+ Message subject
		body: "Уважаеми господине/госпожо,<br><br>Не можахме да не забележим постоянните Ви доходи и бихме искали да Ви помогнем да развиете още повече потенциала си. Кредитният Ви лимит е увеличен до $MONEY$. Чувствайте се свободни да теглите от наличната сума по всяко време във Вашия $SHORTCUT1$<link url=screen.bank color=@@clr_link@@>местен банков център</link>.<br><br>С уважение,<br>Мениджър продажби<br>Банка" #+ Message body
	}

	mail_text: mailtext.bank_debt0 {
		from: "Банка" #+ Message sender
		subject: "Превишили сте кредитния лимит" #+ Message subject
		body: "Уважаеми клиент,<br><br>Изтеглихте повече пари от Вашата сметка, отколкото има в нея. Ние Ви предоставяме краткосрочен кредит за следващите няколко дни, без наложени допълнителни такси, така че да може да разрешите ситуацията. Моля, любезно да отплатите Вашия кредитен баланс възможно най-скоро.<br><br>С най-добри пожелания,<br>Вашият Акаунт мениджър<br>Банка" #+ Message body
	}

	mail_text: mailtext.bank_debtx {
		from: "Банка" #+ Message sender
		subject: "Имате непогасен овърдрафт!" #+ Message subject
		body: "Уважаеми клиент,<br><br>Балансът по Вашата сметка е отрицателен! Моля, погасете Вашия дълг през следващите $DAYS$ или ще бъдем принудени да конфискуваме имуществото Ви!<br><br>С уважение,<br>Вашият Банков мениджър<br>Банка" #+ Message body
	}

	mail_text: mailtext.bank_debtf {
		from: "Банка" #+ Message sender
		subject: "Последно предупреждение!" #+ Message subject
		body: "Уважаеми клиент,<br><br>Това е последното предупреждение, което получавате от нас. Превишихте кредитния лимит на Вашата банкова сметка. Моля, изплатете задълженията си до утре или ще конфискуваме имущество Ви за покриване на дълга.<br><br>С уважение,<br>Вашият Акаунт мениджър<br>Банка" #+ Message body
	}

	mail_text: mailtext.bank_debtr {
		from: "Банка" #+ Message sender
		subject: "Погасен овърдрафт" #+ Message subject
		body: "Уважаеми господине/госпожо,<br><br>Искаме да ви уведомим, че вашият овърдрафт е погасен. Може да разчитате на нас, ако имате нужда от помощ в бъдеще.<br><br>Приятен ден,<br>Мениджър продажби<br>Банка" #+ Message body
	}

	mail_text: mailtext.bank_sellpt {
		from: "Банка" #+ Message sender
		subject: "Личният ви камион бе продаден" #+ Message subject
		body: "Уважаеми клиент,<br><br>За съжаление, трябва да Ви информирам, че се наложи да продадем Вашия личен камион - $TRUCK_NAME$ - за $MONEY$. Причината е, че, имахте просрочен дълг към нас и нямаше друг начин, по който той да се покрие. Извиняваме се, но нямаме друг избор, освен да прибегнем до крайни мерки. Предлагаме Ви да изпълнявате бързи работи, докато подобрите финансовото си състояние.<br><br>С уважение,<br>Вашият Акаунт мениджър<br>Банка" #+ Message body
	}

	mail_text: mailtext.bank_sellptr {
		from: "Банка" #+ Message sender
		subject: "Личното Ви ремарке бе продадено" #+ Message subject
		body: "Уважаеми клиент,<br><br>Наистина съжаляваме да Ви уведомим за това, че се наложи да продадем личното Ви ремарке - $TRAILER_NAME$ - за сумата от $MONEY$. Причината е, че имахте неизплатен дълг към нашата компания. За съжаление, нямахме друг избор, освен да прибегнем до тези крайни мерки. Ние Ви съветваме временно да започнете бърза работа, за да облекчите финансовото си състояние, докато нещата се подобрят.<br><br>С уважение,<br>Вашият финансов счетоводител<br>Банка" #+ Message body
	}

	mail_text: mailtext.bank_sellrep {
		from: "Банка" #+ Message sender
		subject: "Имуществото Ви бе продадено" #+ Message subject
		body: "Уважаеми клиент,<br><br>Поради неизплатен дълг по сметката Ви, се наложи да отнемем и продадем Вашето имущество. Получените възстановени средства в общата сума от <br>$MONEY$ бяха използвани за уреждане на задълженията, които имате. По-специално, тези части бяха запорирани:<br><br>$ITEM_LIST$<br>Извиняваме се и съжаляваме, че ситуацията толкова се усложни и се надяваме, че последствията няма да попречат на Вашите бъдещи начинания.<br><br>С най-добри пожелания,<br>Вашият Акаунт мениджър<br>Банка" #+ Message body
	}

/**
 * Truck dealer mails
 */

	mail_text: mailtext.td_visit {
		from: "Търговец на камиони - $CITY$" #+ Message sender
		subject: "Налични нови камиони $BRAND$ за продан!" #+ Message subject
		body: "Уважаеми господине/госпожо,<br><br>Ние сме сертифициран търговец на дребно на камиони $BRAND$. Предлагаме широка гама от различни конфигурации и можем да извършим персонализации, за да отговорим на вашите специални желания. Моля, $SHORTCUT1$<link url=truck.dealer_map color=@@clr_link@@>посетете нашия шоурум в $CITY$</link>. Камионът, за който винаги сте мечтали, може би ви чака точно зад вратата.<br><br>С най-добри пожелания,<br>Вашият дилър на камиони $BRAND$" #+ Message body
	}

/**
 * Used truck dealer mails
 */

	mail_text: mailtext.used_teaser {
		from: "Търговец на употребявани камиони" #+ Message sender
		subject: "Продавам употребявани камиони!" #+ Message subject
		body: "Уважаеми господине/госпожо,<br><br>С вълнение обявяваме откриването на нашия дилър на употребявани камиони, вашата най-нова дестинация за висококачествени употребявани камиони! Независимо дали търсите мощна машина или просто надежден работен кон, ние имаме перфектния камион за вас.<br><br>Моля, разгледайте нашите $SHORTCUT1$<link url=truck.eshop.used_trucks color=@@clr_link@@>предложения за употребявани камиони</link>. Вярваме, че ще намерите перфектния камион, който отговаря на вашите нужди.<br><br>С уважение,<br><br>Екипът на дилъра на употребявани камиони<br><br>П.С. Не забравяйте да проверявате често за нови постъпления! Нашите наличности се променят постоянно, така че никога не знаете каква сделка може да намерите." #+ Message body
	}

/**
 * Company mails
 */

	mail_text: mailtext.comp_teaser {
		from: "$COMPANY$, $CITY$" #+ Message sender
		subject: "Търсят се шофьори със собствена техника" #+ Message subject
		body: "Ако изявявате интерес,<br><br>Ние търсим опитни шофьори със собствени камиони за голям брой доставки. Предлагаме конкурентно заплащане до $MONEY$ за свършена работа. Моля, ако притежавате собствен камион, заповядайте на събеседване в нашия док в $CITY$. <br><br>$COMPANY$,<br>$CITY$" #+ Message body
	}

/**
 * Driver mails
 */

	mail_text: mailtext.drv_idle {
		from: "Шофьор $NAME$" #+ Message sender
		subject: "Нуждая се от камион" #+ Message subject
		body: "Здравейте, шефе,<br><br>Не знам дали сте забелязали, но съм заточен в $CITY$ без работа вече от $DAYS$. Започвам да се притеснявам, защото ми трябват пари, за да платя сметките си, а не мога да изкарам пукнат грош, ако продължавам да бездействам. Моля, да ми осигурите камион през следващите $DAYS2$, за да вляза в ритъм, иначе нямам друг избор, освен да напусна компанията.<br><br>$NAME$" #+ Message body
	}

	mail_text: mailtext.drv_idle.female {
		from: "Шофьор $NAME$" #+ Message sender - written by female
		subject: "Нуждая се от камион" #+ Message subject - written by female
		body: "Здравейте.<br><br>Имам един проблем. От $DAYS$ стоя в гаража в $CITY$ без работа. Това започва да ме тревожи, защото трябва да платя сметките си, а нямам камион и не мога да работя. Моля да намерите някакво решение в близките $DAYS2$, иначе ще трябва да напусна компанията.<br><br>$NAME$" #+ Message body - written by female
	}

	mail_text: mailtext.drv_quit {
		from: "Шофьор $NAME$" #+ Message sender
		subject: "Довиждане" #+ Message subject
		body: "Здравейте,<br><br>Не мога да позволя да си губя времето повече и да стоя в гаража без камион и работа. Досега пропуснах немалко добри възможности, затова реших да напусна Вашата компания и да пробвам късмета си другаде. Можете да намерите сдаденото от мен оборудване в гаража в $CITY$.<br><br>Довиждане,<br>$NAME$" #+ Message body
	}

	mail_text: mailtext.drv_quit.female {
		from: "Шофьор $NAME$" #+ Message sender - written by female
		subject: "Довиждане" #+ Message subject - written by female
		body: "Здравейте,<br><br>Не мога да позволя да си губя времето повече и да стоя в гаража без камион и работа. Досега пропуснах немалко добри възможности, затова реших да напусна Вашата компания и да пробвам късмета си другаде. Можете да намерите сдаденото от мен оборудване в гаража в $CITY$.<br><br>Довиждане,<br>$NAME$" #+ Message body - written by female
	}

	mail_text: mailtext.drv_wear {
		from: "Шофьор $NAME$" #+ Message sender
		subject: "Моят камион се нуждае от основен ремонт" #+ Message subject
		body: "Здравей шефе,<br><br>Знам, че си зает, но моят камион се нуждае от основен ремонт. Той е твърде стар и износен, за да шофира безопасно повече. Вече съм без работа от $DAYS$ и честно казано съм доста разочарован/на, защото трябва да плащам сметките и не мога без безопасно пътуване. Моля, можете ли да ми вземете нов камион или да ремонтирате този, за да мога да се върна на работа, в противен случай няма да имам друг избор, освен да ви напусна.<br><br>$NAME$" #+ Message body
	}

	mail_text: mailtext.drv_wear.female {
		from: "Шофьор $NAME$" #+ Message sender - written by female
		subject: "Моят камион се нуждае от основен ремонт" #+ Message subject - written by female
		body: "Здравей шефе,<br><br>Знам, че си зает, но моят камион се нуждае от основен ремонт. Той е твърде стар и износен, за да шофира безопасно повече. Вече съм без работа от $DAYS$ и честно казано съм доста разочарован/на, защото трябва да плащам сметките и не мога без безопасно пътуване. Моля, можете ли да ми вземете нов камион или да ремонтирате този, за да мога да се върна на работа, в противен случай няма да имам друг избор, освен да ви напусна.<br><br>$NAME$" #+ Message body - written by female
	}

	mail_text: mailtext.drv_wear_qui {
		from: "Шофьор $NAME$" #+ Message sender
		subject: "Довиждане" #+ Message subject
		body: "Здравейте,<br><br>Съжалявам, че го казвам, но камионът ми се разпада поради износване и нямам време. Нямам работа и разходите ми растат, така че трябва да продължа напред. Препоръчвам основен ремот преди следващия шофьор. Можете да намерите всеки повреден камион в бившия ми гараж в $CITY$.<br><br> Аста Ла виста шефе.<br>$NAME$" #+ Message body
	}

	mail_text: mailtext.drv_wear_qui.female {
		from: "Шофьор $NAME$" #+ Message sender - written by female
		subject: "Сбогом" #+ Message subject - written by female
		body: "Здравейте,<br><br>Съжалявам, че го казвам, но камионът ми се разпада поради износване и нямам време. Нямам работа и разходите ми растат, така че трябва да продължа напред. Препоръчвам основен ремонт преди следващия шофьор. Можете да намерите всеки повреден камион в бившия ми гараж в $CITY$.<br><br>Сбогом.<br>$NAME$" #+ Message body - written by female
	}

	mail_text: mailtext.drv_sold {
		from: "Шофьор $NAME$" #+ Message sender
		subject: "Напускам" #+ Message subject
		body: "Здравейте, шефе,<br><br>Гаражът в $CITY$, където бях назначен, ще бъде затворен. Някакви хора от банката дойдоха и казаха, че трябва да се изнеса незабавно. Изглежда, компанията Ви не се справя много добре напоследък. Така че реших да напусна. Няма да мога да направя нищо, както и да е - без камион и в това положение. Ще си търся нова работа другаде.<br><br>Благодаря и всичко хубаво,<br>$NAME$" #+ Message body
	}

	mail_text: mailtext.drv_sold.female {
		from: "Шофьор $NAME$" #+ Message sender - written by female
		subject: "Напускам" #+ Message subject - written by female
		body: "Здравейте,<br><br>Гаражът в $CITY$, където бях назначена, ще бъде затворен. Някакви хора от банката дойдоха и казаха, че трябва да се изнеса. Изглежда компанията ви е в затруднение, затова реших да напусна. Така или иначе нямам камион и бездействам. Ще си търся нова работа другаде.<br><br>Благодаря и всичко хубаво,<br>$NAME$" #+ Message body - written by female
	}

/**
 * Oversize
 */

	mail_text: mailtext.ovs.new_routes {
		from: "Диспечер" #+ Message sender
		subject: "Извънгабаритни превози" #+ Message subject
		body: "Здравей, шефе.<br><br>Имам нещо специално за теб. Благодарение на нашите връзки, сега сме в състояние да се справим с истинско предизвикателство. Някои специални, изключително големи и тежки товари трябва да бъдат теглени от истински професионалист. Няма да е лесно и ще изисква известни умения, търпение, сътрудничество с превозни средства за ескорт и допълнителни грижи, но предполагам, че имате всичко, нали? Освен това по-големият риск идва с по-голяма печалба.<br><br>Ако се интересувате, можете да посетите тези градове:<br><br>$CITIES$" #+ Message body
	}
	
	mail_text: mailtext.ovs.upd_routes {
		from: "Диспечeр" #+ Message sender
		subject: "Нови извънгабаритни превози" #+ Message subject
		body: "Здравей шефе.<br><br>Повече компании биха искали да наемат професионалните ти умения зад волана за някои специални доставки. Както миналия път - няма да е лесно и ще изисква някои умения, търпение, сътрудничество с придружаващите превозни средства и допълнителни грижи, но предполагам, че все още имате всичко, нали? И не забравяйте - все още има по-голяма печалба за тези товари.<br><br>Заедно с наличните в момента работни места за специален транспорт на:<br><br>$OLD_CITIES$<br><br>Вече можете също да вземете <color value=@@clr_sel@@>нови<color value=@@clr_txt@@> на:<br><br>$CITIES$" #+ Message body
	}

/**
 * Real Estate mail
 */
 	mail_text: mailtext.real_estate {
		from: "Агенция за недвижими имоти" #+ Message sender
		subject: "Желаете ли да разширите компанията си?" #+ Message subject
		body: "Уважаеми господине/госпожо,<br><br>Бихме искали да Ви поздравим за напредъка на Вашата компания. Впечатлени сме от успеха на Вашия бизнес и бихме искали да Ви предложим нов начин да помогнете на компанията си да се разшири допълнително. Отсега нататък можете да използвате нашите услуги, за да закупите допълнителни имоти почти мигновено! За повече информация, моля, посетете нашата страница за недвижими имоти $SHORTCUT1$<link url=screen.real_estate color=@@clr_link@@>на <br><br>С уважение,<br>Мениджър „Връзки с клиенти“<br>Агенция за недвижими имоти" #+ Message body
	}
	
#@}
}