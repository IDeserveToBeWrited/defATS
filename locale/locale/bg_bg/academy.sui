#+ Book 1 Scenario 3_16
#@{

#### 3_16 common
	key[]: "aca_scenario_book1_3_16_title"
	val[]: "Диагонално паркиране на заден ход"

	key[]: "aca_scenario_book1_3_16_desc"
	val[]: "В този сценарий ще изследваме паркирането по диагонал при движение на заден ход. Това може да се случи на места за почивка, спирки на камиони и дори при изпращачи. Често има малко място, защото местата са претъпкани с камиони, така че паркирането е още по-трудно поради липсата на място."

#### 3_16 goal

	key[]: "aca_goal_book1_3_16_check1"
	val[]: "Завъртане на ремаркето"
#!{
	key[]: "aca_goal_book1_3_16_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_16_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_16_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_16_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
 #!}
#### 3_16 msg - intro text

	key[]: "aca_msg_book1_3_16_cutscene1"
	val[]: "Диагоналното паркиране изглежда по-лесно на пръв поглед, но често може да бъде по-предизвикателно от типичните маневри за „паркиране по алея“."

	key[]: "aca_msg_book1_3_16_cutscene2"
	val[]: "На заден ход към мястото за паркиране. Дръжте камиона и ремаркето прави засега."

	key[]: "aca_msg_book1_3_16_cutscene3"
	val[]: "Когато се приближите, оставете ремаркето си да се доближи до паркираните камиони. Това ще ви помогне да го превърнете в място, когато го достигнете."

	key[]: "aca_msg_book1_3_16_cutscene4"
	val[]: "Започнете да завъртате ремаркето в мястото за паркиране. Дръжте ремаркето си близо до камиона от страната на шофьора, тъй като ще имате нужда от място от другата страна."

	key[]: "aca_msg_book1_3_16_cutscene5"
	val[]: "След като ремаркето е добре на мястото за паркиране, започнете да завъртате камиона, за да последвате ремаркето навътре."

	key[]: "aca_msg_book1_3_16_cutscene6"
	val[]: "Спрете на определеното място, след това обезопасете камиона и изключете двигателя."

#### 3_16 Driving Instructions

	key[]: "aca_msg_book1_3_16_start"
	val[]: "Паркирайте камиона на мястото зад вас. Използвайте и двете си огледала, за да навигирате като заден ход.<br><br><font face=/font/big_bold.font>Пригответе се да потеглите. </font>"

	key[]: "aca_msg_book1_3_16_backward"
	val[]: "Проверете заобикалящата среда, след което се насочете към мястото за паркиране.<br><br><font face=/font/big_bold.font>Започнете движение на заден ход.</font>"

	key[]: "aca_msg_book1_3_16_check1"
	val[]: "Започнете да движите ремаркето към камионите до вас. Когато сте готови, завъртете ремаркето на мястото за паркиране. Не забравяйте да вземете предвид въртенето на опашката на ремаркето.<br><br><font face=/font/big_bold.font>Завийте на мястото за паркиране. </font>"
#!{
	key[]: "aca_msg_book1_3_16_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_16_end"
	val[]: "@@aca_msg_book1_2_01_end@@"


 #!}


#@}

#+ Book 1 Scenario 3_17
#@{

#### 3_17 common
	key[]: "aca_scenario_book1_3_17_title"
	val[]: "Заден ход в завой"

	key[]: "aca_scenario_book1_3_17_desc"
	val[]: "В този сценарий ще се движим на заден ход с ремарке в завой за първи път. Ще разгледаме основните принципи на движение на заден ход и за какво да внимаваме, когато завиваме на заден ход."

#### 3_17 goal

	key[]: "aca_goal_book1_3_17_check1"
	val[]: "Завъртане на ремаркето"
#!{
	key[]: "aca_goal_book1_3_17_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_17_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_17_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_17_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
 #!}
#### 3_17 msg - intro text

	key[]: "aca_msg_book1_3_17_cutscene01"
	val[]: "При този сценарий ще трябва да дадете на заден ход до мястото за паркиране, което е зад вас от страната на вашия шофьор."

	key[]: "aca_msg_book1_3_17_cutscene02"
	val[]: "Има няколко съвета, които трябва да запомните, които ще ви помогнат много при движението на ремаркета на заден ход. <br>Първата е, че ремаркето винаги ще иска да завие в посока, обратна на това как управлявате камиона."

	key[]: "aca_msg_book1_3_17_cutscene03"
	val[]: "Второто е, че можете да усетите добре накъде се движи ремаркето, като наблюдавате осите на камиона и ремаркето."

	key[]: "aca_msg_book1_3_17_cutscene04"
	val[]: "Трето, малките входове ще ви отведат там, където трябва да отидете, няма нужда да го натоварвате."

	key[]: "aca_msg_book1_3_17_cutscene05"
	val[]: "Започнете леко да завъртате трактора от мястото за паркиране и ремаркето ще започне да сочи към него."

	key[]: "aca_msg_book1_3_17_cutscene06"
	val[]: "Следвайте ремаркето, като правите корекции, докато вървите, за да го поддържате по правилния път."

	key[]: "aca_msg_book1_3_17_cutscene07"
	val[]: "Гледайте колелата на ремаркето и задното колело на камиона. Те ще ви кажат накъде е насочено ремаркето и накъде го бута влекача."

	key[]: "aca_msg_book1_3_17_cutscene08"
	val[]: "Четвъртият съвет е, че винаги е по-лесно да завъртите ремаркето по-остро, отколкото да се опитате да го изправите от нож. Насочете се към външната страна на мястото, докато се доближите до него, след което можете да завъртите малко по-рязко, за да подравните ремаркето си."

	key[]: "aca_msg_book1_3_17_cutscene09"
	val[]: "Когато ремаркето влезе в мястото за паркиране, качете трактора пред ремаркето. Опитайте се да избегнете твърде много корекции вътре в мястото за паркиране."

	key[]: "aca_msg_book1_3_17_cutscene10"
	val[]: "Обърнете се между бариерите, проверете двете страни, докато се движите."

	key[]: "aca_msg_book1_3_17_cutscene11"
	val[]: "Обезопасете камиона и изключете двигателя."

#### 3_17 Driving Instructions

	key[]: "aca_msg_book1_3_17_start"
	val[]: "Запомнете тези съвети, когато завивате на заден ход с ремарке:<br><br>— Ремаркето завива обратно на начина, по който управлявате влекача<br><br>— Гледайте колелата на ремаркето, за да видите накъде се движи<br><br> — Гледайте задното колело на трактора, за да видите къде бута ремаркето<br><br>— Оставете ремаркето да свърши работата, не завивайте прекалено<br><br>— Винаги е по-лесно да завъртите трейлъра по-остро, отколкото да го изправите<br><br><font face=/font/big_bold.font>Пригответе се да потеглите. </font>"

	key[]: "aca_msg_book1_3_17_backward"
	val[]: "Погледнете зад себе си, за да разберете къде трябва да отидете. Винаги проверявайте обкръжението си, преди да започнете да карате на заден ход.<br><br><font face=/font/big_bold.font>Започнете да карате на заден ход към мястото за паркиране.</font>"

	key[]: "aca_msg_book1_3_17_check1"
	val[]: "<font face=/font/big_bold.font>Започнете да завъртате ремаркето към мястото за паркиране и го последвайте навътре.</font>"

	key[]: "aca_msg_book1_3_17_stop"
	val[]: "<font face=/font/big_bold.font>Спрете в обозначената зона. </font>"
#!{
	key[]: "aca_msg_book1_3_17_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_18
#@{

#### 3_18 common
	key[]: "aca_scenario_book1_3_18_title"
	val[]: "Маневра за паркиране на алея"

	key[]: "aca_scenario_book1_3_18_desc"
	val[]: "В този сценарий ще бъдете натоварени със задачата да обърнете ремаркето на заден ход в алея извън малък път."

#### 3_18 goal

	key[]: "aca_goal_book1_3_18_check1"
	val[]: "Завъртане на ремаркето"
#!{
	key[]: "aca_goal_book1_3_18_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_18_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


	key[]: "aca_goal_book1_3_18_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_18_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

 #!}
#### 3_18 msg - intro text

	key[]: "aca_msg_book1_3_18_cutscene01"
	val[]: "Паркирането тук изисква маневра за „паркиране в алея“.<br>Това е типична маневра за паркиране за шофьори на камиони, тъй като те ще се сблъскват с този вид паркиране почти всеки ден в кариерата си, независимо дали става въпрос за товарене или разтоварване на ремарке или паркиране за през нощта на спирка за камион."

	key[]: "aca_msg_book1_3_18_cutscene02"
	val[]: "Това е маневра, подобна на предишния сценарий, но ще имате по-малко място за работа, така че ще трябва да планирате ходовете си по съответния начин и да внимавате да не ударите нещо."

	key[]: "aca_msg_book1_3_18_cutscene03"
	val[]: "Тъй като има по-малко място, вашето време е по-важно. Завъртете ремаркето в точното време и наблюдавайте колелата на трактора и ремаркето, за да видите къде ще отиде. Имайте предвид въртенето на опашката си и помнете, че не правите ножове - продължавайте да бутате ремаркето."

	key[]: "aca_msg_book1_3_18_cutscene04"
	val[]: "Опитайте се да насочите ремаркето към алеята по-рано, отколкото по-късно. Това ще ви даде място от другата страна, за да завъртите предната част на ремаркето и да поставите трактора пред него."

	key[]: "aca_msg_book1_3_18_cutscene05"
	val[]: "След като ремаркето ви е в алеята, качете трактора пред него. По-добре е да направите това малко по-рано, отколкото инстинктът ви първоначално може да ви накара да повярвате. Винаги можете да го коригирате като обратна страна на крайната ви позиция."

	key[]: "aca_msg_book1_3_18_cutscene06"
	val[]: "Изправете влекача и ремаркето и спрете на определеното място."

	key[]: "aca_msg_book1_3_18_cutscene07"
	val[]: "Обезопасете камиона и изключете двигателя."


#### 3_18 Driving Instructions

	key[]: "aca_msg_book1_3_18_start"
	val[]: "Сега ще опитаме да обърнем ремарке в много по-малка зона с маневра „паркиране в алея“. <br><br><font face=/font/big_bold.font>Пригответе се за потегляне. </font>"

	key[]: "aca_msg_book1_3_18_backward"
	val[]: "Проверете обкръжението си и потърсете мястото за паркиране зад вас. <br><br><font face=/font/big_bold.font>Започнете на заден ход към мястото за паркиране. </font>"

	key[]: "aca_msg_book1_3_18_check1"
	val[]: "<font face=/font/big_bold.font>Завъртете ремаркето в мястото за паркиране"
#!{
	key[]: "aca_msg_book1_3_18_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_18_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}


#@}

#+ Book 1 Scenario 3_19
#@{

#### 3_19 common
	key[]: "aca_scenario_book1_3_19_title"
	val[]: "Финален изпит (част 1)"

	key[]: "aca_scenario_book1_3_19_desc"
	val[]: "Очаква ви финалният изпит, на който ще бъдат тествани всички умения, които сте научили от предишните сценарии. Ще обиколим целия център за обучение, за да видим колко добре сте научили ситуациите, които сте срещали досега.<br><br>След като завършите всички секции и маневри, ще сте на една стъпка по-близо до това да се наречете опитен шофьор на камион!"

