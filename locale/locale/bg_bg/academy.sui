#### 2_06 msg - intro text

	key[]: "aca_msg_book1_2_06_cutscene01"
	val[]: "За последния сценарий на тази глава ще караме на тестовата писта със сложна конфигурация."

	key[]: "aca_msg_book1_2_06_cutscene02"
	val[]: "Първото препятствие е слалом през бариери. Карайте през него и не забравяйте да използвате огледалата си."

	key[]: "aca_msg_book1_2_06_cutscene04"
	val[]: "Следва обратен завой. Дръжте завоя си широк и това не би трябвало да ви създава проблеми."

	key[]: "aca_msg_book1_2_06_cutscene05"
	val[]: "Пътя напред се стеснява значително. Продължете внимателно и използвайте страничното огледало, за да ви помогне."

	key[]: "aca_msg_book1_2_06_cutscene06"
	val[]: "Следва поредица от лесни завои на 90 градуса."

	key[]: "aca_msg_book1_2_06_cutscene08"
	val[]: "Следващият раздел трябва да се направи в обратен ред. Подхождайте към бариерите пред себе си с това предвид."

	key[]: "aca_msg_book1_2_06_cutscene09"
	val[]: "Следвайте пътната маркировка назад и вдясно от вас."

	key[]: "aca_msg_book1_2_06_cutscene10"
	val[]: "Обърнете се към бариерите, след това спрете и продължете напред наляво."

	key[]: "aca_msg_book1_2_06_cutscene11"
	val[]: "Този проход през конусите е много тесен. Карайте бавно и използвайте огледалата си, за да се ориентирате в прохода."

	key[]: "aca_msg_book1_2_06_cutscene13"
	val[]: "Отпред има поредица от редуващи се завои наляво и надясно на 90 градуса."

	key[]: "aca_msg_book1_2_06_cutscene15"
	val[]: "Може да срещнете влакове на този прелез. Ако е така, спрете и изчакайте. След това можете да завиете надясно по обслужващия път."

	key[]: "aca_msg_book1_2_06_cutscene16"
	val[]: "Завийте наляво по пътното платно. Можете да наберете малко скорост, след като завършите хода си."

	key[]: "aca_msg_book1_2_06_cutscene18"
	val[]: "Още няколко завоя наляво в града и ще бъдете на целта си!"

	key[]: "aca_msg_book1_2_06_cutscene19"
	val[]: "Приближете се до бариерите отпред и се пригответе да паркирате на мястото за паркиране вдясно."

	key[]: "aca_msg_book1_2_06_cutscene20"
	val[]: "Върнете се на заден ход до мястото за паркиране, след това изключете двигателя и обезопасете камиона."

#### 2_06 Driving Instructions



	key[]: "aca_msg_book1_2_06_forward"
	val[]: "Пред вас е слалом, направен от бариери.<br><br><font face=/font/big_bold.font>Карайте през слалома.</font>"

	key[]: "aca_msg_book1_2_06_forward2"
	val[]: "<font face=/font/big_bold.font>Следвайте пътя около завоя с фиби. </font>"

	key[]: "aca_msg_book1_2_06_check1"
	val[]: "Пътя напред се стеснява значително. Можете да използвате страничното си огледало, за да се ориентирате.<br><br><font face=/font/big_bold.font>Продължавайте внимателно. </font>"

	key[]: "aca_msg_book1_2_06_check2"
	val[]: "След като кривата е завой на 90 градуса.<br><br><font face=/font/big_bold.font>Коригирайте скоростта си съответно.</font>"

	key[]: "aca_msg_book1_2_06_check3"
	val[]: "Предстоят още няколко лесни завоя, продължете да коригирате скоростта си, ако е необходимо.<br><br><font face=/font/big_bold.font>Продължете да шофирате. </font>"

	key[]: "aca_msg_book1_2_06_check4"
	val[]: "Следващият раздел трябва да бъде изпълнен в обратен ред. Спрете при бариерите отпред, за да можете да върнете на заден ход надясно след това.<br><br><font face=/font/big_bold.font>Спрете при бариерите.</font>"

	key[]: "aca_msg_book1_2_06_check5"
	val[]: "Дайте на заден ход към зоната зад вас и вдясно.<br><br><font face=/font/big_bold.font>Започнете да карате на заден ход. </font>"

	key[]: "aca_msg_book1_2_06_reverse"
	val[]: "Следвайте пътя около завоите.<br><br><font face=/font/big_bold.font>Продължавайте на заден ход.</font>"

	key[]: "aca_msg_book1_2_06_check6"
	val[]: "Зад вас вляво има няколко бариери. <br><br><font face=/font/big_bold.font>Обърнете се към бариерите и бъдете готови да спрете.</font>"

	key[]: "aca_msg_book1_2_06_check7"
	val[]: "Спрете и превключете на предна скорост, след което продължете наляво. <br><br><font face=/font/big_bold.font>Карайте напред. </font>"

	key[]: "aca_msg_book1_2_06_check8"
	val[]: "Пред вас има тясна криволичеща пътека през няколко конуса. Шофирайте внимателно и използвайте огледалата си, ако е необходимо.<br><br><font face=/font/big_bold.font>Карайте през конусите. </font>"

	key[]: "aca_msg_book1_2_06_check9"
	val[]: "Следва комбинация от различни завои на 90 градуса. Уверете се, че подхождате към всеки завой с широка койка.<br><br><font face=/font/big_bold.font>Продължете да шофирате. </font>"

	key[]: "aca_msg_book1_2_06_check10"
	val[]: "Наблюдавайте прелеза, докато го приближавате. Сигналите може да се активират, за да покажат приближаващ влак.<br><br><font face=/font/big_bold.font>Продължете с повишено внимание.</font>"

	key[]: "aca_msg_book1_2_06_check11"
	val[]: "Завоят към обслужващия път е частично блокиран от препятствие, така че се придържайте вляво, докато се приближавате, за да си осигурите повече място.<br><br><font face=/font/big_bold.font>Направете завоя. </font>"

	key[]: "aca_msg_book1_2_06_check12"
	val[]: "Можете да изберете даспрете или да игнорирате знака стоп. Районът е затворен за наша употреба.<br><br><font face=/font/big_bold.font>Завийте наляво.</font>"

	key[]: "aca_msg_book1_2_06_check13"
	val[]: "Можете да изберете малко скорост тук, но ще трябва да завиете на следващата пресечка.<br><br><font face=/font/big_bold.font>Продължете по трасето. </font>"

	key[]: "aca_msg_book1_2_06_check14"
	val[]: "Продължете към града с ляв завой, последван от още два леви завоя до крайната зона.<br><br><font face=/font/big_bold.font>Карайте през града.</font>"

	key[]: "aca_msg_book1_2_06_check15"
	val[]: "От другата страна на парцела има няколко бариери. Карайте до тях. <br><br><font face=/font/big_bold.font>Спрете близо до бариерите. </font>"

	key[]: "aca_msg_book1_2_06_check16"
	val[]: "Зад вас и вдясно има място за паркиране.<br><br><font face=/font/big_bold.font>На заден ход към мястото за паркиране. </font>"
#!{
	key[]: "aca_msg_book1_2_06_check17"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_06_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_2_06_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

#@}

