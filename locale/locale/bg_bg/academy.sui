	key[]: "aca_msg_book1_3_15_cutscene02_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/jug_handle.mat bottom=p256 right=p256 color=FFFFFFFF></align><offset vshift=256>"

	key[]: "aca_msg_book1_3_15_cutscene07_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/button_hook.mat bottom=p256 right=p256 color=FFFFFFFF></align><offset vshift=256>"

#!}


#### 3_15 Driving Instructions

	key[]: "aca_msg_book1_3_15_forward"
	val[]: "Не забравяйте да използвате цялата налична стая, за да ви помогне да преговаряте за всеки завой.<br><br><font face=/font/big_bold.font>Тръгнете и следвайте пътната маркировка навън. </font>"

	key[]: "aca_msg_book1_3_15_check1"
	val[]: "Използвайте цялото налично пространство, за да се завъртите широко и да държите ремаркето далеч от вътрешния бордюр.<br><br><font face=/font/big_bold.font>Накарайте дръжката на каната да се завърти. </font>"

	key[]: "aca_msg_book1_3_15_check2"
	val[]: "Придържайте се към средата на пътя около завоя, след което продължете направо към следващия завой.<br><br><font face=/font/big_bold.font>Продължете да шофирате.</font>"

	key[]: "aca_msg_book1_3_15_check3"
	val[]: "Има ограничено място отляво, така че трябва да карате далече в кръстовището, за да държите ремаркето извън бордюра.<br><br><font face=/font/big_bold.font>Накарайте куката да се завърти. </font>"

	key[]: "aca_msg_book1_3_15_check4"
	val[]: "Карайте напред до и около следващата крива.<br><br><font face=/font/big_bold.font>Продължете да шофирате. </font>"

	key[]: "aca_msg_book1_3_15_check5"
	val[]: "Този завой е най-тесният досега и нито една маневра сама по себе си няма да е достатъчна.<br><br><font face=/font/big_bold.font>Направете завоя, дръжте се възможно най-широко.</font>"

	key[]: "aca_msg_book1_3_15_check6"
	val[]: "<font face=/font/big_bold.font>Продължете до мястото за паркиране напред и вдясно. </font>"
#!{
	key[]: "aca_msg_book1_3_15_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_15_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_15_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

