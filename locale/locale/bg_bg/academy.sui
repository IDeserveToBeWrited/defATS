#### 3_03 msg - intro text

	key[]: "aca_msg_book1_3_03_cutscene01"
	val[]: "Предстоят различни сложни завои и препятствия.<br>Вземете под внимание всичко, което сте научили досега и не би трябвало да е твърде трудно."

	key[]: "aca_msg_book1_3_03_cutscene02"
	val[]: "Първият ъгъл е лесно завъртане на кука с бутон. Дръжте се широко и не би трябвало да представлява проблем."

	key[]: "aca_msg_book1_3_03_cutscene03"
	val[]: "Продължете към кръговото."

	key[]: "aca_msg_book1_3_03_cutscene04"
	val[]: "Дръжте ремаркето далеч от вътрешността на кръговото кръстовище, като карате трактора възможно най-широко около него."

	key[]: "aca_msg_book1_3_03_cutscene05"
	val[]: "Завиването на 90 градуса наляво не е особено стегнато, но внимавайте да не ударите конуси."

	key[]: "aca_msg_book1_3_03_cutscene06"
	val[]: "Този завой е значително по-стегнат. Използвайте маневра с дръжка на кана, за да я завършите."

	key[]: "aca_msg_book1_3_03_cutscene07"
	val[]: "Можете да използвате маневра с кука с бутон на този завой, но има някои допълнителни препятствия, които трябва да избягвате."

	key[]: "aca_msg_book1_3_03_cutscene09"
	val[]: "Още веднъж, последният завой е много стегнат и ще изисква комбинация от маневри с дръжка на каната и кука с бутон, за да завърши."

	key[]: "aca_msg_book1_3_03_cutscene10"
	val[]: "Спрете на определеното място, след това обезопасете камиона и изключете двигателя."


#### 3_03 Driving Instructions



	key[]: "aca_msg_book1_3_03_forward"
	val[]: "<font face=/font/big_bold.font>Продължете до първия завой. </font>"

	key[]: "aca_msg_book1_3_03_check1"
	val[]: "Първият завой е лесно завъртане с кука с бутон.<br><br><font face=/font/big_bold.font><color value=@@clr_txt@@>Продължете през завоя. </font>"

	key[]: "aca_msg_book1_3_03_check2"
	val[]: "Продължете към кръговото движение. Не забравяйте да го заобиколите по широк път.<br><br><font face=/font/big_bold.font>Карайте до и около кръговото движение.</font>"

	key[]: "aca_msg_book1_3_03_check3"
	val[]: "Този завой на 90 градуса е малко по-тесен, внимавайте да не ударите конуси.<br><br><font face=/font/big_bold.font>Направете завоя.</font>"

	key[]: "aca_msg_book1_3_03_check4"
	val[]: "Този завой се подхожда най-добре с процедура с дръжка на кана. Завъртете се широко, преди да влезете в кръстовището.<br><br><font face=/font/big_bold.font>Накарайте дръжката на каната да се завърти. </font>"

	key[]: "aca_msg_book1_3_03_check5"
	val[]: "Този завой е осеян с няколко различни препятствия, но може да се направи с маневра с кука с бутон.<br><br><font face=/font/big_bold.font>Продължете внимателно. </font>"

	key[]: "aca_msg_book1_3_03_check6"
	val[]: "Този завой е най-тесният досега, преговаряйте по него, както сметнете за добре.<br><br><font face=/font/big_bold.font>Завийте към паркинга.</font>"
#!{
	key[]: "aca_msg_book1_3_03_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_03_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

