#+ Book 2 intro
#@{

#### common
	key[]: "aca_scenario_book2_intro_title"
	val[]: "Умения за шофиране на камион"


#### intro text

	key[]: "aca_scenario_book2_book2_intro_cutscene1"
	val[]: "Добре дошли отново в @@driving_academy@@!"

	key[]: "aca_scenario_book2_book2_intro_cutscene2"
	val[]: "Следните сценарии представляват следващата стъпка по пътя ви към професионално шофиране на камион."

	key[]: "aca_scenario_book2_book2_intro_cutscene3"
	val[]: "Този път няма да ви водим през всяка задача, така че зависи от вас да приложите уменията и опита си."

	key[]: "aca_scenario_book2_book2_intro_cutscene4"
	val[]: "Може да се сблъскате с някои познати маневри, но този път в нови среди, създадени да изглеждат по-скоро като сценарии от реалния свят."

	key[]: "aca_scenario_book2_book2_intro_cutscene5"
	val[]: "Новост за @@driving_academy@@ е добавянето на условия „Успешен“ и „Бонус“."

	key[]: "aca_scenario_book2_book2_intro_cutscene6"
	val[]: "Както и преди, трябва да завършите всеки сценарий, без да ударите нищо, като паркирате успешно и обезопасите камиона..."

	key[]: "aca_scenario_book2_book2_intro_cutscene7"
	val[]: "...но сега трябва да го направите и в рамките на определеното време и с ограничение в броя на промените в посоката между движение напред и назад."

	key[]: "aca_scenario_book2_book2_intro_cutscene8"
	val[]: "Бонус условията могат да бъдат изпълнени чрез завършване на всеки сценарий с още по-предизвикателни условия..."

	key[]: "aca_scenario_book2_book2_intro_cutscene9"
	val[]: "...като например по-строги времеви ограничения, по-малко промени в посоката и използване единствено на вътрешната камера."

	key[]: "aca_scenario_book2_book2_intro_cutscene10"
	val[]: "By completing all scenarios, you may consider yourself a proficient trucker and ready for the next challenge down the road.<br><br>To further challenge yourself, complete all of the bonus conditions for each scenario; then you'll truly be a truck driving star!"


#@}



#+ Book 2 zero
#@{
#### zero common
	key[]: "aca_scenario_book2_zero_title"
	val[]: "Обучение"

	key[]: "aca_scenario_book2_zero_desc"
	val[]: "В този сценарий с урок ние ще ви помогнем да се запознаете с новите функции, открити в уменията за шофиране на камион."


#### zero info msg1

	key[]: "aca_msg_book2_scenario_zero1_title"
	val[]: "Умения за шофиране на камион"

	key[]: "aca_msg_book2_scenario_zero1"
	val[]: "В началото на всеки сценарий ще видите прозорец <color value=@@clr_sel@@>„Обобщение на сценария“<color value=@@clr_txt@@>. Той ще ви даде информация за новите условия за преминаване и бонус за сценария. <br><br>Условията за преминаване трябва да бъдат изпълнени, за да се завърши сценарият успешно, докато условията за бонус са допълнително предизвикателство по избор за опитните и умели играчи. <br><br><font face=/font/big_bold.font>За да продължите, включете запалването.</font>"

#### zero info msg1b

	key[]: "aca_msg_book2_scenario_zero1b"
	val[]: "Едно от бонус условията изисква да завършите сценария, докато използвате <color value=@@clr_sel@@>Вътрешната камера<color value=@@clr_txt@@>. Все още можете да използвате външните камери, за да проверите обкръжението си, но само докато камионът е спрял.<br><br>Сега можете да се огледате, за да се ориентирате, след което да се върнете към вътрешната камера.<br><br><font face=/font/big_bold.font>Превключете към камера за преследване, за да проверите обкръжението</font>"


#### zero info msg1c


	key[]: "aca_msg_book2_scenario_zero1c"
	val[]: "Ориентирайте се, след което се върнете към камерата за интериор.<br><br><font face=/font/big_bold.font>Огледайте камиона</font>"


#### zero info msg1d


	key[]: "aca_msg_book2_scenario_zero1d"
	val[]: "<font face=/font/big_bold.font>Връщане към вътрешната камера</font>"
#### zero info msg2

	key[]: "aca_msg_book2_scenario_zero2_title"
	val[]: "Умения за шофиране на камион"

	key[]: "aca_msg_book2_scenario_zero2"
	val[]: "<color value=@@clr_sel@@>Времето<color value=@@clr_txt@@> също ще бъде фактор за уменията за шофиране на камион. Всички сценарии ще имат индивидуално ограничение във времето, в което сценарият трябва да бъде изпълнен като условие за преминаване, а много от тях ще имат и допълнително, по-строго ограничение като бонус условие.<br><br>Таймерът стартира само след като камионът бъде преместен.<br><br><font face=/font/big_bold.font>Стартирайте двигателя и освободете ръчната спирачка, за да продължите.</font>"


#### zero info msg3

	key[]: "aca_msg_book2_scenario_zero3_title"
	val[]: "Умения за шофиране на камион"

	key[]: "aca_msg_book2_scenario_zero3"
	val[]: "Друго ново допълнение към уменията за шофиране на камиони са пътните точки. Всички пътни точки трябва да бъдат достигнати, преди да може да бъде завършен сценарий. <br><br>Освен това, пътните точки са чувствителни към посоката, в която е обърнат камионът, когато се достигне пътната точка, така че обърнете внимание на всички наземни маркировки близо до пътната точка, за да се ориентирате правилно.<br><br><font face=/font/big_bold.font>Карайте напред до пътната точка пред вас.</font>"


#### zero info msg4

	key[]: "aca_msg_book2_scenario_zero4_title"
	val[]: "Умения за шофиране на камион"

	key[]: "aca_msg_book2_scenario_zero4"
	val[]: "Стигнахте до точката и вече можете да преминете към следващата стъпка. <br><br>Зад вас има друга точка, към която трябва да се движите на заден ход. Обърнете внимание на стрелката на земята, която показва в коя посока трябва да е обърнат камионът, когато достигнете точката. <br><br>Друго условие за преминаване и бонус, което трябва да се вземе предвид, е <color value=@@clr_sel@@>Промени в посоката<color value=@@clr_txt@@>. Броим колко пъти сменяте посоката между движение напред и движение назад. Останете под ограничението, за да изпълните условието.<br><br><font face=/font/big_bold.font>Движете се на заден ход до точката и спрете.</font>"

#### zero info msg5

	key[]: "aca_msg_book2_scenario_zero5_title"
	val[]: "Умения за шофиране на камион"

	key[]: "aca_msg_book2_scenario_zero5"
	val[]: "Така че досега би трябвало да сте натрупали една промяна на посоката. <br><br>Вземете ремаркето зад себе си, за да продължите към следващата стъпка. <br><br><font face=/font/big_bold.font>Завийте под ремаркето, за да го свържете.</font>"

#### zero info msg6

	key[]: "aca_msg_book2_scenario_zero6_title"
	val[]: "Умения за шофиране на камион"

	key[]: "aca_msg_book2_scenario_zero6"
	val[]: "Последното място за паркиране е отдясно. Някои сценарии може да имат само едно място за паркиране, докато други ще имат няколко, от които да избирате. Правилното паркиране на което и да е от местата ще ви позволи да завършите сценария. <br><br><font face=/font/big_bold.font> Натиснете @@imv_nrm_attach@@, за да свържете ремаркето. </font>"


#### zero info msg7

	key[]: "aca_msg_book2_scenario_zero7_title"
	val[]: "Умения за шофиране на камион"

	key[]: "aca_msg_book2_scenario_zero7"
	val[]: "Местата за паркиране показват и в каква посока трябва да бъде ориентиран камионът. Ако паркирате в грешна посока, няма да можете да завършите сценария, докато не се поправите, което ще ви струва време и промени в посоката.<br><br><font face=/font/big_bold.font>Карайте до едно от местата за паркиране и паркирайте правилно.</font>"



#### zero info msg8

	key[]: "aca_msg_book2_scenario_zero8_title"
	val[]: "Умения за шофиране на камион"

	key[]: "aca_msg_book2_scenario_zero8"
	val[]: "Вече би трябвало да сте запознати с новите параметри за Условия за преминаване и Бонус цели и да сте готови да се справите с новите сценарии в „Умение за шофиране на камион“!<br><br><font face=/font/big_bold.font>Обезопасете камиона, като задействате ръчната спирачка и изключите двигателя, за да завършите сценария.</font>"



#@}

