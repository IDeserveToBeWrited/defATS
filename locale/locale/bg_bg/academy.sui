#+ Chapters general
#@{
	key[]: "aca_chapter_book1_1_title"
	val[]: "Основни на управлението и движение"

	key[]: "aca_chapter_book1_1_desc"
	val[]: "Научете основните за управление на превозното средство и как да движите камиона напред и назад."

	key[]: "aca_chapter_book1_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Поздравления!<br>Завършихте Рездел 1: @@aca_chapter_book1_1_title@@.<br><br>Научихте как да приготвяте камион преди шофиране,<br>шофиране напред и назад и как да използвате светлини и чистачки.</font><br><br>"

	key[]: "aca_chapter_book1_2_title"
	val[]: "Основни маневри"

	key[]: "aca_chapter_book1_2_desc"
	val[]: "Научете се да шофирате, маневрирате и паркирате с влекач. Разгледайте предназначението на всеки тип огледало и как да го използвате."

	key[]: "aca_chapter_book1_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Поздравления!<br>Завършихте Раздел 2: @@aca_chapter_book1_2_title@@.<br><br>Научихте как за да използвате всяко огледало на камиона, проверете пространството около камиона, преди да се движите, и изпълнете както основни, така и разширени маневри.</font>"

	key[]: "aca_chapter_book1_3_title"
	val[]: "Маневриране с ремарке"

	key[]: "aca_chapter_book1_3_desc"
	val[]: "Научете се да се свързвате и да маневрирате с ремарке в различни ситуации."

	key[]: "aca_chapter_book1_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Поздравления!<br>Завършихте Раздел 3: @@aca_chapter_book1_3_title@@.<br><br>Научихте да се свързвате и откачване на ремарке,<br>усещане на теглото и размерите на камиона с ремарке<br>и шофиране по предизвикателни курсове с ремарке.</font><br><br>"

	key[]: "aca_chapter_book1_4_title"
	val[]: "Заден ход с ремарке"

	key[]: "aca_chapter_book1_4_desc"
	val[]: "Научете нови маневри за ефективно движение на заден ход и паркиране с ремарке."

	key[]: "aca_chapter_book1_4_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Поздравления!<br>Завършихте Глава 4: @@aca_chapter_book1_4_title@@.<br><br>Научихте да обръщате с ремарке<br>и различни техники за паркиране.</font><br><br>"

	key[]: "aca_chapter_book1_5_title"
	val[]: "Заключителен изпит"

	key[]: "aca_chapter_book1_5_desc"
	val[]: "Демонстрирайте знанията и уменията си, за да докажете своя опит, като шофьор на камион!"

	key[]: "aca_chapter_book1_5_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Поздравления!<br>Завършихте раздел 5: @@aca_chapter_book1_5_title@@.<br><br>Доказахте това имате всички необходими умения<br>за шофиране, маневриране и паркиране на камион!</font><br><br>"

	key[]: "aca_chapter_book2_0_title"
	val[]: "Подгряване на двигателя"

	key[]: "aca_chapter_book2_0_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Завършихте обучението: @@aca_chapter_book2_0_title@@.<br><br>Научихте правилата и характеристиките на квалификацията за шофиране.</font><br><br>"

	key[]: "aca_chapter_book2_1_title"
	val[]: "Връщане на предавките"

	key[]: "aca_chapter_book2_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Поздравления!<br>Завършихте Глава 2: @@aca_chapter_book2_1_title@@.<br><br>Загряхте двигателя, тествахте скоростите, завъртяхте правилно колелата и проверихте ефективността на спирачките. Следващите глави ще бъдат по-предизвикателни.</font><br><br>"

	key[]: "aca_chapter_book2_2_title"
	val[]: "Колела в движение"

	key[]: "aca_chapter_book2_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Поздравления!<br>Завършихте Глава 3: @@aca_chapter_book2_2_title@@.<br><br>Усвоихте трудни и разнообразни сценарии. Демонстрирахте умения и представяне.</font><br><br>"

	key[]: "aca_chapter_book2_3_title"
	val[]: "Финалната права"

	key[]: "aca_chapter_book2_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Поздравления!<br>Завършихте Глава 4: @@aca_chapter_book2_3_title@@.<br><br>Справяли сте се с много трудни ситуации при маневриране, паркиране и движение на заден ход с ремарке. Доказали сте, че сте умел шофьор, способен да се справяте с всички трудни ситуации при шофиране на камион."

	key[]: "aca_chapter_book3_1_title"
	val[]: "Продължаване напред"

	key[]: "aca_chapter_book3_1_desc"
	val[]: "Научете всички основни техники за управление на двойни ремаркета при движение напред."

	key[]: "aca_chapter_book3_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Поздравления!<br>Завършихте Глава 1: @@aca_chapter_book3_1_title@@.<br><br>Вече имате опит в ефективното шофиране и маневриране с двойни ремаркета.</font><br><br>"

	key[]: "aca_chapter_book3_2_title"
	val[]: "Управление на заден ход"

	key[]: "aca_chapter_book3_2_desc"
	val[]: "Научете необходимите стъпки за маневриране с двойни ремаркета при движение на заден ход."

	key[]: "aca_chapter_book3_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Поздравления!<br>Завършихте Глава 2: @@aca_chapter_book3_2_title@@.<br><br>Вие усвоихте впечатляващото умение да маневрирате на заден ход с двойни ремаркета.</font><br><br>"

	key[]: "aca_chapter_book3_3_title"
	val[]: "Подготовка за реалния свят"

	key[]: "aca_chapter_book3_3_desc"
	val[]: "Приложете новите си знания в по-сложни сценарии."

	key[]: "aca_chapter_book3_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Поздравления!<br>Завършихте Глава 3: @@aca_chapter_book3_3_title@@.<br><br>Справихте се с много трудни ситуации при маневриране, паркиране и движение на заден ход с B-double ремаркета. Доказахте уменията си тук, сега е време да подкарате B-double композициите по пътищата на American Truck Simulator!</font><br><br>"

#@}

