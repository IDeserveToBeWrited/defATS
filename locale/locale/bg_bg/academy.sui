#+ Book 1 Scenario 3_09
#@{

#### 3_09 common
	key[]: "aca_scenario_book1_3_09_title"
	val[]: "Паркиране по диагонал"

	key[]: "aca_scenario_book1_3_09_desc"
	val[]: "В този сценарий ще паркирате по диагонал на място за паркиране в оживен паркинг. <br><br>Няма много място за маневриране, така че ще трябва да бъдете много точни и съзнателни в шофирането си."

#### 3_09 goal

	key[]: "aca_goal_book1_3_09_check1"
	val[]: "Приближаване до мястото за паркиране"
#!{
	key[]: "aca_goal_book1_3_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_09_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_09_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
 #!}
#### 3_09 msg - intro text

	key[]: "aca_msg_book1_3_09_cutscene1"
	val[]: "Диагоналните места за паркиране като това са много чести. Може да ги срещнете на места за почивка или на спирки за камиони в цяла Америка. <br>Отново ще трябва да „навираме“ към мястото за паркиране отпред."

	key[]: "aca_msg_book1_3_09_cutscene2"
	val[]: "Карайте към определеното място за паркиране близо до края на редицата."

	key[]: "aca_msg_book1_3_09_cutscene3"
	val[]: "Стойте към средата на платното или леко вляво. Искате да си осигурите място за маневриране на ремаркето."

	key[]: "aca_msg_book1_3_09_cutscene4"
	val[]: "Карайте доста покрай мястото за паркиране и след това завийте силно и бързо към мястото. Ще трябва да наблюдавате и двете си странични огледала: огледалото от страната на водача, за да сте сигурни, че предната част на вашето ремарке няма да удари ремаркето до вас, и огледалото от страната на пътника, за да видите, че вашето ремарке навлиза безопасно в мястото за паркиране."

	key[]: "aca_msg_book1_3_09_cutscene5"
	val[]: "Спрете на определеното място, след това обезопасете камиона и изключете двигателя."


#### 3_09 Driving Instructions

	key[]: "aca_msg_book1_3_09_start"
	val[]: "@@aca_msg_book1_3_09_start_img@@<br>Когато паркирате по диагонал, е важно да прецените точно позицията си. След като стигнете част от завоя, е трудно да дадете назад и да препозиционирате безопасно, така че е идеално да се уверите, че имате достатъчно място при първия опит.<br><br><font face=/font/big_bold.font > Пригответе се за тръгване. </font>"

	key[]: "aca_msg_book1_3_09_forward"
	val[]: "<font face=/font/big_bold.font>Започнете да карате и завийте към мястото за паркиране.</font>"

	key[]: "aca_msg_book1_3_09_check1"
	val[]: "Карайте покрай мястото за паркиране, така че ремаркето ви да има място да се върти около камиона отвътре.<br><br><font face=/font/big_bold.font>Завийте на мястото за паркиране. </font>"
#!{
	key[]: "aca_msg_book1_3_09_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}

#@}

#+ Book 1 Scenario 3_10
#@{

#### 3_10 common
	key[]: "aca_scenario_book1_3_10_title"
	val[]: "Заден ход от сляпата страна"

	key[]: "aca_scenario_book1_3_10_desc"
	val[]: "В този сценарий ще разгледаме „сляпата страна“ на заден ход на камиона до място за паркиране. Без възможността да погледнете през прозореца, за да видите къде отивате, ще трябва да разчитате само на огледалата си, за да ви отведат там, където трябва."

#### 3_10 goal
#!{
	key[]: "aca_goal_book1_3_10_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_10_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_10_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_10_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

 #!}
#### 3_10 msg - intro text

	key[]: "aca_msg_book1_3_10_cutscene1"
	val[]: "В този сценарий ще научите маневрата за заден ход на „сляпата страна“. Заслепяването по принцип трябва да се избягва, освен ако няма алтернатива, тъй като видимостта ви е силно ограничена. Отделете време и бъдете изключително предпазливи."

	key[]: "aca_msg_book1_3_10_cutscene2"
	val[]: "Карайте доста покрай мястото за паркиране, за да си осигурите място за работа, след като започнете да карате на заден ход."

	key[]: "aca_msg_book1_3_10_cutscene3"
	val[]: "Спрете, проверете заобикалящата ви среда и след това потеглете на заден ход."

	key[]: "aca_msg_book1_3_10_cutscene4"
	val[]: "Завъртете камиона от мястото. Това ще избута предната част на ремаркето наоколо и на свой ред ще насочи задната част на ремаркето към мястото за паркиране, на което искате да отидете. Внимавайте да не прекалявате или можете да рискувате да „объркате“ комбинацията."

	key[]: "aca_msg_book1_3_10_cutscene5"
	val[]: "Когато ремаркето влезе в мястото за паркиране, започнете да изправяте камиона."

	key[]: "aca_msg_book1_3_10_cutscene6"
	val[]: "Паркирайте на определеното място и обезопасете камиона."

#### 3_10 Driving Instructions

	key[]: "aca_msg_book1_3_10_start"
	val[]: "Карането от сляпа страна изисква същите процедури като каранетото на заден ход, но ще бъдете затруднени от липсата на видимост от тази страна. Използвайте огледалата си и най-добрата си преценка, за да паркирате камиона.<br><br><font face=/font/big_bold.font>Пригответе се да потеглите. </font>"

	key[]: "aca_msg_book1_3_10_forward"
	val[]: "Има място за паркиране отпред и от страната на пътника. Ще трябва да го подминете доста, за да имате място за маневриране, докато давате на заден ход.<br><br><font face=/font/big_bold.font>Карайте напред. </font>"
#!{
	key[]: "aca_msg_book1_3_10_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
	key[]: "aca_msg_book1_3_10_check2"
	val[]: "Не забравяйте, че завъртането на камиона от място ще обърне ремаркето към него. Използвайте огледалата си по най-добрия начин, за да ви помогне да стигнете до мястото за паркиране.<br><br><font face=/font/big_bold.font>Започнете да карате на заден ход. </font>"


#@}

#+ Book 1 Scenario 3_11
#@{

#### 3_11 common
	key[]: "aca_scenario_book1_3_11_title"
	val[]: "Шофиране на кръгово движение"

	key[]: "aca_scenario_book1_3_11_desc"
	val[]: "В този сценарий ще разгледаме как да преговаряте в кръгово кръстовище.<br><br>Ще трябва да обърнете специално внимание на ремаркето си, тъй като то ще се движи зад вас по различен начин, докато влизате, карате през кръговото движение и като излезете."

#### 3_11 goal
#!{
	key[]: "aca_goal_book1_3_11_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_11_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


	key[]: "aca_goal_book1_3_11_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_11_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
 #!}

	key[]: "aca_goal_book1_3_11_check1"
	val[]: "Навлизане в кръговото движение"

	key[]: "aca_goal_book1_3_11_check2"
	val[]: "Шофиране на кръгово движение"

	key[]: "aca_goal_book1_3_11_check3"
	val[]: "Шофиране в кръговото движение"

	key[]: "aca_goal_book1_3_11_check5"
	val[]: "Излизане от кръговото"

	key[]: "aca_goal_book1_3_11_check6"
	val[]: "Шофиране до обозначената зона"

#### 3_11 msg - intro text

	key[]: "aca_msg_book1_3_11_cutscene1"
	val[]: "Кръговите кръстовища са много често срещани по улиците на Европа, така че е важно да знаете как да ги преминавате през тях."

	key[]: "aca_msg_book1_3_11_cutscene3"
	val[]: "Стойте от външната страна на вашата лента, когато наближавате кръговото. Това ще помогне на вашето ремарке да изчисти вътрешността на първоначалния завой."

	key[]: "aca_msg_book1_3_11_cutscene4"
	val[]: "Карайте към центъра на кръговото движение, докато влизате. След като влезете вътре, ще трябва да се насочите към външната страна. Това е, за да държите ремаркето си далеч от центъра на кръговото движение."

	key[]: "aca_msg_book1_3_11_cutscene5"
	val[]: "Следете огледалото си, за да сте сигурни, че ремаркето не се доближава твърде много до вътрешните бариери."

	key[]: "aca_msg_book1_3_11_cutscene6"
	val[]: "Напускането на кръговото движение е сравнително лесно, тъй като вашето ремарке вече е позиционирано далеч от вътрешната страна на изхода. Завъртете се широко при излизане и ремаркето трябва да следва добре."

	key[]: "aca_msg_book1_3_11_cutscene7"
	val[]: "Паркирайте на определеното място и обезопасете камиона."



#### 3_11 Driving Instructions
#!{
	key[]: "aca_msg_book1_3_11_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

	key[]: "aca_msg_book1_3_11_forward"
	val[]: "Пред вас има кръгово кръстовище, по което можете да карате. <br><br><font face=/font/big_bold.font>Бавно се приближете до кръговото движение. </font>"

	key[]: "aca_msg_book1_3_11_check1"
	val[]: "Направете широк завой, когато влизате в кръговото, така че ремаркето ви да влезе зад вас без проблем. <br><br><font face=/font/big_bold.font>Влезте в кръговото движение. </font>"

	key[]: "aca_msg_book1_3_11_check2"
	val[]: "Карайте към външната страна на кръговото движение. Ще трябва да държите камиона възможно най-далеч от центъра на кръговото движение, за да държите ремаркето си далеч от централните бариери. <br><br><font face=/font/big_bold.font>Продължете през кръговото движение.</font>"

	key[]: "aca_msg_book1_3_11_check3"
	val[]: "Стойте близо до външните конуси. <br><br><font face=/font/big_bold.font>Продължавайте да шофирате.</font>"

	key[]: "aca_msg_book1_3_11_check5"
	val[]: "<font face=/font/big_bold.font>Излезте от кръговото.</font>"

	key[]: "aca_msg_book1_3_11_check6"
	val[]: "<font face=/font/big_bold.font>Продължете към мястото за паркиране отпред.</font>"

	key[]: "aca_msg_book1_3_11_stop"
	val[]: "<font face=/font/big_bold.font>Спрете в обозначената зона. </font>"

	key[]: "aca_msg_book1_3_11_end"
	val[]: "<font face=/font/big_bold.font>Обезопасете камиона и изключете двигателя. </font>"
#@}

#+ Book 1 Scenario 3_12
#@{

#### 3_12 common
	key[]: "aca_scenario_book1_3_12_title"
	val[]: "Маневриране в тясно пространство"

	key[]: "aca_scenario_book1_3_12_desc"
	val[]: "В този сценарий ще имате задачата да обърнете камиона в тясно пространство, което ще изисква внимание към заобикалящата ви среда и интелигентно използване на пространството."

#### 3_12 goal



	key[]: "aca_goal_book1_3_12_check1"
	val[]: "Превключване на заден ход"

	key[]: "aca_goal_book1_3_12_check2"
