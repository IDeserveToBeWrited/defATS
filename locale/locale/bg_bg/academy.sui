#+ Book 3 Scenario parallel
#@{

#### parallel common
	key[]: "aca_scenario_book3_parallel_title"
	val[]: "Успоредно паркиране"

	key[]: "aca_scenario_book3_parallel_desc"
	val[]: "In this scenario, we'll parallel park a set of B-doubles on a roadway."

#### parallel goal

	key[]: "aca_goal_book3_parallel_check1"
	val[]: "Движение на заден ход"

#!{
	key[]: "aca_goal_book3_parallel_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_parallel_end"
	val[]: "@@aca_goal_book3_sup_end@@"

	key[]: "aca_goal_book3_parallel_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_parallel_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
#### parallel msg - intro text

	key[]: "aca_msg_book3_parallel_cutscene1"
	val[]: "Завийте зад ъгъла и излезте на платното. Там ще намерите свободно място за вас."

	key[]: "aca_msg_book3_parallel_cutscene2"
	val[]: "Влезте в паркомястото и преминете през него; това ще помогне на ремаркетата да застанат по-близо до целта."

	key[]: "aca_msg_book3_parallel_cutscene3"
	val[]: "Продължете напред извън мястото и изтеглете добре, за да имате достатъчно място за маневра."

	key[]: "aca_msg_book3_parallel_cutscene4"
	val[]: "Използвайте първото ремарке за насочване и вкарайте задното в паркомястото. Ще трябва да планирате действията си предварително, за да сте сигурни, че всяко ремарке ще застане на желаното място."

	key[]: "aca_msg_book3_parallel_cutscene5"
	val[]: "Може да се наложи да се изтеглите напред и назад няколко пъти, докато позиционирате всичко точно."

	key[]: "aca_msg_book3_parallel_cutscene6"
	val[]: "След като се уверите, че сте подравнени с ръба на пътя, центрирайте композицията в паркомястото и обезопасете превозното средство."

#### parallel Driving Instructions

#!{
	key[]: "aca_msg_book3_parallel_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_parallel_forward"
	val[]: "Продължете напред, намерете вашето паркомясто и подгответе камиона за маневра на заден ход."

	key[]: "aca_msg_book3_parallel_check1"
	val[]: "Паркирайте на заден ход на мястото."

