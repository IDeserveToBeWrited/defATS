	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
#### trckstp msg - intro text

	key[]: "aca_msg_book3_trckstp_cutscene1"
	val[]: "Не е необичайно да пристигнете на паркинг, който е почти напълно запълнен с камиони, оставяйки ви много малко възможности за собственото ви паркиране."

	key[]: "aca_msg_book3_trckstp_cutscene2"
	val[]: "В този случай е останало само едно място, където можете да се поберете с вашата двойна композиция.<br><br>Преминете през паркинга и паркирайте в завой близо до изхода."

#### trckstp Driving Instructions

#!{
	key[]: "aca_msg_book3_trckstp_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_trckstp_forward"
	val[]: "Проправете си път през паркинга и паркирайте по протежение на завой.<br><br>Продължете, когато сте готови."

	key[]: "aca_msg_book3_trckstp_check1"
	val[]: "Няма да успеете да преминете през завоя тук; ще трябва да се върнете назад и да намерите друг път."

	key[]: "aca_msg_book3_trckstp_check2"
	val[]: "Паркирайте в завоя пред вас."

	key[]: "aca_msg_book3_trckstp_stop"
	val[]: "Спрете в обозначената зона."

	key[]: "aca_msg_book3_trckstp_end"
	val[]: "Обезопасете камиона и изключете двигателя."

#@}


