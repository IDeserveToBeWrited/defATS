	key[]: "aca_scenario_book3_justb_title"
	val[]: "Първа маневра на заден ход"

	key[]: "aca_scenario_book3_justb_desc"
	val[]: "В този сценарий за първи път ще извършим маневра на заден ход с двойна композиция."

#### justb goal

#!{
	key[]: "aca_goal_book3_justb_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_justb_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
	key[]: "aca_goal_book3_justb_check1"
	val[]: "Спокойно, няма място за притеснение"

#!{
	key[]: "aca_goal_book3_justb_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_justb_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### justb msg - intro text

	key[]: "aca_msg_book3_justb_cutscene1"
	val[]: "Движението на заден ход с двойна композиция изисква изцяло нов начин на мислене. Вместо просто да управлявате едно ремарке, сега използвате предното ремарке, за да насочвате това зад него.<br><br>Използвайте този сценарий, за да добиете усет как работи всичко. Няма конкретна цел – просто отделете време и се опитайте да разберете процеса."

	key[]: "aca_msg_book3_justb_cutscene2"
	val[]: "От изправена позиция можете да завъртите влекача в същата посока, в която искате да отиде задното ремарке.<br><br>Не прекалявайте – трябва само да насочите задното ремарке в желаната посока, след което можете да изправите влекача спрямо предното ремарке и да оставите задното да следва траекторията си."

	key[]: "aca_msg_book3_justb_cutscene3"
	val[]: "След като задното ремарке вече се движи в желаната посока, можете да насочите предното ремарке да го последва.<br><br>Щом предното ремарке последва задното, използвайте влекача, за да регулирате ъгъла между тях – така можете да направите или по-остър завой, или по-широка и плавна маневра."

	key[]: "aca_msg_book3_justb_cutscene4"
	val[]: "Няма точна формула за постигане на перфектен резултат – просто трябва да следите какво се случва, да се учите от грешките си и да продължавате да практикувате.<br><br>Когато прецените, че сте готови, можете да се насочите към обозначената зона и да обезопасите превозното средство.<br><br>Чувствайте се свободни да прекарате тук толкова време в експерименти, колкото смятате за необходимо."

#### justb Driving Instructions

#!{
	key[]: "aca_msg_book3_justb_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_justb_forward"
	val[]: "Започнете да се движите бавно назад. Не забравяйте да правите само малки корекции с волана – няма нужда да „счупвате“ композицията рязко още от самото начало.<br><br>Опитайте се да се движите право назад или насочете ремаркетата към страната на водача."

	key[]: "aca_msg_book3_justb_check1"
	val[]: "Отделете си време и не се отчайвайте.<br><br>Всеки майстор някога е бил начинаещ."

#!{
	key[]: "aca_msg_book3_justb_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_justb_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}

#+ Book 3 Scenario justc
#@{

#### justc common
	key[]: "aca_scenario_book3_justc_title"
	val[]: "Първа корекция при заден ход"

	key[]: "aca_scenario_book3_justc_desc"
	val[]: "В този сценарий ще трябва да продължите оттам, докъдето е стигнал някой друг."

#### justc goal

#!{
	key[]: "aca_goal_book3_justc_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_justc_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
	key[]: "aca_goal_book3_justc_check1"
	val[]: "Движение на заден ход"

#!{
	key[]: "aca_goal_book3_justc_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_justc_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### justc msg - intro text

	key[]: "aca_msg_book3_justc_cutscene1"
	val[]: "О, не! Някой се е поизнервил, докато е карал назад, и е оставил камиона си насред паркинга."

	key[]: "aca_msg_book3_justc_cutscene2"
	val[]: "Неизбежно ще има моменти, в които всичко напълно ще се обърка. Не се притеснявайте – просто тръгнете напред, за да изправите „счупването“, докато позицията на композицията стане удобна за работа.<br><br>Ако не сте сигурни какво да правите, опитайте се да изправите всичко напълно, за да започнете на чисто."

	key[]: "aca_msg_book3_justc_cutscene3"
	val[]: "Това е добра позиция за начало. Задното ремарке все още е насочено натам, накъдето искаме, и можем бързо да изведем влекача пред предното ремарке, за да започнем да насочваме цялата композиция в желаната посока."

	key[]: "aca_msg_book3_justc_cutscene4"
	val[]: "насочете се към обозначената зона и обезопасите камиона.<br><br>Отново напомняме, че можете да упражнявате този сценарий, докато не се почувствате уверени в маневрирането на ремаркетата."

#### justc Driving Instructions

#!{
	key[]: "aca_msg_book3_justc_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_justc_forward"
	val[]: "There's no way out of this mess. Pull forward so you have something to work with."

	key[]: "aca_msg_book3_justc_check1"
	val[]: "Започнете да се движите назад."

#!{
	key[]: "aca_msg_book3_justc_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_justc_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


#+ Straight Backing
#@{

#### straight_backing common

	key[]: "aca_scenario_book3_straight_backing_title"
	val[]: "Движение назад в права линия"

	key[]: "aca_scenario_book3_straight_backing_desc"
	val[]: "В този сценарий трябва да придвижите двойна композиция назад в права линия."

#### straight_backing goal

#!{
	key[]: "aca_goal_book3_straight_backing_start"
	val[]: "@@aca_goal_book3_sup_start@@"
#!}
	key[]: "aca_goal_book3_straight_backing_forward"
	val[]: "Движение на заден ход"

#!{
	key[]: "aca_goal_book3_straight_backing_check1"
	val[]: "@@aca_goal_book3_sup_check1@@"

	key[]: "aca_goal_book3_straight_backing_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_straight_backing_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### straight_backing - intro text

	key[]: "aca_msg_book3_straight_backing_cutscene01"
	val[]: "Движението назад в права линия може да изглежда по-лесно на пръв поглед, но всъщност е много по-трудно.<br><br>Вместо просто да увеличавате или намалявате ъгъла между ремаркетата от едната страна, сега трябва да работите и в двете посоки, за да държите композицията изправена."

	key[]: "aca_msg_book3_straight_backing_cutscene02"
	val[]: "Започнете с относително малки корекции. Няма проблем, ако в началото камионът криволичи наляво-надясно – просто имайте предвид, че ще трябва да задържите ъгъла между влекача и предното ремарке малко по-дълго, за да промените ъгъла между предното и задното ремарке."

	key[]: "aca_msg_book3_straight_backing_cutscene03"
	val[]: "Може да се наложи да правите доста големи маневри с влекача, за да поддържате задното ремарке в желаната посока, но ако се стараете да не прекалявате с корекциите още в самото начало, това няма да бъде необходимо."

	key[]: "aca_msg_book3_straight_backing_cutscene04"
	val[]: "Можете да изтегляте напред, за да правите корекции, толкова пъти, колкото е необходимо. Докато накрая паркирате безопасно на мястото, всичко останало е без значение."

#### Straight Backing Driving Instructions

#!{
	key[]: "aca_msg_book3_straight_backing_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_straight_backing_forward"
	val[]: "Започнете да се движите бавно назад."

#!{
	key[]: "aca_msg_book3_straight_backing_check1"
	val[]: "@@aca_msg_book3_sup_check1@@"
#!}
	key[]: "aca_msg_book3_straight_backing_stop"
	val[]: "Изправете композицията и спрете в обозначената зона."

	key[]: "aca_msg_book3_straight_backing_end"
	val[]: "Обезопасете камиона и изключете двигателя."

#@}


#+ Correcting Straight Backing
#@{

#### correcting_straight_backing common

	key[]: "aca_scenario_book3_correcting_straight_backing_title"
	val[]: "Straight Backing Correction"

	key[]: "aca_scenario_book3_correcting_straight_backing_desc"
	val[]: "В този сценарий ще седнете зад волана, след като някой друг вече се е опитал да премине назад в права линия. Коригирайте грешката му и паркирайте камиона на обозначеното място."

#### correcting_straight_backing goal

#!{
	key[]: "aca_goal_book3_correcting_straight_backing_start"
	val[]: "@@aca_goal_book3_sup_start@@"
#!}
	key[]: "aca_goal_book3_correcting_straight_backing_forward"
	val[]: "Изправяне на композицията"

	key[]: "aca_goal_book3_correcting_straight_backing_check1"
	val[]: "Движение на заден ход"

#!{
	key[]: "aca_goal_book3_correcting_straight_backing_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_correcting_straight_backing_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### correcting_straight_backing - intro text

	key[]: "aca_msg_book3_correcting_straight_cutscene01"
	val[]: "Някой се е опитал да вкара тази композиция назад в паркомястото, но е срещнал трудности. Сега от Вас зависи да оправите нещата!"

	key[]: "aca_msg_book3_correcting_straight_cutscene02"
	val[]: "Първата стъпка е да потеглите напред и да изправите всичко, докато постигнете позиция, удобна за работа. От решаващо значение е задното ремарке да бъде насочено точно натам, накъдето искате да отиде."

	key[]: "aca_msg_book3_correcting_straight_cutscene03"
	val[]: "В този случай избрахме да се насочим повече към страната на водача. Това ще ни осигури по-добра видимост върху това, което правим, докато се движим назад, и ще ни позволи да работим само от едната страна.<br><br>Не забравяйте, че управлявате задното ремарке чрез предното, така че не се съсредоточавайте толкова върху влекача."

	key[]: "aca_msg_book3_correcting_straight_cutscene04"
	val[]: "Композицията е горе-долу там, където ни трябва, но нека изтеглим напред още веднъж, за да я центрираме правилно."

	key[]: "aca_msg_book3_correcting_straight_cutscene05"
	val[]: "Оттук нататък ще се върнем много внимателно назад на място, като се уверим, че задното ремарке следва траекторията перфектно."

	key[]: "aca_msg_book3_correcting_straight_cutscene06"
	val[]: "Сега можем да подравним предното ремарке и самия влекач."

#### correcting_Straight_Backing Driving Instructions

#!{
	key[]: "aca_msg_book3_correcting_straight_backing_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_correcting_straight_backing_forward"
	val[]: "Изтеглете напред и изправете цялата композиция.<br><br>След като сте доволни от позицията, влезте назад в обозначената зона."

	key[]: "aca_msg_book3_correcting_straight_backing_check1"
	val[]: "Дайте назад към обозначената зона."

#!{
	key[]: "aca_msg_book3_correcting_straight_backing_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"
#!}
	key[]: "aca_msg_book3_correcting_straight_backing_end"
	val[]: "Обезопасете превозното средство и изключете двигателя."

#@}


#+ Book 3 Scenario backing_90_tight
#@{

#### backing_90_tight common
	key[]: "aca_scenario_book3_backing_90_tight_title"
	val[]: "Паркиране назад под 90 градуса"

	key[]: "aca_scenario_book3_backing_90_tight_desc"
	val[]: "В този сценарий ще използвате маневра за паркиране назад под 90 градуса, за да спрете в редица между други камиони."

#### backing_90_tight goal

	key[]: "aca_goal_book3_backing_90_tight_check1"
	val[]: "Обратен завой"

	key[]: "aca_goal_book3_backing_90_tight_check2"
	val[]: "Потегляне"

		key[]: "aca_goal_book3_backing_90_tight_check3"
	val[]: "Движение на заден ход"

#!{
		key[]: "aca_goal_book3_backing_90_tight_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_backing_90_tight_end"
	val[]: "@@aca_goal_book3_sup_end@@"

	key[]: "aca_goal_book3_backing_90_tight_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_backing_90_tight_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
#### backing_90_tight msg - intro text

	key[]: "aca_msg_book3_backing_90_tight_cutscene1"
	val[]: "Движението на заден ход настрани е по-лесно с B-double композиции, тъй като ще имате по-ясна гледна точка през страничния прозорец към всичко, което се случва."

	key[]: "aca_msg_book3_backing_90_tight_cutscene2"
	val[]: "Първо продължете напред и направете обратен завой в края на реда. Това ще ви позволи да подходите от страната с пряка видимост и да следите ситуацията по-лесно през шофьорския прозорец."

	key[]: "aca_msg_book3_backing_90_tight_cutscene3"
	val[]: "Можете да подредите ремаркетата по ваш избор, например като насочите задното ремарке директно към мястото за паркиране. В този случай ще започнем от изправена позиция.<br><br>Не забравяйте златното правило – управлявайте задното ремарке чрез движението на предното."

	key[]: "aca_msg_book3_backing_90_tight_cutscene4"
	val[]: "Завийте с предното ремарке леко в посока, обратна на паркомястото – така задното ще започне да се насочва към него. Оттук нататък коригирайте ъгъла между двете ремаркета, за да поддържате плавна и чиста траектория към мястото за паркиране."

	key[]: "aca_msg_book3_backing_90_tight_cutscene5"
	val[]: "Запомнете: ако задното ремарке влиза твърде остро, трябва леко да изправите ъгъла на композицията. Ако пък прави твърде широк завой, увеличете ъгъла на пречупване."

	key[]: "aca_msg_book3_backing_90_tight_cutscene6"
	val[]: "Корекциите, които правите с влекача, влияят на задното ремарке два пъти по-малко, отколкото на предното. Затова не се притеснявайте да маневрирате по-активно с влекача."

	key[]: "aca_msg_book3_backing_90_tight_cutscene7"
	val[]: "В този момент трябва да започнете да планирате следващия ход. Важно е да вкарате и предното ремарке в паркомястото, така че подгответе маневрата така, че то да се изправи директно пред задното."

	key[]: "aca_msg_book3_backing_90_tight_cutscene8"
	val[]: "Рядко се случва ремаркетата да се вкарат от първия опит. В този случай изчакахме твърде дълго, преди да изправим предното ремарке, и сега задното започва да излиза от траекторията.<br><br>Няма проблем – изтеглете напред и опитайте отново."

	key[]: "aca_msg_book3_backing_90_tight_cutscene9"
	val[]: "Въртете волана смело и наместете ремаркетата точно там, където искате. Можете да изтегляте напред толкова пъти, колкото е необходимо, докато не останете доволни от резултата."

	key[]: "aca_msg_book3_backing_90_tight_cutscene10"
	val[]: "И ето така, успешно паркирахме B-double композицията."

#### backing_90_tight Driving Instructions

#!{
	key[]: "aca_msg_book3_backing_90_tight_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_backing_90_tight_forward"
	val[]: "Продължете напред до края на паркинга и обърнете."

	key[]: "aca_msg_book3_backing_90_tight_check1"
	val[]: "Помнете, че трябва да изнесете завоя по-широко."

	key[]: "aca_msg_book3_backing_90_tight_check2"
	val[]: "Продължете напред, докато прецените, че имате достатъчно място за маневриране, след което започнете да се движите на заден ход."

	key[]: "aca_msg_book3_backing_90_tight_check3"
	val[]: "Паркирайте на заден ход на мястото."

#!{
	key[]: "aca_msg_book3_backing_90_tight_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_backing_90_tight_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


