#+ Book 1 Scenario 1_01
#@{

#### 1_01 common
	key[]: "aca_scenario_book1_1_01_title"
	val[]: "Преди да шофирате"

	key[]: "aca_scenario_book1_1_01_desc"
	val[]: "За вашия първи сценарий ще прегледаме основните неща в кабината на водача. Важно е да регулирате правилно седалката, волана и страничните огледала, тъй като добрата видимост е важна за справяне със стресови или несигурни ситуации.<br><br>Ще прегледаме контролите за регулиране на тези компоненти един по един."

#### 1_01 goal

	key[]: "aca_goal_book1_1_01_adjuster"
	val[]: "Регулиране на седалката и огледалото"

	key[]: "aca_goal_book1_1_01_check_adj"
	val[]: "Огледало и проверка на видимостта"

#### 1_01 msg - intro text

	key[]: "aca_msg_book1_1_01_cutscene1"
	val[]: "Добре дошли в първия си урок!<br>Нека започнем, като научим как да подготвим камиона за тръгване."

	key[]: "aca_msg_book1_1_01_cutscene2"
	val[]: "От решаващо значение е да гарантирате, че вашето шофиране е безопастта, професионализма и контрол по всяко време.<br>Правилното регулиране на седалката, волана и огледалата ще ви помогне да постигнете това."

	key[]: "aca_msg_book1_1_01_cutscene3"
	val[]: "От всяка страна на камиона има няколко превозни средства.<br>Те ще ви помогнат да регулирате правилно огледалата."

	key[]: "aca_msg_book1_1_01_cutscene4"
	val[]: "Отделете време, за да настроите всичко по ваш вкус, тъй като тези настройки<br>ще окажат значително влияние върху способността ви да управлявате камиона."

#### 1_01 Driving Instructions

	key[]: "adj_tut_title_0"
	val[]: "Регулиране на седалка и волан"

	key[]: "adj_tut_title_1"
	val[]: "Регулиране на главните огледала"

	key[]: "adj_tut_title_2"
	val[]: "Регулиране на изпъкнали огледала"

	key[]: "adj_tut_title_3_hood"
	val[]: "Регулиране на огледалата на предния капак"

	key[]: "adj_tut_title_3"
	val[]: "Проверка на видимостта и окончателна настройка на огледалото"

	key[]: "adj_tut_open_adj_keyboard"
	val[]: "натиснете @@imv_nrm_adjuster@@ или го осъществете чрез настройките на превозното средство в менюто за пауза"

	key[]: "adj_tut_open_adj_gamepad"
	val[]: "достъп до него чрез настройките на превозното средство в менюто за пауза"

	key[]: "adj_tut_open_adj"
	val[]: "За да показвате '@@adjust_link_t@@' по време на игра, $OPEN_ADJUSTER$."

	key[]: "adj_tut_open_seat"
	val[]: "Първо, нека регулираме шофьорската седалка и волана.<br><br><font face=/font/big_bold.font>Отворете '@@adj_seats@@', за да продължите.</font>"

	key[]: "adj_tut_open_mirrors"
	val[]: "<font face=/font/big_bold.font>Отворете @@adj_mirrors@@, за да конфигурирате настройките на огледалото.</font>"

	key[]: "adj_tut_open_adj_intro"
	val[]: "Когато се качвате в камион за първи път, важно е първо да регулирате седалката, волана и огледалата по ваш вкус.<br><br>Правилната позиция зад волана е от решаващо значение за правилната видимост. Всички органи за управление трябва да са в обсег и водачът трябва да има ясна видимост напред, настрани и в огледалата.<br><br><font face=/font/big_bold.font>За да покажете менюто за конфигурация, $OPEN_ADJUSTER$. </font>"

	key[]: "adj_tut_set_seat_and_back_adj"
	val[]: "@@adj_tut_set_seat_and_back_adj_img@@<br>Регулирайте седалката така, че да имате ясна видимост към заобикалящата ви среда, както и към огледалата, и така че да можете да достигнете до всички органи за управление.<br><br>Регулирайте волана така, че да е в удобна позиция и не блокира изгледа ви към никакви инструменти.<br><br><font face=/font/big_bold.font>Когато сте доволни от вашите настройки, натиснете @@imv_nrm_back@@, за да се върнете към конфигурационно меню. </font>"

	key[]: "adj_tut_open_mirrors_intro"
	val[]: "@@adj_tut_open_mirrors_intro_img@@<br>Камионите имат много големи слепи зони, така че са оборудвани с множество външни огледала, за да помогнат на водача да вижда възможно най-много. <br><br>Правилната настройка на тези огледала ще ви позволи да имате възможно най-добрата видимост на заобикалящата ви среда.<br><br><font face=/font/big_bold.font>Отворете '@@adj_mirrors@@' за продължи.</font>"

	key[]: "adj_tut_set_mirrors_t1_1_adj"
	val[]: "@@adj_tut_set_mirrors_t1_1_adj_img@@<br>Основните огледала покриват пространството отстрани на камиона и ремаркето.<br><br>За да регулирате правилната позиция на основните огледала, използвайте колите от двете страни на превозното средство за справка.<br><br><font face=/font/big_bold.font>Натиснете @@imv_nrm_selectfcs@@, за да продължите.</font>"

	key[]: "adj_tut_set_mirrors_t1_2_adj"
	val[]: "Основните огледала са вашият основен инструмент, за да видите какво се случва до и зад вас. Трябва да имате добър изглед към колата до вас, но се уверете, че сте запазили част от ремаркето в огледалото, за да ви помогне да прецените точно позицията на препятствията около вас."

	key[]: "adj_tut_set_mirrors_t1_2_adj_big"
	val[]: "След като сте доволни от регулирането, превключете към главното огледало от страната на пътника."

	key[]: "adj_tut_set_mirrors_t1_2_adj_moved"
	val[]: "Отново трябва да имате добър изглед към колата до вас, като в същото време част от ремаркето също се вижда в огледалото."

	key[]: "adj_tut_set_mirrors_t1_2_adj_moved_big"
	val[]: "След като сте доволни от настройката на огледалото, преминете към изпъкнало огледало от страната на водача."

	key[]: "adj_tut_set_mirrors_t1_3_adj"
	val[]: "@@adj_tut_set_mirrors_t1_3_adj_img@@<br>Изпъкналите огледала осигуряват по-широко зрително поле, което ви позволява да виждате повече от това, което се случва до вас.<br><br><font face=/font/big_bold.font>Натиснете @@imv_nrm_selectfcs@@, за да продължите.</font>"

	key[]: "adj_tut_set_mirrors_t1_4_adj"
	val[]: "В идеалния случай трябва да виждате и колата, и камиона, паркирани отстрани, докато много малка част от собствения ви камион все още се вижда."

	key[]: "adj_tut_set_mirrors_t1_4_adj_big"
	val[]: "След като сте доволни от настройката на огледалото, преминете към изпъкнало огледало от страната на пътника."

	key[]: "adj_tut_set_mirrors_t1_4_adj_moved"
	val[]: "Отново, трябва да видите както колата, така и камиона, паркирани отстрани, докато все още се вижда малка част от вашия камион."

	key[]: "adj_tut_set_mirrors_t1_4_adj_moved_big"
	val[]: "След като сте доволни от регулирането на огледалото, преминете към огледалото на предния капак."

	key[]: "adj_tut_set_mirrors_t1_5_adj"
	val[]: "@@adj_tut_set_mirrors_t1_5_adj_img@@<br>Огледалата на капака осигуряват изглед към мъртвите зони от двете страни на кабината на трактора, което ви позволява да видите малки коли и препятствия, които иначе биха могли да бъдат скрити поради големите размери на камиона.<br><br><font face=/font/big_bold.font>Натиснете @@imv_nrm_selectfcs@@, за да продължите.</font>"

	key[]: "adj_tut_set_mirrors_t1_6_adj"
	val[]: "@@adj_tut_set_mirrors_t1_6_adj_img@@<br>Тъй като имате други огледала, за да осигурите гледката зад вас, тези огледала са предназначени само да виждат това, което е до вас. Предният капак и рамената на страничните огледала осигуряват добра референтна рамка за това каква част от собствения ви камион все още трябва да бъде видима. Регулирайте огледалата в правилната позиция, както е показано на диаграмата.<br><br><font face=/font/big_bold.font>След като сте доволни от настройката, превключете към огледалото на предния капак от страната на пътника. </font>"

	key[]: "adj_tut_set_mirrors_t1_6_adj_moved"
	val[]: "@@adj_tut_set_mirrors_t1_6_adj_moved_img@@<br>По същия начин регулирайте позицията на това огледало.<br><br><font face=/font/big_bold.font>След като сте доволни от настройката на огледалото, натиснете @@imv_nrm_back@@, за да затворите настройките на огледалото. </font>"

	key[]: "adj_tut_back_adj"
	val[]: "<font face=/font/big_bold.font>Натиснете @@imv_nrm_back@@, за да се върнете в менюто за конфигурация. </font>"

	key[]: "adj_tut_close_adj"
	val[]: "Отлично, със седала и огледала, настроени по ваш вкус, вече сте една крачка по-близо до тръгването на пътя!<br><br><font face=/font/big_bold.font>Затворете менюто за конфигурация, като използвате @@imv_nrm_back@@. </font>"

	key[]: "adj_tut_open_con"
	val[]: "Огледайте се още веднъж наоколо, за да се уверите, че сте доволни от гледката си от кабината и че огледалата ви осигуряват добра видимост какво се случва около камиона.<br><br>Ако нещо не ви устройва, вие може да регулира огледалата отново в менюто за конфигуриране '@@adjust_link_t@@'. <br><br><font face=/font/big_bold.font>Натиснете @@imv_nrm_activate@@, за да приключите първия сценарий.</font> @@aca_goal_tip@@ За да покажете или скриете огледалата на екрана, можете да отидете към '@@adjust_link_t@@' — '@@adj_ui_mirrors@@' в менюто за пауза. Екранните огледала улесняват виждането от страната на пътника."
#@}

# Book 1 Scenario 1_02 - strings not needing translation
#!{
	key[]: "aca_goal_book1_1_02_cam_top"
	val[]: "@@o_im_freecam@@"

	key[]: "aca_goal_book1_1_02_cam_cabin"
	val[]: "@@o_im_topcam@@"

	key[]: "aca_goal_book1_1_02_cam_window"
	val[]: "@@o_im_uppercam@@"

	key[]: "aca_goal_book1_1_02_cam_interior"
	val[]: "@@o_im_wincam@@"

	key[]: "aca_goal_book1_1_02_end"
	val[]: "@@o_im_insidecam@@"
#!}


#+ Book 1 Scenario 1_02
#@{

#### 1_02 common

	key[]: "aca_scenario_book1_1_02_title"
	val[]: "Управление на камерата"

	key[]: "aca_scenario_book1_1_02_desc"
	val[]: "В този сценарий ще научим за различните видове камери, достъпни за вас, и как те могат да ви помогнат да контролирате и маневрирате камиона."

#### 1_02 goal

	key[]: "aca_goal_book1_1_02_seat"
	val[]: "Позиция за сядане"

	key[]: "aca_goal_book1_1_02_look_back"
	val[]: "Поглед назад"

	key[]: "aca_goal_book1_1_02_mirrors"
	val[]: "Проверка на огледалото"

	key[]: "aca_goal_book1_1_02_cam_behind"
	val[]: "Преминаване към външна камера"

	key[]: "aca_goal_book1_1_02_look_around"
	val[]: "Огледайте камиона"


#### 1_02 msg - intro text

	key[]: "aca_msg_book1_1_02_cutscene1"
	val[]: "В този сценарий ще прегледаме различните камери,<br>които са налични за използване."

	key[]: "aca_msg_book1_1_02_cutscene2"
	val[]: "Има общо седем камери за избор, сега ще прегледаме<br> някои от тях и ще обясним предвидените им функции."

	key[]: "aca_msg_book1_1_02_cutscene3"
	val[]: "Различните камери и различните им ъгли могат да ви помогнат при маневриране на тесни места."


#### 1_02 Driving Instructions

	key[]: "aca_msg_book1_1_02_seat"
	val[]: "Гледането накъде отивате е основната основа за безопасно и професионално шофиране. Ако текущата позиция на сядане не ви подхожда, можете да я промените в '@@adjust_link_t@@' (достъп до нея чрез менюто за пауза).<br><br><font face=/font/big_bold.font>Потвърдете, когато са готови с @@imv_nrm_activate@@. </font>"

	key[]: "aca_msg_book1_1_02_look_back"
	val[]: "При движение на заден ход огледалата ви не винаги предлагат ясна видимост. Може да се наложи да погледнете през прозореца зад себе си, за да получите по-добър изглед.<br><br><font face=/font/big_bold.font>Завъртете камерата си докрай към страната на водача, за да погледнете през прозореца към задната част на ремаркето.</font>@@aca_goal_tip@@ Трябва да сте вътре в превозното средство."

	key[]: "aca_msg_book1_1_02_mirrors"
	val[]: "Използвайте този изглед, за да проверите ремаркето по време на маневри на заден ход с ремарке. Винаги е по-добре да се движите на заден ход от страната на водача, за да можете да използвате този изглед. Когато се движите на заден ход от страната на пътника, имате много по-ограничена видимост на случващото се зад вас.<br><br><font face=/font/big_bold.font>Погледнете към страната на пътника. </font>"

	key[]: "aca_msg_book1_1_02_cam_behind"
	val[]: "Ето защо обикновено не се препоръчва движение на заден ход към страната на пътника; можете да видите, че видимостта е доста ограничена. За щастие има и седем външни камери, достъпни за вас. <br><br>Бутонът @@imv_nrm_camcycle@@ може да се използва за превключване към следващата камера в последователност. След като преминете през всичките седем камери, ще се върнете в началото на цикъла. <br><br><font face=/font/big_bold.font>Натиснете @@imv_nrm_camcycle@@, за да превключите към следващата камера. </font>"

	key[]: "aca_msg_book1_1_02_look_around"
	val[]: "Външната камера осигурява най-добрата перспектива за случващото се около камиона.<br><br><font face=/font/big_bold.font>Огледайте камиона.</font>"

	key[]: "aca_msg_book1_1_02_cam_top"
	val[]: "<font face=/font/big_bold.font>Натискайки отново @@imv_nrm_camcycle@@, можете да превключите към следващата камера. </font>"

	key[]: "aca_msg_book1_1_02_cam_cabin"
	val[]: "Изгледът отгоре надолу осигурява отличен оглед на ситуацията около камиона, значително опростявайки паркирането и шофирането в тесни пространства.<br><br><font face=/font/big_bold.font>Натиснете @@imv_nrm_camcycle@@, за да превключите към следващата камера. </font>"

	key[]: "aca_msg_book1_1_02_cam_window"
	val[]: "Камерата на покрива осигурява ясен изглед на пътя далеч пред камиона без много препятствия.<br><br><font face=/font/big_bold.font>Натиснете @@imv_nrm_camcycle@@, за да превключите към последната камера, която ще разгледам засега.</font>"

	key[]: "aca_msg_book1_1_02_cam_interior"
	val[]: "Изгледът отзад е пряк път към изгледа, който сте получили по-рано чрез завъртане на вътрешната камера. Както обсъдихме, това е полезно при движение на заден ход или паркиране.<br><br>В играта имаме още камери, които можете да изпробвате, като натискате многократно @@imv_nrm_camcycle@@.<br><br><font face=/font /big_bold.font>Натиснете @@imv_nrm_cam1@@, за да се върнете към интериора.</font>"

	key[]: "aca_msg_book1_1_02_end"
	val[]: "За автентично изживяване в автошколата препоръчваме да останете с изгледа „Вътрешна камера“, докато преминавате през всеки от сценариите.<br><br><font face=/font/big_bold.font>Натиснете @@imv_nrm_activate@@, за да потвърдете и завършете сценария.</font>@@aca_goal_tip@@ Можете да използвате функцията @@o_im_cam_zoom@@ за по-добър изглед на заобикалящата ви среда. Това е особено полезно, когато гледате през огледалата. Проверете екрана с опции - „Клавиши и бутони“ - за да видите и/или промените съответните контроли."

#@}

#+ Book 1 Scenario 1_03
#@{

#### 1_03 common
	key[]: "aca_scenario_book1_1_03_title"
	val[]: "Първо шофиране"

	key[]: "aca_scenario_book1_1_03_desc"
	val[]: "В този сценарий ще научим как да подготвим камиона за шофиране и след това да го караме напред за първи път."

#### 1_03 goal

	key[]: "aca_goal_book1_1_03_electrics"
	val[]: "Включване на запалването"

	key[]: "aca_goal_book1_1_03_start"
	val[]: "Стартиране на двигателя"

	key[]: "aca_goal_book1_1_03_look_mirror"
	val[]: "Проверка на заобикалящата среда"

	key[]: "aca_goal_book1_1_03_brake"
	val[]: "Задействане на работната спирачка"

	key[]: "aca_goal_book1_1_03_gear"
	val[]: "Превключване на скорост"

	key[]: "aca_goal_book1_1_03_park_br_off"
	val[]: "Освобождаване на ръчната спирачка"

	key[]: "aca_goal_book1_1_03_forward"
	val[]: "Шофиране напред"

	key[]: "aca_goal_book1_1_03_stop"
	val[]: "Спиране"

	key[]: "aca_goal_book1_1_03_park_br_on"
	val[]: "Задействане на ръчната спирачка"

	key[]: "aca_goal_book1_1_03_gear_n"
	val[]: "Превключване на неутрална предавка"

	key[]: "aca_goal_book1_1_03_end"
	val[]: "Изключване на двигателя"

#### 1_03 msg - intro text

	key[]: "aca_msg_book1_1_03_cutscene1"
	val[]: "За първите ви няколко карания ще използваме само влекача.<br>Камионът се нарича влекач, когато няма собствена товарна каросерия и вместо това разчита на използването на ремарке за превоз на стоки и материали."

	key[]: "aca_msg_book1_1_03_cutscene2"
	val[]: "Тракторите са често срещани, защото позволяват по-голяма гъвкавост: те могат да пуснат празно ремарке и да вземат натоварено, без да се налага да чакат, или дори да преминат изцяло към различен тип ремарке."

	key[]: "aca_msg_book1_1_03_cutscene3"
	val[]: "За първото ви шофиране задачата ви ще бъде да карате напред и да спрете след прекъснатата линия.<br>Стартирайте двигателя, следвайте инструкциите, за да подготвите камиона за движение. След като сте готови, карайте направо."

	key[]: "aca_msg_book1_1_03_cutscene4"
	val[]: "Карайте покрай пунктираната линия, спрете, изключете двигателя и обезопасете камиона."

#### 1_03 Driving Instructions

	key[]: "aca_msg_book1_1_03_electrics"
	val[]: "За следващата стъпка от обучението ви ще преместите камиона за първи път.<br><br>Разбира се, без работещ двигател той няма да работи, така че първо ще трябва да включите запалването. <br><br><font face=/font/big_bold.font>Натиснете $input engineelect$, за да включите запалването.</font>@@aca_goal_tip@@ В Кариера по подразбиране двигателят се включва заедно с електричество автоматично. За кариерата можете да коригирате това поведение в екрана с опции - „Игра“ - @@auto_engine_start@@."

	key[]: "aca_msg_book1_1_03_start"
	val[]: "Запалването активира електрониката на камиона. Може да сте забелязали, че предупредителните лампи мигат на таблото - това е нормално. Ако останат включени след стартиране на двигателя, това вероятно сигнализира за проблем с камиона. Изключение прави лампата за ръчна спирачка, която ще се изключи, когато освободим спирачките за паркиране.<br><br>За щастие този камион е в добро състояние и сме готови да продължим.<br><br><font face= /font/big_bold.font>Натиснете @@imv_nrm_engine@@, за да стартирате двигателя. </font>"

	key[]: "aca_msg_book1_1_03_look_mirror"
	val[]: "Сега, когато двигателят е стартиран, е изключително важно да проверите обкръжението си, преди да започнете каквото и да е движение.<br><br><font face=/font/big_bold.font>Огледайте камиона и страничните огледала на шофьора и пътника, за да се уверите, че зоната около камиона е свободна.</font>@@aca_goal_tip@@ Трябва да сте вътре в превозното средство."

	key[]: "aca_msg_book1_1_03_brake"
	val[]: "Може да изглежда очевидно, но трябва да знаете как да спрете, преди да започнете движение.<br><br><font face=/font/big_bold.font>Активирайте работната спирачка, като използвате $input backward$. </font>"

	key[]: "aca_msg_book1_1_03_gear_arcade"
	val[]: "След това ще научите как да промените посоката си на движение.<br><br>С опростената автоматична скоростна кутия няма нужда да превключвате скоростите, всичко се прави автоматично вместо вас.<font face=/font/big_bold.font <br><br>Използвайте $input forward$, за да активирате предавка напред. </font>"

	key[]: "aca_msg_book1_1_03_gear_automatic"
	val[]: "След това ще научите как да промените посоката си на движение.<br><br>Реалистичната автоматична скоростна кутия ви позволява да превключвате между задвижване, неутрално положение и заден ход точно като истински автоматични трансмисии.<br><br><font face= /font/big_bold.font>Натиснете @@imv_nrm_gearup@@, за да активирате предавка напред. </font>"

	key[]: "aca_msg_book1_1_03_gear_manual"
	val[]: "След това ще научите как да променяте посоката си на движение.<br><br>Секвенциалната трансмисия позволява стъпаловидно превключване, точно като истинските секвенциални трансмисии.<br><br>По същия начин, по който включвате предна предавка, докато ускорявате, ще трябва да превключите на по-високи предавки.<br><br><font face=/font/big_bold.font>Натиснете @@imv_nrm_gearup@@, за да включите първа предавка.</font>"

	key[]: "aca_msg_book1_1_03_gear_direct"
	val[]: "След това ще научите как да променяте посоката си на движение.<br><br>С лоста за скоростите и съединителя ще изпитате същото усещане при физическо превключване на предавките, както при истинска ръчна скоростна кутия.<br><br > Натиснете докрай съединителя и работната спирачка. <font face=/font/big_bold.font>Използвайте скоростния лост, за да включите първа предавка. <color value=@@clr_txt@@>Дръжте съединителя и работната спирачка напълно натиснати.</font>"

	key[]: "aca_msg_book1_1_03_park_br_off"
	val[]: "За да започнете да се движите, първо трябва да освободите ръчната спирачка.<br><br><font face=/font/big_bold.font>Използвайте @@imv_nrm_parkingbrake@@, за да освободите ръчната спирачка.</font> @@aca_goal_tip@@ В Career ръчната спирачка първоначално е деактивирана. Можете да коригирате това поведение в екрана с опции – „Игра“ – @@auto_park_brake@@."

	key[]: "aca_msg_book1_1_03_forward_arcade"
	val[]: "Сега камионът е готов да се движи напред. Започнете да се движите и пресечете пунктираната линия.<br><br><font face=/font/big_bold.font>Започнете движение с помощта на ускорителя: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_automatic"
	val[]: "Сега камионът е готов да се движи напред. Започнете да се движите и пресечете пунктираната линия.<br><br><font face=/font/big_bold.font>Започнете движение с помощта на ускорителя: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_manual"
	val[]: "Сега камионът е готов да се движи напред. Започнете да се движите и пресечете пунктираната линия.<br><br><font face=/font/big_bold.font>Започнете движение с помощта на ускорителя: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_direct"
	val[]: "Сега камионът е готов да се движи напред. Започнете да се движите и пресечете пунктираната линия.<br><br><font face=/font/big_bold.font>Освободете работната спирачка, постепенно отпуснете съединителя, за да го включите, като едновременно с това използвате газта, за да поддържате оборотите си високи, така че камионът не спира. След като съединителят е напълно освободен, можете да ускорите и да превключите, ако е необходимо. </font>"

	key[]: "aca_msg_book1_1_03_stop_arcade"
	val[]: "Използвайте работната спирачка, за да спрете.<br><br><font face=/font/big_bold.font>Използвайте $input backward$, за да спрете камиона. </font>"

	key[]: "aca_msg_book1_1_03_stop_automatic"
	val[]: "Използвайте работната спирачка, за да спрете.<br><br><font face=/font/big_bold.font>Използвайте $input backward$, за да спрете камиона. </font>"

	key[]: "aca_msg_book1_1_03_stop_manual"
	val[]: "Използвайте работната спирачка, за да спрете.<br><br><font face=/font/big_bold.font>Използвайте $input backward$, за да спрете камиона. </font>"

	key[]: "aca_msg_book1_1_03_stop_direct"
	val[]: "Когато дойде време да спрете, натиснете съединителя докрай <font face=/font/big_bold.font>и след това спрете камиона, като използвате работната спирачка.<color value=@@clr_txt@@> Превключете на неутрална предавка с помощта на скоростния лост и тогава можете да освободите съединителя. </font>"

	key[]: "aca_msg_book1_1_03_park_br_on"
	val[]: "Сега обезопасете камиона. Ръчната спирачка гарантира, че камионът няма да се движи неволно, след като сте паркирали.<br><br><font face=/font/big_bold.font>Използвайте @@imv_nrm_parkingbrake@@, за да активирате ръчната спирачка.</font>"

	key[]: "aca_msg_book1_1_03_gear_n_arcade"
	val[]: "С опростената автоматична скоростна кутия няма нужда да превключвате скоростите, всичко се прави автоматично за вас.<br><br><font face=/font/big_bold.font>Натиснете @@imv_nrm_activate@@ за потвърждение. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>Превключете в неутрално положение, като натиснете @@imv_nrm_geardown@@.</font>"

	key[]: "aca_msg_book1_1_03_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>Превключете в неутрално положение, като натиснете @@imv_nrm_geardown@@.</font>"

	key[]: "aca_msg_book1_1_03_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>Превключете скоростния лост в неутрално положение, след което отпуснете съединителя. </font>"

	key[]: "aca_msg_book1_1_03_end"
	val[]: "Вече знаете как да накарате камиона да се движи и как да го спрете безопасно.<br><br><font face=/font/big_bold.font>Натиснете $input engineelect$, за да изключите двигателя. </font>"
#@}

#+ Book 1 Scenario 1_04
#@{

#### 1_04 common
	key[]: "aca_scenario_book1_1_04_title"
	val[]: "Заден ход"

	key[]: "aca_scenario_book1_1_04_desc"
	val[]: "В този сценарий ще опитаме да се обърнем за първи път. Ще говорим и за това как да използвате огледалата си, за да виждате зад себе си, за какво да следите и как да се подготвите за движение на заден ход."

#### 1_04 goal

	key[]: "aca_goal_book1_1_04_start"
	val[]: "Стартиране на двигателя"

	key[]: "aca_goal_book1_1_04_look_mirror"
	val[]: "Проверка на страничното огледало на пътника"

	key[]: "aca_goal_book1_1_04_look_back"
	val[]: "Проверка на страничното огледало на пътника"

	key[]: "aca_goal_book1_1_04_gear_r"
	val[]: "Превключване на скорост"

	key[]: "aca_goal_book1_1_04_park_br_off"
	val[]: "Освобождаване на ръчната спирачка"
#!{
	key[]: "aca_goal_book1_1_04_backward"
