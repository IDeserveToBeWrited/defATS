#### 3_02 msg - intro text

	key[]: "aca_msg_book1_3_02_cutscene01"
	val[]: "При този сценарий ще вземем камиона за кратко шофиране. Ще можете да усетите спирането с ремарке, докато се спускаме по лекия наклон напред. Подгответе камиона и тръгвайте."

	key[]: "aca_msg_book1_3_02_cutscene06"
	val[]: "Достигнете скорост от поне 60 км/ч (37 мл/ч). Бъдете готови за зоната на спиране отпред."

	key[]: "aca_msg_book1_3_02_cutscene08"
	val[]: "Започнете да спирате до спиране. Уверете се, че не чакате твърде дълго, или можете да ударите бариерите пред вас!"

	key[]: "aca_msg_book1_3_02_cutscene10"
	val[]: "Спрете на определеното място, след това обезопасете камиона и изключете двигателя."


#### 3_02 Driving Instructions

	key[]: "aca_msg_book1_3_02_start"
	val[]: "По време на това шофиране ще получите усещане за използване на работните спирачки, докато се спускате по лек наклон. Целта на тази тренировка е да осъзнаете тежестта зад вас и как тя влияе на спирачния път на автомобила.<br><br><font face=/font/big_bold.font>Пригответе се да потеглите. </font>"

	key[]: "aca_msg_book1_3_02_forward"
	val[]: "Започнете да шофирате сега и имайте предвид, че ще трябва да достигнете скорост от 60 км/ч (37 мили в час) <font face=/font/big_bold.font>след</font> завоя пред вас.<br><br><font face=/font/big_bold.font>Карайте към завоя отпред. </font>"

	key[]: "aca_msg_book1_3_02_check1"
	val[]: "Завийте надясно, след което ускорете до 60 км/ч (37 мили/ч).<br><br><font face=/font/big_bold.font>Продължете да шофирате. </font>"

	key[]: "aca_msg_book1_3_02_check2"
	val[]: "<font face=/font/big_bold.font>Достигнете скорост от поне 60 км/ч (37 мили/ч). </font>"

	key[]: "aca_msg_book1_3_02_check3"
	val[]: "Достигнахте необходимата скорост.<br><br><font face=/font/big_bold.font>Спрете при бариерите отпред. </font>"
#!{
	key[]: "aca_msg_book1_3_02_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_02_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

