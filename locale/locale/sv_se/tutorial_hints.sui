
    key[]: "hint_engine_title"
	val[]: "Starta motorn"

    key[]: "hint_engine_text"
	val[]: "Använd $KEY_engine$ för att starta motorn."


    key[]: "hint_ignition_title"
	val[]: "Starta tändningen"

    key[]: "hint_ignition_text"
	val[]: "Använd $KEY_engineelect|KEY_engine$ för att starta tändningen."


    key[]: "hint_driv_arc_title"
	val[]: "Köra"

    key[]: "hint_driv_arc_text"
	val[]: "Använd $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ och $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ för att köra framåt och bakåt.<br><offset vshift=8>Använd $SPECIAL_steering$ för att styra."


    key[]: "hint_driv_auto_title"
	val[]: "Köra"

    key[]: "hint_driv_auto_text"
	val[]: "Använd $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ och $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ för att köra framåt och bakåt.<br><offset vshift=8>Använd $SPECIAL_steering$ för att styra.<br><offset vshift=8>Tryck $KEY_gearup$ och $KEY_geardown$ för val av växel."


    key[]: "hint_driv_seq_title"
	val[]: "Köra"

    key[]: "hint_driv_seq_text"
	val[]: "Använd $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ och $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ för att köra framåt och bakåt.<br><offset vshift=8>Använd $SPECIAL_steering$ för att styra.<br><offset vshift=8>Tryck $KEY_gearup$ och $KEY_geardown$ för att styra kopplingen."


    key[]: "hint_driv_hshift_title"
	val[]: "Köra"

    key[]: "hint_driv_hshift_text"
	val[]: "Använd $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ och $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ för att köra framåt och bakåt.<br><offset vshift=8>Använd $SPECIAL_steering$ för att styra.<br><offset vshift=8>Byt växel med <color value=@@clr_sel@@>växelspaken<color value=@@clr_txt@@>."


    key[]: "hint_depot_deliv_title"
    val[]: "Kör mot destinationen"

    key[]: "hint_depot_deliv_text"
    val[]: "Stanna i det markerade området och välj svårighetsgrad för slutgiltig parkeringsplats och tjäna erfarenhetspoäng."


    key[]: "hint_fin_deliv_title"
    val[]: "Slutför leveransen"

    key[]: "hint_fin_deliv_text"
    val[]: "Parkera på vald parkeringsplats. Du kan trycka $KEY_activate$ för att hoppa över när du är nära leveransplatsen."


    key[]: "hint_fin_deliv2_title"
    val[]: "Slutför leveransen"

    key[]: "hint_fin_deliv2_text"
    val[]: "Parkera på vald parkeringsplats. Du kan aktivera en widget i @@desktop_menu_category_options@@ för att tillåta att hoppa över att parkera."


    key[]: "hint_lights_title"
    val[]: "Slå på belysningen"

    key[]: "hint_lights_text"
    val[]: "Använd $KEY_light$ för slå på belysningen. Stega igenom olika lägen genom att trycka flera gånger."


    key[]: "hint_high_beam_title"
    val[]: "Slå på helljuset"

    key[]: "hint_high_beam_text"
    val[]: "Använd $KEY_hblight$ för att slå på helljuset."


    key[]: "hint_wipers_title"
    val[]: "Slå på vindrutetorkarna"

    key[]: "hint_wipers_text"
    val[]: "Använd $KEY_wipers$ för att slå på vindrutekorkarna och stega genom olika hastigheter."


    key[]: "hint_zoom_title"
    val[]: "Titta närmare"

    key[]: "hint_zoom_text"
    val[]: "Använd $KEY_camzoom$ för att zooma medans du är i ett fordon. Du kan sätta zoom-läge till håll inne eller växla i @@desktop_menu_category_options@@."


    key[]: "hint_cam_int_title"
    val[]: "Se dig omkring"

    key[]: "hint_cam_int_text"
    val[]: "Använd $KEY_cam1$ för att växla kameravinkel till inne i hytten."


    key[]: "hint_cam_ext_title"
    val[]: "Se dig omkring"

    key[]: "hint_cam_ext_text"
    val[]: "Du kan bläddra igenom olika kameravinklar genom att trycka $KEY_camcycle$.<br><offset vshift=8>Använd $KEY_cam2$ för att växla till kameravinkeln utanför fordonet."


    key[]: "hint_indicators_title"
    val[]: "Blinkers"

    key[]: "hint_indicators_text"
    val[]: "Använd $KEY_lblinker$ och $KEY_rblinker$ för att slå på blinkers."


    key[]: "hint_tow_title"
    val[]: "Bärgningstjänst"

    key[]: "hint_tow_text"
    val[]: "Om du inte lyckas ta dig ur en besvärlig situation så kan du använda bärgningstjänsten. För att komma åt den, öppna @@quick_info_word@@ menyn med hjälp av $KEY_advmouse$."


    key[]: "hint_diff_lock_title"
    val[]: "Differentialspärr"

    key[]: "hint_diff_lock_text"
    val[]: "Om du inte kan köra iväg, så kanske differentialspärren kan vara till din hjälp. Använd $KEY_diflock$ för att aktivera den eller slå på automatisk differentialspärr i @@desktop_menu_category_options@@."


    key[]: "hint_diff_unlock_title"
    val[]: "Differentialspärr aktiverad"

    key[]: "hint_diff_unlock_text"
    val[]: "Du bör stänga av differentialspärren vid vanlig körning för att undvika att skada den. Använd $KEY_diflock$ för att stänga av den eller slå på automatisk differentialspärr i @@desktop_menu_category_options@@."


    key[]: "hint_wipers_off_title"
    val[]: "Stäng av vindrutetorkarna"

    key[]: "hint_wipers_off_text"
    val[]: "Använd $KEY_wipers$ för att stänga av vindrutetorkarna och stega genom olika hastigheter."


    key[]: "hint_world_map_title"
    val[]: "Kartvy"

    key[]: "hint_world_map_text"
    val[]: "Använd $KEY_navmap$ för att öppna världskartan."


    key[]: "hint_pause_title"
    val[]: "@@quick_info_word@@"

    key[]: "hint_pause_text"
    val[]: "Use $KEY_advmouse$ to open @@quick_info_word@@ - overview of your status with convenient shortcuts."


    key[]: "hint_pause_border_title"
    val[]: "Lokala regler och föreskrifter"

    key[]: "hint_pause_border_text"
    val[]: "Använd $KEY_advmouse$ för att öppna @@quick_info_word@@ och se nuvarande regler och föreskrifter för regionen du har ankommit till."


    key[]: "hint_photo_trophy_title"
    val[]: "@@landmark_word@@"

    key[]: "hint_photo_trophy_text"
    val[]: "Open @@quick_info_word@@ using $KEY_advmouse$ to enter @@photo_mode_word@@ and capture nearby @@landmark_word@@ <img src=/material/ui/map/photo_sight_not_captured.mat width=20 height=20>."


    key[]: "hint_viewpoint_title"
    val[]: "@@viewpoint_title@@ i närheten"

    key[]: "hint_viewpoint_text"
    val[]: "@@viewpoint_title@@ <img src=/material/ui/map/viewpoint_unseen.mat width=20 height=20> är i närheten - hitta den och aktivera för att visa filmsekvensen."


    key[]: "hint_resting_title"
    val[]: "Rastplats i närheten"

    key[]: "hint_resting_text"
    val[]: "Resting places <img src=/material/ui/map/parking_ico.mat width=20 height=20> help you recover from fatigue and take your mandatory break to safely continue your journey."


    key[]: "hint_gas_title"
    val[]: "Bensinstation i närheten"

    key[]: "hint_gas_text"
    val[]: "Bensinstationer <img src=/material/ui/map/gas_ico.mat width=20 height=20> kan användas för att tanka ditt fordon."


    key[]: "hint_car_job_title"
    val[]: "First courier job"

    key[]: "hint_car_job_text"
    val[]: "Complete the delivery - drive safely, take care of the cargo, and arrive at the expected time. Be aware of the customer priority that affects your rating and reward.<br><offset vshift=8>Press $KEY_advmouse$ to view job details."


    key[]: "hint_tour_board_title"
    val[]: "Turisttavla"

    key[]: "hint_tour_board_text"
    val[]: "En turisttavla finns i närheten. Aktivera den för att låsa upp dess innehåll i <color value=@@clr_sel@@>@@tourist_atlas_link@@</color> för att guida dig i att utforska närliggande landmärken och sevärdheter."


    key[]: "hint_tb_first_title"
    val[]: "First location explored"

    key[]: "hint_tb_first_text"
    val[]: "Du har utforskat den första platsen för en lokal turisttavla. Du kan se detaljer i <color value=@@clr_sel@@>@@tourist_atlas_link@@</color>. Utforska alla platser för att lära dig mer och få belöningar."


    key[]: "hint_tb_bef_compl_title"
    val[]: "One location remaining"

    key[]: "hint_tb_bef_compl_text"
    val[]: "Endast en plats återstår innan du har fullständigt utforskat din första lokala turisttavla och erhåller ett vykort."


    key[]: "hint_tb_done_title"
    val[]: "Turisttavla utforskad"

    key[]: "hint_tb_done_text"
    val[]: "Du har korrekt utforskat alla platser av en lokal turisttavla. Du kan se detaljer i <color value=@@clr_sel@@>@@tourist_atlas_link@@</color>. Som belöning så kan du visa upp vykortet i ditt fordon."


    key[]: "hint_vehicle_prio_title"
    val[]: "Customer priority - vehicle condition"

    key[]: "hint_vehicle_prio_text"
    val[]: "The customer has placed a higher priority on vehicle condition - your bonus reward or penalty will be greatly affected by the state of the vehicle you arrive in. Drive safely and take care of your vehicle.<br><offset vshift=8>Press $KEY_advmouse$ to view job details."


    key[]: "hint_cargo_prio_title"
    val[]: "Customer priority - cargo handling"

    key[]: "hint_cargo_prio_text"
    val[]: "The customer has placed a higher priority on cargo handling - your bonus reward or penalty will be greatly affected by the state of the cargo you deliver. Drive safely and take care of your cargo.<br><offset vshift=8>Press $KEY_advmouse$ to view job details."


    key[]: "hint_time_prio_title"
    val[]: "Customer priority - time management"

    key[]: "hint_time_prio_text"
    val[]: "The customer has placed a higher priority on time management - your bonus reward or penalty will be greatly affected by your ability to be punctual. Drive safely and arrive at a time the customer expects you.<br><offset vshift=8>Press $KEY_advmouse$ to view job details."


    key[]: "hint_car_deliv_title"
    val[]: "Approach the destination"

    key[]: "hint_car_deliv_text"
    val[]: "Stop in the marked area to finish the delivery.<br>Remember that the customer expects delivery at a specific time."


    key[]: "hint_car_early_title"
	val[]: "Early arrival"

    key[]: "hint_car_early_text"
    val[]: "The delivery is expected at a specific time, and arriving early will result in customer dissatisfaction. Plan your journey and use available resting places if needed."


#!{
    key[]: "hint_sm_throttle_title"
	val[]: "@@throttle_double_tap@@"
#!}

    key[]: "hint_sm_throttle_text"
    val[]: "You can enable smart throttle control in @@desktop_menu_category_options@@. By enabling it, the vehicle will hold lower throttle by default. After quickly pressing the throttle button twice, the vehicle will hold full throttle until the button is released."
