	key[]: "aca_msg_book1_2_04_check2"
	val[]: "@@aca_msg_book1_2_01_stop@@"
#!}
	key[]: "aca_msg_book1_2_04_end"
	val[]: "<font face=/font/big_bold.font>Çekiciyi emniyete alın ve motoru kapatın.</font>@@aca_goal_tip@@ Aynalara bakmayı kolaylaştırmak için ön ayarları kullanabilirsiniz. İlgili kontrolleri görmek ve/veya değiştirmek için Seçenekler Ekranı - '@@options_bindings_screen@@' kısmını kontrol edin."
#@}

