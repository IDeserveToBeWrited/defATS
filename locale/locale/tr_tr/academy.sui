	key[]: "aca_goal_book1_3_20_park1"
	val[]: "Köşe Kapmaca 2"

	key[]: "aca_goal_book1_3_20_park2"
	val[]: "Çapraz Park Etmek"

	key[]: "aca_goal_book1_3_20_park3"
	val[]: "Otoparkta Sürüş"

	key[]: "aca_goal_book1_3_20_park4"
	val[]: "Paralel Park Etmek"

	key[]: "aca_goal_book1_3_20_park5"
	val[]: "Son Park Etme"


#### 3_20 msg - intro text

	key[]: "aca_msg_book1_3_20_cutscene01"
	val[]: "Final sınavının ikinci bölümüne hoş geldiniz. Yakındaki bir otoparka gideceğiz ve park yerlerine geri geri girme ve manevra yapma becerilerinizi test edeceğiz."

	key[]: "aca_msg_book1_3_20_cutscene02"
	val[]: "Becerilerinizi değerlendirebileceğiniz, peşi sıra gelen birkaç park etme mücadelesi sizi bekliyor."

	key[]: "aca_msg_book1_3_20_cutscene03"
	val[]: "Burada yerimiz dar, dikkatli olun ve acele etmeyin."

	key[]: "aca_msg_book1_3_20_cutscene04"
	val[]: "Etrafınızdaki alanı iyi kullanın ve bütün aynalarınızdan istifade edin. İyi şanslar!"




#### 3_20 outro text

	key[]: "aca_msg_book1_3_20_outro01"
	val[]: "Tebrikler, Çekici Şoförlüğünün Temelleri sınavlarını geçtiniz ve çekiciyle manevra yapmak için gereken bütün becerileri öğrendiniz."

	key[]: "aca_msg_book1_3_20_outro02"
	val[]: "Bu, usta bir çekici şoförü olma hayalinizi gerçekleştirme yolculuğunuzdaki ilk adımdır."

	key[]: "aca_msg_book1_3_20_outro03"
	val[]: "Artık Amerika yollarına çıkmaya ve ilk zorluklarla yüzleşmeye hazırsınız..."

	key[]: "aca_msg_book1_3_20_outro04"
	val[]: "... ama macera daha yeni başlıyor."


#### 3_20 Driving Instructions

	key[]: "aca_msg_book1_3_20_start"
	val[]: "Dikkatli olmayı ve acele etmemeyi unutmayın. İlk denemede başaramazsanız sorun değil, önemli olan çekiciye veya etrafınızdakilere zarar vermemek. <font face=/font/big_bold.font><br><br>Yola çıkmaya hazır olun.</font>"

	key[]: "aca_msg_book1_3_20_forward"
	val[]: "<font face=/font/big_bold.font>Sınavın ilk kısmına doğru ilerleyin.</font>"

	key[]: "aca_msg_book1_3_20_park1"
	val[]: "İlk göreviniz, geri geri park etme manevrasını göstermektir. Dorseyle geri geri yanaşmanız gereken yer solunuzdadır.<br><br><font face=/font/big_bold.font>Geri geri park etme manevrası yapın.</font>"

	key[]: "aca_msg_book1_3_20_park2"
	val[]: "Bir sonraki görev, hareketsiz çekicilerin olduğu bir sıraya geri geri girmektir. Diğer çekicilere çarpmamaya dikkat edin!<br><br><font face=/font/big_bold.font>Çapraz park etme manevrası yapın.</font>"

	key[]: "aca_msg_book1_3_20_park3"
	val[]: "Otoparktan devam edin. Ani durumlara dikkat edin.<br><br><font face=/font/big_bold.font>Sürmeye devam edin.</font>"

	key[]: "aca_msg_book1_3_20_park4"
	val[]: "Şimdi önünüzdeki kaldırım kenarının yanındaki iki çekicinin arasına paralel park etmeye çalışalım.<br><br><font face=/font/big_bold.font>Paralel park etme manevrası yapın.</font>"

	key[]: "aca_msg_book1_3_20_park5"
	val[]: "Solunuza son bir park etme manevrası yapacaksınız. Buna arzu ettiğiniz şekilde yanaşabilirsiniz.<br><br><font face=/font/big_bold.font>Belirtilen yere geri geri girin.</font>"

	key[]: "aca_msg_book1_3_20_park6"
	val[]: "Bitti sayılır. Test alanından çıkın ve çekiciyi park edin.<br><br><font face=/font/big_bold.font>Sol taraftan çıkın.</font>"

	key[]: "aca_msg_book1_3_20_stop"
	val[]: "Sağ tarafa diğer çekicilerin yanına park edebilirsiniz.<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_20_end"
	val[]: "@@aca_msg_book1_2_01_end@@"


#!}

#@}


