#!}

	key[]: "aca_msg_book1_3_13_check2"
	val[]: "Çok fazla yer olmadığından hemen direksiyon simidini çevirmeyi unutmayın.<br><br><font face=/font/big_bold.font>Arkanızdaki işaretli yere geri geri girin.</font>"


#@}

