#### 3_19 msg - intro text

	key[]: "aca_msg_book1_3_19_cutscene01"
	val[]: "Final sınavının ilk bölümüne hoş geldiniz. Burada, Akademide geçirdiğiniz süre boyunca çekici sürmeyi ne kadar iyi öğrendiğinizi göreceğiz."

	key[]: "aca_msg_book1_3_19_cutscene02"
	val[]: "Önce dorseyi bağlayacaksınız. Akabinde çekiciyi bütün test pisti boyunca süreceksiniz."

	key[]: "aca_msg_book1_3_19_cutscene03"
	val[]: "Testin ilk kısmı, sizi şehir merkezine doğru götürecek bazı tali yollara çıkıyor."

	key[]: "aca_msg_book1_3_19_cutscene04"
	val[]: "Test pistinde çeşitli virajlar ve engeller yer alıyor."

	key[]: "aca_msg_book1_3_19_cutscene05"
	val[]: "Pistin küçük bir kısmı şehir merkezinden geçiyor."

	key[]: "aca_msg_book1_3_19_cutscene06"
	val[]: "Çekiciyle farklı engeller ve pistler boyunca manevra yapma kabiliyetinizi test edeceğiz."

	key[]: "aca_msg_book1_3_19_cutscene07"
	val[]: "Etrafınıza karşı dikkatinizi sınayacak çeşitli durumlarla karşılaşacaksınız."

	key[]: "aca_msg_book1_3_19_cutscene08"
	val[]: "Bir sanayi tesisinden geri geri geçeceksiniz."

	key[]: "aca_msg_book1_3_19_cutscene09"
	val[]: "Şehir merkezinde, sanayi tesisinde ve yollarda sürdükten sonra @@driving_academy@@ genel merkezine doğru gideceksiniz."

	key[]: "aca_msg_book1_3_19_cutscene10"
	val[]: "Yolda kısa bir sürüşten sonra bitti sayılır."

	key[]: "aca_msg_book1_3_19_cutscene11"
	val[]: "Testi tamamlamak için doğru park etmeniz gerekiyor. Size en uygun manevrayı seçebilirsiniz."

	key[]: "aca_msg_book1_3_19_cutscene12"
	val[]: "Endişeye mahal yok, geçmeniz için gereken her şeyi öğrendiniz.<br><br>İyi şanslar!"

#### 3_19 Driving Instructions



	key[]: "aca_msg_book1_3_19_forward"
	val[]: "Önce dorseyi bulup bağlamanız gerekiyor. Dorse ileride, sağ tarafta park hâlinde.<br><br><font face=/font/big_bold.font>Dorseye doğru sürün.</font>"

	key[]: "aca_msg_book1_3_19_coupling"
	val[]: "Sola dönün, ardından dorseye doğru geri gidip kendinizi dorseyle aynı hizaya getirin.<br><br><font face=/font/big_bold.font>Dorseye doğru geri gidin.</font>"

	key[]: "aca_msg_book1_3_19_park_br_on"
	val[]: "<font face=/font/big_bold.font>Çekiciyi emniyete alın. </font>"

	key[]: "aca_msg_book1_3_19_connect"
	val[]: "<font face=/font/big_bold.font>Dorseyi bağlamak için @@imv_nrm_attach@@ düğmesine basın.</font>"

	key[]: "aca_msg_book1_3_19_park_br_off"
	val[]: "Dorse bağlandı ve çekici sürüşe hazır.<br><br><font face=/font/big_bold.font>El frenini indirin.</font>"

	key[]: "aca_msg_book1_3_19_b_trailer"
	val[]: "Yol, test maksadıyla kapatıldı. Trafik işaretlerine uymayı veya uymamayı tercih edebilirsiniz.<br><br><font face=/font/big_bold.font>Yola doğru sürün.</font>"

	key[]: "aca_msg_book1_3_19_check01"
	val[]: "İlk birkaç dönüşü geçin. <br><br><font face=/font/big_bold.font>Sürmeye devam edin.</font>"

	key[]: "aca_msg_book1_3_19_check02"
	val[]: "Bir sonraki dönüşten sonra trafik konilerinden oluşan bir slalom var.<br><br><font face=/font/big_bold.font>Trafik konileri arasından dikkatlice ilerleyin.</font>"

	#key[]: "aca_msg_book1_3_19_check02a"
	#val[]: "Continue through the roundabout into the town.<br><br><font face=/font/big_bold.font>Negotiate the roundabout.</font>"

	key[]: "aca_msg_book1_3_19_check02b"
	val[]: "Birkaç 90 derecelik dönüş daha sizi bekliyor. <br><br><font face=/font/big_bold.font>Sürmeye devam edin.</font>"

	key[]: "aca_msg_book1_3_19_check03"
	val[]: "Bir sonraki dönüş çok keskin, geçmek için bütün yolu kullanmanız gerekecek.<br><br><font face=/font/big_bold.font>Sağa dönüp dar sokaktan geçin.</font>"

	key[]: "aca_msg_book1_3_19_check04"
	val[]: "Sola dönüp dar sokaktan çıkın, akabinde sağdan ana yola çıkın.<br><br><font face=/font/big_bold.font>Sürmeye devam edin.</font>"

	key[]: "aca_msg_book1_3_19_check05"
	val[]: "Ana yolda ilerlerken biraz dinlenebilirsiniz. <br><br><font face=/font/big_bold.font>Düz devam edin.</font>"

	key[]: "aca_msg_book1_3_19_check06"
	val[]: "Servis yoluna girerken ve çıkarken bazı keskin dönüşler var.<br><br><font face=/font/big_bold.font>Dönüşlerden dikkatli bir şekilde geçin.</font>"

	key[]: "aca_msg_book1_3_19_check07"
	val[]: "Daha karmaşık bir slaloma giriyorsunuz. Yavaş ilerleyin ve aynalarınızı kullanın. <br><br><font face=/font/big_bold.font>Sürmeye devam edin ve slalomda dikkatli bir şekilde ilerleyin.</font>"

	key[]: "aca_msg_book1_3_19_check08"
	val[]: "Soldan sanayi bölgesine girin, ışık direğine dikkat edin.<br><br><font face=/font/big_bold.font>Sola dönün.</font>"

	key[]: "aca_msg_book1_3_19_check09"
	val[]: "Geri gitmeye hazırlanın.<br><br><font face=/font/big_bold.font>Sağa dönüp ayrılmış yerde durun.</font>"

	key[]: "aca_msg_book1_3_19_check10"
	val[]: "Geri geri gidin ve sol arkanızdaki pisti takip edin.<br><br><font face=/font/big_bold.font>Geri geri gitmeye başlayın.</font>"

	key[]: "aca_msg_book1_3_19_check11"
	val[]: "Soldaki pisti takip edin. <br><br><font face=/font/big_bold.font>Geri geri gitmeye devam edin.</font>"

	key[]: "aca_msg_book1_3_19_check12"
	val[]: "<font face=/font/big_bold.font>İleriye doğru sürün ve sağa dönün.</font>"

	key[]: "aca_msg_book1_3_19_check13"
	val[]: "<font face=/font/big_bold.font>Kapıya doğru devam edin.</font>"

	key[]: "aca_msg_book1_3_19_check14"
	val[]: "Kapının açılmasını bekleyin, akabinde ana yola geri dönün.<br><br><font face=/font/big_bold.font>Sürmeye devam edin.</font>"

	key[]: "aca_msg_book1_3_19_check15"
	val[]: "Levhaya çarpmamaya dikkat edin.<br><br><font face=/font/big_bold.font>Dönüşü yapın ve sürmeye devam edin.</font>"

	key[]: "aca_msg_book1_3_19_check16"
	val[]: "<font face=/font/big_bold.font>Sola dönüp Akademiye girin. </font>"

	key[]: "aca_msg_book1_3_19_check17"
	val[]: "<font face=/font/big_bold.font>Dümdüz devam edin.</font>"

	key[]: "aca_msg_book1_3_19_check18"
	val[]: "Virajdan sonra keskin bir dönüş olduğundan dış tarafta kalın.<br><br><font face=/font/big_bold.font>Virajı takip edin.</font>"

	key[]: "aca_msg_book1_3_19_check19"
	val[]: "<font face=/font/big_bold.font>Sola dönün ve sol tarafa park etmeye hazırlanın.</font>"

	key[]: "aca_msg_book1_3_19_check20"
	val[]: "<font face=/font/big_bold.font>Park yerine geri geri girin.</font>"
