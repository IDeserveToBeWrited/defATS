	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
	key[]: "aca_msg_book1_3_21_forward"
	val[]: "Solda bir park yeri var. İyice geçin ve 45 derecelik bir açıyla vaziyet alın.<br><br><font face=/font/big_bold.font>İleri sürün.</font>"

	key[]: "aca_msg_book1_3_21_check1"
	val[]: "Çekiciyi işaretlerle aynı hizaya getirin.<br><br><font face=/font/big_bold.font>İşaretli yerde durun.</font>"

	key[]: "aca_msg_book1_3_21_check2"
	val[]: "Önceki senaryolardan edindiğiniz bilgileri kullanarak dorseyi park yerine sokun.<br><br><font face=/font/big_bold.font>Geri gitmeye başlayın.</font>"

	key[]: "aca_msg_book1_3_21_stop"
	val[]: "Dorseyi park yerine sokmaya devam edin.<br><br>@@aca_msg_book1_2_01_stop@@"


