	val[]: "Bir Dorse ile Paralel Park Etmek"

	key[]: "aca_scenario_book1_3_22_desc"
	val[]: "Bu senaryoda dorseniz bağlıyken paralel park etmeyi ele alacağız."

#### 3_22 goal


	key[]: "aca_goal_book1_3_22_stopmid"
	val[]: "İşaretli Yerde Durmak"
