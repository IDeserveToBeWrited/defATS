#### 2_06 msg - intro text

	key[]: "aca_msg_book1_2_06_cutscene01"
	val[]: "Bu bölümün son senaryosunda karmaşık bir yapılandırmayla beraber test pistinde sürüşe çıkacağız."

	key[]: "aca_msg_book1_2_06_cutscene02"
	val[]: "İlk engel, bazı bariyerlerin arasından slalom yapmaktır. Etraflarından geçin ve aynalarınızı kullanmayı unutmayın."

	key[]: "aca_msg_book1_2_06_cutscene04"
	val[]: "Sırada bir firkete viraj var. Virajı geniş aldığınız müddetçe sorun yaşamazsınız."

	key[]: "aca_msg_book1_2_06_cutscene05"
	val[]: "Önünüzdeki yol önemli ölçüde daralmaktadır. Dikkatli ilerleyin ve yan aynayı kullanın."

	key[]: "aca_msg_book1_2_06_cutscene06"
	val[]: "Sırada bir dizi kolay 90 derecelik dönüş var."

	key[]: "aca_msg_book1_2_06_cutscene08"
	val[]: "Bir sonraki bölüm tersten tamamlanmalıdır. Bunu aklınızda tutarak önünüzdeki bariyerlere yaklaşın."

	key[]: "aca_msg_book1_2_06_cutscene09"
	val[]: "Yol işaretlerini takip ederek geri dönün ve virajları alın."

	key[]: "aca_msg_book1_2_06_cutscene10"
	val[]: "Bariyerlere doğru geri gidin, sonra durun ve sağdan ilerlemeye devam edin."

	key[]: "aca_msg_book1_2_06_cutscene11"
	val[]: "Koniler arasındaki bu geçit çok dardır. Yavaş sürün ve yönünüzü bulmak için aynalarınızı kullanın."

	key[]: "aca_msg_book1_2_06_cutscene13"
	val[]: "İleride, birbirini takip eden 90 derecelik sola ve sağa dönüşler yer alıyor."

	key[]: "aca_msg_book1_2_06_cutscene15"
	val[]: "Hemzemin geçitte trenlerle karşılaşabilirsiniz. Karşılaşırsanız durun ve bekleyin. Daha sonra sağdan servis yoluna çıkabilirsiniz."

	key[]: "aca_msg_book1_2_06_cutscene16"
	val[]: "Soldan taşıt yoluna çıkın. Çıktıktan sonra biraz hızlanabilirsiniz."

	key[]: "aca_msg_book1_2_06_cutscene18"
	val[]: "Kasabada birkaç sol dönüş daha yaparsanız hedefinize ulaşacaksınız!"

	key[]: "aca_msg_book1_2_06_cutscene19"
	val[]: "Önünüzdeki bariyerlere yaklaşın ve sağdaki park yerine park etmeye hazır olun."

	key[]: "aca_msg_book1_2_06_cutscene20"
	val[]: "Park yerine geri geri girin, akabinde motoru kapatın ve çekiciyi emniyete alın."

#### 2_06 Driving Instructions



	key[]: "aca_msg_book1_2_06_forward"
	val[]: "Önünüzde bariyerlerden meydana gelen bir slalom var.<br><br><font face=/font/big_bold.font>Slalom yapın.</font>"

	key[]: "aca_msg_book1_2_06_forward2"
	val[]: "<font face=/font/big_bold.font>Firkete viraj boyunca devam edin. </font>"

	key[]: "aca_msg_book1_2_06_check1"
	val[]: "Önünüzdeki yol önemli ölçüde daralmaktadır. Yan aynanızı kullanabilirsiniz.<br><br><font face=/font/big_bold.font>Dikkatli ilerleyin.</font>"

	key[]: "aca_msg_book1_2_06_check2"
	val[]: "Virajdan sonra 90 derecelik bir dönüş var.<br><br><font face=/font/big_bold.font>Hızınızı ayarlayın.</font>"

	key[]: "aca_msg_book1_2_06_check3"
	val[]: "Önünüzde birkaç kolay dönüş daha var, gerektiğinde hızınızı ayarlamaya devam edin.<br><br><font face=/font/big_bold.font>Sürmeye devam edin.</font>"

	key[]: "aca_msg_book1_2_06_check4"
	val[]: "Sıradaki bölüm tersten tamamlanmalıdır. Daha sonra sağa geri gidebilmek için önünüzdeki bariyerlerde durun.<br><br><font face=/font/big_bold.font>Bariyerlerde durun.</font>"

	key[]: "aca_msg_book1_2_06_check5"
	val[]: "Sağ arkanızdaki alana geri geri girin.<br><br><font face=/font/big_bold.font>Geri gitmeye başlayın.</font>"

	key[]: "aca_msg_book1_2_06_reverse"
	val[]: "Yolu takip edin.<br><br><font face=/font/big_bold.font>Geri gitmeye devam edin.</font>"

	key[]: "aca_msg_book1_2_06_check6"
	val[]: "Sol arkanızda bazı bariyerler var. <br><br><font face=/font/big_bold.font>Bariyerlere doğru dönün ve durmaya hazır olun.</font>"

	key[]: "aca_msg_book1_2_06_check7"
	val[]: "Durun ve ileri vitese geçin, sonra sağdan devam edin. <br><br><font face=/font/big_bold.font>İleri doğru sürün.</font>"

	key[]: "aca_msg_book1_2_06_check8"
	val[]: "Önünüzde bazı konilerin arasından geçen dar ve kıvrımlı bir yol var. Dikkatli sürün ve gerekirse aynalarınızı kullanın.<br><br><font face=/font/big_bold.font>Konilerin arasından geçin. </font>"

	key[]: "aca_msg_book1_2_06_check9"
	val[]: "Sırada farklı 90 derecelik dönüşlerin bir kombinasyonu var. Her dönüşe geniş bir mesafe bırakarak yaklaştığınızdan emin olun.<br><br><font face=/font/big_bold.font>Sürmeye devam edin.</font>"

	key[]: "aca_msg_book1_2_06_check10"
	val[]: "Yaklaşırken hemzemin geçidi dikkatle inceleyin. Sinyal, yaklaşan bir treni belirtmek için yanabilir.<br><br><font face=/font/big_bold.font>Dikkatli ilerleyin.</font>"

	key[]: "aca_msg_book1_2_06_check11"
	val[]: "Servis yoluna çıkan dönüş kısmen bir engel tarafından kapatılmış. Bu sebeple yaklaşırken kendinize daha fazla yer açmak için sol tarafta kalın.<br><br><font face=/font/big_bold.font>Dönüşü gerçekleştirin.</font>"

	key[]: "aca_msg_book1_2_06_check12"
	val[]: "Dur levhasına uymayı veya uymamayı tercih edebilirsiniz. Alan bizim kullanmamız için kapatıldı.<br><br><font face=/font/big_bold.font>Sola dönün.</font>"

	key[]: "aca_msg_book1_2_06_check13"
	val[]: "Burada biraz hızlanabilirsiniz, ancak bir sonraki kavşakta dönmeniz gerekecek.<br><br><font face=/font/big_bold.font>Yol boyunca devam edin.</font>"

	key[]: "aca_msg_book1_2_06_check14"
	val[]: "Sola dönerek kasabaya girin, akabinde son alana çıkmak için iki kez daha sola dönün.<br><br><font face=/font/big_bold.font>Kasabanın içinden geçin.</font>"

	key[]: "aca_msg_book1_2_06_check15"
	val[]: "Alanın uzak tarafında bazı bariyerler var. Onlara doğru sürün. <br><br><font face=/font/big_bold.font>Bariyerlerin yakınında durun.</font>"

	key[]: "aca_msg_book1_2_06_check16"
	val[]: "Sağ arkanızda bir park yeri var.<br><br><font face=/font/big_bold.font>Park yerine geri geri girin. </font>"
#!{
	key[]: "aca_msg_book1_2_06_check17"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_06_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_2_06_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

