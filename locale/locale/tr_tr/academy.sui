#### 3_03 msg - intro text

	key[]: "aca_msg_book1_3_03_cutscene01"
	val[]: "Önümüzde çeşitli karmaşık virajlar ve engeller var.<br>Şimdiye kadar öğrendiklerinizi göz önünde bulundurduğunuzda çok da zor olmayacağını göreceksiniz."

	key[]: "aca_msg_book1_3_03_cutscene02"
	val[]: "İlk viraj, kanca dönüşüdür ve kolaydır. Genişten aldığınız müddetçe sorun olmayacaktır."

	key[]: "aca_msg_book1_3_03_cutscene03"
	val[]: "Dönel kavşağa doğru devam edin."

	key[]: "aca_msg_book1_3_03_cutscene04"
	val[]: "Çekiciyi mümkün mertebe genişten sürerek dorseyi dönel kavşağın içinden uzak tutun."

	key[]: "aca_msg_book1_3_03_cutscene05"
	val[]: "Sola doğru 90 derecelik dönüş çok dar değil, ancak herhangi bir koniye çarpmamaya dikkat edin."

	key[]: "aca_msg_book1_3_03_cutscene06"
	val[]: "Bu dönüş çok daha dar. Tamamlamak için jug handle manevrasını kullanın."

	key[]: "aca_msg_book1_3_03_cutscene07"
	val[]: "Bu dönüşte kanca manevrasını kullanabilirsiniz, ancak kaçınmanız gereken bazı fazladan engeller var."

	key[]: "aca_msg_book1_3_03_cutscene09"
	val[]: "Son dönüş yine çok dar olacak ve tamamlanması için hem jug handle hem kanca manevralarının bir kombinasyonu gerekecek."

	key[]: "aca_msg_book1_3_03_cutscene10"
	val[]: "Belirtilen yere park edin, çekiciyi emniyete alın ve motoru kapatın."


#### 3_03 Driving Instructions



	key[]: "aca_msg_book1_3_03_forward"
	val[]: "<font face=/font/big_bold.font>İlk dönüşe doğru devam edin. </font>"

	key[]: "aca_msg_book1_3_03_check1"
	val[]: "İlk viraj kanca dönüşüdür ve kolaydır.<br><br><font face=/font/big_bold.font><color value=@@clr_txt@@>Dönüş boyunca ilerleyin.</font>"

	key[]: "aca_msg_book1_3_03_check2"
	val[]: "Dönel kavşağa doğru devam edin. Kavşağı genişten geçmeyi unutmayın.<br><br><font face=/font/big_bold.font>Dönel kavşağa girin ve geçin.</font>"

	key[]: "aca_msg_book1_3_03_check3"
	val[]: "Bu 90 derecelik dönüş biraz daha dardır, konilere çarpmamaya dikkat edin.<br><br><font face=/font/big_bold.font>Dönüşü yapın.</font>"

	key[]: "aca_msg_book1_3_03_check4"
	val[]: "Bu dönüşe en iyi şekilde bir jug handle prosedürüyle yaklaşabilirsiniz. Kavşağa girmeden önce genişçe dönün.<br><br><font face=/font/big_bold.font>Bir jug handle dönüşü yapın.</font>"

	key[]: "aca_msg_book1_3_03_check5"
	val[]: "Bu dönüşte birçok farklı engel var, ancak kanca manevrasıyla halledebilirsiniz.<br><br><font face=/font/big_bold.font>Dikkatli ilerleyin.</font>"

	key[]: "aca_msg_book1_3_03_check6"
	val[]: "Bu dönüş şu ana kadarki en keskin dönüştür, uygun gördüğünüz şekilde ilerleyin.<br><br><font face=/font/big_bold.font>Otoparka dönün.</font>"
