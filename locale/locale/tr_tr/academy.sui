#### common
	key[]: "aca_scenario_book2_intro_title"
	val[]: "Çekici Şoförlüğünde Ustalık"


#### intro text

	key[]: "aca_scenario_book2_book2_intro_cutscene1"
	val[]: "@@driving_academy@@ne tekrar hoş geldiniz!"

	key[]: "aca_scenario_book2_book2_intro_cutscene2"
	val[]: "Takip eden senaryolar, profesyonel çekici şoförlüğü yolculuğunuzdaki bir sonraki adımı temsil etmektedir."

	key[]: "aca_scenario_book2_book2_intro_cutscene3"
	val[]: "Bu sefer her görevde size rehberlik etmeyeceğiz. Dolayısıyla becerilerinizi ve tecrübenizi kullanmak sizin kararınızdır."

	key[]: "aca_scenario_book2_book2_intro_cutscene4"
	val[]: "Bazı tanıdık manevralarla karşılaşabilirsiniz, ancak bu kez gerçek dünya senaryolarına daha çok benzeyen yeni ortamlar vardır."

	key[]: "aca_scenario_book2_book2_intro_cutscene5"
	val[]: "@@driving_academy@@ için yeni olan şey \"Geçme\" ve \"İkramiye\" şartlarının eklenmesidir."

	key[]: "aca_scenario_book2_book2_intro_cutscene6"
	val[]: "Daha önce olduğu gibi yine her senaryoyu hiçbir şeye çarpmadan, başarılı bir şekilde park ederek ve çekiciyi emniyete alarak tamamlamalısınız..."

	key[]: "aca_scenario_book2_book2_intro_cutscene7"
	val[]: "... ama şimdi bunu da belirlenen zaman sınırı içinde ve ileri ve geri sürüş arasındaki istikamet değiştirme sayısında bir sınırlamayla yapmalısınız."

	key[]: "aca_scenario_book2_book2_intro_cutscene8"
	val[]: "Her senaryoyu daha da zorlu şartlarla tamamlayarak ikramiye şartlarını karşılayabilirsiniz..."

	key[]: "aca_scenario_book2_book2_intro_cutscene9"
	val[]: "... mesela daha sıkı zaman sınırlamaları, daha az istikamet değişikliği ve yalnızca iç kameranın kullanılması gibi."

	key[]: "aca_scenario_book2_book2_intro_cutscene10"
	val[]: "Bütün senaryoları tamamladığınızda ehil bir şoför olacak ve bir sonraki mücadeleye hazır hâle geleceksiniz.<br><br>Kendinizi daha da zorlamak için her senaryodaki bütün ikramiye şartlarını tamamlayın. İşte o zaman çekici şoförlerinin piri olacaksınız!"


#@}



#+ Book 2 zero
#@{
#### zero common
	key[]: "aca_scenario_book2_zero_title"
	val[]: "Eğitim"

	key[]: "aca_scenario_book2_zero_desc"
	val[]: "Bu eğitim senaryosunda, Çekici Şoförlüğünde Ustalık'ta bulunan yeni özelliklere aşina olmanıza yardımcı olacağız."


#### zero info msg1

	key[]: "aca_msg_book2_scenario_zero1_title"
	val[]: "Çekici Şoförlüğünde Ustalık"

	key[]: "aca_msg_book2_scenario_zero1"
	val[]: "Her senaryonun başında bir <color value=@@clr_sel@@>\"Senaryo Bilgilendirmesi\"<color value=@@clr_txt@@> göreceksiniz. Bu, size senaryonun yeni geçme ve ikramiye şartları hakkında bilgi verecektir. <br><br>Senaryoyu başarıyla tamamlamak için geçme şartlarının karşılanması gerekirken ikramiye şartları, tecrübeli ve becerikli oyuncular için isteğe bağlı bir ilave zorluktur. <br><br><font face=/font/big_bold.font>Devam etmek için kontağı açın.</font>"

#### zero info msg1b

	key[]: "aca_msg_book2_scenario_zero1b"
	val[]: "İkramiye koşullarından biri, <color value=@@clr_sel@@>İç Kamerayı<color value=@@clr_txt@@> kullanırken senaryoyu tamamlamanızdır. Etrafınızı kontrol etmek için dış kameraları yalnızca çekici dururken kullanabilirsiniz.<br><br>Şimdi yönünüzü bulmak için etrafınıza bakabilir, akabinde iç kameraya geri dönebilirsiniz.<br><br><font face=/font/big_bold.font>Etrafınızı kontrol etmek için takip kamerasına geçin</font>"


#### zero info msg1c


	key[]: "aca_msg_book2_scenario_zero1c"
	val[]: "Yönünüzü bulun, akabinde iç kameraya geri dönün.<br><br><font face=/font/big_bold.font>Çekicinin etrafına bakın</font>"


