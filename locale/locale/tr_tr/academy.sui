#### 3_02 msg - intro text

	key[]: "aca_msg_book1_3_02_cutscene01"
	val[]: "Bu senaryoda çekiciyi kısa bir sürüşe çıkaracağız. Önümüzdeki yokuştan inerken bir dorseyle beraber frenlemeyi öğreneceksiniz. Çekiciyi hazırlayın ve yola çıkın."

	key[]: "aca_msg_book1_3_02_cutscene06"
	val[]: "Asgari 60 km/sa. (37 mil/sa.) hıza ulaşın. Önünüzdeki frenleme bölgesine hazır olun."

	key[]: "aca_msg_book1_3_02_cutscene08"
	val[]: "Durmak için frenlemeye başlayın. Çok geç kalmadığınızdan emin olun. Aksi takdirde önünüzdeki bariyerlere çarpabilirsiniz!"

	key[]: "aca_msg_book1_3_02_cutscene10"
	val[]: "Belirtilen yere park edin, akabinde çekiciyi emniyete alın ve motoru kapatın."


#### 3_02 Driving Instructions

	key[]: "aca_msg_book1_3_02_start"
	val[]: "Bu sürüş esnasında hafif bir yokuştan inerken servis frenlerini kullanmayı öğreneceksiniz. Bu alıştırmanın maksadı, arkanızdaki ağırlığın farkına varmak ve bunun, aracın fren mesafesini nasıl etkilediğini görmektir.<br><br><font face=/font/big_bold.font>Yola çıkmaya hazır olun. </font>"

	key[]: "aca_msg_book1_3_02_forward"
	val[]: "Hemen yola koyulun ve önünüzdeki dönüşten <font face=/font/big_bold.font>sonra</font> 60 km/sa. (37 mil/sa.) sürate ulaşmanız gerektiğini unutmayın.<br><br><font face=/font/big_bold.font>Önünüzdeki dönüşe doğru sürün.</font>"

	key[]: "aca_msg_book1_3_02_check1"
	val[]: "Sağa dönün ve 60 km/sa. (37 mil/sa.) sürate ulaşın.<br><br><font face=/font/big_bold.font>Sürmeye devam edin.</font>"

	key[]: "aca_msg_book1_3_02_check2"
	val[]: "<font face=/font/big_bold.font>Asgari 60 km/sa. (37 mil/sa.) hıza ulaşın. </font>"

	key[]: "aca_msg_book1_3_02_check3"
	val[]: "Gereken hıza ulaştınız.<br><br><font face=/font/big_bold.font>Önünüzdeki bariyerlerde durun. </font>"
#!{
	key[]: "aca_msg_book1_3_02_stop"
