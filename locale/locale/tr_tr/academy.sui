#+ Book 3 Scenario urf
#@{

#### urf common
	key[]: "aca_scenario_book3_urf_title"
	val[]: "Geri Manevra Alanı"

	key[]: "aca_scenario_book3_urf_desc"
	val[]: "Bu senaryoda, çift dorseyle geri manevra yapma alıştırması için boş bir otoparka yerleştirileceksiniz."

#### urf goal

	key[]: "aca_goal_book3_urf_start"
	val[]: "Başlangıç"

	key[]: "aca_goal_book3_urf_move"
	val[]: "Deneme"

	key[]: "aca_goal_book3_urf_stop"
	val[]: "Halletmek"

	key[]: "aca_goal_book3_urf_end"
	val[]: "Senaryoyu Sonlandırmak"

	#### urf msg - intro text

	key[]: "aca_msg_book3_urf_cutscene1"
	val[]: "Çift dorse ile geri manevra yapmak, tek dorse ile manevra yapmaya göre çok daha fazla dikkat gerektirir. Arka dorsenin nereye gideceğini önceden planlamanız, aynı zamanda ön dorseyi ve çekiciyi de kontrol altında tutmanız gerekir. <br><br>Bunu, arka dorseyi ön dorse ile yönlendiriyormuş gibi düşünün. Dolayısıyla, ön dorseyi hangi yöne çevirirseniz, arka dorsenin yönü de ona göre değişecektir."

	key[]: "aca_msg_book3_urf_cutscene2"
	val[]: "Bu durumda, arka dorseyi şoför tarafına çevirmek istiyoruz. <br><br>Bunu yapmak için ön dorseyi yolcu tarafına çevirdik."

	key[]: "aca_msg_book3_urf_cutscene3"
	val[]: "Çoğu insan ilk hatasını burada yapar. Arka dorse dönmeye başladığı anda, çekicinizi ön dorseyle hizalamalısınız..."

	key[]: "aca_msg_book3_urf_cutscene4"
	val[]: "...yoksa bu şekilde katlanma (jack-knife) meydana gelir."

	key[]: "aca_msg_book3_urf_cutscene5"
	val[]: "İki araç arasındaki açı yaklaşık 90 dereceye ulaştığında katlanma (jack-knifing) meydana gelir. Bu gerçekleştiğinde, kurtarma şansı yoktur. İleri doğru hareket edip tekrar denemeniz gerekir. <br><br>Tek bir dorseyi geri geri sürerken olduğu gibi, maksat her zaman dorselerin bütün tekerleklerinin hareket hâlinde olmasını sağlamaktır. Bir tekerlek durursa ve dorse yerinde dönmeye başlarsa hapı yutarsınız."

	key[]: "aca_msg_book3_urf_cutscene6"
	val[]: "En son doğru yaptığınız yere, yani aynı hataya tekrar düşmeden geriye doğru gitmeye devam edebileceğiniz bir konuma doğru ilerleyebilirsiniz; ya da sadece düz hâle gelene kadar ilerleyebilirsiniz."

	key[]: "aca_msg_book3_urf_cutscene7"
	val[]: "Aynı şekilde, arka dorse dönmeye başladıktan sonra, çekiciyi öndeki dorsenin önüne getirin ve arka dorsenin bir anlığına kendi kendine dönmesine müsaade edin."

	key[]: "aca_msg_book3_urf_cutscene8"
	val[]: "Arka dorse artık düzgün bir şekilde döndüğüne göre, ön dorsenin de onu takip etmesinin zamanı geldi. Dönüşü kontrol etmek ve daha keskin veya daha geniş hale getirmek için ön ve arka dorse arasındaki açıyı ayarlayabilirsiniz."

	key[]: "aca_msg_book3_urf_cutscene9"
	val[]: "Manevranın son safhası her şeyi düz hâle getirmektir. Ön dorseyi arka dorsenin önüne getirin."

	key[]: "aca_msg_book3_urf_cutscene10"
	val[]: "Ön dorseyi hareket ettirmenin ne kadar süreceğini ve çekiciyi de hizalamanız gerekeceğini aklınızda bulundurmanızda fayda var."

	key[]: "aca_msg_book3_urf_cutscene11"
	val[]: "Burada dilediğiniz kadar zaman geçirebilir, dorseleri geri geri nasıl hareket ettireceğinize dair kabaca bir fikir edinene kadar farklı manevralar deneyebilirsiniz."

#### urf Driving Instructions

	key[]: "aca_msg_book3_urf_start"
	val[]: "Yola çıkmaya hazır olun."

	key[]: "aca_msg_book3_urf_move"
	val[]: "Bu otoparkı, dorseleri geri geri sürme konusunda fikir edinmek için kullanın. <br><br>@@aca_goal_tip@@ Genel olarak dorseleri geri geri sürme konusunda yeni misiniz? Çekici Şoförlüğünün Temelleri bölümünü oynamayı düşünebilirsiniz."

	key[]: "aca_msg_book3_urf_stop"
	val[]: "İstediğiniz kadar alıştırma yapın. <br><br>İçinize sindiğinde, durup çekiciyi emniyete alarak senaryoyu sonlandırabilirsiniz."

	key[]: "aca_msg_book3_urf_end"
	val[]: "Senaryoyu sonlandırmak için motoru kapatın."
#@}


