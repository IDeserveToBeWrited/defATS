	key[]: "aca_goal_book1_2_08_forward"
	val[]: "Piste Girmek"

	key[]: "aca_goal_book1_2_08_check1"
	val[]: "Geniş Firkete Dönüş"

	key[]: "aca_goal_book1_2_08_check2"
	val[]: "Slalomda Sürüş"

	key[]: "aca_goal_book1_2_08_check3"
	val[]: "Dar Firkete Dönüş"

	key[]: "aca_goal_book1_2_08_check4"
	val[]: "Dar Viraj"

	key[]: "aca_goal_book1_2_08_check6"
	val[]: "Teknik Kısım"

	key[]: "aca_goal_book1_2_08_check7"
	val[]: "Açık Kısım"



#### 2_08 msg - intro text

	key[]: "aca_msg_book1_2_08_cutscene1"
	val[]: "Bu senaryoda, yeni edindiğiniz becerilerinizle çekiciyi nasıl kullanabileceğinizi görmek için kısa bir sürüşe çıkacağız.<br>Pistte çeşitli tipte ve kombinasyonda dönüşler vardır. Bu bir yarış değil ve zaman da önemli değildir. Sabırlı olun ve karşılaştığınız dönüşlere ve engellere göre süratinizi ayarlayın."

	key[]: "aca_msg_book1_2_08_cutscene2"
	val[]: "Geniş bir firkete dönüş yaparak piste girin."

	key[]: "aca_msg_book1_2_08_cutscene3"
	val[]: "Daha sonra sizi düzensiz bir slalom alanına yönlendirecek bir dizi engelle karşılaşacaksınız."

	key[]: "aca_msg_book1_2_08_cutscene4"
	val[]: "Birkaç kolay 90 derecelik dönüşü tamamladıktan sonra, dar keskin bir dönüşle karşılaşacaksınız. Hem dönüşü tamamlamak hem bir sonraki kısma sorunsuz bir şekilde girmek için doğru şekilde hazırlanmanız mühimdir."

	key[]: "aca_msg_book1_2_08_cutscene5"
	val[]: "Kaputun üzerinden görüş alanı sınırlı olduğundan uzun virajdan geçerken konilere dikkat edin."

	key[]: "aca_msg_book1_2_08_cutscene6"
	val[]: "Bir diğer bariyer seti sizi geniş bir slalom alanına yönlendirecektir."

	key[]: "aca_msg_book1_2_08_cutscene7"
	val[]: "Pist biraz açılıyor ama acele etmeyin. Birkaç kolay dönüşten sonra işiniz bitecek."

	key[]: "aca_msg_book1_2_08_cutscene8"
	val[]: "Belirtilen yerde durun ve çekiciyi emniyete alın."


#### 2_08 Driving Instructions

	key[]: "aca_msg_book1_2_08_start"
	val[]: "Bu senaryoyu başarıyla tamamlamak için kaza yapmamalı, pistten çıkmamalı veya trafik konilerine çarpmamalısınız.<br><br><font face=/font/big_bold.font>Yola çıkmaya hazır olun. </font>"

	key[]: "aca_msg_book1_2_08_forward"
	val[]:"<font face=/font/big_bold.font>Piste girmek için geniş firkete dönüşe doğru devam edin.</font>"

	key[]: "aca_msg_book1_2_08_check1"
	val[]: "<font face=/font/big_bold.font>Firkete dönüşü tamamlayın. </font>"

	key[]: "aca_msg_book1_2_08_check2"
	val[]: "Kabaca slalom şeklinde koyulmuş bazı bariyerlere yaklaşıyorsunuz.<br><br><font face=/font/big_bold.font>Hızınızı ayarlayın ve devam edin.</font>"

	key[]: "aca_msg_book1_2_08_check3"
	val[]: "Sırada iki kolay 90 derecelik dönüş ve akabinde keskin bir dönüş var. Yavaşça ilerleyin.<br><br><font face=/font/big_bold.font>Dar keskin dönüşe doğru devam edin.</font>"

	key[]: "aca_msg_book1_2_08_check4"
	val[]: "Firkete virajdan çıktığınızda dar bir yolla karşılaşacaksınız. İçerideki bariyerden uzak durmalısınız ancak önünüzdeki konilere çarpmamaya dikkat etmelisiniz.<br><br><font face=/font/big_bold.font>Viraj boyunca devam edin.</font>"

	key[]: "aca_msg_book1_2_08_check6"
	val[]: "Önünüzdeki yolda bazı dar ve zor dönüşler var. Hızınızı ayarlayın ve dikkatlice geçin.<br><br><font face=/font/big_bold.font>Sürmeye devam edin.</font>"

	key[]: "aca_msg_book1_2_08_check7"
	val[]: "Bir sonraki kısım daha açık ve kolay dönüşler içeriyor. Acele etmeyin.<br><br><font face=/font/big_bold.font>Sürmeye devam edin.</font>"
#!{
	key[]: "aca_msg_book1_2_08_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_08_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

#@}

