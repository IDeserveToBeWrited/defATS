	key[]: "aca_msg_book3_sup_check1"
	val[]: "Sürmeye devam edin."

	key[]: "aca_msg_book3_sup_stop"
	val[]: "Belirtilen yerde durun."

	key[]: "aca_msg_book3_sup_end"
	val[]: "Çekiciyi emniyete alın ve motoru kapatın."
