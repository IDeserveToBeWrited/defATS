#### 3_12 msg - intro text

	key[]: "aca_msg_book1_3_12_cutscene01"
	val[]: "Bu senaryoda, dar bir alanda nasıl dönüş yapılacağını ele alacağız.<br>Çekiciyle manevra yapmak için her zaman çok fazla alanınız olmayacak ve ideal olmayan durumlara uyum sağlamanız gerekecektir."

	key[]: "aca_msg_book1_3_12_cutscene02"
	val[]: "Sokaktan açık alana doğru sürün."

	key[]: "aca_msg_book1_3_12_cutscene03"
	val[]: "Solda geri geri girmeniz gereken başka bir sokak daha var. Bunu göz önünde bulundurarak istediğiniz şekilde hazırlanın.<br>Geri geri gitmeye başlamadan önce dorsenin sokağa doğru bakması işinize yarayabilir."

	key[]: "aca_msg_book1_3_12_cutscene04"
	val[]: "Sokağa doğru geri geri gidin. Çekicinin ve dorsenin her tarafını kontrol etmeye dikkat edin."

	key[]: "aca_msg_book1_3_12_cutscene05"
	val[]: "Sokakta engeller var. Bu sebeple şoför tarafında kalmaya çalışın."

	key[]: "aca_msg_book1_3_12_cutscene06"
	val[]: "Geri geri gitmeyi tamamladıktan sonra ileri gidip geldiğiniz yönden geri dönebilirsiniz."

	key[]: "aca_msg_book1_3_12_cutscene07"
	val[]: "Çıkarken yolcu tarafındaki aynadan dorsenizi görmekte zorluk çekebilirsiniz. Bu sebeple elinizdeki bütün alandan istifade edin."

	key[]: "aca_msg_book1_3_12_cutscene08"
	val[]: "Çıkışa doğru sürmeye devam edin."

	key[]: "aca_msg_book1_3_12_cutscene09"
	val[]: "Belirtilen yere park edin ve çekiciyi emniyete alın."
#!{
	key[]: "aca_msg_book1_3_12_cutscene10"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_12_cutscene11"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_12_cutscene12"
