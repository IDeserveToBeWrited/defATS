#+ Book 1 Scenario 3_09
#@{

#### 3_09 common
	key[]: "aca_scenario_book1_3_09_title"
	val[]: "Çapraz Park Etmek"

	key[]: "aca_scenario_book1_3_09_desc"
	val[]: "Bu senaryoda kalabalık bir otoparkta çapraz bir park yerine park edeceksiniz. <br><br>Manevra alanınız çok fazla olmadığından sürerken hatasız ve şuurlu olmanız gerekecektir."

#### 3_09 goal

	key[]: "aca_goal_book1_3_09_check1"
	val[]: "Park Yerine Yaklaşmak"
#!{
	key[]: "aca_goal_book1_3_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_09_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_09_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
 #!}
#### 3_09 msg - intro text

	key[]: "aca_msg_book1_3_09_cutscene1"
	val[]: "Bu tür çapraz park yerleri çok yaygındır. Amerika'nın her yerindeki dinlenme tesislerinde veya çekici parklarında bunlara rastlayabilirsiniz. <br>Bir kere daha önümüzdeki park yerine \"burnumuzu sokmamız\" gerekecek."

	key[]: "aca_msg_book1_3_09_cutscene2"
	val[]: "Sıranın sonundaki belirtilen park yerine doğru sürün."

	key[]: "aca_msg_book1_3_09_cutscene3"
	val[]: "Şeridin ortasında veya hafifçe solunda kalın. Dorseyle manevra yapmak için kendinize alan bırakmanız lazım."

	key[]: "aca_msg_book1_3_09_cutscene4"
	val[]: "Park yerinin yanından epeyce geçin ve sonra sert ve hızlı bir şekilde o yere doğru dönün. Dorsenizin park yerine emniyetli bir şekilde girdiğini görmek için sağ taraftaki aynanıza bakmanız gerekecektir."

	key[]: "aca_msg_book1_3_09_cutscene5"
	val[]: "Belirtilen yerde durun, çekiciyi emniyete alın ve motoru kapatın."


#### 3_09 Driving Instructions

	key[]: "aca_msg_book1_3_09_start"
	val[]: "@@aca_msg_book1_3_09_start_img@@<br>Çapraz park ederken konumunuzu doğru bir şekilde değerlendirmek önemlidir. Dönüşün ortasına geldiğinizde geri gitmek ve emniyetli bir şekilde yeniden konum almak zordur. Bu sebeple ilk denemede yeterli alanınız olduğundan emin olmak idealdir.<br><br><font face=/font/big_bold.font>Yola çıkmaya hazır olun.</font>"

	key[]: "aca_msg_book1_3_09_forward"
	val[]: "<font face=/font/big_bold.font>Park yerine doğru sürmeye başlayın. </font>"

	key[]: "aca_msg_book1_3_09_check1"
	val[]: "Dorsenizin iç tarafta çekicinin etrafında dönebilecek kadar alana sahip olması için park yerini geçin.<br><br><font face=/font/big_bold.font>Park yerine dönün.</font>"
#!{
	key[]: "aca_msg_book1_3_09_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}

#@}

#+ Book 1 Scenario 3_10
#@{

#### 3_10 common
	key[]: "aca_scenario_book1_3_10_title"
	val[]: "Kör Noktadan Geri Geri Gitmek"

	key[]: "aca_scenario_book1_3_10_desc"
	val[]: "Bu senaryoda, çekiciyi park yerine kör noktadan geri geri sokmaya bakacağız. Pencereden dışarı bakmadan, gitmeniz gereken yere ulaşmak için yalnızca aynalarınıza güvenmek zorunda kalacaksınız."

#### 3_10 goal
#!{
	key[]: "aca_goal_book1_3_10_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_10_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_10_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_10_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

 #!}
#### 3_10 msg - intro text

	key[]: "aca_msg_book1_3_10_cutscene1"
	val[]: "Bu senaryoda \"kör nokta\" geri manevrasını öğreneceksiniz. Görüşünüz ciddi şekilde sınırlı olduğundan bir alternatif olduğu müddetçe kör noktadan geçmekten genellikle kaçınılmalıdır. Acele etmeyin ve tedbiri elden bırakmayın."

	key[]: "aca_msg_book1_3_10_cutscene2"
	val[]: "Geri gitmeye başladığınızda kendinize yer açmak için park yerinden iyice uzaklaşın."

	key[]: "aca_msg_book1_3_10_cutscene3"
	val[]: "Durun, çevrenizi kontrol edin ve geri gitmeye başlayın."

	key[]: "aca_msg_book1_3_10_cutscene4"
	val[]: "Çekiciyi park yerinden uzağa döndürün. Bu, dorsenin önünü itecek ve ardından dorsenin arkasını girmek istediğiniz park yerine doğru yönlendirecektir. Aşırıya kaçmamaya dikkat edin, aksi takdirde dorsenin katlanma riskiyle karşı karşıya kalabilirsiniz."

	key[]: "aca_msg_book1_3_10_cutscene5"
	val[]: "Dorse park yerine girdiğinde çekiciyi toplamaya başlayın."

	key[]: "aca_msg_book1_3_10_cutscene6"
	val[]: "Belirtilen yerde durun ve çekiciyi emniyete alın."

#### 3_10 Driving Instructions

	key[]: "aca_msg_book1_3_10_start"
	val[]: "Kör noktadan geri geri geçmek, gördüğünüz yerden geri geri geçmekle aynı prosedürleri gerektirir, ancak görüş eksikliği size mâni olur. Çekiciyi park etmek için aynalarınızı kullanın ve iyice düşünün.<br><br><font face=/font/big_bold.font>Yola çıkmaya hazır olun.</font>"

	key[]: "aca_msg_book1_3_10_forward"
	val[]: "Önünüzde sağ tarafta bir park yeri var. Geri giderken manevra yapacak alanınız olması için epeyce geçmeniz gerekecek.<br><br><font face=/font/big_bold.font>İleriye doğru sürün.</font>"
#!{
	key[]: "aca_msg_book1_3_10_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
	key[]: "aca_msg_book1_3_10_check2"
	val[]: "Unutmayın, çekiciyi park yerinden uzaklaştırmak, dorseyi oraya doğru döndürecektir. Park yerine girmenize yardımcı olması için aynalarınızı elinizden geldiği kadar kullanın.<br><br><font face=/font/big_bold.font>Geri gitmeye başlayın.</font>"


#@}

#+ Book 1 Scenario 3_11
