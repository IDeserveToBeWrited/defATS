#### 3_11 msg - intro text

	key[]: "aca_msg_book1_3_11_cutscene1"
	val[]: "Amerika'da dönel kavşaklar çok yaygındır. Bu sebeple bu kavşaklarda nasıl hareket edeceğinizi bilmeniz mühimdir."

	key[]: "aca_msg_book1_3_11_cutscene3"
	val[]: "Dönel kavşağa yaklaşırken şeridinizin dışında kalın. Bu, dorsenizin ilk dönüşü geçmesine yardımcı olacaktır."

	key[]: "aca_msg_book1_3_11_cutscene4"
	val[]: "Dönel kavşağa girdiğinizde kavşağın ortasına doğru sürün. İçeri girdiğinizde dışa doğru gitmeniz gerekecek. Bu, dorsenizi dönel kavşağın ortasından uzak tutmak içindir."

	key[]: "aca_msg_book1_3_11_cutscene5"
	val[]: "Dorsenin içteki bariyerlere çok yaklaşmadığından emin olmak için aynanızı takip edin."

	key[]: "aca_msg_book1_3_11_cutscene6"
	val[]: "Dönel kavşaktan çıkmak oldukça kolaydır çünkü dorseniz zaten çıkışın iç tarafından uzaktadır. Çıkışta genişçe döndüğünüzde dorse de ideal açıyla sizi takip edecektir."

	key[]: "aca_msg_book1_3_11_cutscene7"
	val[]: "Belirtilen yere park edin ve çekiciyi emniyete alın."



#### 3_11 Driving Instructions
#!{
	key[]: "aca_msg_book1_3_11_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

	key[]: "aca_msg_book1_3_11_forward"
	val[]: "Önünüzde bir dönel kavşak bulunmaktadır. <br><br><font face=/font/big_bold.font>Dönel kavşağa yavaşça yaklaşın.</font>"

	key[]: "aca_msg_book1_3_11_check1"
	val[]: "Dönel kavşağa girerken geniş bir dönüş yaptığınızda dorseniz sorunsuz bir şekilde sizi takip eder. <br><br><font face=/font/big_bold.font>Dönel kavşağa girin.</font>"

	key[]: "aca_msg_book1_3_11_check2"
	val[]: "Dönel kavşağın dışına doğru sürün. Dorsenizi ortadaki bariyerlerden uzak tutmak için çekiciyi dönel kavşağın merkezinden mümkün mertebe uzakta tutmanız gerekecektir. <br><br><font face=/font/big_bold.font>Dönel kavşak boyunca devam edin.</font>"

	key[]: "aca_msg_book1_3_11_check3"
	val[]: "Dıştaki konilere yakın durun. <br><br><font face=/font/big_bold.font>Sürmeye devam edin.</font>"

	key[]: "aca_msg_book1_3_11_check5"
	val[]: "<font face=/font/big_bold.font>Dönel kavşaktan çıkın.</font>"

	key[]: "aca_msg_book1_3_11_check6"
	val[]: "<font face=/font/big_bold.font>Öndeki park yerine doğru devam edin.</font>"

	key[]: "aca_msg_book1_3_11_stop"
	val[]: "<font face=/font/big_bold.font>Belirtilen yerde durun.</font>"

	key[]: "aca_msg_book1_3_11_end"
	val[]: "<font face=/font/big_bold.font>Çekiciyi emniyete alın ve motoru kapatın.</font>"
