#### 3_04 Driving Instructions



	key[]: "aca_msg_book1_3_04_forward"
	val[]: "<font face=/font/big_bold.font>Hızlanın ve bariyerlerin etrafından geçin.</font>"

	key[]: "aca_msg_book1_3_04_check1"
	val[]: "Piste çıkın ve ilk iki kolay dönüşü geçin.<br><br><font face=/font/big_bold.font>Sürmeye devam edin.</font>"

	key[]: "aca_msg_book1_3_04_check2"
	val[]: "<font face=/font/big_bold.font>90 derecelik dönüşü yapın.</font>"

	key[]: "aca_msg_book1_3_04_check3"
	val[]: "Pistin bir sonraki kısmı çifte firkete virajdır. İlk kısımdaki manevranız, ikinci kısımdaki yolunuzu doğrudan etkileyecektir.<br><br><font face=/font/big_bold.font>Dikkatli devam edin.</font>"

	key[]: "aca_msg_book1_3_04_check4"
	val[]: "Firkete virajdan çıktığınızda dar kısma girmek için soldan devam edin.<br><br><font face=/font/big_bold.font>Sürmeye devam edin.</font>"

	key[]: "aca_msg_book1_3_04_check5"
	val[]: "<font face=/font/big_bold.font>Dar kısımdan geçin. </font>"

	key[]: "aca_msg_book1_3_04_check6"
	val[]: "Önünüzde birkaç 90 derecelik kolay dönüş var.<br><br><font face=/font/big_bold.font>Dönüşleri gerçekleştirin.</font>"

	key[]: "aca_msg_book1_3_04_check7"
	val[]: "Başka bir keskin dönüşe yaklaşıyorsunuz. Yaklaşırken aynadan dorsenizi takip edin. <br><br><font face=/font/big_bold.font>Keskin dönüş boyunca sürün.</font>"

	key[]: "aca_msg_book1_3_04_check8"
	val[]: "Önünüzdeki 90 derecelik dönüş göründüğünden çok daha dar. Alanınızı akıllıca kullanın.<br><br><font face=/font/big_bold.font>Sürmeye devam edin.</font>"

	key[]: "aca_msg_book1_3_04_check9"
	val[]: "Son keskin dönüş karmaşıktır ve neredeyse hiç alan yoktur. <br><br><font face=/font/big_bold.font>Dikkatli ilerleyin.</font>"

	key[]: "aca_msg_book1_3_04_check10"
	val[]: "Son 90 derecelik dönüş sizi bekliyor.<br><br><font face=/font/big_bold.font>Sürmeye devam edin.</font>"

	key[]: "aca_msg_book1_3_04_check11"
	val[]: "Belirtilen yere doğru devam edin."
