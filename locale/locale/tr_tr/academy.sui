 #!}


#@}

#+ Book 1 Scenario 3_17
#@{

#### 3_17 common
	key[]: "aca_scenario_book1_3_17_title"
	val[]: "Bir Dönüşe Geri Geri Girmek"

	key[]: "aca_scenario_book1_3_17_desc"
	val[]: "Bu senaryoda ilk defa bir dorseyle bir viraja geri geri gireceğiz. Geri gitmenin temel prensiplerini ve geri geri giderek dönüş esnasında nelere dikkat edilmesi gerektiğini öğreneceğiz."

#### 3_17 goal

	key[]: "aca_goal_book1_3_17_check1"
	val[]: "Dorseyi Döndürmek"
#!{
	key[]: "aca_goal_book1_3_17_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_17_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_17_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_17_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
 #!}
#### 3_17 msg - intro text

	key[]: "aca_msg_book1_3_17_cutscene01"
	val[]: "Bu senaryoda, arkanızda şoför tarafındaki park yerine geri geri girmeniz gerekecektir."

	key[]: "aca_msg_book1_3_17_cutscene02"
	val[]: "Dorseyle geri manevra yaparken size çok yardımcı olacak birkaç tavsiyeyi aklınızda tutmanız gerekir. <br>Birincisi, dorse daima çekicinin istikametinin aksine dönmek ister."

	key[]: "aca_msg_book1_3_17_cutscene03"
	val[]: "İkincisi, çekicinin ve dorsenin dingillerine bakarak dorsenin nereye gittiğine dair bir fikir edinebilirsiniz."

	key[]: "aca_msg_book1_3_17_cutscene04"
	val[]: "Üçüncüsü, küçük müdahaleler işinizi görecektir, fazla uğraşmanıza gerek yoktur."

	key[]: "aca_msg_book1_3_17_cutscene05"
	val[]: "Çekiciyi park yerinden hafifçe uzaklaştırmaya başladığınızda dorse, park yerine doğru dönmeye başlayacaktır."

	key[]: "aca_msg_book1_3_17_cutscene06"
	val[]: "Dorseyi takip edin ve doğru yolu izlemesini sağlamak için ayarlamalar yapın."

	key[]: "aca_msg_book1_3_17_cutscene07"
	val[]: "Dorse tekerleklerini ve çekicinin arka tekerleğini takip edin. Bunlar size dorsenin nereye baktığını ve çekicinin dorseyi nereye ittiğini söyleyecektir."

	key[]: "aca_msg_book1_3_17_cutscene08"
	val[]: "Dördüncü ipucu, dorseyi keskin bir şekilde döndürmek her zaman dorseyi bir katlanmadan kurtarmaya çalışmaktan daha kolaydır. Park yerine yaklaşana kadar park yerinin aksi istikametine gidin sonra dorsenizi hizalamak için biraz daha keskin dönebilirsiniz."

	key[]: "aca_msg_book1_3_17_cutscene09"
	val[]: "Dorse park yerine girdiğinde çekiciyi dorsenin önüne getirin. Park yerinde çok fazla düzeltme yapmaktan kaçının."

	key[]: "aca_msg_book1_3_17_cutscene10"
	val[]: "Bariyerlerin arasından geri geri gidin, her iki tarafı da kontrol edin."

	key[]: "aca_msg_book1_3_17_cutscene11"
	val[]: "Çekiciyi emniyete alın ve motoru kapatın."

#### 3_17 Driving Instructions

	key[]: "aca_msg_book1_3_17_start"
	val[]: "Dorseyle bir dönüşe geri geri girerken bu ipuçlarını aklınızda bulundurun:<br><br>— Dorse, çekicinin istikametinin aksine döner<br><br>— Dorsenin tekerleklerini seyrederek nereye gittiğine bakın<br><br>— Çekicinin arka tekerleğini seyrederek dorseyi nereye ittiğine bakın<br><br>— Dorse zaten dönecektir, direksiyon simidini aşırı çevirmeyin<br><br>— Dorseyi çok çevirmek, hizaya getirmekten her zaman daha kolaydır<br><br><font face=/font/big_bold.font>Yola çıkmaya hazır olun.</font>"

	key[]: "aca_msg_book1_3_17_backward"
	val[]: "Gitmeniz gereken yeri bulmak için arkanıza bakın. Geri gitmeye başlamadan önce her zaman etrafınızı kontrol edin.<br><br><font face=/font/big_bold.font>Park yerine geri geri girmeye başlayın.</font>"

	key[]: "aca_msg_book1_3_17_check1"
	val[]: "<font face=/font/big_bold.font>Dorseyi park yerine doğru çevirmeye başlayın ve içeri sokun.</font>"

	key[]: "aca_msg_book1_3_17_stop"
	val[]: "<font face=/font/big_bold.font>Belirtilen yerde durun. </font>"
#!{
	key[]: "aca_msg_book1_3_17_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_18
#@{

#### 3_18 common
	key[]: "aca_scenario_book1_3_18_title"
	val[]: "Dar Sokakta Park Etme Manevrası"

	key[]: "aca_scenario_book1_3_18_desc"
	val[]: "Bu senaryoda dorseyi küçük bir yoldan dar bir sokağa geri geri sokmanız gerekiyor."

#### 3_18 goal

	key[]: "aca_goal_book1_3_18_check1"
	val[]: "Dorseyi Döndürmek"
#!{
	key[]: "aca_goal_book1_3_18_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

