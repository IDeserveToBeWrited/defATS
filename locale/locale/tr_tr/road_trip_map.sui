#+ Washington TBs and POIs localization.
#@{
	key[]: "tb_wa1"
	val[]: "Olimpik Yarımadası"

	key[]: "tb_wa1_desc"
	val[]: "Olimpik Yarımadası, okyanusun, ormanın ve dağların sürekli değişen bir güzellik içinde bir arada bulunduğu bir yeri açığa çıkarmaktadır. Sis, kayalık kıyıları kaplarken şelaleler, yükseklerden aşağıya doğru akar ve gizli vadiler küçük tarihî kasabalara ev sahipliği yapar."

	key[]: "poi_wa1_01"
	val[]: "Tarihî Birleşik Devletler Postanesi"

	key[]: "poi_wa1_01_desc"
	val[]: "Port Townsend'in sahil şeridinin üzerindeki bir tepede 1893'te tamamlanan bina, şehrin uluslararası ticaretin yükselen bir merkezi olma yönündeki ilk hedeflerini yansıtan, gümrük binası da içeren bir federal tesis olarak tasarlanmıştır."

	key[]: "poi_wa1_02"
	val[]: "Port Angeles"

	key[]: "poi_wa1_02_desc"
	val[]: "Port Angeles, 19. yüzyılda bir liman ve tedarik noktası olarak kurulan bir kıyı kentidir. Bugün, Olimpik Millî Parkı'na açılan önemli bir geçit ve Amerika Birleşik Devletleri ile Kanada'yı birbirine bağlayan bir feribot limanı olarak hizmet vermektedir."

	key[]: "poi_wa1_03"
	val[]: "Crescent Gölü"

	key[]: "poi_wa1_03_desc"
	val[]: "Washington'ın en derin ikinci gölü olan Crescent Gölü, düşük nitrojen seviyeleri sayesinde canlı mavi ve berrak suları ile bilinir. Popüler bir rekreasyon alanında yer alan göl, yürüyüş yolları ve yaşlı ormanlarla çevrilidir."
	
	key[]: "poi_wa1_04"
	val[]: "Kalaloch Kumsalı"

	key[]: "poi_wa1_04_desc"
	val[]: "Kalaloch Kumsalı, kökleri açığa çıkmış ve küçük bir derenin üzerinden sahile uzanan \"Hayat Ağacı\" adlı Sitka ladiniyle ünlüdür. Bu ağaç, sıradan uzun ladinlerden farklı olarak daha kısa, daha kalın ve rüzgârın şekillendirdiği görünümüyle dikkat çeker. Bu da onu eşsiz ve popüler bir yerel simge hâline getirir."

	key[]: "poi_wa1_05"
	val[]: "Olimpik Millî Parkı"

	key[]: "poi_wa1_05_desc"
	val[]: "Olimpik Millî Parkı, engebeli Pasifik kıyı şeridinden ılıman yağmur ormanlarına ve dağ zirvelerine kadar çeşitli ekosistemleri korumaktadır. İlk olarak 1909'da Millî Anıt olarak sınıflandırılan park, 1938'de federal hükûmet tarafından Millî Park olarak yeniden adlandırılmıştır."

	key[]: "poi_wa1_06"
	val[]: "Greenhead Bataklığı"

	key[]: "poi_wa1_06_desc"
	val[]: "Greenhead Bataklığı, Willapa Körfezi yakınlarındaki 101 numaralı kara yolu boyunca uzanan küçük bir koy ve sulak alan kanalıdır. Somonların yumurtlama alanını desteklemek ve bol miktarda su kuşu gözlemlemek için restore edilmiş bir kıyı haliç habitatı içinde yer almaktadır."

	key[]: "poi_wa1_07"
	val[]: "Dabob Körfezi"

	key[]: "poi_wa1_07_desc"
	val[]: "Dabob Körfezi, somon balıklarına, kabuklu deniz mahsullerine ve yaban hayatına ev sahipliği yapan derin bir fiyorttur. 1984 yılında kurulan Dabob Körfezi Doğal Alanı, son derece işlevsel bir gelgit sulak alan sistemi içinde nadir tuzlu bataklık ve kumlu kıyı bitki topluluklarını korumaktadır."


##########################################################################################

	key[]: "tb_wa2"
	val[]: "The Heartland"

	key[]: "tb_wa2_desc"
	val[]: "Washington'ın kalbi, yolcuları yemyeşil ormanlar ve huzurlu dağ gölleri arasından geçen manzaralı yollara davet ediyor. Rainier Dağı, ufuğu cüssesiyle kaplarken Pasifik Kuzeybatısı'nın doğal manzaraları arasında huzurlu bir yolculuk vadediyor."

	key[]: "poi_wa2_01"
	val[]: "Rainier Dağı"

	key[]: "poi_wa2_01_desc"
	val[]: "Washington'ın 14.411 fit ile en yüksek noktası olan Rainier Dağı, aktif bir stratovolkandır. Buzulları nehirleri besler, vadileri şekillendirir ve zengin ormanlarla yaban hayatını destekleyerek bölgeyi önemli bir doğal konum haline getirir."

	key[]: "poi_wa2_02"
	val[]: "Wanatchee Ulusal Ormanı"

	key[]: "poi_wa2_02_desc"
	val[]: "Wenatchee Ulusal Ormanı; dağları, nehirleri ve dağ vadilerini kapsar. 1933'te Civilian Conservation Corps burada patikalar ve yangın gözetleme noktaları inşa etmiştir. Böylece ormanın rekreasyonel ve koruma tarihine kalıcı bir iz bırakmıştır."

	key[]: "poi_wa2_03"
	val[]: "Baker Dağı–Snoqualmie Ulusal Ormanı"

	key[]: "poi_wa2_03_desc"
	val[]: "Baker Dağı–Snoqualmie Ulusal Ormanı, Amerika'daki en eski buzul izleme alanlarından bazılarına ev sahipliği yapmaktadır ve 1900'lü yılların başından itibaren Cascade Dağları boyunca volkanik buz akışlarını ve iklim değişikliklerini izlemektedir."
	
	key[]: "poi_wa2_04"
	val[]: "Wenatchee Nehri"

	key[]: "poi_wa2_04_desc"
	val[]: "Wenatchee Nehri boyunca 19. yüzyılın başlarından kalan sulama kanallarının ve değirmenlerin kalıntıları, bölge sakinlerinin nehrin sularını nasıl kullandıklarını göstermektedir. Yerli kabileler de somon bakımından zengin olan bu sulardan Avrupalıların yerleşiminden çok önce beslenme ve ticaret amacıyla yararlanmıştır."

	key[]: "poi_wa2_05"
	val[]: "Klawatti Zirvesi"

	key[]: "poi_wa2_05_desc"
	val[]: "İlk kez 20. yüzyılın ortalarında tırmanılan Klawatti Zirvesi, dik ve buzullarla kaplı yamaçları nedeniyle hâlâ nadiren tırmanılan bir konum durumundadır ve North Cascades'te huzurlu vakit geçirmek isteyen dağcılar için gözde bir imtihan olarak dikkat çekmektedir."

	key[]: "poi_wa2_06"
	val[]: "Dry Falls Barajı"

	key[]: "poi_wa2_06_desc"
	val[]: "Yerel su yollarını yönetmek amacıyla inşa edilen Dry Falls Barajı, kökeni tarih öncesine dayanan bazalt kayalıkların üzerinde yer almakta ve mevsimsel su akışlarını kontrol ederken Buzul Çağı sellerinin oluşturduğu terasları ve çöküntü havuzlarını yansıtmaktadır."

	key[]: "poi_wa2_07"
	val[]: "White Mountain Yangın Gözetleme Seyir Noktası"

	key[]: "poi_wa2_07_desc"
	val[]: "Seyir noktasında, Washington'ın yakın tarihindeki en büyük orman yangınlarından biri olan 1988 White Mountain Yangını hakkında bilgilendirici tabelalar bulunmaktadır ve ormandaki yangın izleri ve yeniden büyüme emareleri gözler önüne serilmektedir."

	key[]: "wa_cut_helen_desc"
	val[]: "St. Helens Yanardağı 1980'den önce konik bir şekle sahipti ve Amerika'nın Fuji Dağı olarak anılırdı. 1980'deki patlama, dağ zirvesinin 1.300 fitlik kısmını yok ederek bugün kısmen bir lav kubbesi ve buzulla dolu olan at nalı şeklindeki krateri oluşturdu."


##########################################################################################


	key[]: "tb_wa3"
	val[]: "Şarap Bölgesi"

	key[]: "tb_wa3_desc"
	val[]: "Cascade Dağlarının doğusunda yer alan Washington'ın Şarap Bölgesi, Columbia Valley AVA'yı kapsar. Bölge kapsamında Selah Creek, Lewis and Clark State Park ve tarih boyunca yerli halkların yaşadığı topraklar yer alır ve inişli çıkışlı tepeler ile nehir vadilerinden oluşan kuru, güneşli manzaralar bulunur."

	key[]: "poi_wa3_01"
	val[]: "Clear Creek Şelalesi"

	key[]: "poi_wa3_01_desc"
	val[]: "Clear Creek Şelalesi Seyir Noktası, White Pass Zirvesi'nin hemen doğusunda bulunan popüler bir duraktır. Yaklaşık bir mil doğuda bulunan dönüş, gelenleri balıkçılığı ve yerel yaban hayatını gözlemlemek için sunduğu mükemmel imkânlarla tanınan Clear Lake Rekreasyon Alanı'na götürür."

	key[]: "poi_wa3_02"
	val[]: "Selah Creek Köprüsü"

	key[]: "poi_wa3_02_desc"
	val[]: "Fred G. Redmon Köprüsü veya Selah Creek Köprüsü, Yakima County'de bulunan çift kemerli bir yapıdır. Tamamlandığında Amerika'nın en uzun beton kemer köprüsü ve eyaletin en yüksek otomobil köprüsü ünvanını taşımıştır."

	key[]: "poi_wa3_03"
	val[]: "Üzüm Bağları"
	
	key[]: "poi_wa3_03_desc"
	val[]: "Washington'ın vadileri ve bereketli toprakları; Riesling, Cabernet ve Merlot dâhil olmak üzere birçok üzüm çeşidinin yetişmesini sağlamaktadır. Bağlar, eyalet tarımının ve buradaki yerel manzaraların önemli bir parçasıdır."

	key[]: "poi_wa3_04"
	val[]: "Ed Hendler Köprüsü"

	key[]: "poi_wa3_04_desc"
	val[]: "1978 yılında inşa edilen ve bazen Intercity Köprüsü olarak da adlandırılan bu köprü, güneydoğu Washington'da Pasco ile Kennewick arasında Columbia Nehri'nin üzerinden geçer. Açıldığı günden beri Tri-Cities bölgesinin önemli yapılarından ve sembollerinden biri olarak kabul edilir."

	key[]: "poi_wa3_05"
	val[]: "Lewis and Clark State Parkı"

	key[]: "poi_wa3_05_desc"
	val[]: "Washington'ın ilk eyalet parklarından biri olan Lewis and Clark State Parkı, tarihî bir yerli halk güzergâhı boyunca uzanan kadim ormanlara ev sahipliği yapar. Corps of Discovery'yi onurlandırmak amacıyla bu adla anılan parkın ormanları, Meriwether Lewis'in günlüklerinde tarif ettiği sık ormanlık alanları hatırlatır."

	key[]: "poi_wa3_06"
	val[]: "Columbia County Adliyesi"

	key[]: "poi_wa3_06_desc"
	val[]: "Columbia County Adliyesi, ilçe yönetiminin günlük yaşamın merkezinde olduğu bir dönemi yansıtır. Hızlı büyümenin yaşandığı ve eyalet başkentiyle iletişimin sınırlı olduğu dönemde adliyeler, başlıca otorite kaynağı olarak hizmet verir ve vatandaşların acil ihtiyaçlarıyla ilgilenirdi."

	key[]: "poi_wa3_07"
	val[]: "Yerli Amerikan Kabileleri"

	key[]: "poi_wa3_07_desc"
	val[]: "Columbia Valley ve çevresindeki bölgeler; Yakama, Walla Walla ve Umatilla kabileleri de dâhil olmak üzere yerli halklara ev sahipliği yapıyordu. Günümüzde bu topluluklar bölgede yaşamaya devam ederek kültürel geleneklerini sürdürmekte ve kara ile su kaynaklarını yönetmektedir."

##########################################################################################

#@}




#+ Oregon TBs and POIs localization.
#@{
	key[]: "tb_or1"
	val[]: "Pasifik Kıyısı"

	key[]: "tb_or1_desc"
	val[]: "Oregon’un Pasifik Kıyısı, manzaralı seyir noktalarına sahip sarp burunlarıyla dikkat çekmektedir. Heceta Head Deniz Feneri kuvvetli dalgaları seyrederken Silver Point, Ophir Wayside, Sisters Rocks ve Kissing Rock boyunca yükselen bazalt kayalıklar Pasifik’in dalgalarıyla bir araya gelir."

	key[]: "landmark_or_astoria_b_desc"
	val[]: "Columbia Nehri boyunca dört millik bir mesafede uzanan bu köprü, Oregon ile Washington'ı birbirine bağlayarak nehrin ağzı ve Pasifik ufku manzaralarını sunar."

	key[]: "poi_or1_01"
	val[]: "Silver Point Bilgilendirici Seyir Noktası"

	key[]: "poi_or1_01_desc"
	val[]: "Cannon Plajı'nın hemen güneyinde bulunan bu seyir noktası, özellikle gün batımında Haystack Rock ve sarp kıyı şeridinin müthiş manzaralarını sunar."

	key[]: "or_cut_lighthouse_desc"
	val[]: "Oregon'un 1873'te inşa edilen en yüksek deniz feneri, Newport yakınlarındaki bir bazalt burun üzerinde yükselir."

	key[]: "or_cut_newport_desc"
	val[]: "1936'da tamamlanan Yaquina Bay Köprüsü, Oregon'un en ikonik kıyı simge yapılarından biridir. Ünlü mühendis Conde McCullough tarafından tasarlanan zarif kemeri Yaquina Bay'i kapsar ve U.S. Route 101'in belirgin simgelerinden biri olmaya devam etmektedir."

	key[]: "or_cut_thor_desc"
	val[]: "Cape Perpetua'da, coşkun dalgaların içine girdiği ve okyanusun boşalıyormuş gibi görünmesine yol açan doğal bir obruk."

	key[]: "poi_or1_02"
	val[]: "Ophir Wayside"

	key[]: "poi_or1_02_desc"
	val[]: "Gold Beach yakınlarında ziyaretçilerin mola verip denizi izleyebileceği veya kumsalda dalgaların getirdiği odunları ve akik taşlarını arayabileceği sakin bir cep."

	key[]: "poi_or1_03"
	val[]: "Sisters Rock Seyir Noktası"

	key[]: "poi_or1_03_desc"
	val[]: "Dalgaların arasından yükselen etkileyici kıyı kayalıkları göze çarparken kayalıkların arasında gizlenmiş küçük plajlara patikalardan inilebilir."

	key[]: "poi_or1_04"
	val[]: "Kissing Rock"

	key[]: "poi_or1_04_desc"
	val[]: "Gold Beach'in güneyinde, iki devasa kaya oluşumunun kumların üzerinde birbirine yaslandığı ve burayı fotoğraf çekmek için popüler bir nokta haline getirdiği yol kenarı dinlenme alanı."


##########################################################################################

	key[]: "tb_or2"
	val[]: "Vahşi Doğu"

	key[]: "tb_or2_desc"
	val[]: "Genellikle Oregon'un Vahşi Doğusu olarak adlandırılan bu bölge, yüz milyonlarca yıl boyunca jeolojik kuvvetler tarafından şekillendirilen ve birçoğu bugün hâlâ aktif olan manzaraları gözler önüne serer. Bu devasa zaman ölçeğinin yanında insanlık tarihi kısa kalır ancak arazinin kendisi kadar çarpıcı anlarla doludur."

	key[]: "landmark_or_deadman_p_desc"
	val[]: "Pendleton yakınlarındaki bu seyir alanı, adını 1870'lerdeki Bannock Savaşı sırasında bir vagon sürücüsünün ölü bulunduğu olaydan alan Deadman Pass'in manzaralarını sunar. Yıllar önce sayısız vagon Oregon Trail'deki bu tepelerden geçmiştir."

	key[]: "or_cut_395_desc"
	val[]: "Bir zamanlar Three Flags Highway olarak bilinen US-395, Kanada'dan Meksika'ya kadar uzanarak çölleri, ormanları ve dağları birbirine bağlamaktaydı. Günümüzde California'daki I-15'te sona ermekte ancak ilk güzergâhın kalıntıları San Diego yakınlarında hâlâ bulunmaktadır."

	key[]: "poi_or2_01"
	val[]: "Malheur Ulusal Ormanı"

	key[]: "poi_or2_01_desc"
	val[]: "Malheur Ulusal Ormanı, Mavi Dağlar'da bulunur. 150 milyon yıldan daha uzun bir süre önce bu bölgedeki en eski kayalardan bazıları Pasifik'teki volkanik adaların bir kısmını oluşturmuş ve daha sonra kıtayla birleşmiştir."
	
	key[]: "poi_or2_02"
	val[]: "Badlands Wilderness"

	key[]: "poi_or2_02_desc"
	val[]: "Bend'in hemen doğusunda yer alan Badlands Wilderness, antik lav akıntıları ve rüzgârın taşıdığı küller tarafından şekillendirilmiş engebeli bir volkanik yapıdır. Çarpık lav oluşumları, kumlu toprakları ve yalın arazisi, eyaletteki en eşsiz yüksek çöllü ortamlarından birini oluşturur."

	key[]: "poi_or2_03"
	val[]: "Abert Gölü"

	key[]: "poi_or2_03_desc"
	val[]: "İlk kez 1843'te haritalandırılan Abert Gölü, 10.000 yılı aşkın süredir insanlığa fayda sağlamaktadır. Suyu balıklar için fazla tuzlu olsa da Pasifik Göç Yolu boyunca kuşlar için önemli bir durak olmaya devam etmektedir ve iklim değişikliği nedeniyle son zamanlarda giderek küçülmektedir."

	key[]: "poi_or2_04"
	val[]: "East Steens Tur Rotası"

	key[]: "poi_or2_04_desc"
	val[]: "East Steens Tur Rotası; Steens Dağı ve Alvord Çölü boyunca Highway 78'i takip eder. Rotanın öne çıkan noktası, Oregon'daki en büyük kuru göl yataklarından biri olan Alvord Çölü göl yatağıdır. Buranın yapısı, mevsime bağlı olarak sığ bir göl ile uçsuz bucaksız bir çöl ovası arasında değişir."

	key[]: "poi_or2_05"
	val[]: "Doherty Slide"

	key[]: "poi_or2_05_desc"
	val[]: "Volkanik faaliyet sonucu oluşan bir kaya oluşumu olan Doherty Slide boyunca araç yolculuğu bir saatten kısa sürse de doğanın bu manzarayı bugünkü hâline getirmesi yaklaşık 16 milyon yıl sürmüştür."


##########################################################################################

	key[]: "tb_or3"
	val[]: "Ogden Kenti"

	key[]: "tb_or3_desc"
	val[]: "Bu rota Oregon'un iç kesimlerindeki kuzey-güney koridorunu takip ederek ormanlardan ve yüksek çöl arazilerinden geçer. İlk olarak 1820'lerde kürk tüccarı Peter Skene Ogden tarafından keşfedilen rota, daha sonra İkinci Dünya Savaşı sırasında kereste kaynakları ve ulaşım güzergâhları nedeniyle stratejik önem kazanmıştır."
	
	key[]: "poi_or3_01"
	val[]: "Springfield Flame"

	key[]: "poi_or3_01_desc"
	val[]: "Yaklaşık 65 fit yüksekliğindeki heykel, Springfield'ın kuzey girişini simgeler. Bir alev şeklinde tasarlanan eser, yolcular için bir rehber ve bölge sakinleri ile ziyaretçiler için bir simge işlevi görür."

	key[]: "poi_or3_02"
	val[]: "Santiam Vagon Yolu"

	key[]: "poi_or3_02_desc"
	val[]: "Buranın doğusundaki geçit, bir zamanlar Andrew Wiley'nin adından esinlenerek Wiley Geçidi olarak adlandırılmış ve 1859'da otlatma güzergâhları arayan öncüler tarafından keşfedilmiştir. 1864'te bir askerî yol planlanmış ancak büyük ölçüde inşa edilmemiştir. Ücretli bir güzergâh olan Santiam Vagon Yolu, 1868'den 1914'e kadar hizmet vermiştir."

	key[]: "poi_or3_03"
	val[]: "Tarihî Gazi Otoyolu"

	key[]: "poi_or3_03_desc"
	val[]: "Otoyolun kuzey girişinde, 18 anma levhasından son ikisi 9 Kasım 2012'de Biggs Junction'ın güneyine yerleştirilmiştir. Bu levhalar, ülkenin İkinci Dünya Savaşı gazilerine adanan ilk otoyolunun kuzey giriş noktası olarak Camp Rufus'u simgeler."

	key[]: "poi_or3_04"
	val[]: "Ogden State Manzaralı Seyir Noktası"

	key[]: "poi_or3_04_desc"
	val[]: "19. yüzyılın başlarında yaşamış bir kâşif ve Hudson's Bay Company baş tüccarı olan Peter Skene Ogden'ın adını taşıyan bu yol kenarı alanı, Ogden'ın Snake River bölgesindeki keşif gezilerini ve Great Salt Lake Havzası'nı keşfeden ilk kişilerden biri olarak üstlendiği rolü onurlandırır."

	key[]: "landmark_or_fremont_b_desc"
	val[]: "Köprü ve Portland'daki Fremont Street, Las Californias ve Oregon Country'nin ilk kâşiflerinden John C. Frémont'un adını taşır. Oregon'daki en uzun ana açıklığa sahip olan köprü, dünyanın en uzun ikinci bağlı kemer köprüsüdür."

	
##########################################################################################

#@}



#+ California TBs and POIs localization.
#@{
	key[]: "tb_ca1"
	val[]: "The Golden Horizon"

	key[]: "tb_ca1_desc"
	val[]: "Simgeleşmiş köprüler, parıldayan suların üzerinde yükselerek Alcatraz'ı, Santa Cruz'u ve bölgenin tepeleriyle mahallelerini birbirine bağlar. Hareketli caddelerden ve tarihî mekânlardan güneşli plajlara ve manzaralı kıyı şeritlerine uzanan Bay Area, California'da başka hiçbir yerde bulunmayan bir deneyim sunar."

	key[]: "ca_cut_golden_gate_bridge_desc"
	val[]: "San Francisco Körfezi'ni Pasifik Okyanusu'na bağlayan bu köprü, San Francisco ile California'nın simgelerinden biridir. 1937'de açıldığında dünyanın hem en uzun hem de en yüksek asma köprüsü rekorlarını elinde tutmuştur."

	key[]: "poi_ca1_01"
	val[]: "Alcatraz"

	key[]: "poi_ca1_01_desc"
	val[]: "Alcatraz Adası, 1934'ten 1963'e kadar federal bir hapishaneye ev sahipliği yapmıştır. Ülkenin en kötü şöhretli suçlularından bazılarını barındırmasıyla tanınan ada, günümüzde tarihî bir alan ve popüler bir turistik destinasyondur."

	key[]: "ca_cut_richmond_desc"
	val[]: "Richmond–San Rafael Köprüsü, San Francisco Körfezi'ni geçerek Richmond ile San Rafael'i birbirine bağlar. 1956'da açılan köprü, körfezin kuzeyinden trafik akışı sağlar ve konsol makas tasarımıyla bölgenin önemli ulaşım bağlantılarından biri olarak işlev görür."
	
	key[]: "poi_ca1_02"
	val[]: "Hazine Adası"

	key[]: "poi_ca1_02_desc"
	val[]: "Hazine Adası, 1939'da Golden Gate Uluslararası Fuarı için inşa edilmiş bir adadır. Donanma üssü olarak hizmet verdikten sonra günümüzde konut ve ticari kullanım için yeniden geliştirilmektedir."

	key[]: "poi_ca1_03"
	val[]: "Sörf Şehri"

	key[]: "poi_ca1_03_desc"
	val[]: "Santa Cruz'daki Sörf Heykeli, şehrin sörf mirasını ve kültürünü onurlandırır. Sahil kenarına yerleştirilen heykel, yerel sörfçüleri ve Santa Cruz'un kimliğini ve kıyı topluluğunu şekillendiren bu sporu yansıtır."

	key[]: "poi_ca1_04"
	val[]: "Madonna Inn"

	key[]: "poi_ca1_04_desc"
	val[]: "Highway 152'nin tepesinde bir zamanlar popüler olan bir restoran ve etkinlik mekânıdır. Otoyolla ilgili sorunlar nedeniyle 2004'ten beri kapalı olan mekân, yerel tarih ve hayalet hikâyeleri forumlarında hâlâ sıkça konu olmaktadır."



##########################################################################################

	key[]: "tb_ca2"
	val[]: "Shasta Rotası"

	key[]: "tb_ca2_desc"
	val[]: "Shasta Rotası, Shasta Dağı'nın eteklerinde çam ormanları ve parıldayan dağ gölleri arasından kıvrılarak ilerler. Gizli vadiler boyunca yükselip alçalan yollar, yolcuları güneye taşır. Bu esnada dağlar giderek geride kalır ve yerlerini kuzey California'nın kadim sekoya ormanlarına bırakır."

	key[]: "poi_ca2_01"
	val[]: "Shasta–Trinity Ulusal Ormanı"

	key[]: "poi_ca2_01_desc"
	val[]: "Shasta–Trinity Ulusal Ormanı, California'nın en büyük ulusal ormanıdır ve Trinity Heritage Manzaralı Yolu bu ormandan geçer. 19. yüzyıldaki altın madencileri ve yerleşimciler tarafından kullanılan güzergâhları da takip eder."

	key[]: "poi_ca2_02"
	val[]: "Büyük Lagün"

	key[]: "poi_ca2_02_desc"
	val[]: "Büyük Lagün, Humboldt Lagoons Eyalet Parkı'ndaki üç lagünün en büyüğü ve en güneyde olanıdır. Bu sığ kıyı havzaları, okyanus dalgalarının oluşturduğu ve lagünleri Pasifik Okyanusu'ndan ayıran kum bariyerlerinin bulunduğu kayalık burunlar arasında yer alır."

	key[]: "or_cut_sequoia_desc"
	val[]: "Redwood Ulusal Parkı, dünyanın en uzun ve en yaşlı kıyı sekoyalarından bazılarını korur. Bu ağaçlar 370 fitin üzerine ulaşabilir ve 2.000 yıla kadar yaşayabilir. Yakındaki eyalet parklarıyla birlikte gezegenimizde kalan kadim sekoya ormanlarının yaklaşık yüzde 35'ine ev sahipliği yapar."
	
	key[]: "poi_ca2_03"
	val[]: "Smith Nehri"

	key[]: "poi_ca2_03_desc"
	val[]: "Kuzeybatı California'daki Six Rivers Ulusal Ormanı içerisinde yer alan bu koruma alanı, manzaraları ve ekolojik ve kültürel değerleri korumak amacıyla 1990'da Kongre tarafından koruma altına alınmıştır. Smith Nehri, California'da barajlarla kesilmemiş ve serbestçe akan tek büyük nehirdir."

	key[]: "poi_ca2_04"
	val[]: "Whiskey Creek Köprüsü"

	key[]: "poi_ca2_04_desc"
	val[]: "1961'de tamamlanan Whiskey Creek Köprüsü, üç açıklıklı, kaynaklı, levha kirişli bir yapıdır. Köprü, o dönemde yenilikçi bir kaynak tekniği olarak üç farklı çelik sınıfının kullanıldığı köprü tasarımının erken örneklerinden biri olarak dikkat çeker."

	key[]: "poi_ca2_05"
	val[]: "Shasta Gölü"

	key[]: "poi_ca2_05_desc"
	val[]: "California'nın en büyük rezervuarı olan Shasta Gölü, Sacramento Nehri üzerinde bulunan Shasta Barajı tarafından oluşturulmuştur. 1945'te tamamlanan baraj, su ve hidroelektrik enerji sağlar ve rekreasyon için manzaralı bir alan sunar."

	key[]: "poi_ca2_06"
	val[]: "Shasta Dağı"

	key[]: "poi_ca2_06_desc"
	val[]: "1820'lerden itibaren Cascade Sıradağları'nın en yüksek ikinci zirvesi olan Shasta Dağı, eteklerinden geçen Siskiyou Patikası boyunca yolculuk edenlere rehberlik etmiştir. Bu güzergâh daha sonra Interstate 5'e dönüşmüştür ve günümüzde her yıl binlerce kişiyi dağa ulaştırmaktadır."



##########################################################################################

	key[]: "tb_ca3"
	val[]: "Sierra Geçişi"

	key[]: "tb_ca3_desc"
	val[]: "Yükselen Sierra Nevada'nın eteklerinde yer alan Inn at Benton, açık vadiler ve dalgalı tepeler arasında bulunur. Sierra Geçişi, uzak zirvelerin ve engebeli sırtların zamansız bir panorama oluşturduğu sakin yüksek çöl yolları boyunca ilerler ve yolcuları bölgenin uçsuz bucaksız manzaralarını keşfetmeye davet eder."

	key[]: "ca_cut_olmsted_point_desc"
	val[]: "1890'da kurulan Yosemite Ulusal Parkı, en çok ziyaret edilen parklardan biridir. Kuzey Amerika'nın en yüksek şelalesi Yosemite Şelaleleri, geniş yürüyüş parkurları ve 3.000 seneden daha yaşlı dev sekoyalarıyla tanınır."

	key[]: "poi_ca3_01"
	val[]: "Tioga Geçidi"

	key[]: "poi_ca3_01_desc"
	val[]: "Tioga Geçidi, Yosemite Ulusal Parkı'nın kalbinden geçen manzaralı bir yoldur. California'daki en yüksek otoyol geçididir ve Sierra Nevada'nın batı ve doğu taraflarını birbirine bağlar."

	key[]: "poi_ca3_02"
	val[]: "Mono Gölü"

	key[]: "poi_ca3_02_desc"
	val[]: "Mono Gölü 1 milyon yıldan daha eski olup Kuzey Amerika'nın en eski göllerinden biridir. Doğal bir çıkışı bulunmadığından Sierra Nevada'nın doğu yamaçlarından akan derelerin binlerce yıl boyunca taşıdığı tuzları ve mineralleri biriktirmiştir."
	
	key[]: "poi_ca3_03"
	val[]: "Tahoe Gölü"

	key[]: "poi_ca3_03_desc"
	val[]: "Tahoe Gölü, yaklaşık 2 milyon yıl önce Tahoe Havzası'nda oluşmuş ve günümüzdeki şeklini Buzul Çağı'ndaki buzulların aşındırmasıyla kazanmıştır. Kuzey Amerika'nın en büyük dağ gölü ve Amerika Birleşik Devletleri'nin ikinci en derin gölüdür."

	key[]: "poi_ca3_04"
	val[]: "Eldorado Ulusal Ormanı"

	key[]: "poi_ca3_04_desc"
	val[]: "Eldorado Ulusal Ormanı, milyonlarca California sakinine su sağlayan ve ülkenin meyve ve sebze üretiminin neredeyse yarısını destekleyen önemli bir su havzasının bir parçasını oluşturur."

	key[]: "poi_ca3_05"
	val[]: "Inn at Benton Hot Springs"

	key[]: "poi_ca3_05_desc"
	val[]: "Mono County'nin en eski kasabalarından biri olan Benton, kaplıcalarından yararlanan Paiute halkı tarafından kurulmuştur. 1860'larda yerleşimciler ve madenciler için bir durak hâline gelmiştir. 1940'larda yerel ponza taşından inşa edilen Han, 10 odanın tek bir banyoyu paylaştığı 1904 tarihli bir otelin yerini almıştır."



##########################################################################################

	key[]: "tb_ca4"
	val[]: "The Sun & Sand"

	key[]: "tb_ca4_desc"
	val[]: "Death Valley'nin çölü, sonsuz gökyüzünün altında uzanmaktadır ve kum tepeleri, sarp zirveler ve çatlamış düzlüklerle şekillenmiştir. Güneşli kumların üzerinde tavşanlar sıçramakta, kafatasları sessiz geçişleri temsil etmekte ve tenha yollar, buraya gelen herkesi sınayan ve hayran bırakan yalın, amansız bir manzaranın içinden süzülerek ilerlemektedir."

	key[]: "poi_ca4_01"
	val[]: "Lone Pine"

	key[]: "poi_ca4_01_desc"
	val[]: "Lone Pine, California'nın Owens Vadisi'nde, Sierra'nın doğu eteklerinde yer alan küçük bir kasabadır. Yakınındaki Alabama Hills ile tanınan kasaba, çevredeki dağları ve çöl manzaralarını keşfeden yürüyüşçüler, dağcılar ve film yapımcıları için uzun zamandır bir geçiş noktası görevi görmüştür."

	key[]: "poi_ca4_02"
	val[]: "Death Valley Ulusal Parkı"

	key[]: "poi_ca4_02_desc"
	val[]: "Death Valley, Amerika'nın en zorlu koşullara sahip manzaralarından biridir. Bazı bölgeleri en alçak, en sıcak, en kurak ve en yüksek noktaları barındırmaktadır. 1800'lerdeki öncülerden çok daha önce yerli kabileler burada yaşamış, bu sert ancak tarih açısından zengin bölgede avcılık ve toplayıcılık yapmıştır."

	key[]: "poi_ca4_03"
	val[]: "Father Crowley Manzara Noktası"

	key[]: "poi_ca4_03_desc"
	val[]: "Bu Manzara Noktası, yolcular için popüler bir durak olmuştur. Çöl Papazı olarak bilinen Peder John J. Crowley burada sık sık mola vermiştir. Parkın batı sınırının yakınında yer alan nokta, antik volkanik faaliyetlerle şekillenmiş renkli bir oluşum olan Rainbow Kanyonu'nun çarpıcı manzaralarını sunmaktadır."
	
	key[]: "poi_ca4_04"
	val[]: "Mojave Valley Kuyuları"

	key[]: "poi_ca4_04_desc"
	val[]: "Mojave'deki Valley Wells'te bulunan antik yer altı suyu çıkış birikintileri, Buzul Çağı'ndaki geçmiş sulak alan ortamlarına tanıklık etmiştir. Bu tarihî kuyular, yer altı suyunun şu anda kurak olan çölde bir zamanlar bataklıkları ve gür bitki örtüsünü nasıl desteklediğini ortaya koymuştur."

	key[]: "poi_ca4_05"
	val[]: "The Colorado River Indian Reservation"

	key[]: "poi_ca4_05_desc"
	val[]: "Alan; Arizona ve California boyunca Colorado Nehri kıyısında uzanmaktadır. 1865'te nehir çevresindeki kabileler için kurulmuş olan bu alan; Mohave, Chemehuevi, Hopi ve Navajo halklarına ev sahipliği yapmakta ve günümüzde tarımı ve toplumsal yaşamı desteklemektedir."

##########################################################################################

#@}



#+ Idaho TBs and POIs localization.
#@{

    key[]: "tb_id1"
	val[]: "The Treasure Valley"

	key[]: "tb_id1_desc"
	val[]: "Güneybatı Idaho'daki Treasure Valley; Kızılderili kabileleri, ilk kürk tüccarları ve Oregon Trail yerleşimcileri tarafından şekillendirilmiş zengin bir tarihe sahiptir. Adı, bölgenin kaynaklarını ve sunduğu fırsatları yansıtmaktadır ve vadi daha sonra Boise merkezli tarım, demiryolları ve bölgesel ticaretle gelişmiştir."

	key[]: "poi_id1_01"
	val[]: "Salmon Nehri"

	key[]: "poi_id1_01_desc"
	val[]: "Idaho'daki Salmon Nehri, derin ve engebeli bir kanyonda 425 mil boyunca uzanmaktadır. Güçlü ve zorlu akıntılarına karşı teknelerin nehirde yukarı doğru ilerleyememesi nedeniyle “Geri Dönüşü Olmayan Nehir” lakabını almıştır."

	key[]: "poi_id1_02"
	val[]: "Boise Ulusal Ormanı"

	key[]: "poi_id1_02_desc"
	val[]: "Aşınmaya elverişli Idaho Batoliti boyunca uzanan Boise Ulusal Ormanı, volkanik faaliyetlerle şekillenmiş engebeli bir araziye sahiptir. Bu jeolojik miras en iyi şekilde dik kanyonlarında ve arazi boyunca gizlenmiş çok sayıdaki doğal kaplıcada görülmektedir."

	key[]: "poi_id1_03"
	val[]: "Horseshoe Bend"

	key[]: "poi_id1_03_desc"
	val[]: "1862'de Boise Havzası'nda altın bulunmasının ardından nehir kenarında kışlayan madenciler tarafından Horseshoe Bend kurulmuştur. Başlangıçta yerel bir kereste fabrikası sahibinin adıyla Warrinersville olarak anılan kasaba, maden arayıcıları için önemli bir durak hâline gelmesiyle 1867'de bugünkü adını almıştır."
	
	key[]: "poi_id1_04"
	val[]: "Gişe"

	key[]: "poi_id1_04_desc"
	val[]: "1864'te dik Syrup Creek patikasının yerini yeni bir kanyon güzergâhı almıştır. 20 yıl boyunca geçiş ücretleri, güzergâhın bakımını sağlamış, James A. Porter'ın ünlü oteli ve mandırası ise sığınacak bir yer arayan yolcular için önde gelen bir durak hâline gelmiştir."

	key[]: "poi_id1_05"
	val[]: "Castle Rock"

	key[]: "poi_id1_05_desc"
	val[]: "Camas Prairie'ye doğru uzanan Castle Rock'ın granit kaya çıkıntıları, Goodale's Cutoff güzergâhındaki Oregon Trail göçmenleri için işaret noktaları olarak hizmet etmiştir. 1862'den otomobillerin kullanılmaya başlandığı döneme kadar kullanılan bu nadir oluşumlar, yolculara güzergâh boyunca çarpıcı bir manzara sunmuştur."

    key[]: "poi_id1_06"
	val[]: "Duck Valley Indian Reservation"

	key[]: "poi_id1_06_desc"
	val[]: "1886'da Başkan Cleveland, “Paddy Cap Extension” ile Duck Valley'yi Idaho'ya doğru genişletmiştir. 1934'e gelindiğinde bu alana taşınan çeşitli gruplar, birleşik Shoshone-Paiute Kabileleri olarak federal düzeyde resmî tanınırlık kazanmıştır."


##########################################################################################

    key[]: "tb_id2"
	val[]: "The Magic Valley"

	key[]: "tb_id2_desc"
	val[]: "1900'lerin başlarında I.B. Perrine, Milner Barajı'nı inşa ederek Idaho'nun kurak çölünü tarım arazilerine dönüştürmüştür. 1905'te tamamlanan baraj, Snake Nehri'nin sularını kullanarak araziyi “sihirli” bir şekilde dönüştürmüştür. Bu gelişme Magic Valley'nin oluşmasını sağlamış ve günümüzde hâlâ varlığını sürdüren tarım kasabalarının ortaya çıkmasını sağlamıştır."

	key[]: "id_cut_perrine_desc"
	val[]: "212 fit ile Niagara Şelaleleri'nden daha yüksek olan Shoshone Şelaleleri, Twin Falls'ın hemen kıyısında yer alan güzel bir Snake Nehri simgesi olmuştur."

	key[]: "id_cut_galena_desc"
	val[]: "1879'da kurşun-gümüş keşfinin ardından kurulan bu maden kasabası, fiyatların düşmesiyle 1890'larda önemini yitirmiştir. Günümüzde bölge, tarihi Galena Lodge'a ve yakındaki manzaralı Galena Summit'e ev sahipliği yapan önemli bir rekreasyon merkezi olarak varlığını sürdürmektedir."

	key[]: "poi_id2_01"
	val[]: "Bison Jump"

	key[]: "poi_id2_01_desc"
	val[]: "Challis'te bulunan Bison Jump, Yerli halkların bizonları avlamak amacıyla uçurumlardan aşağı sürüklediği tarihî bir alan olmuştur. 2.000 yılı aşkın süre boyunca kullanılan bu stratejik arazi, kadim toplu avlanma geleneklerine bir bakış sunmaktadır."
	
	key[]: "poi_id2_02"
	val[]: "Grand View Canyon"

	key[]: "poi_id2_02_desc"
	val[]: "US-93 üzerindeki Peaks to Craters Scenic Byway boyunca yer alan Grand View Canyon, Lost River Range'in etkileyici manzaralarını sunmaktadır. Bu sıra dağ, Idaho'nun en yüksek dokuz zirvesine ev sahipliği yapmakta ve kanyonu bu manzaralı güzergâhın öne çıkan noktalarından biri hâline getirmektedir."

	key[]: "landmark_id_mackay_rs_desc"
	val[]: "Aslen kürk avcısı Thyery Goddin'in adını taşıyan ve Goddin'in Nehri olarak adlandırılan Big Lost Nehri, lav yataklarının içinde kaybolmasıyla ünlüdür. Bu “kayıp” su, yer altında ilerleyerek sonunda Snake Nehri yakınlarındaki görkemli Thousand Springs'te yeniden yüzeye çıkmaktadır."

    key[]: "poi_id2_03"
	val[]: "Mackay Hayalet Kasabaları"

	key[]: "poi_id2_03_desc"
	val[]: "White Knob Madencilik Bölgesi'ndeki “Mine Hill” çevresinde kurulan White Knob ve Cliff Creek gibi kasabalar, 20. yüzyılın ortalarına kadar bakır, altın ve gümüş madenciliği patlamasına öncülük etmiştir. Bu yerleşimler, Idaho'nun tarihî madencilik endüstrisinin günümüze ulaşan önemli kalıntıları olmaya devam etmektedir."

	key[]: "id_cut_craters_desc"
	val[]: "15.000 yıl önceki volkanik püskürmelerle oluşan Craters of the Moon, geniş lav akıntılarından ve cüruf konilerinden oluşan bir manzaraya sahiptir. Dünya dışı bir görünüm sunan bu eşsiz arazi, NASA astronotlarının bir dönem Ay görevlerine hazırlanmak için burada eğitim yapmasını sağlamıştır."



##########################################################################################

#@}



#+ Montana TBs and POIs localization.
#@{

    key[]: "tb_mt1"
	val[]: "Buzul Geçidi"

	key[]: "tb_mt1_desc"
	val[]: "Glacier Country, Rocky Mountains'ta kalan son aktif buzullardan bazılarına ev sahipliği yapmaktadır. Binlerce yıl boyunca bu kadim buz kütleleri; derin vadiler, sivri zirveler ve berrak göller oyarak günümüzde Montana'nın batısını tanımlayan manzarayı şekillendirmiştir."

	key[]: "poi_mt1_01"
	val[]: "Kootenai Şelaleleri"

	key[]: "poi_mt1_01_desc"
	val[]: "Kootenai Şelaleleri, Montana'daki en büyük barajsız şelale ve bölgenin önemli turistik noktalarından biri olmuştur. Kootenai Nehri, kısa bir mesafede yaklaşık 300 fit alçalarak unutulmaz manzaralarıyla ziyaretçileri kendine çeken güçlü ve etkileyici bir çağlayan oluşturmuştur."

	key[]: "poi_mt1_02"
	val[]: "Berne Roadside Park"

	key[]: "poi_mt1_02_desc"
	val[]: "Bad Rock Canyon, Flathead Nehri boyunca seyahat edenler için balıkçılığı, manzaraları ve aşırı ısınan araç radyatörlerini soğutmak için kullanılan doğal kaynağıyla tanınan popüler bir durak olmuştur. 1956'da Montana'nın ilk dinlenme alanlarından biri hâline gelmiş ve Berne Roadside Park adını almıştır."

	key[]: "poi_mt1_03"
	val[]: "Heavens Peak"

	key[]: "poi_mt1_03_desc"
	val[]: "Heavens Peak, Glacier Ulusal Parkı'nın en meşhur dağlarından biri olup adını 1890'larda maden arayıcısı Louie Meyer'den almıştır. Güzelliğinden ve yükselen Garden Wall'dan etkilenen kâşifler, burayı yolculukları boyunca karşılaştıkları hiçbir yere benzemeyen bir yer olarak görmüştür."

	key[]: "mt_cut_glacier_national_park_desc"
	val[]: "“Kıtanın Tacı” olarak anılan Glacier Ulusal Parkı, 1910'da kurulmuştur. Kadim buzullar tarafından şekillendirilen parka, günümüzde tarihi bir mühendislik harikası olan Going-to-the-Sun Road'un 1932'de tamamlanmasıyla daha geniş erişim sağlanmıştır."

	key[]: "poi_mt1_04"
	val[]: "Blackfeet Indian Memorial"

	key[]: "poi_mt1_04_desc"
	val[]: "Glacier Ulusal Parkı'nın doğu sınırında Blackfeet Nation bulunmaktadır. “Ovaların savaşçıları” olarak bilinen Blackfeet adının, külle karartılmış mokasenlerden geldiğine inanılmaktadır. Günümüzde park içerisindeki bazı alanlar kabile için hâlâ kutsal kabul edilmektedir."

	key[]: "mt_cut_flathead_lake_desc"
	val[]: "Flathead Gölü, Amerika Birleşik Devletleri'nde yüzölçümü bakımından en büyük doğal tatlı su gölüdür. Çevredeki dağlardan gelen kar sularıyla beslenen gölün son derece berrak suyu birkaç yılda bir tamamen yenilenmekte ve bu durum, gölü dünyanın en temiz büyük göllerinden biri hâline getirmektedir."

	key[]: "mt_cut_thompson_falls_desc"
	val[]: "Adını Britanyalı-Kanadalı kürk tüccarı ve haritacı David Thompson'dan alan kasaba, 1881'de demiryolunun ulaşmasıyla gelişmiştir. Yakındaki Coeur d’Alene altına hücum döneminde, Murray Trail boyunca ilerleyen madenciler için önemli bir durak hâline gelmesiyle daha da büyümüştür."

	key[]: "landmark_mt_missoula_desc"
	val[]: "A. J. Gibson tarafından tasarlanan ve 1910'da kumtaşından inşa edilen Neoklasik Missoula County Adliyesi, daha önceki ve daha küçük bir yapının yerini almıştır. 1860'ta kurulan Missoula County, Bitterroot'tan Rocky Mountains'a kadar uzanan Montana'nın en eski siyasi bölgelerinden biridir."

    key[]: "poi_mt1_05"
	val[]: "Lolo Creek"

	key[]: "poi_mt1_05_desc"
	val[]: "Lolo ile Lolo Pass arasındaki koridor, Lolo Creek boyunca uzanan tarihî bir güzergâhı takip etmektedir. Bir zamanlar Nez Perce halkı, ilk yerleşimciler ve Lewis and Clark Expedition tarafından kullanılan bu güzergâh, günümüzde de bilgilendirici alanlarla öne çıkan önemli bir kültürel ve tarihî manzara olmayı sürdürmektedir."

##########################################################################################

    key[]: "tb_mt2"
	val[]: "Büyük Ovalar"

	key[]: "tb_mt2_desc"
	val[]: "Montana'nın Büyük Ovalar'ı, eyaletin doğu kesimi boyunca uzanmaktadır ve geniş otlakları, inişli çıkışlı bozkırları ve uçsuz bucaksız gökyüzüyle karakterize yapıdadır. Bölgeden Kuzey Amerika'nın en önemli dinozor fosillerinden bazıları çıkarılmış ve milyonlarca yıl önce var olmuş bir manzaraya dair bakış sunulmuştur."

	key[]: "poi_mt2_01"
	val[]: "Hell Creek Formasyonu"

	key[]: "poi_mt2_01_desc"
	val[]: "Jordan, Montana yakınlarındaki Hell Creek çevresinde yer alan Hell Creek Formasyonu, nehirlerden, ormanlardan ve bataklıklardan oluşan kadim subtropikal bir manzaraya ev sahipliği yapar. 67–66 milyon yıl öncesine dayanan bu oluşum, meşhur Tyrannosaurus rex de dâhil olmak üzere zengin dinozor fosilleriyle dünya çapında tanınmaktadır."

	key[]: "poi_mt2_02"
	val[]: "Yellowstone Nehri"

	key[]: "poi_mt2_02_desc"
	val[]: "Yellowstone Nehri, Amerika Birleşik Devletleri'ndeki en uzun serbest akan nehirdir. Yellowstone Ulusal Parkı'ndan doğan nehir, Missouri Nehri'ne katılmadan önce Wyoming ve Montana boyunca 676 mil yol katetmekte ve uzunluğu boyunca tek bir baraj olmadan akmaktadır."

	key[]: "poi_mt2_03"
	val[]: "Glendisaurus"

	key[]: "poi_mt2_03_desc"
	val[]: "Glendisaurus, Glendive'de bulunan gerçek boyutlu bir Triceratops heykelidir ve bölgenin zengin dinozor mirasını kutlamaktadır. Yaklaşık 10 fit yüksekliğinde olan heykel, Dinosaur Trail boyunca popüler bir simge olarak işlev görmektedir."
	
	key[]: "poi_mt2_04"
	val[]: "Missouri Nehri"

	key[]: "poi_mt2_04_desc"
	val[]: "“Büyük Çamurlu” olarak bilinen Missouri Nehri, Amerika Birleşik Devletleri'ndeki en uzun nehirdir. Montana'daki Rocky Mountains'tan Mississippi Nehri'ne kadar 2.341 mil boyunca akan nehir, keşifte, ticarette ve Amerika'nın batıya doğru sınırlarının genişlemesinde hayati bir rol oynamıştır."

	key[]: "mt_cut_fort_peck_spillway_desc"
	val[]: "Büyük Buhran döneminde inşa edilen Fort Peck Barajı, dünyanın en büyük hidrolik dolgulu toprak barajıdır. Amerika'nın en büyük kamu işleri projelerinden biri olarak tamamlanmış ve istihdam sağlamak, selleri kontrol altına almak ve hidroelektrik enerji üretmek üzere tasarlanmıştır."

    key[]: "poi_mt2_05"
	val[]: "Valley County Öncü Müzesi"

	key[]: "poi_mt2_05_desc"
	val[]: "Bu müze; Assiniboine halkı, demiryolları, tarım, Fort Peck Barajı ve Lewis and Clark Keşif Gezisi üzerine sergiler aracılığıyla Montana'nın kuzeydoğusunun tarihini sergilemektedir. Ayrıca kapsamlı arşivlere ve ülkedeki en büyük Assiniboine koleksiyonlarından birine ev sahipliği yapmaktadır."

	key[]: "poi_mt2_06"
	val[]: "Sleeping Buffalo Rock"

	key[]: "poi_mt2_06_desc"
	val[]: "Bu büyük buzul kayaları, yerli kabileler için kutsal simge yapılar olmuştur. Antik buzullar bu kayaları şekillendirmiş ve taşımıştır. Daha küçük olan “Buffalo Rock”, bizona benzeyecek şekilde oyulmuşken daha büyük olan “Medicine Rock” çeşitli petroglifler barındırmaktadır."



##########################################################################################

#@}



#+ Wyoming TBs and POIs localization.
#@{

    key[]: "tb_wy1"
	val[]: "The Buffalo Trail"

	key[]: "tb_wy1_desc"
	val[]: "Yellowstone'a ve Grand Teton'a ev sahipliği yapan bu bölge, gayzerlere ve kaplıcalara güç veren aktif bir volkanik sistem üzerinde yer almaktadır. Buzullar ve faylar ise zirvelerini ve vadilerini şekillendirmiştir. Bu güçler bir araya gelerek Kuzeybatı Wyoming'i Amerika'nın batı bölgesindeki jeolojik açıdan en dinamik ve görsel açıdan en ikonik manzaralardan biri haline getirmiştir."

	key[]: "landmark_wy_yellowsto_desc"
	val[]: "1872'de dünyanın ilk milli parkı olarak kurulmuş olan Yellowstone, devasa bir sönmüş volkanın üzerinde yer almaktadır. Dünyadaki aktif gayzerlerin yaklaşık yarısına ev sahipliği yapan park aynı zamanda dünya üzerindeki en büyük ve en bozulmamış ılıman ekosistemlerden birini korumaktadır."

	key[]: "poi_wy1_01"
	val[]: "Lower Geyser Basin"

	key[]: "poi_wy1_01_desc"
	val[]: "Lower Geyser Basin, Yellowstone'un en büyük gayzer havzasıdır ve yoğun bir gayzer, kaplıca ve buhar bacası topluluğuna sahiptir. Derinlerdeki magmadan gelen ısıyla beslenen bölge, parkın en aktif jeotermal manzaralarından birini sergilemektedir."

	key[]: "poi_wy1_02"
	val[]: "Yellowstone Gölü"

	key[]: "poi_wy1_02_desc"
	val[]: "Yellowstone Gölü, Kuzey Amerika'nın yüksek rakımlı en büyük gölüdür ve kıtanın en büyük yabani gökkuşağı alabalığı popülasyonunu desteklemektedir. Bilim insanları gölün bir zamanlar Pasifik Okyanusu'na doğru aktığına ve balıkların Two Ocean Pass üzerinden Kıtasal Bölünme'yi aşmasına olanak sağladığına inanmaktadır."
	
	key[]: "poi_wy1_03"
	val[]: "Buffalo Bill Barajı"

	key[]: "poi_wy1_03_desc"
	val[]: "1910'da tamamlanan Buffalo Bill Barajı, Amerika Birleşik Devletleri'ndeki ilk beton kemer barajlardan biri olmuştur. 325 fit yüksekliğinde olan baraj o dönemde dünyanın en yüksek barajı olmuş ve erken dönem mühendislik yeniliklerinin simge yapılarından biri haline gelmiştir."

	key[]: "poi_wy1_04"
	val[]: "Colters Hell"

	key[]: "poi_wy1_04_desc"
	val[]: "Colter’s Hell, Shoshone Nehri boyunca uzanan ve adını kaşif John Colter'ın 1807'de verdiği tarihi bir jeotermal alandır. İlk dönem dağ adamları bölgedeki buhar çıkan bacaları ve kükürt kokularını “cehenneme” benzetmiştir. Günümüzde yalnızca kaplıcalar ve buhar bacaları aktif durumdadır."

	key[]: "wy_cut_grand_teton_desc"
	val[]: "Grand Teton Ulusal Parkı, Jackson Hole'un üzerinde keskin bir şekilde yükselen ve buzullar tarafından şekillendirilmiş zirveleriyle tanımlanmaktadır. Kürk avcıları tarafından ovaların ötesinden görülebilmeleri nedeniyle bir zamanlar “Pilot Düğmeleri” olarak adlandırılan dağlar günümüzde Amerika'nın Batı bölgesinin en simgeleşmiş yapıları arasında yer almaktadır."

	key[]: "poi_wy1_05"
	val[]: "Crowheart Butte"

	key[]: "poi_wy1_05_desc"
	val[]: "Crowheart Butte, adını 1866'da Shoshone ve Crow kabileleri arasında gerçekleşen bir savaştan alan bir doğal simge olmuştur. Geleneğe göre Şef Washakie, Shoshone zaferinin ardından bir Crow şefinin kalbini uyarı amacıyla tepenin üzerine koymuş ve bu oluşumun, günümüze kadar gelen adını almasını sağlamıştır."

##########################################################################################

    key[]: "tb_wy2"
	val[]: "Kızıl Çöl"

	key[]: "tb_wy2_desc"
	val[]: "Wyoming'in Kızıl Çöl bölgesi; rüzgârın şekillendirdiği kumları, adaçayı düzlükleri ve çarpıcı kırmızı kaya oluşumlarıyla dikkat çeken geniş bir yüksek çöl havzasıdır. Kuzey Amerika'daki en büyük yerleşimsiz alanlardan biri olan bölge; zorlu iklim koşulları, antik göl yatakları ve uzun göç güzergâhları tarafından şekillendirilmiştir."

	key[]: "poi_wy2_01"
	val[]: "Kırmızı Kanyon"

	key[]: "poi_wy2_01_desc"
	val[]: "Kırmızı Kanyon yaklaşık 60 milyon yıl önce Wind River Range'in yükselmesi sırasında oluşmuştur. Kendine özgü kırmızı kayalıkları, oksitlenmiş demirin kanyona ilham kaynağı canlı rengi kazandırdığı Chugwater kayalarından oluşmuştur."

	key[]: "poi_wy2_02"
	val[]: "Kudret Manzaraları"

	key[]: "poi_wy2_02_desc"
	val[]: "Boar’s Tusk, Wyoming'in Kızıl Çöl bölgesinin 400 fit üzerinde yükselen volkanik bir kaya oluşumu olup milyonlarca yıl önce oluşmuş bir volkanın aşınmış çekirdeğidir. Kuzey Amerika'nın en büyük aktif kumul alanının bir parçası olan geniş Killpecker Kumulları'na hâkim bir konumda bulunmaktadır."

	key[]: "poi_wy2_03"
	val[]: "Rock Springs"

	key[]: "poi_wy2_03_desc"
	val[]: "Rock Springs, kültürel çeşitliliği geniş tarihi nedeniyle “56 Milletin Şehri” olarak bilinmektedir. 1800'lerin sonlarında dünyanın dört bir yanından insanlar Union Pacific kömür madenlerinde çalışmak için buraya gelmiştir. Şehir aynı zamanda ünlü kanun kaçağı Butch Cassidy ile de bağlantılıdır."
	
	key[]: "poi_wy2_04"
	val[]: "Butch Cassidy Kulübesi"

	key[]: "poi_wy2_04_desc"
	val[]: "Butch Cassidy, Vahşi Batı'da tren ve banka soygunlarıyla tanınan “Wild Bunch” adlı çeteye liderlik etmiş ünlü bir Amerikalı kanun kaçağı olmuştur. Rock Springs'te bir kasap dükkânında çalışırken “Butch” lakabını almıştır. En efsanevi ve etkili soygunu ise 1899'daki Wilcox Tren Soygunu olmuştur."

	key[]: "wy_cut_evanston_desc"
	val[]: "1869'da Union Pacific Railroad tarafından kurulan Evanston, adını haritacı James A. Evans'tan almıştır. Şehir bir demiryolu merkezi olarak gelişmiş ve daha sonra tarım, petrol ve doğal gaz alanlarında bölgesel bir merkez hâline gelmiştir."

    key[]: "poi_wy2_05"
	val[]: "Lander Cutoff"

	key[]: "poi_wy2_05_desc"
	val[]: "1857 tarihli Pasifik Vagon Yolu Yasası'nın ardından inşa edilen Lander Cutoff, Amerikan Batı'sında federal hükümet tarafından finanse edilen ilk vagon yollarından biri olmuştur. Adını mühendis Frederick W. Lander'dan alan bu yol, batıya doğru ilerleyen göçmenlere daha kısa bir güzergâh sağlamıştır."

	

##########################################################################################

#@}


#+ South Dakota TBs and POIs localization.
#@{

    key[]: "tb_sd1"
	val[]: "The Black Hills"

	key[]: "tb_sd1_desc"
	val[]: "Güney Dakota'nın batısı, Black Hills ve Badlands bölgeleriyle karakterizedir. Burada geniş çayırlar, çamlarla kaplı dağlara, granit kulelere ve dolaşan bizon sürülerine doğru yükselmektedir. Hemen ötesinde ise engebeli Badlands, milyonlarca yıl boyunca rüzgâr ve su tarafından şekillendirilmiş çarpıcı bir manzara sunmaktadır."

	key[]: "poi_sd1_01"
	val[]: "Black Hills Ulusal Ormanı"

	key[]: "poi_sd1_01_desc"
	val[]: "Lakotalar tarafından “Siyah Tepeler” anlamına gelen Paha Sapa olarak bilinen bu çamlarla kaplı bölge, 7.244 fit yüksekliğiyle Güney Dakota'nın en yüksek noktası olan Black Elk Peak'e ev sahipliği yapmaktadır. Ünlü Lakota şifacısının onuruna yeniden adlandırılan bu zirve, aynı zamanda Rocky Mountains'ın doğusundaki en yüksek zirvedir."

	key[]: "sd_cut_rush_desc"
	val[]: "Amerika'nın “Demokrasi Mabedi” olarak bilinen Mount Rushmore, 1927 ile 1941 yılları arasında Black Hills'e oyulmuştur. Anıt, ülkenin kuruluşunu, büyümesini, gelişimini ve korunmasını temsil eden başkanlar Washington, Jefferson, Roosevelt ve Lincoln'ın 60 fit yüksekliğindeki heykellerine ev sahipliği yapmaktadır."

	key[]: "poi_sd1_02"
	val[]: "Beaver Creek Köprüsü"

	key[]: "poi_sd1_02_desc"
	val[]: "1929'da inşa edilen ve 225 fit uzunluğundaki bu çelik ve beton kemer köprü, Wind Cave Ulusal Parkı yakınlarında bir kanyonun üzerinden geçer. Kanyon tabanından 115 fit yüksekteki köprü, Güney Dakota'da türünün tek örneğidir ve çevredeki kayalıklarla kusursuz bir uyum sağlayacak şekilde tasarlanmıştır."

	key[]: "sd_cut_sturgis_desc"
	val[]: "Sturgis, dünyanın en büyük motosiklet rallisine ev sahipliği yapmasıyla tanınır. Yerel Indian bayisi Pappy Hoel tarafından 1938'de başlatılan ve yılda bir kez düzenlenen bu 10 günlük etkinlikte motosiklet gösterileri, yarışlar, müzik ve kutlamalar için dünyanın dört bir yanından motosikletçiler Black Hills'e gelmektedir."

	key[]: "sd_cut_deadwood_desc"
	val[]: "Deadwood, 1876'daki Black Hills altına hücumu sırasında gelişerek Vahşi Batı'nın en kötü şöhretli kasabalarından biri hâline gelmiştir. 1961'de Ulusal Tarihî Alan ilan edilen Deadwood, bu statüye sahip tek Amerikan şehridir ve tarihî şehir merkezinin büyük bölümünü korunmaktadır."

	key[]: "sd_cut_badlands_desc"
	val[]: "Badlands Ulusal Parkı, ülkenin koruma altındaki en büyük karma çayır alanının yanı sıra 244.000 dönümlük bir alana yayılan tepelerden, sivri kayalardan ve çıkıntılardan oluşur. Aynı zamanda dünyanın en zengin fosil yataklarından birine ev sahipliği yaparak bir zamanlar Büyük Ovalar'da dolaşan antik memeliler hakkında önemli bilgiler sunar."

	key[]: "poi_sd1_03"
	val[]: "Doane Robinson Tüneli"

	key[]: "poi_sd1_03_desc"
	val[]: "“Mount Rushmore'un Babası” olarak bilinen Doane Robinson, ziyaretçileri Güney Dakota'ya çekmek amacıyla Black Hills'de görkemli bir anıt yapılmasını planladı. Günümüzde mirası yaşamaya devam ediyor. Mount Rushmore, manzaralı Doane Robinson Tüneli'nden bakıldığında kusursuz bir şekilde çerçeveleniyor."

	key[]: "sd_cut_hot_springs_desc"
	val[]: "Sioux halkı tarafından “sıcak sular” anlamına gelen Minnekahta olarak adlandırılan Hot Springs, şifalı olduğuna inanılan maden suyu kaynaklarının çevresinde 1879'da yerleşime açılmıştır. 1882'de adı değiştirilmiştir ve bir sağlık merkezine dönüşmüştür. Günümüzde tarihî Evans Plunge ile tanınmaya devam etmektedir."

	key[]: "poi_sd1_04"
	val[]: "Mamut Alanı"

	key[]: "poi_sd1_04_desc"
	val[]: "Mamut Alanı, 61 mamutun ortaya çıkarıldığı dünyaca ünlü bir Buzul Çağı fosil kazı alanıdır. 1974'te keşfedilen bu antik obruk, Kuzey Amerika'daki en büyük Columbia mamutu kalıntıları koleksiyonunu barındırırken kazıları günümüzde hâlen sürmektedir."

##########################################################################################

    key[]: "tb_sd2"
	val[]: "Büyük Bölünme"

	key[]: "tb_sd2_desc"
	val[]: "Güney Dakota'nın Missouri Nehri bölgesi, eyaletin merkezî bölünme hattını oluşturur ve bir tarafında geniş ovalar, diğer tarafında ise dalgalı tepeler yer alır. Burası Kızılderili ulusları, kürk tüccarları ve Lewis and Clark için önemli bir güzergâh olmuştır ve daha sonra büyük barajlara, sınır kasabalarına ve zengin bir nehir tarihine ev sahipliği yapmıştır."

	key[]: "poi_sd2_01"
	val[]: "Dört Büyük Göl"

	key[]: "poi_sd2_01_desc"
	val[]: "1940'ların sonlarında Missouri Nehri üzerinde inşa edilen barajlarla oluşturulan Oahe, Sharpe, Francis Case ve Lewis and Clark gölleri, günümüzde Güney Dakota'nın merkezî kesimini yansıtmaktadır. Bu rezervuarlar; tekne gezintisi, balıkçılık ve rekreasyon için birlikte 440 milden fazla kıyı şeridi sunmaktadır."

	key[]: "poi_sd2_02"
	val[]: "Bangor Hayalet Kasabası"

	key[]: "poi_sd2_02_desc"
	val[]: "Bangor bir zamanlar Walworth County'nin ilçe merkeziydi ancak binaları 1899'da yakındaki Selby'ye taşındıktan sonra ilçe bir hayalet kasabaya dönüştü. Günümüzde kasabanın bir zamanlar bulunduğu yeri yalnızca bir anıt temsil ediyor."

	key[]: "landmark_sd_state_capitol_desc"
	val[]: "1880'de kurulan Pierre, Güney Dakota'nın 1889'da Birlik'e katılmasıyla eyaletin başkenti olmuştur. Merkezi konumu ve Missouri Nehri geçişi nedeniyle seçilen şehre, Fransız-Amerikalı kürk tüccarı Pierre Chouteau Jr.ın adı verilmiştir."

	key[]: "sd_cut_corn_desc"
	val[]: "Mitchell'daki Mısır Sarayı, dünyanın tamamen mısırla süslenmiş tek sarayıdır. Her yıl yerel sanatçılar ve çiftçiler; doğal renkli mısır, tahıl ve otlar kullanarak yeni duvar resimleri oluşturmakta ve burayı Güney Dakota'nın en eşsiz simge yapılarından biri hâline getirmektedir."

	key[]: "landmark_sd_largest_pheasant_desc"
	val[]: "Huron, 1959'da inşa edilen, 40 fit yüksekliğinde, fiberglastan ve çelikten yapılmış, Dünyanın En Büyük Sülün Heykeline ev sahipliği yapmaktadır. 22 ton ağırlığındaki heykel, bölgenin Amerika'nın önde gelen sülün avcılığı noktalarından biri olarak uzun süredir sahip olduğu ünü temsil etmektedir."

	key[]: "landmark_sd_dignity_of_earth_and_sky_desc"
	val[]: "Dignity Of Earth & Sky, Chamberlain yakınlarında Missouri Nehri'ne bakan, 50 fit yüksekliğinde, paslanmaz çelikten yapılmış bir heykeldir. Sanatçı Dale Lamphere tarafından yaratılan eser, Lakota ve Dakota halklarının mirasını, dirayetini ve kültürlerini onurlandırmaktadır."

##########################################################################################

#@}
