    key[]: "hint_car_job_title"
    val[]: "გადამზიდავის პირველი სამუშაო"

    key[]: "hint_car_job_text"
    val[]: "შეასრულეთ მიწოდება – მართეთ უსაფრთხოდ, მოუფრთხილდით ტვირთს, მიიტანეთ დროულად. გაითვალისწინეთ, რა არის დამკვეთისთვის უპირატესი, რაც მოქმედებს შეფასებებსა და მიღებულ ჯილდოზე.<br><offset vshift=8>დააჭირეთ $KEY_advmouse$ სამუშაოს სანახავად."


    key[]: "hint_tour_board_title"
    val[]: "მოგზაურის დაფა"

    key[]: "hint_tour_board_text"
    val[]: "მოგზაურის დაფა ახლოსაა. აამოქმედეთ, რომ გახსნათ შიგთავსი და იხილოთ <color value=@@clr_sel@@>@@tourist_atlas_link@@</color> რომელიც გაგიძღვებათ ახლომდებარე ღირსშესანიშნაობებისა და მოსანახულებელი ადგილების გასაცნობად."


    key[]: "hint_tb_first_title"
    val[]: "პირველი ადგილი მონახულებულია"

    key[]: "hint_tb_first_text"
    val[]: "წარმატებით მოინახულეთ პირველი მდებარეობა ადგილობრივი მოგზაურის დაფიდან. მისი მონაცემებისთვის შეგიძლიათ იხილოთ <color value=@@clr_sel@@>@@tourist_atlas_link@@</color>. მოინახულეთ ყველა ადგილი მათ უკეთ გასაცნობად და ჯილდოების მოსაპოვებლად."


    key[]: "hint_tb_bef_compl_title"
    val[]: "ერთი მდებარეობაა დარჩენილი"

    key[]: "hint_tb_bef_compl_text"
    val[]: "მხოლოდ ერთი ადგილიღაა დარჩენილი თქვენი პირველი ადგილობრივი სამოგზაურო დაფის სრულად მონახულებისთვის და ღია ბარათის მოსაპოვებლად."


    key[]: "hint_tb_done_title"
    val[]: "მოგზაურის დაფა მონახულებულია"

    key[]: "hint_tb_done_text"
    val[]: "წარმატებით მოინახულეთ ყველა წერტილი ადგილობრივ მოგზაურის დაფაზე. მათი მონაცემებისთვის შეგიძლიათ იხილოთ <color value=@@clr_sel@@>@@tourist_atlas_link@@</color>. ჯილდოთ კი შეგიძლიათ გამოაჩინოთ ღია ბარათი თქვენს მანქანაზე."


    key[]: "hint_vehicle_prio_title"
    val[]: "დამკვეთისთვის უპირატესია – მანქანის მდგომარეობა"

    key[]: "hint_vehicle_prio_text"
    val[]: "დამკვეთმა მიუთითა, რომ მისთვის უპირატესია მანქანის წესრიგში ყოფნა – თქვენი ჯილდო და ჯარიმა მეტწილად დამოკიდებული იქნება მანქანის მდგომარეობაზე მისვლისას. მართეთ უსაფრთხოდ და მოუფრთხილდით მანქანას.<br><offset vshift=8>დააჭირეთ $KEY_advmouse$ სამუშაოს სანახავად."


    key[]: "hint_cargo_prio_title"
    val[]: "დამკვეთისთვის უპირატესია – ტვირთთან მოპყრობა"

    key[]: "hint_cargo_prio_text"
    val[]: "დამკვეთმა მიუთითა, რომ მისთვის უპირატესია ტვირთთან სათანადო მოპყრობა – თქვენი ჯილდო და ჯარიმა მეტწილად დამოკიდებული იქნება ბარგის მდგომარეობაზე მისვლისას. მართეთ უსაფრთხოდ და მოუფრთხილდით ტვირთს.<br><offset vshift=8>დააჭირეთ $KEY_advmouse$ სამუშაოს სანახავად."


    key[]: "hint_time_prio_title"
    val[]: "დამკვეთისთვის უპირატესია – დროულად მიწოდება"

    key[]: "hint_time_prio_text"
    val[]: "დამკვეთმა მიუთითა, რომ მისთვის უპირატესია სამუშაოს დროულად შესრულება – თქვენი ჯილდო და ჯარიმა მეტწილად დამოკიდებული იქნება დანიშნულ დროს მისვლაზე. მართეთ უსაფრთხოდ და მიდით დროულად.<br><offset vshift=8>დააჭირეთ $KEY_advmouse$ სამუშაოს სანახავად."


    key[]: "hint_car_deliv_title"
    val[]: "დანიშნულების ადგილას მისვლა"

    key[]: "hint_car_deliv_text"
    val[]: "გააჩერეთ მონიშნულ ადგილას მიწოდების დასასრულებლად.<br>დაიხსომეთ, რომ დამკვეთი ელის მითითებულ დროს მიწოდებას."


    key[]: "hint_car_early_title"
	val[]: "ნაადრევი მიტანა"

    key[]: "hint_car_early_text"
    val[]: "მიწოდებას ელოდებიან განსაზღვრულ დროს და ნაადრევად მიტანა გამოიწვევს მომხმარებლის უკმაყოფილებას. დაგეგმეთ გადაზიდვა სათანადოდ და გამოიყენეთ მოსასვენებელი ადგილები, თუ საჭიროა."


