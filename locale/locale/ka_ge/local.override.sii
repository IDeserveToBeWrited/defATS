	key[]: "music_player_hint"
	val[]: "განათავსეთ სასურველი მუსიკა საქაღალდეში <color value=@@clr_sel@@>Documents <color value=@@clr_txt@@>/<color value=@@clr_sel@@>American Truck Simulator/music <color value=@@clr_txt@@> და აქ გამოჩნდება."

#+ Tooltip shown when hovering over the radio_stream button.

	key[]: "radio_hint"
	val[]: "ჩაასწორეთ <color value=@@clr_sel@@>live_streams.sii <color value=@@clr_txt@@>ფაილი საქაღალდეში <color value=@@clr_sel@@>American Truck Simulator <color value=@@clr_txt@@>/<color value=@@clr_sel@@>Documents <color value=@@clr_txt@@> და მოუსმინეთ საყვარელ რადიოს თამაშში!"

#+ Hint shown if no online radio streams are defined.

	key[]: "empty_radio_hint"
	val[]: "გთხოვთ, წაიკითხოთ ფაილში <color value=@@clr_sel@@>readme.rtf<color value=@@clr_txt@@>, მისამართზე <color value=@@clr_sel@@>Documents / American Truck Simulator <color value=@@clr_txt@@>, თუ როგორ ხდება საკუთარი მუსიკის ან რადიოსადგურების დამატება."
#@}

