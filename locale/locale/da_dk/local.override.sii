#+ System error message - the game will close gracefully with this msg if graphics cannot start - keep the '\n' intact!
#@{

	key[]: "sys_no_graphics"
	val[]: "American Truck Simulator er stødt på et problem. Spillet kunne ikke finde en gyldig grafikenhed på din computer.\nForeslåede løsningstrin:\n1. Tjek om din computer og dit grafikkort lever op til spillets minimumskrav.\n2. Opdatér din udgave af Microsoft DirectX til den nyeste version.\n3. Hent og indstallér de nyeste drivere til dit grafikkort fra udbyderens hjemmeside - en eller flere af dine gamle drivere er måske forældede.\n4. Prøv at skifte visningsmetode fra OpenGL til DirectX eller omvendt.\n5. Slet spillets konfigurationsfil 'config.cfg', der ligger under 'Dokumenter' i mappen 'American Truck Simulator'. Den kan muligvis være beskadiget.\nFilen vil automatisk gendanne sig selv med korrekte standardværdier næste gang, du starter spillet."

	key[]: "sys_no_graphics_simple"
	val[]: "American Truck Simulator har problemer med at rendere grafikken på din computer (Intet gyldigt grafikkort fundet)."
#@}

#+ Activation screen
