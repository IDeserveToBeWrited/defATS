#+ Text deviations for American Truck Simulator. Please, use only terms appropriate for USA (i.e. culture specific nuances, not American English).
#@{

#+ Music/radio player
#@{

#+ Hint shown if no music files are found. Also shown as tooltip when hovering over music_player button.

	key[]: "music_player_hint"
	val[]: "Kopier din musik til mappen <color value=@@clr_sel@@>American Truck Simulator/music <color value=@@clr_txt@@>i dine <color value=@@clr_sel@@>Dokumenter <color value=@@clr_txt@@>og du kan se den her."

#+ Tooltip shown when hovering over the radio_stream button.

	key[]: "radio_hint"
	val[]: "Rediger <color value=@@clr_sel@@>live_streams.sii <color value=@@clr_txt@@>i <color value=@@clr_sel@@>American Truck Simulator<color value=@@clr_txt@@>-mappen i dine <color value=@@clr_sel@@>Dokumenter <color value=@@clr_txt@@>og lyt til din foretrukne online radiokanal, mens du spiller!"

#+ Hint shown if no online radio streams are defined.

	key[]: "empty_radio_hint"
	val[]: "Se venligst <color value=@@clr_sel@@>readme.rtf <color value=@@clr_txt@@> i <color value=@@clr_sel@@>American Truck Simulator<color value=@@clr_txt@@>-mappen i dine <color value=@@clr_sel@@>Dokumenter <color value=@@clr_txt@@> for hvordan du tilføjer din egen musik og radiostreams."
#@}

