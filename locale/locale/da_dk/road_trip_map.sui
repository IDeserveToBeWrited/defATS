#+ Washington TBs and POIs localization.
#@{
	key[]: "tb_wa1"
	val[]: "Den olympiske Halvø"

	key[]: "tb_wa1_desc"
	val[]: "Den olympiske Halvø er et sted, hvor hav, skov og bjerge danner en scene af evigt skiftende skønhed. Tåge driver over stenede kyster, og hvide vandfald tumler fra højdedragene, hvor skjulte dale våger over små historiske landsbyer."

	key[]: "poi_wa1_01"
	val[]: "Historisk amerikansk postkontor"

	key[]: "poi_wa1_01_desc"
	val[]: "Bygningen, der blev færdiggjort i 1893 på en skrænt over Port Townsends havnefront, blev designet som et føderalt anlæg med en toldbod, hvilket afspejlede byens tidlige ambitioner som et fremvoksende knudepunkt for international handel."

	key[]: "poi_wa1_02"
	val[]: "Port Angeles"

	key[]: "poi_wa1_02_desc"
	val[]: "Port Angeles er en kystby, der blev grundlagt i det 19. århundrede som havn og forsyningspunkt. I dag fungerer den som en vigtig port til Olympic National Park og som færgehavn, der forbinder USA og Canada."

	key[]: "poi_wa1_03"
	val[]: "Lake Crescent"

	key[]: "poi_wa1_03_desc"
	val[]: "Lake Crescent, Washingtons næstdybeste sø, er kendt for sit klare blå, krystalklare vand, som er et resultat af lave kvælstofniveauer. Beliggende i et populært rekreativt område, er søen omgivet af stier og gammel skov."
	
	key[]: "poi_wa1_04"
	val[]: "Kalaloch Beach"

	key[]: "poi_wa1_04_desc"
	val[]: "Kalaloch Beach er kendt for \"Tree of Life\" eller \"Livets Træ\", en sitkagran med blotlagte rødder, der strækker sig over en lille bæk til kysten. I modsætning til typiske høje graner er træet kortere, tykkere og vindblæst, hvilket gør det til et unikt og populært lokalt vartegn."

	key[]: "poi_wa1_05"
	val[]: "Olympic National Park"

	key[]: "poi_wa1_05_desc"
	val[]: "Olympic National Park beskytter forskellige økosystemer - fra en barsk Stillehavskyst og tempererede regnskove til alpine tinder. Den blev først klassificeret som et nationalt monument i 1909 og blev omdannet til nationalpark af den føderale regering i 1938."

	key[]: "poi_wa1_06"
	val[]: "Greenhead Slough"

	key[]: "poi_wa1_06_desc"
	val[]: "Greenhead Slough er en lille vådområdekanal langs Highway 101 nær Willapa Bay. Den ligger i et kystnært flodmundingshabitat, der er blevet restaureret for at understøtte gydning af laks og observation af de mange vandfugle."

	key[]: "poi_wa1_07"
	val[]: "Dabob Bay"

	key[]: "poi_wa1_07_desc"
	val[]: "Dabob Bay er en dyb fjord, der er hjemsted for laks, skaldyr og dyreliv. Dabob Bay Natural Area, der blev etableret i 1984, beskytter sjældne plantesamfund i saltmarsk og sand i et velfungerende tidevandssystem."


##########################################################################################

	key[]: "tb_wa2"
	val[]: "The Heartland"

	key[]: "tb_wa2_desc"
	val[]: "Washingtons Heartland leder rejsende langs maleriske veje gennem stedsegrønne skove og rolige alpine søer. Mount Rainier dominerer horisonten og tilbyder ikoniske udsigter og en fredelig rejse i de naturlige landskaber ved det nordvestlige Stillehav."

	key[]: "poi_wa2_01"
	val[]: "Mount Rainier"

	key[]: "poi_wa2_01_desc"
	val[]: "Mount Rainier, Washingtons højeste bjergtop med sine 4.392 meter, er en aktiv stratovulkan. Dens gletsjere leder til floder, former dale og opretholder frodige skove og dyreliv, hvilket gør den til et vigtigt naturligt vartegn."

	key[]: "poi_wa2_02"
	val[]: "Wanatchee National Forest"

	key[]: "poi_wa2_02_desc"
	val[]: "Wenatchee National Forest strækker sig over bjerge, floder og alpine dale. I 1933 anlagde Civilian Conservation Corps stier og byggede brandudkigsposter her, hvilket satte et varigt præg på skovens rekreative og bevaringsmæssige historie."

	key[]: "poi_wa2_03"
	val[]: "Mount Baker–Snoqualmie National Forest"

	key[]: "poi_wa2_03_desc"
	val[]: "Mount Baker-Snoqualmie National Forest rummer nogle af de ældste gletsjerovervågningssteder i Amerika, der sporer vulkanske isstrømme og klimaændringer i the Cascades siden begyndelsen af 1900-tallet."
	
	key[]: "poi_wa2_04"
	val[]: "Wenatchee River"

	key[]: "poi_wa2_04_desc"
	val[]: "Langs Wenatchee-floden viser resterne af vandingskanaler og møller fra det tidlige 19. århundrede, hvordan nybyggere udnyttede dens vand. Indfødte stammer var også afhængige af det laksrige vand for mad og handel længe før europæerne ankom og bosatte sig."

	key[]: "poi_wa2_05"
	val[]: "Klawatti Peak"

	key[]: "poi_wa2_05_desc"
	val[]: "Klawatti Peak, der først blev besteget i midten af det 20. århundrede, bliver sjældent besteget på grund af sine stejle, gletsjerdækkede skråninger, som gør den til en lokkende udfordring for de bjergbestigere, der søger isolation i North Cascades."

	key[]: "poi_wa2_06"
	val[]: "Dry Falls Dam"

	key[]: "poi_wa2_06_desc"
	val[]: "Dry Falls-dæmningen er bygget til at kontrollere de lokale vandveje og ligger på forhistoriske basaltklipper. Den kontrollerer de sæsonbestemte vandstrømme og afslører samtidig terrasser og bassiner, der er udskåret af oversvømmelser fra istiden."

	key[]: "poi_wa2_07"
	val[]: "White Mountain Fire Overlook"

	key[]: "poi_wa2_07_desc"
	val[]: "Udsigtspunktet har skilte, der afslører ar og genvækstmønstre i skoven efter White Mountain-branden i 1988, en af Washingtons største skovbrande i nyere historie."

	key[]: "wa_cut_helen_desc"
	val[]: "Før 1980 havde Mount St. Helens en konisk form og blev omtalt som Amerikas Mount Fuji. Udbruddet i 1980 fjernede 400 meter af toppen og dannede et hesteskokrater, der nu delvist er fyldt af en lavakuppel og en gletsjer."


##########################################################################################


	key[]: "tb_wa3"
	val[]: "Wine Country"

	key[]: "tb_wa3_desc"
	val[]: "Øst for Cascades ligger Washingtons vinland, der strækker sig over Columbia Valley. Regionen omfatter Selah Creek, Lewis and Clark State Park og områder, der historisk set har været beboet af oprindelige folk. Områderne er kendetegnet ved tørre, solrige landskaber med bølgende bakker og floddale."

	key[]: "poi_wa3_01"
	val[]: "Clear Creek Falls"

	key[]: "poi_wa3_01_desc"
	val[]: "Udsigtspunktet Clear Creek Falls Overlook er et populært stop lige øst for White Pass Summit. Omkring halvanden kilometer længere mod øst fører afkørslen til Clear Lake Recreation Area, som er kendt for fiskeri og fremragende muligheder for at observere det lokale dyreliv."

	key[]: "poi_wa3_02"
	val[]: "Selah Creek Bridge"

	key[]: "poi_wa3_02_desc"
	val[]: "Fred G. Redmon Bridge, eller Selah Creek Bridge, er en dobbeltbuebro i Yakima County. Da den stod færdig, var den den længste betonbuebro i Amerika og den højeste bilbro i staten."

	key[]: "poi_wa3_03"
	val[]: "Grape Fields"
	
	key[]: "poi_wa3_03_desc"
	val[]: "Washingtons dale og frugtbare jord understøtter mange typer vinstokke, herunder Riesling, Cabernet og Merlot. Vinmarkerne er en vigtig del af statens landbrug og lokale landskaber."

	key[]: "poi_wa3_04"
	val[]: "Ed Hendler Bridge"

	key[]: "poi_wa3_04_desc"
	val[]: "Broen, der blev bygget i 1978 og undertiden kaldes Intercity Bridge, krydser Columbia-floden mellem Pasco og Kennewick i det sydøstlige Washington. Siden åbningen har den været betragtet som et vartegn og symbol på Tri-Cities."

	key[]: "poi_wa3_05"
	val[]: "Lewis and Clark State Park"

	key[]: "poi_wa3_05_desc"
	val[]: "Lewis and Clark State Park, en af Washingtons første statsparker, beskytter gamle skove langs en af de oprindelige folks historiske ruter. Skovene, der er opkaldt efter Corps of Discovery, minder om de tætte skovområder, som Meriwether Lewis beskrev i sine dagbøger."

	key[]: "poi_wa3_06"
	val[]: "Columbia County Courthouse"

	key[]: "poi_wa3_06_desc"
	val[]: "Columbia County Courthouse afspejler en tid, hvor amtsstyret var centralt i det daglige liv. I en periode med hurtig vækst og begrænset kontakt med statens hovedstad fungerede retsbygningerne som den primære kilde til myndighed og dækkede borgernes umiddelbare behov."

	key[]: "poi_wa3_07"
	val[]: "Oprindelige amerikanske stammer"

	key[]: "poi_wa3_07_desc"
	val[]: "Columbia Valley og de omkringliggende områder var hjemsted for oprindelige folk, herunder Yakama-, Walla Walla- og Umatilla-stammerne. I dag lever disse samfund fortsat i regionen, opretholder kulturelle traditioner og forvalter jord- og vandressourcer."

##########################################################################################

#@}




#+ Oregon TBs and POIs localization.
#@{
	key[]: "tb_or1"
	val[]: "Stillehavskysten"

	key[]: "tb_or1_desc"
	val[]: "Oregons stillehavskyst strækker sig gennem barske forbjerge med naturskønne udsigtspunkter. Mens Heceta Head Lighthouse har udsigt over brusende bølger, rejser Silver Point, Ophir Wayside, Sisters Rocks og Kissing Rock sig undervejs med basaltklipper, der møder Stillehavets brænding."

	key[]: "landmark_or_astoria_b_desc"
	val[]: "Denne bro, der strækker sig over Columbia-floden på seks kilometer, forbinder Oregon og Washington og tilbyder udsigt over flodens udmunding og Stillehavets horisont."

	key[]: "poi_or1_01"
	val[]: "Silver Point Interpretive Overlook"

	key[]: "poi_or1_01_desc"
	val[]: "Lige syd for Cannon Beach tilbyder dette udsigtspunkt en storslået udsigt over Haystack Rock og den forrevne kystlinje, en udsigt, som er særligt spektakulær ved solnedgang."

	key[]: "or_cut_lighthouse_desc"
	val[]: "Oregons højeste fyrtårn, bygget i 1873, står på et basaltforbjerg nær Newport."

	key[]: "or_cut_newport_desc"
	val[]: "Yaquina Bay Bridge, der blev færdiggjort i 1936, er et af Oregons mest ikoniske vartegn langs kysten. Dens elegante bue, der er designet af den berømte ingeniør Conde McCullough, spænder over Yaquina Bay og er fortsat et definerende træk ved U.S. Route 101."

	key[]: "or_cut_thor_desc"
	val[]: "Et naturligt jordfaldshul på Cape Perpetua, hvor brusende bølger kollapser og giver illusionen af, at havet er ved at blive drænet væk."

	key[]: "poi_or1_02"
	val[]: "Ophir Wayside"

	key[]: "poi_or1_02_desc"
	val[]: "En stille afkørsel nær Gold Beach, hvor besøgende kan strække benene, se på brændingen eller finde drivtømmer og agater på stranden."

	key[]: "poi_or1_03"
	val[]: "Sisters Rock Overlook"

	key[]: "poi_or1_03_desc"
	val[]: "Dramatiske havsøjler rejser sig fra brændingen med stier, der fører ned til små strande gemt mellem klipperne."

	key[]: "poi_or1_04"
	val[]: "Kissing Rock"

	key[]: "poi_or1_04_desc"
	val[]: "Et stop langs vejen syd for Gold Beach, hvor to massive klippeformationer læner sig sammen over sandet, hvilket gør det til et yndet fotosted."


##########################################################################################

	key[]: "tb_or2"
	val[]: "Det vilde Øst"

	key[]: "tb_or2_desc"
	val[]: "Denne region, ofte kaldet Oregons vilde Øst, afslører landskaber formet af geologiske kræfter over flere hundrede millioner af år, hvoraf mange stadig er aktive i dag. På trods af denne enorme tidsskala er menneskets historie kort, men alligevel præget af øjeblikke lige så dramatiske som landet selv."

	key[]: "landmark_or_deadman_p_desc"
	val[]: "Nær Pendleton tilbyder dette udsigtsområde udsigt over Deadman Pass, opkaldt efter en hændelse i 1870'erne under Bannock-krigen, hvor en vognmand blev fundet død. Årtier tidligere krydsede utallige vogne disse bakker langs Oregon Trail."

	key[]: "or_cut_395_desc"
	val[]: "US-395, engang kendt som Three Flags Highway, strakte sig fra Canada til Mexico og forbandt ørkener, skove og bjerge. I dag ender den ved US-15 i Californien, selvom rester af den oprindelige rute stadig findes nær San Diego."

	key[]: "poi_or2_01"
	val[]: "Malheur National Forest"

	key[]: "poi_or2_01_desc"
	val[]: "Malheur National Forest ligger i Blue Mountains. For mere end 150 millioner år siden udgjorde nogle af de ældste klipper i denne region en del af vulkanske øer i Stillehavet, som senere smeltede sammen med kontinentet."
	
	key[]: "poi_or2_02"
	val[]: "Badlands Wilderness"

	key[]: "poi_or2_02_desc"
	val[]: "Badlands Wilderness, lige øst for Bend, er et barsk vulkansk landskab formet af gamle lavastrømme og vindblæst aske. Dets snoede lavaformationer, sandjord og barske terræn skaber et af statens mest unikke højørkenmiljøer."

	key[]: "poi_or2_03"
	val[]: "Lake Abert"

	key[]: "poi_or2_03_desc"
	val[]: "Lake Abert, der først blev kortlagt i 1843, har haft menneskelig tilstedeværelse i over 10.000 år. Selvom den er for salt til fisk, er den stadig et vigtigt stoppested for fugle langs Pacific Flyway. På grund af klimaændringer er den gennem de seneste årtier skrumpet ind."

	key[]: "poi_or2_04"
	val[]: "East Steens Tour Route"

	key[]: "poi_or2_04_desc"
	val[]: "East Steens Tour-ruten følger Highway 78 langs Steens Mountain og Alvord-ørkenen. Højdepunktet er Alvord-ørkenens playa, en af Oregons største tørre sølejer, der skifter sæsonmæssigt mellem en lavvandet sø og en vidtstrakt ørkenslette."

	key[]: "poi_or2_05"
	val[]: "Doherty Slide"

	key[]: "poi_or2_05_desc"
	val[]: "Det tager mindre end en time at køre langs Doherty Slide, en klippeformation, der er født af vulkansk aktivitet. Alligevel tog det naturen omkring 16 millioner år at forme landskabet, som det ser ud i dag."


##########################################################################################

	key[]: "tb_or3"
	val[]: "The Ogden State"

	key[]: "tb_or3_desc"
	val[]: "Denne rute følger Oregons indre nord-sydlige korridor, forbi skove og høj ørken. Den blev først udforsket af pelshandleren Peter Skene Ogden i 1820'erne og fik senere strategisk betydning under Anden Verdenskrig for sine tømmer- og transportruter."
	
	key[]: "poi_or3_01"
	val[]: "Springfield Flame"

	key[]: "poi_or3_01_desc"
	val[]: "Med en højde på næsten 20 meter markerer skulpturen Springfields nordlige port, designet som en flamme, der skal tjene som et fyrtårn for rejsende og et vartegn for både beboere og besøgende."

	key[]: "poi_or3_02"
	val[]: "Santiam Wagon Road"

	key[]: "poi_or3_02_desc"
	val[]: "Passet øst herfor, engang kaldet Wiley Pass efter Andrew Wiley, blev udforsket i 1859 af pionerer, der søgte græsningsruter. En militærvej blev planlagt i 1864, men forblev hovedsageligt uanlagt. En betalingsvej, Santiam Wagon Road, var i drift fra 1868 til 1914."

	key[]: "poi_or3_03"
	val[]: "Veteran Historic Highway"

	key[]: "poi_or3_03_desc"
	val[]: "Ved motorvejens nordlige indgang blev de sidste to af 18 hyldestskilte installeret den 9. november 2012 syd for Biggs Junction. De markerer Camp Rufus som det nordlige indgangspunkt til landets første motorvej dedikeret til veteraner fra Anden Verdenskrig."

	key[]: "poi_or3_04"
	val[]: "Ogden State Scenic Viewpoint"

	key[]: "poi_or3_04_desc"
	val[]: "Vejkanten, der er opkaldt efter Peter Skene Ogden, en opdagelsesrejsende fra begyndelsen af det 19. århundrede og Hudson's Bay Companys hovedhandler, hylder hans ekspeditioner på tværs af Snake River-landet og hans rolle som en af de første til at udforske Great Salt Lake Basin."

	key[]: "landmark_or_fremont_b_desc"
	val[]: "Broen og Portlands Fremont Street er opkaldt efter John C. Frémont, en tidlig opdagelsesrejsende af Las Californias og Oregon Country. Den har Oregons længste hovedspænd og er verdens næstlængste bro med bundbuer."

	
##########################################################################################

#@}



#+ California TBs and POIs localization.
#@{
	key[]: "tb_ca1"
	val[]: "The Golden Horizon"

	key[]: "tb_ca1_desc"
	val[]: "Ikoniske broer rejser sig over det glitrende vand og forbinder Alcatraz, Santa Cruz og regionens bakker og kvarterer. Fra travle gader og historiske steder til solbeskinnede strande og naturskønne kystlinjer tilbyder Bay Area en uforlignelig californisk oplevelse."

	key[]: "ca_cut_golden_gate_bridge_desc"
	val[]: "Broen, der forbinder San Francisco-bugten med Stillehavet, er et ikonisk symbol på San Francisco og Californien. Da den åbnede i 1937, havde den rekorderne for både verdens længste og højeste hængebro."

	key[]: "poi_ca1_01"
	val[]: "Alcatraz"

	key[]: "poi_ca1_01_desc"
	val[]: "Alcatraz Island var hjemsted for et føderalt fængsel fra 1934 til 1963. Det er kendt for at huse nogle af landets mest berygtede kriminelle og er nu et historisk sted og en populær turistdestination."

	key[]: "ca_cut_richmond_desc"
	val[]: "Richmond-San Rafael-broen spænder over San Francisco-bugten og forbinder Richmond og San Rafael. Den åbnede i 1956 og transporterer trafik over den nordlige bugt. Den har en udkragnings- og gitterkonstruktion og fungerer som en vigtig regional transportforbindelse."
	
	key[]: "poi_ca1_02"
	val[]: "Treasure Island"

	key[]: "poi_ca1_02_desc"
	val[]: "Treasure Island er en menneskeskabt ø, der blev bygget til Golden Gate International Exposition i 1939. Efter at have tjent som flådebase bliver den nu ombygget til bolig- og erhvervsmæssig brug."

	key[]: "poi_ca1_03"
	val[]: "Surfing City"

	key[]: "poi_ca1_03_desc"
	val[]: "Surfingstatuen i Santa Cruz hylder byens surfarv og -kultur. Den er installeret nær stranden og hylder lokale surfere og sporten, der har formet Santa Cruz' identitet og kystsamfund."

	key[]: "poi_ca1_04"
	val[]: "Madonna Inn"

	key[]: "poi_ca1_04_desc"
	val[]: "En tidligere populær restaurant og vartegn for begivenheder øverst på Highway 152. Selv om den har været lukket siden 2004 på grund af motorvejsproblemer, er den stadig et hyppigt emne i lokalhistorie og spøgelseshistoriefora."



##########################################################################################

	key[]: "tb_ca2"
	val[]: "The Shasta Route"

	key[]: "tb_ca2_desc"
	val[]: "Shasta-ruten snor sig gennem fyrreskove og glitrende alpine søer ved Mount Shasta. Veje stiger og falder gennem skjulte dale og fører rejsende sydpå, mens bjergene gradvist viger og giver plads til de gamle redwood-træer i det nordlige Californien."

	key[]: "poi_ca2_01"
	val[]: "Shasta - Trinity National Forest"

	key[]: "poi_ca2_01_desc"
	val[]: "Shasta-Trinity National Forest, Californiens største nationalskov, gennemløbes af Trinity Heritage Scenic Byway. Den følger ruter, der blev brugt af guldgravere og nybyggere i det 19. århundrede."

	key[]: "poi_ca2_02"
	val[]: "Big Lagoon"

	key[]: "poi_ca2_02_desc"
	val[]: "Big Lagoon er den største og sydligste af de tre laguner i Humboldt Lagoons State Park. Disse lavvandede kystbassiner ligger mellem klippefyldte forbjerge, hvor havbølger har bygget sandede barrierer, der adskiller lagunerne fra Stillehavet."

	key[]: "or_cut_sequoia_desc"
	val[]: "Redwood National Park beskytter nogle af verdens højeste og ældste kyst-redwoodtræer, der når over 113 meter og lever i op til 2000 år. Sammen med nærliggende statsparker beskytter den omkring 35 % af planetens resterende gamle redwood-skove."
	
	key[]: "poi_ca2_03"
	val[]: "Smith River"

	key[]: "poi_ca2_03_desc"
	val[]: "Dette beskyttede område, der ligger i Six Rivers National Forest i det nordvestlige Californien, blev udpeget af Kongressen i 1990 for at bevare naturskønne, økologiske og kulturelle værdier. Smith-floden er Californiens eneste større uopdæmmede, fritflydende flod."

	key[]: "poi_ca2_04"
	val[]: "Whiskey Creek Bridge"

	key[]: "poi_ca2_04_desc"
	val[]: "Whiskey Creek-broen, der blev færdiggjort i 1961, er en trespænds svejset pladebjælkekonstruktion. Den er bemærkelsesværdig som et tidligt eksempel på brodesign, der anvender tre forskellige stålkvaliteter, hvilket var en innovativ svejseteknik på det tidspunkt."

	key[]: "poi_ca2_05"
	val[]: "Shasta Lake"

	key[]: "poi_ca2_05_desc"
	val[]: "Shasta Lake, Californiens største reservoir, blev dannet af Shasta-dæmningen ved Sacramento-floden. Den blev færdiggjort i 1945 og giver området vand, vandkraft og et naturskønt sted til rekreation."

	key[]: "poi_ca2_06"
	val[]: "Mount Shasta"

	key[]: "poi_ca2_06_desc"
	val[]: "Fra 1820'erne og fremefter guidede Mount Shasta, den næsthøjeste top i Cascade Range, rejsende langs Siskiyou Trail ved dens fod. Denne rute udviklede sig senere til Interstate 5, som nu fører tusindvis til bjerget hvert år."



##########################################################################################

	key[]: "tb_ca3"
	val[]: "The Sierra Crossing"

	key[]: "tb_ca3_desc"
	val[]: "Under tårnhøje Sierra Nevada ligger Inn at Benton mellem åbne dale og bølgende bakker. Sierra Crossing snor sig langs stille, høje ørkenveje, hvor fjerne tinder og barske højderygge skaber et tidløst panorama, der inviterer rejsende til at udforske regionens vidtstrakte landskaber."

	key[]: "ca_cut_olmsted_point_desc"
	val[]: "Yosemite Nationalpark, der blev grundlagt i 1890, er en af de mest besøgte parker. Den er kendt for Yosemite Falls, det højeste vandfald i Nordamerika, omfattende stisystemer og kæmpe sequoiaer, der er over 3.000 år gamle."

	key[]: "poi_ca3_01"
	val[]: "Tioga Road"

	key[]: "poi_ca3_01_desc"
	val[]: "Tioga Road er en ikonisk naturskøn rute, der løber gennem hjertet af Yosemite Nationalpark. Det er det højest beliggende motorvejspas i Californien, der forbinder den vestlige og østlige side af Sierra Nevada."

	key[]: "poi_ca3_02"
	val[]: "Mono Lake"

	key[]: "poi_ca3_02_desc"
	val[]: "Mono-søen er mere end 1 million år gammel, hvilket gør den til en af de ældste søer i Nordamerika. Uden et naturligt udløb har den samlet salte og mineraler, som er blevet ført med vandløb fra det østlige Sierra Nevada over tusinder af år."
	
	key[]: "poi_ca3_03"
	val[]: "Lake Tahoe"

	key[]: "poi_ca3_03_desc"
	val[]: "Lake Tahoe blev dannet for cirka 2 millioner år siden i Tahoe-bassinet, og dens nuværende form er formet af istidens gletsjere. Det er den største alpine sø i Nordamerika og den næstdybeste i USA."

	key[]: "poi_ca3_04"
	val[]: "Eldorado National Forest"

	key[]: "poi_ca3_04_desc"
	val[]: "Eldorado National Forest er en del af et større vandskel, der forsyner millioner af californiere med vand og støtter landbrug, der producerer næsten halvdelen af landets frugter og grøntsager."

	key[]: "poi_ca3_05"
	val[]: "Inn at Benton Hot Springs"

	key[]: "poi_ca3_05_desc"
	val[]: "Benton, en af Mono Countys ældste byer, blev grundlagt af paiute-folket, som benyttede de varme kilder. I 1860'erne blev det et stop for nybyggere og minearbejdere. Kroen, bygget i 1940'erne af lokal pimpsten, erstattede et hotel fra 1904 med 10 værelser, der delte ét badeværelse."



##########################################################################################

	key[]: "tb_ca4"
	val[]: "Sol og sand"

	key[]: "tb_ca4_desc"
	val[]: "Death Valleys ørken strækker sig under endeløse himmelstrøg med klitter, takkede tinder og revnede sletter. Harer hopper langs solbeskinnede sandstrande, kranier markerer tyste passager, og isolerede veje snor sig gennem et barskt, ukueligt landskab, der sætter alle på prøve og forbløffer dem, der begiver sig her."

	key[]: "poi_ca4_01"
	val[]: "Lone Pine"

	key[]: "poi_ca4_01_desc"
	val[]: "Lone Pine er en lille by i Owens Valley i Californien, ved den østlige fod af Sierra Nevada-bjergene. Byen er kendt for de nærliggende Alabama Hills og har længe fungeret som en indgangsport for vandrere, klatrere og filmskabere, der udforsker de omkringliggende bjerge og ørkenlandskaber."

	key[]: "poi_ca4_02"
	val[]: "Death Valley National Park"

	key[]: "poi_ca4_02_desc"
	val[]: "Death Valley er et af Amerikas mest ekstreme landskaber – stedvis det laveste, varmeste, tørreste og højeste. Længe før 1800-tallets pionerer boede indfødte stammer her, hvor de jagede og samlede i denne barske, men historisk rige region."

	key[]: "poi_ca4_03"
	val[]: "Father Crowley Vista Point"

	key[]: "poi_ca4_03_desc"
	val[]: "Dette udsigtspunkt er et populært stop for rejsende. Fader John J. Crowley, the Desert Padre, holdt ofte pause her. Nær parkens vestlige grænse tilbyder det en betagende udsigt over Rainbow Canyon, en farverig formation formet af gammel vulkansk aktivitet."
	
	key[]: "poi_ca4_04"
	val[]: "Mojave Valley Wells"

	key[]: "poi_ca4_04_desc"
	val[]: "Ved Valley Wells i Mojave-bjergene dokumenterer gamle grundvandsaflejringer tidligere vådområder fra istiden. Disse historiske kilder afslører, hvordan grundvandet engang understøttede marsklandskaber og frodig vegetation i en ellers tør ørken."

	key[]: "poi_ca4_05"
	val[]: "The Colorado River Indian Reservation"

	key[]: "poi_ca4_05_desc"
	val[]: "Reservatet strækker sig langs Colorado-floden i Arizona og Californien. Det blev etableret i 1865 for flodens stammer og er hjemsted for Mohave-, Chemehuevi-, Hopi- og Navajo-folkene. I dag understøtter det landbrug og samfundsliv."

##########################################################################################

#@}



#+ Idaho TBs and POIs localization.
#@{

    key[]: "tb_id1"
	val[]: "The Treasure Valley"

	key[]: "tb_id1_desc"
	val[]: "Treasure Valley i det sydvestlige Idaho har en rig historie formet af indianerstammer, tidlige pelshandlere og bosættere langs Oregon Trail. Navnet afspejler områdets ressourcer og muligheder, og det voksede senere med landbrug, jernbaner og regional handel centreret omkring Boise."

	key[]: "poi_id1_01"
	val[]: "Salmon River"

	key[]: "poi_id1_01_desc"
	val[]: "Salmon River i Idaho strækker sig 677 kilometer gennem en dyb, barsk kløft. Den fik øgenavnet \"River of No Return\", fordi tidlige både ikke kunne sejle opstrøms mod de stærke, udfordrende strømme."

	key[]: "poi_id1_02"
	val[]: "Boise National Forest"

	key[]: "poi_id1_02_desc"
	val[]: "Boise National Forest, der spænder over den eroderbare Idaho-batolith, byder på et barskt landskab skabt af vulkansk aktivitet. Denne geologiske arv ses bedst i dens stejle kløfter og de mange naturlige varme kilder, der ligger spredt i terrænet."

	key[]: "poi_id1_03"
	val[]: "Horseshoe Bend"

	key[]: "poi_id1_03_desc"
	val[]: "Efter at der blev fundet guld i Boise Basin i 1862, grundlagde minearbejdere, der overvintrede ved floden, Horseshoe Bend. Byen, oprindeligt kaldet Warrinersville efter en lokal savværksejer, fik sit nuværende navn i 1867, da den blev et vigtigt stop for guldgravere."
	
	key[]: "poi_id1_04"
	val[]: "Vejafgiftspunkt"

	key[]: "poi_id1_04_desc"
	val[]: "I 1864 erstattede en ny kløftrute den stejle Syrup Creek-sti. I 20 år finansierede vejafgifter vedligeholdelsen, mens James A. Porters berømte hotel og mejeri blev et førsteklasses stop for rejsende, der søgte tilflugt."

	key[]: "poi_id1_05"
	val[]: "Castle Rock"

	key[]: "poi_id1_05_desc"
	val[]: "Mod Camas Prairie tjente Castle Rocks granitfremspring som ikoniske vartegn for Oregon Trail-emigranter på Goodale's Cutoff. Disse sjældne formationer, der blev brugt fra 1862 og indtil bilernes æra, tilbød rejsende et slående syn langs ruten."

    key[]: "poi_id1_06"
	val[]: "Duck Valley Indian Reservation"

	key[]: "poi_id1_06_desc"
	val[]: "I 1886 udvidede præsident Cleveland Duck Valley til Idaho via den såkaldte \"Paddy Cap Extension\". I 1934 opnåede de forskellige grupper, der flyttede til reservatet, officiel føderal anerkendelse som de forenede Shoshone-Paiute-stammer."


##########################################################################################

    key[]: "tb_id2"
	val[]: "The Magic Valley"

	key[]: "tb_id2_desc"
	val[]: "I begyndelsen af 1900-tallet forvandlede I.B. Perrine Idahos tørre ørken til landbrugsjord ved at bygge Milner-dæmningen. Dæmningen, der blev færdiggjort i 1905, brugte vand fra Snake River til \"magisk\" at forvandle landskabet. Dette skabte Magic Valley, der førte til de blomstrende landbrugsbyer, der stadig eksisterer i dag."

	key[]: "id_cut_perrine_desc"
	val[]: "Shoshone Falls er 63 meter højere end Niagara Falls og er et smukt vartegn ved Snake River, lige ved kanten af Twin Falls."

	key[]: "id_cut_galena_desc"
	val[]: "Denne mineby, der blev grundlagt i 1879 efter en opdagelse af bly og sølv, forsvandt i 1890'erne i takt med faldende priser. I dag trives området som et rekreativt centrum, hjemsted for den historiske Galena Lodge og det nærliggende, naturskønne Galena Summit."

	key[]: "poi_id2_01"
	val[]: "Bison Jump"

	key[]: "poi_id2_01_desc"
	val[]: "Bison Jump, der ligger ved Challis, er et historisk sted, hvor den oprindelige befolkning drev bøfler over klipperne i forbindelse med jagt. Dette strategisk vigtige landskab, der har været brugt i over 2.000 år, giver et glimt af gamle, fælles jagttraditioner."
	
	key[]: "poi_id2_02"
	val[]: "Grand View Canyon"

	key[]: "poi_id2_02_desc"
	val[]: "Grandview Canyon ligger langs Peaks to Craters Scenic Byway på US-93 og tilbyder en fantastisk udsigt over Lost River Range. Denne bjergkæde er hjemsted for ni af Idahos højeste tinder, hvilket gør kløften til et højdepunkt på den naturskønne rute."

	key[]: "landmark_id_mackay_rs_desc"
	val[]: "Big Lost River, oprindeligt kaldet Goddin’s River efter pelsjægeren Thyery Goddin, er berømt for at synke ned i lavalejer. Dette \"forsvundne\" vand bevæger sig under jorden og dukker til sidst op igen ved de spektakulære Thousand Springs nær Snake River."

    key[]: "poi_id2_03"
	val[]: "Mackays spøgelsesbyer"

	key[]: "poi_id2_03_desc"
	val[]: "Byer som White Knob og Cliff Creek, der ligger på \"Mine Hill\" i White Knob Mining District, gav næring til et boom inden for kobber, guld og sølv frem til midten af det 20. århundrede. Disse steder er fortsat vigtige rester af Idahos historiske minedrift."

	key[]: "id_cut_craters_desc"
	val[]: "Craters of the Moon, der blev dannet af vulkanudbrud for 15.000 år siden, byder på et vidtstrakt landskab af lavastrømme og slaggekegler. Dets fremmede terræn er så unikt, at NASA-astronauter engang brugte det til at træne til månemissioner."



##########################################################################################

#@}



#+ Montana TBs and POIs localization.
#@{

    key[]: "tb_mt1"
	val[]: "The Glacier Passage"

	key[]: "tb_mt1_desc"
	val[]: "Glacier Country er hjemsted for nogle af de sidste aktive gletsjere i Rocky Mountains. Over tusinder af år har disse gamle ismasser udskåret dybe dale, skarpe tinder og uberørte søer og formet det landskab, der definerer det vestlige Montana i dag."

	key[]: "poi_mt1_01"
	val[]: "Kootenai Falls"

	key[]: "poi_mt1_01_desc"
	val[]: "Kootenai Falls er det største uopdæmmede vandfald i Montana og en stor regional attraktion. Kootenai-floden falder omkring 90 meter over en kort afstand og skaber en kraftfuld, naturskøn kaskade, der tiltrækker besøgende med sine uforglemmelige udsigter."

	key[]: "poi_mt1_02"
	val[]: "Berne Roadside Park"

	key[]: "poi_mt1_02_desc"
	val[]: "Bad Rock Canyon var et populært stop for rejsende langs Flathead River kendt for fiskeri, naturskønne udsigter og en naturlig kilde, der engang blev brugt til at køle overophedede bilradiatorer. I 1956 blev det et af Montanas første rekreationelle områder, kaldet Berne Roadside Park."

	key[]: "poi_mt1_03"
	val[]: "Heavens Peak"

	key[]: "poi_mt1_03_desc"
	val[]: "Heaven's Peak, et af Glacier National Parks mest ikoniske bjerge, blev navngivet i 1890'erne af guldgraver Louie Meyer. Imponerede af dens skønhed og den tårnhøje Garden Wall, så opdagelsesrejsende det som ulig noget andet på deres rejse."

	key[]: "mt_cut_glacier_national_park_desc"
	val[]: "Glacier National Park, der fejres som \"kontinentets krone\", blev grundlagt i 1910. Formet af gamle gletsjere blev den lettere at nå i 1932 med færdiggørelsen af Going-to-the-Sun Road, der nu er et historisk ingeniørmæssigt vartegn."

	key[]: "poi_mt1_04"
	val[]: "Blackfeet Indian Memorial"

	key[]: "poi_mt1_04_desc"
	val[]: "På den østlige kant af Glacier National Park ligger Blackfeet Nation. De er kendt som \"sletternes krigere\", og det menes, at deres navn stammer fra mokkasiner sværtet med aske. I dag er flere steder i parken stadig hellige for stammen."

	key[]: "mt_cut_flathead_lake_desc"
	val[]: "Flathead Lake er den største naturlige ferskvandssø målt på overfladeareal i det sammenhængende USA. Dens usædvanligt klare vand, der tilføres af smeltet sne fra de omkringliggende bjerge, fornyes fuldt ud hvert par år, hvilket gør den til en af de reneste store søer i verden."

	key[]: "mt_cut_thompson_falls_desc"
	val[]: "Byen, der er opkaldt efter den britisk-canadiske pelshandler og kartograf David Thompson, voksede efter jernbanens ankomst i 1881. Den udvidede sig yderligere under det nærliggende guldfeber i Coeur d'Alene, da den blev et vigtigt stop for minearbejdere, der var på vej langs Murray Trail."

	key[]: "landmark_mt_missoula_desc"
	val[]: "Det neoklassiske Missoula County Courthouse, bygget af sandsten og tegnet af A. J. Gibson i 1910, erstattede en tidligere, mindre bygning. Missoula County, dannet i 1860, er en af Montanas ældste politiske regioner og strækker sig fra Bitterroot til Rocky Mountains."

    key[]: "poi_mt1_05"
	val[]: "Lolo Creek"

	key[]: "poi_mt1_05_desc"
	val[]: "Korridoren mellem Lolo og Lolo Pass følger en historisk rute langs Lolo Creek. Den blev engang brugt af Nez Perce, tidlige bosættere og Lewis og Clark-ekspeditionen og er stadig et vigtigt kulturelt og historisk landskab præget af steder til fortolkning."

##########################################################################################

    key[]: "tb_mt2"
	val[]: "The Great Plains"

	key[]: "tb_mt2_desc"
	val[]: "Montanas sletter Great Plains strækker sig over den østlige del af staten og er kendetegnet ved store græsarealer, bølgende prærier og store, åbne himmelstrøg. Nogle af Nordamerikas vigtigste dinosaurfossiler er fundet i regionen og giver et glimt af et landskab, der eksisterede for millioner af år siden."

	key[]: "poi_mt2_01"
	val[]: "Hell Creek Formation"

	key[]: "poi_mt2_01_desc"
	val[]: "Hell Creek-formationen, centreret langs Hell Creek nær Jordan, Montana, bevarer et gammelt subtropisk landskab med floder, skove og sumpe. Den dateres tilbage til for 67-66 millioner år siden og er verdensberømt for sine rige dinosaurfossiler, herunder den ikoniske Tyrannosaurus Rex."

	key[]: "poi_mt2_02"
	val[]: "Yellowstone River"

	key[]: "poi_mt2_02_desc"
	val[]: "Yellowstone-floden er den længste fritflydende flod i det sammenhængende USA. Den udspringer i Yellowstone Nationalpark og strækker sig uden en eneste dæmning 1089 km gennem Wyoming og Montana, før den munder ud i Missouri-floden."

	key[]: "poi_mt2_03"
	val[]: "Glendisaurus"

	key[]: "poi_mt2_03_desc"
	val[]: "Glendisaurus, en Triceratops-statue i naturlig størrelse i Glendive, hylder regionens rige dinosaurarv. Med en højde på omkring 3 meter fungerer den som et populært vartegn langs Dinosaur Trail."
	
	key[]: "poi_mt2_04"
	val[]: "Missouri River"

	key[]: "poi_mt2_04_desc"
	val[]: "Missouri-floden, kendt som \"Big Muddy\", er den længste flod i USA. Med en længde på 3.777 km fra Montanas Rocky Mountains til Mississippi-floden spillede den en afgørende rolle i udforskning, handel og den vestlige udvidelse af den amerikanske grænse."

	key[]: "mt_cut_fort_peck_spillway_desc"
	val[]: "Fort Peck-dæmningen, der blev bygget under den store depression, er verdens største hydraulisk fyldte jorddæmning. Den blev færdiggjort som et af Amerikas største offentlige byggeprojekter og var designet til at skabe arbejdspladser, kontrollere oversvømmelser og generere vandkraft."

    key[]: "poi_mt2_05"
	val[]: "Valley County Pioneer Museum"

	key[]: "poi_mt2_05_desc"
	val[]: "Dette museum viser historien om det nordøstlige Montana gennem udstillinger om Assiniboine-folket, jernbaner, landbrug, Fort Peck-dæmningen og Lewis og Clark-ekspeditionen. Det huser også omfattende arkiver og en af de største Assiniboine-samlinger i landet."

	key[]: "poi_mt2_06"
	val[]: "Sleeping Buffalo Rock"

	key[]: "poi_mt2_06_desc"
	val[]: "Disse store gletsjersten var hellige vartegn for indfødte stammer. Gamle gletsjere skar dem ud og transporterede dem. Den mindre sten, \"Buffalo Rock\", fik form som en bøffel, mens den større, \"Medicine Rock\", har forskellige helleristninger."



##########################################################################################

#@}



#+ Wyoming TBs and POIs localization.
#@{

    key[]: "tb_wy1"
	val[]: "The Buffalo Trail"

	key[]: "tb_wy1_desc"
	val[]: "Hjemsted for Yellowstone og Grand Teton ligger landet på et aktivt vulkansystem, der driver gejsere og varme kilder, mens gletsjere og forkastninger har formet bjergtoppe og dale. Sammen gør disse kræfter det nordvestlige Wyoming til et af de mest geologisk dynamiske og visuelt ikoniske landskaber i det amerikanske vesten."

	key[]: "landmark_wy_yellowsto_desc"
	val[]: "Yellowstone, der blev grundlagt i 1872 som verdens første nationalpark, ligger på toppen af en massiv, sovende vulkan. Parken er hjemsted for omkring halvdelen af verdens aktive gejsere og beskytter også et af de største og mest intakte tempererede økosystemer på Jorden."

	key[]: "poi_wy1_01"
	val[]: "Lower Geyser Basin"

	key[]: "poi_wy1_01_desc"
	val[]: "Lower Geyser Basin er Yellowstones største gejserbassin med en enorm koncentration af gejsere, varme kilder og dampudluftningskanaler. Drevet af varme fra dyb underjordisk magma fremviser det et af parkens mest aktive geotermiske landskaber."

	key[]: "poi_wy1_02"
	val[]: "Yellowstone Lake"

	key[]: "poi_wy1_02_desc"
	val[]: "Yellowstone Lake er Nordamerikas største højtliggende sø og hjemsted for kontinentets største bestand af vildtlevende cutthroat-ørred. Forskere mener, at den engang løb ud mod Stillehavet, hvorved fisk kunne krydse Continental Divide gennem Two Ocean Pass."
	
	key[]: "poi_wy1_03"
	val[]: "Buffalo Bill Dam"

	key[]: "poi_wy1_03_desc"
	val[]: "Buffalo Bill-dæmningen, der blev færdiggjort i 1910, var en af de første betonbuedæmninger i USA. Med en højde på 102 meter var den den højeste dæmning i verden på det tidspunkt og blev et vartegn for tidlig ingeniørkunst."

	key[]: "poi_wy1_04"
	val[]: "Colters Hell"

	key[]: "poi_wy1_04_desc"
	val[]: "Colter’s Hell er et historisk geotermisk område langs Shoshone-floden, navngivet af opdagelsesrejsende John Colter i 1807. Tidlige bjergfolk sammenlignede dets dampende kløfter og svovlholdige lugte med \"helvede\". I dag er kun varme kilder og dampkløfter stadig aktive."

	key[]: "wy_cut_grand_teton_desc"
	val[]: "Grand Teton Nationalpark er defineret af sine gletsjerskårne tinder, der rejser sig skarpt over Jackson Hole. Bjergene, der engang blev kaldt \"Pilot Knobs\" af pelsjægere på grund af deres synlighed over sletterne, er stadig blandt de mest ikoniske vartegn i det amerikanske vesten."

	key[]: "poi_wy1_05"
	val[]: "Crowheart Butte"

	key[]: "poi_wy1_05_desc"
	val[]: "Crowheart Butte er et fremtrædende vartegn, der er opkaldt efter et slag i 1866 mellem Shoshone- og Crow-stammerne. Ifølge traditionen placerede høvding Washakie et Crow-høvdingehjerte oven på højen efter Shoshone-sejren som en advarsel, hvilket gav formationen sit navn."

##########################################################################################

    key[]: "tb_wy2"
	val[]: "Den røde ørken"

	key[]: "tb_wy2_desc"
	val[]: "Wyomings Røde Ørken er et enormt højtliggende ørkenområde defineret af vindformet sand, sagebrush-sletter og slående røde klippeformationer. Det er et af de største ubeboede områder i Nordamerika og er formet af et ekstremt klima, gamle sølejer og lange migrationsruter."

	key[]: "poi_wy2_01"
	val[]: "Red Canyon"

	key[]: "poi_wy2_01_desc"
	val[]: "Red Canyon blev udskåret under hævningen af Wind River Range for omkring 60 millioner år siden. Dens karakteristiske røde klipper er dannet af Chugwater-klippe, hvis oxiderede jern giver kløften den levende farve, der førte til dens navn."

	key[]: "poi_wy2_02"
	val[]: "Landskaber med styrke"

	key[]: "poi_wy2_02_desc"
	val[]: "Boar’s Tusk, en vulkansk klippeformation, der rejser sig over 122 meter over Wyomings Red Desert, er den eroderede kerne af en vulkan, der blev dannet for millioner af år siden. Den har udsigt over de enorme Killpecker-sandklitter, en del af Nordamerikas største aktive klitfelt."

	key[]: "poi_wy2_03"
	val[]: "Rock Springs"

	key[]: "poi_wy2_03_desc"
	val[]: "Rock Springs er kendt som \"Byen med 56 Nationaliteter\" på grund af sin mangfoldige immigrantarv. I slutningen af 1800-tallet ankom folk fra hele verden for at arbejde i Union Pacifics kulminer. Byen er også forbundet med den berømte fredløse Butch Cassidy."
	
	key[]: "poi_wy2_04"
	val[]: "Butch Cassidy Cabin"

	key[]: "poi_wy2_04_desc"
	val[]: "Butch Cassidy var en berømt amerikansk fredløs, der ledte \"Wild Bunch\", en bande kendt for tog- og bankrøverier i det gamle vesten. Han fik øgenavnet \"Butch\", mens han arbejdede i en slagterforretning (butcher shop på engelsk) i Rock Springs. Det mest legendariske og indflydelsesrige kup var Wilcox-togrøveriet i 1899."

	key[]: "wy_cut_evanston_desc"
	val[]: "Evanston blev grundlagt i 1869 af Union Pacific Railroad og opkaldt efter landmåler James A. Evans. Byen voksede som et jernbaneknudepunkt og blev senere et regionalt center for landbrug, olie og gas."

    key[]: "poi_wy2_05"
	val[]: "Lander Cutoff"

	key[]: "poi_wy2_05_desc"
	val[]: "Lander Cutoff, der blev bygget efter Pacific Wagon Road Act fra 1857, var en af de første føderalt finansierede vognveje i det amerikanske vesten. Den var opkaldt efter ingeniør Frederick W. Lander og gav en kortere rute for emigranter, der rejste vestpå."

	

##########################################################################################

#@}


#+ South Dakota TBs and POIs localization.
#@{

    key[]: "tb_sd1"
	val[]: "The Black Hills"

	key[]: "tb_sd1_desc"
	val[]: "Det vestlige South Dakota er defineret af Black Hills og Badlands. Her møder store prærier fyrretræsklædte bjerge, granitspir og strejfende bisonflokke. Lidt længere væk afslører de barske Badlands et slående landskab formet af vind og vand over millioner af år."

	key[]: "poi_sd1_01"
	val[]: "Black Hills National Forest"

	key[]: "poi_sd1_01_desc"
	val[]: "Dette fyrretræsdækkede område, kendt af lakotaerne som Paha Sapa, der betyder \"Sorte bakker\", er hjemsted for Black Elk Peak, South Dakotas højeste punkt på 2.144 meter. Det er omdøbt til ære for den berømte lakota-healer og er også den højeste top øst for Rocky Mountains."

	key[]: "sd_cut_rush_desc"
	val[]: "Mount Rushmore, kendt som Amerikas \"Demokratiets helligdom\", blev hugget ud af Black Hills mellem 1927 og 1941. Monumentet har 18 meter høje skulpturer af præsidenterne Washington, Jefferson, Roosevelt og Lincoln, der repræsenterer landets fødsel, vækst, udvikling og bevarelse."

	key[]: "poi_sd1_02"
	val[]: "Beaver Creek Bridge"

	key[]: "poi_sd1_02_desc"
	val[]: "Denne 67 meter høje buebro af stål og beton, bygget i 1929, spænder over en kløft nær Wind Cave National Park. Med en højde på 35 meter over kløftens bund er den South Dakotas eneste bro af sin slags og blev designet til problemfrit at falde i ét med den omgivende klippe."

	key[]: "sd_cut_sturgis_desc"
	val[]: "Sturgis er kendt for at være vært for verdens største motorcykeltræf. Det årlige 10-dages arrangement, der blev startet i 1938 af den lokale indiske forhandler Pappy Hoel, bringer kørere fra hele verden til Black Hills for motorcykelshows, løb, musik og fester."

	key[]: "sd_cut_deadwood_desc"
	val[]: "Deadwood voksede frem under Black Hills-guldfeberen i 1876 og blev en af Det Vilde Vestens mest berygtede byer. Byen har bevaret meget af sin historiske bymidte og blev udpeget som National Historic Landmark i 1961 som den eneste amerikanske by med denne status."

	key[]: "sd_cut_badlands_desc"
	val[]: "Badlands Nationalpark strækker sig over 244.000 hektar med klipper, tinder og spir langs landets største beskyttede prærie med blandet græs. Den bevarer også et af verdens rigeste fossillag, der afslører gamle pattedyr, der engang strejfede rundt på de store sletter."

	key[]: "poi_sd1_03"
	val[]: "Doane Robinson Tunnel"

	key[]: "poi_sd1_03_desc"
	val[]: "Doane Robinson, kendt som \"Mount Rushmores fader\", forestillede sig et storslået monument i Black Hills for at tiltrække besøgende til South Dakota. I dag fortsætter hans arv, hvor Mount Rushmore er perfekt indrammet gennem den naturskønne Doane Robinson-tunnel."

	key[]: "sd_cut_hot_springs_desc"
	val[]: "Hot Springs, oprindeligt kaldt Minnekahta af siouxerne på grund af dets \"varme vand\", blev grundlagt i 1879 omkring mineralkilder, der mentes at have helbredende kræfter. Det blev omdøbt i 1882 og blev et kursted og er stadig kendt for det historiske Evans Plunge."

	key[]: "poi_sd1_04"
	val[]: "The Mammoth Site"

	key[]: "poi_sd1_04_desc"
	val[]: "Mammoth Site er en verdensberømt fossiludgravning fra istiden, hvor 61 mammutter er blevet afdækket. Det gamle jordfaldshul, der blev opdaget i 1974, indeholder den største samling af rester af colombianske mammutter i Nordamerika, og udgravningerne er stadig i gang i dag."

##########################################################################################

    key[]: "tb_sd2"
	val[]: "The Great Divide"

	key[]: "tb_sd2_desc"
	val[]: "Missouri River-regionen i South Dakota markerer statens centrale grænse med brede sletter på den ene side og bølgende bakker på den anden. Den var en vigtig korridor for indfødte nationer, pelshandlere og Lewis og Clark, og blev senere hjemsted for store dæmninger, grænsebyer og en rig flodhistorie."

	key[]: "poi_sd2_01"
	val[]: "Four Great Lakes"

	key[]: "poi_sd2_01_desc"
	val[]: "Søerne Oahe, Sharpe, Francis Case og Lewis & Clark, der blev dannet af dæmninger i Missouri-floden i slutningen af 1940'erne, definerer nu det centrale South Dakota. Tilsammen udgør disse reservoirer mere end 700 kilometer kystlinje til sejlads, fiskeri og rekreation."

	key[]: "poi_sd2_02"
	val[]: "Bangor spøgelsesby"

	key[]: "poi_sd2_02_desc"
	val[]: "Bangor var engang amtssæde for Walworth County, men blev en spøgelsesby, efter at bygningerne blev flyttet til det nærliggende Selby i 1899. I dag er der kun et monument, som markerer stedet, hvor byen engang lå."

	key[]: "landmark_sd_state_capitol_desc"
	val[]: "Pierre blev grundlagt i 1880 og blev South Dakotas hovedstad, da staten tiltrådte Unionen i 1889. Byen, der blev valgt på grund af sin centrale beliggenhed og krydsning af Missouri-floden, blev opkaldt efter den fransk-amerikanske pelshandler Pierre Chouteau Jr."

	key[]: "sd_cut_corn_desc"
	val[]: "Corn Palace i Mitchell er verdens eneste palads, der udelukkende er dekoreret med majs. Hvert år skaber lokale kunstnere og landmænd nye vægmalerier med naturligt farvede majs, korn og græsser, hvilket gør det til et af South Dakotas mest unikke vartegn."

	key[]: "landmark_sd_largest_pheasant_desc"
	val[]: "Huron er hjemsted for verdens største fasan, en 12 meter høj skulptur af glasfiber og stål, bygget i 1959. Med en vægt på 22 tons hylder den regionens mangeårige ry som en af Amerikas førende fasanjagtdestinationer."

	key[]: "landmark_sd_dignity_of_earth_and_sky_desc"
	val[]: "\"Dignity Of Earth & Sky\" er en 15 meter høj skulptur i rustfrit stål med udsigt over Missouri-floden nær Chamberlain. Den er skabt af kunstneren Dale Lamphere og hylder Lakota- og Dakota-folkets arv, modstandsdygtighed og kulturer."

