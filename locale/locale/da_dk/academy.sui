val[]: "For at afslutte dette scenarie korrekt, skal du holde din trailer tilsluttet hele vejen igennem.<br><br><font face=/font/big_bold.font>Opret forbindelse til traileren.</font>"

key[]: "aca_msg_book2_slopy_moments2"
val[]: "Nu kan du fortsætte med scenariet"


