#### 2_09 msg - intro text

	key[]: "aca_msg_book1_2_09_cutscene1"
	val[]: "Parallelparkering er en essentiel ting, enhver chauffør bør kunne.<br>Gør klar til start."

	key[]: "aca_msg_book1_2_09_cutscene2"
	val[]: "Kør mod parkeringspladsen.<br>Hold øje med dine omgivelser."

	key[]: "aca_msg_book1_2_09_cutscene3"
	val[]: "Flugt med lastbilen foran din parkeringsplads. Kør ikke for tæt på den, men hold lidt afstand, så du har plads til at manøvrere."

	key[]: "aca_msg_book1_2_09_cutscene4"
	val[]: "Drej skarpt mod pladsen og begynd at bakke."

	key[]: "aca_msg_book1_2_09_cutscene5"
	val[]: "Når du ser gennem sidespejlet på førersiden, skal du sigte efter kantstenen lige foran lastbilen bag dig."

	key[]: "aca_msg_book1_2_09_cutscene6"
	val[]: "Når din kofanger er fri af lastbilen foran dig, kan du begynde at styre forenden af din lastbil ind og flugte med parkeringspladsen."

	key[]: "aca_msg_book1_2_09_cutscene7"
	val[]: "Ret rettet op og ram midten af parkeringspladsen.<br>Parker og sikr lastbilen."

#### 2_09 Driving Instructions

	key[]: "aca_msg_book1_2_09_start"
	val[]: "Foran dig er der nogle parkerede lastbiler. Der er en enkelt fri plads, du kan parkere i. <br><br><font face=/font/big_bold.font>Gør klar til start. </font>"

	key[]: "aca_msg_book1_2_09_check1"
	val[]: "Husk at være opmærksom på dine omgivelser. Gør god brug af dine spejle gennem denne manøvre. <br><br><font face=/font/big_bold.font>Kør fremad. </font>"

	key[]: "aca_msg_book1_2_09_stopmid"
	val[]: "<color value=@@clr_white@@>Kør forbi parkeringspladsen og ind på det markerede område. Herfra kan du begynde din bakkemanøvre.<br><br><font face=/font/big_bold.font>Stands på det markerede sted. </font>"

	key[]: "aca_msg_book1_2_09_checkmirror"
	val[]: "Tjek om der er forhindringer i dine omgivelser og vær sikker på, at du har plads til at bakke.<br><br><font face=/font/big_bold.font>Se gennem sidespejlet på passagersiden. </font>"

	key[]: "aca_msg_book1_2_09_backward"
	val[]: "Drej dine hjul og bak ind på parkeringspladsen.<br><br><font face=/font/big_bold.font>Begynd at bakke. </font>"

	key[]: "aca_msg_book1_2_09_stop"
	val[]: "Begynd at rette lastbilen op, når det er passende. Kør ikke over kantstenen!<br><br><font face=/font/big_bold.font>Få lastbilen og pladsen til at flugte. </font>"
#!{
	key[]: "aca_msg_book1_2_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

