#### 3_01 msg - intro text

	key[]: "aca_msg_book1_3_01_cutscene1"
	val[]: "I dette scenarie skal vi for første gang prøve at til- og frakoble en trailer. Gør lastbilen klar til kørsel og bak under traileren bag dig."

	key[]: "aca_msg_book1_3_01_cutscene2"
	val[]: "Kobl traileren til og træk fremad."

	key[]: "aca_msg_book1_3_01_cutscene3"
	val[]: "Stands i det markerede område."

	key[]: "aca_msg_book1_3_01_cutscene4"
	val[]: "Kobl traileren fra, træk fremad."

	key[]: "aca_msg_book1_3_01_cutscene5"
	val[]: "Parker på parkeringspladsen og sikr lastbilen."


#### 3_01 Driving Instructions

	key[]: "aca_msg_book1_3_01_start"
	val[]: "I dette scenarie gennemgår vi procedurerne ved til- og frakobling af trækker og trailer. Dette er en forsimplet version af, hvad en lastbilchauffør ville møde i den virkelige verden. <br><br><font face=/font/big_bold.font>Gør klar til start. </font>"

	key[]: "aca_msg_book1_3_01_check_con"
	val[]: "Der er en trailer bag trækkeren. Bak langsomt ind under traileren, indtil det femte hjul rammer king pin'en. Lige nu står traileren rigtigt i forhold til trækkeren, så der er ikke brug for at styre, bare kør baglæns.<br><br><font face=/font/big_bold.font>Bak langsomt indtil du føler en sammenkobling. </font>"

	key[]: "aca_msg_book1_3_01_park_br_on"
	val[]: "Det femte hjul er koblet til kingpin'en.<br><br><font face=/font/big_bold.font>Sikr lastbilen ved at trække håndbremsen. </font>"

	key[]: "aca_msg_book1_3_01_connect"
	val[]: "I virkeligheden låser det femte hjul automatisk kingpin'en, for chaufføren ville skulle forlade køretøjet for at hæve støttebenene og forbinde luft- og elektriske ledninger. <br><br><font face=/font/big_bold.font>For os er det nok bare at trykke @@imv_nrm_attach@@ for at tilkoble traileren. </font>"

	key[]: "aca_msg_book1_3_01_park_br_off"
	val[]: "Nu da traileren er koblet sikkert til trækkeren, er du klar til at køre fremad. Husk at dit køretøj nu er væsentligt længere og tungere og vil kræve et nyt sæt færdigheder at styre. <br><br><font face=/font/big_bold.font>Løs håndbremsen og gør klar til at køre fremad. </font>"

	key[]: "aca_msg_book1_3_01_check_discon"
	val[]: "Kør fremad.<br><br><font face=/font/big_bold.font>Stands i det markerede område længere fremme. </font>"

	key[]: "aca_msg_book1_3_01_parking_brake5"
	val[]: "<font face=/font/big_bold.font>Træk håndbremsen. </font>"

	key[]: "aca_msg_book1_3_01_stop5"
	val[]: "<font face=/font/big_bold.font>Træk håndbremsen. </font>"

	key[]: "aca_msg_book1_3_01_disc5"
	val[]: "Igen, i virkeligheden ville chaufføren skulle forlade køretøjet, sænke støttebenene, frakoble luft- og elektiske ledninger samt løsne det femte hjuls låsemekanisme. <br><br><font face=/font/big_bold.font>Vi gør denne proces mere enkel for dig, så hvis du trykker @@imv_nrm_attach@@ frakobles traileren. </font>"

	key[]: "aca_msg_book1_3_01_park_br_off2"
	val[]: "<font face=/font/big_bold.font>Løsn din håndbremse. </font>"

	key[]: "aca_msg_book1_3_01_park_br_off3"
	val[]: "Kør trækkeren ud fra under traileren og kør fremad.<br><br><font face=/font/big_bold.font>Stands i det markerede område. </font>"

	key[]: "aca_msg_book1_3_01_stop"
	val[]: "<font face=/font/big_bold.font>Stands på det markerede sted. </font>"
#!{
	key[]: "aca_msg_book1_3_01_end"
	val[]: "@@aca_msg_book1_2_01_end@@"


#!}

#@}

#+ Book 1 Scenario 3_02
#@{

#### 3_02 common
	key[]: "aca_scenario_book1_3_02_title"
	val[]: "Brems med en trailer"

	key[]: "aca_scenario_book1_3_02_desc"
	val[]: "I dette scenarie vil du prøve, hvordan det er at køre og bremse med en trailer tilkoblet."

#### 3_02 goal



	key[]: "aca_goal_book1_3_02_forward"
	val[]: "Kom i gang"

	key[]: "aca_goal_book1_3_02_check1"
	val[]: "Kør ned ad nedkørslen"

	key[]: "aca_goal_book1_3_02_check2"
	val[]: "Nå en hastighed på 60 km/t (37 mph)"

	key[]: "aca_goal_book1_3_02_check3"
	val[]: "Brug bremser"
