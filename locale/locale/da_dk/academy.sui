	key[]: "aca_goal_book1_3_03_check1"
	val[]: "Første sving"

	key[]: "aca_goal_book1_3_03_check2"
	val[]: "Rundkørsel"

	key[]: "aca_goal_book1_3_03_check3"
	val[]: "90 graders-sving"

	key[]: "aca_goal_book1_3_03_check4"
	val[]: "Kandegrebs-sving"

	key[]: "aca_goal_book1_3_03_check5"
	val[]: "Knappekrogs-sving"

	key[]: "aca_goal_book1_3_03_check6"
	val[]: "Skarpt sving"


#### generic phrase

	key[]: "aca_goal_book1_3_03_chk_point"
	val[]: "Kør uden om barriererne"

#### 3_03 msg - intro text

	key[]: "aca_msg_book1_3_03_cutscene01"
	val[]: "Længere fremme er forskellige komplekse sving og forhindringer.<br>Hvis du husker alt, du har lært indtil nu, bør det ikke være for svært."

	key[]: "aca_msg_book1_3_03_cutscene02"
	val[]: "Det første sving er et let knappekrogs-sving. Hold mod midten og det bør ikke udgøre et problem."

	key[]: "aca_msg_book1_3_03_cutscene03"
	val[]: "Fortsæt frem mod rundkørslen."

	key[]: "aca_msg_book1_3_03_cutscene04"
	val[]: "Hold traileren væk fra indersiden af rundkørslen ved at styre trækkeren så langt væk fra den som muligt."

	key[]: "aca_msg_book1_3_03_cutscene05"
	val[]: "Dette 90 graders venstresving er ikke særligt skarpt, men vær sikker på ikke at ramme keglerne."

	key[]: "aca_msg_book1_3_03_cutscene06"
	val[]: "Dette sving er væsentligt skarpere. Brug en kandegrebs-manøvre for at gennemføre det."

	key[]: "aca_msg_book1_3_03_cutscene07"
	val[]: "Du kan bruge en knappekrogs-manøvre ved dette sving, men der er nogle ekstra forhindringer, som skal undgås."

	key[]: "aca_msg_book1_3_03_cutscene09"
	val[]: "Igen, det afsluttende sving er meget skarpt og vil kræve en kombination af både kandegrebs- og knappekrogs-manøvrer for at gennemføres."

	key[]: "aca_msg_book1_3_03_cutscene10"
	val[]: "Parker i det anviste område, sikr lastbilen og sluk motoren."


#### 3_03 Driving Instructions



	key[]: "aca_msg_book1_3_03_forward"
	val[]: "<font face=/font/big_bold.font>Fortsæt til første sving. </font>"

	key[]: "aca_msg_book1_3_03_check1"
	val[]: "Det første sving er et let knappekrogs-sving.<br><br><font face=/font/big_bold.font><color value=@@clr_txt@@>Fortsæt gennem svinget. </font>"

	key[]: "aca_msg_book1_3_03_check2"
	val[]: "Fortsæt frem mod rundkørslen. Husk at holde mod ydersiden i den.<br><br><font face=/font/big_bold.font>Kør frem til og gennem rundkørslen.</font>"

	key[]: "aca_msg_book1_3_03_check3"
	val[]: "Dette 90 graders-sving er lidt skarpere. Vær sikker på ikke at ramme keglerne.<br><br><font face=/font/big_bold.font>Gennemfør svinget.</font>"

	key[]: "aca_msg_book1_3_03_check4"
	val[]: "Dette sving tackles bedst med en kandegrebs-procedure. Drej vidt inden du kører ind i krydset.<br><br><font face=/font/big_bold.font>Gennemfør et kandegrebs-sving. </font>"

	key[]: "aca_msg_book1_3_03_check5"
	val[]: "Dette sving er fyld med forskellige forhindringer, men det kan klares med en knappekrogs-manøvre.<br><br><font face=/font/big_bold.font>Fortsæt forsigtigt. </font>"

	key[]: "aca_msg_book1_3_03_check6"
	val[]: "Dette sving er ikke det allerskarpeste, så gennemfør det som du finder bedst.<br><br><font face=/font/big_bold.font>Drej ind på parkeringspladsen.</font>"
#!{
	key[]: "aca_msg_book1_3_03_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_03_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

#@}

#+ Book 1 Scenario 3_04
