#+ Book 1 Scenario 1_02
#@{

#### 1_02 common

	key[]: "aca_scenario_book1_1_02_title"
	val[]: "Kamerastyring"

	key[]: "aca_scenario_book1_1_02_desc"
	val[]: "I dette scenarie lærer vi om de forskellige kameratyper, du har til rådighed, og hvordan de kan hjælpe dig til at styre og manøvrere lastbilen."

#### 1_02 goal

	key[]: "aca_goal_book1_1_02_seat"
	val[]: "Sædeposition"

	key[]: "aca_goal_book1_1_02_look_back"
	val[]: "Udsigt bagud"

	key[]: "aca_goal_book1_1_02_mirrors"
	val[]: "Spejltjek"

	key[]: "aca_goal_book1_1_02_cam_behind"
	val[]: "Skift til eksternt kamera"

	key[]: "aca_goal_book1_1_02_look_around"
	val[]: "Se rundt om lastbilen"


#### 1_02 msg - intro text

	key[]: "aca_msg_book1_1_02_cutscene1"
	val[]: "I dette scenarie vil vi gennemgå de forskellige kameraer<br>du har til rådighed."

	key[]: "aca_msg_book1_1_02_cutscene2"
	val[]: "I alt kan du vælge mellem syv kameraer. Vi vil gennemgå<br>nogle af dem nu og forklare deres formål."

	key[]: "aca_msg_book1_1_02_cutscene3"
	val[]: "De forskellige kameraer har forskellige vinkler, som kan hjælpe dig med at manøvrere, hvis pladsen er trang."


#### 1_02 Driving Instructions

	key[]: "aca_msg_book1_1_02_seat"
	val[]: "At se hvor du kører er absolut grundlæggende for sikker og professionel kørsel. Hvis den nuværende sædeposition ikke passer dig, kan du ændre den i '@@adjust_link_t@@' (kan tilgås via pausemenuen).<br><br><font face=/font/big_bold.font>Når du er klar, kan du bekræfte med @@imv_nrm_activate@@. </font>"

	key[]: "aca_msg_book1_1_02_look_back"
	val[]: "Når du bakker er det ikke altid, at dine spejle giver klart udsyn. Det kan blive nødvendigt at se ud af vinduet for at få et bedre udsyn bagud.<br><br><font face=/font/big_bold.font>Drej dit kamera så langt du kan til førersiden for at se ud af vinduet mod trailerens bagende.</font>@@aca_goal_tip@@ Du er nødt til at være inde i køretøjet."

	key[]: "aca_msg_book1_1_02_mirrors"
	val[]: "Brug denne vinkel for at holde øje med traileren, når du bakker. Det er altid bedre at bakke til førersiden, så du kan benytte denne metode. Når du bakker til passagersiden vil dit udsyn bagud være meget mere begrænset.<br><br><font face=/font/big_bold.font>Se mod passagersiden. </font>"

	key[]: "aca_msg_book1_1_02_cam_behind"
	val[]: "Dette er grunden til, at det normalt ikke anbefales at bakke til passagersiden; som du kan se, er udsynet ret begrænset. Heldigvis står syv ydre kameraer også til din rådighed. <br><br>Knappen @@imv_nrm_camcycle@@ kan bruges til at skifte mellem disse kameraer, ét efter ét. Når du når det sidste kamera, vil knappen bringe dig tilbage til starten.<br><br><font face=/font/big_bold.font>Tryk @@imv_nrm_camcycle@@ for at skifte til næste kamera. </font>"

	key[]: "aca_msg_book1_1_02_look_around"
	val[]: "Det eksterne kamera giver det bedste overblik over, hvad der foregår rundt om lastbilen.<br><br><font face=/font/big_bold.font>Se rundt om lastbilen.</font>"

	key[]: "aca_msg_book1_1_02_cam_top"
	val[]: "<font face=/font/big_bold.font>Hvis du trykker @@imv_nrm_camcycle@@ igen, skifter du til næste kamera. </font>"

	key[]: "aca_msg_book1_1_02_cam_cabin"
	val[]: "Vinklen lodret ovenfra giver et perfekt overblik ad situationen rundt om lastbilen, hvilket gør parkering og kørsel i trange rum væsentligt lettere.<br><br><font face=/font/big_bold.font>Tryk @@imv_nrm_camcycle@@ for at skifte til næste kamera.  </font>"

	key[]: "aca_msg_book1_1_02_cam_window"
	val[]: "Tagkameraet giver frit udsyn til vejen langt foran lastbilen uden meget, som dækker for udsynet.<br><br><font face=/font/big_bold.font>Tryk @@imv_nrm_camcycle@@ for at skifte til det sidste kamera, vi vil se på i denne omgang.</font>"

	key[]: "aca_msg_book1_1_02_cam_interior"
	val[]: "Vinklen bagud er en genvej til det udsyn du tidligere fik ved at dreje kabinekameraet. Som vi nævnte, er det praktisk, når du bakker og parkerer.<br><br>I spillet har vi flere kameraer, du kan prøve ved gentagne tryk på @@imv_nrm_camcycle@@.<br><br><font face=/font/big_bold.font>Tryk @@imv_nrm_cam1@@ for at vende tilbage til kabinen.</font>"

	key[]: "aca_msg_book1_1_02_end"
	val[]: "For en autentisk køreskoleoplevelse anbefaler vi, at du holder dig til kabinekameraet, når du gennemgår de forskellige scenarier.<br><br><font face=/font/big_bold.font>Tryk @@imv_nrm_activate@@ for at bekræfte og afslutte scenariet.</font>@@aca_goal_tip@@ Du kan benytte @@o_im_cam_zoom@@ -funktionen for at få et bedre udsyn til dine omgivelser. Det er særligt praktisk, når du ser gennem spejlene. Tjek Indstillingsskærmen - '@@options_bindings_screen@@' for at se og/eller ændre de benyttede kontrolmuligheder."

#@}

#+ Book 1 Scenario 1_03
#@{

#### 1_03 common
	key[]: "aca_scenario_book1_1_03_title"
	val[]: "Første kørsel"

	key[]: "aca_scenario_book1_1_03_desc"
	val[]: "I dette scenarie lærer vi at forberede lastbilen til kørsel og at køre fremad for første gang."

#### 1_03 goal

	key[]: "aca_goal_book1_1_03_electrics"
	val[]: "Start tændingen"

	key[]: "aca_goal_book1_1_03_start"
	val[]: "Tænd motoren"

	key[]: "aca_goal_book1_1_03_look_mirror"
	val[]: "Undersøg omgivelserne"

	key[]: "aca_goal_book1_1_03_brake"
	val[]: "Brug fodbremsen"

	key[]: "aca_goal_book1_1_03_gear"
	val[]: "Sæt i gear"

	key[]: "aca_goal_book1_1_03_park_br_off"
	val[]: "Løs håndbremsen"

	key[]: "aca_goal_book1_1_03_forward"
	val[]: "Kør fremad"

	key[]: "aca_goal_book1_1_03_stop"
	val[]: "Standsning"

	key[]: "aca_goal_book1_1_03_park_br_on"
	val[]: "Træk håndbremsen"

	key[]: "aca_goal_book1_1_03_gear_n"
	val[]: "Skift til frigear"

	key[]: "aca_goal_book1_1_03_end"
	val[]: "Sluk motoren"

#### 1_03 msg - intro text

	key[]: "aca_msg_book1_1_03_cutscene1"
	val[]: "Ved dine første kørsler benytter vi trækkeren alene.<br> En lastbil kaldes en trækker, hvis den ikke har sit eget lastrum og i stedet benytter trailere til at transportere varer og materialer."

	key[]: "aca_msg_book1_1_03_cutscene2"
	val[]: "Trækkere er udbredte, fordi de giver større fleksibilitet: De kan parkere en tom trailer og samle en fyldt op uden ventetid, eller endda skifte til en helt anden trailertype, hvis nødvendigt."

	key[]: "aca_msg_book1_1_03_cutscene3"
	val[]: "Ved din første kørsel bliver din opgave at køre fremad og standse efter den stiplede linje.<br>Tænd motoren og følg instruktionerne for at gøre lastbilen klar til kørsel. Kør lige frem, når du er klar."

	key[]: "aca_msg_book1_1_03_cutscene4"
	val[]: "Kør forbi den stiplede linje, stands, sluk motoren og sikr køretøjet."

#### 1_03 Driving Instructions

	key[]: "aca_msg_book1_1_03_electrics"
	val[]: "I næste trin af din træning skal du køre lastbilen for første gang.<br><br>Det kan selvfølgelig ikke lade sig gøre, hvis motoren ikke kører, så du skal først slå tændingen til.<br><br><font face=/font/big_bold.font>Tryk $input engineelect$ for at slå tændingen til.</font>@@aca_goal_tip@@ I denne karriere tændes motoren automatisk sammen med elektriciteten. I karrieren kan du tilpasse dette under Indstillinger - Spilindstillinger - @@auto_engine_start@@."

	key[]: "aca_msg_book1_1_03_start"
	val[]: "Tændingen aktiverer lastbilens elektronik. Du har måske bemærket advarselslamper, som blinker på instrumentpanelet - det er normalt. Hvis de bliver ved med at blinke, når motoren er startet, er det sandsynligvis et tegn på, at der er et problem med lastbilen. Undtagelsen er lampen for håndbremsen, som slukker, når vi løsner bremsen.<br><br>Heldigvis er denne lastbil i tiptop stand, så vi er klar til at fortsætte.<br><br><font face=/font/big_bold.font>Tryk @@imv_nrm_engine@@ for at starte motoren. </font>"

	key[]: "aca_msg_book1_1_03_look_mirror"
	val[]: "Nu din motor er startet er det essentielt, at du tjekker dine omgivelser, inden du begynder at køre.<br><br><font face=/font/big_bold.font>Se rundt om lastbilen og i spejlene på fører- og passagersiden for at sikre dig, at området omkring lastbilen er frit.</font>@@aca_goal_tip@@ Du skal befinde dig inden i køretøjet."

	key[]: "aca_msg_book1_1_03_brake"
	val[]: "Det kan lyde indlysende, men du er nødt til at vide, hvordan du bremser, inden du begynder at køre.<br><br><font face=/font/big_bold.font>Aktiver fodbremsen ved hjælp af $input backward$. </font>"

	key[]: "aca_msg_book1_1_03_gear_arcade"
	val[]: "Som det næste vil du lære at ændre retningen, du bevæger dig i.<br><br>Med en forsimplet automatgear behøver du ikke selv skifte gear. Alt gøres automatisk for dig.<font face=/font/big_bold.font><br><br>Brug $input forward$ for at aktivere et fremadgående gear. </font>"

	key[]: "aca_msg_book1_1_03_gear_automatic"
	val[]: "Som det næste vil du lære at ændre retningen, du bevæger dig i.<br><br>Det realistiske automatgear giver dig mulighed for at skifte mellem Kør, Frigear og Bak, præcis som ved rigtige automatgear.<br><br><font face=/font/big_bold.font>Tryk @@imv_nrm_gearup@@ for at aktivere et fremadgående gear. </font>"

	key[]: "aca_msg_book1_1_03_gear_manual"
	val[]: "Som det næste vil du lære at ændre retningen, du bevæger dig i.<br><br>Det sekventielle gear giver mulighed for trinvis skiftning, præcis som ved rigtige sekventielle gear.<br><br>På samme måde som du sætter i et fremadgående gear, vil du skulle skifte til højere gear, når du accelererer.<br><br><font face=/font/big_bold.font>Tryk @@imv_nrm_gearup@@  for at sætte i første gear.</font>"

	key[]: "aca_msg_book1_1_03_gear_direct"
	val[]: "Som det næste vil du lære at ændre retningen, du bevæger dig i.<br><br>Med gearstand og kobling vil du opleve samme følelse af fysisk at skifte gear, som ved en rigtig manuel gearkasse.<br><br>Tryk koblingen og fodbrensen helt ned. <font face=/font/big_bold.font>Brug gearstangen til at sætte i første gear. <color value=@@clr_txt@@>Hold koblingen og fodbremsen helt nede.</font>"

	key[]: "aca_msg_book1_1_03_park_br_off"
	val[]: "For at begynde at køre, skal du først løsne håndbremsen.<br><br><font face=/font/big_bold.font>Brug @@imv_nrm_parkingbrake@@ for at løsne håndbremsen.</font> @@aca_goal_tip@@ I karrieren er håndbremsen i første omgang deaktiveret. Du kan ændre dette under Indstillinger - Spilindstillinger - @@auto_park_brake@@."

	key[]: "aca_msg_book1_1_03_forward_arcade"
	val[]: "Nu er lastbilen klar til at køre fremad. Begynd at køre og kryds den stiplede linje.<br><br><font face=/font/big_bold.font>Start ved at bruge speederen: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_automatic"
	val[]: "Nu er lastbilen klar til at køre fremad. Begynd at køre og kryds den stiplede linje.<br><br><font face=/font/big_bold.font>Start ved at bruge speederen: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_manual"
	val[]: "Nu er lastbilen klar til at køre fremad. Begynd at køre og kryds den stiplede linje.<br><br><font face=/font/big_bold.font>Start ved at bruge speederen: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_direct"
	val[]: "Nu er lastbilen klar til at køre fremad. Begynd at køre og kryds den stiplede linje.<br><br><font face=/font/big_bold.font>Løs fodbremsen, og gradist slip koblingen for at aktivere den, mens du samtidig bruger speederen for at holde omdrejningerne oppe, så motoren ikke stopper. Når koblingen er helt sluppet, kan du accelerere og skifte gear alt efter behov. </font>"

	key[]: "aca_msg_book1_1_03_stop_arcade"
	val[]: "Brug fodbremsen for at standse.<br><br><font face=/font/big_bold.font>Brug $input backward$ for at standse lastbilen. </font>"

	key[]: "aca_msg_book1_1_03_stop_automatic"
	val[]: "Brug fodbremsen for at standse.<br><br><font face=/font/big_bold.font>Brug $input backward$ for at standse lastbilen. </font>"

	key[]: "aca_msg_book1_1_03_stop_manual"
	val[]: "Brug fodbremsen for at standse.<br><br><font face=/font/big_bold.font>Brug $input backward$ for at standse lastbilen. </font>"

	key[]: "aca_msg_book1_1_03_stop_direct"
	val[]: "Når det er tid til at standse skal du slippe koblingen helt <font face=/font/big_bold.font>og så standse lastbilen med fodbremsen.<color value=@@clr_txt@@> Skift til frigear med gearstangen, og du kan slippe koblingen. </font>"

	key[]: "aca_msg_book1_1_03_park_br_on"
	val[]: "Nu skal du sikre lastbilen. Håndbremsen sikrer, at lastbilen ikke bevæger sig utilsigtet efter, at du har parkeret.<br><br><font face=/font/big_bold.font>Brug @@imv_nrm_parkingbrake@@ for at trække håndbremsen.</font>"

	key[]: "aca_msg_book1_1_03_gear_n_arcade"
	val[]: "Ved forsimplet automatgear er der ikke brug for at skifte gear. Alt klares for dig automatisk.<br><br><font face=/font/big_bold.font>Tryk @@imv_nrm_activate@@ for at bekræfte. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>Skift til frigear ved at trykke @@imv_nrm_geardown@@. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>Skift til frigear ved at trykke @@imv_nrm_geardown@@. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>Sæt gearstangen i frigear og slip så koblingen. </font>"

	key[]: "aca_msg_book1_1_03_end"
	val[]: "Nu ved du, hvordan du sætter lastbilen i bevægelse, og hvordan du standser den sikkert.<br><br><font face=/font/big_bold.font>Tryk $input engineelect$ for at slukke motoren. </font>"
#@}

#+ Book 1 Scenario 1_04
#@{

#### 1_04 common
	key[]: "aca_scenario_book1_1_04_title"
	val[]: "Baglænskørsel"

	key[]: "aca_scenario_book1_1_04_desc"
	val[]: "I dette scenarie skal vi prøve at bakke for første gang. Vi vil også tale om, hvordan du kan bruge spejlene til at se bagud, hvad du skal være opmærksom på, og hvordan du forbereder dig på baglænskørsel."

#### 1_04 goal

	key[]: "aca_goal_book1_1_04_start"
	val[]: "Tænd motoren"

	key[]: "aca_goal_book1_1_04_look_mirror"
	val[]: "Tjek spejlet på passagersiden"

	key[]: "aca_goal_book1_1_04_look_back"
	val[]: "Tjek spejlet på førersiden"

	key[]: "aca_goal_book1_1_04_gear_r"
	val[]: "Sæt i gear"

	key[]: "aca_goal_book1_1_04_park_br_off"
	val[]: "Løs håndbremsen"
#!{
	key[]: "aca_goal_book1_1_04_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_1_04_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_1_04_park_br_on"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

#!}
	key[]: "aca_goal_book1_1_04_gear_n"
	val[]: "Skift til frigear"

	key[]: "aca_goal_book1_1_04_end"
	val[]: "Sluk motoren"

#### 1_04 msg - intro text

	key[]: "aca_msg_book1_1_04_cutscene1"
	val[]: "Ved denne køretur vil vi bakke lige bagud. Du skal bakke forbi den stiplede linje og herefter standse."

	key[]: "aca_msg_book1_1_04_cutscene2"
	val[]: "Når du bakker lastbilen, er det essentielt hele tiden at være opmærksom, holde øje med alle spejle og sikre dig at området omkring og bag dig er frit."

	key[]: "aca_msg_book1_1_04_cutscene3"
	val[]: "Start motoren, skift til bakgear og begynd at køre."

	key[]: "aca_msg_book1_1_04_cutscene4"
	val[]: "Bak forbi den stiplede linje, stands, sluk motoren og sikr køretøjet."

#### 1_04 Driving Instructions

	key[]: "aca_msg_book1_1_04_start"
	val[]: "Forbered lastbilen til kørsel, som du lærte i sidste scenarie.<br><br><font face=/font/big_bold.font>Tænd motoren, når du er klar. </font>"

	key[]: "aca_msg_book1_1_04_look_mirror"
	val[]: "Tjek dine spejle for at sikre dig at området omkring dig er frit. Hvis du ikke er tilfreds med deres placering kan du rette dem til i '@@adjust_link_t@@'.<br><br><font face=/font/big_bold.font>Se gennem spejlet på passagersiden.</font>@@aca_goal_tip@@ Du er nødt til at være i kabinen."

	key[]: "aca_msg_book1_1_04_look_back"
	val[]: "Du vil køre forbi den stiplede linje. Lige nu er vejbanen fri, men ved normal kørsel er det vigtigt hele tiden at holde øje med dine omgivelser ved at se rundt og benytte spejlene.<br><br><font face=/font/big_bold.font>Tjek spejlet på passagersiden.</font>"

	key[]: "aca_msg_book1_1_04_gear_r_arcade"
	val[]: "<font face=/font/big_bold.font>Brug $input backward$ for at skifte til bakgear. </font>@@aca_goal_tip@@ Når du bakker, vil bakke-alarmen automatisk aktiveres ved de fleste lastbiler. Du kan slå dette fra under Indstillinger - Lyd - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_automatic"
	val[]: "<font face=/font/big_bold.font>Tryk @@imv_nrm_geardown@@ for at skifte til bakgear. </font>@@aca_goal_tip@@ Når du bakker, vil bakke-alarmen automatisk aktiveres ved de fleste lastbiler. Du kan slå dette fra under Indstillinger - Lyd - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_manual"
	val[]: "<font face=/font/big_bold.font>Tryk @@imv_nrm_geardown@@ for at skifte til bakgear. </font>@@aca_goal_tip@@ Når du bakker, vil bakke-alarmen automatisk aktiveres ved de fleste lastbiler. Du kan slå dette fra under Indstillinger - Lyd - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_direct"
	val[]: "<font face=/font/big_bold.font>Løs koblingen helt og flyt din gearstang til bakgear. </font>@@aca_goal_tip@@ Når du bakker, vil bakke-alarmen automatisk aktiveres ved de fleste lastbiler. Du kan slå dette fra under Indstillinger - Lyd - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_park_br_off"
	val[]: "Du er nu i bakgear.<br><br><font face=/font/big_bold.font>Løs håndbremsen med @@imv_nrm_parkingbrake@@. </font>"

	key[]: "aca_msg_book1_1_04_backward_arcade"
	val[]: "Begynd at køre med $input backward$.<br><br><font face=/font/big_bold.font>Bak forbi den stiplede linje. </font>"

	key[]: "aca_msg_book1_1_04_backward_automatic"
	val[]: "Begynd at køre ved hjælp af speederen: $input forward$.<br><br><font face=/font/big_bold.font>Bak forbi den stiplede linje. </font>"

	key[]: "aca_msg_book1_1_04_backward_manual"
	val[]: "Begynd at køre ved hjælp af speederen: $input forward$.<br><br><font face=/font/big_bold.font>Bak forbi den stiplede linje. </font>"

	key[]: "aca_msg_book1_1_04_backward_direct"
	val[]: "Slip koblingen langsomt mens du holder motorens omdrejninger oppe ved hjælp af speederen. <br><br><font face=/font/big_bold.font>Bak forbi den stiplede linje. </font>"

	key[]: "aca_msg_book1_1_04_stop_arcade"
	val[]: "<font face=/font/big_bold.font>Stands lastbilen med din fodbremse: $input forward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_automatic"
	val[]: "<font face=/font/big_bold.font>Stands lastbilen med din fodbremse: $input backward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_manual"
	val[]: "<font face=/font/big_bold.font>Stands lastbilen med din fodbremse: $input backward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_direct"
	val[]: "<font face=/font/big_bold.font>Slip koblingen helt og stands så lastbilen med dine fodbremser. </font>"

	key[]: "aca_msg_book1_1_04_park_br_on"
	val[]: "<font face=/font/big_bold.font>Træk håndbremsen med @@imv_nrm_parkingbrake@@. </font>"

	key[]: "aca_msg_book1_1_04_gear_n_arcade"
	val[]: "Ved forsimplet automatgear er der ikke brug for at skifte gear, da alt klares for dig automatisk, modsat hvordan det sker i virkeligheden.<br><br><font face=/font/big_bold.font>Tryk @@imv_nrm_activate@@ for at bekræfte. </font>"

	key[]: "aca_msg_book1_1_04_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>Skift til frigear ved at trykke @@imv_nrm_gearup@@.</font>@@aca_goal_tip@@ Moderne lastbiler skifter automatisk til frigear, når håndbremsen trækkes. Det er dog en god vane altid at gøre det selv. I de følgende scenarier har vi ikke brug for dette trin."

	key[]: "aca_msg_book1_1_04_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>Skift til frigear ved at trykke @@imv_nrm_gearup@@.</font>@@aca_goal_tip@@ Moderne lastbiler skifter automatisk til frigear, når håndbremsen trækkes. Det er dog en god vane altid at gøre det selv. I de følgende scenarier har vi ikke brug for dette trin."

	key[]: "aca_msg_book1_1_04_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>Sæt gearstanden i frigear og slip så koblingen.</font>@@aca_goal_tip@@ Moderne lastbiler skifter automatisk til frigear, når håndbremsen trækkes. Det er dog en god vane altid at gøre det selv. I de følgende scenarier har vi ikke brug for dette trin."

	key[]: "aca_msg_book1_1_04_end"
	val[]: "Husk altid at være opmærksom på dine omgivelser når du bakker, især i travle områder med megen trafik.<br><br><font face=/font/big_bold.font>Sluk motoren ved at trykke $input engineelect$. </font>"
#@}

