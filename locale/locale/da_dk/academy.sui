#### 3_02 msg - intro text

	key[]: "aca_msg_book1_3_02_cutscene01"
	val[]: "I dette scenarie kører vi en lille tur med lastbilen. Du vil prøve, hvordan det er at bremse med en trailer, når vi kører ned ad den lette nedkørsel længere fremme. Gør lastbilen klar og begynd at køre."

	key[]: "aca_msg_book1_3_02_cutscene06"
	val[]: "Nå en hastighed på mindst 60 km/t (37 mph). Vær forberedt på bremseområdet længere fremme."

	key[]: "aca_msg_book1_3_02_cutscene08"
	val[]: "Begynd at bremse til du står stille. Vær sikker på, at du ikke venter for længe, så du ikke rammer barriererne foran dig!"

	key[]: "aca_msg_book1_3_02_cutscene10"
	val[]: "Parker i det anviste område, sikr lastbilen og sluk motoren."


#### 3_02 Driving Instructions

	key[]: "aca_msg_book1_3_02_start"
	val[]: "Under denne tur vil du prøve at bruge fodbremsen, når du kører ned ad en let nedkørsel. Formålet med denne køretur er at føle vægten bag dig og hvordan den påvirker lastbilens bremselængde.<br><br><font face=/font/big_bold.font>Gør klar til start. </font>"

	key[]: "aca_msg_book1_3_02_forward"
	val[]: "Begynd at køre og husk, at du vil skulle nå en hastighed på 60 km/t (37 mph) <font face=/font/big_bold.font>efter</font> det kommende sving.<br><br><font face=/font/big_bold.font>Kør mod svinget længere fremme. </font>"

	key[]: "aca_msg_book1_3_02_check1"
	val[]: "Gennemfør højresvinget og accelerer så til 60 km/t (37 mph).<br><br><font face=/font/big_bold.font>Fortsæt kørslen. </font>"

	key[]: "aca_msg_book1_3_02_check2"
	val[]: "<font face=/font/big_bold.font>Nå en hastighed på mindst 60 km/t (37 mph). </font>"

	key[]: "aca_msg_book1_3_02_check3"
	val[]: "Du har nået den krævede hastighed.<br><br><font face=/font/big_bold.font>Stands ved barriererne længere fremme. </font>"
#!{
	key[]: "aca_msg_book1_3_02_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_02_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

