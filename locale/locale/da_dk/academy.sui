	key[]: "aca_scenario_book3_double_90_title"
	val[]: "90 graders-sving"

	key[]: "aca_scenario_book3_double_90_desc"
	val[]: "I dette scenarie skal du køre gennem en bane med 90 graders sving af forskellig sværhedsgrad."

#### double_90 goal

	key[]: "aca_goal_book3_double_90_start"
	val[]: "Kom i gang"

	key[]: "aca_goal_book3_double_90_forward"
	val[]: "Fremad"

	key[]: "aca_goal_book3_double_90_check1"
	val[]: "Brug dine spejle"

	key[]: "aca_goal_book3_double_90_check2"
	val[]: "Der er plads nok"

	key[]: "aca_goal_book3_double_90_check3"
	val[]: "Sæt brikkerne på plads"

	key[]: "aca_goal_book3_double_90_check4"
	val[]: "Tænk fremad"

#!{
	key[]: "aca_goal_book3_double_90_check5"
	val[]: "@@aca_goal_book3_sup_check1@@"

	key[]: "aca_goal_book3_double_90_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_double_90_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}

#### double_90 intro

	key[]: "aca_msg_book3_double_90_cutscene01"
	val[]: "Banen længere fremme vil hjælpe dig med at lære, hvordan du styrer B-dobbelttrailere gennem 90 graders sving af forskellig sværhedsgrad."

	key[]: "aca_msg_book3_double_90_cutscene02"
	val[]: "De første hjørner er ret brede med masser af plads. Brug dem til at få en føling med trailerne bag dig, når du drejer."

	key[]: "aca_msg_book3_double_90_cutscene03"
	val[]: "Fra nu af bliver svingene skarpere og mere krævende. Nærm dig langsomt og husk at køre langt ind i svingene, så dine trailere kan komme fri af hjørnet bag dig."

	key[]: "aca_msg_book3_double_90_cutscene04"
	val[]: "Dette er et af banens skarpeste sving. Det kan være en hjælp at bruge den lille smule plads til højre for at få dine trailere forbi de drilagtige kegler på indersiden."

	key[]: "aca_msg_book3_double_90_cutscene05"
	val[]: "Du skal altid have næste sving i tankerne - når du forlader et sving, skal du straks lægge en plan for, hvordan du vil nærme dig det næste."

	key[]: "aca_msg_book3_double_90_cutscene06"
	val[]: "Hold altid øje med dine trailere, helt indtil de er fri af alle forhindringer."

#### double_90 driving instructions

#!{
	key[]: "aca_msg_book3_double_90_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_double_90_forward"
	val[]: "Fortsæt frem mod første sving."

	key[]: "aca_msg_book3_double_90_check1"
	val[]: "Hold øje med spejlene, mens du kører, så du lærer, hvordan trailerne følger dig."

	key[]: "aca_msg_book3_double_90_check2"
	val[]: "Kør mod ydersiden inden hvert sving. Dette er essentielt for at give dig den plads, du får brug for, når trailerne skal rundt om hjørnet."

	key[]: "aca_msg_book3_double_90_check3"
	val[]: "Den rigtige fremgangsmåde er essentiel ved de næste sving, da de følges af en meget skarp kurve. Hvis du laver en fejl i begyndelsen, kan du betale dyrt senere. <br><br>Arbejd langsomt og grundigt og hold øje med dine omgivelser."

	key[]: "aca_msg_book3_double_90_check4"
	val[]: "Dette sving er ekstremt skarpt og fører direkte ind i endnu et skarpt sving. Du skal ikke kun overveje, hvordan du kører ind i svinget, men også hvordan du forlader det og forbereder dig på næste."

	key[]: "aca_msg_book3_double_90_check5"
	val[]: "Kør videre gennem de sidste sving mod det angivne område."

#!{
	key[]: "aca_msg_book3_double_90_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_double_90_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


#+ Book 3 Scenario justb
#@{

#### justb common
	key[]: "aca_scenario_book3_justb_title"
	val[]: "Første bak"

	key[]: "aca_scenario_book3_justb_desc"
	val[]: "I dette scenarie vil vi for første gang bakke med en B-dobbeltkombination."

#### justb goal

#!{
	key[]: "aca_goal_book3_justb_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_justb_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
	key[]: "aca_goal_book3_justb_check1"
	val[]: "Ingen stress"

#!{
	key[]: "aca_goal_book3_justb_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_justb_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### justb msg - intro text

	key[]: "aca_msg_book3_justb_cutscene1"
	val[]: "At bakke med B-dobbelttrailere kræver en helt ny måde at tænke på, hvad du gør. I stedet for bare at styre en enkelt trailer, er du nu nødt til at bruge din forreste trailer til at styre den bagerste. <br><br> Brug dette scenrarie til at få en føling med, hvordan det hele fungerer. Der er ikke noget særligt mål; bare giv dig tid og forsøg at finde ud af, hvad der foregår."

	key[]: "aca_msg_book3_justb_cutscene2"
	val[]: "Når du starter fra en lige position, kan du dreje trækkeren i samme retning, som du vil have, at den bagerste trailer skal bevæge sig. <br><br>Vær ikke for ivrig - det er nok at få traileren til at pege i den retning, du vil have den, og så kan du rette trækkeren op, så den flugter med den forreste trailer, og lade den bagerste klare ærterne."

	key[]: "aca_msg_book3_justb_cutscene3"
	val[]: "Når din bagerste trailer har den retning, du vil have den til at bevæge sig i, kan du styre den forreste trailer ind, så den følger samme retning. <br><br>Så snart den forreste følger den bagerste, kan du bruge trækkeren til at justere vinklen mellem de to trailere, alt efter om du vil dreje skarpere eller mere glidende."

	key[]: "aca_msg_book3_justb_cutscene4"
	val[]: "Der findes ikke nogen præcis opskrift for at få det til at lykkes - du er bare nødt til at holde øje med, hvad der sker, lære af dine fejl og blive ved med at øve dig. <br><br>Når du er tilfreds, kan du køre til det markerede område og sikre køretøjet. <br><br>Bare brug så meget tid på at eksperimentere her, som du har lyst til."

#### justb Driving Instructions

#!{
	key[]: "aca_msg_book3_justb_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_justb_forward"
	val[]: "Begynd langsomt at bakke. Husk at starte med små korrektioner - der er ingen grund til at folde hele trækket sammen med det samme.<br><br>Prøv at køre lige bagud eller bring trailerne mod førersiden."

	key[]: "aca_msg_book3_justb_check1"
	val[]: "Giv dig god tid og bliv ikke frustreret. <br><br>Enhver mester var engang en begynder."

#!{
	key[]: "aca_msg_book3_justb_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_justb_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}

#+ Book 3 Scenario justc
#@{

#### justc common
	key[]: "aca_scenario_book3_justc_title"
	val[]: "Første korrektion når du bakker"

	key[]: "aca_scenario_book3_justc_desc"
	val[]: "I dette scenarie skal vi fortsætte, hvor en anden gav op."

#### justc goal

#!{
	key[]: "aca_goal_book3_justc_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_justc_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
	key[]: "aca_goal_book3_justc_check1"
	val[]: "Baglænskørsel"

#!{
	key[]: "aca_goal_book3_justc_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_justc_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### justc msg - intro text

	key[]: "aca_msg_book3_justc_cutscene1"
	val[]: "Åh nej! Nogen blev vist lidt frustreret, mens de bakkede, og har efterladt deres lastbil midt på pladsen."

	key[]: "aca_msg_book3_justc_cutscene2"
	val[]: "Det kan ikke undgås, at der vil være tidspunkter, hvor det går helt i kludder. Det gør ikke noget - kør bare fremad, indtil trailerne er rettet så meget op, at du har noget, du kan arbejde videre med. <br><br>Hvis du er i tvivl, kan du altid sigte mod at rette helt op, så du kan starte på en frisk."

	key[]: "aca_msg_book3_justc_cutscene3"
	val[]: "Dette er en forholdsvis god position at starte fra. Den bagerste trailer peger stadig i den retning, vi vil have den i, og vi kan hurtigt få trækkeren ind foran den forreste trailer, så vi kan få hele kombinationen styret i den retning, vi vil have den."

	key[]: "aca_msg_book3_justc_cutscene4"
	val[]: "Fortsæt til det anviste område og sikr lastbilen. <br><br>Du kan frit øve dette scenarie, indtil du føler dig tryg ved at manøvrere med trailerne."

#### justc Driving Instructions

#!{
	key[]: "aca_msg_book3_justc_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_justc_forward"
	val[]: "Den her kan ikke reddes. Kør fremad, så du får noget at arbejde med."

	key[]: "aca_msg_book3_justc_check1"
	val[]: "Begynd at bakke."

#!{
	key[]: "aca_msg_book3_justc_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_justc_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


#+ Straight Backing
#@{

#### straight_backing common

	key[]: "aca_scenario_book3_straight_backing_title"
	val[]: "Baglænskørsel ligeud"

	key[]: "aca_scenario_book3_straight_backing_desc"
	val[]: "I dette scenarie skal du bakke et sæt B-dobbelttrailere i en lige linje."

#### straight_backing goal

#!{
	key[]: "aca_goal_book3_straight_backing_start"
	val[]: "@@aca_goal_book3_sup_start@@"
#!}
	key[]: "aca_goal_book3_straight_backing_forward"
	val[]: "Baglænskørsel"

