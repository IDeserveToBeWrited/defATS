#### 2_06 msg - intro text

	key[]: "aca_msg_book1_2_06_cutscene01"
	val[]: "I det sidste scenarie i dette kapitel vil vi køre på en testbane med en kompleks konfiguration."

	key[]: "aca_msg_book1_2_06_cutscene02"
	val[]: "Den første forhindring er en slalom mellem nogle barrierer. Kør gennem den og husk at bruge dine spejle."

	key[]: "aca_msg_book1_2_06_cutscene04"
	val[]: "Nu kommer et hårnålesving. Hold dit sving bredt og du burde ikke få problemer."

	key[]: "aca_msg_book1_2_06_cutscene05"
	val[]: "Ruten fremad bliver tydeligt smallere. Fortsæt forsigtigt og brug sidespejlet som hjælp."

	key[]: "aca_msg_book1_2_06_cutscene06"
	val[]: "Det næste, som kommer, er en række lette 90 graders-sving."

	key[]: "aca_msg_book1_2_06_cutscene08"
	val[]: "Den næste sektion skal gennemføres i bakgear. Hav det i baghovedet når du nærmer dig barriererne længere fremme."

	key[]: "aca_msg_book1_2_06_cutscene09"
	val[]: "Følg vejmarkeringerne tilbage og gennem kurverne."

	key[]: "aca_msg_book1_2_06_cutscene10"
	val[]: "Bak hen til barrierne, stands så og fortsæt frem til højre."

	key[]: "aca_msg_book1_2_06_cutscene11"
	val[]: "Denne passage mellem keglerne er meget snæver. Kør langsomt og brug dine spejle til at orientere dig efter i passagen."

	key[]: "aca_msg_book1_2_06_cutscene13"
	val[]: "Længere fremme er en serie skiftevis venstre og højre 90 graders-sving."

	key[]: "aca_msg_book1_2_06_cutscene15"
	val[]: "Du kan støde på tog ved denne overskæring. Stands og vent hvis det sker. Bagefter kan du dreje til højre."

	key[]: "aca_msg_book1_2_06_cutscene16"
	val[]: "Drej til venstre ud på vejen. Efter svinget kan du sætte farten op."

	key[]: "aca_msg_book1_2_06_cutscene18"
	val[]: "Nu mangler nogle få venstresving i byen, og du vil være fremme ved din destination!"

	key[]: "aca_msg_book1_2_06_cutscene19"
	val[]: "Nærm dig barriererne længere fremme og gør klar til at parkere på pladsen til højre."

	key[]: "aca_msg_book1_2_06_cutscene20"
	val[]: "Bak ind på parkeringspladsen, sluk motoren og sikr lastbilen."

#### 2_06 Driving Instructions



	key[]: "aca_msg_book1_2_06_forward"
	val[]: "Foran dig er en slalombane af barrierer.<br><br><font face=/font/big_bold.font>Kør gennem banen.</font>"

	key[]: "aca_msg_book1_2_06_forward2"
	val[]: "<font face=/font/big_bold.font>Følg ruten gennem hårnålesvinget. </font>"

	key[]: "aca_msg_book1_2_06_check1"
	val[]: "Ruten fremad bliver tydeligt smallere. Du kan bruge dit sidespejl til at orientere dig efter.<br><br><font face=/font/big_bold.font>Fortsæt forsigtigt. </font>"

	key[]: "aca_msg_book1_2_06_check2"
	val[]: "Efter kurven kommer et 90 graders-sving.<br><br><font face=/font/big_bold.font>Tilpas din hastighed.</font>"

	key[]: "aca_msg_book1_2_06_check3"
	val[]: "Længere fremme er nogle få, lette sving. Fortsæt med at tilpasse din hastighed efter omstændighederne.<br><br><font face=/font/big_bold.font>Kør videre. </font>"

	key[]: "aca_msg_book1_2_06_check4"
	val[]: "Den følgende sektion skal gennemføres i bakgear. Stands ved barriererne længere fremme, så du kan bakke til højre efterfølgende.<br><br><font face=/font/big_bold.font>Stands ved barriererne.</font>"

	key[]: "aca_msg_book1_2_06_check5"
	val[]: "Bak mod området bag dig til højre.<br><br><font face=/font/big_bold.font>Begynd at bakke. </font>"

	key[]: "aca_msg_book1_2_06_reverse"
	val[]: "Følg ruten gennem svingene.<br><br><font face=/font/big_bold.font>Bak videre.</font>"

	key[]: "aca_msg_book1_2_06_check6"
	val[]: "Bag dig til venstre er nogle barrierer. <br><br><font face=/font/big_bold.font>Drej mod barriererne og vær klar til at standse.</font>"

	key[]: "aca_msg_book1_2_06_check7"
	val[]: "Stands and skift til et fremadrettet gear. Fortsæt så mod højre. <br><br><font face=/font/big_bold.font>Kør frem. </font>"

	key[]: "aca_msg_book1_2_06_check8"
	val[]: "Foran dig er en smal, bugtende rute mellem nogle kegler. Kør forsigtigt og brug dine spejle hvis nødvendigt.<br><br><font face=/font/big_bold.font>Kør mellem keglerne. </font>"

	key[]: "aca_msg_book1_2_06_check9"
	val[]: "Det næste er en kombination af forskellige 90 graders-sving. Vær sikker på at nærme dig hvert sving med god afstand til at manøvrere.<br><br><font face=/font/big_bold.font>Fortsæt kørslen. </font>"

	key[]: "aca_msg_book1_2_06_check10"
	val[]: "Hold øje med overskæringen, når du nærmer dig. Signalerne kan aktiveres, hvis et tog er på vej.<br><br><font face=/font/big_bold.font>Fortsæt forsigtigt.</font>"

	key[]: "aca_msg_book1_2_06_check11"
	val[]: "Svinget ud på vejen er delvist spærret af en forhindring, så hold til venstre, mens du nærmer dig, for at give dig selv mere plads.<br><br><font face=/font/big_bold.font>Gennemfør svinget. </font>"

	key[]: "aca_msg_book1_2_06_check12"
	val[]: "Du kan vælge at følge eller ignorere stopskiltet. Området er blevet spærret af, så vi kan bruge det.<br><br><font face=/font/big_bold.font>Drej til venstre.</font>"

	key[]: "aca_msg_book1_2_06_check13"
	val[]: "Du kan sætte farten op her, men du vil skulle dreje i næste kryds.<br><br><font face=/font/big_bold.font>Fortsæt gennem banen. </font>"

	key[]: "aca_msg_book1_2_06_check14"
	val[]: "Fortsæt ind i byen med et venstresving, efterfulgt af yderligere to venstresving til det sidste område.<br><br><font face=/font/big_bold.font>Kør gennem byen.</font>"

	key[]: "aca_msg_book1_2_06_check15"
	val[]: "På den fjerne side af pladsen er nogle barrierer. Kør hen til dem. <br><br><font face=/font/big_bold.font>Stands tæt på barriererne. </font>"

	key[]: "aca_msg_book1_2_06_check16"
	val[]: "Bag dig til højre er der en parkeringsplads.<br><br><font face=/font/big_bold.font>Bak ind på parkeringspladsen. </font>"
#!{
	key[]: "aca_msg_book1_2_06_check17"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_06_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_2_06_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

#@}

#+ Book 1 Scenario 2_08
#@{

#### 2_08 common
	key[]: "aca_scenario_book1_2_08_title"
	val[]: "Enkel træningsbane"

	key[]: "aca_scenario_book1_2_08_desc"
	val[]: "I dette scenarie vil vi benytte de færdigheder, du har lært indtil nu, på en let køretur gennem en enkel træningsbane."

#### 2_08 goal
#!{
	key[]: "aca_goal_book1_2_08_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_08_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_2_08_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
#!}
	key[]: "aca_goal_book1_2_08_forward"
	val[]: "Kør ind på banen"

	key[]: "aca_goal_book1_2_08_check1"
	val[]: "Bredt hårnålesving"

	key[]: "aca_goal_book1_2_08_check2"
	val[]: "Kør gennem slalommen"

	key[]: "aca_goal_book1_2_08_check3"
	val[]: "Skarpt hårnålesving"

	key[]: "aca_goal_book1_2_08_check4"
	val[]: "Smal kurve"

	key[]: "aca_goal_book1_2_08_check6"
	val[]: "Teknisk del"

	key[]: "aca_goal_book1_2_08_check7"
	val[]: "Åben sektion"



#### 2_08 msg - intro text

	key[]: "aca_msg_book1_2_08_cutscene1"
	val[]: "I dette scenarie tager vi din trækker på en kort tur for at se, hvordan du bruger dine nye færdigheder.<br>Der er forskellige typer og kombinationer af sving på banen. Det er ikke et kapløb og handler ikke om tid. Vær tålmodig og tilpas din hastighed efter de sving og forhindringer, du møder."

	key[]: "aca_msg_book1_2_08_cutscene2"
	val[]: "Kør ind på banen med et bredt hårnålesving."

	key[]: "aca_msg_book1_2_08_cutscene3"
	val[]: "Nu vil du møde en serie forhindringer, som leder dig ind i en ujævn slalom."

	key[]: "aca_msg_book1_2_08_cutscene4"
	val[]: "Efter at have gennemført et par lette 90 graders-sving, vil du støde på et skarpt hårnålesving. Det er vigtigt at nærme dig korrekt, både for at gennemføre svinget og for glidende at nå næste sektion."

	key[]: "aca_msg_book1_2_08_cutscene5"
	val[]: "Vær opmærksom på kegler når du kører gennem den lange kurve, da udsynet over kølerhjelmen er begrænset."

	key[]: "aca_msg_book1_2_08_cutscene6"
	val[]: "Endnu et sæt barrierer vil lede dig ind på en bred slalombane."

	key[]: "aca_msg_book1_2_08_cutscene7"
	val[]: "Ruten bliver lidt bredere, men kør ikke for hurtigt. Et par lette sving mere og du er færdig."

	key[]: "aca_msg_book1_2_08_cutscene8"
	val[]: "Stands i det angivne område og sikr lastbilen."


#### 2_08 Driving Instructions

	key[]: "aca_msg_book1_2_08_start"
	val[]: "For at fuldføre dette scenarie må du ikke køre galt, køre af banen eller ramme trafikkeglerne.<br><br><font face=/font/big_bold.font>Gør klar til start. </font>"

	key[]: "aca_msg_book1_2_08_forward"
	val[]:"<font face=/font/big_bold.font>Fortsæt frem ind i det brede hårnålesving for at komme ind på banen. </font>"

	key[]: "aca_msg_book1_2_08_check1"
	val[]: "<font face=/font/big_bold.font>Gennemfør hårnålesvinget. </font>"

	key[]: "aca_msg_book1_2_08_check2"
	val[]: "Du nærmer dig nogle barrierer, som er arrangeret nogenlunde som en slalombane.<br><br><font face=/font/big_bold.font>Tilpas din hastighed og fortsæt.</font>"

	key[]: "aca_msg_book1_2_08_check3"
	val[]: "Det næste, du møder, er to lette 90 graders-sving efterfulgt af et skarpt hårnålesving. Kør forsigtigt.<br><br><font face=/font/big_bold.font>Fortsæt ind i hårnålesvinget.</font>"

	key[]: "aca_msg_book1_2_08_check4"
	val[]: "Når du kommer ud af hårnålesvinget, vil du møde en smal rute gennem en kurve. Du må holde afstand til den indre barriere, men samtidig også undgå at ramme trafikkeglerne foran dig.<br><br><font face=/font/big_bold.font>Fortsæt gennem kurven. </font>"

	key[]: "aca_msg_book1_2_08_check6"
	val[]: "Vejen længere fremme har nogle snævre, tekniske sving. Tilpas din hastighed og fuldfør sektionen forsigtigt.<br><br><font face=/font/big_bold.font>Fortsæt med at køre. </font>"

	key[]: "aca_msg_book1_2_08_check7"
	val[]: "Den næste sektion er mere åben og har nogle lette sving. Kør ikke for hurtigt.<br><br><font face=/font/big_bold.font>Fortsæt kørslen. </font>"
#!{
	key[]: "aca_msg_book1_2_08_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_08_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

#@}

#+ Book 1 Scenario 2_09
#@{

#### 2_09 common
	key[]: "aca_scenario_book1_2_09_title"
	val[]: "Parallelparkering"

	key[]: "aca_scenario_book1_2_09_desc"
	val[]: "I dette scenarie tager vi et kig på parallelparkering mellem to andre lastbiler."

#### 2_09 goal

	key[]: "aca_goal_book1_2_09_stopmid"
	val[]: "Stands foran parkeringspladsen"

	key[]: "aca_goal_book1_2_09_checkmirror"
	val[]: "Tjek bakspejlet"

	key[]: "aca_goal_book1_2_09_backward"
	val[]: "Bak ind på parkeringspladsen"

	key[]: "aca_goal_book1_2_09_stop"
	val[]: "Ret lastbilen til i parkeringspladsen"

#!{
	key[]: "aca_goal_book1_2_09_start"
