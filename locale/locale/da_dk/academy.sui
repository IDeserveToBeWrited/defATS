	val[]: "ANSVARSFRASKRIVELSE"

	key[]: "aca_book_disclaimer_topbar"
	val[]: "Dette er ikke et certificeret træningsprogram."

	key[]: "aca_book_disclaimer"
	val[]: "<color value=@@clr_sel@@><font face=/font/big_bold.font>@@driving_academy@@ er ikke beregnet til at erstatte i førerhustræning.</font><br><br> <color value=@@clr_txt@@>Vi anbefaler på det kraftigste, at du opsøger instruktion fra en akkrediteret lastbiluddannelsesinstitution, før du forsøger at betjene en lastbil i det virkelige liv, <br><br>. @@driving_academy@@ for at supplere i taxachaufføruddannelse kan kontakte os på academy@scssoft.com."

	key[]: "aca_book_book1_title"
	val[]: "Grundlæggende lastbilkørsel"

	key[]: "aca_book_book1_desc"
	val[]: "Lær de grundlæggende dele ved lastbilkørsel, fra grundlæggende funktioner og styring til at manøvrere med en trailer."

	key[]: "aca_book_book2_title"
	val[]: "Lastbilkørsels-færdigheder"

	key[]: "aca_book_book2_desc"
	val[]: "Finpuds dine evner for lastbilkørsel med nye scenarier under mere krævende forhold."

	key[]: "aca_book_book3_title"
	val[]: "Håndtering af dobbelttrailere"

	key[]: "aca_book_book3_desc"
	val[]: "Prøv de anderledes udfordringer ved at køre og bakke med en B-dobbeltkonfiguration."
#@}

