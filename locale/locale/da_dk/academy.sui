#+ Chapters general
#@{
	key[]: "aca_chapter_book1_1_title"
	val[]: "Grundlæggende styring og kørsel"

	key[]: "aca_chapter_book1_1_desc"
	val[]: "Lær grundlæggende fartøjsstyring samt hvordan du kører frem og bakker."

	key[]: "aca_chapter_book1_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Tillykke!<br>Du har fuldført kapitel 1: @@aca_chapter_book1_1_title@@.<br><br>Du har lært at klargøre lastbilen inden kørsel,<br>kørsel fremad og i bakgear samt hvordan du bruger lys og vinduesviskere.</font><br><br>"

	key[]: "aca_chapter_book1_2_title"
	val[]: "Grundlæggende manøvrering"

	key[]: "aca_chapter_book1_2_desc"
	val[]: "Lær at køre, manøvrere og parkere en trækker. Udforsk formålet med hver enkel type spejl og hvordan de bruges."

	key[]: "aca_chapter_book1_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Tillykke!<br>Du har fuldført kapitel 2: @@aca_chapter_book1_2_title@@.<br><br>Du har lært hvordan hvert spejl på lastbilen bruges, at kontrollere området omkring lastbilen før kørsel, og udføre både grundlæggende og avancerede manøvrer.</font>"

	key[]: "aca_chapter_book1_3_title"
	val[]: "Manøvrering med trailer"

	key[]: "aca_chapter_book1_3_desc"
	val[]: "Lær at tilkoble og manøvrere med en trailer i forskellige situationer."

	key[]: "aca_chapter_book1_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Tillykke!<br>Du har fuldført kapitel 3: @@aca_chapter_book1_3_title@@.<br><br>Du har lært at til- og frakoble en trailer,<br>fået føling for vægten og størrelsen af lastbilen med trailer<br>samt trailerkørsel på udfordrende ruter.</font><br><br>"

	key[]: "aca_chapter_book1_4_title"
	val[]: "Baglænskørsel med en trailer"

	key[]: "aca_chapter_book1_4_desc"
	val[]: "Lær nye manøvrer for effektiv baglænskørsel og parkering med en trailer."

	key[]: "aca_chapter_book1_4_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Tillykke!<br>Du har fuldført kapitel 4: @@aca_chapter_book1_4_title@@.<br><br>Du har lært at bakke med en trailer<br>samt forskellige parkeringsteknikker.</font><br><br>"

	key[]: "aca_chapter_book1_5_title"
	val[]: "Afsluttende eksamen"

	key[]: "aca_chapter_book1_5_desc"
	val[]: "Demonstrer din viden og dine evner og bevis, at du er en trucker!"

	key[]: "aca_chapter_book1_5_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Tillykke!<br>Du har fuldført kapitel 5: @@aca_chapter_book1_5_title@@.<br><br>Du har bevist, at du har alle de fornødne færdigheder<br>for kørsel, manøvrering og parkering af en lastbil!</font><br><br>"

	key[]: "aca_chapter_book2_0_title"
	val[]: "Varm motoren op"

	key[]: "aca_chapter_book2_0_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Du har gennemført træningen: @@aca_chapter_book2_0_title@@.<br><br>Du har lært regler og funktioner i kørefærdigheder.</font><br><br>"

	key[]: "aca_chapter_book2_1_title"
	val[]: "Tilbage i gear"

	key[]: "aca_chapter_book2_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Tillykke!<br>Du har gennemført kapitel 2: @@aca_chapter_book2_1_title@@.<br><br>Du har varmet motoren op, testet gearene, hjulene drejet ordentligt og kontrolleret bremseeffektiviteten. De næste kapitler bliver mere udfordrende.</font><br><br>"

	key[]: "aca_chapter_book2_2_title"
	val[]: "Hjul i bevægelse"

	key[]: "aca_chapter_book2_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Tillykke!<br>Du har gennemført kapitel 3: @@aca_chapter_book2_2_title@@.<br><br>Du har mestret vanskelige og varierede scenarier. Du har demonstreret færdigheder og præstation.</font><br><br>"

	key[]: "aca_chapter_book2_3_title"
	val[]: "Hjemmekampen"

	key[]: "aca_chapter_book2_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Tillykke!<br>Du har gennemført kapitel 4: @@aca_chapter_book2_3_title@@.<br><br>Du har håndteret mange vanskelige situationer med manøvrering, parkering og bakkekørsel med en trailer. Du har bevist, at du er en dygtig chauffør, der er i stand til at håndtere alle udfordrende lastbilkørselssituationer."

	key[]: "aca_chapter_book3_1_title"
	val[]: "Kørsel fremad"

	key[]: "aca_chapter_book3_1_desc"
	val[]: "Lær de essentielle teknikker for håndtering af en B-dobbelttrailer, når du kører fremad."

	key[]: "aca_chapter_book3_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Tillykke!<br>Du har fuldført kapitel 1: @@aca_chapter_book3_1_title@@.<br><br>Du har prøvet, hvordan man kører og manøvrerer effektivt med B-dobbelttrailere.</font><br><br>"

	key[]: "aca_chapter_book3_2_title"
	val[]: "Kørsel bagud"

	key[]: "aca_chapter_book3_2_desc"
	val[]: "Forstå de nødvendige trin for at håndtere en B-dobbelttrailere, når du bakker."

	key[]: "aca_chapter_book3_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Tillykke!<br>Du har fuldført kapitel 2: @@aca_chapter_book3_2_title@@.<br><br>Du har lært den eminente evne til at bakke med B-dobbelttrailere.</font><br><br>"

	key[]: "aca_chapter_book3_3_title"
	val[]: "Forberedelse til den virkelige verden"

	key[]: "aca_chapter_book3_3_desc"
	val[]: "Brug dine nye evner i mere avancerede scenarier."

	key[]: "aca_chapter_book3_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Tillykke!<br>Du har fuldført kapitel 3: @@aca_chapter_book3_3_title@@.<br><br>Du har håndteret mange, svære situationer i forbindelse med manøvrering, parkering og bakning med B-dobbelttrailere. Du har vist dine evner, og nu er det tid til at trække nogle B-dobler på vejene i American Truck Simulator!</font><br><br>"

#@}

