#@{

#### 3_01 common
	key[]: "aca_scenario_book1_3_01_title"
	val[]: "Tilkobl en trailer"

	key[]: "aca_scenario_book1_3_01_desc"
	val[]: "I dette scenarie forklarer vi, hvordan du kobler trækkeren til eller fra en trailer."

#### 3_01 goal

	key[]: "aca_goal_book1_3_01_check_con"
	val[]: "Bak til traileren"

	key[]: "aca_goal_book1_3_01_connect"
	val[]: "Tilkobl traileren"

	key[]: "aca_goal_book1_3_01_park_br_off"
	val[]: "Løsn håndbremsen"


	key[]: "aca_goal_book1_3_01_disc5"
	val[]: "Frakobl traileren"

