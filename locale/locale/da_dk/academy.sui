#### 3_04 msg - intro text

	key[]: "aca_msg_book1_3_04_cutscene01"
	val[]: "Husk at tænke fremad ved hvert sving og gør brug af pladsen omkring dig. Kør forbi det første sæt barrierer og ind på banen."

	key[]: "aca_msg_book1_3_04_cutscene02"
	val[]: "De første sving bliver gradvist skarpere, efterhånden som du kører."

	key[]: "aca_msg_book1_3_04_cutscene03"
	val[]: "Husk at den måde, du forlader ét sving på, kan påvirke, hvordan du kører ind i næste."

	key[]: "aca_msg_book1_3_04_cutscene04"
	val[]: "Det første af de mere udfordrende sving kombinerer to hårnålesving i ét. Du vil skulle være meget forsigtig og benytte spejlene i din kørsel."

	key[]: "aca_msg_book1_3_04_cutscene05"
	val[]: "Fortsæt gennem den smalle sektion."

	key[]: "aca_msg_book1_3_04_cutscene06"
	val[]: "Nu kommer et par lette sving på din vej mod et skarpt hårnålesving."

	key[]: "aca_msg_book1_3_04_cutscene07"
	val[]: "Husk at se dig omkring så du er sikker på, at du ikke rammer barriererne. Kør så langsomt, som du har brug for."

	key[]: "aca_msg_book1_3_04_cutscene08"
	val[]: "Selv hvor det ser ud, som om du har masser af plads til at manøvrere, kan du stadig ende i en snæver situation."

	key[]: "aca_msg_book1_3_04_cutscene09"
	val[]: "Det mest komplicerede sving kommer nu. Den måde, du kører ind i svinget, vil afgøre, om du kommer succesfuldt gennem det eller ej."

	key[]: "aca_msg_book1_3_04_cutscene10"
	val[]: "Fortsæt gennem det sidste sving."

	key[]: "aca_msg_book1_3_04_cutscene11"
	val[]: "Stands i det anviste område, sikr lastbilen og sluk motoren."
#!{
	key[]: "aca_msg_book1_3_04_cutscene12"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_04_cutscene13"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_04_cutscene14"
	val[]: "Unused"
#!}

#### 3_04 Driving Instructions



	key[]: "aca_msg_book1_3_04_forward"
	val[]: "<font face=/font/big_bold.font>Sæt farten op og kør forbi barriererne. </font>"

	key[]: "aca_msg_book1_3_04_check1"
	val[]: "Fortsæt ind på banen og gennem de første to lette sving.<br><br><font face=/font/big_bold.font>Fortsæt kørslen. </font>"

	key[]: "aca_msg_book1_3_04_check2"
	val[]: "<font face=/font/big_bold.font>Gennemfør 90 graders-svinget.</font>"

	key[]: "aca_msg_book1_3_04_check3"
	val[]: "Den næste del af banen er et dobbelt hårnålesving. Den måde, du manøvrerer gennem første del, vil påvirke din rute gennem anden del.<br><br><font face=/font/big_bold.font>Fortsæt forsigtigt. </font>"

	key[]: "aca_msg_book1_3_04_check4"
	val[]: "Hold til venstre for at gøre klar til den snævre sektion, når du forlader hårnålesvingene.<br><br><font face=/font/big_bold.font>Fortsæt kørslen. </font>"

	key[]: "aca_msg_book1_3_04_check5"
	val[]: "<font face=/font/big_bold.font>Fortsæt med at køre gennem den smalle sektion. </font>"

	key[]: "aca_msg_book1_3_04_check6"
	val[]: "Længere fremme er nogle lette 90 graders-sving.<br><br><font face=/font/big_bold.font>Gennemfør svingene. </font>"

	key[]: "aca_msg_book1_3_04_check7"
	val[]: "Du nærmer dig endnu et hårnålesving. Hold øje med din trailer i spejlet, mens du bevæger dig nærmere. <br><br><font face=/font/big_bold.font>Kør gennem hårnålesvinget. </font>"

	key[]: "aca_msg_book1_3_04_check8"
	val[]: "90 graders-svinget længere fremme er meget skarpere, end det ser ud. Brug din plads klogt.<br><br><font face=/font/big_bold.font>Fortsæt kørslen. </font>"

	key[]: "aca_msg_book1_3_04_check9"
	val[]: "Det sidste hårnålesving er kompliceret og har næsten ingen overskydende plads. <br><br><font face=/font/big_bold.font>Fortsæt forsigtigt.</font>"

	key[]: "aca_msg_book1_3_04_check10"
	val[]: "Et sidste 90 graders-sving venter dig.<br><br><font face=/font/big_bold.font>Fortsæt kørslen. </font>"

	key[]: "aca_msg_book1_3_04_check11"
	val[]: "Fortsæt til det anviste område."
#!{
	key[]: "aca_msg_book1_3_04_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_04_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

