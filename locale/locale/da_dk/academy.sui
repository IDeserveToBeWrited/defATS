#+ Book 1 Scenario 1_01
#@{

#### 1_01 common
	key[]: "aca_scenario_book1_1_01_title"
	val[]: "Før du kører"

	key[]: "aca_scenario_book1_1_01_desc"
	val[]: "I dit første scenarie gennemgår vi de grundlæggende ting i førerhuset. Det er vigtigt at indstille dit sæde, rat og dine sidespejle korrekt, da det er vigtigt at have godt udsyn i stressende og usikre situationer.<br><br>Vi gennemgår, hvordan du kan tilpasse disse dele én ad gangen."

#### 1_01 goal

	key[]: "aca_goal_book1_1_01_adjuster"
	val[]: "Indstilling af sæde og spejle"

	key[]: "aca_goal_book1_1_01_check_adj"
	val[]: "Spejl- og udsyntjek"

#### 1_01 msg - intro text

	key[]: "aca_msg_book1_1_01_cutscene1"
	val[]: "Velkommen til din første time!<br>Lad os starte med at gennemgå, hvordan du forbereder lastbilen til kørsel."

	key[]: "aca_msg_book1_1_01_cutscene2"
	val[]: "Det er essentielt at sikre dig, at din kørsel hele tiden er sikker, professionel og under kontrol.<br>Den rette indstilling af sæde, rat og spejle hjælper dig med at opnå dette."

	key[]: "aca_msg_book1_1_01_cutscene3"
	val[]: "På hver side af lastbilen er der nogle køretøjer.<br>De vil hjælpe dig med at indstille spejlene korrekt."

	key[]: "aca_msg_book1_1_01_cutscene4"
	val[]: "Tag dig god til til at indstille alt, som du foretrækker det, da disse indstillinger<br>vil have stor indflydelse på din evne til at styre lastbilen."

#### 1_01 Driving Instructions

	key[]: "adj_tut_title_0"
	val[]: "Indstilling af sæde og rat"

	key[]: "adj_tut_title_1"
	val[]: "Indstilling af hovedspejle"

	key[]: "adj_tut_title_2"
	val[]: "Indstilling af konvekse spejle"

	key[]: "adj_tut_title_3_hood"
	val[]: "Indstilling af skærmspejle"

	key[]: "adj_tut_title_3"
	val[]: "Udsynstjek og afsluttende spejltilpasning"

	key[]: "adj_tut_open_adj_keyboard"
	val[]: "tryk @@imv_nrm_adjuster@@ eller tilgå via køretøjsjusteringer i pausemenuen"

	key[]: "adj_tut_open_adj_gamepad"
	val[]: "tilgå det via køretøjsjusteringer i pausemenuen"

	key[]: "adj_tut_open_adj"
	val[]: "For at vise '@@adjust_link_t@@' når du spiller, $OPEN_ADJUSTER$."

	key[]: "adj_tut_open_seat"
	val[]: "Lad os først indstille sædet og rattet.<br><br><font face=/font/big_bold.font>Åbn @@adj_seats@@ for at fortsætte.</font>"

	key[]: "adj_tut_open_mirrors"
	val[]: "<font face=/font/big_bold.font>Åbn @@adj_mirrors@@ for at indstille spejlene.</font>"

	key[]: "adj_tut_open_adj_intro"
	val[]: "Når du sætter dig ind i en lastbil for første gang, er det vigtigt først at indstille sædet, rattet og spejlene, som du foretrækker dem.<br><br>Den rette placering bag rattet er essentiel for et godt udsyn. Alle dele bør være inden for rækkevidde, og føreren skal have klart udsyn fremad, til siderne og i spejlene.<br><br><font face=/font/big_bold.font>For at se indstillingsmenuen, $OPEN_ADJUSTER$. </font>"

	key[]: "adj_tut_set_seat_and_back_adj"
	val[]: "@@adj_tut_set_seat_and_back_adj_img@@<br>Tilpas sædet så du har klart udsyn til dine omgivelser og spejlene, og så du kan nå alt, du har brug for.<br><br>Tilpas rattet, så det er komfortabelt og ikke spærrer udsynet til nogle instrumenter.<br><br><font face=/font/big_bold.font>Når du er tilfreds, tryk @@imv_nrm_back@@ for at vende tilbage til konfigurationsmenuen. </font>"

	key[]: "adj_tut_open_mirrors_intro"
	val[]: "@@adj_tut_open_mirrors_intro_img@@<br>Lastbiler har mange, store blinde vinkler, så de er udstyret med flere spejle for at hjælpe føreren med at se så meget som muligt. <br><br>Den rette indstilling af disse spejle giver dig det bedste udsyn over dine omgivelser.<br><br><font face=/font/big_bold.font>Åbn @@adj_mirrors@@ for at fortsætte.</font>"

	key[]: "adj_tut_set_mirrors_t1_1_adj"
	val[]: "@@adj_tut_set_mirrors_t1_1_adj_img@@<br>Hovedspejlene dækker området langs siderne af lastbilen og traileren.<br><br>Brug bilerne på begge sider at køretøjet som referencer, når du indstiller hovedspejlene.<br><br><font face=/font/big_bold.font>Tryk @@imv_nrm_selectfcs@@ for at fortsætte.</font>"

	key[]: "adj_tut_set_mirrors_t1_2_adj"
	val[]: "Hovedspejlene er dit vigtigste værktøj for at se, hvad der foregår ved siden af og bag dig. Du bør have godt udsyn til bilen ved siden af dig, men vær sikker på også at have lidt af traileren i spejlet for lettere at kunne vurdere, hvor forhindringer er placeret i forhold til dig."

	key[]: "adj_tut_set_mirrors_t1_2_adj_big"
	val[]: "Skift til hovedspejlet på passagersiden, når du er tilfreds med indstillingen."

	key[]: "adj_tut_set_mirrors_t1_2_adj_moved"
	val[]: "Du vil igen skulle have et godt udsyn til bilen ved siden af dig, mens du også kan se lidt af traileren i spejlet."

	key[]: "adj_tut_set_mirrors_t1_2_adj_moved_big"
	val[]: "Skift til førersidens konvekse spejl, når du er tilfreds med indstillingen."

	key[]: "adj_tut_set_mirrors_t1_3_adj"
	val[]: "@@adj_tut_set_mirrors_t1_3_adj_img@@<br>Konvekse spejle giver et bredere udsyn, hvilket gør det muligt at se mere af, hvad der foregår ved siden af dig.<br><br><font face=/font/big_bold.font>Tryk @@imv_nrm_selectfcs@@ for at fortsætte.</font>"

	key[]: "adj_tut_set_mirrors_t1_4_adj"
	val[]: "Det vil være ideelt, hvis du kan se både bilen og lastbilen parkeret ved siden af, mens du også kan se en meget lille smule af din egen lastbil."

	key[]: "adj_tut_set_mirrors_t1_4_adj_big"
	val[]: "Skift til passagersidens konvekse spejl, når du er tilfreds med indstillingen."

	key[]: "adj_tut_set_mirrors_t1_4_adj_moved"
	val[]: "Du vil igen skulle kunne se både bilen og lastbilen parkeret ved siden af, mens du også kan se en lille smule af din egen lastbil."

	key[]: "adj_tut_set_mirrors_t1_4_adj_moved_big"
	val[]: "Skift til skærmspejlet, når du er tilfreds med indstillingen."

	key[]: "adj_tut_set_mirrors_t1_5_adj"
	val[]: "@@adj_tut_set_mirrors_t1_5_adj_img@@<br>Kølerhjelmsspejle giver udsyn til blinde vinkler på begge side af førerkabinen og hjælper dig med at se små biler og forhindringer, som ellers ville være skjult på grund af lastbilens størrelse.<br><br><font face=/font/big_bold.font>Tryk @@imv_nrm_selectfcs@@ for at fortsætte.</font>"

	key[]: "adj_tut_set_mirrors_t1_6_adj"
	val[]: "@@adj_tut_set_mirrors_t1_6_adj_img@@<br>Da du har andre spejle som hjælper dig med at se bagud, er disse spejle kun designet til at vise, hvad der er ved siden af dig. Armene på skærm- og sidespejlene giver dig gode referencepunkter til, hvor meget af din egen lastbil, som stadig bør kunne ses. Juster spejlene til den rette position som vist på diagrammet.<br><br><font face=/font/big_bold.font>Skift til skærmspejlet på passagersiden når du er tilfreds. </font>"

	key[]: "adj_tut_set_mirrors_t1_6_adj_moved"
	val[]: "@@adj_tut_set_mirrors_t1_6_adj_moved_img@@<br>Juster dette spejl på samme måde.<br><br><font face=/font/big_bold.font>Tryk @@imv_nrm_back@@ for at lukke spejlindstillingerne når du er tilfreds. </font>"

	key[]: "adj_tut_back_adj"
	val[]: "<font face=/font/big_bold.font>Tryk @@imv_nrm_back@@ for at vende tilbage til konfigurationsmenuen. </font>"

	key[]: "adj_tut_close_adj"
	val[]: "Super. Med det sæde og dine spejle indstillet korrekt er du et skridt tættere på at komme ud på vejen!<br><br><font face=/font/big_bold.font>Luk konfigurationsmenuen med @@imv_nrm_back@@. </font>"

	key[]: "adj_tut_open_con"
	val[]: "Tag endnu et kig rundt for at sikre dig, at du er tilfreds med dit udsyn fra førerhuset og at spejlene giver dig et godt udsyn til, hvad der sker omkring lastbilen.<br><br>Hvis noget ikke passer dig, kan du rette spejlene igen i '@@adjust_link_t@@' konfigurationemenuen. <br><br><font face=/font/big_bold.font>Tryk @@imv_nrm_activate@@ for at afslutte første scenarie.</font> @@aca_goal_tip@@ For at vise eller skjule brugerfladespejlene kan du gå til '@@adjust_link_t@@' — '@@adj_ui_mirrors@@' i pausemenuen. Brugerfladespejle gør det lettere at se din passagerside."
#@}

# Book 1 Scenario 1_02 - strings not needing translation
