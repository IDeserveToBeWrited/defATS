#### finex common

	key[]: "aca_scenario_book3_finex_title"
	val[]: "Afsluttende eksamen"

	key[]: "aca_scenario_book3_finex_desc"
	val[]: "I dette scenarie vil du få afprøvet dine nye evner på en bane designet til at teste din præcision og forståelse for, hvordan man kører med B-dobbelttrailere."

#### finex goal

	key[]: "aca_goal_book3_finex_check0"
	val[]: "Baglænskørsel"

	key[]: "aca_goal_book3_finex_check1"
	val[]: "Kør ind på banen"

	key[]: "aca_goal_book3_finex_check2"
	val[]: "Få hastigheden op"

	key[]: "aca_goal_book3_finex_check22"
	val[]: "Gør klar til at bremse"

	key[]: "aca_goal_book3_finex_speed"
	val[]: "For lav hastighed"

