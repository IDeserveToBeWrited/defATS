#### 3_19 msg - intro text

	key[]: "aca_msg_book1_3_19_cutscene01"
	val[]: "Velkommen til den første del af den afsluttende eksamen. Her vil vi finde ud af, hvor godt du har lært at føre en lastbil efter din tid i køreskolen."

	key[]: "aca_msg_book1_3_19_cutscene02"
	val[]: "Først skal du koble traileren til. Når den er tilkoblet, vil du køre hele testruten igennem."

	key[]: "aca_msg_book1_3_19_cutscene03"
	val[]: "Den første sektion af testen fører dig til nogle sideveje, som vil bringe dig mod bymidten."

	key[]: "aca_msg_book1_3_19_cutscene04"
	val[]: "Testruten indeholder forskellige typer sving og forhindringer."

	key[]: "aca_msg_book1_3_19_cutscene05"
	val[]: "En lille del af ruten går gennem bymidten."

	key[]: "aca_msg_book1_3_19_cutscene06"
	val[]: "Vi vil teste din evne til at manøvrere lastbilen forbi forskellige forhindringer og gennem forskellige baner."

	key[]: "aca_msg_book1_3_19_cutscene07"
	val[]: "Du vil møde forskellige situationer, som vil teste hvor opmærksom, du er på dine omgivelser."

	key[]: "aca_msg_book1_3_19_cutscene08"
	val[]: "Vi vil få dig til at bakke gennem et industrianlæg."

	key[]: "aca_msg_book1_3_19_cutscene09"
	val[]: "Efter at have kørt på veje, gennem byens centrum og i industrianlægget, går du mod @@driving_academy@@ hovedkvarteret."

	key[]: "aca_msg_book1_3_19_cutscene10"
	val[]: "En kort tur på vejen, og du er næsten færdig."

	key[]: "aca_msg_book1_3_19_cutscene11"
	val[]: "For at gennemføre testen skal du parkere nøjagtigt. Du kan vælge den manøvre, der passer bedst til dig."

	key[]: "aca_msg_book1_3_19_cutscene12"
	val[]: "Du behøver ikke være nervøs - du har allerede lært alt, du får brug for for at bestå.<br><br>Held og lykke!"

#### 3_19 Driving Instructions



	key[]: "aca_msg_book1_3_19_forward"
	val[]: "Først vil du skulle finde og tilkoble traileren. Den er parkeret længere fremme til højre.<br><br><font face=/font/big_bold.font>Kør frem mod traileren. </font>"

	key[]: "aca_msg_book1_3_19_coupling"
	val[]: "Drej til venstre og bak så mod traileren, mens du får trækkeren til at flugte med den.<br><br><font face=/font/big_bold.font>Bak mod traileren. </font>"

	key[]: "aca_msg_book1_3_19_park_br_on"
	val[]: "<font face=/font/big_bold.font>Sikr lastbilen. </font>"

	key[]: "aca_msg_book1_3_19_connect"
	val[]: "<font face=/font/big_bold.font>Tryk @@imv_nrm_attach@@ for at tilkoble traileren. </font>"

	key[]: "aca_msg_book1_3_19_park_br_off"
	val[]: "Traileren er tilkoblet, og lastbilen er klar til at køre.<br><br><font face=/font/big_bold.font>Løsn håndbremsen. </font>"

	key[]: "aca_msg_book1_3_19_b_trailer"
	val[]: "Vejen er blevet spærret af, så vi kan benytte den. Du vælger selv, om du vil følge eller ignorere skiltningen.<br><br><font face=/font/big_bold.font>Kør mod vejen. </font>"

	key[]: "aca_msg_book1_3_19_check01"
	val[]: "Fortsæt gennem de første sving. <br><br><font face=/font/big_bold.font>Fortsæt kørslen. </font>"

	key[]: "aca_msg_book1_3_19_check02"
	val[]: "Efter næste sving er der en slalombane lavet af trafikkegler.<br><br><font face=/font/big_bold.font>Kør forsigtigt gennem banen. </font>"

	#key[]: "aca_msg_book1_3_19_check02a"
	#val[]: "Continue through the roundabout into the town.<br><br><font face=/font/big_bold.font>Negotiate the roundabout.</font>"

	key[]: "aca_msg_book1_3_19_check02b"
	val[]: "Nogle få 90 graders-sving venter dig stadig. <br><br><font face=/font/big_bold.font>Fortsæt kørslen. </font>"

	key[]: "aca_msg_book1_3_19_check03"
	val[]: "Det næste sving er ekstremt snævert og vil kræve hele vejen for at klare det.<br><br><font face=/font/big_bold.font>Drej til højre og kør gennem gyden.</font>"

	key[]: "aca_msg_book1_3_19_check04"
	val[]: "Drej til venstre ud af gyden og drej så til højre ud på vejen.<br><br><font face=/font/big_bold.font>Fortsæt kørslen. </font>"

	key[]: "aca_msg_book1_3_19_check05"
	val[]: "Du kan slappe lidt af, mens du kører ned ad vejen. <br><br><font face=/font/big_bold.font>Kør lige frem. </font>"

	key[]: "aca_msg_book1_3_19_check06"
	val[]: "Der er nogle skarpe sving, når du kører ud på og af den mindre vej.<br><br><font face=/font/big_bold.font>Kør forsigtigt gennem svingene. </font>"

	key[]: "aca_msg_book1_3_19_check07"
	val[]: "Du har nået en mere kompleks slalombane. Fortsat langsomt frem og brug dine spejle. <br><br><font face=/font/big_bold.font>Fortsæt fremad og kør forsigtigt gennem slalombanen.</font>"

	key[]: "aca_msg_book1_3_19_check08"
	val[]: "Drej til venstre ind i industriområdet, pas på lyspælen.<br><br><font face=/font/big_bold.font>Drej. </font>"

	key[]: "aca_msg_book1_3_19_check09"
	val[]: "Forbered dig på at bakke.<br><br><font face=/font/big_bold.font>Drej til højre og stands i det afspærrede område. </font>"

	key[]: "aca_msg_book1_3_19_check10"
	val[]: "Bak og følg ruten til venstre bag dig.<br><br><font face=/font/big_bold.font>Begynd at bakke.</font>"

	key[]: "aca_msg_book1_3_19_check11"
	val[]: "Følg ruten til venstre. <br><br><font face=/font/big_bold.font>Bak videre. </font>"

	key[]: "aca_msg_book1_3_19_check12"
	val[]: "<font face=/font/big_bold.font>Kør frem og drej til højre. </font>"

	key[]: "aca_msg_book1_3_19_check13"
	val[]: "<font face=/font/big_bold.font>Fortsæt mod porten. </font>"

	key[]: "aca_msg_book1_3_19_check14"
	val[]: "Vent til porten er åbnet og fortsæt så tilbage på hovedvejen.<br><br><font face=/font/big_bold.font>Fortsæt kørslen. </font>"

	key[]: "aca_msg_book1_3_19_check15"
	val[]: "Vær forsigtig at du ikke rammer skiltet.<br><br><font face=/font/big_bold.font>Gennemfør svinget og fortsæt kørslen. </font>"

	key[]: "aca_msg_book1_3_19_check16"
	val[]: "<font face=/font/big_bold.font>Drej til venstre mod køreskolen. </font>"

	key[]: "aca_msg_book1_3_19_check17"
	val[]: "<font face=/font/big_bold.font>Fortsæt lige frem.</font>"

	key[]: "aca_msg_book1_3_19_check18"
	val[]: "Hold til ydersiden da der kommer et skarpt sving efter kurven.<br><br><font face=/font/big_bold.font>Følg kurven.</font>"

	key[]: "aca_msg_book1_3_19_check19"
	val[]: "<font face=/font/big_bold.font>Drej til venstre og gør klar til at parkere til venstre.</font>"

	key[]: "aca_msg_book1_3_19_check20"
	val[]: "<font face=/font/big_bold.font>Bak ind på parkeringspladsen.</font>"
#!{
	key[]: "aca_msg_book1_3_19_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_19_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_19_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
 #!}


#@}


#+ Book 1 Scenario 3_20
#@{

#### 3_20 common
	key[]: "aca_scenario_book1_3_20_title"
	val[]: "Afsluttende eksamen (del 2)"

	key[]: "aca_scenario_book1_3_20_desc"
	val[]: "Den sidste del af den afsluttende eksamen venter dig. Her vil de parkeringsfærdigheder, du har lært i de tidligere scenarier, blive evalueret. Parker forsigtigt og præcist, og du vil være klar til at køre ud på de amerikanske veje som en erfaren trucker!"

#### 3_20 goal
#!{
	key[]: "aca_goal_book1_3_20_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_20_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_20_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_20_forward"
	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}


	key[]: "aca_goal_book1_3_20_park1"
	val[]: "Forskudt manøvre"

	key[]: "aca_goal_book1_3_20_park2"
	val[]: "Diagonal parkering"

	key[]: "aca_goal_book1_3_20_park3"
	val[]: "Kør gennem parkeringspladsen"

	key[]: "aca_goal_book1_3_20_park4"
	val[]: "Parallelparkering"

	key[]: "aca_goal_book1_3_20_park5"
	val[]: "Sidste parkering"


#### 3_20 msg - intro text

	key[]: "aca_msg_book1_3_20_cutscene01"
	val[]: "Velkommen til anden del af den afsluttende eksamen. Vi vil begive os til en nærliggende parkeringsplads og teste dine evner, når det kommer til baglænskørsel og manøvrering i forbindelse med parkering."

	key[]: "aca_msg_book1_3_20_cutscene02"
	val[]: "Flere på hinanden følgende parkeringsudfordringer venter dig for at teste dine evner."

	key[]: "aca_msg_book1_3_20_cutscene03"
	val[]: "Der er begrænset plads her, så vær forsigtig og giv dig god tid."

	key[]: "aca_msg_book1_3_20_cutscene04"
	val[]: "Gør god brug af pladsen omkring dig og brug alle dine spejle som hjælp. Held og lykke!"




#### 3_20 outro text

	key[]: "aca_msg_book1_3_20_outro01"
	val[]: "Tillykke. Du har gennemført eksamenerne i Grundlæggende lastbilkørsel og har lært alle de færdigheder, som er nødvendige for at kunne manøvrere din lastbil succesfuldt."

	key[]: "aca_msg_book1_3_20_outro02"
	val[]: "Dette er første trin på din rejse mod at gøre din drøm om at blive professionel lastbilchauffør til virkelighed."

	key[]: "aca_msg_book1_3_20_outro03"
	val[]: "Du er nu klar til at køre ud på de amerikanske veje og møde dine første udfordringer..."

	key[]: "aca_msg_book1_3_20_outro04"
	val[]: "... men eventyret er kun lige begyndt."


#### 3_20 Driving Instructions

	key[]: "aca_msg_book1_3_20_start"
	val[]: "Husk at være forsigtig og ikke forhaste dig. Det er okay, hvis du ikke kan få den ind i første forsøg - det vigtigste er ikke at skade lastbilen eller dem, der befinder sig omkring dig. <font face=/font/big_bold.font><br><br>Gør klar til start. </font>"

	key[]: "aca_msg_book1_3_20_forward"
	val[]: "<font face=/font/big_bold.font>Kør frem til den første del af eksamenen.</font>"

	key[]: "aca_msg_book1_3_20_park1"
	val[]: "Din første opgave er at udføre den forskudte parkeringsmanøvre. Pladsen, du skal bakke traileren mod, ligger på din venstre side.<br><br><font face=/font/big_bold.font>Udfør en forskudt parkeringsmanøvre.</font>"

	key[]: "aca_msg_book1_3_20_park2"
	val[]: "Næste opgave er at bakke ind ved en række af parkerede lastbiler. Vær opmærksom på ikke at ramme de andre lastbiler!<br><br><font face=/font/big_bold.font>Foretag en diagonal parkeringsmanøvre.</font>"

	key[]: "aca_msg_book1_3_20_park3"
	val[]: "Fortsæt gennem parkeringspladsen. Hold øjnene åbne efter uventede situationer.<br><br><font face=/font/big_bold.font>Kør videre.</font>"

	key[]: "aca_msg_book1_3_20_park4"
	val[]: "Lad os nu prøve parallelparkering mellem de to lastbiler ved kantstenen længere fremme.<br><br><font face=/font/big_bold.font>Foretag en parallelparkering.</font>"

	key[]: "aca_msg_book1_3_20_park5"
	val[]: "Én sidste parkeringsmanøvre til venstre for dig! Du kan vælge at nærme dig den præcis, som du har lyst til.<br><br><font face=/font/big_bold.font>Bak ind på det angivne område.</font>"

	key[]: "aca_msg_book1_3_20_park6"
	val[]: "Vi er næsten færdige. Forlad testområdet og parker lastbilen.<br><br><font face=/font/big_bold.font>Forlad testområdet på din venstre side.</font>"

	key[]: "aca_msg_book1_3_20_stop"
	val[]: "Du kan parkere lastbilen til højre sammen med de andre.<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_20_end"
	val[]: "@@aca_msg_book1_2_01_end@@"


#!}

#@}


#+ Book 1 Scenario 3_22
#@{

#### 3_22 common
	key[]: "aca_scenario_book1_3_22_title"
	val[]: "Parallelparkering med trailer"

	key[]: "aca_scenario_book1_3_22_desc"
	val[]: "I dette scenarie tager vi et kig på parallelparkering med traileren tilkoblet."

#### 3_22 goal


	key[]: "aca_goal_book1_3_22_stopmid"
	val[]: "Stands i det markerede område"
#!{
	key[]: "aca_goal_book1_3_22_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_22_check1"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_22_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_22_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_22_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
  #!}
#### 3_22 msg - intro text

	key[]: "aca_msg_book1_3_22_cutscene1"
	val[]: "Parallelparkering med en trailer er en relevant færdighed for alle lastbilchauffører.<br>Hvad end det er parkering på gader i storbyer eller et stop på en rasteplads ude i landet, er det noget enhver chauffør bør mestre."

	key[]: "aca_msg_book1_3_22_cutscene2"
	val[]: "Hold godt øje når du passerer parkeringspladsen for at være sikker på, at der er plads nok til både trækker og trailer. I dette eksempel har vi sikret os, at du har masser af plads."

	key[]: "aca_msg_book1_3_22_cutscene3"
	val[]: "Flugt med lastbilen foran parkeringspladsen. Kør ikke for tæt på den, men hold lidt afstand, så du har plads til at manøvrere."

	key[]: "aca_msg_book1_3_22_cutscene4"
	val[]: "Drej skarpt væk fra parkeringspladsen og begynd at bakke. Idéen er at få traileren til straks at dreje ind på parkeringspladsen."

	key[]: "aca_msg_book1_3_22_cutscene5"
	val[]: "Når traileren peger godt ind på pladsen, kan du begynde at følge den."

	key[]: "aca_msg_book1_3_22_cutscene6"
	val[]: "Begynd at styre traileren væk fra kantstenen før dens hjul på førersiden har nået pladsen."

	key[]: "aca_msg_book1_3_22_cutscene7"
	val[]: "Ret trækkeren op i forhold til traileren og centrer dig herefter i parkeringsområdet.<br><br>Parker, sluk motoren og sikr køretøjet."

#### 3_22 Driving Instructions

	key[]: "aca_msg_book1_3_22_start"
	val[]: "Du kan se parkeringsområdet mellem de andre lastbiler foran dig. Vær sikker på at holde øje med dine spejle og hold sikker afstand mellem lastbilen og forhindringerne omkring dig, når du parkerer.<br><br><font face=/font/big_bold.font>Gør klar til start. </font>"

	key[]: "aca_msg_book1_3_22_check1"
	val[]: "Kør gennem pladsen for at finde din parkeringsplads.<br><br><font face=/font/big_bold.font>Kør fremad. </font>"

	key[]: "aca_msg_book1_3_22_stopmid"
	val[]: "<color value=@@clr_white@@>Kør forbi din ønskede parkeringsplads og ind på det markerede område. Herfra kan du begynde din bakkemanøvre.<br><br><font face=/font/big_bold.font>Stands på det markerede sted. </font>"

	key[]: "aca_msg_book1_3_22_backward"
	val[]: "Drej trækkeren væk fra punktet for at begynde at dreje traileren mod det. Drej ikke for kraftigt, ellers rammer du kantstenen. <br><br><font face=/font/big_bold.font>Begynd at bakke. </font>"

	key[]: "aca_msg_book1_3_22_stop"
	val[]: "Juster traileren med stedet. Gå om nødvendigt frem eller tilbage, mens du foretager de nødvendige styreinput for at justere din position.<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_22_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
 #!}

#@}

#+ Book 1 Scenario 3_21
#@{
#### 3_21 common
	key[]: "aca_scenario_book1_3_21_title"
	val[]: "At bakke fra et 45 graders udgangspunkt"

	key[]: "aca_scenario_book1_3_21_desc"
	val[]: "I dette scenarie udforsker vi 45 graders-udgangspunktet for baglænskørsel."

#### 3_21 goal
#!{
	key[]: "aca_goal_book1_3_21_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_21_forward"
	val[]: "@@aca_goal_book1_1_03_forward@@"

	key[]: "aca_goal_book1_3_21_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}
	key[]: "aca_goal_book1_3_21_check1"
	val[]: "Checkpoint"

	key[]: "aca_goal_book1_3_21_check2"
	val[]: "Få den korrekte afstand for baglænskørsel"

	key[]: "aca_goal_book1_3_21_stop"
	val[]: "Parker i det anviste område"



#### 3_21 msg - intro text

	key[]: "aca_msg_book1_3_21_cutscene1"
	val[]: "I denne lektion tager vi et kig på 45 graders-parkering. Når situationen tillader det, er det den foretrukne metode for mange, når det kommer til parkering. Ved at starte med, at traileren allerede peger i den retning, du vil køre, har du mindre brug for at manøvrere for at parkere."

	key[]: "aca_msg_book1_3_21_cutscene2"
	val[]: "Denne type opsætning giver dig også mulighed for at se længere ind på parkeringspladsen, hvilket giver bedre udsyn til, hvor du kører hen."

	key[]: "aca_msg_book1_3_21_cutscene3"
	val[]: "Kør et godt stykke forbi parkeringspladsen og drej, så du står i en vinkel på cirka 45 grader. Du skal sigte mod at få din trailer til at pege mod lastbilen på den fjerne side af den plads, du vil bakke ind på."

	key[]: "aca_msg_book1_3_21_cutscene4"
	val[]: "Drej lastbilen væk fra stedet for at flytte den forreste del af traileren rundt, og styr bagende mod parkeringspladsen. Pas på ikke at overdrive det. Når du først begynder at dreje, er det nemmere at gøre svinget skarpere end at udvide det."

	key[]: "aca_msg_book1_3_21_cutscene5"
	val[]: "Få trækkeren ind foran traileren, når traileren ruller ind på parkeringsområdet, og få de to til at flugte."

	key[]: "aca_msg_book1_3_21_cutscene6"
	val[]: "Stands på det angivne sted og sikr lastbilen."

#### 3_21 Driving Instructions
#!{
	key[]: "aca_msg_book1_3_21_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

	key[]: "aca_msg_book1_3_21_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
	key[]: "aca_msg_book1_3_21_forward"
	val[]: "Der er en parkeringsplads til venstre. Kør et godt stykke forbi den og drej til en 45 graders vinkel.<br><br><font face=/font/big_bold.font>Kør fremad. </font>"

	key[]: "aca_msg_book1_3_21_check1"
	val[]: "Få lastbilen til at flugte med markeringerne.<br><br><font face=/font/big_bold.font>Stands på det markerede område. </font>"

	key[]: "aca_msg_book1_3_21_check2"
	val[]: "Brug den viden du har fået i tidligere scenarier til at styre traileren ind på parkeringspladsen.<br><br><font face=/font/big_bold.font>Begynd at bakke. </font>"

	key[]: "aca_msg_book1_3_21_stop"
	val[]: "Fortsæt med at styre traileren ind på parkeringspladsen.<br><br>@@aca_msg_book1_2_01_stop@@"


#@}

