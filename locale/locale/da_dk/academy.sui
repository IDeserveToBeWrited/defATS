#### trckstp msg - intro text

	key[]: "aca_msg_book3_trckstp_cutscene1"
	val[]: "Det er ikke unormalt at ankomme til en plads, som er næsten helt fyldt op med lastbiler, så du selv har meget få valgmuligheder, når du skal parkere."

	key[]: "aca_msg_book3_trckstp_cutscene2"
	val[]: "I dette tilfælde er der kun en fri plads, hvor en B-dobbeltkombination kan passe ind. <br><br>Kør gennem pladsen og parker i kurven tæt på udkørslen."

#### trckstp Driving Instructions

#!{
	key[]: "aca_msg_book3_trckstp_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_trckstp_forward"
	val[]: "Find en vej gennem pladsen og parker langs kurven. <br><br>Fortsæt, når du er klar."

	key[]: "aca_msg_book3_trckstp_check1"
	val[]: "Der er ikke helt plads til dig gennem dette sving, så du vil være nødt til at bakke og finde en anden vej gennem."

	key[]: "aca_msg_book3_trckstp_check2"
	val[]: "Parker i kurven længere fremme."

	key[]: "aca_msg_book3_trckstp_stop"
	val[]: "Stands i det anviste område."

	key[]: "aca_msg_book3_trckstp_end"
	val[]: "Sikr lastbilen og sluk motoren."

#@}


