#+ Book 2 night_parallel
#@{
#### common
	key[]: "aca_scenario_book2_night_parallel_title"
	val[]: "Parallelparkering om natten"

	key[]: "aca_scenario_book2_night_parallel_desc"
	val[]: "I dette scenarie skal du parallelparkere ved siden af en kantsten. Det er nat, så sigtbarheden vil være begrænset."

#### intro text

	key[]: "aca_scenario_book2_night_parallel_cutscene1"
	val[]: "Tid og vejr er ikke altid ideelle, når du endelig skal parkere for natten, så du skal være ekstra opmærksom på dine omgivelser.<br><br>Glem ikke at tænde lyset!"

#@}


#+ Book 2 blindside_parking_options
#@{
#### common
	key[]: "aca_scenario_book2_blindside_parking_options_title"
	val[]: "Blinde beslutninger"

	key[]: "aca_scenario_book2_blindside_parking_options_desc"
	val[]: "I dette scenarie har du tre forskellige parkeringsbåse at bakke ind i fra den blinde side; hver enkelt vil byde på sin egen unikke udfordring."

#### intro text

	key[]: "aca_scenario_book2_blindside_parking_options_cutscene1"
	val[]: "Der er tre ledige parkeringspladser at vælge imellem. Hver af dem har en fordel til gengæld en omkostning, så vælg den, der passer bedst til din bakkestil."

#@}


#+ Book 2 driving_course
#@{
#### common
	key[]: "aca_scenario_book2_driving_course_title"
	val[]: "Snoet"

	key[]: "aca_scenario_book2_driving_course_desc"
	val[]: "I dette scenarie har du til opgave at køre gennem et meget komplekst træningsforløb. Undervejs skal du finde og koble til en trailer, og derefter tage den med dig til enden."

#### intro text

	key[]: "aca_scenario_book2_driving_course_cutscene1"
	val[]: "Dette scenarie vil teste din rumlige og situationsfornemmelse. Den forudestående rute er fuld af forhindringer, som du ikke altid let vil kunne få øje på."

	key[]: "aca_scenario_book2_driving_course_cutscene2"
	val[]: "Find vej gennem ruten til traileren. Når du har fundet den, skal du koble den til og trække den til den sidste parkeringsplads."

#@}

#+ Book 2 saturday_night
#@{
#### common
	key[]: "aca_scenario_book2_saturday_night_title"
	val[]: "Undslippe fra lastbilstoppestedet"

	key[]: "aca_scenario_book2_saturday_night_desc"
	val[]: "I dette scenarie skal du omhyggeligt finde vej ud af en fyldt parkeringsplads midt om natten."

#### intro text

	key[]: "aca_scenario_book2_saturday_night_cutscene1"
	val[]: "Desperat trætte chauffører parkerer hvor som helst de kan finde en plads, selvom det kan være ubelejligt for deres medbilister. <br><br>Arbejd dig gennem parkeringspladsen mod udgangen, men pas på ikke at ramme andre lastbiler!"

#@}


#+ Book 2 Streets
#@{
#### common
	key[]: "aca_scenario_book2_streets_title"
	val[]: "Kørsel i regnvejr"

	key[]: "aca_scenario_book2_streets_desc"
	val[]: "I dette scenarie vil du øve dig i at køre gennem byen på en våd overflade med reduceret sigtbarhed."

#### intro text

	key[]: "aca_scenario_book2_streets_cutscene1"
	val[]: "Din opgave er at køre langs den angivne rute. Svingene er primært 90-graders hjørner, så der burde ikke være meget, der kan overraske dig her."

#@}


#+ Book 2 threading_needle
#@{
#### common
	key[]: "aca_scenario_book2_threading_needle_title"
	val[]: "Spredt hjerne"

	key[]: "aca_scenario_book2_threading_needle_desc"
	val[]: "I dette scenarie skal du kreativt finde en måde at nå frem til alle vejpunkterne og til den endelige parkeringsplads."

#### intro text

	key[]: "aca_scenario_book2_threading_needle_cutscene2"
	val[]: "Nogle af dem kan være umulige at nå med traileren tilkoblet..."


#@}


