#+ Book 1 Scenario 3_09
#@{

#### 3_09 common
	key[]: "aca_scenario_book1_3_09_title"
	val[]: "Diagonal parkering"

	key[]: "aca_scenario_book1_3_09_desc"
	val[]: "I dette scenarie vil du parkere på i en diagonal-parkeringsplads i et travlt område. <br><br>Der er ikke megen plads at manøvrere på, så du vil skulle være meget præcis og velovervejet i din kørsel."

#### 3_09 goal

	key[]: "aca_goal_book1_3_09_check1"
	val[]: "Nærm dig parkeringspladsen"
#!{
	key[]: "aca_goal_book1_3_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_09_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_09_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
 #!}
#### 3_09 msg - intro text

	key[]: "aca_msg_book1_3_09_cutscene1"
	val[]: "Diagonale parkingspladser som denne er meget almindelige. Du vil kunne støde på dem ved rastepladser og lastbilstop over hele Amerika. <br>Vi vil igen skulle \"stikke snuden ind\" på parkeringspladsen længere fremme."

	key[]: "aca_msg_book1_3_09_cutscene2"
	val[]: "Kør mod den anviste parkeringsplads tæt på enden af rækken."

	key[]: "aca_msg_book1_3_09_cutscene3"
	val[]: "Hold mod midten af banen eller en anelse til venstre. Du skal give dig selv plads til at manøvrere traileren ind."

	key[]: "aca_msg_book1_3_09_cutscene4"
	val[]: "Kør et passende stykke forbi parkeringspladsen og drej så hårdt og hurtigt mod pladsen. Du skal holde øje med dit højre sidespejl for at sikre dig, at traileren når sikkert ind på parkeringspladsen."

	key[]: "aca_msg_book1_3_09_cutscene5"
	val[]: "Stands i det anviste område, sikr lastbilen og sluk motoren."


#### 3_09 Driving Instructions

	key[]: "aca_msg_book1_3_09_start"
	val[]: "@@aca_msg_book1_3_09_start_img@@<br>Når du parkerer diagonalt, er det vigtigt at bedømme din position nøjagtigt. Når du først er kommet et stykke ind i svinget, er det svært at vende og flytte dig sikkert, så det er ideelt at sikre dig, at du har plads nok i første forsøg.<br><br><font face=/font/big_bold.font >Gør klar til start. </font>"

	key[]: "aca_msg_book1_3_09_forward"
	val[]: "<font face=/font/big_bold.font>Begynd at køre mod parkeringspladsen. </font>"

	key[]: "aca_msg_book1_3_09_check1"
	val[]: "Kør forbi parkeringspladsen, så din trailer har plads til at dreje rundt om lastbilen på din inderside.<br><br><font face=/font/big_bold.font>Kør ind på parkeringspladsen. </font>"
#!{
	key[]: "aca_msg_book1_3_09_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}

#@}

#+ Book 1 Scenario 3_10
#@{

#### 3_10 common
	key[]: "aca_scenario_book1_3_10_title"
	val[]: "Baglænskørsel med blind vinkel"

	key[]: "aca_scenario_book1_3_10_desc"
	val[]: "I dette scenarie ser vi på baglænskørsel med blind vinkel. Uden at kunne se, hvor du kører hen ud af vinduet, er du nødt til at sætte din lid til spejlene alene for at komme frem til målet."

#### 3_10 goal
#!{
	key[]: "aca_goal_book1_3_10_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_10_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_10_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_10_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

 #!}
#### 3_10 msg - intro text

	key[]: "aca_msg_book1_3_10_cutscene1"
	val[]: "I dette scenarie vil du lære manøvren for baglænskørsel med blind vinkel. Denne type manøvrer bør generelt undgås med mindre der ikke er noget andet alternativ, da dit udsyn er meget begrænset. Tag dig god tid og vær meget forsigtig."

	key[]: "aca_msg_book1_3_10_cutscene2"
	val[]: "Kør et godt stykke forbi parkeringspladsen, så du har plads nok, når du begynder at bakke."

	key[]: "aca_msg_book1_3_10_cutscene3"
	val[]: "Stands helt op, tjek dine omgivelser og begynd så at bakke."

	key[]: "aca_msg_book1_3_10_cutscene4"
	val[]: "Drej trækkeren væk fra stedet. Dette vil skubbe fronten af traileren rundt og samtidig dreje trailerens bagende mod parkeringspladsen, du ønsker at benytte. Vær forsigtig ikke at dreje for hårdt, da du kan risikere, at trækker og trailer \"folder sammen\"."

	key[]: "aca_msg_book1_3_10_cutscene5"
	val[]: "Begynd at rette lastbilen op, når traileren bevæger sig ind på parkeringspladsen."

	key[]: "aca_msg_book1_3_10_cutscene6"
	val[]: "Stands i det angivne område og sikr lastbilen."

#### 3_10 Driving Instructions

	key[]: "aca_msg_book1_3_10_start"
	val[]: "Baglænskørsel med blind vinkel kræver samme procedurer som baglænskørsel med sideudsyn, men du vil være hæmmet af manglen på udsyn på den side. Brug dine spejle og din dømmekraft for at parkere lastbilen.<br><br><font face=/font/big_bold.font>Gør klar til start. </font>"

	key[]: "aca_msg_book1_3_10_forward"
	val[]: "Der er en parkeringsplads fremme til højre. Du vil skulle køre forbi den, så du har plads til at manøvrere, når du bakker.<br><br><font face=/font/big_bold.font>Kør fremad. </font>"
#!{
	key[]: "aca_msg_book1_3_10_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
	key[]: "aca_msg_book1_3_10_check2"
	val[]: "Husk at hvis du styrer lastbilen væk fra pladsen, vil traileren styre mod den. Brug dine spejle så godt du kan for at hjælpe dig til at ramme parkeringspladsen.<br><br><font face=/font/big_bold.font>Begynd at bakke. </font>"


#@}

#+ Book 1 Scenario 3_11
#@{

#### 3_11 common
	key[]: "aca_scenario_book1_3_11_title"
	val[]: "Kørsel i rundkørsel"

	key[]: "aca_scenario_book1_3_11_desc"
	val[]: "I dette scenarie ser vi på, hvordan man kommer gennem en rundkørsel.<br><br>Du skal holde særligt øje med din trailer, da den vil følge dig forskelligt, når du kører ind i, gennem og forlader rundkørslen."

#### 3_11 goal
#!{
	key[]: "aca_goal_book1_3_11_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_11_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


	key[]: "aca_goal_book1_3_11_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_11_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
 #!}

	key[]: "aca_goal_book1_3_11_check1"
	val[]: "Kør ind i rundkørslen"

	key[]: "aca_goal_book1_3_11_check2"
	val[]: "Kørsel i rundkørslen"

	key[]: "aca_goal_book1_3_11_check3"
	val[]: "Kørsel i rundkørslen"

	key[]: "aca_goal_book1_3_11_check5"
	val[]: "Forlad rundkørslen"

	key[]: "aca_goal_book1_3_11_check6"
	val[]: "Kør til det angivne område"

#### 3_11 msg - intro text

	key[]: "aca_msg_book1_3_11_cutscene1"
	val[]: "Rundkørsler bliver mere almindelige i Amerika, så det er vigtigt at vide, hvordan man kører gennem dem."

	key[]: "aca_msg_book1_3_11_cutscene3"
	val[]: "Hold mod ydersiden af din bane, mens du nærmer dig rundkørslen. Dette vil hjælpe dig med at holde traileren fri af indersiden, når du drejer ind."

	key[]: "aca_msg_book1_3_11_cutscene4"
	val[]: "Kør mod midten af rundkørslen, når du kører ind. Når du er i rundkørslen, vil du skulle styre mod ydersiden for at holde traileren fri af midten."

	key[]: "aca_msg_book1_3_11_cutscene5"
	val[]: "Hold øje med dit spejl for at sikre dig, at traileren ikke kommer for tæt på de inderste barrierer."

	key[]: "aca_msg_book1_3_11_cutscene6"
	val[]: "Det er forholdsvis let at forlade rundkørslen, da din trailer allerede befinder sig væk fra indersiden af udkørslen. Drej bredt når du kører ud, og traileren burde følge dig uden problemer."

	key[]: "aca_msg_book1_3_11_cutscene7"
	val[]: "Parker i det angivne område og sikr lastbilen."



#### 3_11 Driving Instructions
#!{
	key[]: "aca_msg_book1_3_11_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

	key[]: "aca_msg_book1_3_11_forward"
	val[]: "Foran dig er en rundkørsel, klar til at køre gennem. <br><br><font face=/font/big_bold.font>Kør langsomt nærmere rundkørslen. </font>"

	key[]: "aca_msg_book1_3_11_check1"
	val[]: "Drej vidt når du kører ind i rundkørslen, så din trailer kan følge dig uden problemer. <br><br><font face=/font/big_bold.font>Kør ind i rundkørslen. </font>"

	key[]: "aca_msg_book1_3_11_check2"
	val[]: "Kør mod ydersiden af rundkørslen. Du vil skulle holde lastbilen så langt væk fra midten som muligt for at holde din trailer væk fra midterbarriererne. <br><br><font face=/font/big_bold.font>Fortsæt gennem rundkørslen.</font>"

	key[]: "aca_msg_book1_3_11_check3"
	val[]: "Hold dig tæt på de yderste kegler. <br><br><font face=/font/big_bold.font>Kør videre.</font>"

	key[]: "aca_msg_book1_3_11_check5"
	val[]: "<font face=/font/big_bold.font>Forlad rundkørslen.</font>"

	key[]: "aca_msg_book1_3_11_check6"
	val[]: "<font face=/font/big_bold.font>Fortsæt til parkeringspladsen længere fremme. </font>"

	key[]: "aca_msg_book1_3_11_stop"
	val[]: "<font face=/font/big_bold.font>Stands i det anviste område. </font>"

	key[]: "aca_msg_book1_3_11_end"
	val[]: "<font face=/font/big_bold.font>Sikr lastbilen og sluk motoren. </font>"
#@}

#+ Book 1 Scenario 3_12
#@{

#### 3_12 common
	key[]: "aca_scenario_book1_3_12_title"
	val[]: "Manøvrering med begrænset plads"

	key[]: "aca_scenario_book1_3_12_desc"
	val[]: "I dette scenarie får du til opgave at vende lastbilen rundt på et trangt sted, hvilket vil kræve at du er opmærksomhed på dine omgivelser og smart udnyttelse af pladsen."

#### 3_12 goal



	key[]: "aca_goal_book1_3_12_check1"
	val[]: "Skift til bakgear"

	key[]: "aca_goal_book1_3_12_check2"
	val[]: "Forlad området"

	key[]: "aca_goal_book1_3_12_check3"
	val[]: "Bak ind på markeringen"

	key[]: "aca_goal_book1_3_12_check4"
	val[]: "Fuldførelse af den blinde vinkel"
#!{
	key[]: "aca_goal_book1_3_12_check5"
	val[]: "Unused"

	key[]: "aca_goal_book1_3_12_check6"
	val[]: "@@aca_goal_book1_3_11_check6@@"

	key[]: "aca_goal_book1_3_12_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_12_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_12_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_12_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"
 #!}

#### 3_12 msg - intro text

	key[]: "aca_msg_book1_3_12_cutscene01"
	val[]: "I dette scenarie gennemgår vi, hvordan man drejer, når der ikke er megen plads.<br>Du vil ikke altid have masser af plads til at manøvrere lastbilen og vil skulle tilpasse dig mindre ideelle situationer."

	key[]: "aca_msg_book1_3_12_cutscene02"
	val[]: "Kør gennem gyden mod det åbne område."

	key[]: "aca_msg_book1_3_12_cutscene03"
	val[]: "Til venstre er endnu en gyde, du vil skulle bakke ind i. Hav dette i baghovedet, når du placerer dig.<br>Det kan være en hjælp at forsøge at få traileren til at pege i retning af gyden, inden du begynder at bakke."

	key[]: "aca_msg_book1_3_12_cutscene04"
	val[]: "Bak mod gyden. Husk at holde øje med alle sider af trækker og trailer."

	key[]: "aca_msg_book1_3_12_cutscene05"
	val[]: "Der er forhindringer i gyden, så husk at holde mod førersiden."

	key[]: "aca_msg_book1_3_12_cutscene06"
	val[]: "Når du er færdig med at bakke, kan du fortsætte fremad og køre tilbage i den retning, du kom fra."

	key[]: "aca_msg_book1_3_12_cutscene07"
	val[]: "De kan måske have svært ved at se din trailer i sidespejlet på passagersiden, når du kører ud, så brug al den plads, du har, så godt som muligt."

	key[]: "aca_msg_book1_3_12_cutscene08"
	val[]: "Fortsæt mod udkørslen."

	key[]: "aca_msg_book1_3_12_cutscene09"
	val[]: "Parker i det angivne område og sikr lastbilen."
#!{
	key[]: "aca_msg_book1_3_12_cutscene10"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_12_cutscene11"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_12_cutscene12"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_12_cutscene13"
	val[]: "Unused"
#!}
#### 3_12 Driving Instructions

	key[]: "aca_msg_book1_3_12_start"
	val[]: "Foran dig er et område, der repræsenterer et rederi. Din opgave er at komme ind og vende lastbilen for at komme ud igen. Sørg for at gøre god brug af pladsen omkring dig.<br><br><font face=/font/big_bold.font>Gør klar til start </font>"

	key[]: "aca_msg_book1_3_12_forward"
	val[]: "<font face=/font/big_bold.font>Fortsæt gennem gyden. </font>"

	key[]: "aca_msg_book1_3_12_check1"
	val[]: "Lige efter bygningen til venstre ligger endnu en gyde, som du vil skulle bakke ind i. Hav dette i baghovedet.<br><br><font face=/font/big_bold.font>Fortsæt mod barriererne. </font>"



	key[]: "aca_msg_book1_3_12_check3"
	val[]: "Bak og drej traileren i retning af gyden. Du skal være sikker på ikke at ramme noget på højre side af trækkeren.<br><br><font face=/font/big_bold.font>Begynd at bakke og drej traileren ind i gyden. Stands i det markerede område. </font>"

	key[]: "aca_msg_book1_3_12_check4"
	val[]: "Du kan nu forlade området i samme retning, som du ankom. Gør god brug af pladsen, du har til rådighed.<br><br><font face=/font/big_bold.font>Kør frem og drej til højre. </font>"


	key[]: "aca_msg_book1_3_12_check6"
	val[]: "Fortsæt gennem gyden til det angivne område."
#!{
	key[]: "aca_msg_book1_3_12_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_12_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_12_check5"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_12_check2"
	val[]: "Unused"
#!}

#@}

#+ Book 1 Scenario 3_13
#@{

#### 3_13 common
	key[]: "aca_scenario_book1_3_13_title"
	val[]: "Forskudt bakkemanøvre"

	key[]: "aca_scenario_book1_3_13_desc"
	val[]: "I dette scenarie vil du skulle bakke ind på en parkeringsplads, som ikke er lige bag dig. Der er begrænset plads til at manøvrere, så du skal bruge den plads, der er, klogt."

#### 3_13 goal

#!{
	key[]: "aca_goal_book1_3_13_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_13_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_13_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_13_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

#!}

#### 3_13 msg - intro text

	key[]: "aca_msg_book1_3_13_cutscene01"
	val[]: "I dette scenarie skal du parkere i området ved siden af dig. Der er ikke megen plads til at manøvrere, så du vil skulle gøre lidt ekstra arbejde for at få traileren derhen, hvor du gerne vil have den."

	key[]: "aca_msg_book1_3_13_cutscene02"
	val[]: "Kør lige op til barrieren."

	key[]: "aca_msg_book1_3_13_cutscene03"
	val[]: "Stands inden barrieren."

	key[]: "aca_msg_book1_3_13_cutscene04"
	val[]: "Drej rattet skarpt til førersiden, før du bevæger dig. På denne måde begynder du at dreje traileren mod parkeringspladsen, så snart du begynder at bakke, hvilket sparer værdifuld plads."

	key[]: "aca_msg_book1_3_13_cutscene05"
	val[]: "Når du har traileren rettet i den retning, du ønsker, få trækkeren foran traileren og begynd at styre mod parkeringspladsen."

	key[]: "aca_msg_book1_3_13_cutscene06"
	val[]: "Herfra er det ikke så forskelligt fra en almindelig parkering."

	key[]: "aca_msg_book1_3_13_cutscene07"
	val[]: "Bliv ved med at bakke og hold øje med begge sider. Hold trækker og trailer flugtet med parkeringspladsen."

	key[]: "aca_msg_book1_3_13_cutscene08"
	val[]: "Stands i det anviste område, sikr lastbilen og sluk motoren."


#### 3_13 Driving Instructions

	key[]: "aca_msg_book1_3_13_start"
	val[]: "Du holder på en parkeringsplads, men der er en anden plads til højre for dig, som du skal flytte til.<br><br><font face=/font/big_bold.font>Gør klar til start. </font>"

	key[]: "aca_msg_book1_3_13_forward"
	val[]: "Der er et markeret område foran dig.<br><br><font face=/font/big_bold.font>Kør fremad. </font>"
#!{
	key[]: "aca_msg_book1_3_13_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

	key[]: "aca_msg_book1_3_13_check2"
	val[]: "Husk at begynde at styre med det samme, da der ikke er megen plads.<br><br><font face=/font/big_bold.font>Bak til den markerede plads bag dig. </font>"


#@}

#+ Book 1 Scenario 3_15
#@{

#### 3_15 common
	key[]: "aca_scenario_book1_3_15_title"
	val[]: "Kandegrebs- og knappekrogs-sving"

	key[]: "aca_scenario_book1_3_15_desc"
	val[]: "I dette scenarie tager du en kort køretur gennem en træningsbane, som vil hjælpe dig til at kunne manøvrere traileren gennem skarpe sving ved hjælp af to forskellige teknikker."

#### 3_15 goal
#!{
	key[]: "aca_goal_book1_3_15_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_15_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_15_check6"
	val[]: "@@aca_goal_book1_3_11_check6@@"

	key[]: "aca_goal_book1_3_15_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_15_end"
	val[]: "@@aca_goal_book1_2_01_end@@"


 #!}
	key[]: "aca_goal_book1_3_15_check1"
	val[]: "Kandegrebs-sving"

	key[]: "aca_goal_book1_3_15_check2"
	val[]: "Kurve og lige sektion"

	key[]: "aca_goal_book1_3_15_check3"
	val[]: "Knappekrogs-sving"

	key[]: "aca_goal_book1_3_15_check4"
	val[]: "Lige sektion og kurve"

	key[]: "aca_goal_book1_3_15_check5"
	val[]: "Kombinationssving"



#### 3_15 msg - intro text

	key[]: "aca_msg_book1_3_15_cutscene01"
	val[]: "Foran dig er der nogle skarpe sving med begrænset plads.<br>De vil hjælpe dig med at lære at manøvrere traileren effektivt."

	key[]: "aca_msg_book1_3_15_cutscene02"
	val[]: "@@aca_msg_book1_3_15_cutscene02_img@@<br>Det første sving kræver en kandegrebs-manøvre. Dette begreb bruges, når du har sving med begrænset plads på den vej, du drejer ind på, og i stedet er nødt til at bruge ekstra plads på vejen, du drejer fra."

	key[]: "aca_msg_book1_3_15_cutscene03"
	val[]: "Følg banemarkeringerne for at dreje trækkeren langt fra den indre kantsten.<br>Dette vil bringe din trailer væk fra kantstenen, så du vil have plads nok til at manøvrere."

	key[]: "aca_msg_book1_3_15_cutscene04"
	val[]: "Hold dig tæt på forhindringen, når du kører ud af svinget, så traileren bliver ved med at følge den størst mulige kurve."

	key[]: "aca_msg_book1_3_15_cutscene05"
	val[]: "For at holde trailerens hjul fra kantstenen må du holde trækkeren mod midten af vejen, når du kører ind i den lange kurve."

	key[]: "aca_msg_book1_3_15_cutscene06"
	val[]: "Fortsæt langs vejen."

	key[]: "aca_msg_book1_3_15_cutscene07"
	val[]: "@@aca_msg_book1_3_15_cutscene07_img@@<br>Det næste sving kræver en \"knappekrogs\"-manøvre. Det er den foretrukne teknik, da den ikke åbner vejsporet bag dig, så en uopmærksom trafikkant kan smutte op på din højre side. Brug altid denne manøvre, når der er plads nok på den vej, du drejer ind på."

	key[]: "aca_msg_book1_3_15_cutscene08"
	val[]: "Kør dybt ind i krydset og drej hurtigt og skarpt til højre."

	key[]: "aca_msg_book1_3_15_cutscene09"
	val[]: "Når du kommer op på siden af forhindringen, kan du rette op og igen holde dig til venstre side af din kørebane.<br>Alt dette hjælper med at holde trailerens hjul væk fra kantstenen."

	key[]: "aca_msg_book1_3_15_cutscene10"
	val[]: "Fortsæt frem mod næste kurve."

	key[]: "aca_msg_book1_3_15_cutscene11"
	val[]: "Hold igen mod midten af vejen for at holde trailerens hjul væk fra kantstenen."

	key[]: "aca_msg_book1_3_15_cutscene12"
	val[]: "Svinget længere fremme er særligt problematisk. I situationer som denne, vil du ikke have ideelle tilstande for hverken et kandegrebs-sving eller et knappekrogs-sving, og du vil være nødt til at kombinere begge manøvrer for at nå frem."

	key[]: "aca_msg_book1_3_15_cutscene13"
	val[]: "Drej vidt inden svinget, kør dybt ind i krydset og drej så hurtigt ind. Igen er det ideelt at holde sig så tæt på forhindringen som muligt for at holde svinget så bredt som muligt."

	key[]: "aca_msg_book1_3_15_cutscene14"
	val[]: "Parker i det anviste område, sikr lastbilen og sluk motoren."

	# Book 1 Scenario 3_15 formatting
#!{
	key[]: "aca_msg_book1_3_15_cutscene02_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/jug_handle.mat bottom=p256 right=p256 color=FFFFFFFF></align><offset vshift=256>"

	key[]: "aca_msg_book1_3_15_cutscene07_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/button_hook.mat bottom=p256 right=p256 color=FFFFFFFF></align><offset vshift=256>"

#!}


#### 3_15 Driving Instructions

	key[]: "aca_msg_book1_3_15_forward"
	val[]: "Husk at bruge alt den plads, du har, for at komme gennem hvert sving.<br><br><font face=/font/big_bold.font>Begynd at køre og følg vejmarkeringerne til venstre. </font>"

	key[]: "aca_msg_book1_3_15_check1"
	val[]: "Brug al den plads, du har, til at dreje bredt og hold traileren væk fra den indre kantsten.<br><br><font face=/font/big_bold.font>Gennemfør et kandegrebs-sving. </font>"

	key[]: "aca_msg_book1_3_15_check2"
	val[]: "Hold mod midten af vejen gennem kurven og fortsæt så lige frem mod næste sving.<br><br><font face=/font/big_bold.font>Fortsæt kørslen. </font>"

	key[]: "aca_msg_book1_3_15_check3"
	val[]: "Der er begrænset plads på venstre side, så du må køre dybt ind i krydset for at holde traileren fra kantstenen.<br><br><font face=/font/big_bold.font>Lav et knappekrogs-sving. </font>"

	key[]: "aca_msg_book1_3_15_check4"
	val[]: "Kør videre og gennem næste kurve.<br><br><font face=/font/big_bold.font>Fortsæt kørslen. </font>"

	key[]: "aca_msg_book1_3_15_check5"
	val[]: "Dette er det hidtil skarpeste sving, og du vil skulle bruge flere manøvrer.<br><br><font face=/font/big_bold.font>Gennemfør svinget og kør så vidt som muligt.</font>"

	key[]: "aca_msg_book1_3_15_check6"
	val[]: "<font face=/font/big_bold.font>Fortsæt til parkeringspladsen længere fremme til højre. </font>"
#!{
	key[]: "aca_msg_book1_3_15_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_15_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_15_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}


#@}

#+ Book 1 Scenario 3_16
#@{

#### 3_16 common
	key[]: "aca_scenario_book1_3_16_title"
	val[]: "Diagonal parkering i bakgear"

	key[]: "aca_scenario_book1_3_16_desc"
	val[]: "I dette scenarie vil vi udforske diagonal parkering, når man bakker. Dette kan forekomme i hvileområder, lastbilstop og selv ved afsendere. Der er ofte begrænset plads, fordi der er mange lastbiler omkring dig, hvilket gør parkering tilsvarende sværere."

#### 3_16 goal

	key[]: "aca_goal_book1_3_16_check1"
	val[]: "Drej traileren"
#!{
	key[]: "aca_goal_book1_3_16_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_16_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_16_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_16_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
 #!}
#### 3_16 msg - intro text

	key[]: "aca_msg_book1_3_16_cutscene1"
	val[]: "Diagonalparkering ser ved første øjekast lettere ud, men kan ofte være mere udfordrende en typiske \"gydeparkerings\"-manøvrer."

	key[]: "aca_msg_book1_3_16_cutscene2"
	val[]: "Bak mod parkeringspladsen. Hold trækker og trailer lige indtil videre."

	key[]: "aca_msg_book1_3_16_cutscene3"
	val[]: "Lad din trailer komme tættere på de parkerede lastbiler efterhånden som du nærmer dig. Det vil gøre det lettere for dig at dreje ind på pladsen, når du når den."

	key[]: "aca_msg_book1_3_16_cutscene4"
	val[]: "Begynd at dreje traileren ind på parkeringspladsen. Hold din trailer tæt på lastbilen på førersiden, da du får brug for pladsen på den anden side."

	key[]: "aca_msg_book1_3_16_cutscene5"
	val[]: "Begynd at dreje trækkeren for at følge efter, når traileren er godt inde på parkeringspladsen."

	key[]: "aca_msg_book1_3_16_cutscene6"
	val[]: "Parker i det anviste område, sikr lastbilen og sluk motoren."

#### 3_16 Driving Instructions

	key[]: "aca_msg_book1_3_16_start"
	val[]: "Parker lastbilen på pladsen bag dig. Brug begge dine spejle til at navigere efter, når du bakker.<br><br><font face=/font/big_bold.font>Gør klar til start. </font>"

	key[]: "aca_msg_book1_3_16_backward"
	val[]: "Tjek dine omgivelser og kør så mod parkeringspladsen.<br><br><font face=/font/big_bold.font>Begynd at bakke.</font>"

	key[]: "aca_msg_book1_3_16_check1"
	val[]: "Begynd at styre traileren mod lastbilerne ved siden af dig. Drej den ind på parkeringspladsen, når du er klar. Husk at dens bagende svinger ud.<br><br><font face=/font/big_bold.font>Drej ind på parkeringspladsen. </font>"
#!{
	key[]: "aca_msg_book1_3_16_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_16_end"
	val[]: "@@aca_msg_book1_2_01_end@@"


 #!}


#@}

#+ Book 1 Scenario 3_17
#@{

#### 3_17 common
	key[]: "aca_scenario_book1_3_17_title"
	val[]: "Baglænskørsel ind i et sving"

	key[]: "aca_scenario_book1_3_17_desc"
	val[]: "I dette scenarie vil vi for første gang bakke en trailer ind i et sving. Vi gennemgår de grundlæggende principper for baglænskørsel og hvad, du skal holde øje med, når du drejer, mens du bakker."

#### 3_17 goal

	key[]: "aca_goal_book1_3_17_check1"
	val[]: "Drej traileren"
#!{
	key[]: "aca_goal_book1_3_17_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_17_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_17_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_17_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
 #!}
#### 3_17 msg - intro text

	key[]: "aca_msg_book1_3_17_cutscene01"
	val[]: "I dette scenarie skal du bakke ind på parkeringspladsen, som er bag dig på førersiden."

	key[]: "aca_msg_book1_3_17_cutscene02"
	val[]: "Der findes nogle forskellige tips, som vil være en stor hjælp, når du skal bakke med trailere. <br>Det første er, at traileren altid vil dreje i den modsatte retning af den vej, du styrer trækkeren."

	key[]: "aca_msg_book1_3_17_cutscene03"
	val[]: "Det andet er, at du kan gøre dig et godt indtryk af, hvor traileren bevæger sig hen ved at holde øje med akslerne på lastbil og trailer."

	key[]: "aca_msg_book1_3_17_cutscene04"
	val[]: "For det tredje vil små korrektioner være nok til at få dig derhen, du ønsker. Der er ingen grund til at overdrive."

	key[]: "aca_msg_book1_3_17_cutscene05"
	val[]: "Begynd at dreje trækkeren en smule væk fra parkeringspladsen, og traileren vil begynde at pege mod den."

	key[]: "aca_msg_book1_3_17_cutscene06"
	val[]: "Følg traileren og lav korrektioner, mens du kører, for at holde den på rette kurs."

	key[]: "aca_msg_book1_3_17_cutscene07"
	val[]: "Hold øje med dine trailerhjul og det bagerste hjul på trækkeren. De vil fortælle dig hvilken retning, traileren peger i, og hvor trækkeren skubber den hen."

	key[]: "aca_msg_book1_3_17_cutscene08"
	val[]: "Et fjerde tip er, at det altid er lettere at dreje traileren skarpere, end det er at forsøge at rette op, når den er foldet helt sammen mod trækkeren. Sigt efter ydersiden af pladsen, indtil du er tættere på den. Så kan du dreje lidt skarpere for at rette traileren ind."

	key[]: "aca_msg_book1_3_17_cutscene09"
	val[]: "Få trækkeren foran traileren, når traileren ruller ind på parkeringspladsen. Prøv at undgå for mange justeringer på selve pladsen."

	key[]: "aca_msg_book1_3_17_cutscene10"
	val[]: "Bak mellem barriererne og tjek begge sider, mens du kører."

	key[]: "aca_msg_book1_3_17_cutscene11"
	val[]: "Sikr lastbilen og sluk motoren."

#### 3_17 Driving Instructions

	key[]: "aca_msg_book1_3_17_start"
	val[]: "Husk disse tips, når du bakker ind i et sving med en trailer:<br><br>— Traileren drejer i modsat retning af trækkeren<br><br>— Hold øje med trailerens hjul for at se hvilken retning, den bevæger sig i<br><br>— Hold øje med trækkerens bagerste hjul for at se hvilken retning, den skubber traileren i<br><br>— Lad traileren gøre arbejdet. Undgå at overstyre<br><br>— Det er altid lettere at få traileren til at dreje skarpere, end det er at få den til at rette op<br><br><font face=/font/big_bold.font>Gør klar til start. </font>"

	key[]: "aca_msg_book1_3_17_backward"
	val[]: "Se bag dig for at finde ud af hvor du skal hen. Tjek altid dine omgivelser, før du begynder at bakke.<br><br><font face=/font/big_bold.font>Begynd at bakke mod parkeringspladsen.</font>"

	key[]: "aca_msg_book1_3_17_check1"
	val[]: "<font face=/font/big_bold.font>Begynd at dreje traileren mod parkeringspladsen og følg den ind.</font>"

	key[]: "aca_msg_book1_3_17_stop"
	val[]: "<font face=/font/big_bold.font>Stands i det anviste område. </font>"
#!{
	key[]: "aca_msg_book1_3_17_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_18
#@{

#### 3_18 common
	key[]: "aca_scenario_book1_3_18_title"
	val[]: "Gydeparkerings-manøvre"

	key[]: "aca_scenario_book1_3_18_desc"
	val[]: "I dette scenarie får du til opgave at bakke traileren ind i en gyde forbundet med en lille vej."

#### 3_18 goal

	key[]: "aca_goal_book1_3_18_check1"
	val[]: "Drej traileren"
#!{
	key[]: "aca_goal_book1_3_18_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_18_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


	key[]: "aca_goal_book1_3_18_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_18_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

 #!}
#### 3_18 msg - intro text

	key[]: "aca_msg_book1_3_18_cutscene01"
	val[]: "Det er nødvendigt at benytte en \"Gydeparkerings-manøvre\" for at parkere her.<br>Dette er en normal manøvre for lastbilchauffører, da de møder denne type parkeringssituation næsten dagligt, hvad end det er for at laste eller losse en trailer eller for at parkere for natten."

	key[]: "aca_msg_book1_3_18_cutscene02"
	val[]: "Denne manøvre minder om sidste scenarie, men du vil have mindre plads til rådighed, så du vil skulle planlægge, hvad ud vil gøre, og være forsigtig ikke at ramme noget."

	key[]: "aca_msg_book1_3_18_cutscene03"
	val[]: "Da der er mindre plads, bliver din timing vigtigere. Drej traileren på det rette tidspunkt og hold øje med trækkerens og trailerens hjul for at se hvilken retning, den vil bevæge sig i. Husk på, at bagenden kan slå ud og undgå at \"folde sammen\" - blev ved med at skubbe traileren."

	key[]: "aca_msg_book1_3_18_cutscene04"
	val[]: "Prøv at styre traileren i retning af gyden så tidligt som muligt. Dette vil give dig plads på den anden side til at dreje fronten af traileren rundt og få trækkeren ind foran den."

	key[]: "aca_msg_book1_3_18_cutscene05"
	val[]: "Få trækkeren foran traileren, når traileren er i gyden. Det er bedre at gøre dette en smule tidligere, end dit instinkt måske fortæller dig. Du kan altid rette til, når du bakker til din endelige plads."

	key[]: "aca_msg_book1_3_18_cutscene06"
	val[]: "Få trækker og trailer på linje og stands på den anviste plads."

	key[]: "aca_msg_book1_3_18_cutscene07"
	val[]: "Sikr lastbilen og sluk motoren."


#### 3_18 Driving Instructions

	key[]: "aca_msg_book1_3_18_start"
	val[]: "Nu vil vi prøve at vende en trailer på et meget mindre område med en \"gydeparkerings-manøvre\". <br><br><font face=/font/big_bold.font>Gør klar til start. </font>"

	key[]: "aca_msg_book1_3_18_backward"
	val[]: "Tjek dine omgivelser og find parkeringspladsen bag dig. <br><br><font face=/font/big_bold.font>Begynd at bakke mod parkeringspladsen. </font>"

	key[]: "aca_msg_book1_3_18_check1"
	val[]: "<font face=/font/big_bold.font>Drej traileren ind på parkeringspladsen.</font>"
#!{
	key[]: "aca_msg_book1_3_18_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_18_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}


#@}

#+ Book 1 Scenario 3_19
#@{

#### 3_19 common
	key[]: "aca_scenario_book1_3_19_title"
	val[]: "Afsluttende eksamen (del 1)"

	key[]: "aca_scenario_book1_3_19_desc"
	val[]: "Den afsluttende eksamen venter dig, hvor alle de færdigheder, du har lært i de foregående scenarier, vil blive testet. Vi vil tage en køretur gennem hele træningscentret for at se, hvor godt du har lært de situationer, du har mødt indtil nu.<br><br>Når du har gennemført alle sektioner og manøvrer, vil du være et skridt tættere på at kalde dig en trænet chauffør!"

