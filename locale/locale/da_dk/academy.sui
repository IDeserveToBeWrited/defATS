	key[]: "aca_msg_book3_intro_cutscene05"
	val[]: "Først baglænskørsel ..."

	key[]: "aca_msg_book3_intro_cutscene06"
	val[]: "... og korrigering af de mest almindelige fejl"

	key[]: "aca_msg_book3_intro_cutscene07"
	val[]: "Kørsel på brede veje"

	key[]: "aca_msg_book3_intro_cutscene08"
	val[]: "At dreje gennem smalle steder."

	key[]: "aca_msg_book3_intro_cutscene09"
	val[]: "Og endda lave lidt sjov til sidst.<br><br> Held og lykke!"
