#+ Book 3 Scenario Truckstop Angle
#@{

#### trckstp common

	key[]: "aca_scenario_book3_trckstp_title"
	val[]: "Parkering langs en kurve"

	key[]: "aca_scenario_book3_trckstp_desc"
	val[]: "I dette scenarie skal du køre gennem en travl plads fuld af ubelejligt parkerede lastbiler for til sidst at parkere langs en kurve."

#### trckstp goal

#!{
	key[]: "aca_goal_book3_trckstp_check1"
