	#### diag common

	key[]: "aca_scenario_book3_diag_title"
	val[]: "Diagonalparkering med B-dobbelttrailere"

	key[]: "aca_scenario_book3_diag_desc"
	val[]: "I dette scenarie vil du parkere din B-dobbeltkombination på et diagonalt parkeringssted på en travl plads. "

#### diag msg - intro text

	key[]: "aca_msg_book3_diag_cutscene1"
	val[]: "Diagonale parkeringssteder som her er meget almindelige. De ses især ved ældre lastbilstop, såvel som de mange rastepladser langs de amerikanske motorveje."

	key[]: "aca_msg_book3_diag_cutscene2"
	val[]: "Kør mod den anviste plads tæt på enden af rækken."

	key[]: "aca_msg_book3_diag_cutscene3"
	val[]: "Hold dig mod ydersiden af sporet, men ikke for tæt på barrieren, da trailerens bagende kan ramme den, når du drejer ind."

	key[]: "aca_msg_book3_diag_cutscene4"
	val[]: "Kør forbi parkeringsstedet for at gøre plads, så begge trailere kan følge dig ind. Drej herefter mod den fjerne ende af parkeringsstedet for at få den forreste trailer i den rette position."

	key[]: "aca_msg_book3_diag_cutscene5"
	val[]: "Ret op og stands så i det angivne område og sikr lastbilen."

#### diag Driving Instructions

#!{
	key[]: "aca_msg_book3_diag_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_diag_forward"
	val[]: "Fortsæt mod enden af rækken for at finde dit parkeringssted."

	key[]: "aca_msg_book3_diag_check1"
	val[]: "Kør forbi parkeringsstedet for at sikre dig, at din bagerste trailer vil følge dig korrekt ind på plads. Drej herefter ind mens du sikrer dig, at forenden af den forreste trailer ikke rammer lastbilen ved siden af dig."

	key[]: "aca_msg_book3_diag_stop"
	val[]: "Fortsæt langsomt, mens du retter kombinationen op, og stands så i det markerede område."

#!{
	key[]: "aca_msg_book3_diag_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


