#+ Text deviations for American Truck Simulator. Please, use only terms appropriate for USA (i.e. culture specific nuances, not American English).
#@{

#+ Music/radio player
#@{

#+ Hint shown if no music files are found. Also shown as tooltip when hovering over music_player button.

	key[]: "music_player_hint"
	val[]: "Jarri itzazu zure abestiak <color value=@@clr_sel@@>American Truck Simulator/music <color value=@@clr_txt@@>karpetan zure <color value=@@clr_sel@@>Dokumentuetan <color value=@@clr_txt@@>eta hemen ikusiko dituzu."

#+ Tooltip shown when hovering over the radio_stream button.

	key[]: "radio_hint"
	val[]: "Edita ezazu <color value=@@clr_sel@@>live_streams.sii<color value=@@clr_txt@@>, <color value=@@clr_sel@@>American Truck Simulator<color value=@@clr_txt@@> karpetan, zure <color value=@@clr_sel@@>Dokumentuetan<color value=@@clr_txt@@> eta entzun zure internet-irrati gustukuenak jokoan bertan!"

#+ Hint shown if no online radio streams are defined.

	key[]: "empty_radio_hint"
	val[]: "Mesedez, irakurri <color value=@@clr_sel@@>readme.rtf <color value=@@clr_txt@@> <color value=@@clr_sel@@>American Truck Simulator <color value=@@clr_txt@@>helbidean, <color value=@@clr_sel@@>Dokumentuak <color value=@@clr_txt@@>karpetan, zure irrati 'stream'-ak gehitzeko."
#@}

