#+ Washington TBs and POIs localization.
#@{
	key[]: "tb_wa1"
	val[]: "Olimpijski polotok"

	key[]: "tb_wa1_desc"
	val[]: "Olimpijski polotok razkriva kraj, kjer morje, gozd in gore sobivajo v nenehno spreminjajoči se lepoti. Megla se vali nad skalnatimi obalami, medtem ko se slapovi spuščajo z višavja, kjer skrite doline dajejo zavetje majhnim zgodovinskim krajem."

	key[]: "poi_wa1_01"
	val[]: "Zgodovinska poštna stavba Združenih držav Amerike"

	key[]: "poi_wa1_01_desc"
	val[]: "Zgradba, ki je bila dokončana leta 1893 na pečini nad obalo mesta Port Townsend, je bila zasnovana kot zvezna ustanova s carinsko postajo, kar odraža zgodnje ambicije mesta postati središče mednarodne trgovine."

	key[]: "poi_wa1_02"
	val[]: "Port Angeles"

	key[]: "poi_wa1_02_desc"
	val[]: "Port Angeles je obalno mesto, ki je bilo ustanovljeno v 19. stoletju kot pristanišče in oskrbovalna točka. Danes služi kot ključna vstopna točka v nardoni park Olympic in trajektno pristanišče, ki povezuje Združene države Amerike in Kanado."

	key[]: "poi_wa1_03"
	val[]: "Jezero Crescent"

	key[]: "poi_wa1_03_desc"
	val[]: "Jezero Crescent, drugo najgloblje jezero v Washingtonu, je znano po svoji živo modri, kristalno čisti vodi, ki je posledica nizke ravni dušika. Nahaja se na priljubljenem rekreacijskem območju, ki ga obdajajo pohodniške poti in pragozd."
	
	key[]: "poi_wa1_04"
	val[]: "Plaža Kalaloch"

	key[]: "poi_wa1_04_desc"
	val[]: "Plaža Kalaloch je znana po \"drevesu življenja\", sitkanski smreki z golimi koreninami, ki se raztezajo čez majhen potok do obale. Za razliko od tipičnih visokih smrek je nižja, debelejša in odporna na veter, zaradi česar je edinstvena in priljubljena lokalna znamenitost."

	key[]: "poi_wa1_05"
	val[]: "Narodni park Olympic"

	key[]: "poi_wa1_05_desc"
	val[]: "Narodni park Olympic varuje raznolike ekosisteme, od razgibane pacifiške obale in zmernih deževnih gozdov, do alpskih vrhov. Leta 1909 je bil prvič razglašen za narodni spomenik, leta 1938 pa ga je zvezna vlada preimenovala v narodni park."

	key[]: "poi_wa1_06"
	val[]: "Greenhead Slough"

	key[]: "poi_wa1_06_desc"
	val[]: "Greenhead Slough je majhen zaliv in mokrišče ob avtocesti 101 blizu zaliva Willapa. Leži se znotraj obalnega estuarijskega habitata, ki je bil obnovljen za drstenje lososov in opazovanje številnih vodnih ptic."

	key[]: "poi_wa1_07"
	val[]: "Zaliv Dabob"

	key[]: "poi_wa1_07_desc"
	val[]: "Zaliv Dabob je globok fjord, v katerem živijo lososi, školjke in divje živali. Naravno območje zaliva Dabob, ustanovljeno leta 1984, varuje redke rastlinske skupnosti slanih močvirij in peščenih sipin znotraj visoko funkcionalnega sistema plimskih mokrišč."


##########################################################################################

	key[]: "tb_wa2"
	val[]: "Osrčje"

	key[]: "tb_wa2_desc"
	val[]: "Osrčje Washingtona vabi popotnike na slikovite ceste skozi zimzelene gozdove in mirna alpska jezera. Na obzorju dominira gora Mount Rainier, ki ponuja slovite razglede in mirno potovanje v naravne pokrajine pacifiškega severozahoda."

	key[]: "poi_wa2_01"
	val[]: "Gora Rainier"

	key[]: "poi_wa2_01_desc"
	val[]: "Gora Rainier, najvišji vrh Washingtona s 4371 metri, je aktiven stratovulkan. Njeni ledeniki napajajo reke, oblikujejo doline ter omogočajo obstoj bogatih gozdov in divje živali, zaradi česar je ta gora pomembna naravna znamenitost."

	key[]: "poi_wa2_02"
	val[]: "Narodni gozd Wanatchee"

	key[]: "poi_wa2_02_desc"
	val[]: "Narodni gozd Wenatchee se razteza čez gore, reke in alpske doline. Leta 1933 je Civilni korpus za ohranjanje narave tukaj zgradil poti in požarne razgledne točke, kar je pustilo trajen pečat v rekreacijski in naravovarstveni zgodovini gozda."

	key[]: "poi_wa2_03"
	val[]: "Narodni gozd Mt. Baker SNOQMALMIE"

	key[]: "poi_wa2_03_desc"
	val[]: "V narodnem gozdu Mt. Baker Snoqualmie so nekatera najstarejša mesta za spremljanje ledenikov v Ameriki, ki spremljajo vulkanske tokove ledu in podnebne spremembe v gorovju Cascades že od začetka 20. stoletja."
	
	key[]: "poi_wa2_04"
	val[]: "Reka Wanatchee"

	key[]: "poi_wa2_04_desc"
	val[]: "Ob reki Wenatchee ostanki namakalnih kanalov in mlinov iz začetka 19. stoletja prikazujejo, kako so naseljenci izkoriščali njeno vodo. Tudi domorodna plemena so se že dolgo pred prihodom evropskih naseljencev zanašala na njene vode, bogate z lososi, kot vir hrane in jo uporabljale tudi za trgovino."

	key[]: "poi_wa2_05"
	val[]: "Vrh Klawatti"

	key[]: "poi_wa2_05_desc"
	val[]: "Vrh Klawatti, ki je bil prvič osvojen v sredini 20. stoletja, ostaja zaradi strmih z ledeniki pokritih pobočij redko obiskan, kar ga naredi za zaželen izziv za alpiniste, ki iščejo samoto v severnem delu gorovja Cascades."

	key[]: "poi_wa2_06"
	val[]: "Jez Dry Falls"

	key[]: "poi_wa2_06_desc"
	val[]: "Jez Dry Falls, zgrajen za urejanje lokalnih vodotokov, stoji na vrhu prazgodovinskih bazaltnih pečin, uravnava sezonske pretoke in hkrati razkriva terase ter globoke tolmune, ki so jih izklesale poplave iz ledene dobe."

	key[]: "poi_wa2_07"
	val[]: "Razgledna točka na goro White Fire"

	key[]: "poi_wa2_07_desc"
	val[]: "Na razgledni točki so postavljene turistične table o požaru v gorovju White Mountain iz leta 1988, enem največjih gozdnih požarov v nedavni zgodovini zvezne države Washington, ki razkrivajo brazgotine in vzorce ponovne rasti v gozdu."

	key[]: "wa_cut_helen_desc"
	val[]: "Pred letom 1980 je imel vulkan Mount St. Helens stožčasto obliko in so ga imenovali gora Fuji Amerike. Izbruh leta 1980 je odstranil 395 metrov njegovega vrha in oblikoval podkvasti krater, ki ga trenutno delno zapolnjujeta lava in ledenik."


##########################################################################################


	key[]: "tb_wa3"
	val[]: "Vinska dežela"

	key[]: "tb_wa3_desc"
	val[]: "Vzhodno od gorovja Cascades se v dolini Columbia (AVA) razprostira vinska dežela Washingtona. Regija vključuje potok Selah Creek, državni park Lewis and Clark ter zemljišča, ki so jih v preteklosti naseljevali staroselci, s suhimi, sončnimi pokrajinami in valovitimi hribi ter rečnimi dolinami."

	key[]: "poi_wa3_01"
	val[]: "Slapovi Clear Creek"

	key[]: "poi_wa3_01_desc"
	val[]: "Razgledna točka slapov Clear Creek je priljubljena postaja vzhodno od vrha White Pass. Približno miljo naprej proti vzhodu odcep vodi do rekreacijskega območja Clear Lake, znanega po ribolovu in odličnih možnostih za opazovanje lokalnih divjih živali."

	key[]: "poi_wa3_02"
	val[]: "Most Selah Creek"

	key[]: "poi_wa3_02_desc"
	val[]: "Most Freda G. Redmona, znan tudi kot most Selah Creek, je most z dvema lokoma v okrožju Yakima. Ob dokončanju je bil najdaljši betonski lokasti most v Ameriki in najvišji avtomobilski most v tej zvezni državi."

	key[]: "poi_wa3_03"
	val[]: "Vinogradi"
	
	key[]: "poi_wa3_03_desc"
	val[]: "V rodovitnih dolinah zvezne države Washington uspeva veliko sort vinske trte, med drugim rizling, cabernet in merlot. Vinogradi so pomemben del kmetijstva te zvezne države in lokalnih pokrajin."

	key[]: "poi_wa3_04"
	val[]: "Most Ed Hendler"

	key[]: "poi_wa3_04_desc"
	val[]: "Most, zgrajen leta 1978, ki ga včasih imenujejo tudi most Intercity, prečka reko Columbia med mestoma Pasco in Kennewick v jugovzhodnem delu zvezne države Washington. Od odprtja velja za znamenitost in simbol regije Tri-Cities."

	key[]: "poi_wa3_05"
	val[]: "Državni park Lewis and Clark"

	key[]: "poi_wa3_05_desc"
	val[]: "Državni park Lewis and Clark, eden prvih državnih parkov v Washingtonu, ohranja starodavne gozdove ob zgodovinski poti avtohtonih prebivalcev. Gozdovi, poimenovani v čast Corps of Discovery, spominjajo na goste gozdove, ki jih je Meriwether Lewis opisal v svojih dnevnikih."

	key[]: "poi_wa3_06"
	val[]: "Deželno sodišče Columbia"

	key[]: "poi_wa3_06_desc"
	val[]: "Deželno sodišče Columbia odraža obdobje, ko je bila deželna uprava osrednjega pomena za vsakdanje življenje. V času hitre rasti in omejenih stikov z državno prestolnico so sodne palače služile kot glavni vir avtoritete in zadovoljevale nujne potrebe državljanov."

	key[]: "poi_wa3_07"
	val[]: "Indijanska plemena"

	key[]: "poi_wa3_07_desc"
	val[]: "V dolini Columbia in okoliških območjih so nekoč živeli avtohtoni prebivalci, med njimi plemena Yakama, Walla Walla in Umatilla. Danes te skupnosti še vedno živijo v tej regiji, ohranjajo kulturne tradicije ter upravljajo z zemljišči in vodnimi viri."

##########################################################################################

#@}




#+ Oregon TBs and POIs localization.
#@{
	key[]: "tb_or1"
	val[]: "Pacifiška obala"

	key[]: "tb_or1_desc"
	val[]: "Pacifiška obala Oregona se razteza skozi strme rte z razglednimi točkami. Medtem ko svetilnik Heceta Head gleda na razbijajoče se valove, se Silver Point, Ophir Wayside, Sisters Rocks in Kissing Rock z bazaltnimi pečinami spuščajo v pacifiške valove."

	key[]: "landmark_or_astoria_b_desc"
	val[]: "Most, ki se razteza čez reko Columbia v dolžini štirih milj, povezuje Oregon in Washington, ponuja razgled na ustje reke in obzorje Tihega oceana."

	key[]: "poi_or1_01"
	val[]: "Razgledna točka Silver Point"

	key[]: "poi_or1_01_desc"
	val[]: "Južno od plaže Cannon Beach ponuja ta razgledna točka čudovit razgled na Haystack Rock in razgibano obalo, še posebej osupljivo ob sončnem zahodu."

	key[]: "or_cut_lighthouse_desc"
	val[]: "Najvišji svetilnik Oregona, zgrajen leta 1873, stoji na bazaltnem rtu blizu Newporta."

	key[]: "or_cut_newport_desc"
	val[]: "Most Yaquina Bay, dokončan leta 1936, je ena najbolj slovitih obalnih znamenitosti Oregona. Njegov elegantni lok, ki ga je zasnoval priznani inženir Conde McCullough, se razprostira čez zaliv Yaquina in ostaja prepoznavna značilnost ameriške ceste Route 101."

	key[]: "or_cut_thor_desc"
	val[]: "Naravna vrtača na rtu Cape Perpetua, kjer se valovi zrušijo in ustvarjajo iluzijo, da ocean odteka."

	key[]: "poi_or1_02"
	val[]: "Ophir Wayside"

	key[]: "poi_or1_02_desc"
	val[]: "Mirno parkirišče v bližini Gold Beacha, kjer se obiskovalci lahko razgibajo, opazujejo valove ali po plaži preiskujejo naplavljeno leseno vejevje in agate."

	key[]: "poi_or1_03"
	val[]: "Razgledna točka Sisters Rock"

	key[]: "poi_or1_03_desc"
	val[]: "Dramatični morski grebeni se dvigajo iz valov, s potmi, ki vodijo do majhnih plaž, skriti med pečinami."

	key[]: "poi_or1_04"
	val[]: "Kissing Rock"

	key[]: "poi_or1_04_desc"
	val[]: "Postanek ob cesti južno od Gold Beacha, kjer se nad peskom nagibata druga proti drugi dve ogromni skalni formaciji, zaradi česar je to priljubljena točka za fotografiranje."


##########################################################################################

	key[]: "tb_or2"
	val[]: "Wild East"

	key[]: "tb_or2_desc"
	val[]: "Ta regija, ki jo pogosto imenujejo \"divji vzhod\" Oregona, razkriva pokrajine, ki so jih oblikovale geološke sile skozi stotine milijonov let, mnoge pa so aktivne še danes. V primerjavi s tem ogromnim časovnim obsegom je človeška zgodovina kratka, a jo zaznamujejo trenutki, ki so prav tako dramatični kot sama pokrajina."

	key[]: "landmark_or_deadman_p_desc"
	val[]: "V bližini Pendletona ta razgledna točka ponuja pogled na prelaz Deadman Pass, ki je dobil ime po dogodku iz leta 1870 med Bannockovo vojno, ko so tam našli mrtvega voznika voza. Desetletja prej so te hribe po poti Oregon Trail prečkali nešteti vozovi."

	key[]: "or_cut_395_desc"
	val[]: "Nekoč znana kot avtocesta treh zastav, se je avtocesta US-395 raztezala od Kanade do Mehike in povezovala puščave, gozdove in gore. Danes se konča pri avtocesti US-15 v Kaliforniji, čeprav so ostanki prvotne trase ostali v bližini San Diega."

	key[]: "poi_or2_01"
	val[]: "Narodni gozd Malheur"

	key[]: "poi_or2_01_desc"
	val[]: "Narodni gozd Malheur leži v gorah Blue Mountains. Pred več kot 150 milijoni let so nekatere najstarejše kamnine v tej regiji tvorile del vulkanskih otokov v Pacifiku, kasneje pa so se združile s celino."
	
	key[]: "poi_or2_02"
	val[]: "Divjina Badlands"

	key[]: "poi_or2_02_desc"
	val[]: "Divjina Badlands, vzhodno od Benda, je robustna vulkanska pokrajina, ki so jo oblikovali starodavni tokovi lave in vulkanski pepel, ki ga je napihnil veter. Njene zavite formacije lave, peščena tla in surov teren ustvarjajo eno najbolj edinstvenih visokogorskih puščavskih okolij v državi."

	key[]: "poi_or2_03"
	val[]: "Jezero Abert"

	key[]: "poi_or2_03_desc"
	val[]: "Jezero Abert, ki je bilo prvič kartirano leta 1843, je že več kot 10.000 let podpiralo človeško prisotnost. Čeprav je preveč slano za ribe, ostaja pomembna postaja za ptice vzdolž pacifiške selitvene poti in se je v zadnjih desetletjih zaradi podnebnih sprememb krči."

	key[]: "poi_or2_04"
	val[]: "Turistična pot East Steens"

	key[]: "poi_or2_04_desc"
	val[]: "Turistična pot East Steens sledi avtocesti 78 vzdolž gore Steens Mountain in puščave Alvord Desert. Njen vrhunec je puščavska plaža Alvord Desert, eno največjih suhih jezer v Oregonu, ki se sezonsko spreminja med plitvim jezerom in prostrano puščavsko ravnino."

	key[]: "poi_or2_05"
	val[]: "Doherty Slide"

	key[]: "poi_or2_05_desc"
	val[]: "Vožnja po Doherty Slideu, skalni formaciji, ki je nastala zaradi vulkanske aktivnosti, traja manj kot eno uro. Vendar je narava potrebovala približno 16 milijonov let, da je oblikovala pokrajino, kot jo vidimo danes."


##########################################################################################

	key[]: "tb_or3"
	val[]: "Država Ogden"

	key[]: "tb_or3_desc"
	val[]: "Ta pot sledi severno južnemu koridorju v notranjosti Oregona, mimo gozdov in visoke puščave. Prvič jo je v dvajsetih letih 19. stoletja raziskal trgovec s krznom Peter Skene Ogden, med drugo svetovno vojno pa je pridobila strateški pomen zaradi lesnih in transportnih poti."
	
	key[]: "poi_or3_01"
	val[]: "Springfield Flame"

	key[]: "poi_or3_01_desc"
	val[]: "Skoraj 20 metrov visok kip označuje severna vrata Springfielda. Zasnovan kot plamen, služi pa kot svetilnik za popotnike in znamenitost za prebivalce in obiskovalce."

	key[]: "poi_or3_02"
	val[]: "Cesta Santiam Wagon"

	key[]: "poi_or3_02_desc"
	val[]: "Prelaz vzhodno od tu, nekoč imenovan Wiley Pass po Andrewu Wileyju, so leta 1859 raziskali pionirji, ki so iskali pašne poti. Vojaška cesta je bila načrtovana leta 1864, vendar večinoma ni bila zgrajena. Cestnina, Santiam Wagon Road, je obratovala od leta 1868 do 1914."

	key[]: "poi_or3_03"
	val[]: "Zgodovinska avtocesta veteranov"

	key[]: "poi_or3_03_desc"
	val[]: "Na severnem delu avtoceste, južno od križišča Biggs, sta bila 9. novembra 2012 postavljena zadnja dva od 18 spominskih tabel. Označujeta Camp Rufus kot severno vstopno točko na prvo avtocesto v državi, posvečeno veteranom druge svetovne vojne."

	key[]: "poi_or3_04"
	val[]: "Razgleda točka države Ogden"

	key[]: "poi_or3_04_desc"
	val[]: "Obcestna pot je poimenovana po Petru Skeneju Ogdenu, raziskovalcu iz začetka 19. stoletja in glavnem trgovcu družbe Hudson's Bay Company. Zgrajena je bila v čast njegovim odpravam po deželi reke Snake in njegovi vlogi med prvimi raziskovalci porečja slanega jezera Great Salt Lake Basin."

	key[]: "landmark_or_fremont_b_desc"
	val[]: "Most in ulica Fremont v Portlandu sta poimenovana po Johnu C. Frémontu, enem od prvih raziskovalcev Las Californiasa in območja Oregona. Ima najdaljši glavni razpon v Oregonu in se uvršča med druge najdaljše mostove z vezanimi loki na svetu."

	
##########################################################################################

#@}



#+ California TBs and POIs localization.
#@{
	key[]: "tb_ca1"
	val[]: "Golden Horizon"

	key[]: "tb_ca1_desc"
	val[]: "Nad bleščečo vodo se dvigajo znameniti mostovi, ki povezujejo Alcatraz, Santa Cruz ter hribe in soseske te regije. Od živahnih ulic in zgodovinskih znamenitosti do sončnih plaž in slikovitih obalnih območij - Bay Area ponuja edinstveno kalifornijsko doživetje."

	key[]: "ca_cut_golden_gate_bridge_desc"
	val[]: "Most, ki povezuje zaliv San Francisco s Tihim oceanom, je slovit simbol San Francisca in Kalifornije. Ob odprtju leta 1937 je držal rekord za najdaljši in najvišji viseči most na svetu."

	key[]: "poi_ca1_01"
	val[]: "Alcatraz"

	key[]: "poi_ca1_01_desc"
	val[]: "Na otoku Alcatraz je med letoma 1934 in 1963 deloval zvezni zapor. Otok, znan po tem, da so v njem bili zaprti nekateri najbolj zloglasni zločinci v državi, je danes zgodovinska znamenitost in priljubljena turistična destinacija."

	key[]: "ca_cut_richmond_desc"
	val[]: "Most Richmond–San Rafael se razteza čez zaliv San Francisco in povezuje mesti Richmond in San Rafael. Odprt je bil leta 1956, omogoča promet čez severni zaliv in ima konzolno-rešelastno zasnovo ter služi kot ključna regionalna prometna povezava."
	
	key[]: "poi_ca1_02"
	val[]: "Otok Treasure Island"

	key[]: "poi_ca1_02_desc"
	val[]: "Treasure Island je umetni otok, zgrajen za mednarodno razstavo Golden Gate leta 1939. Po tem, ko je služil kot mornariška baza, se zdaj preureja za stanovanjske in poslovne namene."

	key[]: "poi_ca1_03"
	val[]: "Mesto surfanja"

	key[]: "poi_ca1_03_desc"
	val[]: "Kip surferja v Santa Cruzu je posvečen dediščini in kulturi surfanja v mestu. Postavljen je v bližini obale in slavi lokalne surferje ter šport, ki je oblikoval identiteto Santa Cruza in njegovo obalno skupnost."

	key[]: "poi_ca1_04"
	val[]: "Madonna Inn"

	key[]: "poi_ca1_04_desc"
	val[]: "Nekdanja priljubljena restavracija in znamenitost dogodkov na vrhu avtoceste 152 je zaradi težav z avtocesto bila leta 2004 zaprta. Od takrat pa ostaja pogosta tema na forumih o lokalni zgodovini in zgodbah o duhovih."



##########################################################################################

	key[]: "tb_ca2"
	val[]: "Pot Shasta"

	key[]: "tb_ca2_desc"
	val[]: "Pot Shasta se vije skozi borove gozdove in vodi mimo lesketajočih se alpskih jezer pod goro Shasta. Ceste se vzpenjajo in spuščajo, popotnike peljejo proti jugu skozi skrite doline, medtem ko gore postopoma bledijo in se umikajo starodavnim sekvojam severne Kalifornije."

	key[]: "poi_ca2_01"
	val[]: "Nacionalni gozd Shasta - Trinity"

	key[]: "poi_ca2_01_desc"
	val[]: "Nacionalni park Shasta–Trinity je največji v Kaliforniji. Prečka ga slikovita cesta Trinity Heritage Scenic Byway, ki vodi po poteh rudarjev zlata in prvih naseljencih iz 19. stoletja."

	key[]: "poi_ca2_02"
	val[]: "Velika laguna"

	key[]: "poi_ca2_02_desc"
	val[]: "Velika laguna ali Big Lagoon je največja in najjužnejša od treh lagun v državnem parku Humboldt Lagoons. Gre za plitve obalne kotanje, ležijo med skalnatimi rtovi. Oceanski valovi so namreč zgradili peščene pregrade, ki ločujejo lagune od Tihega oceana."

	key[]: "or_cut_sequoia_desc"
	val[]: "Narodni park Redwood je dom najvišjim in najstarejšim obalnim sekvojam na svetu, ki dosegajo več kot 112 metrov in živijo tudi do 2000 let. S pomočjo bližnjih državnih parkov ohranja približno 35 % preostalih starodavnih gozdov sekvoje na planetu."
	
	key[]: "poi_ca2_03"
	val[]: "Reka Smith"

	key[]: "poi_ca2_03_desc"
	val[]: "Nacionalni gozd Six Rivers v severozahodni Kaliforniji je kongres leta 1990 razglasil za zaščiteno območje z namenom ohranitve slikovitih, ekoloških in kulturnih vrednot. Reka Smith je edina večja nezajezena, prosto tekoča reka v Kaliforniji."

	key[]: "poi_ca2_04"
	val[]: "Most Whiskey Creek"

	key[]: "poi_ca2_04_desc"
	val[]: "Most Whisky Creek Bridge je trirazponska konstrukcija z varjenimi ploščatimi nosilci in je bil dokončan leta 1961. Pomemben je kot zgodnji primer načrtovanja mostu, ki uporablja tri različne razrede jekla, kar je bila takrat inovativna tehnika varjenja."

	key[]: "poi_ca2_05"
	val[]: "Jezero Shasta"

	key[]: "poi_ca2_05_desc"
	val[]: "Jezero Shasta, največji vodni rezervoar v Kaliforniji, je nastal z jezom Shasta na reki Sacramento. Dokončan je bil leta 1945 in zagotavlja vodo, hidroelektrično energijo in slikovit kraj za rekreacijo."

	key[]: "poi_ca2_06"
	val[]: "Gora Shasta"

	key[]: "poi_ca2_06_desc"
	val[]: "Gora Shasta, drugi najvišji vrh v gorovju Cascade, vodi popotnike po poti Siskiyou do svojega vznožja že od leta 1820. Ta pot se je kasneje razvila v Interstate 5, ki zdaj vsako leto h gori prepelje na tisoče ljudi."



##########################################################################################

	key[]: "tb_ca3"
	val[]: "Pot The Sierra Crossing"

	key[]: "tb_ca3_desc"
	val[]: "Gostišče Inn at Benton se nahaja pod visoko Sierra Nevado, med odprtimi dolinami in griči. Pot Sierra Crossing se vije vzdolž tihih visokih puščavskih cest, kjer oddaljeni vrhovi in razgibani grebeni ustvarjajo brezčasno panoramo, ki popotnike vabi k raziskovanju široko odprte pokrajine regije."

	key[]: "ca_cut_olmsted_point_desc"
	val[]: "Nacionalni park Yosemite je bil ustanovljen leta 1890 in je eden najbolj obiskanih parkov. Znan je po najvišjem slapu v Severni Ameriki Yosemite, obsežnih pohodniških poteh in velikanskih sekvojah, starih več kot 3000 let."

	key[]: "poi_ca3_01"
	val[]: "Cesta Tioga"

	key[]: "poi_ca3_01_desc"
	val[]: "Cesta Tioga je znamenita slikovita pot, ki poteka skozi osrčje nacionalnega parka Yosemite. Je najvišji avtocestni prelaz v Kaliforniji in povezuje zahodno in vzhodno stran Sierre Nevade."

	key[]: "poi_ca3_02"
	val[]: "Jezero Mono"

	key[]: "poi_ca3_02_desc"
	val[]: "Jezero Mono je eno najstarejših jezer v Severni Ameriki, staro je več kot milijon let. V tisočletjih obstoja so se v njem nakopičile soli in minerali, ki so jih prinesli potoki iz vzhodne Sierre Nevade. Jezero namreč nima naravnega izliva."
	
	key[]: "poi_ca3_03"
	val[]: "Jezero Tahoe"

	key[]: "poi_ca3_03_desc"
	val[]: "Jezero Tahoe je nastalo pred približno 2 milijonoma let, njegovo današnjo obliko pa so izklesali ledeniki iz ledene dobe. Je največje alpsko jezero v Severni Ameriki in drugo najgloblje v ZDA."

	key[]: "poi_ca3_04"
	val[]: "Nacionalni gozd Eldorado"

	key[]: "poi_ca3_04_desc"
	val[]: "Nacionalni gozd Eldorado je del velikega vodozbirnega območje, ki zagotavlja vodo milijonom prebivalcev Kalifornije in podpira kmetije, ki proizvedejo skoraj polovico sadja in zelenjave v državi."

	key[]: "poi_ca3_05"
	val[]: "Gostišče Inn at Benton v mestu Hot Springs"

	key[]: "poi_ca3_05_desc"
	val[]: "Benton, eno najstarejših mest v okrožju Mono, so ustanovili ljudje iz plemena Paiute za uporabo vročih vrelcev. V šestdesetih letih 19. stoletja je postalo postajališče za prve naseljence in rudarje. Gostišče Inn at Benton, je bilo zgrajeno v 40. letih prejšnjega stoletja iz porozne vulkanske kamnine imenovane plovec, ki se nahaja v bližini. Nadomestilo je hotel iz leta 1904 z 10 sobami in eno samo kopalnico."



##########################################################################################

	key[]: "tb_ca4"
	val[]: "Sonce in pesek"

	key[]: "tb_ca4_desc"
	val[]: "Puščava Doline Smrti se razteza pod neskončnim nebom, polna je sipin, strmih vrhov in razpokanih ravnic. Zajci skačejo po s soncem obsijanem pesku, lobanje označujejo tihe predele in osamljene ceste se vijejo skozi ostro, nepopustljivo pokrajino, ki preizkuša in navdušuje vse, ki se podajo sem."

	key[]: "poi_ca4_01"
	val[]: "Lone Pine"

	key[]: "poi_ca4_01_desc"
	val[]: "Lone Pine je majhno mesto v kalifornijski dolini Owens, ob vzhodnem vznožju gorovja Sierra. Znano po bližnjih hribih Alabama Hills, je že dolgo služilo kot izhodišče za pohodnike, plezalce in filmske ustvarjalce, ki raziskujejo okoliške gore in puščavske pokrajine."

	key[]: "poi_ca4_02"
	val[]: "Nacionalni park Death Valley"

	key[]: "poi_ca4_02_desc"
	val[]: "Death Valley ali Dolina smrti spada med najbolj ekstremna območja v Ameriki - je najnižja, najbolj vroča, najbolj suha in ponekod tudi najvišje ležeča pokrajina. Že dolgo pred prihodom pionirjev v 19. stoletju so tu živela avtohtona plemena, ki so se ukvarjala z lovom in nabiralništvom v tej surovi, a zgodovinsko bogati regiji."

	key[]: "poi_ca4_03"
	val[]: "Razgledna točka Father Crowley"

	key[]: "poi_ca4_03_desc"
	val[]: "Razgledna točka je priljubljena postaja za popotnike. Tukaj se je pogosto ustavljal tudi puščavski pater oče John J. Crowley. V bližini zahodne meje parka se odpira osupljiv razgled na kanjon Rainbow, barvito formacijo, ki je bila oblikovana s starodavnim vulkanskim delovanjem."
	
	key[]: "poi_ca4_04"
	val[]: "Mesto Valley Wells v puščavi Mojave"

	key[]: "poi_ca4_04_desc"
	val[]: "Starodavni iztoki podzemne vode v mestu Valley Wells pričajo o preteklih mokriščih iz ledene dobe. Ti zgodovinski vodnjaki razkrivajo, kako je podzemna voda nekoč omogočala močvirja in bujno vegetacijo v sicer sušni puščavi."

	key[]: "poi_ca4_05"
	val[]: "Indijanski rezervat reke Colorado"

	key[]: "poi_ca4_05_desc"
	val[]: "Rezervat se razteza vzdolž reke Kolorado v Arizoni in Kaliforniji. Ustanovljen je bil leta 1865 za plemena, ki so živela ob reki - Mohave, Chemehuevi, Hopi in Navajo. Dandanes še vedno živijo na tem področju in vzdržujejo svojo kmetijsko dejavnost ter lokalno skupnost."

##########################################################################################

#@}



#+ Idaho TBs and POIs localization.
#@{

    key[]: "tb_id1"
	val[]: "Dolina Treasure Valley"

	key[]: "tb_id1_desc"
	val[]: "Dolina Treasure Valley v jugozahodnem Idahu ima bogato zgodovino, ki so jo oblikovala plemena ameriških staroselcev, zgodnji trgovci s krznom in naseljenci Oregonske poti. Njeno ime odraža naravne vire in priložnosti, kasneje pa se je razvila s kmetijstvom, železnicami in regionalno trgovino, osredotočeno okoli mesta Boise."

	key[]: "poi_id1_01"
	val[]: "Reka Salmon"

	key[]: "poi_id1_01_desc"
	val[]: "Reka Salmon v Idahu je dolga 683 km in se razteza skozi globok, razgiban kanjon. Vzdevek \"Reka brez povratka\" si je prislužila, ker se v preteklosti ljudje ob vračanju s čolni niso mogli boriti proti njenim močnim in zahtevnim tokovom."

	key[]: "poi_id1_02"
	val[]: "Nacionalni gozd Boise"

	key[]: "poi_id1_02_desc"
	val[]: "Narodni gozd Boise se razteza čez erodirajoči batolit Idaha in se ponaša z robustno pokrajino, ki jo je oblikovala vulkanska dejavnost. Ta geološka dediščina se kaže v strmih kanjonih in številnih naravnih termalnih vrelcih, ki so skriti po celotnem terenu."

	key[]: "poi_id1_03"
	val[]: "Mesto Horseshoe Bend"

	key[]: "poi_id1_03_desc"
	val[]: "Potem ko so leta 1862 v kotlini Boise našli zlato, so rudarji, ki so prezimovali ob reki, ustanovili Horseshoe Bend. Mesto se je prvotno imenovalo Warrinersville po lokalnem lastniku žage, sedanje ime pa je dobilo leta 1867, ko je postalo ključna postaja za iskalce zlata."
	
	key[]: "poi_id1_04"
	val[]: "Cestninska postaja Toll Gate"

	key[]: "poi_id1_04_desc"
	val[]: "Leta 1864 je strmo pot Syrup Creek nadomestila nova kanjonska pot. Njeno vzdrževanje so 20 let financirale cestnine, slavni hotel in mlekarna Jamesa A. Porterja pa je medtem postala glavna postaja za popotnike, ki so iskali zatočišče."

	key[]: "poi_id1_05"
	val[]: "Mesto Castle Rock"

	key[]: "poi_id1_05_desc"
	val[]: "Granitna vzpetina Castle Rock je bila ikonska znamenitost za popotnike, ki so potovali po cesti Goodale’s Cutoff proti preriji Camas. Cesta je bila v uporabi od leta 1862 do dobe avtomobilov in takšne redke kamnite strukture so popotnikom predstavljajle osupljiv prizor ob poti."

    key[]: "poi_id1_06"
	val[]: "Indijanski rezervat Duck Valley"

	key[]: "poi_id1_06_desc"
	val[]: "Leta 1886 je predsednik Cleveland razširil rezervat Duck Valley v Idaho z \"razširitvijo Paddy Cap\". Do leta 1934 so različne skupine, ki so se preselile v rezervat, dobile uradno zvezno priznanje kot enotna plemena Shoshone-Paiute."


##########################################################################################

    key[]: "tb_id2"
	val[]: "Dolina The Magic Valley"

	key[]: "tb_id2_desc"
	val[]: "V začetku 20. stoletja je I. B. Perrine suho puščavo v Idahu spremenil v kmetijska zemljišča z izgradnjo jezu Milner. Jez, dokončan leta 1905, je z vodo reke Snake \"čarobno\" preoblikoval pokrajino. To je ustvarilo dolino Magic Vlley, ki je vodila do uspešnih kmetijskih mest, ki obstajajo še danes."

	key[]: "id_cut_perrine_desc"
	val[]: "Slapovi Shoshone so s svojimi 65 metri višji od Niagarskih slapov. So čudovita znamenitost reke Snake, ki se nahaja tik ob robu slapov Twin Falls."

	key[]: "id_cut_galena_desc"
	val[]: "Rudarsko mesto, ustanovljeno leta 1879 po odkritju svinca in srebra, je propadlo do leta 1890 zaradi padca cen. Danes območje uspeva kot rekreacijsko središče, kjer se nahajata zgodovinska koča Galena Lodge in bližnji slikoviti vrh Galena Summit."

	key[]: "poi_id2_01"
	val[]: "Pečina Bison Jump"

	key[]: "poi_id2_01_desc"
	val[]: "V bližini mesta Challis se nahaja zgodovinska lokacija, kjer so domorodci bizone preganjali čez pečine. Ta strateško pomembna pokrajina, ki se uporablja že več kot 2000 let, ponuja vpogled v starodavne skupnostne lovske tradicije."
	
	key[]: "poi_id2_02"
	val[]: "Kanjon Grand View"

	key[]: "poi_id2_02_desc"
	val[]: "Kanjon Grandview, ki se nahaja ob slikoviti cesti Peaks to Craters na avtocesti US-93, ponuja osupljiv razgled na gorovje Lost River. V tem gorovju se nahaja devet najvišjih vrhov Idaha, zaradi česar kanjon predstavlja vrhunec slikovite poti."

	key[]: "landmark_id_mackay_rs_desc"
	val[]: "Big Lost River ali Velika izgubljena reka, prvotno imenovana Goddinova reka po lovcu na krzno Thyeryju Goddinu, je znana po tem, da se pogreza v struge, ki jih je nekoč oblikovala lava. Ta \"izgubljena\" voda potuje pod zemljo in se sčasoma ponovno vrne v obliki spektakularnih izvirov Thousand Springs blizu reke Snake."

    key[]: "poi_id2_03"
	val[]: "Mesta duhov Mackay"

	key[]: "poi_id2_03_desc"
	val[]: "Mesta, kot sta White Knob in Cliff Creek, ki sta nastala na podlagi rudnika \"Mine Hill\" v rudarskem okrožju White Knob, so do sredine 20. stoletja spodbudila razcvet rudarjenja bakra, zlata in srebra. Ta območja ostajajo ključni ostanki zgodovinske rudarske industrije v Idahu."

	key[]: "id_cut_craters_desc"
	val[]: "Območje Craters of the Moon, ki so ga pred 15.000 leti oblikovali vulkanski izbruhi, se ponaša z obsežno pokrajino tokov lave in pepelnatih stožcev. Njegova nadzemeljska pokrajina je tako edinstvena, da so jo nekoč astronavti agencije NASA uporabljali za usposabljanje za misije na Luno."



##########################################################################################

#@}



#+ Montana TBs and POIs localization.
#@{

    key[]: "tb_mt1"
	val[]: "Prelaz The Glacier"

	key[]: "tb_mt1_desc"
	val[]: "V pokrajini Glacier Country se nahajajo zadnji aktivni ledeniki v gorovju Rocky Mountains. V tisočletjih so te starodavne ledene mase izklesale globoke doline, ostre vrhove in neokrnjena jezera ter tako oblikovale pokrajino, ki danes zaznamuje zahodno Montano."

	key[]: "poi_mt1_01"
	val[]: "Slap Kootenai"

	key[]: "poi_mt1_01_desc"
	val[]: "Slap Kootenai je največji nezajezeni slap v Montani in glavna znamenitost v regiji. Reka Kootenai se na kratki razdalji spusti približno 91 metrov globoko in ustvari mogočen, slikovit slap, ki s svojimi nepozabnimi razgledi privablja obiskovalce."

	key[]: "poi_mt1_02"
	val[]: "Počivališče Berne Roadside Park"

	key[]: "poi_mt1_02_desc"
	val[]: "V preteklosti je bil kanjon Bad Rock priljubljena postaja za popotnike ob reki Flathead, znani po ribolovu, slikovitih razgledih in naravnem izviru, ki so ga uporabljali za hlajenje pregretih avtomobilskih motorjev. Leta 1956 je Berne Roadside Park postal eno prvih počivališč v Montani."

	key[]: "poi_mt1_03"
	val[]: "Gora Heavens Peak"

	key[]: "poi_mt1_03_desc"
	val[]: "Heaven's Peak je ena najbolj znamenitih gora v narodnem parku Glacier, ki jo je v devetdesetih letih 19. stoletja poimenoval iskalec zlata Louie Meyer. Raziskovalci so bili navdušeni nad njeno lepoto in visokimi pečinami, saj so menili, da je nekaj povsem drugačnega od vsega, kar so doslej srečali na svoji poti."

	key[]: "mt_cut_glacier_national_park_desc"
	val[]: "Narodni park Glacier slovi kot \"krona celine\" in je bil ustanovljen leta 1910. Oblikujejo ga starodavni ledeniki, širši dostop pa je dobil leta 1932 z dokončanjem ceste Going-to-the-Sun, ki je danes zgodovinska inženirska znamenitost."

	key[]: "poi_mt1_04"
	val[]: "Spomenik indijanskim plemenom Blackfeet"

	key[]: "poi_mt1_04_desc"
	val[]: "Vzhodni rob narodnega parka Glacier je dom plemena Blackfeet Nation. Znani so kot \"bojevniki ravnin\", njihovo ime naj bi izviralo iz mokasinov, potemnjenih od pepela. Danes je več krajev v parku še vedno svetih za to pleme."

	key[]: "mt_cut_flathead_lake_desc"
	val[]: "Jezero Flathead je po površini največje naravno sladkovodno jezero v Združenih državah Amerike. Napaja ga taljenje snega z okoliških gora, njegova izjemno čista voda pa se v celoti obnovi vsakih nekaj let, zaradi česar je eno najčistejših velikih jezer na svetu."

	key[]: "mt_cut_thompson_falls_desc"
	val[]: "Mesto, poimenovano po britansko-kanadskem trgovcu s krznom in kartografu Davidu Thompsonu, je raslo po prihodu železnice leta 1881. Še bolj pa se je razširilo v času zlate mrzlice v bližnjem mestu Coeur d'Alene, saj je postalo ključna postaja za rudarje, ki so potovali po cesti Murray Trail."

	key[]: "landmark_mt_missoula_desc"
	val[]: "Neoklasicistična sodna palača okrožja Missoula, je zgrajena iz peščenjaka in zasnovana po načrtih A. J. Gibsona leta 1910. Nadomestila je prejšnjo, manjšo zgradbo. Okrožje Missoula, ustanovljeno leta 1860, je ena najstarejših političnih regij Montane, ki se razteza od Bitterroota do gorovja Rocky Mountains."

    key[]: "poi_mt1_05"
	val[]: "Potok Lolo"

	key[]: "poi_mt1_05_desc"
	val[]: "Po koridorju med prelazom in mestom Lolo poteka zgodovinska pot vzdolž potoka Lolo. Nekoč so tukaj potovali zgodnji naseljenci Nez Perce in odprava Lewis in Clark. Ostaja pomembna kulturna in zgodovinska pokrajina, ki je označena informativnimi tablami."

##########################################################################################

    key[]: "tb_mt2"
	val[]: "Velike planjave"

	key[]: "tb_mt2_desc"
	val[]: "Velike planjave Montane ali The Great Plains se raztezajo čez vzhodni del države, zanje so značilna prostrana travišča, valovite prerije in prostrano odprto nebo. V regiji so našli nekatere pomembnejših fosilov dinozavrov v Severni Ameriki, ki nam omogočajo vpogled v pokrajino, ki je obstajala pred milijoni let."

	key[]: "poi_mt2_01"
	val[]: "Geološka struktura Hell Creek"

	key[]: "poi_mt2_01_desc"
	val[]: "Formacija Hell Creek, se razteza vzdolž potoka Hell Creek v bližini mesta Jordan v Montani. Ohranja starodavno subtropsko pokrajino z rekami, gozdovi in močvirji. Nastala je pred 67–66 milijoni let in je svetovno znana po bogatih najdiščih fosilov dinozavrov, med katerimi je tudi sloviti tiranozaver rex."

	key[]: "poi_mt2_02"
	val[]: "Reka Yellowstone"

	key[]: "poi_mt2_02_desc"
	val[]: "Reka Yellowstone je najdaljša prosto tekoča reka v Združenih državah Amerike. Izvira v narodnem parku Yellowstone in teče 1087 km skozi Wyoming in Montano, nato pa se združi z reko Missouri, pri čemer teče po svoji celotni dolžini brez enega samega jezu."

	key[]: "poi_mt2_03"
	val[]: "Glendisaurus"

	key[]: "poi_mt2_03_desc"
	val[]: "Glendisaurus je kip Triceratopsa v naravni velikosti v Glendivu, ki je bil postavljen v čast bogati dinozavrski dediščini regije. Z višino meri približno 3 metre in služi kot priljubljena znamenitost ob Poti dinozavrov."
	
	key[]: "poi_mt2_04"
	val[]: "Reka Missouri"

	key[]: "poi_mt2_04_desc"
	val[]: "Reka Missouri, znana kot \"Big Muddy\", je najdaljša reka v Združenih državah Amerike. Dolga je 3767 kilometrov in teče od gorovja Rocky Mountains v Montani do reke Mississippi. Ključno vlogo je igrala pri raziskovanju, trgovini in širjenju ameriške meje proti zahodu."

	key[]: "mt_cut_fort_peck_spillway_desc"
	val[]: "Jez Fort Peck, zgrajen v času velike depresije, je največji hidravlično napolnjen zemeljski jez na svetu. Zgrajen je bil kot eden največjih ameriških javnih projektov in je bil zasnovan za zagotavljanje delovnih mest, nadzor poplav in proizvodnjo hidroenergije."

    key[]: "poi_mt2_05"
	val[]: "Muzej pionirjev Valley County"

	key[]: "poi_mt2_05_desc"
	val[]: "Muzej prikazuje zgodovino severovzhodne Montane z razstavami o plemenu Assiniboine, železnicah, kmetijstvu, jezu Fort Peck in odpravi Lewis in Clark. Hrani tudi obsežne arhive in eno največjih zbirk Assiniboine v državi."

	key[]: "poi_mt2_06"
	val[]: "Znamenitost Sleeping Buffalo Rock"

	key[]: "poi_mt2_06_desc"
	val[]: "Ti veliki ledeniški balvani so bili sveti mejniki za avtohtona plemena. Starodavni ledeniki so jih izklesali in prinesli na ta kraj. Manjša skala, poimenovana “Buffalo Rock\" je bila izklesana tako, da spominja na bivola, medtem ko je večja, \"Medicine Rock\" opremljena z različnimi petroglifi."



##########################################################################################

#@}



#+ Wyoming TBs and POIs localization.
#@{

    key[]: "tb_wy1"
	val[]: "Pot bivolov"

	key[]: "tb_wy1_desc"
	val[]: "Tukaj se nahajata nacionalna parka Yellowstone in Grand Teton, pod zemljinim površjem pa se skriva aktivni vulkanski sistem, ki poganja gejzirje in vroče vrelce. Vrhove in doline so oblikovali ledeniki in prelomi. Zaradi teh sil je severozahodni Wyoming ena najbolj geološko dinamičnih in vizualno privlačnih pokrajin na ameriškem Zahodu."

	key[]: "landmark_wy_yellowsto_desc"
	val[]: "Nacionalni park Yellowstone je bil ustanovljen leta 1872 kot prvi narodni park na svetu. Znan je po tem, da leži na vrhu ogromnega mirujočega vulkana. V njem je približno polovica aktivnih gejzirjev na svetu, varuje pa tudi enega največjih neokrnjenih ekosistemov v zmernih podnebnih območjih."

	key[]: "poi_wy1_01"
	val[]: "Lower Geyser Basin"

	key[]: "poi_wy1_01_desc"
	val[]: "Lower Geyser Basin je največji gejzirski bazen v parku Yellowstone, ki se ponaša z veliko koncentracijo gejzirjev, vročih vrelcev in parnih izvirov. Napaja ga toplota iz globoke podzemne magme in predstavlja eno najaktivnejših geotermalnih pokrajin v parku."

	key[]: "poi_wy1_02"
	val[]: "Jezero Yellowstone"

	key[]: "poi_wy1_02_desc"
	val[]: "Jezero Yellowstone je največje visoko ležeče jezero v Severni Ameriki, v njem živi in največja populacija divje postrvi na celini. Znanstveniki verjamejo, da se je nekoč izlivalo v Tihi ocean, kar je ribam omogočalo prečkanje celinske ločnice Continental Divide skozi prelaz Two Ocean Pass.\n"
	
	key[]: "poi_wy1_03"
	val[]: "Jez Buffalo Bill"

	key[]: "poi_wy1_03_desc"
	val[]: "Jez Buffalo Bill je bil zgrajen leta 1910 in je bil eden prvih betonskih ločnih jezov v Združenih državah Amerike. Takrat je bil najvišji jez na svetu, v višino je meril 99 metrov in zato postal mejnik zgodnjih inženirskih inovacij."

	key[]: "poi_wy1_04"
	val[]: "Colters Hell"

	key[]: "poi_wy1_04_desc"
	val[]: "Colter’s Hell je zgodovinsko geotermalno območje ob reki Shoshone, ki ga je leta 1807 poimenoval raziskovalec John Colter. Zgodnji možje gora so odprtine na zemeljskem površju, ki so bruhale paro, vročo vodo in vonjave po žveplu primerjali s \"peklom\". Danes so aktivni le še vroči vrelci in parne odprtine."

	key[]: "wy_cut_grand_teton_desc"
	val[]: "Narodni park Grand Teton zaznamujejo njegovi ledeniško izklesani vrhovi, ki se strmo dvigajo nad dolino Jackson Hole. Lovci na krzno so jih nekoč imenovali “Stožčasti gumbi”, saj so jim omogčali dobro vidljivost po ravnini. \nGore še danes ostajajo med najbolj slovitimi znamenitostmi ameriškega Zahoda."

	key[]: "poi_wy1_05"
	val[]: "Crowheart Butte"

	key[]: "poi_wy1_05_desc"
	val[]: "Crowheart Butte je pomembna znamenitost, poimenovana po bitki med plemenoma Shoshone in Crow leta 1866. Ljudsko izročilo pravi, da je poglavar Washakie po zmagi ljudstva Shoshone v opozorilo na vrh gore položil srce poglavarja Vranov, s čimer je vzpetina dobila trajno ime."

##########################################################################################

    key[]: "tb_wy2"
	val[]: "Rdeča puščava - The Red Desert"

	key[]: "tb_wy2_desc"
	val[]: "Rdeča puščava v Wyomingu je prostrana visoka puščavska kotlina. Definirajo jo pesek, ki ga je oblikoval veter, ravnice žajblja in osupljive rdeče skalne strukture. Je eno največjih nenaseljenih območij v Severni Ameriki, oblikujejo ga ekstremno podnebje, starodavna jezerska dna in dolge migracijske poti."

	key[]: "poi_wy2_01"
	val[]: "Rdeči kanjon - Red Canyon"

	key[]: "poi_wy2_01_desc"
	val[]: "Rdeči kanjon je bil izklesan z dvigom gorovja Wind River pred približno 60 milijoni let. Njegove značilne rdeče pečine so oblikovane iz kamnine Chugwater. Oksidirano železo iz kamnine, daje kanjonu živo barvo, ki je bila navdih za njegovo ime."

	key[]: "poi_wy2_02"
	val[]: "Pokrajina moči"

	key[]: "poi_wy2_02_desc"
	val[]: "Boar's Tusk, vulkanska kamnita formacija, se dviga več kot 120 metrov nad Rdečo puščavo v Wyomingu, je erodirano jedro vulkana, ki je nastal pred milijoni let. Z nje se odpira pogled na prostrane peščene sipine Killpecker, ki je del največjega aktivnega polja sipin v Severni Ameriki."

	key[]: "poi_wy2_03"
	val[]: "Mesto Rock Springs"

	key[]: "poi_wy2_03_desc"
	val[]: "Rock Springs je zaradi svoje raznolike priseljenske dediščine znan kot »mesto 56 narodnosti«. V poznem 19. stoletju so ljudje z vsega sveta prihajali delat v premogovnike Union Pacific. Mesto je povezano tudi z znanim izobčencem Butchom Cassidyjem."
	
	key[]: "poi_wy2_04"
	val[]: "Koča Butcha Cassidyja"

	key[]: "poi_wy2_04_desc"
	val[]: "Butch Cassidy je bil znan ameriški izobčenec, bil je vodja tolpe »Divja druščina«, ki je bila znana po ropih vlakov in bank na Divjem zahodu. Vzdevek »Butch« si je prislužil med delom v mesnici v Rock Springsu. Najbolj legendaren in vpliven roparski pohod je bila oplenitev vlaka v Wilcoxu leta 1899."

	key[]: "wy_cut_evanston_desc"
	val[]: "Evanston, ki ga je leta 1869 ustanovila železnica Union Pacific, je bil poimenovan po geodetu Jamesu A. Evansu. Mesto je raslo kot železniško vozlišče in kasneje postalo regionalno središče za kmetijstvo, nafto in plin."

    key[]: "poi_wy2_05"
	val[]: "Lander Cutoff"

	key[]: "poi_wy2_05_desc"
	val[]: "Cesta Lander Cutoff je bila zgrajena po Zakonu o pacifiških cestah iz leta 1857 in je bila ena prvih zvezno financiranih cest na ameriškem Zahodu. Poimenovana je bila po inženirju Fredericku W. Landerju, njen namen pa je bil zagotoviti krajšo pot za izseljence, ki so potovali proti zahodu."

	

##########################################################################################

#@}


#+ South Dakota TBs and POIs localization.
#@{

    key[]: "tb_sd1"
	val[]: "The Black Hills"

	key[]: "tb_sd1_desc"
	val[]: "Zahodni del Južne Dakote zaznamujeta gorovje Black Hills in nacionalni park Badlands. Tu se prostrane prerije dvigajo v gore, porasle z borovci, granitne vzpetine in potujoče črede bizonov. Tik za njimi pa se nahaja osupljiva pokrajina Badlands, ki sta jo milijone let klesala veter in voda."

	key[]: "poi_sd1_01"
	val[]: "Nacionalni gozd Black Hills National"

	key[]: "poi_sd1_01_desc"
	val[]: "Gora Black Elk Peak z 2207,97 metri nadmorske višine predstavlja tako najvišjo točko v Južni Dakoti kot tudi najvišji vrh vzhodno od Skalnega gorovja. Je del z borovci poraslega območja, ki ga je pleme Lakota poimenoval Paha Sapa ali \"črni hribi\". Kasneje je bil preimenovan v čast slavnemu zdravilca plemena Lakota."

	key[]: "sd_cut_rush_desc"
	val[]: "Spomenik Mount Rushmore je znan kot ameriško \"svetišče demokracije\", in je bil vklesan v gorovje Black Hills med letoma 1927 in 1941. Spomenik prikazuje 18 metrov visoke skulpture predsednikov Washingtona, Jeffersona, Roosevelta in Lincolna, ki predstavljajo rojstvo, rast, razvoj in ohranitev države."

	key[]: "poi_sd1_02"
	val[]: "Most Beaver Creek"

	key[]: "poi_sd1_02_desc"
	val[]: "Gre za 68 metrov dolg most iz jekla in betona, ki je bil zgrajen leta 1929. Razteza se 35 metrov visoko čez kanjon v bližini narodnega parka Wind Cave. Je edini tovrstni most v Južni Dakoti, ki je zasnovan tako, da se neopazno zlije z okoliško skalo."

	key[]: "sd_cut_sturgis_desc"
	val[]: "Mesto Sturgis je znano po tem, da gosti največje motociklistično zborovanje na svetu. Leta 1938 ga je ustanovil prodajalec motornih koles Indijanec Pappy Hoel. Vsakoletno 10-dnevno srečanje privabi motoriste z vsega sveta v bližino gorovja Black Hills, da se naužijejo motociklističnih predstav, dirk, praznovanja in glasbe."

	key[]: "sd_cut_deadwood_desc"
	val[]: "Deadwood je nastal med zlato mrzlico v Black Hillsu leta 1876 in postal eno najbolj razvpitih mest Divjega zahoda. Leta 1961 je bil razglašen za nacionalno zgodovinsko znamenitost in je edino ameriško mesto s tem statusom, ki je ohranilo velik del svojega zgodovinskega središča."

	key[]: "sd_cut_badlands_desc"
	val[]: "Narodni park Badlands se razteza na 987.4 km2. Znan je po osamelih skalnih stolpičih in vzpetinah s strmimi pobočji, ki se dvigujejo ob največji zaščiteni preriji v državi. Ohranja eno najbogatejših fosilnih nahajališč na svetu in razkriva starodavne sesalce, ki so nekoč živeli v nižini Great Plains."

	key[]: "poi_sd1_03"
	val[]: "Tunel Doane Robinson"

	key[]: "poi_sd1_03_desc"
	val[]: "Doane Robinson je znan kot \"oče spomenika Mount Rushmore\". Zamislil si je veličastno skulpturo v gorovju Black Hills, ki bi privabila obiskovalce v Južno Dakoto. Danes se njegova zapuščina nadaljuje - Mount Rushmore je odlično uokvirjen v pogledu skozi slikovit predor Doane Robinson."

	key[]: "sd_cut_hot_springs_desc"
	val[]: "Mesto Hot Springs je ljudstvo Sioux prvotno imenovalo Minnekahta, kar pomeni \"vroča voda\". Naseljen je bil leta 1879 okoli mineralnih vrelcev, za katere so verjeli, da imajo zdravilne moči. Preimenovan je bil leta 1882, postal je zdraviliško letovišče in ostaja znan po zgodovinskem Evans Plunge."

	key[]: "poi_sd1_04"
	val[]: "Najdišče The Mammoth Site"

	key[]: "poi_sd1_04_desc"
	val[]: "The Mammoth Site je svetovno znano arheološko najdišče fosilov iz ledene dobe, kjer so odkrili 61 mamutov. Starodavna vrtača je bila odkrita leta 1974 in hrani največjo zbirko ostankov kolumbijskih mamutov v Severni Ameriki, izkopavanja potekajo še danes."

##########################################################################################

    key[]: "tb_sd2"
	val[]: "Velika ločnico -The Great Divide"

	key[]: "tb_sd2_desc"
	val[]: "Območje reke Missouri v Južni Dakoti označuje osrednjo ločnico zvezne države - široke ravnine na eni strani in valoviti hribi na drugi. Območje je bilo ključni koridor za domorodna plemena, trgovce s krznom ter ekspedicijo Lewis in Clark, kasneje pa je postal dom velikih jezov, pionirskih mest in bogate rečne zgodovine."

	key[]: "poi_sd2_01"
	val[]: "Štiri velika jezera"

	key[]: "poi_sd2_01_desc"
	val[]: "Jezera Oahe, Sharpe, Francis Case in Lewis & Clark so osrednji del zvezne države Južna Dakota. Ustvarjena so bila z jezovi na reki Missouri v poznih 40. letih 20. stoletja. So rezervoar, ki zagotavlja več kot 440 milj obale za čolnarjenje, ribolov in rekreacijo."

	key[]: "poi_sd2_02"
	val[]: "Mesto duhov Bangor"

	key[]: "poi_sd2_02_desc"
	val[]: "Mesto Bangor je bil nekoč sedež okrožja Walworth, a je postal mesto duhov, potem ko so leta 1899 njegove stavbe preselili v bližnji Selby. Danes na mestu, kjer je nekoč stalo mesto, stoji le še spomenik."

	key[]: "landmark_sd_state_capitol_desc"
	val[]: "Mesto Pierre je bilo ustanovljeno leta 1880 kot glavno mesto Južne Dakote, ki se je leta 1889 pridružila Uniji. Izbrano je bilo zaradi svoje osrednje lokacije in možnosti prečkanja reke Missouri. Poimenovano je bilo po trgovcu s krznom Pierre Chouteau Jr."

	key[]: "sd_cut_corn_desc"
	val[]: "The Corn Palace je ena najbolj zanimivih znamenitosti Južne Dakote. Nahaja se v mestu Mitchell in je edina palača na svetu, ki je v celoti okrašena s koruzo. Lokalni umetniki in kmetje vsako leto ustvarijo nove freske z naravno obarvano koruzo, žitaricami in travami."

	key[]: "landmark_sd_largest_pheasant_desc"
	val[]: "V mestu Huron živi največji fazan na svetu. Gre za 12 metrov visoko skulpturo iz steklenih vlaken in jekla, ki je bila zgrajena leta 1959. Tehta 22 ton in predstavlja dolgoletni sloves regije kot ene od glavnih ameriških destinacij za lov na fazane."

	key[]: "landmark_sd_dignity_of_earth_and_sky_desc"
	val[]: "Dignity Of Earth & Sky je 15 metrska skulptura iz nerjavečega jekla, s pogledom na reko Missouri blizu mesta Chamberlain. Ustvaril jo je umetnik Dale Lamphere in predstavlja dediščino, odpornost in kulturo ljudstev Lakota in Dakota."

