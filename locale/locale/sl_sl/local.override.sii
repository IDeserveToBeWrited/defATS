#+ Text deviations for American Truck Simulator. Please, use only terms appropriate for USA (i.e. culture specific nuances, not American English).
#@{

#+ Music/radio player
#@{

#+ Hint shown if no music files are found. Also shown as tooltip when hovering over music_player button.

	key[]: "music_player_hint"
	val[]: "Prilepi svoje skladbe v <color value=@@clr_sel@@>American Truck Simulator/music <color value=@@clr_txt@@>mapo, ki se nahaja v <color value=@@clr_sel@@>Dokumentih <color value=@@clr_txt@@>in potem jih boš videl tukaj."

#+ Tooltip shown when hovering over the radio_stream button.

	key[]: "radio_hint"
	val[]: "Uredi <color value=@@clr_sel@@>live_streams.sii <color value=@@clr_txt@@>v <color value=@@clr_sel@@>American Truck Simulator <color value=@@clr_txt@@>mapi, ki se nahaja v <color value=@@clr_sel@@>Dokumentih <color value=@@clr_txt@@>in poslušaj svoj najljubši internetni pretočni radio kar iz igre!"

#+ Hint shown if no online radio streams are defined.

	key[]: "empty_radio_hint"
	val[]: "Prosimo, preberite <color value=@@clr_sel@@>readme.rtf <color value=@@clr_txt@@>v <color value=@@clr_sel@@>American Truck Simulator <color value=@@clr_txt@@>mapi, ki se nahaja v <color value=@@clr_sel@@>Dokumentih <color value=@@clr_txt@@>, da boste izvedeli kako dodati svojo glasbo in pretočni radio."
#@}

#+ Messages shown as part of the tutorial.
#+
