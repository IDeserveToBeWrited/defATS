
    key[]: "hint_engine_title"
	val[]: "Arrancar el motor"

    key[]: "hint_engine_text"
	val[]: "Pulsa $KEY_engine$ para poner en marcha el motor."


    key[]: "hint_ignition_title"
	val[]: "Encender el sistema eléctrico"

    key[]: "hint_ignition_text"
	val[]: "Pulsa $KEY_engineelect|KEY_engine$ para activar el sistema eléctrico."


    key[]: "hint_driv_arc_title"
	val[]: "Conducir"

    key[]: "hint_driv_arc_text"
	val[]: "Pulsa $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ y $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ para avanzar o retroceder.<br><offset vshift=8>Pulsa $SPECIAL_steering$ para girar."


    key[]: "hint_driv_auto_title"
	val[]: "Conducir"

    key[]: "hint_driv_auto_text"
	val[]: "Pulsa $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ y $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ para avanzar o retroceder.<br><offset vshift=8>Pulsa $SPECIAL_steering$ para girar.<br><offset vshift=8>Pulsa $KEY_gearup$ y $KEY_geardown$ para cambiar de marcha."


    key[]: "hint_driv_seq_title"
	val[]: "Conducir"

    key[]: "hint_driv_seq_text"
	val[]: "Pulsa $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ y $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ para avanzar o retroceder.<br><offset vshift=8>Pulsa $SPECIAL_steering$ para girar.<br><offset vshift=8>Pulsa $KEY_gearup$ y $KEY_geardown$ para controlar el embrague."


    key[]: "hint_driv_hshift_title"
	val[]: "Conducir"

    key[]: "hint_driv_hshift_text"
	val[]: "Pulsa $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ y $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ para avanzar o retroceder.<br><offset vshift=8>Pulsa $SPECIAL_steering$ para girar.<br><offset vshift=8>Cambia de marcha usando la <color value=@@clr_sel@@>palanca<color value=@@clr_txt@@>."


    key[]: "hint_depot_deliv_title"
    val[]: "Aproximarse al destino"

    key[]: "hint_depot_deliv_text"
    val[]: "Detente en la zona marcada para seleccionar la dificultad de la maniobra de estacionamiento y obtener la correspondiente experiencia."


    key[]: "hint_fin_deliv_title"
    val[]: "Finalizar la entrega"

    key[]: "hint_fin_deliv_text"
    val[]: "Estaciona en la plaza de aparcamiento seleccionada. Puedes usar $KEY_activate$ para omitir la maniobra una vez te acerques lo suficiente al punto de entrega."


    key[]: "hint_fin_deliv2_title"
    val[]: "Finalizar la entrega"

    key[]: "hint_fin_deliv2_text"
    val[]: "Estaciona en la plaza de aparcamiento seleccionada. Puedes activar un widget en @@desktop_menu_category_options@@ que te permitirá omitir la maniobra."


    key[]: "hint_lights_title"
    val[]: "Encender el alumbrado"

    key[]: "hint_lights_text"
    val[]: "Pulsa $KEY_light$ para encender el alumbrado de posición. Presionar el comando varias veces te permitirá alternar los diferentes tipos de alumbrado."


    key[]: "hint_high_beam_title"
    val[]: "Usar el alumbrado de carretera"

    key[]: "hint_high_beam_text"
    val[]: "Pulsa $KEY_hblight$ para encender el alumbrado de carretera."


    key[]: "hint_wipers_title"
    val[]: "Usar los limpiaparabrisas"

    key[]: "hint_wipers_text"
    val[]: "Pulsa $KEY_wipers$ para activar los limpiaparabrisas. Presionar el comando varias veces te permitirá alternar su velocidad."


    key[]: "hint_zoom_title"
    val[]: "Acercar la vista"

    key[]: "hint_zoom_text"
    val[]: "Pulsa $KEY_camzoom$ para adelantar el punto de vista en el interior de la cabina. Puedes configurar su modo de uso en @@desktop_menu_category_options@@."


    key[]: "hint_cam_int_title"
    val[]: "Mirar alrededor"

    key[]: "hint_cam_int_text"
    val[]: "Pulsa $KEY_cam1$ para usar la cámara interior."


    key[]: "hint_cam_ext_title"
    val[]: "Mirar alrededor"

    key[]: "hint_cam_ext_text"
    val[]: "Puedes alternar entre las diferentes cámaras pulsando KEY_camcycle$.<br><offset vshift=8>Pulsa $KEY_cam2$ para alternar a la cámara dinámica."


    key[]: "hint_indicators_title"
    val[]: "Usar los intermitentes"

    key[]: "hint_indicators_text"
    val[]: "Pulsa $KEY_lblinker$ y $KEY_rblinker$ para poner los intermitentes."


    key[]: "hint_tow_title"
    val[]: "Remolcar hasta taller"

    key[]: "hint_tow_text"
    val[]: "Pulsa $KEY_advmouse$ para acceder al servicio de remolque en @@quick_info_word@@ si no puedes salir de una situación complicada."


    key[]: "hint_diff_lock_title"
    val[]: "Bloquear el diferencial"

    key[]: "hint_diff_lock_text"
    val[]: "Pulsa $KEY_diflock$ para bloquear el diferencial o activa el bloqueo automático del diferencial en @@desktop_menu_category_options@@. Te ayudará en aquellos casos en los que no puedas moverte."


    key[]: "hint_diff_unlock_title"
    val[]: "Desbloquear el diferencial"

    key[]: "hint_diff_unlock_text"
    val[]: "Pulsa $KEY_diflock$ para desbloquear el diferencial o activa el bloqueo automático del diferencial en @@desktop_menu_category_options@@. No hacerlo durante la conducción podría dañarlo."


    key[]: "hint_wipers_off_title"
    val[]: "Detener los limpiaparabrisas"

    key[]: "hint_wipers_off_text"
    val[]: "Pulsa $KEY_wipers$ para desactivar los limpiaparabrisas. Presionar el comando varias veces te permitirá alternar su velocidad."


    key[]: "hint_world_map_title"
    val[]: "Ver el mapa"

    key[]: "hint_world_map_text"
    val[]: "Pulsa $KEY_navmap$ para acceder al mapa del mundo."


    key[]: "hint_pause_title"
    val[]: "Abrir el panel @@quick_info_word@@"

    key[]: "hint_pause_text"
    val[]: "Pulsa $KEY_advmouse$ para acceder a @@quick_info_word@@ y ver un resumen de tu estado con accesos directos prácticos."


    key[]: "hint_pause_border_title"
    val[]: "Revisar las normativas vigentes"

    key[]: "hint_pause_border_text"
    val[]: "Pulsa $KEY_advmouse$ para acceder a @@quick_info_word@@ y ver las normativas vigentes en la región por la que te desplazas."


    key[]: "hint_photo_trophy_title"
    val[]: "@@landmark_word@@ en las cercanías"

    key[]: "hint_photo_trophy_text"
    val[]: "Accede a @@quick_info_word@@ y pulsa $KEY_advmouse$ para acceder al @@photo_mode_word@@ y tomar una captura del trofeo fotográfico <img src=/material/ui/map/photo_sight_not_captured.mat width=20 height=20>."


    key[]: "hint_viewpoint_title"
    val[]: "@@viewpoint_title@@ en las cercanías"

    key[]: "hint_viewpoint_text"
    val[]: "<img src=/material/ui/map/viewpoint_unseen.mat width=20 height=20> Los miradores te permiten deleitarte con espectaculares vistas de lugares emblemáticos."


    key[]: "hint_resting_title"
    val[]: "Área de descanso en las cercanías"

    key[]: "hint_resting_text"
    val[]: "Resting places <img src=/material/ui/map/parking_ico.mat width=20 height=20> help you recover from fatigue and take your mandatory break to safely continue your journey."


    key[]: "hint_gas_title"
    val[]: "Estación de servicio en las cercanías"

    key[]: "hint_gas_text"
    val[]: "<img src=/material/ui/map/gas_ico.mat width=20 height=20> Puedes usar las estaciones de servicio para repostar combustible."


    key[]: "hint_car_job_title"
    val[]: "Primer trabajo de reparto"

    key[]: "hint_car_job_text"
    val[]: "Completa la entrega: conduce con precaución, protege la mercancía y llega a la hora prevista. Ten en cuenta la prioridad del cliente, ya que afecta a tu valoración y recompensa.<br><offset vshift=8>Pulsa $KEY_advmouse$ para ver los detalles del trabajo."


    key[]: "hint_tour_board_title"
    val[]: "Cartel turístico"

    key[]: "hint_tour_board_text"
    val[]: "Hay un cartel turístico cerca. Actívalo para desbloquear su contenido en el <color value=@@clr_sel@@>@@tourist_atlas_link@@</color> y guiar tu exploración de los monumentos y puntos de interés cercanos."


    key[]: "hint_tb_first_title"
    val[]: "Primera ubicación explorada"

    key[]: "hint_tb_first_text"
    val[]: "Has explorado la primera ubicación de un cartel turístico local. Puedes ver sus detalles en el <color value=@@clr_sel@@>@@tourist_atlas_link@@</color>. Explora todas las ubicaciones para ver más información y ganar recompensas."


    key[]: "hint_tb_bef_compl_title"
    val[]: "Una ubicación restante"

    key[]: "hint_tb_bef_compl_text"
    val[]: "Solo queda una ubicación para completar tu primer cartel turístico local y que ganes una postal."


    key[]: "hint_tb_done_title"
    val[]: "Cartel turístico explorado"

    key[]: "hint_tb_done_text"
    val[]: "Has explorado con éxito todas las ubicaciones de un cartel turístico local. Puedes ver sus detalles en el <color value=@@clr_sel@@>@@tourist_atlas_link@@</color>. Como recompensa, ya puedes lucir la postal en tu vehículo."


    key[]: "hint_vehicle_prio_title"
    val[]: "Prioridad del cliente: estado del vehículo"

    key[]: "hint_vehicle_prio_text"
    val[]: "El cliente le ha dado mayor prioridad al estado del vehículo: la bonificación o penalización se verá muy afectada por las condiciones en las que llegue. Conduce con precaución y cuídalo bien.<br><offset vshift=8>Pulsa $KEY_advmouse$ para ver los detalles del encargo."


    key[]: "hint_cargo_prio_title"
    val[]: "Preferencia del cliente: manipulación de la mercancía"

    key[]: "hint_cargo_prio_text"
    val[]: "El cliente le ha dado mayor prioridad a la manipulación de la mercancía: la bonificación o penalización se verá muy afectada por el estado en que la entregues. Conduce con precaución y cuídala bien.<br><offset vshift=8>Pulsa $KEY_advmouse$ para ver los detalles del encargo."


    key[]: "hint_time_prio_title"
    val[]: "Prioridad del cliente: puntualidad"

    key[]: "hint_time_prio_text"
    val[]: "El cliente le ha dado mayor prioridad a la gestión del tiempo: la bonificación o penalización se verá muy afectada por tu puntualidad. Conduce con precaución y llega a la hora prevista por el cliente.<br><offset vshift=8>Pulsa $KEY_advmouse$ para ver los detalles del encargo."


    key[]: "hint_car_deliv_title"
    val[]: "Llega al destino"

    key[]: "hint_car_deliv_text"
    val[]: "Detente en la zona designada para finalizar la entrega.<br>Recuerda que tu cliente espera recibirla a una hora concreta."


    key[]: "hint_car_early_title"
	val[]: "Llegada anticipada"

    key[]: "hint_car_early_text"
    val[]: "La entrega está prevista para una hora específica; si llegas antes, el cliente quedará insatisfecho. Planifica tu ruta y usa las áreas de descanso disponibles si lo necesitas."


#!{
    key[]: "hint_sm_throttle_title"
	val[]: "@@throttle_double_tap@@"
#!}

    key[]: "hint_sm_throttle_text"
    val[]: "Puedes habilitar el control inteligente del acelerador en @@desktop_menu_category_options@@. Al activarlo, el vehículo mantendrá un nivel de aceleración reducida por defecto. Tras pulsar dos veces rápidamente el botón de aceleración, el vehículo mantendrá el acelerador al máximo hasta que lo sueltes."
