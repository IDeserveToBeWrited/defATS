#+ Washington TBs and POIs localization.
#@{
	key[]: "tb_wa1"
	val[]: "奥林匹克半岛"

	key[]: "tb_wa1_desc"
	val[]: "奥林匹克半岛展现了一片海洋、森林与群山和谐共存，美景千变万化的天地。岩岸雾气氤氲，高地瀑布飞流，隐秘的山谷中点缀着几座历史悠久的小镇。"

	key[]: "poi_wa1_01"
	val[]: "美国邮局史迹"

	key[]: "poi_wa1_01_desc"
	val[]: "该建筑于1893年在俯瞰汤森港海滨的悬崖上竣工，按联邦设施标准设计，并设有海关大楼，体现了这座城市早期作为新兴国际贸易枢纽的雄心。"

	key[]: "poi_wa1_02"
	val[]: "安吉利斯港"

	key[]: "poi_wa1_02_desc"
	val[]: "安吉利斯港是一座始建于19世纪的沿海城市，最初作为港口和补给点发展起来。如今，它是通往奥林匹克国家公园的重要门户，也是连接美国与加拿大的渡轮港口。"

	key[]: "poi_wa1_03"
	val[]: "克雷森特湖"

	key[]: "poi_wa1_03_desc"
	val[]: "克雷森特湖是华盛顿州第二深的湖泊，以其湛蓝清澈的湖水而闻名，这得益于其较低的氮含量。该湖位于一个热门的休闲区内，周边环绕着步道和原始森林。"
	
	key[]: "poi_wa1_04"
	val[]: "克拉洛克海滩"

	key[]: "poi_wa1_04_desc"
	val[]: "克拉洛克海滩以“生命之树”而闻名。这是一棵北美云杉，其裸露的根系横跨一条小溪，一直延伸到岸边。与高大的典型云杉不同，它更矮、更粗，且饱经风霜，因此成为当地的一处独特而广受欢迎的地标。"

	key[]: "poi_wa1_05"
	val[]: "奥林匹克国家公园"

	key[]: "poi_wa1_05_desc"
	val[]: "奥林匹克国家公园守护着多样化的生态系统，从崎岖的太平洋海岸线与温带雨林，到高山峰峦。该公园最初于1909年被列为国家纪念地，1938年由联邦政府更名为国家公园。"

	key[]: "poi_wa1_06"
	val[]: "格林黑德湿地"

	key[]: "poi_wa1_06_desc"
	val[]: "格林黑德湿地是位于威拉帕湾附近、紧邻101号公路的一处小型水湾与湿地水道。这片沿海河口栖息地经过生态修复，如今已成为支持鲑鱼洄游产卵和观赏丰富水禽的理想场所。"

	key[]: "poi_wa1_07"
	val[]: "达博湾"

	key[]: "poi_wa1_07_desc"
	val[]: "达博湾是一处深邃的峡湾，孕育着鲑鱼、贝类和多样的野生动物。达博湾自然保护区成立于1984年，保护着稀有的盐沼与沙嘴植物群落，维系着功能高度完善的潮汐湿地系统。"


##########################################################################################

	key[]: "tb_wa2"
	val[]: "心脏地带"

	key[]: "tb_wa2_desc"
	val[]: "华盛顿州的心脏地带召唤旅人驶入风景如画的道路，穿越常青森林与静谧的高山湖泊。雷尼尔山雄踞天际线，展现出标志性的壮丽景色，引领人们踏上深入太平洋西北部自然画卷的宁静旅程。"

	key[]: "poi_wa2_01"
	val[]: "雷尼尔山"

	key[]: "poi_wa2_01_desc"
	val[]: "雷尼尔山是华盛顿州最高峰，海拔14411英尺，是一座活跃的复式火山。其冰川滋养河流、塑造山谷，并维系着茂密的森林和野生动物种群，使其成为重要的自然地标。"

	key[]: "poi_wa2_02"
	val[]: "韦纳奇国家森林"

	key[]: "poi_wa2_02_desc"
	val[]: "韦纳奇国家森林横跨山脉、河流和高山山谷。1933年，平民保育团于此地修建了步道和防火瞭望台，在森林的休闲与保护史上留下了深刻的印记。"

	key[]: "poi_wa2_03"
	val[]: "贝克山-斯诺夸尔米国家森林"

	key[]: "poi_wa2_03_desc"
	val[]: "贝克山-斯诺夸尔米国家森林拥有一些美国最早期的冰川监测站，这些站点自20世纪初以来一直追踪着喀斯喀特山脉地区的火山冰流与气候变化。"
	
	key[]: "poi_wa2_04"
	val[]: "韦纳奇河"

	key[]: "poi_wa2_04_desc"
	val[]: "在韦纳奇河沿岸，19世纪早期的灌溉渠道和水磨坊遗迹展现了早期定居者利用河水的方式。早在欧洲人定居之前，当地原住民部落就一直依赖这条盛产鲑鱼的河流获取食物并进行贸易。"

	key[]: "poi_wa2_05"
	val[]: "克拉瓦蒂峰"

	key[]: "poi_wa2_05_desc"
	val[]: "克拉瓦蒂峰于20世纪中期首次被登顶。由于坡势陡峭且覆盖冰川，这座山峰至今仍鲜有人攀登，因此也成为北喀斯喀特山脉中追求孤寂与挑战的登山者向往的目标。"

	key[]: "poi_wa2_06"
	val[]: "干瀑坝"

	key[]: "poi_wa2_06_desc"
	val[]: "干瀑坝为调控当地水系而建，坐落在史前玄武岩悬崖之上，在调节季节性水流的同时，也展露出冰河时期洪水雕凿出的阶地与深潭。"

	key[]: "poi_wa2_07"
	val[]: "白山火警瞭望台"

	key[]: "poi_wa2_07_desc"
	val[]: "此瞭望台设有关于1988年白山火灾的解说牌——这场华盛顿州近年规模最大的野火之一，至今仍在山林间显露着灾痕与生态再生的轨迹。"

	key[]: "wa_cut_helen_desc"
	val[]: "1980年之前，圣海伦斯山呈圆锥形，曾被称为“美国的富士山”。1980年的喷发将其山顶削去了1300英尺，形成了一个马蹄形火山口，如今该火山口的部分区域已被熔岩穹丘和冰川覆盖。"


##########################################################################################


	key[]: "tb_wa3"
	val[]: "葡萄酒之乡"

	key[]: "tb_wa3_desc"
	val[]: "华盛顿州葡萄酒之乡位于喀斯喀特山脉以东，横跨哥伦比亚河谷法定葡萄种植区。这片干旱少雨、阳光充沛的土地以起伏的丘陵与河谷为特征，涵盖塞拉溪、刘易斯与克拉克州立公园，以及历史上原住民世代栖居的故土。"

	key[]: "poi_wa3_01"
	val[]: "清溪瀑布"

	key[]: "poi_wa3_01_desc"
	val[]: "清溪瀑布观景台是白山口峰顶以东一处广受欢迎的休憩点。向东约一英里，有一条岔道通往清溪湖休闲区，该地以垂钓和绝佳的本地野生动物观察机会而闻名。"

	key[]: "poi_wa3_02"
	val[]: "锡拉溪大桥"

	key[]: "poi_wa3_02_desc"
	val[]: "弗雷德•G•雷德蒙（Fred G. Redmon）大桥，又称锡拉溪大桥，是一座位于亚基马县的双拱桥。建成时，它是美国最长的混凝土拱桥，也是该州最高的公路桥。"

	key[]: "poi_wa3_03"
	val[]: "葡萄园"
	
	key[]: "poi_wa3_03_desc"
	val[]: "华盛顿州的河谷和肥沃的土壤孕育了众多葡萄品种，包括雷司令、赤霞珠和梅洛。葡萄园是该州农业和本地景观的重要组成部分。"

	key[]: "poi_wa3_04"
	val[]: "埃德•亨德勒大桥"

	key[]: "poi_wa3_04_desc"
	val[]: "这座建于1978年的桥梁有时也被称为“城际大桥”，其桥体横跨哥伦比亚河，连接华盛顿州东南部的帕斯科和肯纳威克两地。自通车以来，它一直被视作华盛顿州三城地区的地标与象征。"

	key[]: "poi_wa3_05"
	val[]: "刘易斯与克拉克州立公园"

	key[]: "poi_wa3_05_desc"
	val[]: "作为华盛顿州最早设立的州立公园之一，刘易斯与克拉克州立公园守护着沿古老原住民路线生长的原始森林。其名字是为了纪念“探索军团”，这里的密林幽谷亦重现了梅里韦瑟·刘易斯在日记中描绘的苍莽景象。"

	key[]: "poi_wa3_06"
	val[]: "哥伦比亚县法院大楼"

	key[]: "poi_wa3_06_desc"
	val[]: "哥伦比亚县法院大楼反映了县政府在日常生活中占据核心地位的时代。在发展迅速且与州首府联系有限的时期，法院是权威的主要来源，并能满足民众的迫切需求。"

	key[]: "poi_wa3_07"
	val[]: "美洲原住民部落"

	key[]: "poi_wa3_07_desc"
	val[]: "哥伦比亚河谷及周边地区曾是包括亚卡马族（Yakama）、瓦拉瓦拉族（Walla Walla）和乌马蒂拉族（Umatilla）在内的原住民族的故土。如今，这些族群依然在这个地区生活，传承着文化传统，并管理着土地和水资源。"

##########################################################################################

#@}




#+ Oregon TBs and POIs localization.
#@{
	key[]: "tb_or1"
	val[]: "太平洋海岸"

	key[]: "tb_or1_desc"
	val[]: "俄勒冈州的太平洋海岸线蜿蜒穿过嶙峋岬角，沿途遍布观景胜地。哈萨塔角灯塔俯瞰惊涛拍岸，银角、奥菲尔路畔、姐妹岩与亲吻石等玄武岩峭壁在此间巍然屹立，迎向太平洋的浪潮。"

	key[]: "landmark_or_astoria_b_desc"
	val[]: "这座横跨哥伦比亚河且长达四英里的桥梁将俄勒冈州和华盛顿州连接起来，从这里可以观赏到河流入海口和太平洋地平线的美景。"

	key[]: "poi_or1_01"
	val[]: "银角解说观景台"

	key[]: "poi_or1_01_desc"
	val[]: "位于坎农海滩正南方的这处观景台，可将草垛岩与崎岖海岸线尽收眼底，日落时分的景致尤为壮丽。"

	key[]: "or_cut_lighthouse_desc"
	val[]: "俄勒冈州最高的灯塔建于1873年，矗立在纽波特附近的一处玄武岩岬角上。"

	key[]: "or_cut_newport_desc"
	val[]: "亚奎纳湾大桥于1936年建成，是俄勒冈州最具代表性的沿海地标之一。该桥由著名工程师康德•麦卡洛（Conde McCullough）设计，其优雅的拱形结构横跨亚奎纳湾，至今仍是101号国道的一大特色。"

	key[]: "or_cut_thor_desc"
	val[]: "佩尔佩图阿角有一处天然落水洞，汹涌的浪涛在此崩解，让人产生大海正在流走的错觉。"

	key[]: "poi_or1_02"
	val[]: "奥菲尔路畔"

	key[]: "poi_or1_02_desc"
	val[]: "一处临近黄金海滩的静谧停靠点，游客可在此舒展筋骨、观赏浪涛，或漫步沙滩寻觅浮木与玛瑙。"

	key[]: "poi_or1_03"
	val[]: "姐妹岩观景台"

	key[]: "poi_or1_03_desc"
	val[]: "海上矗立着数座嶙峋岩柱，小径向下延伸至悬崖环抱的隐秘袖珍海滩。"

	key[]: "poi_or1_04"
	val[]: "亲吻石"

	key[]: "poi_or1_04_desc"
	val[]: "黄金海滩以南的路边景点，两座巨型岩体在沙滩上相依而立，成为备受青睐的摄影打卡胜地。"


##########################################################################################

	key[]: "tb_or2"
	val[]: "狂野东部"

	key[]: "tb_or2_desc"
	val[]: "这片常被称为俄勒冈“狂野东部”的区域，展现着数亿年来地质力量塑造的地貌奇观，许多地质活动至今仍在上演。在这浩瀚的时间尺度下，人类历史虽显短暂，却也留下了与这片土地同样动人心魄的印记。"

	key[]: "landmark_or_deadman_p_desc"
	val[]: "位于彭德尔顿附近的这处瞭望区可俯瞰“亡者山口”——得名于1870年代班诺克战争期间一名货车司机遇害的事件。而在更早的数十年前，无数移民马车曾沿俄勒冈小径翻越这片山丘。"

	key[]: "or_cut_395_desc"
	val[]: "曾被称为“三旗公路”的美国395号公路，昔日纵贯加墨两国边境，串联起沙漠、森林与山峦。如今这条公路虽在加州汇入I-15号公路并止于此，其原始路段的遗迹仍在圣迭戈附近留存。"

	key[]: "poi_or2_01"
	val[]: "马卢尔国家森林"

	key[]: "poi_or2_01_desc"
	val[]: "马卢尔国家森林位于蓝山地区。1.5亿多年前，该地部分最古老的岩石曾是太平洋中火山岛的一部分，后来与大陆融合在一起。"
	
	key[]: "poi_or2_02"
	val[]: "恶地荒野"

	key[]: "poi_or2_02_desc"
	val[]: "位于本德以东的恶地荒野，是一片由远古熔岩流与风积火山灰塑造而成的嶙峋火山地貌。其扭曲的熔岩构造、沙质土壤与荒凉地形，共同造就了该州最具独特性的高海拔沙漠环境之一。"

	key[]: "poi_or2_03"
	val[]: "艾伯特湖"

	key[]: "poi_or2_03_desc"
	val[]: "艾伯特湖于1843年首次被绘入地图，湖区至今已有超过一万年的人类活动史。尽管湖水盐度过高，不适合鱼类生存，但它仍是鸟类在太平洋迁徙通道上的重要停歇地，且由于气候变化的影响，该湖面积在近几十年里持续缩小。"

	key[]: "poi_or2_04"
	val[]: "东斯廷斯游览路线"

	key[]: "poi_or2_04_desc"
	val[]: "东斯廷斯游览路线沿78号公路穿越斯廷斯山与阿尔沃德沙漠。其亮点在于阿尔沃德沙漠干盐湖——俄勒冈州最大的干涸湖床之一，随季节更迭在浅水湖泊与广袤荒原之间变换。"

	key[]: "poi_or2_05"
	val[]: "多尔蒂滑坡"

	key[]: "poi_or2_05_desc"
	val[]: "驾车穿越多尔蒂滑坡这座由火山活动造就的岩层构造仅需不到一小时，而大自然却用了约1600万年才将这片地貌塑造成今日的模样。"


##########################################################################################

	key[]: "tb_or3"
	val[]: "奥格登州"

	key[]: "tb_or3_desc"
	val[]: "这条路线沿着俄勒冈内陆的南北走廊延伸，穿越森林与高海拔荒漠。皮毛商人彼得·斯基恩·奥格登（Peter Skene Ogden）于1820年代首次勘探此路，后在二战期间因其木材资源与运输通道的战略价值而备受重视。"
	
	key[]: "poi_or3_01"
	val[]: "斯普林菲尔德火焰"

	key[]: "poi_or3_01_desc"
	val[]: "这座近65英尺高的雕塑矗立在斯普林菲尔德的北部门户，其造型设计形似火焰，既为往来旅客指引方向，也为当地居民和游客充当共同地标。"

	key[]: "poi_or3_02"
	val[]: "桑蒂亚姆货运公路"

	key[]: "poi_or3_02_desc"
	val[]: "此处东侧的山口——威利山口，曾被命以安德鲁·威利（Andrew Wiley）之名，1859年由寻找牧场的拓荒者首次探勘。1864年虽规划建设军用道路，但大部分未建成。1868年至1914年间，作为收费路线的桑蒂亚姆货运公路正式开放运营。"

	key[]: "poi_or3_03"
	val[]: "老兵纪念公路"

	key[]: "poi_or3_03_desc"
	val[]: "2012年11月9日，该公路北门户处，比格斯枢纽以南，18座纪念路牌的最后两座正式落成。这些路牌标志着鲁弗斯营地成为全国首条二战老兵纪念公路的北端起点。"

	key[]: "poi_or3_04"
	val[]: "奥格登州立观景点"

	key[]: "poi_or3_04_desc"
	val[]: "这座路旁纪念地以19世纪初的探险家、哈德逊湾公司首席贸易员彼得·斯基恩·奥格登（Peter Skene Ogden）命名，铭记他穿越斯内克河地区的远征，以及作为首批探索大盐湖盆地的先驱者之一的历史角色。"

	key[]: "landmark_or_fremont_b_desc"
	val[]: "此桥与波特兰的弗里蒙特街皆以早期加利福尼亚和俄勒冈地区的探险家约翰·C·弗里蒙特（John C. Frémont）命名。大桥拥有俄勒冈最长的跨河主桥段，是世界第二长的系杆拱桥。"

	
##########################################################################################

#@}



#+ California TBs and POIs localization.
#@{
	key[]: "tb_ca1"
	val[]: "金色地平线"

	key[]: "tb_ca1_desc"
	val[]: "标志性的桥梁耸立在波光粼粼的水面上，将阿尔卡特拉斯岛、圣克鲁斯与本地区的山岭和社区连接在一起。从熙熙攘攘的街道和历史遗迹，到阳光普照的海滩和风景如画的海岸线，湾区给人带来无与伦比的加州体验。"

	key[]: "ca_cut_golden_gate_bridge_desc"
	val[]: "这座连接旧金山湾与太平洋的大桥是旧金山和加利福尼亚州的标志性建筑。1937年通车时，它同时保持着世界最长和最高悬索桥的纪录。"

	key[]: "poi_ca1_01"
	val[]: "阿尔卡特拉斯岛"

	key[]: "poi_ca1_01_desc"
	val[]: "1934年至1963年间，阿尔卡特拉斯岛曾是一座联邦监狱的所在地。这里曾关押过一部分美国最臭名昭著的罪犯，如今它已成为一处史迹，亦是热门旅游景点。"

	key[]: "ca_cut_richmond_desc"
	val[]: "里士满-圣拉斐尔大桥横跨旧金山湾，连接里士满和圣拉斐尔两地。大桥于1956年通车，承担着湾区北部的交通功能，它采用悬臂与桁架相结合的设计，是重要的区域交通枢纽。"
	
	key[]: "poi_ca1_02"
	val[]: "金银岛"

	key[]: "poi_ca1_02_desc"
	val[]: "金银岛是为1939年金门万国博览会建造的人工岛。该岛曾作为海军基地使用，如今它正被重新开发，用于住宅和商业用途。"

	key[]: "poi_ca1_03"
	val[]: "冲浪之城"

	key[]: "poi_ca1_03_desc"
	val[]: "圣克鲁斯的冲浪雕塑致敬了这座城市的冲浪传统与文化。这座雕塑矗立在海滨附近，旨在颂扬当地冲浪者以及这项塑造了圣克鲁斯身份认同和沿海社区的运动。"

	key[]: "poi_ca1_04"
	val[]: "麦当娜旅馆"

	key[]: "poi_ca1_04_desc"
	val[]: "这里曾是152号州道最高点的一家人气餐厅兼活动地标。由于公路问题，该场所自2004年起便已关闭，但至今仍是当地历史及鬼故事论坛上的热门话题。"



##########################################################################################

	key[]: "tb_ca2"
	val[]: "沙斯塔线"

	key[]: "tb_ca2_desc"
	val[]: "沙斯塔线蜿蜒穿过沙斯塔山脚下的松林和波光粼粼的高山湖泊。线路在隐秘的山谷间起伏蜿蜒，载着游客向南行进，山峦逐渐淡出视野，取而代之的是加利福尼亚北部的古老红杉林。"

	key[]: "poi_ca2_01"
	val[]: "沙斯塔-特里尼蒂国家森林"

	key[]: "poi_ca2_01_desc"
	val[]: "在加利福尼亚州最大的国家森林——沙斯塔-特里尼蒂国家森林内，贯穿着特里尼蒂遗产风景道路。这条公路沿着19世纪淘金者和拓荒者走过的路线延伸。"

	key[]: "poi_ca2_02"
	val[]: "大潟湖"

	key[]: "poi_ca2_02_desc"
	val[]: "大潟湖是洪堡潟湖州立公园内三座潟湖中最大且最靠南的一座。这些浅水海岸盆地位于岩石岬角之间，海浪在此堆筑沙堤，将潟湖与太平洋分隔开来。"

	key[]: "or_cut_sequoia_desc"
	val[]: "红杉国家公园保护着一些世界最高、最古老的海岸红杉，这些树木的高度超过370英尺，寿命可达2000年。连同附近的州立公园一起，它保存着地球现存约35%的原始红杉林。"
	
	key[]: "poi_ca2_03"
	val[]: "史密斯河"

	key[]: "poi_ca2_03_desc"
	val[]: "该保护区位于加利福尼亚西北部的六河国家森林内，于1990年由美国国会指定设立，旨在保护其风景、生态和文化价值。史密斯河是加利福尼亚唯一一条未建水坝且自由流淌的主要河流。"

	key[]: "poi_ca2_04"
	val[]: "威士忌溪桥"

	key[]: "poi_ca2_04_desc"
	val[]: "威士忌溪桥于1961年建成，是一座三联焊接板梁桥。其特别之处在于采用了三种不同等级钢材的创新焊接工艺，是早期桥梁设计的典范。"

	key[]: "poi_ca2_05"
	val[]: "沙斯塔湖"

	key[]: "poi_ca2_05_desc"
	val[]: "沙斯塔湖是加利福尼亚州最大的水库，由沙斯塔大坝拦截萨克拉门托河形成。该水库于1945年建成，可以提供水源，亦可水力发电，并且还是一处风景优美的休闲胜地。"

	key[]: "poi_ca2_06"
	val[]: "沙斯塔山"

	key[]: "poi_ca2_06_desc"
	val[]: "自19世纪20年代起，作为喀斯喀特山脉第二高峰的沙斯塔山，就一直指引着沿着其山脚的锡斯基尤小径前行的旅人。这条路线后来演变为5号州际公路，如今每年都有成千上万的人经由此往沙斯塔山。"



##########################################################################################

	key[]: "tb_ca3"
	val[]: "塞拉穿越线"

	key[]: "tb_ca3_desc"
	val[]: "在高耸的内华达山脉脚下，本顿旅馆坐落在开阔山谷与连绵丘陵间。塞拉穿越线蜿蜒于静谧的高荒漠公路之上，远处层峦叠嶂勾勒出亘古如初的全景画卷，吸引着旅行者畅游这片广袤天地。"

	key[]: "ca_cut_olmsted_point_desc"
	val[]: "约塞米蒂国家公园设立于1890年，是游客量最大的国家公园之一。它以北美最高的瀑布——约塞米蒂瀑布、庞大的步道网络和树龄超过3000年的巨杉而闻名。"

	key[]: "poi_ca3_01"
	val[]: "蒂奥加路"

	key[]: "poi_ca3_01_desc"
	val[]: "蒂奥加路是纵贯约塞米蒂国家公园核心区的标志性景观公路，作为加利福尼亚州海拔最高的公路山口，其串联起内华达山脉东西两麓。"

	key[]: "poi_ca3_02"
	val[]: "莫诺湖"

	key[]: "poi_ca3_02_desc"
	val[]: "莫诺湖已有100多万年的历史，是北美最古老的湖泊之一。由于没有天然出水口，数千年来，它不断积聚了由内华达山脉东部溪流带来的盐分和矿物质。"
	
	key[]: "poi_ca3_03"
	val[]: "太浩湖"

	key[]: "poi_ca3_03_desc"
	val[]: "太浩湖位于太浩盆地内，大约形成于200万年前，其现今的形态是由冰河时代的冰川塑造而成的。它是北美最大的高山湖泊，也是美国第二深的湖泊。"

	key[]: "poi_ca3_04"
	val[]: "埃尔多拉多国家森林"

	key[]: "poi_ca3_04_desc"
	val[]: "埃尔多拉多国家森林是一个重要集水区的一部分，该集水区为数百万加利福尼亚州居民提供水源，并支撑着生产全美近一半水果和蔬菜的农场。"

	key[]: "poi_ca3_05"
	val[]: "本顿温泉旅馆"

	key[]: "poi_ca3_05_desc"
	val[]: "本顿是莫诺县最古老的城镇之一，最初由派尤特（Paiute）族为利用当地的温泉而建立。19世纪60年代，这里成为定居者和矿工的中转站。这家旅馆建于20世纪40年代，采用当地的浮石建造，取代了1904年的那家拥有十间客房而共用一间浴室的宾馆。"



##########################################################################################

	key[]: "tb_ca4"
	val[]: "日与沙"

	key[]: "tb_ca4_desc"
	val[]: "死亡谷的沙漠在无垠的天空下绵延，沙丘、嶙峋的山峰和龟裂的平原交相辉映。野兔在阳光照耀的沙地上跳跃，骸骨无声标记着小道，孤寂的道路蜿蜒穿过冷峻不屈的荒原，考验并震撼着每一位踏入其中的人。"

	key[]: "poi_ca4_01"
	val[]: "隆派恩"

	key[]: "poi_ca4_01_desc"
	val[]: "隆派恩是位于加利福尼亚州欧文斯谷，是内华达山脉东麓的一个小镇。这里因邻近的阿拉巴马山而闻名，长期以来一直是徒步者、登山者和电影制作人探索周边山脉及沙漠景观的门户。"

	key[]: "poi_ca4_02"
	val[]: "死亡谷国家公园"

	key[]: "poi_ca4_02_desc"
	val[]: "死亡谷是美国最极端的地貌之一：在不同区域，它可能同时呈现最低的海拔、最炎热干燥的气候，甚至最高的地势起伏。早在十九世纪初拓荒者到来之前，原住民族群便在这片严酷却历史深厚的土地上狩猎、采集，并在此繁衍生息。"

	key[]: "poi_ca4_03"
	val[]: "克劳利神父观景点"

	key[]: "poi_ca4_03_desc"
	val[]: "这个观景点是游客常常驻足的热门地点。被称为“沙漠神父”的约翰•J•克劳利（John J. Crowley）神父曾多次在此停留。观景点位于公园西界附近，可将彩虹峡谷的壮丽景色尽收眼底——一片由远古火山活动塑造而成的多彩地貌景观。"
	
	key[]: "poi_ca4_04"
	val[]: "莫哈韦的瓦利韦尔斯"

	key[]: "poi_ca4_04_desc"
	val[]: "在莫哈韦沙漠的瓦利韦尔斯，古老的地下水排泄沉积物记录了冰河时代曾存在的湿地环境。这些古井揭示了地下水过去如何在这片原本干旱的沙漠中滋养沼泽和茂密的植被。"

	key[]: "poi_ca4_05"
	val[]: "科罗拉多河印第安保留地"

	key[]: "poi_ca4_05_desc"
	val[]: "该保留地沿科罗拉多河延伸，横跨亚利桑那州和加利福尼亚州。保留地于1865年为沿河部落设立，是莫哈韦（Mohave）族、切梅韦维（Chemehuevi）族、霍皮（Hopi）族和纳瓦霍（Navajo）族人民的家园，如今这里仍维持着农业生产和社区生活。"

##########################################################################################

#@}



#+ Idaho TBs and POIs localization.
#@{

    key[]: "tb_id1"
	val[]: "宝藏谷"

	key[]: "tb_id1_desc"
	val[]: "位于爱达荷州西南部的宝藏谷，拥有由美洲原住民部落、早期毛皮商人和俄勒冈小径定居者共同塑造的丰富历史。该地的名称反映了这一区域所蕴藏的资源和机遇。此后，该地因农业、铁路及以博伊西为中心的区域贸易而进一步繁荣。"

	key[]: "poi_id1_01"
	val[]: "萨蒙河"

	key[]: "poi_id1_01_desc"
	val[]: "爱达荷州的萨蒙河蜿蜒延伸425英里，穿越一条深邃而崎岖的峡谷。由于早期的船只无法顶着它强力而充满挑战的激流逆流而上，这条河获得了“不归河”的绰号。"

	key[]: "poi_id1_02"
	val[]: "博伊西国家森林"

	key[]: "poi_id1_02_desc"
	val[]: "博伊西国家森林横跨易受侵蚀的爱达荷岩基，其崎岖的地貌由火山活动塑造而成。这种地质遗产在陡峭的峡谷和散布于各地的众多天然温泉中表现得最为明显。"

	key[]: "poi_id1_03"
	val[]: "霍斯舒本德"

	key[]: "poi_id1_03_desc"
	val[]: "1862年，博伊西盆地发现金矿后，在河边过冬的矿工们建立了霍斯舒本德。该镇最初以当地一家锯木厂主的名字命名为“沃里纳斯维尔”，1867年随着此地成为淘金者的重要中转站而改为现名。"
	
	key[]: "poi_id1_04"
	val[]: "收费站"

	key[]: "poi_id1_04_desc"
	val[]: "1864年，一条新的峡谷路线取代了陡峭的糖溪小道。此后二十年，通行费维系着道路养护，而詹姆斯·A·波特（James A. Porter）经营的著名旅馆与奶场，则成为往来旅人途中休憩的首选驿站。"

	key[]: "poi_id1_05"
	val[]: "城堡岩"

	key[]: "poi_id1_05_desc"
	val[]: "在通往卡马斯草原的途中，城堡岩的花岗岩露岩曾是俄勒冈小道上移民经古德尔近道时的标志性地标。自1862年沿用至汽车时代，这些罕见岩层为途中的旅行者提供了引人注目的路标。"

    key[]: "poi_id1_06"
	val[]: "鸭谷印第安保留地"

	key[]: "poi_id1_06_desc"
	val[]: "1886年，克利夫兰总统通过“平顶帽扩展”行政令，将鸭谷保留地扩展至爱达荷州。至1934年，迁入该保留地的各支部落正式获得联邦政府承认，合并为统一的肖肖尼-派尤特（Shoshone-Paiute）部落。"


##########################################################################################

    key[]: "tb_id2"
	val[]: "魔力谷"

	key[]: "tb_id2_desc"
	val[]: "20世纪初，I•B•佩林（I.B. Perrine）通过修建米尔纳大坝，将爱达荷州干旱的沙漠改造成成了农田。这座1905年竣工的大坝利用斯内克河的水源，如同施展魔力般改变了地貌，由此形成了“魔力谷”，进而催生了一批当今依然繁荣的农业小镇。"

	key[]: "id_cut_perrine_desc"
	val[]: "肖肖尼瀑布位于特温福尔斯市的边缘，其212英尺的海拔高于尼亚加拉大瀑布，是斯内克河上的一处壮丽地标。"

	key[]: "id_cut_galena_desc"
	val[]: "这座矿业小镇于1879年发现铅银矿后建立，但随着矿价下跌，至19世纪90年代已逐渐衰落。如今，该地区作为休闲中心蓬勃发展，这里不仅坐落着历史悠久的格伦纳旅馆，附近还有风景秀丽的格伦纳峰。"

	key[]: "poi_id2_01"
	val[]: "野牛跳"

	key[]: "poi_id2_01_desc"
	val[]: "位于查利斯的野牛跳是一处历史遗址，当地原住民曾在此将野牛赶下悬崖以进行捕猎。这片具有战略意义的地貌被使用了2000多年，让人得以一窥古代的集体狩猎传统。"
	
	key[]: "poi_id2_02"
	val[]: "大观峡谷"

	key[]: "poi_id2_02_desc"
	val[]: "大观峡谷坐落于连接雪峰与火山口的景观大道美国93号公路上，可饱览失落河山脉的壮丽全景。这条山链汇聚了爱达荷州九座最高峰，使峡谷成为该景观路线的一道靓丽风景。"

	key[]: "landmark_id_mackay_rs_desc"
	val[]: "大失落河最初以毛皮猎人塞里·戈丁（Thyery Goddin）的名字命名为“戈丁河”，因其河水没入熔岩层而闻名。这股“失落”的水流在地下穿行，最终在蛇河附近的千泉奇观处重新涌出地面。"

    key[]: "poi_id2_03"
	val[]: "麦凯鬼镇群"

	key[]: "poi_id2_03_desc"
	val[]: "依托白山矿区的矿工山而建，白峰、峭壁溪等城镇曾是20世纪中期铜矿、金矿与银矿热潮的核心。这些遗址至今仍是爱达荷州矿业历史的重要见证。"

	key[]: "id_cut_craters_desc"
	val[]: "月球陨坑形成于一万五千年前的火山喷发，展现出熔岩流与火山渣锥构成的浩瀚地貌。其超凡脱俗的奇特地貌如此独特，甚至曾被美国宇航局选作宇航员的登月训练基地。"



##########################################################################################

#@}



#+ Montana TBs and POIs localization.
#@{

    key[]: "tb_mt1"
	val[]: "冰川通道"

	key[]: "tb_mt1_desc"
	val[]: "冰川国度拥有落基山脉中为数不多的几座仍然活跃的冰川。数千年来，这些古老的冰体雕琢出深邃的山谷、陡峭的峰峦和纯净的湖泊，塑造了今日蒙大拿州西部的独特地貌。"

	key[]: "poi_mt1_01"
	val[]: "库特内瀑布"

	key[]: "poi_mt1_01_desc"
	val[]: "库特内瀑布是蒙大拿州最大的未筑坝瀑布，也是该地区的主要景点之一。库特内河在很短的距离内下落约300英尺，形成了一道气势磅礴、景色优美的瀑布，其令人难忘的壮丽景色吸引了众多游客。"

	key[]: "poi_mt1_02"
	val[]: "伯恩路侧公园"

	key[]: "poi_mt1_02_desc"
	val[]: "恶岩峡谷曾是弗拉特黑德河畔旅行者的热门休憩点，以垂钓、美景和天然冷泉闻名——过往司机常取此泉水为过热的汽车散热器降温。1956年，此地正式成为蒙大拿州首批路侧休憩区之一，定名为伯恩路侧公园。"

	key[]: "poi_mt1_03"
	val[]: "天堂峰"

	key[]: "poi_mt1_03_desc"
	val[]: "作为冰川国家公园最具标志性的山峰之一，“天堂峰”由探矿者路易·迈耶（Louie Meyer）于19世纪90年代命名。登山者被其壮美与高耸的花园墙所震撼，视之为旅途中所见最超凡脱俗的景观。"

	key[]: "mt_cut_glacier_national_park_desc"
	val[]: "被誉为“大陆皇冠”的冰川国家公园设立于1910年。该地由远古冰川塑造而成，交通随着1932年“通向太阳之路”的竣工而变得更加便利，后者当今已成为一处具有历史意义的工程地标。"

	key[]: "poi_mt1_04"
	val[]: "黑脚印第安人纪念碑"

	key[]: "poi_mt1_04_desc"
	val[]: "冰川国家公园的东缘是黑脚族（Blackfeet Nation）的所在。他们被誉为“大平原的勇士”，据信其族名源于灰烬染黑的莫卡辛鞋。如今，公园内仍有若干地点被该部落视作圣地。"

	key[]: "mt_cut_flathead_lake_desc"
	val[]: "弗拉特黑德湖是美国本土水域面积最大的天然淡水湖。该湖由周边山脉的融雪补给，湖水异常清澈，每隔几年就会完全更新一次，因此成为世界上最干净的大型湖泊之一。"

	key[]: "mt_cut_thompson_falls_desc"
	val[]: "这座以英裔加拿大毛皮商人兼制图师大卫·汤普森（David Thompson）命名的小镇，在1881年铁路贯通后开始繁荣。随着附近科达伦地区淘金热的兴起，该镇作为默里小径上矿工重要中转站得以进一步扩展。"

	key[]: "landmark_mt_missoula_desc"
	val[]: "这座新古典主义风格的米苏拉县法院大楼由砂岩建成，由A. J. 吉布森（A. J. Gibson）于1910年设计，取代了此前规模较小的旧建筑。米苏拉县成立于1860年，是蒙大拿州历史最悠久的行政区之一，县界自比特鲁特山脉延伸至落基山脉。"

    key[]: "poi_mt1_05"
	val[]: "洛洛溪"

	key[]: "poi_mt1_05_desc"
	val[]: "洛洛与洛洛山口之间的走廊遵循一条沿着洛洛溪延伸的古道。这里曾经见证了内兹珀斯（Nez Perce）族、早期定居者以及刘易斯与克拉克探险队的脚步，至今仍是重要的文化与历史景观，分布着多处解说点。"

##########################################################################################

    key[]: "tb_mt2"
	val[]: "大平原"

	key[]: "tb_mt2_desc"
	val[]: "蒙大拿州的大平原覆盖该州东部，以无垠的草地、起伏的草原和广阔的天空为特色。该地区出土了一部分北美最重要的恐龙化石，让人得以一窥数百万年前的自然景观。"

	key[]: "poi_mt2_01"
	val[]: "地狱溪地层"

	key[]: "poi_mt2_01_desc"
	val[]: "地狱溪地层以蒙大拿州乔丹附近的地狱溪为中心，保存了由河流、森林和沼泽构成的远古亚热带景观。该地层形成于6700万至6600万年前，因其丰富的恐龙化石而闻名于世，其中包括标志性的霸王龙。"

	key[]: "poi_mt2_02"
	val[]: "黄石河"

	key[]: "poi_mt2_02_desc"
	val[]: "黄石河是美国本土最长的自由流动河流。它发源自黄石国家公园，流淌676英里，经过怀俄明州和蒙大拿州后汇入密苏里河，沿途全程未建任何水坝。"

	key[]: "poi_mt2_03"
	val[]: "格兰迪龙"

	key[]: "poi_mt2_03_desc"
	val[]: "位于格兰代夫的格兰迪龙，是一座真实尺寸的三角龙雕像，彰显了该地区深厚的恐龙遗产。这座约10英尺高的雕塑，已成为恐龙小径上广受欢迎的标志性景观。"
	
	key[]: "poi_mt2_04"
	val[]: "密苏里河"

	key[]: "poi_mt2_04_desc"
	val[]: "密苏里河素有“大泥河”之称，是美国最长的河流。它发源自蒙大拿州的落基山脉，流经2341英里后汇入密西西比河，在探险、贸易及美国边疆西扩的过程中发挥了至关重要的作用。"

	key[]: "mt_cut_fort_peck_spillway_desc"
	val[]: "建于大萧条时期的佩克堡水坝，是世界上最大的水力冲填式土坝。作为美国历史上规模最宏大的公共工程之一，它的建设旨在创造就业岗位、调控洪水并开发水电资源。"

    key[]: "poi_mt2_05"
	val[]: "河谷县开拓者博物馆"

	key[]: "poi_mt2_05_desc"
	val[]: "这座博物馆通过阿西尼博因（Assiniboine）人、铁路、农业、佩克堡水坝以及刘易斯与克拉克远征等主题展览，展现蒙大拿州东北部的历史脉络。馆内还藏有大量档案资料，并拥有全美最丰富的阿西尼博因文化藏品系列之一。"

	key[]: "poi_mt2_06"
	val[]: "沉睡水牛岩"

	key[]: "poi_mt2_06_desc"
	val[]: "这些巨大的冰川漂砾曾是原住民部落的神圣地标。它们由远古冰川塑造并搬运而来。较小的那块岩石名为“水牛岩”，其形状酷似水牛；而较大的那块名为“药岩”，表面刻有各种岩画。"



##########################################################################################

#@}



#+ Wyoming TBs and POIs localization.
#@{

    key[]: "tb_wy1"
	val[]: "水牛小径"

	key[]: "tb_wy1_desc"
	val[]: "坐落在黄石与大提顿之间的这片土地，其活跃的火山系统孕育着间歇泉与温泉，而冰川与断层则雕琢出巍峨群峰与深邃峡谷。正是这些自然伟力共同将怀俄明州西北部塑造成为美国西部地质活动最活跃、景观最具标志性的区域。"

	key[]: "landmark_wy_yellowsto_desc"
	val[]: "黄石公园成立于1872 年，是世界上第一个国家公园，它坐落在一座巨大的休眠火山之上。这里拥有全球约一半的活跃间歇泉，同时也守护着地球上规模最大且保存最完好的温带生态系统之一。"

	key[]: "poi_wy1_01"
	val[]: "下间歇泉盆地"

	key[]: "poi_wy1_01_desc"
	val[]: "下间歇泉盆地是黄石公园最大的间歇泉盆地，密集分布着大量间歇泉、温泉和汽孔。这里由地下深处的岩浆热能驱动，为公园内最活跃的地热景观之一。"

	key[]: "poi_wy1_02"
	val[]: "黄石湖"

	key[]: "poi_wy1_02_desc"
	val[]: "黄石湖是北美最大的高海拔湖泊，栖息着北美数量最多的野生切喉鳟种群。科学家认为，该湖曾有水流通向太平洋，使鱼类能够通过双洋山口（Two Ocean Pass）穿越大陆分水岭。"
	
	key[]: "poi_wy1_03"
	val[]: "水牛比尔大坝"

	key[]: "poi_wy1_03_desc"
	val[]: "水牛比尔大坝于1910年建成，是美国最早的混凝土拱坝之一。大坝高325英尺，为当时世界最高，成为了早期工程创新的标志性建筑。"

	key[]: "poi_wy1_04"
	val[]: "科尔特地狱"

	key[]: "poi_wy1_04_desc"
	val[]: "科尔特地狱是肖肖尼河畔的一处历史悠久的地热区，1807年由探险家约翰•科尔特（John Colter）命名。早期的山地居民将此处冒着蒸汽的汽孔和刺鼻的硫磺味比作“地狱”。不过，这里当今只有温泉和汽孔仍保持活跃。"

	key[]: "wy_cut_grand_teton_desc"
	val[]: "冰川雕琢的陡峭群峰从杰克逊谷地拔地而起，构成了大提顿国家公园的壮阔轮廓。这些曾被毛皮猎人称为“领航峰”的山峦，因其在平原上突出的辨识度，至今仍是美国西部最具代表性的地标之一。"

	key[]: "poi_wy1_05"
	val[]: "克罗之心孤峰"

	key[]: "poi_wy1_05_desc"
	val[]: "克罗之心孤峰这座显著的地标得名于1866年肖肖尼（Shoshone）族与克罗（Crow）族之间的一场战役。据传，获胜的肖肖尼族酋长瓦沙基（Washakie）将克罗族酋长的心脏置于峰顶示警，由此赋予了这座孤峰流传至今的名字。"

##########################################################################################

    key[]: "tb_wy2"
	val[]: "红沙漠"

	key[]: "tb_wy2_desc"
	val[]: "怀俄明州的红沙漠是一片广袤的高海拔沙漠盆地，以风蚀沙丘、三齿蒿平原以及鲜明的红岩地层为特征。作为北美最大的无人区之一，这里的地貌是由极端气候、远古湖床与漫长的迁徙路线共同塑造而成的。"

	key[]: "poi_wy2_01"
	val[]: "红峡谷"

	key[]: "poi_wy2_01_desc"
	val[]: "约六千万年前风河山脉隆起期间形成的红峡谷，其独特的红色崖壁由楚格沃特岩层构成。岩层中铁质的氧化作用赋予了峡谷鲜明的赤红色彩，正是其名称的灵感来源。"

	key[]: "poi_wy2_02"
	val[]: "权力地景"

	key[]: "poi_wy2_02_desc"
	val[]: "野猪獠牙——这座矗立在怀俄明州红漠之上、高达120多米的火山岩构造，是数百万年前形成的火山侵蚀核心。它俯瞰着广袤的基尔佩克沙丘群，而后者是北美现存最大流动沙丘区的重要组成部分。"

	key[]: "poi_wy2_03"
	val[]: "石泉城"

	key[]: "poi_wy2_03_desc"
	val[]: "石泉城因其多元的移民传统被誉为“五十六族之城”。19世纪末，来自世界各地的人们聚集于此，在联合太平洋铁路的煤矿工作。这座城市也与著名的亡命之徒布屈·卡西迪（Butch Cassidy）有关。"
	
	key[]: "poi_wy2_04"
	val[]: "布屈·卡西迪小屋"

	key[]: "poi_wy2_04_desc"
	val[]: "布屈·卡西迪（Butch Cassidy）是一个著名的亡命之徒，他领导的“狂野帮”以劫掠火车与银行在旧西部臭名昭著。其绰号“布屈”（屠夫）正是源于在石泉城肉铺工作的经历。1899年的威尔科克斯火车劫案，成为了他最具传奇性与影响力的抢劫事件。"

	key[]: "wy_cut_evanston_desc"
	val[]: "埃文斯顿由联合太平洋铁路公司于1869年建立，其名称源自测量员詹姆斯•A•埃文斯（James A. Evans）。该市作为铁路枢纽发展壮大，后来成为农业、石油和天然气领域的区域中心。"

    key[]: "poi_wy2_05"
	val[]: "兰德捷径"

	key[]: "poi_wy2_05_desc"
	val[]: "兰德捷径建于《1857年太平洋马车道法案》通过之后，是美国西部最早由联邦政府资助修建的马车道之一。它以工程师弗雷德里克•W•兰德（Frederick W. Lander）的名字命名，为西进的移民提供了一条更短的路线。"

	

##########################################################################################

#@}


#+ South Dakota TBs and POIs localization.
#@{

    key[]: "tb_sd1"
	val[]: "布莱克山"

	key[]: "tb_sd1_desc"
	val[]: "南达科他州西部的风貌由布莱克山与恶地共同界定。在这里，广袤的草原渐次隆起为松林覆盖的山峦、花岗岩尖峰与游荡的野牛群。不远处，历经千万年风蚀水刻的崎岖的恶地展现出令人震撼的奇特地貌。"

	key[]: "poi_sd1_01"
	val[]: "布莱克山国家森林"

	key[]: "poi_sd1_01_desc"
	val[]: "这片被松树覆盖的地区在拉科塔（Lakota）语中被称为“Paha Sapa”，意为“黑色山丘”，是南达科他州海拔7244英尺的最高峰——黑麋峰的所在地。该峰也是落基山脉以东的最高峰，为纪念著名的拉科塔族治疗师而更名。"

	key[]: "sd_cut_rush_desc"
	val[]: "拉什莫尔山被誉为美国的“民主圣殿”，于1927年至1941年间在黑山地区开凿而成。此处雕刻着华盛顿、杰斐逊、罗斯福和林肯四位总统各高60英尺的雕像，分别象征着美国的诞生、成长、发展和维护。"

	key[]: "poi_sd1_02"
	val[]: "比弗溪大桥"

	key[]: "poi_sd1_02_desc"
	val[]: "这座建于1929年的钢混拱桥长225英尺，横跨风洞国家公园附近的一处峡谷，桥面距峡谷谷底115英尺。该桥为南达科他州唯一一座此类结构的桥梁，其设计意在与周边的岩石无缝融合。"

	key[]: "sd_cut_sturgis_desc"
	val[]: "斯特吉斯以举办全球规模最大的摩托车集会而闻名。该活动始于1938年，由当地印第安人摩托车经销商帕皮•霍尔（Pappy Hoel）发起。这一为期10天的年度盛会吸引着来自世界各地的摩托车手齐聚布莱克山地区，共同参与摩托车展、比赛、音乐会和庆典等活动。"

	key[]: "sd_cut_deadwood_desc"
	val[]: "戴德伍德于1876年布莱克山淘金热期间兴起，并成为狂野西部最臭名昭著的城镇之一。该地于1961年被指定为国家历史名胜，是美国唯一拥有这一地位的城市，其历史悠久的市中心大部分区域都被完好保存。"

	key[]: "sd_cut_badlands_desc"
	val[]: "占地24.4万英亩的恶地国家公园，拥有连绵的孤丘、尖蜂石阵与岩柱，毗邻美国最大的受保护混草草原。这里保存着全球最丰富的化石层之一，揭示了曾在北美大平原漫游的远古哺乳动物的踪迹。"

	key[]: "poi_sd1_03"
	val[]: "多恩•罗宾逊隧道"

	key[]: "poi_sd1_03_desc"
	val[]: "被誉为“拉什莫尔山之父”的多恩•罗宾逊（Doane Robinson），曾设想在布莱克山地区建造一座宏伟的纪念碑，以吸引游客前往南达科他州。如今，他的遗志仍在延续，美景可观的多恩•罗宾逊隧道将拉什莫尔山完美地框进视野之中。"

	key[]: "sd_cut_hot_springs_desc"
	val[]: "热泉，最初被苏（Sioux）族人称为“Minnekahta”，意为“热水之地”。该城于1879年围绕据说具有疗愈功效的矿泉建立，1882年更名为“热泉”后逐渐发展为疗养胜地，至今仍以历史悠久的埃文斯泳池（Evans Plunge）闻名。"

	key[]: "poi_sd1_04"
	val[]: "猛犸象遗址"

	key[]: "poi_sd1_04_desc"
	val[]: "猛犸象遗址是世界闻名的冰河时代化石发掘地，迄今已出土61具猛犸象遗骸。该遗址于1974年被发现，古老的天坑保存着北美规模最大的哥伦比亚猛犸象遗骸群，发掘工作至今仍在进行。"

##########################################################################################

    key[]: "tb_sd2"
	val[]: "大分水岭"

	key[]: "tb_sd2_desc"
	val[]: "密苏里河流经的南达科他州中部形成了该州的地理分界，一侧是辽阔平原，另一侧为连绵丘陵。这里曾是原住民部落、毛皮贸易商和刘易斯与克拉克远征队的重要通道，后来更成为大型水坝、边疆城镇与丰富河流历史的汇聚之地。"

	key[]: "poi_sd2_01"
	val[]: "四大湖"

	key[]: "poi_sd2_01_desc"
	val[]: "奥阿希湖、夏普湖、弗朗西斯•凯斯湖以及刘易斯与克拉克湖均为20世纪40年代末期筑坝拦截密苏里河的产物，如今已成为南达科他州中部的标志性景观。这些水库总计拥有超过440英里的湖岸线，可供划船、钓鱼及休闲娱乐之用。"

	key[]: "poi_sd2_02"
	val[]: "鬼城班戈"

	key[]: "poi_sd2_02_desc"
	val[]: "班戈曾是沃尔沃思县的县治，但1899年其建筑被迁往附近的塞尔比后，便成了一座鬼城。如今，只有一座纪念碑标记着这座小镇曾经所在的位置。"

	key[]: "landmark_sd_state_capitol_desc"
	val[]: "皮尔建立于1880年，1889年南达科他州加入联邦时，该地因其地理位置居中且毗邻密苏里河渡口而被选为州首府，其市名源自法裔美国皮毛商人小皮埃尔•舒托（Pierre Chouteau Jr.）。"

	key[]: "sd_cut_corn_desc"
	val[]: "位于米切尔的玉米宫是世界上唯一一座完全由玉米装饰而成的宫殿。每年，当地艺术家和农民都会用天然色泽的玉米、谷物和草来创作新的壁画，使其成为南达科他州最具特色的地标之一。"

	key[]: "landmark_sd_largest_pheasant_desc"
	val[]: "休伦是“世界最大雉鸡”的所在地。它是一座高40英尺、由玻璃钢和钢材制成的雕塑，建于1959年。这座重达22吨的雕塑，彰显了该地区作为美国顶级雉鸡狩猎胜地之一的长久声誉。"

	key[]: "landmark_sd_dignity_of_earth_and_sky_desc"
	val[]: "《大地与天空的尊严》是一座高50英尺的不锈钢雕塑，矗立在张伯伦附近，俯瞰密苏里河。该作品由艺术家戴尔•兰菲尔（Dale Lamphere）创作，旨在致敬拉科塔（Lakota）族和达科他（Dakota）族的传统、韧性与文化。"

##########################################################################################

#@}
