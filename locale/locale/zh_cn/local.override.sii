#+ Text deviations for American Truck Simulator. Please, use only terms appropriate for USA (i.e. culture specific nuances, not American English).
#@{

#+ Music/radio player
#@{

#+ Hint shown if no music files are found. Also shown as tooltip when hovering over music_player button.

	key[]: "music_player_hint"
	val[]: "把你的音乐放到位于<color value=@@clr_sel@@>文档<color value=@@clr_txt@@>下的<color value=@@clr_sel@@>American Truck Simulator/music<color value=@@clr_txt@@>文件夹内，就能在这里看到它们了。"

#+ Tooltip shown when hovering over the radio_stream button.

	key[]: "radio_hint"
	val[]: "编辑<color value=@@clr_sel@@>文档<color value=@@clr_txt@@>文件夹下<color value=@@clr_sel@@>American Truck Simulator<color value=@@clr_txt@@>文件夹当中的<color value=@@clr_sel@@>live_streams.sii<color value=@@clr_txt@@>文件，即可在游戏中收听你喜欢的网络电台！"

#+ Hint shown if no online radio streams are defined.

	key[]: "empty_radio_hint"
	val[]: "请根据<color value=@@clr_sel@@>文档<color value=@@clr_txt@@>文件夹下<color value=@@clr_sel@@>American Truck Simulator<color value=@@clr_txt@@>文件夹里面的<color value=@@clr_sel@@>readme.rtf<color value=@@clr_txt@@>文件中的指示来添加你自己的音乐和广播电台。"
#@}

#+ Messages shown as part of the tutorial.
