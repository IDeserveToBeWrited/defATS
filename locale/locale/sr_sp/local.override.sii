#+ Text deviations for American Truck Simulator. Please, use only terms appropriate for USA (i.e. culture specific nuances, not American English).
#@{

#+ Music/radio player
#@{

#+ Hint shown if no music files are found. Also shown as tooltip when hovering over music_player button.

	key[]: "music_player_hint"
	val[]: "Stavite vaše pesme u <color value=@@clr_sel@@>American Truck Simulator/music <color value=@@clr_txt@@>folder u vašim <color value=@@clr_sel@@>Documents <color value=@@clr_txt@@>i pojaviće se ovde."

#+ Tooltip shown when hovering over the radio_stream button.

	key[]: "radio_hint"
	val[]: "Izmenite <color value=@@clr_sel@@>live_streams.sii <color value=@@clr_txt@@>u <color value=@@clr_sel@@>American Truck Simulator <color value=@@clr_txt@@>folderu u vašim <color value=@@clr_sel@@>Documents <color value=@@clr_txt@@>i slušajte vaš omiljeni Internet-radio tokom igre!"

#+ Hint shown if no online radio streams are defined.

	key[]: "empty_radio_hint"
	val[]: "Molimo, pogledajte <color value=@@clr_sel@@>readme.rtf <color value=@@clr_txt@@>u<color value=@@clr_sel@@>American Truck Simulator <color value=@@clr_txt@@>folderu u vašim <color value=@@clr_sel@@>Documents <color value=@@clr_txt@@>kako da dodate svoju muziku i radio-stanice."
#@}

#+ Messages shown as part of the tutorial.
#+
#+ The $KEY$ texts are placeholders for various keys and should be left intact.
#@{

	key[]: "intro_1"
	val[]: "Dobrodošli u American Truck Simulator!"
#@}

