#### 3_04 msg - intro text

	key[]: "aca_msg_book1_3_04_cutscene01"
	val[]: "Ne zaboravite da unapred planirate svako skretanje i dobro iskoristite prostor oko vas. Zaobiđite prvi set barijera i uđite u stazu."

	key[]: "aca_msg_book1_3_04_cutscene02"
	val[]: "Prvih nekoliko skretanja postaju sve oštrija kako idete."

	key[]: "aca_msg_book1_3_04_cutscene03"
	val[]: "Zapamtite da način na koji izađete iz jednog skretanja može uticati na to kako ćete ući u sledeće."

	key[]: "aca_msg_book1_3_04_cutscene04"
	val[]: "Prvi od izazovnijih uglova kombinuje dva skretanja ukosnice u jedan. Moraćete da budete veoma oprezni i promišljeni u vožnji i da koristite retrovizore u svoju korist."

	key[]: "aca_msg_book1_3_04_cutscene05"
	val[]: "Nastavite kroz uski sektor."

	key[]: "aca_msg_book1_3_04_cutscene06"
	val[]: "Sledeće je nekoliko lakih uglova na putu ka tesnoj ukosnici."

	key[]: "aca_msg_book1_3_04_cutscene07"
	val[]: "Držite glavu na okretaju kako bi bili sigurni da ne udarite ni jednu od barijera. Idite sporije koliko je potrebno."

	key[]: "aca_msg_book1_3_04_cutscene08"
	val[]: "Čak i kada se čini da ima puno prostora za manevrisanje, još uvek možete da se nađete u tesnoj situaciji."

	key[]: "aca_msg_book1_3_04_cutscene09"
	val[]: "Najkompleksnija skretanja su pred vama. Vaš ulazak u skretanje će odrediti da li ćete uspeti ili ne."

	key[]: "aca_msg_book1_3_04_cutscene10"
	val[]: "Nastavite kroz finalno skretanje."

	key[]: "aca_msg_book1_3_04_cutscene11"
	val[]: "Stop in the designated area, secure the truck and shut down the engine."
#!{
	key[]: "aca_msg_book1_3_04_cutscene12"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_04_cutscene13"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_04_cutscene14"
	val[]: "Unused"
#!}

#### 3_04 Driving Instructions



	key[]: "aca_msg_book1_3_04_forward"
	val[]: "<font face=/font/big_bold.font>Ubrzajte i vozite oko barijera. </font>"

	key[]: "aca_msg_book1_3_04_check1"
	val[]: "Nastavite na stazu i kroz prva dva laka skretanja.<br><br><font face=/font/big_bold.font>Nastavite vožnju. </font>"

	key[]: "aca_msg_book1_3_04_check2"
	val[]: "<font face=/font/big_bold.font>Napravite skretanje od 90°.</font>"

	key[]: "aca_msg_book1_3_04_check3"
	val[]: "Sledeći deo kursa je dupla ukosnica. Kako ćete manevrisati kroz prvi deo direktno će uticati na vaš put kroz drugi deo.<br><br><font face=/font/big_bold.font>Nastavite sa oprezom.. </font>"

	key[]: "aca_msg_book1_3_04_check4"
	val[]: "Dok izlazite iz ukosnica, držite se levo da biste pripremili ulazak u uski sektor.<br><br><font face=/font/big_bold.font>Nastavite vožnju. </font>"

	key[]: "aca_msg_book1_3_04_check5"
	val[]: "<font face=/font/big_bold.font>Nastavite vožnju kroz uski sektor. </font>"

	key[]: "aca_msg_book1_3_04_check6"
	val[]: "Pred vama je nekoliko lakih skretanja od 90°.<br><br><font face=/font/big_bold.font>Napravi skretanje. </font>"

	key[]: "aca_msg_book1_3_04_check7"
	val[]: "Približavate se još jednoj ukosnici. Pratite svoju prikolicu u retrovizor dok se približavate. <br><br><font face=/font/big_bold.font>Vozite kroz ukosnicu. </font>"

	key[]: "aca_msg_book1_3_04_check8"
	val[]: "Skretanje od 90° napred je mnogo tesnije nego što izgleda. Koristite svoj prostor mudro.<br><br><font face=/font/big_bold.font>Nastavite vožnju. </font>"

	key[]: "aca_msg_book1_3_04_check9"
	val[]: "Konačna ukosnica je složena, gotovo da nema rezervnog prostora. <br><br><font face=/font/big_bold.font>Nastavite sa oprezom.</font>"

	key[]: "aca_msg_book1_3_04_check10"
	val[]: "Očekuje vas još jedno skretanje od 90°.<br><br><font face=/font/big_bold.font>Nastavite vožnju. </font>"

	key[]: "aca_msg_book1_3_04_check11"
	val[]: "Nastavite do određenog područja."
