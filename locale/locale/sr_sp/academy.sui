	key[]: "aca_book_book2_help_finish_requirments_t"
	val[]: "Zahtevi za završetak"

	key[]: "aca_book_book2_help_success_desc"
	val[]: "Scenariji se završavaju ispunjavanjem svih uslova za prolaz"

	key[]: "aca_book_book2_help_stars_desc"
	val[]: "Zvezdice se zarađuju ispunjavanjem bonus uslova"

	key[]: "aca_book_book2_help_conditions_t"
	val[]: "Uslovi"

	key[]: "aca_book_book2_help_direction_changes_desc"
	val[]: "Maksimalan broj promena između kretanja napred i nazad"

	key[]: "aca_book_book2_help_time_desc"
	val[]: "Maksimalno dozvoljeno vreme za završetak scenarija za dati uslov"

	key[]: "aca_book_book2_help_camera_desc"
	val[]: "Ekskluzivna upotreba unutrašnje kamere - spoljašnje kamere se i dalje mogu koristiti dok miruju"

	key[]: "aca_book_book2_completed_t"
	val[]: "POLOŽENE VEŠTINE VOŽNJE KAMIONA"

	key[]: "aca_book_book2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Čestitamo!<br><br>Ispunili ste sve uslove za prolazak u modulu „Veštine vožnje kamiona“ i zaradili nagrade za svoj karijerni profil. I dalje možete da izazovete sebe da dobijete još nagrada ispunjavanjem svih bonus uslova.</font><br><br>"

	key[]: "aca_book_book2_maxrank_t"
	val[]: "KOMPLETIRANE VEŠTINE VOŽNJE KAMIONA"

	key[]: "aca_book_book2_maxrank"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Čestitamo!<br><br>Ispunili ste sve uslove za prolaz i bonuse u modulu Veština vožnje kamiona i zaradili nagrade za svoj karijerni profil.</font><br><br>"

#@}

#+ Book 2 intro
#@{

#### common
	key[]: "aca_scenario_book2_intro_title"
	val[]: "Veštine za vožnju kamiona"


#### intro text

	key[]: "aca_scenario_book2_book2_intro_cutscene1"
	val[]: "Dobrodošli nazad u @@driving_academy@@!"

	key[]: "aca_scenario_book2_book2_intro_cutscene2"
	val[]: "Sledeći scenariji predstavljaju sledeći korak na vašem putu ka profesionalnoj vožnji kamiona."

	key[]: "aca_scenario_book2_book2_intro_cutscene3"
	val[]: "Ovog puta vas nećemo voditi kroz svaki zadatak, tako da je na vama da upotrebite svoje veštine i iskustvo."

	key[]: "aca_scenario_book2_book2_intro_cutscene4"
	val[]: "Možda ćete naići na neke poznate manevre, ali ovog puta u novim okruženjima napravljenim da više liče na scenarije iz stvarnog sveta."

	key[]: "aca_scenario_book2_book2_intro_cutscene5"
	val[]: "Novo za @@driving_academy@@ je dodavanje uslova „Prolaz“ i „Bonus“."

	key[]: "aca_scenario_book2_book2_intro_cutscene6"
	val[]: "Kao i pre, i dalje morate završiti svaki scenario bez udaranja u bilo šta, tako što ćete uspešno parkirati i osigurati kamion..."

	key[]: "aca_scenario_book2_book2_intro_cutscene7"
	val[]: "...ali sada to morate učiniti i u predviđenom vremenskom ograničenju, i sa ograničenjem u broju promena smera između vožnje napred i nazad."

	key[]: "aca_scenario_book2_book2_intro_cutscene8"
	val[]: "Bonus uslovi se mogu ispuniti završetkom svakog scenarija sa još izazovnijim uslovima..."

	key[]: "aca_scenario_book2_book2_intro_cutscene9"
	val[]: "...kao što su stroža vremenska ograničenja, manje promena pravca i isključivo korišćenje unutrašnje kamere."

	key[]: "aca_scenario_book2_book2_intro_cutscene10"
	val[]: "Završetkom svih scenarija, možete sebe smatrati veštim vozačem kamiona i spremnim za sledeći izazov na putu.<br><br>Da biste sebe dodatno izazvali, ispunite sve bonus uslove za svaki scenario; onda ćete zaista biti zvezda vozača kamiona!"


#@}



#+ Book 2 zero
#@{
#### zero common
	key[]: "aca_scenario_book2_zero_title"
	val[]: "Tutorijal"

	key[]: "aca_scenario_book2_zero_desc"
	val[]: "U ovom tutorijalu, pomoći ćemo vam da se upoznate sa novim funkcijama koje se nalaze u Vičnosti za vožnju kamiona."


#### zero info msg1

	key[]: "aca_msg_book2_scenario_zero1_title"
	val[]: "Veštine za vožnju kamiona"

	key[]: "aca_msg_book2_scenario_zero1"
	val[]: "Na početku svakog scenarija, videćete <color value=@@clr_sel@@>„Brifing scenarija“<color value=@@clr_txt@@> prozor. Ovo će vam dati informacije o novim uslovima za prolaz i bonus za scenario. <br><br>Uslovi za prolazak moraju biti ispunjeni da bi se scenario uspešno završio, dok su bonus uslovi opcioni dodatni izazov za iskusne i vešte igrače. <br><br><font face=/font/big_bold.font>Da biste nastavili, uključite paljenje.</font>"

#### zero info msg1b

	key[]: "aca_msg_book2_scenario_zero1b"
	val[]: "Jedan od bonus uslova zahteva da završite scenario dok koristite <color value=@@clr_sel@@>unutrašnju kameru<color value=@@clr_txt@@>. I dalje možete koristiti spoljašnje kamere da biste proverili svoju okolinu, ali samo dok je kamion zaustavljen.<br><br>Sada možete da se osvrnete okolo da biste se orijentisali, a zatim se vratite na unutrašnju kameru.<br><br><font face=/font/big_bold.font>Prebacite se na kameru za praćenje da biste proverili okolinu</font>"


#### zero info msg1c


	key[]: "aca_msg_book2_scenario_zero1c"
	val[]: "Orijentišite se, a zatim se vratite na unutrašnju kameru.<br><br><font face=/font/big_bold.font>Pogledajte oko kamiona</font>"


#### zero info msg1d


	key[]: "aca_msg_book2_scenario_zero1d"
	val[]: "<font face=/font/big_bold.font>Vratite se na unutrašnju kameru</font>"
#### zero info msg2

	key[]: "aca_msg_book2_scenario_zero2_title"
	val[]: "Veštine vožnje kamiona"

	key[]: "aca_msg_book2_scenario_zero2"
	val[]: "<color value=@@clr_sel@@>Vreme<color value=@@clr_txt@@> takođe će biti faktor u veštini vožnje kamiona. Svi scenariji će imati individualno vremensko ograničenje u kojem scenario mora biti završen kao uslov za prolaz, a mnogi će takođe imati dodatno, strože ograničenje kao bonus uslov.<br><br>Tajmer se pokreće tek nakon što se kamion pomeri.<br><br><font face=/font/big_bold.font>Upalite motor i otpustite ručnu kočnicu da biste nastavili.</font>"


#### zero info msg3

	key[]: "aca_msg_book2_scenario_zero3_title"
	val[]: "Veštine vožnje kamiona"

	key[]: "aca_msg_book2_scenario_zero3"
	val[]: "Još jedan novi dodatak za veštinu vožnje kamiona su putne tačke. Sve putne tačke moraju biti dostignute pre nego što se scenario može završiti. <br><br>Pored toga, putne tačke su osetljive na to u kom pravcu je kamion okrenut kada se stigne do putne tačke, zato obratite pažnju na sve oznake na zemlji u blizini putne tačke kako biste se pravilno orijentisali.<br><br><font face=/font/big_bold.font>Vozite napred do putne tačke ispred vas.</font>"


#### zero info msg4

	key[]: "aca_msg_book2_scenario_zero4_title"
	val[]: "Veštine vožnje kamiona"

	key[]: "aca_msg_book2_scenario_zero4"
	val[]: "Stigli ste do ciljne tačke i sada možete preći na sledeći korak. <br><br>Iza vas se nalazi još jedna tačka u koju morate da se pomerite unazad. Obratite pažnju na strelicu na zemlji koja pokazuje u kom pravcu kamion treba da bude okrenut kada stignete do tačke. <br><br>Još jedan uslov za prolaz i bonus koji se mora uzeti u obzir je <color value=@@clr_sel@@>Promene pravca<color value=@@clr_txt@@>. Brojimo koliko puta promenite smer između vožnje napred i vožnje unazad. Ostanite ispod ograničenja da biste ispunili uslov.<br><br><font face=/font/big_bold.font>Vratite se na putnu tačku i zaustavite se.</font>"

#### zero info msg5

	key[]: "aca_msg_book2_scenario_zero5_title"
	val[]: "Veštine vožnje kamiona"

	key[]: "aca_msg_book2_scenario_zero5"
	val[]: "Dakle, do sada ste trebali akumulirati jednu promenu smera. <br><br>Pokupite prikolicu iza sebe da biste prešli na sledeći korak. <br><br><font face=/font/big_bold.font>Krenite unazad ispod prikolice da biste je spojili.</font>"

#### zero info msg6

	key[]: "aca_msg_book2_scenario_zero6_title"
	val[]: "Veštine vožnje kamiona"

	key[]: "aca_msg_book2_scenario_zero6"
	val[]: "Poslednje parking mesto je sa vaše desne strane. Neki scenariji mogu imati samo jedno parking mesto, dok će drugi imati više njih za izbor. Pravilno parkiranje na bilo kom od mesta će vam omogućiti da završite scenario. <br><br><font face=/font/big_bold.font> Pritisnite @@imv_nrm_attach@@ da povežete prikolicu. </font>"


#### zero info msg7

	key[]: "aca_msg_book2_scenario_zero7_title"
	val[]: "Veštine vožnje kamiona"

	key[]: "aca_msg_book2_scenario_zero7"
	val[]: "Parking mesta takođe pokazuju u kom pravcu kamion treba da bude orijentisan na tom mestu. Parkiranje u pogrešnom smeru i nećete moći da završite scenario dok se ne ispravite, što će vas koštati vremena i promene pravca.<br><br><font face=/font/big_bold.font>Vozite do jednog od parking mesta i pravilno parkirajte.</font>"



#### zero info msg8

	key[]: "aca_msg_book2_scenario_zero8_title"
	val[]: "Veštine vožnje kamiona"

	key[]: "aca_msg_book2_scenario_zero8"
	val[]: "Sada bi trebalo da budete upoznati sa novim parametrima za uslove za prolaz i bonus ciljeve i da budete spremni da se uhvatite u koštac sa novim scenarijima u veštini vožnje kamiona!<br><br><font face=/font/big_bold.font>Obezbedite kamion aktiviranjem ručne kočnice i isključivanjem motora da biste završili scenario.</font>"



#@}

#+ Book 2 trailer check
#@{

#### Mission instructions - trailer check

key[]: "aca_msg_book2_slopy_moments_title"
val[]: "Pratite uputstva"

key[]: "aca_msg_book2_slopy_moments1"
val[]: "Da biste uspešno završili ovaj scenario, držite prikolicu stalno povezanu.<br><br><font face=/font/big_bold.font>Povežite se sa prikolicom.</font>"

key[]: "aca_msg_book2_slopy_moments2"
val[]: "Sada možete nastaviti sa scenarijem"


#@}


#+ Book 2 slalom_nt
#@{
#### 3_21 common
	key[]: "aca_scenario_book2_slalom_nt_title"
	val[]: "Dupli slalom"

	key[]: "aca_scenario_book2_slalom_nt_desc"
	val[]: "U ovom scenariju, morate savladati kratku stazu sastavljenu od dva povezana slaloma."

