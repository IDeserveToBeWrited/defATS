#+ Book 1 Scenario 1_01
#@{

#### 1_01 common
	key[]: "aca_scenario_book1_1_01_title"
	val[]: "Pre vožnje"

	key[]: "aca_scenario_book1_1_01_desc"
	val[]: "Za vaš prvi scenario, proći ćemo kroz osnove vozačke kabine. Važno je da pravilno podesite sedište, volan i bočne retrovizore, jer je dobra vidljivost važna za upravljanje stresnim ili nesigurnim situacijama.<br><br>Pregledaćemo kontrole za podešavanje ovih komponenti jednu po jednu."

#### 1_01 goal

	key[]: "aca_goal_book1_1_01_adjuster"
	val[]: "Podešavanje sedišta i retrovizore"

	key[]: "aca_goal_book1_1_01_check_adj"
	val[]: "Provera retrovizora i vidljivosti"

#### 1_01 msg - intro text

	key[]: "aca_msg_book1_1_01_cutscene1"
	val[]: "Dobrodošli na svoju prvu lekciju!<br>Počnimo tako što ćemo naučiti kako da pripremimo kamion da krene na put."

	key[]: "aca_msg_book1_1_01_cutscene2"
	val[]: "Ključno je osigurati da vaša vožnja bude bezbedna, profesionalna i pod kontrolom u svakom trenutku.<br>Pravilno podešavanje sedišta, volana i retrovizora će vam pomoći da to postignete."

	key[]: "aca_msg_book1_1_01_cutscene3"
	val[]: "Sa svake strane kamiona su neka vozila.<br>Oni će vam pomoći da pravilno podesite retrovizore."

	key[]: "aca_msg_book1_1_01_cutscene4"
	val[]: "Odvojite vreme da sve prilagodite svojim željama kao ova podešavanja<br>će imati značajan uticaj na vašu sposobnost da kontrolišete kamion."

#### 1_01 Driving Instructions

	key[]: "adj_tut_title_0"
	val[]: "Podešavanje sedišta i volana"

	key[]: "adj_tut_title_1"
	val[]: "Podešavanje glavnih retrovizora"

	key[]: "adj_tut_title_2"
	val[]: "Podešavanje konveksnih retrovizora"

	key[]: "adj_tut_title_3_hood"
	val[]: "Podešavanje retrovizora na haubi"

	key[]: "adj_tut_title_3"
	val[]: "Provera vidljivosti i konačno podešavanje retrovizora"

	key[]: "adj_tut_open_adj_keyboard"
	val[]: "pritisnite @@imv_nrm_adjuster@@ ili mu pristupite preko podešavanja vozila u meniju za pauzu"

	key[]: "adj_tut_open_adj_gamepad"
	val[]: "pristupite mu kroz podešavanja vozila u meniju za pauzu"

	key[]: "adj_tut_open_adj"
	val[]: "Za prikaz '@@adjust_link_t@@' tokom igranja, $OPEN_ADJUSTER$."

	key[]: "adj_tut_open_seat"
	val[]: "Prvo, podesimo vozačevo sedište i volan.<br><br><font face=/font/big_bold.font>Otvori '@@adj_seats@@' da se nastavi.</font>"

	key[]: "adj_tut_open_mirrors"
	val[]: "<font face=/font/big_bold.font>Otvori @@adj_mirrors@@ da konfigurišete postavke retrovizora.</font>"

	key[]: "adj_tut_open_adj_intro"
	val[]: "Kada prvi put ulazite u kamion, važno je da prvo podesite sedište, volan i retrovizore po svom ukusu.<br><br>Pravilna pozicija iza volana je ključna za pravilnu vidljivost. Sve komande moraju biti na dohvat ruke, a vozač mora da ima jasan pogled ispred sebe, sa strane i u retrovizore.<br><br><font face=/font/big_bold.font>Za prikaz menija konfiguracije, $OPEN_ADJUSTER$. </font>"

	key[]: "adj_tut_set_seat_and_back_adj"
	val[]: "@@adj_tut_set_seat_and_back_adj_img@@<br>Podesite sedište tako da imate jasan pogled na okolinu, kao i na retrovizore, i tako da možete da dosegnete i sve komande.<br><br>Podesite volan tako da bude u udobnom položaju i da vam ne blokira pogled na instrumente.<br><br><font face=/font/big_bold.font>Kada ste zadovoljni svojim podešavanjima, pritisnite @@imv_nrm_back@@ da biste se vratili u konfiguracioni meni. </font>"

	key[]: "adj_tut_open_mirrors_intro"
	val[]: "@@adj_tut_open_mirrors_intro_img@@<br>Kamioni imaju mnogo velikih mrtvih uglova, tako da su opremljeni sa više spoljašnjih retrovizora kako bi pomogli vozaču da vidi što je više moguće. <br><br>Pravilno podešavanje ovih retrovizora omogućiće vam najbolju moguću vidljivost okoline.<br><br><font face=/font/big_bold.font>Otvori '@@adj_mirrors@@' da se nastavi.</font>"

	key[]: "adj_tut_set_mirrors_t1_1_adj"
	val[]: "@@adj_tut_set_mirrors_t1_1_adj_img@@<br>Glavni retrovizori pokrivaju prostor duž bočne strane kamiona i prikolice.<br><br>Da biste podesili ispravan položaj glavnih retrovizora, za referencu koristite automobile sa obe strane vozila.<br><br><font face=/font/big_bold.font>Pritisnite @@imv_nrm_selectfcs@@ da se nastavi.</font>"

	key[]: "adj_tut_set_mirrors_t1_2_adj"
	val[]: "Glavni retrovizori su vaše primarno sredstvo da vidite šta se dešava pored i iza vas. Trebalo bi da imate dobar pogled na automobil pored sebe, ali svakako držite deo prikolice u retrovizoru kako biste precizno procenili položaj prepreka oko sebe."

	key[]: "adj_tut_set_mirrors_t1_2_adj_big"
	val[]: "Kada budete zadovoljni podešavanjem, prebacite se na glavni retrovizor sa suvozačeve strane."

	key[]: "adj_tut_set_mirrors_t1_2_adj_moved"
	val[]: "Opet, trebalo bi da imate dobar pogled na auto pored sebe, a da deo prikolice bude vidljiv i u retrovizoru."

	key[]: "adj_tut_set_mirrors_t1_2_adj_moved_big"
	val[]: "Kada budete zadovoljni podešavanjem retrovizora, pređite na konveksni retrovizor sa vozačeve strane."

	key[]: "adj_tut_set_mirrors_t1_3_adj"
	val[]: "@@adj_tut_set_mirrors_t1_3_adj_img@@<br>Konveksna ogledala pružaju šire vidno polje, omogućavajući vam da vidite više onoga što se dešava pored vas.<br><br><font face=/font/big_bold.font>Pritisnite @@imv_nrm_selectfcs@@ da se nastavi.</font>"

	key[]: "adj_tut_set_mirrors_t1_4_adj"
	val[]: "Idealno, trebalo bi da vidite i automobil i kamion koji su parkirani sa strane, dok je veoma mali deo vašeg kamiona još uvek vidljiv."

	key[]: "adj_tut_set_mirrors_t1_4_adj_big"
	val[]: "Kada budete zadovoljni podešavanjem retrovizora, pređite na konveksni retrovizor sa suvozačeve strane."

	key[]: "adj_tut_set_mirrors_t1_4_adj_moved"
	val[]: "Opet, trebalo bi da vidite i automobil i kamion koji su parkirani sa strane, a da je još uvek vidljiv mali deo vašeg kamiona."

	key[]: "adj_tut_set_mirrors_t1_4_adj_moved_big"
	val[]: "Kada budete zadovoljni podešavanjem retrovizora, pređite na retrovizor haube."

	key[]: "adj_tut_set_mirrors_t1_5_adj"
	val[]: "@@adj_tut_set_mirrors_t1_5_adj_img@@<br>Retrovizori na haubi pružaju pogled u mrtve tačke sa obe strane kabine tegljača, omogućavajući vam da vidite male automobile i prepreke koje bi inače mogle biti sakrivene zbog velikih dimenzija kamiona.<br><br><font face=/font/big_bold.font>Pritisnite @@imv_nrm_selectfcs@@ da nastavite.</font>"

	key[]: "adj_tut_set_mirrors_t1_6_adj"
	val[]: "@@adj_tut_set_mirrors_t1_6_adj_img@@<br>Pošto imate druge retrovizore koja pružaju pogled iza sebe, ovi retrovizori su dizajnirana samo da vide ono što je pored vas. Hauba i krakovi bočnih retrovizora pružaju dobar referentni okvir o tome koliko vašeg kamiona još uvek treba da bude vidljivo. Podesite retrovizore na ispravan položaj kao što je prikazano na dijagramu.<br><br><font face=/font/big_bold.font>Kada budete zadovoljni podešavanjem, prebacite se na retrovizor haube sa suvozačeve strane. </font>"

	key[]: "adj_tut_set_mirrors_t1_6_adj_moved"
	val[]: "@@adj_tut_set_mirrors_t1_6_adj_moved_img@@<br>Na isti način podesite položaj ovog retrovizora.<br><br><font face=/font/big_bold.font>Kada ste zadovoljni podešavanjem retrovizora, pritisnite @@imv_nrm_back@@ da zatvorite podešavanja retrovizora. </font>"

	key[]: "adj_tut_back_adj"
	val[]: "<font face=/font/big_bold.font>Pritisnite @@imv_nrm_back@@ da biste se vratili u konfiguracioni meni. </font>"

	key[]: "adj_tut_close_adj"
	val[]: "Odlično, sa vašim sedištem i retrovizorima postavljenim po vašoj želji, sada ste korak bliže putu!<br><br><font face=/font/big_bold.font>Zatvorite meni za konfiguraciju koristeći @@imv_nrm_back@@. </font>"

	key[]: "adj_tut_open_con"
	val[]: "Još jednom pogledajte oko sebe da biste bili sigurni da ste zadovoljni pogledom iz kabine i da vam retrovizori pružaju dobar pogled na ono što se dešava oko kamiona.<br><br>Ako vam nešto ne odgovara, možete ponovo da podesite retrovizore '@@adjust_link_t@@' konfiguracioni meni. <br><br><font face=/font/big_bold.font>Pritisnite @@imv_nrm_activate@@ da se završi prvi scenario.</font> @@aca_goal_tip@@ Da biste prikazali ili sakrili retrovizore na ekranu, možete da odete na '@@adjust_link_t@@' — '@@adj_ui_mirrors@@' u meniju za pauzu. Retrovizori na ekranu olakšavaju pregled sa strane vašeg suvozača."
#@}

