	val[]: "Vozite napred između barijera."

	key[]: "aca_msg_scenario_follow_checkpoints"
	val[]: "Pratite putne tačke i vodite računa o njihovoj orijentaciji."

	key[]: "aca_msg_scenario_reverse_in_forward_out"
	val[]: "Vozite se unazad na označeno mesto, a zatim se iz njega izvucite vozilom napred."

	key[]: "aca_msg_scenario_forward_in_reverse_out"
	val[]: "Vozite napred do obeleženog mesta, a zatim izađite unazad."

	key[]: "aca_msg_scenario_reverse_continue"
	val[]: "Nastavite unazad."

	key[]: "aca_msg_scenario_reverse_start"
	val[]: "Započnite unazad."

	key[]: "aca_msg_scenario_reverse_barriers"
	val[]: "Unazad između barijera."

	key[]: "aca_msg_scenario_park_forward"
	val[]: "Parkirajte na za to određenom mestu."

	key[]: "aca_msg_scenario_park_reverse"
	val[]: "Vozite unazad i parkirajte se na određeno mesto."

	key[]: "aca_msg_scenario_checkpoint_reached_title"
	val[]: "Dostignuti tačku puta"

	key[]: "aca_msg_scenario_checkpoint_reached"
	val[]: "Nastavite sa scenarijem."

	key[]: "aca_msg_scenario_end_title"
	val[]: "Parking mesto"

	key[]: "aca_msg_scenario_end"
	val[]: "<font face=/font/big_bold.font>Da završite scenario, osigurajte kamion i ugasite motor.</font>"

	key[]: "aca_msg_parking_orientation_title"
	val[]: "@@aca_msg_scenario_end_title@@"

	key[]: "aca_msg_parking_orientation"
	val[]: "Na pravom ste mestu, ali ste okrenuti na pogrešan način.<br><br><font face=/font/big_bold.font>Okrenite kamion pre nego što završite scenario.</font>"

#@}


#+ Book 1 intro
#@{

	key[]: "aca_scenario_book1_intro_title"
	val[]: "Osnove vožnje kamiona"

	key[]: "aca_msg_book1_intro_cutscene01"
	val[]: "Dobrodošli u @@driving_academy@@."

	key[]: "aca_msg_book1_intro_cutscene02"
	val[]: "Sledeći scenariji predstavljaju prvi korak na vašem putu ka profesionalnoj vožnji kamiona."

	key[]: "aca_msg_book1_intro_cutscene03"
	val[]: "Ovde ćete naučiti sve iz osnovnih sistema i kontrola kamiona..."

	key[]: "aca_msg_book1_intro_cutscene04"
	val[]: "...za složene manevre sa i bez prikolice."

	key[]: "aca_msg_book1_intro_cutscene05"
	val[]: "Pomoći ćemo vam da steknete navike koje će vam pomoći da se bezbedno krećete u raznim situacijama,"

	key[]: "aca_msg_book1_intro_cutscene06"
	val[]: "i nauči vas da mudro koristite raspoloživi prostor za efikasno manevrisanje vašim kamionom."

	key[]: "aca_msg_book1_intro_cutscene07"
	val[]: "Završavanjem svih scenarija i polaganjem završnih ispita,"

	key[]: "aca_msg_book1_intro_cutscene08"
	val[]: "bićete spremni da krenete putevima Amerike i nađete nove izazove sa kojima ćete se suočiti."

#@}

