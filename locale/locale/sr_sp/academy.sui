#+ Book 1 Scenario 1_02
#@{

#### 1_02 common

	key[]: "aca_scenario_book1_1_02_title"
	val[]: "Kontrole kamere"

	key[]: "aca_scenario_book1_1_02_desc"
	val[]: "U ovom scenariju ćemo naučiti o različitim vrstama kamera koje su vam dostupne i kako vam one mogu pomoći da kontrolišete i manevrirate kamionom."

#### 1_02 goal

	key[]: "aca_goal_book1_1_02_seat"
	val[]: "Položaj sedenjа"

	key[]: "aca_goal_book1_1_02_look_back"
	val[]: "Pogled na pozadinu"

	key[]: "aca_goal_book1_1_02_mirrors"
	val[]: "Provera retrovizora"

	key[]: "aca_goal_book1_1_02_cam_behind"
	val[]: "Prebacite se na spoljnu kameru"

	key[]: "aca_goal_book1_1_02_look_around"
	val[]: "Pogledajte oko kamiona"


#### 1_02 msg - intro text

	key[]: "aca_msg_book1_1_02_cutscene1"
	val[]: "U ovom scenariju, proći ćemo kroz različite kamere<br>koje su dostupne za upotrebu."

	key[]: "aca_msg_book1_1_02_cutscene2"
	val[]: "Ukupno imate sedam kamera koje možete izabrati, proći ćemo kroz njih<br> nekoliko njih sada i objasni njihove predviđene funkcije."

	key[]: "aca_msg_book1_1_02_cutscene3"
	val[]: "Različite kamere i njihovi različiti uglovi mogu vam pomoći prilikom manevrisanja na uskim mestima."


#### 1_02 Driving Instructions

	key[]: "aca_msg_book1_1_02_seat"
	val[]: "Gledanje kuda idete je osnovna osnova bezbedne i profesionalne vožnje. Ako vam trenutni položaj sedenja ne odgovara, možete ga promeniti '@@adjust_link_t@@' (Pristupite mu preko menija za pauzu).<br><br><font face=/font/big_bold.font>Potvrdite kada ste spremni sa @@imv_nrm_activate@@. </font>"

	key[]: "aca_msg_book1_1_02_look_back"
	val[]: "Kada vozite unazad, retrovizori ne nude uvek jasan pogled. Možda će biti potrebno da pogledate kroz prozor iza sebe da biste imali bolji pogled.<br><br><font face=/font/big_bold.font>Okrenite kameru skroz do vozačeve strane da biste pogledali kroz prozor prema zadnjem delu prikolice.</font>@@aca_goal_tip@@ Morate biti u vozilu."

	key[]: "aca_msg_book1_1_02_mirrors"
	val[]: "Koristite ovaj prikaz da proverite prikolicu tokom manevara unazad sa prikolicom. Uvek je bolje da se okrenete unazad na stranu vozača da biste mogli da iskoristite ovaj pogled. Kada se krećete unazad na suvozačevu stranu, imate mnogo ograničeniji pogled na ono što se dešava iza vas.<br><br><font face=/font/big_bold.font>Pogledajte prema suvozačevoj strani. </font>"

	key[]: "aca_msg_book1_1_02_cam_behind"
	val[]: "Zbog toga se obično ne preporučuje kretanje unazad prema suvozačevoj strani; možete videti da je vidljivost prilično ograničena. Srećom, na raspolaganju vam je i sedam spoljašnjih kamera. <br><br>Dugme @@imv_nrm_camcycle@@ može se koristiti za prelazak na sledeću kameru u nizu. Nakon što prođete kroz svih sedam kamera, vratićete se na početak ciklusa. <br><br><font face=/font/big_bold.font>Pritisnite @@imv_nrm_camcycle@@ da biste prešli na sledeću kameru. </font>"

	key[]: "aca_msg_book1_1_02_look_around"
	val[]: "Eksterna kamera pruža najbolju perspektivu o tome šta se dešava oko kamiona.<br><br><font face=/font/big_bold.font>Pogledaj oko kamiona.</font>"

	key[]: "aca_msg_book1_1_02_cam_top"
	val[]: "<font face=/font/big_bold.font>Pritiskanje @@imv_nrm_camcycle@@ ponovo možete da pređete na sledeću kameru. </font>"

	key[]: "aca_msg_book1_1_02_cam_cabin"
	val[]: "Pogled odozgo nadole pruža odličan pregled situacije oko kamiona, značajno pojednostavljujući parkiranje i vožnju u skučenim prostorima.<br><br><font face=/font/big_bold.font>Pritisnite @@imv_nrm_camcycle@@ da biste prešli na sledeću kameru.  </font>"

	key[]: "aca_msg_book1_1_02_cam_window"
	val[]: "Krovna kamera pruža jasan pogled na put daleko ispred kamiona bez većih prepreka.<br><br><font face=/font/big_bold.font>Pritisnite @@imv_nrm_camcycle@@ da pređemo na poslednju kameru koju ćemo za sada pogledati.</font>"

	key[]: "aca_msg_book1_1_02_cam_interior"
	val[]: "Pogled pozadi je prečica za pogled koji ste ranije dobili okretanjem unutrašnje kamere. Kao što smo diskutovali, to je od pomoći kada se vozi unazad ili parkira.<br><br>U igri imamo više kamera koje možete isprobati uzastopnim pritiskom @@imv_nrm_camcycle@@.<br><br><font face=/font/big_bold.font>Pritisnite @@imv_nrm_cam1@@ da se vrati u unutrašnjost.</font>"

	key[]: "aca_msg_book1_1_02_end"
	val[]: "For an authentic driving school experience, we recommend staying with the 'Interior Camera' view as you go through each of the scenarios.<br><br><font face=/font/big_bold.font>Press @@imv_nrm_activate@@ to confirm and end the scenario.</font>@@aca_goal_tip@@ You can use the @@o_im_cam_zoom@@ feature for a better view of your surroundings. It's especially helpful when looking through the mirrors. Check the Options Screen - '@@options_bindings_screen@@' - to see and/or change corresponding controls."

#@}

#+ Book 1 Scenario 1_03
#@{

#### 1_03 common
	key[]: "aca_scenario_book1_1_03_title"
	val[]: "Prva vožnja"

	key[]: "aca_scenario_book1_1_03_desc"
	val[]: "U ovom scenariju, naučićemo kako da pripremimo kamion za vožnju, a zatim da ga vozimo napred po prvi put."

#### 1_03 goal

	key[]: "aca_goal_book1_1_03_electrics"
	val[]: "Uključivanje paljenja"

	key[]: "aca_goal_book1_1_03_start"
	val[]: "Startovanje motora"

	key[]: "aca_goal_book1_1_03_look_mirror"
	val[]: "Provera okoline"

	key[]: "aca_goal_book1_1_03_brake"
	val[]: "Primena radne kočnice"

	key[]: "aca_goal_book1_1_03_gear"
	val[]: "Prebacivanje u brzinu"

	key[]: "aca_goal_book1_1_03_park_br_off"
	val[]: "Otpuštanje parkirne kočnice"

	key[]: "aca_goal_book1_1_03_forward"
	val[]: "Vožnja napred"

	key[]: "aca_goal_book1_1_03_stop"
	val[]: "Zaustavljanje"

	key[]: "aca_goal_book1_1_03_park_br_on"
	val[]: "Primenite parkirnu kočnicu"

	key[]: "aca_goal_book1_1_03_gear_n"
	val[]: "Prebacivanje u ler"

	key[]: "aca_goal_book1_1_03_end"
	val[]: "Gašenje motora"

#### 1_03 msg - intro text

	key[]: "aca_msg_book1_1_03_cutscene1"
	val[]: "Za vaših prvih nekoliko vožnji koristićemo samo tegljač.<br>Kamion se naziva tegljač kada nema sopstvenu karoseriju, već se oslanja na upotrebu prikolice za prevoz robe i materijala."

	key[]: "aca_msg_book1_1_03_cutscene2"
	val[]: "Tegljači su uobičajeni jer omogućavaju veću svestranost: mogu da ispuste praznu prikolicu i pokupe natovarenu bez čekanja, ili čak da se u potpunosti prebace na drugu vrstu prikolice."

	key[]: "aca_msg_book1_1_03_cutscene3"
	val[]: "Za vašu prvu vožnju, vaš zadatak će biti da vozite napred i zaustavite se nakon isprekidane linije.<br>Pokrenite motor, pratite uputstva da kamion bude spreman za pokret. Kada se pripremite, vozite pravo."

	key[]: "aca_msg_book1_1_03_cutscene4"
	val[]: "Vozite pored isprekidane linije, zaustavite se, ugasite motor i osigurajte kamion."

#### 1_03 Driving Instructions

	key[]: "aca_msg_book1_1_03_electrics"
	val[]: "Za sledeći korak u vašoj obuci, prvi put ćete pomeriti kamion.<br><br>Naravno, bez rada motora neće raditi, tako da prvo morate uključiti paljenje.<br><br><font face=/font/big_bold.font>Pritisnite $input engineelect$ da uključite paljenje.</font>@@aca_goal_tip@@ U karijeri, podrazumevano, motor se automatski uključuje zajedno sa strujom. Za karijeru, ovo ponašanje možete da prilagodite na ekranu sa opcijama - „Igranje“ - @@auto_engine_start@@."

	key[]: "aca_msg_book1_1_03_start"
	val[]: "Paljenje aktivira elektroniku kamiona. Možda ste primetili da lampice upozorenja trepere na instrument tabli - to je normalno. Ako ostanu uključeni kada se motor pokrene, to verovatno ukazuje na problem sa kamionom. Izuzetak je lampica parkirne kočnice, koja će se ugasiti kada otpustimo parkirne kočnice.<br><br>Srećom, ovaj kamion je u dobrom stanju i spremni smo da nastavimo.<br><br><font face=/font/big_bold.font>Pritisnite @@imv_nrm_engine@@ za pokretanje motora. </font>"

	key[]: "aca_msg_book1_1_03_look_mirror"
	val[]: "Sada kada je motor pokrenut, ključno je da proverite okolinu pre nego što započnete bilo kakav pokret.<br><br><font face=/font/big_bold.font>Pogledajte oko kamiona i bočne retrovizore vozačeva i suvozačeva strana da biste potvrdili da je prostor oko kamiona čist.</font>@@aca_goal_tip@@ Morate da budete u vozilu."

	key[]: "aca_msg_book1_1_03_brake"
	val[]: "Možda izgleda očigledno, ali trebalo bi da znate kako da se zaustavite pre nego što započnete bilo kakav pokret.<br><br><font face=/font/big_bold.font>Aktivirajte radnu kočnicu koristeći $input backward$. </font>"

	key[]: "aca_msg_book1_1_03_gear_arcade"
	val[]: "Zatim ćete naučiti kako da promenite smer putovanja.<br><br>Sa pojednostavljenim automatskim menjačem, nema potrebe za menjanjem brzina, sve se radi automatski umesto vas.<font face=/font/big_bold.font><br><br>Koristi $input forward$ da biste aktivirali brzinu za kretanje napred. </font>"

	key[]: "aca_msg_book1_1_03_gear_automatic"
	val[]: "Zatim ćete naučiti kako da promenite smer putovanja.<br><br>Realističan automatski menjač vam omogućava da menjate između vožnje, neutralnog i rikverc, baš kao pravi automatski menjači.<br><br><font face=/font/big_bold.font>Pritisnite @@imv_nrm_gearup@@ da biste aktivirali brzinu za kretanje napred. </font>"

	key[]: "aca_msg_book1_1_03_gear_manual"
	val[]: "Zatim ćete naučiti kako da promenite smer putovanja.<br><br>Sekvencijalni menjač omogućava stepenasto prebacivanje, baš kao i pravi sekvencijalni menjači.<br><br>Na isti način kao što uključujete brzinu za napred, dok ubrzavate, moraćete da prebacite u višu brzinu.<br><br><font face=/font/big_bold.font>Pritisnite @@imv_nrm_gearup@@  da uključite prvu brzinu.</font>"

	key[]: "aca_msg_book1_1_03_gear_direct"
	val[]: "Zatim ćete naučiti kako da promenite smer putovanja.<br><br>Sa ručicom menjača i kvačilom doživećete isti osećaj fizičkog menjanja brzina kao kod pravog manuelnog menjača.<br><br>Do kraja pritisnite kvačilo i radnu kočnicu. <font face=/font/big_bold.font>Koristite ručicu menjača da biste ubacili prvu brzinu. <color value=@@clr_txt@@>Držite kvačilo i radnu kočnicu pritisnute do kraja.</font>"

	key[]: "aca_msg_book1_1_03_park_br_off"
	val[]: "Da biste započeli kretanje, prvo morate otpustiti parkirnu kočnicu.<br><br><font face=/font/big_bold.font>Koristi @@imv_nrm_parkingbrake@@ da otpusti parkirnu kočnicu.</font> @@aca_goal_tip@@ U karijeri, parkirna kočnica je inicijalno onemogućena. Ovo ponašanje možete podesiti na ekranu sa opcijama - „Igranje“ - @@auto_park_brake@@."

	key[]: "aca_msg_book1_1_03_forward_arcade"
	val[]: "Sada je kamion spreman da krene napred. Započnite kretanje i pređite isprekidanu liniju.<br><br><font face=/font/big_bold.font>Započnite kretanje pomoću gasa: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_automatic"
	val[]: "Sada je kamion spreman da krene napred. Započnite kretanje i pređite isprekidanu liniju.<br><br><font face=/font/big_bold.font>Započnite kretanje pomoću gasa: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_manual"
	val[]: "Sada je kamion spreman da krene napred. Započnite kretanje i pređite isprekidanu liniju.<br><br><font face=/font/big_bold.font>Započnite kretanje pomoću gasa: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_direct"
	val[]: "Sada je kamion spreman da krene napred. Započnite kretanje i pređite isprekidanu liniju.<br><br><font face=/font/big_bold.font>Otpustite radnu kočnicu, postepeno otpuštajte kvačilo da biste ga pokrenuli, dok istovremeno koristite papučicu gasa da biste održali broj obrtaja na visokom nivou kako kamion ne bi stao. Kada se kvačilo potpuno otpusti, možete ubrzati i menjati po potrebi. </font>"

	key[]: "aca_msg_book1_1_03_stop_arcade"
	val[]: "Koristite radnu kočnicu da se zaustavite.<br><br><font face=/font/big_bold.font>Koristi $input backward$ da zaustavi kamion. </font>"

	key[]: "aca_msg_book1_1_03_stop_automatic"
	val[]: "Koristite radnu kočnicu da se zaustavite.<br><br><font face=/font/big_bold.font>Koristi $input backward$ da zaustavi kamion. </font>"

	key[]: "aca_msg_book1_1_03_stop_manual"
	val[]: "Koristite radnu kočnicu da se zaustavite.<br><br><font face=/font/big_bold.font>Koristi $input backward$ da zaustavi kamion. </font>"

	key[]: "aca_msg_book1_1_03_stop_direct"
	val[]: "Kada dođe vreme da se zaustavi, pritisnite kvačilo do kraja <font face=/font/big_bold.font>a zatim zaustaviti kamion pomoću radne kočnice.<color value=@@clr_txt@@> Prebacite u neutralni položaj koristeći ručicu menjača, a zatim možete otpustiti kvačilo. </font>"

	key[]: "aca_msg_book1_1_03_park_br_on"
	val[]: "Sada, osigurajte kamion. Parkirna kočnica obezbeđuje da se kamion neće nenamerno pomeriti nakon što ste parkirali.<br><br><font face=/font/big_bold.font>Koristi @@imv_nrm_parkingbrake@@ da biste aktivirali parkirnu kočnicu.</font>"

	key[]: "aca_msg_book1_1_03_gear_n_arcade"
	val[]: "Sa pojednostavljenim automatskim menjačem, nema potrebe da menjate brzine, sve se radi automatski za vas.<br><br><font face=/font/big_bold.font>Pritisnite @@imv_nrm_activate@@ da potvrdi. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>Prebacite u neutralan položaj pritiskom @@imv_nrm_geardown@@. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>Prebacite u neutralan položaj pritiskom @@imv_nrm_geardown@@. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>Prebacite ručicu menjača u neutralni položaj, zatim otpustite kvačilo. </font>"

	key[]: "aca_msg_book1_1_03_end"
	val[]: "Sada znate kako da pokrenete kamion i kako da ga bezbedno zaustavite.<br><br><font face=/font/big_bold.font>Pritisnite $input engineelect$ da ugasi motor. </font>"
#@}

#+ Book 1 Scenario 1_04
#@{

#### 1_04 common
	key[]: "aca_scenario_book1_1_04_title"
	val[]: "Vožnja unazad"

	key[]: "aca_scenario_book1_1_04_desc"
	val[]: "U ovom scenariju, pokušaćemo prvi put da se vratimo unazad. Takođe ćemo razgovarati o tome kako da iskoristite svoje retrovizore da vidite iza sebe, na šta da pazite i kako da se pripremite za kretanje unazad."

#### 1_04 goal

	key[]: "aca_goal_book1_1_04_start"
	val[]: "Startovanje motora"

	key[]: "aca_goal_book1_1_04_look_mirror"
	val[]: "Provera suvozačevog bočnog retrovizora"

	key[]: "aca_goal_book1_1_04_look_back"
	val[]: "Provera vozačevog bočnog retrovizora"

	key[]: "aca_goal_book1_1_04_gear_r"
	val[]: "Prebacivanje u brzinu"

	key[]: "aca_goal_book1_1_04_park_br_off"
	val[]: "Otpuštanje parkirne kočnice"
#!{
	key[]: "aca_goal_book1_1_04_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_1_04_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_1_04_park_br_on"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

#!}
	key[]: "aca_goal_book1_1_04_gear_n"
	val[]: "Prebacivanje u ler"

	key[]: "aca_goal_book1_1_04_end"
	val[]: "Gašenje motora"

#### 1_04 msg - intro text

	key[]: "aca_msg_book1_1_04_cutscene1"
	val[]: "Za ovu vožnju, mi ćemo kretati unazad u pravoj liniji. Moraćete da pređete unazad preko isprekidane linije i da se tamo zaustavite."

	key[]: "aca_msg_book1_1_04_cutscene2"
	val[]: "Kada vozite kamion unazad, neophodno je da stalno gledate okolo, posmatrate sve retrovizore i vodite računa o tome da je prostor oko i iza vas čist."

	key[]: "aca_msg_book1_1_04_cutscene3"
	val[]: "Upalite motor, prebacite u rikverc i počnite da se krećete."

	key[]: "aca_msg_book1_1_04_cutscene4"
	val[]: "Pređite unazad preko isprekidane linije, zaustavite se, ugasite motor i osigurajte kamion."

#### 1_04 Driving Instructions

	key[]: "aca_msg_book1_1_04_start"
	val[]: "Pripremite kamion za vožnju kao što ste naučili u prethodnom scenariju.<br><br><font face=/font/big_bold.font>Kada budete spremni, upalite motor. </font>"

	key[]: "aca_msg_book1_1_04_look_mirror"
	val[]: "Proverite svoje retrovizore da biste se uverili da je područje oko vas čisto. Ako niste zadovoljni njihovim položajima, možete ih podesiti '@@adjust_link_t@@'.<br><br><font face=/font/big_bold.font>Pogledajte suvozačev bočni retrovizor.</font>@@aca_goal_tip@@ Morate da budete u vozilu."

	key[]: "aca_msg_book1_1_04_look_back"
	val[]: "Proći ćete preko isprekidane linije. Traka je sada čista, ali tokom redovne vožnje, od suštinskog je značaja da stalno nadgledate svoju okolinu gledajući okolo i upotrebom retrovizora.<br><br><font face=/font/big_bold.font>Proverite retrovizor sa strane vozača.</font>"

	key[]: "aca_msg_book1_1_04_gear_r_arcade"
	val[]: "<font face=/font/big_bold.font>Koristi $input backward$ za uključivanje stepena prenosa unazad. </font>@@aca_goal_tip@@ Prilikom vožnje unazad, rezervni alarm se automatski uključuje na većini kamiona. Možete ga isključiti na ekranu sa opcijama - „Audio“ - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_automatic"
	val[]: "<font face=/font/big_bold.font>Pritisnite @@imv_nrm_geardown@@ za prebacivanje u rikverc. </font>@@aca_goal_tip@@ Prilikom vožnje unazad, rezervni alarm se automatski uključuje na većini kamiona. Možete ga isključiti na ekranu sa opcijama - „Audio“ - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_manual"
	val[]: "<font face=/font/big_bold.font>Pritisnite @@imv_nrm_geardown@@ za prebacivanje u rikverc. </font>@@aca_goal_tip@@ Prilikom vožnje unazad, rezervni alarm se automatski uključuje na većini kamiona. Možete ga isključiti na ekranu sa opcijama - 'Audio' - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_direct"
	val[]: "<font face=/font/big_bold.font>Pritisnite do kraja kvačilo i pomerite ručicu menjača u hod unazad. </font>@@aca_goal_tip@@ Prilikom vožnje unazad, rezervni alarm se automatski uključuje na većini kamiona. Možete ga isključiti na ekranu sa opcijama - „Audio“ - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_park_br_off"
	val[]: "Sada imate uključenu brzinu za vožnju unazad.<br><br><font face=/font/big_bold.font>Otpustite parkirnu kočnicu koristeći @@imv_nrm_parkingbrake@@. </font>"

	key[]: "aca_msg_book1_1_04_backward_arcade"
	val[]: "Počnite da se krećete koristeći $input backward$.<br><br><font face=/font/big_bold.font>Okrenite se unazad preko isprekidane linije. </font>"

	key[]: "aca_msg_book1_1_04_backward_automatic"
	val[]: "Počnite da se krećete koristeći gas: $input forward$.<br><br><font face=/font/big_bold.font>Okrenite se unazad preko isprekidane linije. </font>"

	key[]: "aca_msg_book1_1_04_backward_manual"
	val[]: "Počnite da se krećete koristeći gas: $input forward$.<br><br><font face=/font/big_bold.font>Okrenite se unazad preko isprekidane linije. </font>"

	key[]: "aca_msg_book1_1_04_backward_direct"
	val[]: "Polako otpustite kvačilo, održavajući broj obrtaja motora pomoću gasa. <br><br><font face=/font/big_bold.font>Okrenite se unazad preko isprekidane linije. </font>"

	key[]: "aca_msg_book1_1_04_stop_arcade"
	val[]: "<font face=/font/big_bold.font>Zaustavite kamion koristeći svoju radnu kočnicu: $input forward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_automatic"
	val[]: "<font face=/font/big_bold.font>Zaustavite kamion koristeći svoju radnu kočnicu: $input backward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_manual"
	val[]: "<font face=/font/big_bold.font>Zaustavite kamion koristeći svoju radnu kočnicu: $input backward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_direct"
	val[]: "<font face=/font/big_bold.font>Pritisnite kvačilo do kraja, a zatim zaustavite kamion koristeći radne kočnice. </font>"

	key[]: "aca_msg_book1_1_04_park_br_on"
	val[]: "<font face=/font/big_bold.font>Aktivirajte parkirnu kočnicu pomoću @@imv_nrm_parkingbrake@@. </font>"

	key[]: "aca_msg_book1_1_04_gear_n_arcade"
	val[]: "Sa pojednostavljenim automatskim menjačem, nema potrebe da menjate brzine jer se sve radi automatski za vas, za razliku od stvarnosti.<br><br><font face=/font/big_bold.font>Pritisnite @@imv_nrm_activate@@ da potvrdi. </font>"

	key[]: "aca_msg_book1_1_04_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>Prebacite u neutralan položaj pritiskom @@imv_nrm_gearup@@.</font>@@aca_goal_tip@@ Savremeni kamioni će automatski prebaciti u neutralni položaj kada se povuče parkirna kočnica. Ipak, dobra je navika da to uvek radite sami. U sledećim scenarijima, ovaj korak nam neće biti potreban."

	key[]: "aca_msg_book1_1_04_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>Prebacite u neutralan položaj pritiskom @@imv_nrm_gearup@@.</font>@@aca_goal_tip@@ Savremeni kamioni će automatski prebaciti u neutralni položaj kada se povuče parkirna kočnica. Ipak, dobra je navika da to uvek radite sami. U sledećim scenarijima, ovaj korak nam neće biti potreban."

	key[]: "aca_msg_book1_1_04_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>Pomerite ručicu menjača u neutralni položaj, a zatim otpustite kvačilo.</font>@@aca_goal_tip@@ Savremeni kamioni će automatski prebaciti u neutralni položaj kada se povuče parkirna kočnica. Ipak, dobra je navika da to uvek radite sami. U sledećim scenarijima, ovaj korak nam neće biti potreban."

	key[]: "aca_msg_book1_1_04_end"
	val[]: "Ne zaboravite da uvek budete svesni svog okruženja dok se krećete unazad, posebno u prometnim područjima sa puno saobraćaja.<br><br><font face=/font/big_bold.font>Isključite motor pritiskom na $input engineelect$. </font>"
#@}

# Book 1 Scenario 1_05 formatting
#!{
	key[]: "aca_msg_book1_1_05_low_beam_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/parking_lights.mat width=336 height=76 color=FFFFFFFF></align><offset vshift=76>"

	key[]: "aca_msg_book1_1_05_high_beam_on_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/low_beam.mat width=336 height=76 color=FFFFFFFF></align><offset vshift=76>"

	key[]: "aca_msg_book1_1_05_high_beam_off_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/high_beam.mat width=336 height=76 color=FFFFFFFF></align><offset vshift=76>"

	key[]: "aca_msg_book1_1_05_lblinker_off_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/blinkers_left.mat width=336 height=76 color=FFFFFFFF></align><offset vshift=76>"

	key[]: "aca_msg_book1_1_05_rblinker_off_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/blinkers_right.mat width=336 height=76 color=FFFFFFFF></align><offset vshift=76>"

	key[]: "aca_msg_book1_1_05_hazard_on_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/hazard_lights.mat width=336 height=76 color=FFFFFFFF></align><offset vshift=76>"

	key[]: "aca_msg_book1_1_05_hazard_off_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/hazard_lights_blink.mat width=336 height=76 color=FFFFFFFF></align><offset vshift=76>"
