#+ Book 3 Scenario urf
#@{

#### urf common
	key[]: "aca_scenario_book3_urf_title"
	val[]: "Oslonac za kutiju"

	key[]: "aca_scenario_book3_urf_desc"
	val[]: "U ovom scenariju, bićete smešteni na prazan parking da vežbate vožnju unazad sa B-duplim prikolicama."

#### urf goal

	key[]: "aca_goal_book3_urf_start"
	val[]: "Započnite"

	key[]: "aca_goal_book3_urf_move"
	val[]: "Eksperimentisanje"

	key[]: "aca_goal_book3_urf_stop"
	val[]: "Završava se"

	key[]: "aca_goal_book3_urf_end"
	val[]: "Kraj scenarija"

	#### urf msg - intro text

	key[]: "aca_msg_book3_urf_cutscene1"
	val[]: "Vožnja unazad sa B-duplim prikolicama zahteva mnogo više pažnje nego sa jednom prikolicom. Morate unapred planirati gde želite da se postavi zadnja prikolica, a da pritom zadržite kontrolu na prednjoj prikolici i kabini. <br><br>Zamislite to kao da upravljate zadnjom prikolicom pomoću vodeće prikolice. Dakle, gde god da usmerite vodeću prikolicu, putanja zadnjeg dela će se promeniti."

	key[]: "aca_msg_book3_urf_cutscene2"
	val[]: "In this case, we want to turn the rear trailer to the driver's side. <br><br>To do this, we steered the lead to the passenger's side."

	key[]: "aca_msg_book3_urf_cutscene3"
	val[]: "Ovde većina ljudi pravi svoju prvu grešku. Kada zadnja prikolica počne da se okreće, morate ispraviti kamion sa vođstvom..."

	key[]: "aca_msg_book3_urf_cutscene4"
	val[]: "...ili ćeš završiti poprečen ovako."

	key[]: "aca_msg_book3_urf_cutscene5"
	val[]: "Do savijanja vozila u kombinaciji dolazi kada ugao između bilo koja dva vozila u kombinaciji postane oko 90°. Kada se to desi, nema spasa - morate krenuti napred i pokušati ponovo. <br><br> Kao i kod vožnje jedne prikolice unazad, cilj bi uvek trebalo da bude da se svi točkovi na prikolicama okreću. Kada se jedan točak zaustavi i prikolica se okreće u mestu, gotovo je."

	key[]: "aca_msg_book3_urf_cutscene6"
	val[]: "Možete se povući napred do mesta gde ste poslednji put bili ispravni, odnosno do položaja gde možete nastaviti da radite unazad bez ponovnog ponavljanja iste greške, ili jednostavno povući napred dok ne budete pravi."

	key[]: "aca_msg_book3_urf_cutscene7"
	val[]: "Ponovo, kada se zadnja prikolica okreće, postavite kamion ispred vodećeg dela i pustite da se zadnja prikolica sama okrene na trenutak."

	key[]: "aca_msg_book3_urf_cutscene8"
	val[]: "Sada kada se zadnja prikolica lepo okreće, vreme je da se ispred nje pokrene i vodeća prikolica. Možete podesiti ugao između vodeće i zadnjeg dela prikolice da biste kontrolisali skretanje i učinili ga oštrijim ili širim."

	key[]: "aca_msg_book3_urf_cutscene9"
	val[]: "Poslednji deo manevra je ispravljanje svega. Preuzmite vođstvo ispred zadnjeg dela."

	key[]: "aca_msg_book3_urf_cutscene10"
	val[]: "Dobro je imati na umu vreme potrebno za pomeranje vođstva, kao i da ćete takođe morati da dovedete kamion u red."

	key[]: "aca_msg_book3_urf_cutscene11"
	val[]: "Slobodno provedite ovde koliko god vremena želite, eksperimentišite sa različitim manevrima dok ne pomislite da imate otprilike predstavu o tome kako se rukuje prikolicama unazad."

#### urf Driving Instructions

	key[]: "aca_msg_book3_urf_start"
	val[]: "Pripremite se za polazak."

	key[]: "aca_msg_book3_urf_move"
	val[]: "Koristite ovaj parking da biste stekli osećaj za rukovanje prikolicama unazad. <br><br>@@aca_goal_tip@@ Novi ste u praćenju prikolica uopšte? Razmislite o igranju igre Osnove vožnje kamiona."

	key[]: "aca_msg_book3_urf_stop"
	val[]: "Vežbajte koliko god želite. <br><br>Kada ste zadovoljni, možete zaustaviti i obezbediti kamion kako biste okončali scenario."

	key[]: "aca_msg_book3_urf_end"
	val[]: "Ugasite motor da biste završili scenario."
#@}


#+ Book 3 Scenario sup
#@{

#### sup common
	key[]: "aca_scenario_book3_sup_title"
	val[]: "Parkiranje u uskom prostoru"

	key[]: "aca_scenario_book3_sup_desc"
	val[]: "U ovom scenariju, zadatak vam je da parkirate svoju B-duplu kombinaciju u uskom prostoru."

#### sup goal

	key[]: "aca_goal_book3_sup_start"
	val[]: "Započnite"

	key[]: "aca_goal_book3_sup_forward"
	val[]: "Krenite"

	key[]: "aca_goal_book3_sup_check1"
	val[]: "Nastavite vožnju"

	key[]: "aca_goal_book3_sup_stop"
	val[]: "Zaustavljanje"

	key[]: "aca_goal_book3_sup_end"
	val[]: "Obezbedite vozilo"

#### sup msg - intro text

	key[]: "aca_msg_book3_sup_cutscene1"
	val[]: "Vožnja sa B-duplim prikolicama može delovati zastrašujuće, ali nema mnogo više od vožnje sa jednom prikolicom - samo morate uzeti u obzir i putanju zadnje prikolice!"

	key[]: "aca_msg_book3_sup_cutscene2"
	val[]: "Ispred vas je usko parking mesto. Nećete imati dovoljno prostora da se potpuno ispravite pre ulaska, pa ćete morati pažljivo razmisliti kako ćete se uvući sa obe prikolice."

	key[]: "aca_msg_book3_sup_cutscene3"
	val[]: "Odmah skrenite ka suprotnoj strani parking mesta i vozite daleko dalje od mesta gde biste obično skrenuli."

	key[]: "aca_msg_book3_sup_cutscene4"
	val[]: "Sada kada je vaša zadnja prikolica na pravom putu, možete se uputiti ka tom mestu; možda ćete morati ponovo da odete na drugu stranu kako biste pomogli da dovezete prvu prikolicu."

	key[]: "aca_msg_book3_sup_cutscene5"
	val[]: "Nastavite do mesta, a obe prikolice će vas pratiti i ispravljati se dok idete."

	key[]: "aca_msg_book3_sup_cutscene6"
	val[]: "Parkirajte na određenom području i obezbedite kamion."

#### sup Driving Instructions

	key[]: "aca_msg_book3_sup_start"
	val[]: "Pripremite se za polazak."

	key[]: "aca_msg_book3_sup_forward"
	val[]: "Nastavite napred i uđite u uski prostor."

	key[]: "aca_msg_book3_sup_check1"
	val[]: "Nastavite vožnju."

	key[]: "aca_msg_book3_sup_stop"
	val[]: "Zaustavite se na određenom području."

	key[]: "aca_msg_book3_sup_end"
	val[]: "Obezbedite kamion i ugasite motor."
#@}


