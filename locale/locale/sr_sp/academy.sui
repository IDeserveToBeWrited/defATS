#### finex common

	key[]: "aca_scenario_book3_finex_title"
	val[]: "Završni ispit"

	key[]: "aca_scenario_book3_finex_desc"
	val[]: "U ovom scenariju, testiraćete svoje nove veštine na kursu osmišljenom da testira vašu preciznost i razumevanje vožnje sa B-duplim prikolicama."

#### finex goal

	key[]: "aca_goal_book3_finex_check0"
	val[]: "Vožnja unazad"

	key[]: "aca_goal_book3_finex_check1"
	val[]: "Ulazak na poligon"

	key[]: "aca_goal_book3_finex_check2"
	val[]: "Dobiti na brzini"

