#### 3_01 msg - intro text

	key[]: "aca_msg_book1_3_01_cutscene1"
	val[]: "U ovom scenariju, pokušaćemo da povežemo i odkačimo prikolicu po prvi put. Pripremite kamion za polazak, a zatim vozite unazad ispod prikolice iza vas."

	key[]: "aca_msg_book1_3_01_cutscene2"
	val[]: "Zakačite prikolicu, povucite napred."

	key[]: "aca_msg_book1_3_01_cutscene3"
	val[]: "Stanite na označenu zonu."

	key[]: "aca_msg_book1_3_01_cutscene4"
	val[]: "Odkačite prikolicu, povucite napred."

	key[]: "aca_msg_book1_3_01_cutscene5"
	val[]: "Parkirajte na parking mesto i obezbedite kamion."


#### 3_01 Driving Instructions

	key[]: "aca_msg_book1_3_01_start"
	val[]: "U ovom scenariju, razgovaraćemo o procedurama za povezivanje i odvajanje tegljača i prikolice. Ovo je pojednostavljena procedura u poređenju sa onim sa čime će se kamiondžija susresti u stvarnom životu. <br><br><font face=/font/big_bold.font>Pripremite se za polazak. </font>"

	key[]: "aca_msg_book1_3_01_check_con"
	val[]: "Iza tegljača se nalazi prikolica. Polako krenite unazad ispod prikolice dok sedlo ne udari u osovinu. Kamion je trenutno pravilno poravnat tako da nema potrebe za upravljanjem, samo krenite pravo unazad.<br><br><font face=/font/big_bold.font>Polako vozite unazad sve dok ne osetite vezu. </font>"

	key[]: "aca_msg_book1_3_01_park_br_on"
	val[]: "Sedlo je spojeno sa osovinom.<br><br><font face=/font/big_bold.font>Obezbedite kamion primenjivanjem parkirne kočnice. </font>"

	key[]: "aca_msg_book1_3_01_connect"
	val[]: "U stvarnom životu, sedlo automatski zaključava osovinu, a zatim bi kamiondžija morao da izađe iz vozila da uvuče stajni trap i poveže vazdušne i električne vodove. <br><br><font face=/font/big_bold.font>Za nas, jednostavnim pritiskom @@imv_nrm_attach@@ povezaće prikolicu. </font>"

	key[]: "aca_msg_book1_3_01_park_br_off"
	val[]: "Sada kada je tegljač bezbedno povezan sa prikolicom, spremni ste da krenete napred. Imajte na umu da je vaše vozilo sada znatno duže i teže i da će zahtevati novi set veština za upravljanje. <br><br><font face=/font/big_bold.font>Otpustite parkirnu kočnicu i pripremite se da vozite napred. </font>"

	key[]: "aca_msg_book1_3_01_check_discon"
	val[]: "Vozite napred.<br><br><font face=/font/big_bold.font>Zaustavite se u obeleženom području ispred. </font>"

	key[]: "aca_msg_book1_3_01_parking_brake5"
	val[]: "<font face=/font/big_bold.font>Primenite parkirnu kočnicu. </font>"

	key[]: "aca_msg_book1_3_01_stop5"
	val[]: "<font face=/font/big_bold.font>Aktivirajte parkirnu kočnicu. </font>"

	key[]: "aca_msg_book1_3_01_disc5"
	val[]: "Još jednom, u stvarnom životu, kamiondžija bi morao da izađe iz vozila, spusti stajni trap, isključi vazdušne i električne vodove i pusti mehanizam za zaključavanje sedla. <br><br><font face=/font/big_bold.font>Mi pojednostavljujemo ovaj proces za vas, tako da pritisnite @@imv_nrm_attach@@ da odkači prikolicu. </font>"

	key[]: "aca_msg_book1_3_01_park_br_off2"
	val[]: "<font face=/font/big_bold.font>Otpustite vašu parkirnu kočnicu. </font>"

	key[]: "aca_msg_book1_3_01_park_br_off3"
	val[]: "Izvucite tegljač ispod prikolice i idite napred.<br><br><font face=/font/big_bold.font>Zaustavite se na obeleženom području. </font>"

	key[]: "aca_msg_book1_3_01_stop"
	val[]: "<font face=/font/big_bold.font>Zaustavite se na označenom području. </font>"
#!{
	key[]: "aca_msg_book1_3_01_end"
	val[]: "@@aca_msg_book1_2_01_end@@"


#!}

#@}

#+ Book 1 Scenario 3_02
#@{

#### 3_02 common
	key[]: "aca_scenario_book1_3_02_title"
	val[]: "Kočenje sa prikolicom"

	key[]: "aca_scenario_book1_3_02_desc"
	val[]: "U ovom scenariju, dobićete osećaj za vožnju i kočenje sa zakačenom prikolicom."

#### 3_02 goal



	key[]: "aca_goal_book1_3_02_forward"
	val[]: "Krenite"

	key[]: "aca_goal_book1_3_02_check1"
	val[]: "Vožnja niz nagib"

	key[]: "aca_goal_book1_3_02_check2"
	val[]: "Dostizanje brzine od 60 km/h (37 mph)"

	key[]: "aca_goal_book1_3_02_check3"
	val[]: "Primena kočnica"
#!{
	key[]: "aca_goal_book1_3_02_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_02_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_02_start"
	val[]: "@@aca_goal_book1_2_01_start@@"
 #!}
#### 3_02 msg - intro text

	key[]: "aca_msg_book1_3_02_cutscene01"
	val[]: "U ovom scenariju, odvešćemo kamion na kratku vožnju. Moći ćete da steknete osećaj kočenja sa prikolicom dok se spuštamo blagim nagibom napred. Pripremite kamion i krenite."

	key[]: "aca_msg_book1_3_02_cutscene06"
	val[]: "Dostignite brzinu od najmanje 60 km/h (37 mph). Budite spremni za zonu kočenja ispred vas."

	key[]: "aca_msg_book1_3_02_cutscene08"
	val[]: "Počnite kočiti do zaustavljanja. Pazite da ne čekate predugo, inače biste mogli da udarite u barijere ispred sebe!"

	key[]: "aca_msg_book1_3_02_cutscene10"
	val[]: "Parkirajte na određenom mestu, zatim obezbedite kamion i ugasite motor."


#### 3_02 Driving Instructions

	key[]: "aca_msg_book1_3_02_start"
	val[]: "Tokom ove vožnje, steći ćete osećaj da koristite radne kočnice dok se spuštate blagim nagibom. Svrha ove vežbe je da postanete svesni težine iza vas i kako ona utiče na put kočenja vozila.<br><br><font face=/font/big_bold.font>Pripremite se za polazak. </font>"

	key[]: "aca_msg_book1_3_02_forward"
	val[]: "Počnite da vozite sada i imajte na umu da ćete morati da postignete brzinu od 60 km/h (37 mph) <font face=/font/big_bold.font>posle</font> скретања напред.<br><br><font face=/font/big_bold.font>Vozite prema skretanju ispred vas. </font>"

	key[]: "aca_msg_book1_3_02_check1"
	val[]: "Skrenite desno, a zatim ubrzajte do 60 km/h (37 mph).<br><br><font face=/font/big_bold.font>Nastavite vožnju. </font>"

	key[]: "aca_msg_book1_3_02_check2"
	val[]: "<font face=/font/big_bold.font>Dostignite brzinu od najmanje 60 km/h (37 mph). </font>"

	key[]: "aca_msg_book1_3_02_check3"
	val[]: "Dostigli ste potrebnu brzinu.<br><br><font face=/font/big_bold.font>Zaustavite se na preprekama ispred. </font>"
#!{
	key[]: "aca_msg_book1_3_02_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_02_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

