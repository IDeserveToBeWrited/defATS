#### 3_19 msg - intro text

	key[]: "aca_msg_book1_3_19_cutscene01"
	val[]: "Dobrodošli na prvi deo završnog ispita. Evo, videćemo koliko ste dobro naučili da vozite kamion nakon provedenog na Akademiji."

	key[]: "aca_msg_book1_3_19_cutscene02"
	val[]: "Prvo ćete prikačiti prikolicu. Kada se povežete, vozićete kamion po celoj testnoj ruti."

	key[]: "aca_msg_book1_3_19_cutscene03"
	val[]: "Prvi deo testa vodi vas na sporedne puteve koji će vas odvesti prema centru grada."

	key[]: "aca_msg_book1_3_19_cutscene04"
	val[]: "Testna ruta uključuje različite vrste uglova i prepreka."

	key[]: "aca_msg_book1_3_19_cutscene05"
	val[]: "Mali deo rute prolazi kroz centar grada."

	key[]: "aca_msg_book1_3_19_cutscene06"
	val[]: "Testiraćemo vašu sposobnost manevrisanja kamionom kroz različite prepreke i kurseve."

	key[]: "aca_msg_book1_3_19_cutscene07"
	val[]: "Susrećete se sa raznim situacijama koje će testirati vašu pažnju na okolinu."

	key[]: "aca_msg_book1_3_19_cutscene08"
	val[]: "Vi imate vožnju unazad kroz industrijski objekat."

	key[]: "aca_msg_book1_3_19_cutscene09"
	val[]: "Nakon vožnje putevima, kroz centar grada i u industrijskom objektu, uputićete se ka @@driving_academy@@ štabu."

	key[]: "aca_msg_book1_3_19_cutscene10"
	val[]: "Kratka vožnja putem i skoro ste gotovi."

	key[]: "aca_msg_book1_3_19_cutscene11"
	val[]: "Da biste završili test, moraćete precizno da parkirate. Možete odabrati koji manevar najbolje odgovara za vas."

	key[]: "aca_msg_book1_3_19_cutscene12"
	val[]: "Nema potrebe da budete nervozni, već ste naučili sve što će biti potrebno za polaganje.<br><br>Srećno!"

#### 3_19 Driving Instructions



	key[]: "aca_msg_book1_3_19_forward"
	val[]: "Prvo ćete morati da pronađete i zakačitete prikolicu. Parkiran je napred sa desne strane.<br><br><font face=/font/big_bold.font>Vozite prema prikolici.</font>"

	key[]: "aca_msg_book1_3_19_coupling"
	val[]: "Skrenite levo, zatim vozite unazad prema prikolici i poravnajte se sa njom.<br><br><font face=/font/big_bold.font>Vozite nazad prema prikolici. </font>"

	key[]: "aca_msg_book1_3_19_park_br_on"
	val[]: "<font face=/font/big_bold.font>Obezbedite kamion. </font>"

	key[]: "aca_msg_book1_3_19_connect"
	val[]: "<font face=/font/big_bold.font>Pritisnite @@imv_nrm_attach@@ da povežete prikolicu. </font>"

	key[]: "aca_msg_book1_3_19_park_br_off"
	val[]: "Prikolica je povezana, a kamion je spreman za vožnju.<br><br><font face=/font/big_bold.font>Otpustite parkirnu kočnicu. </font>"

	key[]: "aca_msg_book1_3_19_b_trailer"
	val[]: "Put je zatvoren radi našeg testiranja. Možete izabrati da poštujete ili ignorišete saobraćajne znakove kako vam odgovara.<br><br><font face=/font/big_bold.font>Vozite prema putu. </font>"

	key[]: "aca_msg_book1_3_19_check01"
	val[]: "Prođite kroz prvih nekoliko skretanja. <br><br><font face=/font/big_bold.font>Nastavite vožnju. </font>"

	key[]: "aca_msg_book1_3_19_check02"
	val[]: "Posle sledećeg skretanja sledi slalom od saobraćajnih čunjeva.<br><br><font face=/font/big_bold.font>Pažljivo se krećite između saobraćajnih čunjeva. </font>"

	#key[]: "aca_msg_book1_3_19_check02a"
	#val[]: "Continue through the roundabout into the town.<br><br><font face=/font/big_bold.font>Negotiate the roundabout.</font>"

	key[]: "aca_msg_book1_3_19_check02b"
	val[]: "Očekuje vas još nekoliko skretanja od 90°. <br><br><font face=/font/big_bold.font>Nastavite vožnju. </font>"

	key[]: "aca_msg_book1_3_19_check03"
	val[]: "Sledeće skretanje je izuzetno tesno i zahtevaće ceo put da biste ga uspešno obavili.<br><br><font face=/font/big_bold.font>Skrenite desno i vozite kroz uličicu.</font>"

	key[]: "aca_msg_book1_3_19_check04"
	val[]: "Skrenite levo iz uličice, a zatim skrenite desno na glavni put.<br><br><font face=/font/big_bold.font>Nastavite vožnju. </font>"

	key[]: "aca_msg_book1_3_19_check05"
	val[]: "Možete se malo opustiti dok se vozite glavnim putem. <br><br><font face=/font/big_bold.font>Vozite pravo. </font>"

	key[]: "aca_msg_book1_3_19_check06"
	val[]: "Postoje oštra skretanja na i van servisnog puta.<br><br><font face=/font/big_bold.font>Pažljivo vozite kroz skretanja. </font>"

	key[]: "aca_msg_book1_3_19_check07"
	val[]: "Ulazite u složeniji slalom. Nastavite polako i koristite svoje retrovizore. <br><br><font face=/font/big_bold.font>Nastavite sa vožnjom i pažljivo se krećite u slalomu.</font>"

	key[]: "aca_msg_book1_3_19_check08"
	val[]: "Skrenite levo u industrijsko područje, pazite na rasvetni stub.<br><br><font face=/font/big_bold.font>Napravi levo skretanje. </font>"

	key[]: "aca_msg_book1_3_19_check09"
	val[]: "Pripremite se za vožnju unazad.<br><br><font face=/font/big_bold.font>Skrenite desno i zaustavite se u odsečenu oblast. </font>"

	key[]: "aca_msg_book1_3_19_check10"
	val[]: "Vozite unazad i pratite kurs levo iza vas.<br><br><font face=/font/big_bold.font>Započnite vožnju unazad.</font>"

	key[]: "aca_msg_book1_3_19_check11"
	val[]: "Pratite kurs levo. <br><br><font face=/font/big_bold.font>Nastavite vožnju unazad. </font>"

	key[]: "aca_msg_book1_3_19_check12"
	val[]: "<font face=/font/big_bold.font>Vozite napred i skrenite desno. </font>"

	key[]: "aca_msg_book1_3_19_check13"
	val[]: "<font face=/font/big_bold.font>Nastavite prema kapiji. </font>"

	key[]: "aca_msg_book1_3_19_check14"
	val[]: "Sačekajte da se kapija otvori, a zatim se vratite na glavni put.<br><br><font face=/font/big_bold.font>Nastavite vožnju. </font>"

	key[]: "aca_msg_book1_3_19_check15"
	val[]: "Pazite da ne udarite u znak.<br><br><font face=/font/big_bold.font>Napravite skretanje i nastavite vožnju. </font>"

	key[]: "aca_msg_book1_3_19_check16"
	val[]: "<font face=/font/big_bold.font>Skrenite levo u Akademiju. </font>"

	key[]: "aca_msg_book1_3_19_check17"
	val[]: "<font face=/font/big_bold.font>Nastavite pravo. </font>"

	key[]: "aca_msg_book1_3_19_check18"
	val[]: "Držite se spolja, jer nakon krivine postoji naglo skretanje.<br><br><font face=/font/big_bold.font>Pratite krivinu.</font>"

	key[]: "aca_msg_book1_3_19_check19"
	val[]: "<font face=/font/big_bold.font>Skrenite levo i pripremite se za parkiranje sa leve strane.</font>"

	key[]: "aca_msg_book1_3_19_check20"
	val[]: "<font face=/font/big_bold.font>Vozite unazad na parking mesto.</font>"
#!{
	key[]: "aca_msg_book1_3_19_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_19_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_19_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
 #!}


#@}


#+ Book 1 Scenario 3_20
#@{

#### 3_20 common
	key[]: "aca_scenario_book1_3_20_title"
	val[]: "Završni ispit (2. deo)"

	key[]: "aca_scenario_book1_3_20_desc"
	val[]: "Očekuje vas poslednji deo završnog ispita, gde će se proceniti veštine parkiranja koje ste naučili u prethodnim scenarijima. Parkirajte pažljivo i precizno i bićete spremni da krenete putevima Amerike kao vešt kamiondžija!"

#### 3_20 goal
#!{
	key[]: "aca_goal_book1_3_20_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_20_stop"
