	key[]: "aca_scenario_book3_double_90_title"
	val[]: "Skretanja 90°"

	key[]: "aca_scenario_book3_double_90_desc"
	val[]: "U ovom scenariju, imaćete zadatak da vozite kroz stazu sa skretanjima od 90° različite težine."

#### double_90 goal

	key[]: "aca_goal_book3_double_90_start"
