#### double_90 intro

	key[]: "aca_msg_book3_double_90_cutscene01"
	val[]: "Kurs pred vama će vam pomoći da se upoznate sa skretanjem B-duplih prikolica kroz skretanja od 90° različite težine."

	key[]: "aca_msg_book3_double_90_cutscene02"
	val[]: "Prvih nekoliko krivina je prilično širokih, sa puno prostora. Koristite ih da biste stekli utisak o prikolicama iza vas dok skrećete."

	key[]: "aca_msg_book3_double_90_cutscene03"
	val[]: "Od sada pa nadalje, skretanja će postajati uža i tehnički zahtevnija. Prilazite im polako i vodite računa da vozite duboko u skretanju kako bi vaše prikolice imale prostora da se zaobiđu iza vas."

	key[]: "aca_msg_book3_double_90_cutscene04"
	val[]: "Ovo je jedna od najužih krivina na stazi. Možda će vam pomoći da iskoristite mali prostor sa desne strane kako biste lakše zaobišli one dosadne unutrašnje čunjeve sa prikolicama."

	key[]: "aca_msg_book3_double_90_cutscene05"
	val[]: "Sledeće skretanje treba uvek da vam bude u pozadini uma - dok izlazite iz jednog skretanja, napravite plan kako ćete se pripremiti za sledeći."

	key[]: "aca_msg_book3_double_90_cutscene06"
	val[]: "Uvek obraćajte pažnju na svoje prikolice sve dok se ne uklone od bilo kakvih prepreka."

#### double_90 driving instructions

#!{
	key[]: "aca_msg_book3_double_90_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_double_90_forward"
	val[]: "Nastavite napred prema prvom skretanju."

	key[]: "aca_msg_book3_double_90_check1"
	val[]: "Obratite pažnju na retrovizore dok vozite kako biste razumeli kako se prikolice kreću iza vas."

	key[]: "aca_msg_book3_double_90_check2"
	val[]: "Držite se široko pre svakog skretanja, ovo je ključno da biste sebi dali prostora koji vam je potreban da zaobiđete prikolice iza ugla."

	key[]: "aca_msg_book3_double_90_check3"
	val[]: "Postavljanje za sledećih nekoliko krivina je ključno, jer posle toga sledi veoma uska krivina. Greška na početku može vas kasnije još više koštati. <br><br>Budite spori i pedantni i obratite pažnju na svoju okolinu."

	key[]: "aca_msg_book3_double_90_check4"
	val[]: "Ovo skretanje je izuzetno usko i vodi direktno u drugo usko skretanje. Nećete morati samo da razmislite kako ulazite u skretanje, već i kako izlazite i kako se postavljate za sledeće."

	key[]: "aca_msg_book3_double_90_check5"
	val[]: "Nastavite vožnju kroz poslednje skretanje prema označenom području."

#!{
	key[]: "aca_msg_book3_double_90_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_double_90_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


#+ Book 3 Scenario justb
#@{

#### justb common
	key[]: "aca_scenario_book3_justb_title"
	val[]: "Prva vožnja unazad"

	key[]: "aca_scenario_book3_justb_desc"
	val[]: "U ovom scenariju, vozićemo unazad kombinaciju B-duplih prikolica po prvi put."

#### justb goal

#!{
	key[]: "aca_goal_book3_justb_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_justb_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
	key[]: "aca_goal_book3_justb_check1"
	val[]: "Opusti se, ne brini"

#!{
	key[]: "aca_goal_book3_justb_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_justb_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### justb msg - intro text

	key[]: "aca_msg_book3_justb_cutscene1"
	val[]: "Vožnja unazad sa B-duplim prikolicama zahteva potpuno novi način razmišljanja o tome šta radite. Umesto da samo upravljate prikolicom, sada koristite svoju vodeću prikolicu da upravljate prikolicom iza nje. <br><br> Iskoristite ovaj scenario da biste stekli utisak o tome kako sve funkcioniše. Ne postoji određeni cilj, samo odvojite vreme i pokušajte da shvatite šta se dešava."

	key[]: "aca_msg_book3_justb_cutscene2"
	val[]: "Iz pravog položaja možete okrenuti kamion u istom smeru u kom želite da ide zadnja prikolica. <br><br>Ne preterujte; samo treba da usmerite zadnju prikolicu u željenom pravcu, a zatim možete poravnati tegljač sa vodećom prikolicom i pustiti zadnju prikolicu da uradi svoje."

	key[]: "aca_msg_book3_justb_cutscene3"
	val[]: "Kada se vaša zadnja prikolica kreće tamo gde želite, možete usmeriti vodeću prikolicu da prati isti smer. <br><br>Kada vodeća prati zadnji deo, pomoću tegljača podesite ugao između dve prikolice kako biste napravili oštrije skretanje ili šire skretanje."

	key[]: "aca_msg_book3_justb_cutscene4"
	val[]: "Ne postoji tačna formula da se ovo uradi kako treba, samo treba da obratite pažnju na ono što se dešava, učite iz svojih grešaka i nastavite da vežbate. <br><br>Kada ste zadovoljni, možete se uputiti ka određenom području i obezbediti vozilo. <br><br>Slobodno provedite ovde onoliko vremena eksperimentišući koliko smatrate da vam je potrebno."

#### justb Driving Instructions

#!{
	key[]: "aca_msg_book3_justb_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_justb_forward"
	val[]: "Počnite polako da se krećete unazad. Zapamtite da počnete sa malim ulazima, nema potrebe da sve odmah preklapate.<br><br>Pokušajte da se vratite pravo nazad ili dovezite prikolice do vozačeve strane."

	key[]: "aca_msg_book3_justb_check1"
	val[]: "Ne žurite i nemojte se frustrirati. <br><br>Svaki majstor je nekada bio početnik."

#!{
	key[]: "aca_msg_book3_justb_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_justb_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}

#+ Book 3 Scenario justc
#@{

#### justc common
	key[]: "aca_scenario_book3_justc_title"
	val[]: "Prva korekcija vožnje unazad"

	key[]: "aca_scenario_book3_justc_desc"
	val[]: "U ovom scenariju, moraćemo da nastavimo tamo gde je neko drugi stao."

#### justc goal

