#### 3_04 common
	key[]: "aca_scenario_book1_3_04_title"
	val[]: "Kurs napredne obuke - Prikolica"

	key[]: "aca_scenario_book1_3_04_desc"
	val[]: "U završnom scenariju 3 poglavlja, provozaćemo se dužom obukom sa raznim skretanjima da bismo videli koliko ste dobro naučili da manevrišete sa prikolicom."

#### 3_04 goal



	key[]: "aca_goal_book1_3_04_check1"
	val[]: "Easy Turns"

	key[]: "aca_goal_book1_3_04_check2"
