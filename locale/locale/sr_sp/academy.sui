	key[]: "aca_scenario_book3_diag_title"
	val[]: "Dijagonalno parkiranje sa B-duplim prikolicama"

	key[]: "aca_scenario_book3_diag_desc"
	val[]: "U ovom scenariju, parkiraćete svoju kombinaciju B-duplih prikolica na dijagonalnom parking mestu na prometnom parkingu. "

#### diag msg - intro text

	key[]: "aca_msg_book3_diag_cutscene1"
	val[]: "Dijagonalna parking mesta poput ovog su veoma česta. Posebno su česta na starijim parking staništima za kamione, kao i na mnogim odmorištima duž američkih međudržavnih puteva."

	key[]: "aca_msg_book3_diag_cutscene2"
	val[]: "Vozite prema naznačenom parking mestu blizu kraja reda."

	key[]: "aca_msg_book3_diag_cutscene3"
	val[]: "Držite se spoljašnje strane trake, ali nemojte biti preblizu uz barijere jer zadnji deo prikolice može da ih udari tokom skretanja."

	key[]: "aca_msg_book3_diag_cutscene4"
	val[]: "Prođite pored parking mesta kako biste napravili prostor za obe prikolice da vas prate. Zatim se zaronite prema suprotnoj strani mesta da biste doveli prvu prikolicu na poziciju."

	key[]: "aca_msg_book3_diag_cutscene5"
	val[]: "Ispravite se, zatim se zaustavite na određenom mestu i obezbedite kamion."

#### diag Driving Instructions

#!{
	key[]: "aca_msg_book3_diag_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_diag_forward"
	val[]: "Nastavite prema kraju reda i pronađite svoje parking mesto."

	key[]: "aca_msg_book3_diag_check1"
	val[]: "Prođite pored parking mesta kako biste bili sigurni da će se vaša zadnja prikolica pravilno parkirati na to mesto, a zatim skrenite, oštro vodeći računa da prednji deo vaše vodeće prikolice ne dodirne kamion pored vas."

	key[]: "aca_msg_book3_diag_stop"
	val[]: "Nastavite polako dok ispravljate kombinaciju, a zatim se zaustavite u određenom području."

#!{
	key[]: "aca_msg_book3_diag_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


