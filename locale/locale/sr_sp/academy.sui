#### 3_11 msg - intro text

	key[]: "aca_msg_book3_3_11_cutscene1"
	val[]: "Kružni tok je malo komplikovaniji za savladavanje sa B-duplim prikolicama nego sa jednom prikolicom."

	key[]: "aca_msg_book3_3_11_cutscene2"
	val[]: "Morate se voziti dovoljno daleko da obe prikolice mogu uspešno ući, ali onda morate voziti spolja kako biste držali prikolice dalje od centra."

	key[]: "aca_msg_book3_3_11_cutscene3"
	val[]: "U redu je ako obe prikolice ne stanu u jednu traku - u stvari, možda je čak i bolje da se proširite na obe trake kako vas optimističan motorista ne bi pokušao prestići."

	key[]: "aca_msg_book3_3_11_cutscene4"
	val[]: "Vozite do druge strane izlazne trake kako biste se ponovo uverili da su obe prikolice van opasnosti od potencijalnih sudara."

	key[]: "aca_msg_book3_3_11_cutscene5"
	val[]: "Nastavite do drugog kružnog toka."

	key[]: "aca_msg_book3_3_11_cutscene6"
	val[]: "Ovaj kružni tok ima samo jednu traku, zato ne žurite i budite precizni."

	key[]: "aca_msg_book3_3_11_cutscene7"
	val[]: "Iskoristite sav raspoloživi prostor - skraćivanje ovde će samo otežati stvari."

	key[]: "aca_msg_book3_3_11_cutscene8"
	val[]: "Izađite na izlazu i nastavite ka parking mestu."

	key[]: "aca_msg_book3_3_11_cutscene9"
	val[]: "Parkirajte i obezbedite kamion."

#### 3_11 infinite Fun Driving Instructions

#!{
	key[]: "aca_msg_book3_3_11_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_3_11_forward"
	val[]: "Nalazite se na kursu koji je osmišljen da vas upozna sa prolaskom kroz kružne tokove. Nastavite dalje kada budete spremni."

	key[]: "aca_msg_book3_3_11_check1"
	val[]: "Uđite dobro u kružni tok pre nego što krenete ka spoljnim čunjevima kako biste osigurali bezbedan ulazak obe prikolice."

	key[]: "aca_msg_book3_3_11_check2"
	val[]: "Poželećete da vozite do druge strane izlaza kako biste sprečili da vaše prikolice udare u čunjeve. <br><br>Možda bi bilo korisno da skrenete ka centru kružnog toka neposredno pre izlaska iz njega."

#!{
	key[]: "aca_msg_book3_3_11_check3"
	val[]: "@@aca_msg_book3_sup_check1@@"
#!}
	key[]: "aca_msg_book3_3_11_check4"
	val[]: "Trebalo bi da budete u stanju da ovo sami rešite, da odvojite vreme i mudro iskoristite svoj prostor."

	key[]: "aca_msg_book3_3_11_check5"
	val[]: "Pažljivo izlazite iz kružnog toka."

#!{
	key[]: "aca_msg_book3_3_11_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_3_11_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


