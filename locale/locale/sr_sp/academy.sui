#+ Book 1 Scenario 3_03
#@{

#### 3_03 common
	key[]: "aca_scenario_book1_3_03_title"
	val[]: "Vožnja na putu poligona"

	key[]: "aca_scenario_book1_3_03_desc"
	val[]: "U ovom scenariju, istražićemo manevrisanje prikolicom kroz kratku, ali složenu stazu sa preprekama."

#### 3_03 goal
#!{
	key[]: "aca_goal_book1_3_03_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

