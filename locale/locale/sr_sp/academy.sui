	val[]: "@@aca_goal_book1_3_02_forward@@"
 #!}

#### 3_12 msg - intro text

	key[]: "aca_msg_book1_3_12_cutscene01"
	val[]: "U ovom scenariju, preći ćemo na to kako da se skrene u tesnom prostoru.<br>Nećete uvek imati puno prostora za manevrisanje kamionom i moraćete da se prilagodite ne idealnim situacijama."

	key[]: "aca_msg_book1_3_12_cutscene02"
	val[]: "Vozite se kroz uličicu prema otvorenom prostoru."

	key[]: "aca_msg_book1_3_12_cutscene03"
	val[]: "Na levoj strani je još jedna uličica u koju morate skrenuti. Postavite se kako god želite imajući ovo na umu.<br>Možda će biti od pomoći da pokušate da prikolica bude usmerena ka uličici pre nego što krenete unazad."

	key[]: "aca_msg_book1_3_12_cutscene04"
	val[]: "Vozite nazad prema uličici. Pazite da držite na oku sve strane tegljača i prikolice."

	key[]: "aca_msg_book1_3_12_cutscene05"
	val[]: "U uličici postoje prepreke, pa se držite prema vozačevoj strani."

	key[]: "aca_msg_book1_3_12_cutscene06"
	val[]: "Kada završite sa kretanjem unazad, možete nastaviti napred i vratiti se u pravcu iz kojeg ste došli."

	key[]: "aca_msg_book1_3_12_cutscene07"
	val[]: "Možda ćete imati poteškoća da vidite svoju prikolicu u suvozačevom retrovizoru dok izlazite, pa iskoristite sav raspoloživi prostor u svoju korist."

	key[]: "aca_msg_book1_3_12_cutscene08"
	val[]: "Nastavite da vozite prema izlazu."

	key[]: "aca_msg_book1_3_12_cutscene09"
	val[]: "Park in the designated area and secure the truck."
#!{
	key[]: "aca_msg_book1_3_12_cutscene10"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_12_cutscene11"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_12_cutscene12"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_12_cutscene13"
	val[]: "Unused"
#!}
#### 3_12 Driving Instructions

	key[]: "aca_msg_book1_3_12_start"
	val[]: "Pred vama je oblast koja predstavlja parcelu brodarske kompanije. Vaš zadatak je da uđete i okrenete kamion da se vrati. Obavezno dobro iskoristite prostor oko sebe.<br><br><font face=/font/big_bold.font>Pripremite se za polazak </font>"

	key[]: "aca_msg_book1_3_12_forward"
	val[]: "<font face=/font/big_bold.font>Nastavite kroz uličicu. </font>"

	key[]: "aca_msg_book1_3_12_check1"
	val[]: "Odmah pored zgrade sa leve strane, nalazi se još jedna uličica u koju morate skrenuti. Postavite sebi ovo na umu.<br><br><font face=/font/big_bold.font>Nastavite prema barijerama. </font>"



	key[]: "aca_msg_book1_3_12_check3"
	val[]: "Vozite unazad i skrenite prikolicu prema uličici, pazeći da tegljačem ne udarite ništa sa desne strane.<br><br><font face=/font/big_bold.font>Započnite vožnju unazad i skrenite prikolicu u uličicu. Zaustavite se u označenom području. </font>"

	key[]: "aca_msg_book1_3_12_check4"
	val[]: "Sada možete da nastavite iz oblasti u istom pravcu iz kojeg ste došli. Dobro iskoristite prostor koji vam je na raspolaganju.<br><br><font face=/font/big_bold.font>Vozite napred i skrenite desno. </font>"


	key[]: "aca_msg_book1_3_12_check6"
	val[]: "Nastavite niz uličicu prema označenom području."
#!{
	key[]: "aca_msg_book1_3_12_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_12_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_12_check5"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_12_check2"
	val[]: "Unused"
#!}

#@}

#+ Book 1 Scenario 3_13
#@{

#### 3_13 common
	key[]: "aca_scenario_book1_3_13_title"
	val[]: "Ofsetni manevar unazad"

	key[]: "aca_scenario_book1_3_13_desc"
	val[]: "U ovom scenariju, imaćete zadatak da se vratite na parking mesto koje nije direktno iza vas. Postoji ograničen prostor za manevrisanje, tako da morate mudro koristiti svoj prostor."

#### 3_13 goal

#!{
	key[]: "aca_goal_book1_3_13_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_13_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_13_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_13_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

#!}

#### 3_13 msg - intro text

	key[]: "aca_msg_book1_3_13_cutscene01"
	val[]: "U ovom scenariju, vaš zadatak će biti da parkirate u prostoru koji se nalazi pored vas. Nema mnogo prostora za manevrisanje, tako da ćete morati da uradite malo dodatnog posla da biste dovezli prikolicu tamo gde želite."

	key[]: "aca_msg_book1_3_13_cutscene02"
	val[]: "Vozite pravo do barijere."

	key[]: "aca_msg_book1_3_13_cutscene03"
	val[]: "Stanite pre barijere."

	key[]: "aca_msg_book1_3_13_cutscene04"
	val[]: "Okrenite volan oštro na stranu vozača pre nego što krenete. Na ovaj način ćete početi da okrećete prikolicu ka parking mestu čim počnete da se krećete unazad, štedeći dragoceni prostor."

	key[]: "aca_msg_book1_3_13_cutscene05"
	val[]: "Kada usmerite prikolicu tamo gde želite, postavite tegljač ispred prikolice i počnite da je upravljate na parking mesto."

	key[]: "aca_msg_book1_3_13_cutscene06"
	val[]: "Od ovog trenutka pa nadalje, ne razlikuje se toliko od običnog manevara parkiranja."

	key[]: "aca_msg_book1_3_13_cutscene07"
	val[]: "Zadržite vožnju unazad i posmatrajte obe strane. Držite tegljač i prikolicu u liniji sa parking mestom."

	key[]: "aca_msg_book1_3_13_cutscene08"
	val[]: "Zaustavite se na predviđenom mestu, obezbedite kamion, i ugasite motor."


#### 3_13 Driving Instructions

	key[]: "aca_msg_book1_3_13_start"
	val[]: "Nalazite se na parking mestu, ali sa vaše desne strane postoji drugo parking mesto na koje morate da se pomerite.<br><br><font face=/font/big_bold.font>Pripremite se za polazak. </font>"

	key[]: "aca_msg_book1_3_13_forward"
	val[]: "Ispred vas je obeleženo područje.<br><br><font face=/font/big_bold.font>Vozite napred. </font>"
#!{
	key[]: "aca_msg_book1_3_13_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

	key[]: "aca_msg_book1_3_13_check2"
	val[]: "Ne zaboravite da odmah počnete da upravljate, jer nema mnogo prostora.<br><br><font face=/font/big_bold.font>Vozite unazad do označenog mesta iza vas. </font>"


#@}

#+ Book 1 Scenario 3_15
#@{

#### 3_15 common
	key[]: "aca_scenario_book1_3_15_title"
	val[]: "Jug handle i buton hok skretanja"

	key[]: "aca_scenario_book1_3_15_desc"
	val[]: "U ovom scenariju, proći ćete kratku vožnju kroz kurs obuke koji će vam pomoći da naučite da manevrirate prikolicom oko tesnih uglova uz pomoć dve različite procedure za skretanje."

#### 3_15 goal
#!{
	key[]: "aca_goal_book1_3_15_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_15_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_15_check6"
	val[]: "@@aca_goal_book1_3_11_check6@@"

	key[]: "aca_goal_book1_3_15_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_15_end"
	val[]: "@@aca_goal_book1_2_01_end@@"


 #!}
	key[]: "aca_goal_book1_3_15_check1"
	val[]: "Jug handle skretanje"

	key[]: "aca_goal_book1_3_15_check2"
	val[]: "Krivina i pravi sektor"

	key[]: "aca_goal_book1_3_15_check3"
	val[]: "Buton hok skretanje"

	key[]: "aca_goal_book1_3_15_check4"
	val[]: "Pravi sektor i krivina"

	key[]: "aca_goal_book1_3_15_check5"
	val[]: "Kombinacija skretanja"



#### 3_15 msg - intro text

	key[]: "aca_msg_book1_3_15_cutscene01"
	val[]: "Pred vama su tesna skretanja sa malo prostora.<br>Ovo će vam pomoći da naučite da efikasno upravljate prikolicom."

	key[]: "aca_msg_book1_3_15_cutscene02"
	val[]: "@@aca_msg_book1_3_15_cutscene02_img@@<br>Prvo skretanje zahteva manevar „jug handle“. Ovaj termin se primenjuje na skretanja gde imate ograničen prostor na putu na koji skrećete i umesto toga morate da iskoristite dodatni prostor na putu na kom se trenutno nalazite."

	key[]: "aca_msg_book1_3_15_cutscene03"
	val[]: "Pratite oznake trake da biste zamahnuli tegljač daleko od unutrašnjeg ivičnjaka.<br>Ovo će odvesti vašu prikolicu od ivičnjaka tako da imate dovoljno prostora za manevrisanje."

	key[]: "aca_msg_book1_3_15_cutscene04"
	val[]: "Držite se blizu prepreke dok izlazite iz skretanja tako da prikolica nastavi da prati najširi mogući luk."

	key[]: "aca_msg_book1_3_15_cutscene05"
	val[]: "Dok ulazite u dugu krivinu, tegljač morate držati prema sredini puta kako biste držali točkove prikolice dalje od ivičnjaka."

	key[]: "aca_msg_book1_3_15_cutscene06"
	val[]: "Nastavite duž puta."

	key[]: "aca_msg_book1_3_15_cutscene07"
	val[]: "@@aca_msg_book1_3_15_cutscene07_img@@<br>Sledeće skretanje zahteva upotrebu manevra „buton hok“. Ovo je poželjna tehnika, jer ne otvara traku iza vas da bi se nepažljivi vozač prišunjao sa desne strane. Uvek ga koristite kada imate dovoljno prostora na putu na koji skrećete."

	key[]: "aca_msg_book1_3_15_cutscene08"
	val[]: "Vozite duboko u raskrsnicu i brzo skrenite oštro udesno."

	key[]: "aca_msg_book1_3_15_cutscene09"
	val[]: "Kada naiđete pored prepreke, možete se ispraviti i ponovo držati prema levoj strani svoje trake.<br>Sve ovo služi da se točkovi prikolice drže dalje od ivičnjaka."

	key[]: "aca_msg_book1_3_15_cutscene10"
	val[]: "Nastavite ka sledećoj krivini."

	key[]: "aca_msg_book1_3_15_cutscene11"
	val[]: "Još jednom, držite se sredine puta kako biste držali točkove prikolice dalje od ivičnjaka."

	key[]: "aca_msg_book1_3_15_cutscene12"
	val[]: "Ugao ispred je posebno problematičan. U ovakvim slučajevima nećete imati idealne uslove ni za skretanje jug handle ni za okretanje buton hok i morate kombinovati oba manevra zajedno da biste stigli tamo gde treba da idete."

	key[]: "aca_msg_book1_3_15_cutscene13"
	val[]: "Zamahnite široko pre skretanja, uđite duboko u raskrsnicu i brzo skrenite. Još jednom, idealno je da ostanete što bliže prepreci da bi skretanje bilo što šire."

	key[]: "aca_msg_book1_3_15_cutscene14"
	val[]: "Park in the designated area, secure the truck and shut down the engine."

	# Book 1 Scenario 3_15 formatting
#!{
	key[]: "aca_msg_book1_3_15_cutscene02_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/jug_handle.mat bottom=p256 right=p256 color=FFFFFFFF></align><offset vshift=256>"

	key[]: "aca_msg_book1_3_15_cutscene07_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/button_hook.mat bottom=p256 right=p256 color=FFFFFFFF></align><offset vshift=256>"

#!}


#### 3_15 Driving Instructions

	key[]: "aca_msg_book1_3_15_forward"
	val[]: "Ne zaboravite da koristite sav prostor koji vam je na raspolaganju da vam pomogne da pregovarate o svakom skretanju.<br><br><font face=/font/big_bold.font>Krenite i pratite oznake na putu levo. </font>"

	key[]: "aca_msg_book1_3_15_check1"
	val[]: "Iskoristite sav dostupni prostor da se zamahnete i držite prikolicu dalje od unutrašnjeg ivičnjaka.<br><br><font face=/font/big_bold.font>Napravite jug handle skretanje. </font>"

	key[]: "aca_msg_book1_3_15_check2"
	val[]: "Držite se prema sredini puta oko krivine, a zatim nastavite pravo ka sledećem skretanju.<br><br><font face=/font/big_bold.font>Nastavite vožnju. </font>"

	key[]: "aca_msg_book1_3_15_check3"
	val[]: "Ograničeno je prostora sa leve strane, tako da morate da vozite daleko do raskrsnice da biste sklonili prikolicu sa ivičnjaka.<br><br><font face=/font/big_bold.font>Napravite buton hok skretanje. </font>"

	key[]: "aca_msg_book1_3_15_check4"
	val[]: "Vozite napred do i oko sledeće krivine.<br><br><font face=/font/big_bold.font>Nastavite vožnju. </font>"

	key[]: "aca_msg_book1_3_15_check5"
	val[]: "Ovo skretanje je najteži do sada i nijedan manevar sam po sebi neće biti dovoljan.<br><br><font face=/font/big_bold.font>Napravite skretanje, držite što je moguće šire.</font>"

	key[]: "aca_msg_book1_3_15_check6"
	val[]: "<font face=/font/big_bold.font>Nastavite do parking mesta napred i desno. </font>"
#!{
	key[]: "aca_msg_book1_3_15_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_15_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_15_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}


#@}

#+ Book 1 Scenario 3_16
#@{

#### 3_16 common
	key[]: "aca_scenario_book1_3_16_title"
	val[]: "Dijagonalno parkiranje u vožnji unazad"

	key[]: "aca_scenario_book1_3_16_desc"
	val[]: "U ovom scenariju, istražićemo parkiranje dijagonalno pri kretanju unazad. Ovo se može desiti na odmorištima, stajalištima kamiona, pa čak i kod pošiljalaca. Često je malo prostora jer su parcele krcate kamionima, pa je parkiranje utoliko teže zbog nedostatka prostora."

#### 3_16 goal

	key[]: "aca_goal_book1_3_16_check1"
	val[]: "Okretanje prikolice"
#!{
	key[]: "aca_goal_book1_3_16_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_16_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_16_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_16_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
 #!}
#### 3_16 msg - intro text

	key[]: "aca_msg_book1_3_16_cutscene1"
	val[]: "Dijagonalno parkiranje na prvi pogled izgleda lakše, ali često može biti izazovnije od tipičnih manevara za „parkiranje u uličici“."

	key[]: "aca_msg_book1_3_16_cutscene2"
	val[]: "Vozite unazad prema parking mestu. Za sada držite tegljač i prikolicu ravno."

	key[]: "aca_msg_book1_3_16_cutscene3"
	val[]: "Dok se približavate, pustite prikolicu da se približi parkiranim kamionima. Ovo će vam pomoći skrenete u mesto kada stignete do njega."

	key[]: "aca_msg_book1_3_16_cutscene4"
	val[]: "Počnite da okrećete prikolicu u parking mestu. Držite prikolicu blizu kamiona na strani vozača, jer će vam trebati prostor na drugoj strani."

	key[]: "aca_msg_book1_3_16_cutscene5"
	val[]: "Kada je prikolica dobro na mestu za parkiranje, počnite da okrećete tegljač kako biste pratili prikolicu."

	key[]: "aca_msg_book1_3_16_cutscene6"
	val[]: "Parkirajte na za to predviđenom mestu, obezbedite kamion i ugasite motor."

#### 3_16 Driving Instructions

	key[]: "aca_msg_book1_3_16_start"
	val[]: "Parkirajte kamion u prostor iza vas. Koristite oba vaša retrovizora za navigaciju u vašoj vožnji unazad.<br><br><font face=/font/big_bold.font>Pripremite se da krenete. </font>"

	key[]: "aca_msg_book1_3_16_backward"
	val[]: "Proverite svoje okruženje, a zatim idite ka parking mestu.<br><br><font face=/font/big_bold.font>Počnite vožnju unazad.</font>"

	key[]: "aca_msg_book1_3_16_check1"
	val[]: "Počnite da pomerate prikolicu prema kamionima pored vas. Kada budete spremni, okrenite prikolicu na parking mesto. Ne zaboravite da uzmete u obzir zamah repa prikolice.<br><br><font face=/font/big_bold.font>Skrenite na parking mesto. </font>"
#!{
	key[]: "aca_msg_book1_3_16_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_16_end"
	val[]: "@@aca_msg_book1_2_01_end@@"


 #!}


#@}

#+ Book 1 Scenario 3_17
#@{

#### 3_17 common
	key[]: "aca_scenario_book1_3_17_title"
	val[]: "Vozite unazad u skretanju"

	key[]: "aca_scenario_book1_3_17_desc"
	val[]: "U ovom scenariju, prvi put ćemo se kretati unazad sa prikolicom u skretanje. Istražićemo osnovne principe vožnje unazad i na šta treba obratiti pažnju kada se skreće unazad."

#### 3_17 goal

	key[]: "aca_goal_book1_3_17_check1"
	val[]: "Okretanje prikolice"
#!{
	key[]: "aca_goal_book1_3_17_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_17_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_17_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_17_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
 #!}
#### 3_17 msg - intro text

	key[]: "aca_msg_book1_3_17_cutscene01"
	val[]: "U ovom scenariju, moraćete da se vratite unazad do parking mesta koje je iza vas na strani vašeg vozača."

	key[]: "aca_msg_book1_3_17_cutscene02"
	val[]: "Treba zapamtiti nekoliko saveta koji će vam mnogo pomoći vožnjom sa prikolicama unazad. <br>Prvi je taj što će prikolica uvek želeti da se okrene u suprotnom smeru od načina na koji upravljate tegljačem."

	key[]: "aca_msg_book1_3_17_cutscene03"
	val[]: "Drugi je da možete dobiti dobar osećaj kuda se prikolica kreće posmatrajući osovine kamiona i prikolice."

	key[]: "aca_msg_book1_3_17_cutscene04"
	val[]: "Treće, mali unosi će vas odvesti tamo gde treba da idete, bez potrebe da se previše opterećujete."

	key[]: "aca_msg_book1_3_17_cutscene05"
	val[]: "Počnite lagano da okrećete tegljač od parking mesta, a prikolica će početi da pokazuje ka njemu."

	key[]: "aca_msg_book1_3_17_cutscene06"
	val[]: "Pratite prikolicu, prilagođavajući se dok idete da biste je držali na pravom putu."

	key[]: "aca_msg_book1_3_17_cutscene07"
	val[]: "Gledajte svoje točkove prikolice i zadnji točak tegljača. Oni će vam reći gde je prikolica usmerena, a gde tegljač gura."

	key[]: "aca_msg_book1_3_17_cutscene08"
	val[]: "Četvrti savet je da je uvek lakše okrenuti prikolicu oštrije nego pokušati da je ispravite nožem. Ciljajte ka spoljašnjoj strani mesta dok joj se ne približite, a zatim možete da skrenete malo oštrije da poravnate svoju prikolicu."

	key[]: "aca_msg_book1_3_17_cutscene09"
	val[]: "Dok prikolica ulazi na parking mesto, stavite tegljač ispred prikolice. Pokušajte da izbegnete previše podešavanja unutar mesta."

	key[]: "aca_msg_book1_3_17_cutscene10"
	val[]: "Vozite između barijera unazad, proverite obe strane dok idete."

	key[]: "aca_msg_book1_3_17_cutscene11"
	val[]: "Obezbedite kamion i ugasite motor."

#### 3_17 Driving Instructions

	key[]: "aca_msg_book1_3_17_start"
	val[]: "Zapamtite ove savete kada prelazite u vožnju unazad sa prikolicom:<br><br>— Prikolica se okreće suprotno od načina na koji upravljate tegljačem<br><br>— Gledajte točkove prikolice da vidite kuda cilja<br><br>— Gledajte zadnji točak tegljača da vidite gde gura prikolicu<br><br>— Pustite prikolicu da odradi posao, nemojte je preupravljati<br><br>— Uvek je lakše okrenuti prikolicu oštrije nego je ispraviti<br><br><font face=/font/big_bold.font>Pripremite se da krenete. </font>"

	key[]: "aca_msg_book1_3_17_backward"
	val[]: "Pogledajte iza sebe da biste pronašli gde treba da idete. Uvek proverite svoje okruženje pre nego što počnete da vozite unazad.<br><br><font face=/font/big_bold.font>Počnite da vozite unazad ka parking mestu.</font>"

	key[]: "aca_msg_book1_3_17_check1"
	val[]: "<font face=/font/big_bold.font>Počnite da okrećete prikolicu ka parking mestu i pratite je.</font>"

	key[]: "aca_msg_book1_3_17_stop"
	val[]: "<font face=/font/big_bold.font>Zaustavite se u označeno mesto. </font>"
#!{
	key[]: "aca_msg_book1_3_17_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_18
#@{

#### 3_18 common
	key[]: "aca_scenario_book1_3_18_title"
	val[]: "Manevar parkiranja u uličici"

	key[]: "aca_scenario_book1_3_18_desc"
	val[]: "U ovom scenariju, imaćete zadatak da vozite unazad prikolicu u uličicu sa malog puta."

#### 3_18 goal

	key[]: "aca_goal_book1_3_18_check1"
	val[]: "Okretanje prikolice"
#!{
	key[]: "aca_goal_book1_3_18_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_18_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


	key[]: "aca_goal_book1_3_18_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_18_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

 #!}
#### 3_18 msg - intro text

	key[]: "aca_msg_book1_3_18_cutscene01"
	val[]: "Parkiranje ovde zahteva manevar „parkiranje u uličici“.<br>Ovo je tipičan manevar parkiranja za kamiondžije, jer će se sa ovakvom situacijom parkiranja susresti skoro svakodnevno u svojoj karijeri, bilo da se radi o utovaru ili istovaru prikolice ili parkiranju preko noći na stajalištu za kamione."

	key[]: "aca_msg_book1_3_18_cutscene02"
	val[]: "Ovo je sličan manevar prethodnom scenariju, ali ćete imati manje prostora za rad, tako da ćete morati da planirate svoje poteze u skladu sa tim i pazite da ništa ne udarite."

	key[]: "aca_msg_book1_3_18_cutscene03"
	val[]: "Pošto ima manje prostora, vaš tajming je važniji. Okrenite prikolicu u pravo vreme i posmatrajte tegljač i točkove prikolice da vidite kuda će ići. Imajte na umu zamah repa i zapamtite da ne udarate nožem - nastavite da gurate prikolicu."

	key[]: "aca_msg_book1_3_18_cutscene04"
	val[]: "Pokušajte da usmerite prikolicu prema uličici ranije nego kasnije. Ovo će vam dati prostor na drugoj strani da okrenete prednji deo prikolice i da stavite tegljač ispred njega."

	key[]: "aca_msg_book1_3_18_cutscene05"
	val[]: "Kada je vaša prikolica u uličici, stavite tegljač ispred nje. Bolje je to učiniti malo ranije nego što bi vas instinkt u početku mogao navesti. Uvek ga možete ispraviti kao naličje na svoju konačnu poziciju."

	key[]: "aca_msg_book1_3_18_cutscene06"
	val[]: "Ispravite tegljač i prikolicu i zaustavite se na predviđenom mestu."

	key[]: "aca_msg_book1_3_18_cutscene07"
	val[]: "Obezbedite kamion i ugasite motor."


#### 3_18 Driving Instructions

	key[]: "aca_msg_book1_3_18_start"
	val[]: "Sada ćemo pokušati da okrenemo prikolicu na mnogo manjoj površini sa manevrom „parkiranje u ulici“. <br><br><font face=/font/big_bold.font>Pripremite se za polazak. </font>"

	key[]: "aca_msg_book1_3_18_backward"
	val[]: "Proverite svoju okolinu i potražite mesto za parkiranje iza sebe. <br><br><font face=/font/big_bold.font>Počnite da vozite unazad ka parking mestu. </font>"

	key[]: "aca_msg_book1_3_18_check1"
	val[]: "<font face=/font/big_bold.font>Okrenite prikolicu na parking mesto. </font>"
#!{
	key[]: "aca_msg_book1_3_18_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_18_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}


#@}

#+ Book 1 Scenario 3_19
#@{

#### 3_19 common
	key[]: "aca_scenario_book1_3_19_title"
	val[]: "Završni ispit (1. deo)"

	key[]: "aca_scenario_book1_3_19_desc"
	val[]: "Očekuje vas završni ispit, gde će sve veštine koje ste naučili iz prethodnih scenarija biti stavljene na probu. Provozaćemo se po celom centru za obuku da vidimo koliko ste dobro naučili situacije sa kojima ste se do sada susretali.<br><br>Kada završite sve deonice i manevre, bićete korak bliže tome da sebe nazovete veštim kamiondžijem!"

