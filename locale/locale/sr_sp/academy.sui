#### 2_06 msg - intro text

	key[]: "aca_msg_book1_2_06_cutscene01"
	val[]: "Za konačni scenario ovog poglavlja, vozićemo se na probnoj stazi sa složenom konfiguracijom."

	key[]: "aca_msg_book1_2_06_cutscene02"
	val[]: "Prva prepreka je slalom kroz neke barijere. Vozite se kroz njih i ne zaboravite da koristite svoje retrovizore."

	key[]: "aca_msg_book1_2_06_cutscene04"
	val[]: "Sledeće je okretanje ukosnice. Držite skretanje širokim i ne bi trebalo da vam predstavlja probleme."

	key[]: "aca_msg_book1_2_06_cutscene05"
	val[]: "Put ispred se značajno sužava. Nastavite oprezno i koristite bočni retrovizor da vam pomogne."

	key[]: "aca_msg_book1_2_06_cutscene06"
	val[]: "Sledi niz lakih skretanja od 90°."

	key[]: "aca_msg_book1_2_06_cutscene08"
	val[]: "Sledeći odeljak mora da se uradi obrnuto. Imajući to na umu, pristupite barijerama ispred vas."

	key[]: "aca_msg_book1_2_06_cutscene09"
	val[]: "Pratite oznake puta nazad i oko krivina."

	key[]: "aca_msg_book1_2_06_cutscene10"
	val[]: "Vratite se unazad do barijera, zatim se zaustavite i nastavite napred udesno."

	key[]: "aca_msg_book1_2_06_cutscene11"
	val[]: "This passage through the cones is very narrow. Drive slowly and use your mirrors to orient yourself within the passage."

	key[]: "aca_msg_book1_2_06_cutscene13"
	val[]: "Napred je niz naizmeničnih skretanja levo i desno za 90°."

	key[]: "aca_msg_book1_2_06_cutscene15"
	val[]: "Možete naići na vozove na ovom pružnom prelazu. Ako jeste, zaustavite se i sačekajte. Nakon toga možete skrenuti desno na servisni put."

	key[]: "aca_msg_book1_2_06_cutscene16"
	val[]: "Skrenite levo na kolovoz. Možete povećati brzinu nakon što završite skretanje."

	key[]: "aca_msg_book1_2_06_cutscene18"
	val[]: "Još nekoliko skretanja ulevo u gradu i bićete na svom odredištu!"

	key[]: "aca_msg_book1_2_06_cutscene19"
	val[]: "Približite se preprekama ispred i pripremite se da parkirate na parking mestu sa desne strane."

	key[]: "aca_msg_book1_2_06_cutscene20"
	val[]: "Vozite unazad do parking mesta, zatim ugasite motor i obezbedite kamion."

#### 2_06 Driving Instructions



	key[]: "aca_msg_book1_2_06_forward"
	val[]: "Pred vama je slalom napravljen od barijera.<br><br><font face=/font/big_bold.font>Vozite kroz slalom.</font>"

	key[]: "aca_msg_book1_2_06_forward2"
	val[]: "<font face=/font/big_bold.font>Pratite putanju oko skretanja za ukosnicu. </font>"

	key[]: "aca_msg_book1_2_06_check1"
	val[]: "Put ispred se značajno sužava. Možete koristiti bočni retrovizor da biste se lakše orijentisali.<br><br><font face=/font/big_bold.font>Nastavite oprezno. </font>"

	key[]: "aca_msg_book1_2_06_check2"
	val[]: "Posle krivine je skretanje od 90°.<br><br><font face=/font/big_bold.font>Podesite svoju brzinu u skladu sa tim.</font>"

	key[]: "aca_msg_book1_2_06_check3"
	val[]: "Pred vama je još nekoliko lakih skretanja, nastavite da prilagođavate brzinu po potrebi.<br><br><font face=/font/big_bold.font>Nastavite vožnju. </font>"

	key[]: "aca_msg_book1_2_06_check4"
	val[]: "The following section must be completed in reverse. Stop at the barriers ahead so that you can reverse to the right afterwards.<br><br><font face=/font/big_bold.font>Stop at the barriers.</font>"

	key[]: "aca_msg_book1_2_06_check5"
	val[]: "Okrenite se unazad prema području iza vas i udesno.<br><br><font face=/font/big_bold.font>Počnite da vozite unazad. </font>"

	key[]: "aca_msg_book1_2_06_reverse"
	val[]: "Pratite put oko skretanja.<br><br><font face=/font/big_bold.font>Zadržite vožnju unazad.</font>"

	key[]: "aca_msg_book1_2_06_check6"
	val[]: "Iza vas levo su neke barijere. <br><br><font face=/font/big_bold.font>Okrenite se prema barijerama i budite spremni da se zaustavite.</font>"

	key[]: "aca_msg_book1_2_06_check7"
	val[]: "Zaustavite se i promenite brzinu za napred, a zatim nastavite desno. <br><br><font face=/font/big_bold.font>Vozite napred. </font>"

	key[]: "aca_msg_book1_2_06_check8"
	val[]: "In front of you is a narrow winding path through some cones. Drive carefully and use your mirrors if necessary.<br><br><font face=/font/big_bold.font>Drive through the cones. </font>"

	key[]: "aca_msg_book1_2_06_check9"
	val[]: "Slede kombinacije različitih skretanja od 90°. Obavezno pristupite svakom skretanju sa širokim ležajem.<br><br><font face=/font/big_bold.font>Nastavite vožnju. </font>"

	key[]: "aca_msg_book1_2_06_check10"
	val[]: "Posmatrajte pružni prelaz dok mu prilazite. Signali se mogu aktivirati kako bi ukazali na nadolazeći voz.Posmatrajte pružni prelaz dok mu prilazite. Signali se mogu aktivirati kako bi ukazali na nadolazeći voz.<br><br><font face=/font/big_bold.font>Postupite oprezno.</font>"

	key[]: "aca_msg_book1_2_06_check11"
	val[]: "Skretanje na servisni put je delimično blokiran preprekom, pa se držite leve strane dok prilazite da biste sebi dali više prostora.<br><br><font face=/font/big_bold.font>Napravi skretanje. </font>"

	key[]: "aca_msg_book1_2_06_check12"
	val[]: "Možete izabrati da poslušate ili ignorišete znak stop. Područje je zatvoreno za našu upotrebu.<br><br><font face=/font/big_bold.font>Skrenite levo.</font>"

	key[]: "aca_msg_book1_2_06_check13"
	val[]: "Ovde možete da ubrzate, ali ćete morati da skrenete na sledećoj raskrsnici.<br><br><font face=/font/big_bold.font>Nastavite duž kursa. </font>"

	key[]: "aca_msg_book1_2_06_check14"
	val[]: "Nastavite u grad sa skretanjem levo, nakon čega slede još dva skretanja ulevo do konačnog područja.<br><br><font face=/font/big_bold.font>Vozite kroz grad.</font>"

	key[]: "aca_msg_book1_2_06_check15"
	val[]: "Na suprotnoj strani parcele su neke barijere. Vozite do njih. <br><br><font face=/font/big_bold.font>Zaustavite se blizu barijera. </font>"

	key[]: "aca_msg_book1_2_06_check16"
	val[]: "Iza vas i sa desne strane nalazi se parking mesto.<br><br><font face=/font/big_bold.font><font face=/font/big_bold.font>Vozite unazad na parking mesto. </font>"
#!{
	key[]: "aca_msg_book1_2_06_check17"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_06_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_2_06_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

#@}

