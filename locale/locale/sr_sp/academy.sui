	key[]: "aca_goal_book1_2_08_check4"
	val[]: "Uska krivina"

	key[]: "aca_goal_book1_2_08_check6"
	val[]: "Tehnička sekcija"

	key[]: "aca_goal_book1_2_08_check7"
	val[]: "Otvori oblast"



#### 2_08 msg - intro text

	key[]: "aca_msg_book1_2_08_cutscene1"
	val[]: "U ovom scenariju, odvešćemo tegljač na kratku vožnju da vidimo kako se nosite sa njim sa svojim novostečenim veštinama.<br>Na stazi postoje razne vrste i kombinacije skretanja. Nije trka i nije vreme. Budite strpljivi i prilagodite brzinu vožnje skretanjima i preprekama na koje nailazite."

	key[]: "aca_msg_book1_2_08_cutscene2"
	val[]: "Uđite u stazu sa širokim skretanjem ukosnice."

	key[]: "aca_msg_book1_2_08_cutscene3"
	val[]: "Zatim ćete naići na niz prepreka koje vas vode u nepravilan slalom."

	key[]: "aca_msg_book1_2_08_cutscene4"
	val[]: "Nakon što završite nekoliko lakih skretanja od 90°, naići ćete na tesno okretanje ukosnice. Važno je da se pravilno postavite, kako da završite skretanje, tako i da glatko uđete u sledeći sektor."

	key[]: "aca_msg_book1_2_08_cutscene5"
	val[]: "Vodite računa o čunjevima dok vozite kroz dugu krivinu jer je vidljivost preko haube ograničena."

	key[]: "aca_msg_book1_2_08_cutscene6"
	val[]: "Još jedan set barijera će vas odvesti u široki slalom."

	key[]: "aca_msg_book1_2_08_cutscene7"
	val[]: "Staza se malo otvara, ali ne žurite. Još nekoliko lakih skretanja i gotovi ste."

	key[]: "aca_msg_book1_2_08_cutscene8"
	val[]: "Stop in the designated area and secure the truck."


#### 2_08 Driving Instructions

	key[]: "aca_msg_book1_2_08_start"
	val[]: "Da biste uspešno završili ovaj scenario, ne smete se sudariti, sleteti sa staze ili udariti u saobraćajne čunjeve.<br><br><font face=/font/big_bold.font>Pripremite se za polazak. </font>"

	key[]: "aca_msg_book1_2_08_forward"
	val[]:"<font face=/font/big_bold.font>Nastavite napred u široko skretanje za ukosnicu da uđete u stazu. </font>"

	key[]: "aca_msg_book1_2_08_check1"
	val[]: "<font face=/font/big_bold.font>Završite skretanje ukosnice. </font>"

	key[]: "aca_msg_book1_2_08_check2"
	val[]: "Približavate se barijerama raspoređenim otprilike u slalom.<br><br><font face=/font/big_bold.font>U skladu sa tim prilagodite brzinu i nastavite.</font>"

	key[]: "aca_msg_book1_2_08_check3"
	val[]: "Sledeće, imate dva laka okreta od 90° praćena tesnim skretanjem ukosnice. Polako.<br><br><font face=/font/big_bold.font>Nastavite do tesnog skretanja ukosnice.</font>"

	key[]: "aca_msg_book1_2_08_check4"
	val[]: "Izlazeći iz ukosnice, naići ćete na usku stazu kroz krivinu. Morate se kloniti unutrašnje barijere, ali pazite da ne udarite čunjeve ispred sebe.<br><br><font face=/font/big_bold.font>Nastavite kroz krivinu. </font>"

	key[]: "aca_msg_book1_2_08_check6"
	val[]: "Put ispred nas je tesan, tehnička skretanja. Podesite brzinu i pažljivo se krećete kroz deo.<br><br><font face=/font/big_bold.font>Nastavite vožnju. </font>"

	key[]: "aca_msg_book1_2_08_check7"
	val[]: "Sledeći sektor je otvoreniji sa nekim lakim skretanjima. Ne žuri.<br><br><font face=/font/big_bold.font>Nastavite vožnju. </font>"
#!{
	key[]: "aca_msg_book1_2_08_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_08_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

#@}

#+ Book 1 Scenario 2_09
#@{

#### 2_09 common
	key[]: "aca_scenario_book1_2_09_title"
	val[]: "Paralelno parkiranje"

	key[]: "aca_scenario_book1_2_09_desc"
	val[]: "U ovom scenariju, pogledaćemo paralelno parkiranje između dva druga kamiona."

#### 2_09 goal

	key[]: "aca_goal_book1_2_09_stopmid"
	val[]: "Zaustavljanje ispred parking mesta"

	key[]: "aca_goal_book1_2_09_checkmirror"
	val[]: "Provera pozadi pogled na retrovizor"

	key[]: "aca_goal_book1_2_09_backward"
	val[]: "Vožnjom unazad na parking mesto"

	key[]: "aca_goal_book1_2_09_stop"
	val[]: "Poravnavanje kamiona unutar parking mesta"

#!{
	key[]: "aca_goal_book1_2_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_09_check1"
	val[]: "@@aca_goal_book1_1_03_forward@@"


	key[]: "aca_goal_book1_2_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"



 #!}
#### 2_09 msg - intro text

	key[]: "aca_msg_book1_2_09_cutscene1"
	val[]: "Paralelno parkiranje je ključna veština koju treba da zna svaki kamiondžija.<br>Pripremite se za polazak."

	key[]: "aca_msg_book1_2_09_cutscene2"
	val[]: "Vozite ka parking mestu.<br>Obratite pažnju na okolinu."

	key[]: "aca_msg_book1_2_09_cutscene3"
	val[]: "Poravnajte se s kamionom ispred vašeg parking mesta. Nemojte mu biti previše blizu, držite se na malom odstojanju od njega da biste imali prostora za rad."

	key[]: "aca_msg_book1_2_09_cutscene4"
	val[]: "Okrenite oštro prema prostoru i počnite da vozite unazad."

	key[]: "aca_msg_book1_2_09_cutscene5"
	val[]: "Kada gledate u retrovizor sa strane vozača, ciljajte na ivičnjak odmah ispred kamiona iza vas."

	key[]: "aca_msg_book1_2_09_cutscene6"
	val[]: "Kada vaš prednji branik oslobodi kamion ispred vas, možete početi da upravljate prednjim krajem kamiona na mesto, poravnavajući kamion sa parking mestom."

	key[]: "aca_msg_book1_2_09_cutscene7"
	val[]: "Ispravite točak i centrirajte kamion u okviru parking mesta.<br>Parkirajte i obezbedite kamion."

#### 2_09 Driving Instructions

	key[]: "aca_msg_book1_2_09_start"
	val[]: "Ispred vas, su parkirani kamioni. Ostalo vam je jedno otvoreno mesto na kome možete da parkirate. <br><br><font face=/font/big_bold.font>Pripremite se za polazak. </font>"

	key[]: "aca_msg_book1_2_09_check1"
	val[]: "Zapamtite da budete svesni svog okruženja. Iskoristite dobro retrovizore tokom ovog manevra. <br><br><font face=/font/big_bold.font>Vozite napred. </font>"

	key[]: "aca_msg_book1_2_09_stopmid"
	val[]: "<color value=@@clr_white@@>Vozite pored parking mesta i uđite u obeleženo područje. Odatle možete započeti svoj manevar vožnjom unazad.<br><br><font face=/font/big_bold.font>Stanite na označenom mestu. </font>"

	key[]: "aca_msg_book1_2_09_checkmirror"
	val[]: "Proverite da li se u vašem okruženju nalaze prepreke i da se uverite da ste slobodni za vožnju unazad.<br><br><font face=/font/big_bold.font>Pogledajte kroz suvozačev retrovizor. </font>"

	key[]: "aca_msg_book1_2_09_backward"
	val[]: "Okrenite točkove i krenite unazad do parking mesta.<br><br><font face=/font/big_bold.font>Počnite da vozite unazad. </font>"

	key[]: "aca_msg_book1_2_09_stop"
	val[]: "Počnite da ispravljate kamion kada je to potrebno. Ne vozite preko ivičnjaka!<br><br><font face=/font/big_bold.font>Poravnajte kamion sa mestom. </font>"
#!{
	key[]: "aca_msg_book1_2_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_01
#@{

#### 3_01 common
	key[]: "aca_scenario_book1_3_01_title"
	val[]: "Povezivanje prikolice"

	key[]: "aca_scenario_book1_3_01_desc"
	val[]: "U ovom scenariju ćemo objasniti osnove povezivanja i odvajanja tegljača od prikolice."

#### 3_01 goal

	key[]: "aca_goal_book1_3_01_check_con"
	val[]: "Vozite unazad do prikolie"

	key[]: "aca_goal_book1_3_01_connect"
	val[]: "Povezivanje prikolice"

	key[]: "aca_goal_book1_3_01_park_br_off"
	val[]: "Otpuštanje parkirne kočnice"


	key[]: "aca_goal_book1_3_01_disc5"
	val[]: "Otkačivanje Prikolice"

	key[]: "aca_goal_book1_3_01_park_br_off2"
	val[]: "Otkačivanje Prikolice"

	key[]: "aca_goal_book1_3_01_disconnect"
	val[]: "Otkačivanje Prikolice"

	key[]: "aca_goal_book1_3_01_stop"
	val[]: "Zaustavljanje u određenoj zoni"
