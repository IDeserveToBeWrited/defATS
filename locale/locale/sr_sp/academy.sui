 #!}
	key[]: "aca_goal_book1_3_03_check1"
	val[]: "Prvo skretanje"

	key[]: "aca_goal_book1_3_03_check2"
	val[]: "Roundabout"

	key[]: "aca_goal_book1_3_03_check3"
	val[]: "Skretanje od 90°"

	key[]: "aca_goal_book1_3_03_check4"
	val[]: "Jug handle skretanje"

	key[]: "aca_goal_book1_3_03_check5"
	val[]: "Buton hok skretanje"

	key[]: "aca_goal_book1_3_03_check6"
	val[]: "Tight Turn"


#### generic phrase

	key[]: "aca_goal_book1_3_03_chk_point"
	val[]: "Vožnja oko barijera"

#### 3_03 msg - intro text

	key[]: "aca_msg_book1_3_03_cutscene01"
	val[]: "Ispred su razni složeni uglovi i prepreke.<br>Uzmite u obzir sve što ste do sada naučili i to ne bi trebalo da bude teško."

	key[]: "aca_msg_book1_3_03_cutscene02"
	val[]: "Prvi ugao je lako skretanje buton hok. Držite se široko i to ne bi trebalo da predstavlja problem."

	key[]: "aca_msg_book1_3_03_cutscene03"
	val[]: "Nastavite prema kružnom toku."

	key[]: "aca_msg_book1_3_03_cutscene04"
	val[]: "Držite prikolicu dalje od unutrašnjosti kružnog toka tako što ćete tegljač voziti što je moguće šire oko nje."

	key[]: "aca_msg_book1_3_03_cutscene05"
	val[]: "Skretanje od 90° ulevo nije posebno tesan, ali pazite da ne udarite ni u jedan čunj."

	key[]: "aca_msg_book1_3_03_cutscene06"
	val[]: "Ovo skretanje je znatno tesnije. Koristite manevar jug handle da biste ga dovršili."

	key[]: "aca_msg_book1_3_03_cutscene07"
	val[]: "U ovom skretanju možete koristiti manevar buton hok, ali postoje neke dodatne prepreke koje treba izbegavati."

	key[]: "aca_msg_book1_3_03_cutscene09"
	val[]: "Još jednom, poslednji zaokret je veoma tesan i biće potrebna kombinacija manevara jug handle i buton hok da završite."

	key[]: "aca_msg_book1_3_03_cutscene10"
	val[]: "Park in the designated area, secure the truck and shut down the engine."


#### 3_03 Driving Instructions



	key[]: "aca_msg_book1_3_03_forward"
	val[]: "<font face=/font/big_bold.font>Nastavite do prvog skretanja. </font>"

	key[]: "aca_msg_book1_3_03_check1"
	val[]: "Prvo ckretanje je jednostavno skretanje buton hok.<br><br><font face=/font/big_bold.font><color value=@@clr_txt@@>Nastavite kroz skretanje.</font>"

	key[]: "aca_msg_book1_3_03_check2"
	val[]: "Nastavite do kružnog toka. Ne zaboravite da ga obiđete širokim putem.<br><br><font face=/font/big_bold.font>Vozite do i oko kružnog toka.</font>"

	key[]: "aca_msg_book1_3_03_check3"
	val[]: "Ovo skretanje od 90° je malo tesnije, pazite da ne udarite u čunjeve.<br><br><font face=/font/big_bold.font>Napravi skretanje.</font>"

	key[]: "aca_msg_book1_3_03_check4"
	val[]: "Ovom skretanju je najbolje pristupiti postupkom jug handle. Zamahnite široko pre nego što uđete na raskrsnicu.<br><br><font face=/font/big_bold.font>Napravite jug handle skretanje. </font>"

	key[]: "aca_msg_book1_3_03_check5"
	val[]: "Ovo skretanje je prepuno nekoliko različitih prepreka, ali to se može uraditi manevrom buton hok.<br><br><font face=/font/big_bold.font>Nastavite pažljivo. </font>"

	key[]: "aca_msg_book1_3_03_check6"
	val[]: "Ovo skretanje je najteže do sada, pregovarajte o njemu kako vam odgovara.<br><br><font face=/font/big_bold.font>Skrenite na parking.</font>"
#!{
	key[]: "aca_msg_book1_3_03_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_03_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

#@}

#+ Book 1 Scenario 3_04
