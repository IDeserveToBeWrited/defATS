	key[]: "aca_goal_book1_3_06_check1"
	val[]: "Manevrisanje u mestu"


#### 3_06 msg - intro text

	key[]: "aca_msg_book1_3_06_cutscene01"
	val[]: "Parkiranje dok vozite napred ili „ubacivanje nosa“ je prilično lako što se tiče manevara parkiranja. <br>I dalje ćete morati da nadoknadite ofset praćenje prikolice."

	key[]: "aca_msg_book1_3_06_cutscene02"
	val[]: "Moraćete da prođete pored tačke gde biste inače sami okretali tegljač. Ovo će vam omogućiti da efikasnije postavite prikolicu."

	key[]: "aca_msg_book1_3_06_cutscene03"
	val[]: "Dok se približavate parking mestu, okrenite se da biste postavili tegljač ispred prikolice. Postavite se u red i nastavite na mesto. <br>Zaustavite, parkirajte i obezbedite kamion i ugasite motor."

#### 3_06 Driving Instructions

	key[]: "aca_msg_book1_3_06_start"
	val[]: "Ispred vas, je parking mesto do kojeg ćete morati da se odvezete i parkirate unutra.<br><br><font face=/font/big_bold.font>Pripremite se za polazak. </font>"

	key[]: "aca_msg_book1_3_06_forward"
	val[]: "<font face=/font/big_bold.font>Počnite da vozite i skrenite prema mestu za parkiranje.</font>"

	key[]: "aca_msg_book1_3_06_check1"
	val[]: "Prođite pored parking mesta da bi vaša prikolica bila u liniji sa obeleženim područjem, a zatim dovedite tegljač na mesto i ispravite se.<br><br><font face=/font/big_bold.font>Parkirajte na određenom području.  </font>"

	key[]: "aca_msg_book1_3_06_stop"
	val[]: "<font face=/font/big_bold.font>Zaustavite se na određenom području.</font>"

	key[]: "aca_msg_book1_3_06_end"
	val[]: "<font face=/font/big_bold.font>Obezbedite kamion i ugasite motor.</font>"
#@}

