#+ Text deviations for American Truck Simulator. Please, use only terms appropriate for USA (i.e. culture specific nuances, not American English).
#@{

#+ Music/radio player
#@{

#+ Hint shown if no music files are found. Also shown as tooltip when hovering over music_player button.

	key[]: "music_player_hint"
	val[]: "Скопируйте вашу музыку в папку <color value=@@clr_sel@@>Документы/American Truck Simulator/music<color value=@@clr_txt@@>, и она станет доступна в игре."

#+ Tooltip shown when hovering over the radio_stream button.

	key[]: "radio_hint"
	val[]: "Добавьте в файл <color value=@@clr_sel@@>live_streams.sii <color value=@@clr_txt@@>ваши любимые онлайн-радиостанции и слушайте их в игре! Файл <color value=@@clr_sel@@>live_streams.sii <color value=@@clr_txt@@>находится в папке <color value=@@clr_sel@@>Документы / American Truck Simulator<color value=@@clr_txt@@>."

#+ Hint shown if no online radio streams are defined.

	key[]: "empty_radio_hint"
	val[]: "Информацию о том, как добавить адреса радиостанций и свою музыку в проигрыватель, вы можете найти в файле <color value=@@clr_sel@@>readme.rtf<color value=@@clr_txt@@>, находящемся в папке <color value=@@clr_sel@@>Документы / American Truck Simulator <color value=@@clr_txt@@>."
#@}

