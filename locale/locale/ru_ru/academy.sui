	#### diag common

	key[]: "aca_scenario_book3_diag_title"
	val[]: "Диагональная парковка с двойным прицепом"

	key[]: "aca_scenario_book3_diag_desc"
	val[]: "В этом упражнении вам нужно выполнить диагональную парковку с двойным прицепом на заполненной стоянке. "

#### diag msg - intro text

	key[]: "aca_msg_book3_diag_cutscene1"
	val[]: "Такие диагональные парковки встречаются очень часто. Особенно они распространены на старых стоянках для грузовиков, а также на многочисленных зонах отдыха вдоль автомагистралей Америки."

	key[]: "aca_msg_book3_diag_cutscene2"
	val[]: "Двигайтесь к специально отведённому месту для парковки в конце ряда."

	key[]: "aca_msg_book3_diag_cutscene3"
	val[]: "Двигайтесь по внешней стороне полосы, но не вплотную к ограждениям, так как задняя часть прицепа может задеть их при повороте."

	key[]: "aca_msg_book3_diag_cutscene4"
	val[]: "Проезжайте мимо парковочного места, чтобы освободить место для обоих прицепов. Затем сверните к противоположной стороне, чтобы выставить первый прицеп к обозначенному месту."

	key[]: "aca_msg_book3_diag_cutscene5"
	val[]: "Выровняйтесь, затем остановитесь в обозначенном месте и активируйте стояночный тормоз."

#### diag Driving Instructions

#!{
	key[]: "aca_msg_book3_diag_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_diag_forward"
	val[]: "Двигайтесь к концу ряда и найдите ваше парковочное место."

	key[]: "aca_msg_book3_diag_check1"
	val[]: "Двигайтесь далее парковочного места, чтобы убедиться, что ваш задний прицеп правильно въедет на него, затем резко поверните, следя за тем, чтобы передняя часть вашего ведущего прицепа не задела грузовик рядом с вами."

	key[]: "aca_msg_book3_diag_stop"
	val[]: "Продолжайте медленно выравнивать прицепы, затем остановитесь в обозначенном месте."

#!{
	key[]: "aca_msg_book3_diag_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


