	key[]: "aca_scenario_book1_2_04_title"
	val[]: "Парковка рядом с препятствием"

	key[]: "aca_scenario_book1_2_04_desc"
	val[]: "В этом упражнении мы научимся парковаться рядом с бордюром, используя боковое зеркало."

#### 2_04 goal

	key[]: "aca_goal_book1_2_04_mirror"
	val[]: "Проверка зеркал бокового обзора"

	key[]: "aca_goal_book1_2_04_check1"
	val[]: "Движение к обочине"

