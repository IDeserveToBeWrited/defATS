#+ Book 3 Scenario Truckstop Angle
#@{

#### trckstp common

	key[]: "aca_scenario_book3_trckstp_title"
	val[]: "Парковка на повороте"

	key[]: "aca_scenario_book3_trckstp_desc"
	val[]: "В этом упражнении вам предстоит проехать через заполненную парковку, полную неудобно припаркованных грузовиков, чтобы припарковаться на повороте."

#### trckstp goal

#!{
	key[]: "aca_goal_book3_trckstp_check1"
	val[]: "@@aca_goal_book3_sup_check1@@"

	key[]: "aca_goal_book3_trckstp_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_trckstp_end"
	val[]: "@@aca_goal_book3_sup_end@@"

	key[]: "aca_goal_book3_trckstp_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_trckstp_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
#### trckstp msg - intro text

	key[]: "aca_msg_book3_trckstp_cutscene1"
	val[]: "Нередко можно приехать на стоянку, почти полностью заполненную грузовиками, и у вас практически не останется вариантов для самостоятельной парковки."

	key[]: "aca_msg_book3_trckstp_cutscene2"
	val[]: "В этом случае осталось только одно место, куда можно поставить вашу сцепку из двух прицепов. <br><br>Проезжайте через парковку и припаркуйтесь на повороте возле выезда."

#### trckstp Driving Instructions

#!{
	key[]: "aca_msg_book3_trckstp_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_trckstp_forward"
	val[]: "Проезжайте через парковку и припаркуйтесь вдоль поворота. <br><br>Продолжайте, когда будете готовы."

	key[]: "aca_msg_book3_trckstp_check1"
	val[]: "Здесь вы не сможете проехать через поворот, вам придётся сдать назад и найти другой путь."

	key[]: "aca_msg_book3_trckstp_check2"
	val[]: "Припаркуйтесь на повороте впереди."

	key[]: "aca_msg_book3_trckstp_stop"
	val[]: "Остановитесь в обозначенном месте."

	key[]: "aca_msg_book3_trckstp_end"
	val[]: "Поставьте грузовик на стояночный тормоз и заглушите двигатель."

#@}


