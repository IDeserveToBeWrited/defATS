	val[]: "В этом упражнении вам придётся развернуть свой прицеп в условиях крайне ограниченного пространства для манёвра."

#### intro text

	key[]: "aca_scenario_book2_sharp_circle_cutscene1"
	val[]: "Подъезжайте к месту напротив вас."

	#@}

#+ Book 2 sharp.backing
