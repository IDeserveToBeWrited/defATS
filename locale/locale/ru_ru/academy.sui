	val[]: "@@aca_goal_book1_1_03_forward@@"


	key[]: "aca_goal_book1_2_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"



 #!}
#### 2_09 msg - intro text

	key[]: "aca_msg_book1_2_09_cutscene1"
	val[]: "Параллельная парковка — важнейший навык, который должен знать каждый дальнобойщик.<br>Приготовьтесь к движению."

	key[]: "aca_msg_book1_2_09_cutscene2"
	val[]: "Двигайтесь к месту парковки.<br>Обратите внимание на своё окружение."

	key[]: "aca_msg_book1_2_09_cutscene3"
	val[]: "Выровняйтесь с грузовиком перед местом парковки. Не приближайтесь к нему слишком близко, держитесь на некотором расстоянии, чтобы у вас было место для манёвра."

	key[]: "aca_msg_book1_2_09_cutscene4"
	val[]: "Резко поверните в сторону парковочного места и начните движение задним ходом."

	key[]: "aca_msg_book1_2_09_cutscene5"
	val[]: "Глядя в зеркало заднего вида со стороны водителя, стремитесь к обочине прямо перед грузовиком, находящимся позади вас."

	key[]: "aca_msg_book1_2_09_cutscene6"
	val[]: "Как только ваш передний бампер минует грузовик впереди вас, вы можете начать направлять переднюю часть грузовика в нужное место, выравнивая грузовик по парковочному месту."

	key[]: "aca_msg_book1_2_09_cutscene7"
	val[]: "Выровняйте руль и расположите грузовик по центру парковочного места.<br>Припаркуйтесь и поставьте грузовик на стояночный тормоз."

#### 2_09 Driving Instructions

	key[]: "aca_msg_book1_2_09_start"
	val[]: "Перед вами несколько припаркованных грузовиков. Одно место оставлено для вас.<br><br><font face=/font/big_bold.font>Приготовьтесь к отправлению.</font>"

	key[]: "aca_msg_book1_2_09_check1"
	val[]: "Не забывайте следить за своим окружением. Во время этого манёвра эффективно используйте зеркала. <br><br><font face=/font/big_bold.font>Двигайтесь вперёд. </font>"

	key[]: "aca_msg_book1_2_09_stopmid"
	val[]: "<color value=@@clr_white@@>Двигайтесь мимо места для парковки и въезжайте в отмеченную зону. Отсюда вы можете начать манёвр заднего хода.<br><br><font face=/font/big_bold.font>Остановитесь в отмеченном месте. </font>"

	key[]: "aca_msg_book1_2_09_checkmirror"
	val[]: "Проверьте свое окружение на наличие препятствий и убедитесь, что вы можете повернуть назад.<br><br><font face=/font/big_bold.font>Посмотрите в боковое зеркало со стороны пассажира. </font>"

	key[]: "aca_msg_book1_2_09_backward"
	val[]: "Поверните колёса и двигайтесь задним ходом на место парковки.<br><br><font face=/font/big_bold.font>Начните движение назад. </font>"

	key[]: "aca_msg_book1_2_09_stop"
	val[]: "При необходимости начните выпрямлять грузовик. Не выезжайте за бордюр!<br><br><font face=/font/big_bold.font>Выровняйте грузовик по месту. </font>"
#!{
	key[]: "aca_msg_book1_2_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_01
#@{

#### 3_01 common
	key[]: "aca_scenario_book1_3_01_title"
	val[]: "Зацеп прицепа"

	key[]: "aca_scenario_book1_3_01_desc"
	val[]: "В этом упражнении мы объясним основы подсоединения и отсоединения тягача от прицепа."

#### 3_01 goal

