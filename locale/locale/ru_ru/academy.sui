#### double_90 intro

	key[]: "aca_msg_book3_double_90_cutscene01"
	val[]: "Следующее упражнение поможет вам освоить выполнение поворотов на 90 градусов различной сложности с двойной сцепкой."

	key[]: "aca_msg_book3_double_90_cutscene02"
	val[]: "Первые несколько поворотов довольно широкие, с достаточным пространством. Используйте их, чтобы почувствовать прицепы позади вас во время поворота."

	key[]: "aca_msg_book3_double_90_cutscene03"
	val[]: "Следующие повороты станут круче и сложнее. Приближайтесь к ним медленно и заезжайте в повороты достаточно широко, чтобы у ваших прицепов было достаточно места для движения, минуя повороты позади."

	key[]: "aca_msg_book3_double_90_cutscene04"
	val[]: "Это один из самых крутых поворотов на маршруте. Возможно, вам поможет небольшое пространство справа, чтобы объехать эти надоедливые внутренние конусы."

	key[]: "aca_msg_book3_double_90_cutscene05"
	val[]: "Следующий поворот всегда должен быть у вас в голове — после прохождения одного поворота составьте план подготовки к следующему."

	key[]: "aca_msg_book3_double_90_cutscene06"
	val[]: "Всегда внимательно следите за своими прицепами, пока они не отъедут от любых препятствий."

#### double_90 driving instructions

#!{
	key[]: "aca_msg_book3_double_90_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_double_90_forward"
	val[]: "Двигайтесь вперёд к первому повороту."

	key[]: "aca_msg_book3_double_90_check1"
	val[]: "Обращайте внимание на зеркала заднего вида во время движения, чтобы понимать, как прицепы движутся позади вас."

	key[]: "aca_msg_book3_double_90_check2"
	val[]: "Держитесь шире перед каждым поворотом, это важно, чтобы обеспечить пространство, необходимое для того, чтобы прицепы завернули за угол."

	key[]: "aca_msg_book3_double_90_check3"
	val[]: "Правильная подготовка к следующим нескольким поворотам имеет решающее значение, поскольку после них следует очень крутой вираж. Ошибка в начале может дорого обойтись вам позже.<br><br>Действуйте не спеша и тщательно, обращая внимание на окружающую обстановку."

	key[]: "aca_msg_book3_double_90_check4"
	val[]: "Этот поворот чрезвычайно крутой и плавно переходит в следующий крутой поворот. Вам нужно будет продумать не только вход в поворот, но и выход из него, а также подготовку к следующему."

	key[]: "aca_msg_book3_double_90_check5"
	val[]: "Продолжайте движение через последние повороты к обозначенной зоне."

#!{
	key[]: "aca_msg_book3_double_90_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_double_90_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


#+ Book 3 Scenario justb
#@{

#### justb common
	key[]: "aca_scenario_book3_justb_title"
	val[]: "Первое движение назад"

	key[]: "aca_scenario_book3_justb_desc"
	val[]: "В этом упражнении мы впервые осуществим движение задним ходом с двойным прицепом."

#### justb goal

#!{
	key[]: "aca_goal_book3_justb_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_justb_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
	key[]: "aca_goal_book3_justb_check1"
	val[]: "Расслабьтесь, не волнуйтесь"

#!{
	key[]: "aca_goal_book3_justb_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_justb_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### justb msg - intro text

	key[]: "aca_msg_book3_justb_cutscene1"
	val[]: "Движение назад с двойным прицепом требует совершенно нового подхода к тому, что вы делаете. Вместо того, чтобы просто управлять прицепом, вы используете ведущий прицеп для управления прицепом, идущим за ним. <br><br> Используйте это упражнение, чтобы понять, как всё работает. Конкретной цели нет, просто не торопитесь и постарайтесь разобраться в происходящем."

	key[]: "aca_msg_book3_justb_cutscene2"
	val[]: "Из прямолинейного положения вы можете повернуть свой грузовик в том направлении, в котором хотите, чтобы двигался задний прицеп. <br><br>Не переусердствуйте; вам нужно лишь направить задний прицеп в нужном направлении, а затем выровнять тягач с ведущим прицепом и позволить заднему прицепу делать своё дело."

	key[]: "aca_msg_book3_justb_cutscene3"
	val[]: "Как только задний прицеп направится в нужное вам место, вы можете скорректировать направление движения ведущего прицепа. <br><br>Как только ведущий прицеп последует за ним, с помощью тягача отрегулируйте угол между двумя прицепами, чтобы сделать угол более крутым или более широким."

	key[]: "aca_msg_book3_justb_cutscene4"
	val[]: "Не существует идеальной формулы успеха, нужно лишь внимательно следить за происходящим, учиться на своих ошибках и постоянно практиковаться. <br><br>Когда убедитесь, что всё в порядке, можете направиться в обозначенное место и зафиксировать грузовик. <br><br>Не стесняйтесь экспериментировать здесь столько времени, сколько посчитаете нужным."

#### justb Driving Instructions

#!{
	key[]: "aca_msg_book3_justb_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_justb_forward"
	val[]: "Начинайте движение назад медленно. Начинайте с небольших движений, не нужно сразу же резко разворачивать руль.<br><br>Постарайтесь двигаться прямо назад или подъехать прицепами к стороне водителя."

	key[]: "aca_msg_book3_justb_check1"
	val[]: "Не торопитесь и не расстраивайтесь. <br><br>Каждый мастер был когда-то новичком."

#!{
	key[]: "aca_msg_book3_justb_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_justb_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}

