#### 3_12 msg - intro text

	key[]: "aca_msg_book1_3_12_cutscene01"
	val[]: "В этом упражнении мы рассмотрим, как развернуться в ограниченном пространстве.<br>У вас не всегда будет достаточно места для маневрирования, и вам придётся приспосабливаться к различным ситуациям."

	key[]: "aca_msg_book1_3_12_cutscene02"
	val[]: "Двигайтесь по проезду к открытой площадке."

	key[]: "aca_msg_book1_3_12_cutscene03"
	val[]: "Слева находится ещё один проезд, в который вам нужно свернуть. Подготовьтесь к манёвру так, как вам захочется.<br>Перед тем, как начать движение задним ходом, может быть полезно направить прицеп в сторону проезда."

	key[]: "aca_msg_book1_3_12_cutscene04"
	val[]: "Двигайтесь задним ходом в сторону проезда. Будьте внимательны и следите за тягачом и прицепом со всех сторон."

	key[]: "aca_msg_book1_3_12_cutscene05"
	val[]: "В проезде есть препятствия, так что старайтесь держаться водительской стороны."

	key[]: "aca_msg_book1_3_12_cutscene06"
	val[]: "Закончив движение задним ходом, вы можете проехать вперёд и вернуться в направлении, откуда приехали."

	key[]: "aca_msg_book1_3_12_cutscene07"
	val[]: "Вам может быть трудно увидеть прицеп в боковом зеркале пассажира при выезде, поэтому используйте всё свободное пространство с пользой для себя."

	key[]: "aca_msg_book1_3_12_cutscene08"
	val[]: "Продолжайте движение к выходу."

	key[]: "aca_msg_book1_3_12_cutscene09"
	val[]: "Припаркуйтесь в обозначенном месте и поставьте грузовик на стояночный тормоз."
#!{
	key[]: "aca_msg_book1_3_12_cutscene10"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_12_cutscene11"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_12_cutscene12"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_12_cutscene13"
	val[]: "Unused"
#!}
#### 3_12 Driving Instructions

	key[]: "aca_msg_book1_3_12_start"
	val[]: "Перед вами территория, представляющая собой стоянку транспортной компании. Ваша задача въехать туда и развернуться, чтобы выехать обратно. Убедитесь, что вы правильно используете пространство вокруг себя.<br><br><font face=/font/big_bold.font>Приготовьтесь к движению</font>"

	key[]: "aca_msg_book1_3_12_forward"
	val[]: "<font face=/font/big_bold.font>Двигайтесь по проезду. </font>"

	key[]: "aca_msg_book1_3_12_check1"
	val[]: "Сразу за зданием слева есть ещё один проезд, в который вам нужно заехать задним ходом. Приготовьтесь к этому.<br><br><font face=/font/big_bold.font>Продолжайте двигаться к барьерам. </font>"



	key[]: "aca_msg_book1_3_12_check3"
	val[]: "Двигайтесь назад и направляйте прицеп в сторону кармана, стараясь не задеть траком ничего с правой стороны.<br><br><font face=/font/big_bold.font>Начните движение задним ходом и направьте прицеп в проезд. Остановитесь в обозначенной зоне. </font>"

	key[]: "aca_msg_book1_3_12_check4"
	val[]: "Теперь вы можете покинуть площадку в том же направлении, откуда приехали. Используйте доступное вам пространство с пользой.<br><br><font face=/font/big_bold.font>Двигайтесь вперёд и поверните направо. </font>"


	key[]: "aca_msg_book1_3_12_check6"
	val[]: "Продолжайте движение по проезду к обозначенному месту."
#!{
	key[]: "aca_msg_book1_3_12_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_12_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_12_check5"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_12_check2"
	val[]: "Unused"
#!}

#@}

#+ Book 1 Scenario 3_13
#@{

#### 3_13 common
	key[]: "aca_scenario_book1_3_13_title"
	val[]: "Движение задним ходом со смещением"

	key[]: "aca_scenario_book1_3_13_desc"
	val[]: "В этом упражнении вам будет необходимо сдать назад на парковочное место, которое не находится прямо позади вас. Место для манёвра ограничено, поэтому вам следует использовать своё пространство с умом."

#### 3_13 goal

#!{
	key[]: "aca_goal_book1_3_13_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_13_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_13_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_13_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

#!}

#### 3_13 msg - intro text

	key[]: "aca_msg_book1_3_13_cutscene01"
	val[]: "В этом упражнении ваша задача — припарковаться на месте, расположенном рядом с вами. Пространство для манёвра ограничено, поэтому вам придётся приложить немного дополнительных усилий, чтобы направить прицеп туда, куда нужно."

	key[]: "aca_msg_book1_3_13_cutscene02"
	val[]: "Подъезжайте к барьеру."

	key[]: "aca_msg_book1_3_13_cutscene03"
	val[]: "Остановитесь перед ограждением."

	key[]: "aca_msg_book1_3_13_cutscene04"
	val[]: "Перед началом движения сразу поверните руль в сторону водителя. Таким образом, вы начнёте поворачивать прицеп к парковочному месту сразу после начала движения задним ходом, экономя ценное пространство."

	key[]: "aca_msg_book1_3_13_cutscene05"
	val[]: "Как только вы направите прицеп в нужном направлении, выставьте тягач перед прицепом и начните направлять его на место для парковки."

	key[]: "aca_msg_book1_3_13_cutscene06"
	val[]: "С этого момента это не сильно отличается от обычного манёвра парковки."

	key[]: "aca_msg_book1_3_13_cutscene07"
	val[]: "Продолжайте двигаться задним ходом и наблюдайте за обеими сторонами. Держите тягач и прицеп на одной линии с местом для парковки."

	key[]: "aca_msg_book1_3_13_cutscene08"
	val[]: "Остановитесь в обозначенном месте, поставьте грузовик на стояночный тормоз и заглушите двигатель."


#### 3_13 Driving Instructions

	key[]: "aca_msg_book1_3_13_start"
	val[]: "Вы находитесь на парковочном месте, но справа от вас есть второе парковочное место, куда вам нужно переехать.<br><br><font face=/font/big_bold.font>Приготовьтесь к движению. </font>"

	key[]: "aca_msg_book1_3_13_forward"
	val[]: "Перед вами отмеченная область.<br><br><font face=/font/big_bold.font>Двигайтесь вперёд. </font>"
#!{
	key[]: "aca_msg_book1_3_13_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

	key[]: "aca_msg_book1_3_13_check2"
	val[]: "Не забудьте сразу начать подруливать, так как места мало.<br><br><font face=/font/big_bold.font>Двигайтесь назад к обозначенному месту позади вас. </font>"


#@}

#+ Book 1 Scenario 3_15
#@{

#### 3_15 common
	key[]: "aca_scenario_book1_3_15_title"
	val[]: "Повороты \"Ручка кувшина\" и \"Крючок\""

	key[]: "aca_scenario_book1_3_15_desc"
	val[]: "В этом упражнении вы пройдёте небольшой курс обучения, который поможет вам научиться маневрировать прицепом на крутых поворотах с помощью двух различных манёвров прохождения поворотов."

#### 3_15 goal
#!{
	key[]: "aca_goal_book1_3_15_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_15_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_15_check6"
	val[]: "@@aca_goal_book1_3_11_check6@@"

	key[]: "aca_goal_book1_3_15_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_15_end"
	val[]: "@@aca_goal_book1_2_01_end@@"


 #!}
	key[]: "aca_goal_book1_3_15_check1"
	val[]: "Поворот \"Ручка кувшина\""

	key[]: "aca_goal_book1_3_15_check2"
	val[]: "Кривой и прямой участок"

	key[]: "aca_goal_book1_3_15_check3"
	val[]: "Поворот \"Крючок\""

	key[]: "aca_goal_book1_3_15_check4"
	val[]: "Прямой участок и кривая"

	key[]: "aca_goal_book1_3_15_check5"
	val[]: "Комбинированный поворот"



#### 3_15 msg - intro text

	key[]: "aca_msg_book1_3_15_cutscene01"
	val[]: "Перед вами несколько узких поворотов, с очень небольшим количеством свободного места.<br>Это поможет вам научиться эффективно маневрировать с прицепом."

	key[]: "aca_msg_book1_3_15_cutscene02"
	val[]: "@@aca_msg_book1_3_15_cutscene02_img@@<br>Первый поворот требует манёвра в форме ручки кувшина или вопросительного знака. Он применятся при поворотах, когда на дороге, на которую вы поворачиваете, недостаточно свободного места, поэтому требуется брать шире и использовать больше пространства на дороге, с которой вы сворачиваете."

	key[]: "aca_msg_book1_3_15_cutscene03"
	val[]: "Следуйте разметке на полосе, чтобы направить тягач дальше и шире от внутреннего бордюра.<br>Это позволит отвести прицеп от бордюра, чтобы у вас было достаточно места для маневрирования."

	key[]: "aca_msg_book1_3_15_cutscene04"
	val[]: "Держитесь ближе к препятствию на выходе из поворота, чтобы прицеп следовал по как можно большей дуге."

	key[]: "aca_msg_book1_3_15_cutscene05"
	val[]: "При входе в длинный поворот необходимо держать тягач по направлению к центру дороги, чтобы колеса прицепа не задевали бордюр."

	key[]: "aca_msg_book1_3_15_cutscene06"
	val[]: "Продолжайте движение по дороге."

	key[]: "aca_msg_book1_3_15_cutscene07"
	val[]: "@@aca_msg_book1_3_15_cutscene07_img@@<br>Следующий поворот требует использования манёвра \"Крючок\". Это предпочтительная техника, поскольку она не открывает полосу позади вас для невнимательного автомобилиста, который может подкрасться справа. Всегда используйте эту технику, если у вас достаточно места на дороге, на которую вы поворачиваете."

	key[]: "aca_msg_book1_3_15_cutscene08"
	val[]: "Двигайтесь вглубь перекрёстка и резко поверните направо."

	key[]: "aca_msg_book1_3_15_cutscene09"
	val[]: "Подъехав к препятствию, вы можете выпрямиться и снова держаться левой стороны своей полосы.<br>Всё это помогает удерживать колеса прицепа на расстоянии от бордюра."

	key[]: "aca_msg_book1_3_15_cutscene10"
	val[]: "Продолжайте двигаться к следующему повороту."

	key[]: "aca_msg_book1_3_15_cutscene11"
	val[]: "И снова держитесь середины дороги, чтобы колёса прицепа не касались бордюра."

	key[]: "aca_msg_book1_3_15_cutscene12"
	val[]: "Поворот впереди является особенно проблемным. В таких случаях у вас не будет идеальных условий ни для манёвра \"ручка кувшина\", ни для манёвра \"крючком\", поэтому вам придётся комбинировать оба манёвра, чтобы добраться туда, куда вам нужно."

	key[]: "aca_msg_book1_3_15_cutscene13"
	val[]: "Двигайтесь шире перед поворотом, заезжайте на перекрёсток и резко поверните. И снова идеально держаться как можно ближе к препятствию, чтобы поворот был как можно шире."

	key[]: "aca_msg_book1_3_15_cutscene14"
	val[]: "Остановитесь в обозначенном месте, поставьте грузовик на стояночный тормоз и заглушите двигатель."

	# Book 1 Scenario 3_15 formatting
#!{
	key[]: "aca_msg_book1_3_15_cutscene02_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/jug_handle.mat bottom=p256 right=p256 color=FFFFFFFF></align><offset vshift=256>"

	key[]: "aca_msg_book1_3_15_cutscene07_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/button_hook.mat bottom=p256 right=p256 color=FFFFFFFF></align><offset vshift=256>"

#!}


#### 3_15 Driving Instructions

	key[]: "aca_msg_book1_3_15_forward"
	val[]: "Не забывайте использовать всё доступное вам пространство, чтобы пройти каждый поворот.<br><br><font face=/font/big_bold.font>Начинайте движение и следуйте по дорожной разметке налево. </font>"

	key[]: "aca_msg_book1_3_15_check1"
	val[]: "Используйте всё доступное пространство, чтобы поворачивать широко и держать прицеп подальше от внутреннего бордюра.<br><br><font face=/font/big_bold.font>Выполните манёвр \"ручка кувшина\". </font>"

	key[]: "aca_msg_book1_3_15_check2"
	val[]: "Держитесь центра дороги на повороте, а затем продолжайте движение прямо до следующего поворота.<br><br><font face=/font/big_bold.font>Продолжайте движение. </font>"

	key[]: "aca_msg_book1_3_15_check3"
	val[]: "Слева место ограничено, поэтому вы должны заехать дальше на перекрёсток, чтобы прицеп не заехал на бордюр.<br><br><font face=/font/big_bold.font>Выполните манёвр \"крючком\". </font>"

	key[]: "aca_msg_book1_3_15_check4"
	val[]: "Двигайтесь дальше, до следующего поворота.<br><br><font face=/font/big_bold.font>Продолжайте движение. </font>"

	key[]: "aca_msg_book1_3_15_check5"
	val[]: "Этот поворот самый узкий и ни один из манёвров сам по себе не будет достаточным.<br><br><font face=/font/big_bold.font>Выполните поворот, держась как можно шире.</font>"

	key[]: "aca_msg_book1_3_15_check6"
	val[]: "<font face=/font/big_bold.font>Двигайтесь на парковку впереди справа. </font>"
#!{
	key[]: "aca_msg_book1_3_15_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_15_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_15_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}


#@}

#+ Book 1 Scenario 3_16
#@{

#### 3_16 common
	key[]: "aca_scenario_book1_3_16_title"
	val[]: "Диагональная парковка задним ходом"

	key[]: "aca_scenario_book1_3_16_desc"
	val[]: "В этом упражнении мы рассмотрим парковку по диагонали при движении задним ходом. Это может происходить на площадках для отдыха, стоянках грузовиков и даже у грузоотправителей. Зачастую такие места переполнены грузовиками, поэтому парковка становится ещё более сложной из-за ограниченного пространства."

#### 3_16 goal

	key[]: "aca_goal_book1_3_16_check1"
	val[]: "Поворот прицепом"
#!{
	key[]: "aca_goal_book1_3_16_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_16_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_16_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_16_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
 #!}
#### 3_16 msg - intro text

	key[]: "aca_msg_book1_3_16_cutscene1"
	val[]: "Диагональная парковка на первый взгляд кажется проще, но зачастую она может оказаться сложнее, чем типичные манёвры \"парковки в проезде\"."

	key[]: "aca_msg_book1_3_16_cutscene2"
	val[]: "Двигайтесь задним ходом к месту парковки. Пока держите тягач и прицеп прямо."

	key[]: "aca_msg_book1_3_16_cutscene3"
	val[]: "По мере приближения направляйте прицеп ближе к припаркованным грузовикам. Это поможет вам развернуть его на место, где нужно припарковаться."

	key[]: "aca_msg_book1_3_16_cutscene4"
	val[]: "Начинайте поворачивать прицеп на парковочное место. Выставляйте прицеп вплотную к грузовику со стороны водителя, так как вам понадобится место с другой стороны."

	key[]: "aca_msg_book1_3_16_cutscene5"
	val[]: "Как только прицеп въедет на место парковки, начинайте подруливать тягачом, чтобы следовать за прицепом."

	key[]: "aca_msg_book1_3_16_cutscene6"
	val[]: "Остановитесь в обозначенном месте, поставьте грузовик на стояночный тормоз и заглушите двигатель."

#### 3_16 Driving Instructions

	key[]: "aca_msg_book1_3_16_start"
	val[]: "Припаркуйте грузовик на свободное место позади себя. Используйте оба зеркала заднего вида для движения задним ходом.<br><br><font face=/font/big_bold.font>Приготовьтесь к движению. </font>"

	key[]: "aca_msg_book1_3_16_backward"
	val[]: "Проверьте свое окружение, затем направляйтесь к парковочному месту.<br><br><font face=/font/big_bold.font>Начинайте движение назад.</font>"

	key[]: "aca_msg_book1_3_16_check1"
	val[]: "Начинайте двигать прицеп к грузовикам рядом с вами. Когда будете готовы, поверните прицеп на парковочное место. Не забудьте учесть занос хвоста прицепа.<br><br><font face=/font/big_bold.font>Поверните на парковочное место. </font>"
#!{
	key[]: "aca_msg_book1_3_16_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_16_end"
	val[]: "@@aca_msg_book1_2_01_end@@"


 #!}


#@}

