	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
#### finex msg - intro text

	key[]: "aca_msg_book3_finex_cutscene1"
	val[]: "Добро пожаловать на итоговый экзамен. Мы подготовили несколько реалистичных ситуаций, с которыми вы можете столкнуться, чтобы проверить вашу способность с ними справляться. Как всегда, не торопитесь и будьте точны. <br><br>Удачи!"

#### finex Driving Instructions

	key[]: "aca_msg_book3_finex_check0"
	val[]: "Дорога впереди заблокирована, развернитесь в отведённом месте."

	key[]: "aca_msg_book3_finex_check1"
	val[]: "Продолжайте движение к центру города."

	key[]: "aca_msg_book3_finex_check2"
	val[]: "Двигаясь по направлению к центру города, достигните скорости не менее 37 миль/час (60 км/ч)."

	key[]: "aca_msg_book3_finex_check22"
	val[]: "Приготовьтесь к торможению."

	key[]: "aca_msg_book3_finex_speed"
	val[]: "Вы не достигли скорости 37 миль в час (60 км/ч)"

	key[]: "aca_msg_book3_finex_check4"
	val[]: "Продолжайте движение по маршруту."

	key[]: "aca_msg_book3_finex_check5"
	val[]: "Парковочное место в ряду грузовиков слева. Заезжайте задним ходом и паркуйтесь."

