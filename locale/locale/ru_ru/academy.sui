#### 1_02 common

	key[]: "aca_scenario_book1_1_02_title"
	val[]: "Управление камерой"

	key[]: "aca_scenario_book1_1_02_desc"
	val[]: "В этом упражнении мы узнаем о различных типах камер и о том, как они могут помочь вам управлять грузовиком."

#### 1_02 goal

	key[]: "aca_goal_book1_1_02_seat"
	val[]: "Настройка сиденья"

	key[]: "aca_goal_book1_1_02_look_back"
	val[]: "Вид сзади"

	key[]: "aca_goal_book1_1_02_mirrors"
	val[]: "Проверка зеркал"

	key[]: "aca_goal_book1_1_02_cam_behind"
	val[]: "Переключение на внешнюю камеру"

	key[]: "aca_goal_book1_1_02_look_around"
	val[]: "Обзор вокруг грузовика"


#### 1_02 msg - intro text

	key[]: "aca_msg_book1_1_02_cutscene1"
	val[]: "В этом упражнении мы рассмотрим различные камеры,<br>которые доступны для использования."

	key[]: "aca_msg_book1_1_02_cutscene2"
	val[]: "Всего на выбор предлагается семь камер, сейчас мы рассмотрим<br> некоторые из них и объясним их предполагаемые функции."

	key[]: "aca_msg_book1_1_02_cutscene3"
	val[]: "Различные камеры и их разные углы обзора могут помочь вам при маневрировании в ограниченных местах."


#### 1_02 Driving Instructions

	key[]: "aca_msg_book1_1_02_seat"
	val[]: "Смотреть, куда едешь — основа безопасного и профессионального вождения. Если текущее положение сиденья вас не устраивает, вы можете изменить это в @@adjust_link_t@@ (Доступно в меню паузы).<br><br><font face=/font/big_bold.font>Подтвердите готовность нажав @@imv_nrm_activate@@. </font>"

	key[]: "aca_msg_book1_1_02_look_back"
	val[]: "При движении задним ходом зеркала не всегда обеспечивают четкий обзор. Возможно, вам придется выглянуть в окно позади себя, чтобы лучше видеть.<br><br><font face=/font/big_bold.font>Поверните камеру полностью в сторону водителя, чтобы посмотреть за окно на заднюю часть прицепа.</font>@@aca_goal_tip@@ Вы должны находиться в кабине."

	key[]: "aca_msg_book1_1_02_mirrors"
	val[]: "Используйте этот вид для проверки прицепа во время манёвров задним ходом с прицепом. Всегда лучше посмотреть назад со стороны водителя, чтобы иметь возможность использовать этот обзор. При движении задним ходом на пассажирскую сторону у вас гораздо более ограниченный обзор того, что происходит позади вас.<br><br><font face=/font/big_bold.font>Посмотрите в сторону пассажира. </font>"

	key[]: "aca_msg_book1_1_02_cam_behind"
	val[]: "Именно поэтому обычно не рекомендуется двигаться назад в сторону пассажира; вы можете видеть, что видимость весьма ограничена. К счастью, вам также доступны семь внешних камер. <br><br>Кнопка @@imv_nrm_camcycle@@ может использоваться для последовательного переключения на следующую камеру. Пройдя по всем семи камерам, вы вернётесь к началу цикла. <br><br><font face=/font/big_bold.font>Нажмите @@imv_nrm_camcycle@@ чтобы переключиться на следующую камеру. </font>"

	key[]: "aca_msg_book1_1_02_look_around"
	val[]: "Внешняя камера обеспечивает лучший обзор того, что происходит вокруг грузовика.<br><br><font face=/font/big_bold.font>Осмотритесь вокруг грузовика.</font>"

	key[]: "aca_msg_book1_1_02_cam_top"
	val[]: "<font face=/font/big_bold.font>Нажмите снова @@imv_nrm_camcycle@@, и вы переключитесь на другую камеру. </font>"

	key[]: "aca_msg_book1_1_02_cam_cabin"
	val[]: "Вид сверху обеспечивает отличный обзор ситуации вокруг грузовика, значительно упрощая парковку и движение в ограниченном пространстве.<br><br><font face=/font/big_bold.font>Нажмите @@imv_nrm_camcycle@@, чтобы переключиться на следующую камеру. </font>"

	key[]: "aca_msg_book1_1_02_cam_window"
	val[]: "Камера на крыше обеспечивает чёткий обзор дороги впереди грузовика без каких-либо помех.<br><br><font face=/font/big_bold.font>Нажмите @@imv_nrm_camcycle@@, чтобы переключиться на последнюю камеру, которую мы сейчас рассмотрим.</font>"

	key[]: "aca_msg_book1_1_02_cam_interior"
	val[]: "Вид назад — это быстрый доступ к ракурсу, который вы ранее получили поворотом камеры из кабины. Как мы уже говорили, это полезно при движении задним ходом или парковке.<br><br>В игре есть больше камер, которые вы можете опробовать, несколько раз нажав @@imv_nrm_camcycle@@.<br><br><font face=/font/big_bold.font>Нажмите @@imv_nrm_cam1@@, чтобы вернуться в кабину.</font>"

	key[]: "aca_msg_book1_1_02_end"
	val[]: "Для более достоверного опыта, мы рекомендуем использовать \"Вид из кабины\" при прохождении каждого из упражнений.<br><br><font face=/font/big_bold.font>Нажмите @@imv_nrm_activate@@, чтобы подтвердить и завершить упражнение.</font>@@aca_goal_tip@@ Вы можете использовать функцию @@o_im_cam_zoom@@ для лучшего обзора окружающей обстановки. Это особенно полезно при взгляде в зеркало. Проверьте окно настроек - '@@options_bindings_screen@@', чтобы посмотреть и/или изменить соответствующие привязки клавиш."

#@}

#+ Book 1 Scenario 1_03
#@{

#### 1_03 common
	key[]: "aca_scenario_book1_1_03_title"
	val[]: "Первая поездка"

	key[]: "aca_scenario_book1_1_03_desc"
	val[]: "В этом упражнении мы узнаем, как подготовить грузовик к вождению, а затем впервые на нём проедемся."

#### 1_03 goal

	key[]: "aca_goal_book1_1_03_electrics"
	val[]: "Включение зажигания"

	key[]: "aca_goal_book1_1_03_start"
	val[]: "Запуск двигателя"

	key[]: "aca_goal_book1_1_03_look_mirror"
	val[]: "Проверка окружения"

	key[]: "aca_goal_book1_1_03_brake"
	val[]: "Применение рабочего тормоза"

	key[]: "aca_goal_book1_1_03_gear"
	val[]: "Переключение на передачу"

	key[]: "aca_goal_book1_1_03_park_br_off"
	val[]: "Отпускание стояночного тормоза"

	key[]: "aca_goal_book1_1_03_forward"
	val[]: "Движение вперёд"

	key[]: "aca_goal_book1_1_03_stop"
	val[]: "Остановка"

	key[]: "aca_goal_book1_1_03_park_br_on"
	val[]: "Использование стояночного тормоза"

	key[]: "aca_goal_book1_1_03_gear_n"
	val[]: "Переключение на нейтраль"

	key[]: "aca_goal_book1_1_03_end"
	val[]: "Остановка двигателя"

#### 1_03 msg - intro text

	key[]: "aca_msg_book1_1_03_cutscene1"
	val[]: "Для ваших первых поездок мы будем использовать только тягач.<br>Грузовик называется тягачом, если у него нет собственного кузова для грузов, и вместо этого для перевозки товаров и материалов используется прицеп."

	key[]: "aca_msg_book1_1_03_cutscene2"
	val[]: "Тягачи полуприцепов популярны, поскольку они универсальны: они могут отцепить пустой прицеп и тут же зацепить другой, уже загруженный, без необходимости ждать, или могут зацепить прицеп с другим типом кузова."

	key[]: "aca_msg_book1_1_03_cutscene3"
	val[]: "Во время вашей первой поездки ваша задача будет заключаться в том, чтобы проехать вперёд и остановиться после пунктирной линии.<br>Запустите двигатель и следуйте инструкциям, чтобы подготовить грузовик к движению. Подготовившись, двигайтесь прямо."

	key[]: "aca_msg_book1_1_03_cutscene4"
	val[]: "Двигайтесь за пунктирную линию, остановитесь, поставьте грузовик на стояночный тормоз и заглушите двигатель."

#### 1_03 Driving Instructions

	key[]: "aca_msg_book1_1_03_electrics"
	val[]: "На следующем этапе вашего обучения вы впервые управляете грузовиком.<br><br>Разумеется, без работающего двигателя это не сработает, поэтому сначала необходимо включить зажигание.<br><br><font face=/font/big_bold.font>Нажмите $input engineelect$ чтобы включить зажигание.</font>@@aca_goal_tip@@ В Карьере по умолчанию двигатель включается вместе с бортовой сетью автоматически. Для карьеры вы можете настроить это поведение в настройках — \"Игровой процесс\" — @@auto_engine_start@@."

	key[]: "aca_msg_book1_1_03_start"
	val[]: "Зажигание активирует бортовую сеть грузовика. Вы могли заметить, что на приборной панели мигают контрольные лампы — это нормально. Если они продолжают гореть после запуска двигателя, это, скорее всего, указывает на проблему с грузовиком. Исключением является лампа стояночного тормоза, которая гаснет при его отпускании.<br><br>К счастью, этот грузовик в хорошем состоянии, и мы готовы продолжить работу.<br><br><font face=/font/big_bold.font>Нажмите @@imv_nrm_engine@@, чтобы запустить двигатель. </font>"

	key[]: "aca_msg_book1_1_03_look_mirror"
	val[]: "Теперь, когда двигатель запущен, очень важно проверить окружающую обстановку, прежде чем начинать какое-либо движение.<br><br><font face=/font/big_bold.font>Осмотритесь вокруг грузовика, а также в боковые зеркала со стороны водителя и пассажира, чтобы убедиться, что зона вокруг грузовика свободна.</font>@@aca_goal_tip@@ Вы должны находиться внутри."

	key[]: "aca_msg_book1_1_03_brake"
	val[]: "Это может показаться очевидным, но вы должны знать, как остановиться, прежде чем начинать какое-либо движение.<br><br><font face=/font/big_bold.font>Нажмите тормоз, используя $input backward$. </font>"

	key[]: "aca_msg_book1_1_03_gear_arcade"
	val[]: "Далее вы узнаете, как изменить направление движения.<br><br>С упрощённой автоматической коробкой передач нет необходимости переключать передачи, всё делается автоматически за вас.<font face=/font/big_bold.font><br><br>Используйте $input forward$ для включения передачи переднего хода. </font>"

	key[]: "aca_msg_book1_1_03_gear_automatic"
	val[]: "Далее вы узнаете, как изменить направление движения.<br><br>Реалистичная автоматическая коробка передач позволяет переключаться между движением вперёд, нейтралью и задним ходом, как в настоящей автоматической коробке передач.<br><br><font face=/font/big_bold.font>Нажмите @@imv_nrm_gearup@@ для включения передней передачи. </font>"

	key[]: "aca_msg_book1_1_03_gear_manual"
	val[]: "Далее вы узнаете, как изменить направление движения.<br><br>Секвентальная коробка передач позволяет осуществлять ступенчатое переключение передач, как и настоящие секвентальные коробки передач.<br><br>Точно так же, как вы включаете переднюю передачу, при разгоне вам необходимо будет переключиться на более высокие передачи.<br><br><font face=/font/big_bold.font>Нажмите @@imv_nrm_gearup@@ для включения первой передачи.</font>"

	key[]: "aca_msg_book1_1_03_gear_direct"
	val[]: "Далее вы узнаете, как изменить направление движения.<br><br>С рычагом переключения передач и сцеплением вы испытаете то же ощущение физического переключения передач, что и при использовании настоящей механической коробки передач.<br><br> Полностью выжмите сцепление и тормоз.<font face=/font/big_bold.font>Используйте рычаг переключения передач, чтобы включить первую передачу. <color value=@@clr_txt@@>Держите сцепление и тормоз полностью выжатыми.</font>"

	key[]: "aca_msg_book1_1_03_park_br_off"
	val[]: "Чтобы начать движение, необходимо сначала отпустить стояночный тормоз.<br><br><font face=/font/big_bold.font>Используйте @@imv_nrm_parkingbrake@@ чтобы отпустить стояночный тормоз.</font> @@aca_goal_tip@@ В режиме карьеры стояночный тормоз изначально отключен. Вы можете настроить это поведение в настройках — \"Игровой процесс\" — @@auto_park_brake@@."

	key[]: "aca_msg_book1_1_03_forward_arcade"
	val[]: "Теперь грузовик готов двигаться вперед. Начинайте движение и пересеките пунктирную линию.<br><br><font face=/font/big_bold.font>Начните движение, используя акселератор: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_automatic"
	val[]: "Теперь грузовик готов двигаться вперед. Начинайте движение и пересеките пунктирную линию.<br><br><font face=/font/big_bold.font>Начните движение, используя акселератор: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_manual"
	val[]: "Теперь грузовик готов двигаться вперед. Начинайте движение и пересеките пунктирную линию.<br><br><font face=/font/big_bold.font>Начните движение, используя акселератор: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_direct"
	val[]: "Теперь грузовик готов к движению вперёд. Начните двигаться и пересеките пунктирную линию.<br><br><font face=/font/big_bold.font>Отпустите тормоз, постепенно отпускайте сцепление, чтобы включить его, одновременно нажимая на педаль газа для поддержания высоких оборотов, чтобы грузовик не заглох. Как только сцепление полностью отпущено, вы можете ускориться и переключиться по мере необходимости. </font>"

	key[]: "aca_msg_book1_1_03_stop_arcade"
	val[]: "Для остановки используйте тормоз.<br><br><font face=/font/big_bold.font>Используйте $input backward$, чтобы остановить грузовик. </font>"

	key[]: "aca_msg_book1_1_03_stop_automatic"
	val[]: "Для остановки используйте тормоз.<br><br><font face=/font/big_bold.font>Используйте $input backward$, чтобы остановить грузовик. </font>"

	key[]: "aca_msg_book1_1_03_stop_manual"
	val[]: "Для остановки используйте тормоз.<br><br><font face=/font/big_bold.font>Используйте $input backward$, чтобы остановить грузовик. </font>"

	key[]: "aca_msg_book1_1_03_stop_direct"
	val[]: "Когда вам необходимо остановиться, полностью выжмите сцепление <font face=/font/big_bold.font>, а затем остановите грузовик, используя тормоз.<color value=@@clr_txt@@>Переключитесь на нейтральную передачу с помощью рычага переключения передач, а затем можно отпустить сцепление. </font>"

	key[]: "aca_msg_book1_1_03_park_br_on"
	val[]: "Поставьте грузовик на стояночный тормоз. Это исключит непреднамеренное движение грузовика после того, как вы припарковались.<br><br><font face=/font/big_bold.font>Используйте @@imv_nrm_parkingbrake@@ чтобы активировать стояночный тормоз.</font>"

	key[]: "aca_msg_book1_1_03_gear_n_arcade"
	val[]: "С упрощенной автоматической коробкой передач нет необходимости переключать передачи, всё делается автоматически за вас.<br><br><font face=/font/big_bold.font>Нажмите @@imv_nrm_activate@@, чтобы подтвердить. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>Переключитесь в нейтраль, нажав @@imv_nrm_geardown@@. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>Переключитесь в нейтраль, нажав @@imv_nrm_geardown@@. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>Переведите рычаг переключения передач в нейтраль, затем отпустите сцепление. </font>"

	key[]: "aca_msg_book1_1_03_end"
	val[]: "Теперь вы знаете, как привести грузовик в движение и как безопасно остановить его.<br><br><font face=/font/big_bold.font>Нажмите $input engineelect$, чтобы заглушить двигатель.</font>"
#@}

#+ Book 1 Scenario 1_04
#@{

#### 1_04 common
	key[]: "aca_scenario_book1_1_04_title"
	val[]: "Движение назад"

	key[]: "aca_scenario_book1_1_04_desc"
	val[]: "В этом упражнении мы будем практиковать движение задним ходом. Мы также поговорим о том, как пользоваться зеркалами, на что обращать внимание и как подготовиться к движению задним ходом."

#### 1_04 goal

	key[]: "aca_goal_book1_1_04_start"
	val[]: "Запуск двигателя"

	key[]: "aca_goal_book1_1_04_look_mirror"
	val[]: "Проверка бокового зеркала пассажира"

	key[]: "aca_goal_book1_1_04_look_back"
	val[]: "Проверка бокового зеркала водителя"

	key[]: "aca_goal_book1_1_04_gear_r"
	val[]: "Переключение на передачу"

	key[]: "aca_goal_book1_1_04_park_br_off"
	val[]: "Отпускание стояночного тормоза"
#!{
	key[]: "aca_goal_book1_1_04_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

