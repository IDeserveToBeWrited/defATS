	key[]: "aca_goal_book1_2_08_forward"
	val[]: "Выезд на маршрут"

	key[]: "aca_goal_book1_2_08_check1"
	val[]: "Широкий поворот со шпилькой"

	key[]: "aca_goal_book1_2_08_check2"
	val[]: "Прохождение слалома"

	key[]: "aca_goal_book1_2_08_check3"
	val[]: "Крутой поворот на шпильке"

	key[]: "aca_goal_book1_2_08_check4"
	val[]: "Узкая кривая"

	key[]: "aca_goal_book1_2_08_check6"
	val[]: "Технический участок"

	key[]: "aca_goal_book1_2_08_check7"
	val[]: "Открытый участок"



#### 2_08 msg - intro text

	key[]: "aca_msg_book1_2_08_cutscene1"
	val[]: "В этом упражнении мы проедемся на тягаче по короткому маршртуту, чтобы посмотреть, как вы справитесь с вашими недавно приобретенными навыками.<br>На трассе есть различные типы и комбинации поворотов. Это не гонка, и не испытание на время. Будьте терпеливы и подбирайте скорость движения в зависимости от поворотов и препятствий."

	key[]: "aca_msg_book1_2_08_cutscene2"
	val[]: "Въезжайте на трассу с широким поворотом на шпильке."

	key[]: "aca_msg_book1_2_08_cutscene3"
	val[]: "Далее вас ожидает серия препятствий, образующих неравномерный слалом."

	key[]: "aca_msg_book1_2_08_cutscene4"
	val[]: "После пары простых 90-градусных поворотов, вам предстоит пройти узкую шпильку. Очень важно правильно спозиционировать грузовик так, чтобы и пройти поворот, и плавно выйти на следующий участок."

	key[]: "aca_msg_book1_2_08_cutscene5"
	val[]: "Не забывайте о конусах при прохождении длинного поворота, так как видимость перед капотом ограничена."

	key[]: "aca_msg_book1_2_08_cutscene6"
	val[]: "Ещё один набор барьеров направит вас в широкий слалом."

	key[]: "aca_msg_book1_2_08_cutscene7"
	val[]: "Трасса немного расширяется, но не спешите. Ещё несколько легких поворотов и вы закончите."

	key[]: "aca_msg_book1_2_08_cutscene8"
	val[]: "Остановитесь в обозначенном месте и поставьте грузовик на стояночный тормоз."


#### 2_08 Driving Instructions

	key[]: "aca_msg_book1_2_08_start"
	val[]: "Чтобы успешно завершить это упражнение, вам необходимо избежать столкновения, схода с трассы, и контакта с дорожными конусами.<br><br><font face=/font/big_bold.font>Приготовьтесь к движению. </font>"

	key[]: "aca_msg_book1_2_08_forward"
	val[]:"<font face=/font/big_bold.font>Проезжайте вперёд до поворота с широкой шпилькой, чтобы выйти на трассу. </font>"

	key[]: "aca_msg_book1_2_08_check1"
	val[]: "<font face=/font/big_bold.font>Завершите поворот на шпильке. </font>"

	key[]: "aca_msg_book1_2_08_check2"
	val[]: "Вы приближаетесь к барьерам, расположенным в виде слалома.<br><br><font face=/font/big_bold.font>Откорректируйте скорость и продолжайте движение.</font>"

	key[]: "aca_msg_book1_2_08_check3"
	val[]: "Далее, вам предстоит проехать два простых поворота на 90 градусов, за которыми будет узкая шпилька. Не торопитесь.<br><br><font face=/font/big_bold.font>Двигайтесь в шпильку.</font>"

	key[]: "aca_msg_book1_2_08_check4"
	val[]: "После выхода из шпильки, вас ждёт узкая изогнутая дорога. Держитесь подальше от внутреннего ограждения, но также и не заденьте конусы перед вами.<br><br><font face=/font/big_bold.font>Продолжайте движение через кривую.</font>"

	key[]: "aca_msg_book1_2_08_check6"
	val[]: "Путь впереди состоит из крутых технических поворотов. Контролируйте скорость и внимательно перемещайтесь по участку.<br><br><font face=/font/big_bold.font>Продолжайте движение. </font>"

	key[]: "aca_msg_book1_2_08_check7"
	val[]: "Следующий участок более открытый, с несколькими легкими поворотами. Не спешите.<br><br><font face=/font/big_bold.font>Продолжайте движение. </font>"
#!{
	key[]: "aca_msg_book1_2_08_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_08_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

#@}

