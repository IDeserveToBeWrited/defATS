	val[]: "@@aca_msg_book1_2_01_end@@"
#!}
	key[]: "aca_goal_book1_3_21_check1"
	val[]: "Контрольная точка"

	key[]: "aca_goal_book1_3_21_check2"
	val[]: "Соблюдение правильной дистанции при движении задним ходом"

	key[]: "aca_goal_book1_3_21_stop"
	val[]: "Парковка в обозначенном месте"



#### 3_21 msg - intro text

	key[]: "aca_msg_book1_3_21_cutscene1"
	val[]: "В этом уроке мы рассмотрим парковку под углом 45 градусов. Когда ситуация позволяет, многие предпочитают именно этот способ парковки задним ходом. Если начать движение с прицепа, уже направленного туда, куда вам необходимо, придётся меньше маневрировать, чтобы припарковаться."

	key[]: "aca_msg_book1_3_21_cutscene2"
	val[]: "Такая техника также позволяет видеть дальше в парковочное место, обеспечивая лучшую видимость того, куда вы направляетесь."

	key[]: "aca_msg_book1_3_21_cutscene3"
	val[]: "Двигайтесь мимо места парковки и выставьтесь примерно под углом 45 градусов. Прицеп должен быть направлен на грузовик, стоящий на дальней стороне парковки, куда вы собираетесь въехать задним ходом."

	key[]: "aca_msg_book1_3_21_cutscene4"
	val[]: "Поверните грузовик в сторону от места парковки, чтобы подтолкнуть переднюю часть прицепа, направляя заднюю к месту парковки. Будьте осторожны и не переусердствуйте. Как только вы начнёте поворачивать, легче сделать поворот более резким, чем сделать его шире."

	key[]: "aca_msg_book1_3_21_cutscene5"
	val[]: "Когда прицеп въедет на парковочное место, выставьте тягач перед ним и выровняйтесь."

	key[]: "aca_msg_book1_3_21_cutscene6"
	val[]: "Остановитесь в обозначенном месте и поставьте грузовик на стояночный тормоз."

#### 3_21 Driving Instructions
#!{
	key[]: "aca_msg_book1_3_21_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

	key[]: "aca_msg_book1_3_21_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
	key[]: "aca_msg_book1_3_21_forward"
	val[]: "Слева есть место для парковки. Двигайтесь мимо него и расположитесь под углом 45 градусов.<br><br><font face=/font/big_bold.font>Двигайтесь вперёд. </font>"

	key[]: "aca_msg_book1_3_21_check1"
	val[]: "Выровняйте грузовик в соответствии с разметкой.<br><br><font face=/font/big_bold.font>Остановитесь в обозначенном месте. </font>"

	key[]: "aca_msg_book1_3_21_check2"
	val[]: "Используя знания, полученные в предыдущих сценариях, направьте прицеп на место парковки.<br><br><font face=/font/big_bold.font>Начинайте движение назад. </font>"

	key[]: "aca_msg_book1_3_21_stop"
	val[]: "Продолжайте направлять прицеп к месту парковки.<br><br>@@aca_msg_book1_2_01_stop@@"


#@}

