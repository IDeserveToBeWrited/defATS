#+ Book 3 Scenario urf
#@{

#### urf common
	key[]: "aca_scenario_book3_urf_title"
	val[]: "Тренажер заднего хода"

	key[]: "aca_scenario_book3_urf_desc"
	val[]: "В этом упражнении вы на пустой парковке, чтобы попрактиковать движение задним ходом с двойным прицепом."

#### urf goal

	key[]: "aca_goal_book3_urf_start"
	val[]: "Перед началом движения"

	key[]: "aca_goal_book3_urf_move"
	val[]: "Эксперименты"

	key[]: "aca_goal_book3_urf_stop"
	val[]: "Завершение"

	key[]: "aca_goal_book3_urf_end"
	val[]: "Завершение упражнения"

	#### urf msg - intro text

	key[]: "aca_msg_book3_urf_cutscene1"
	val[]: "Движение задним ходом с двойным прицепом требует гораздо больше внимания, чем с одиночным прицепом. Необходимо заранее спланировать, куда вы хотите направить задний прицеп, при этом не отрывая взгляда от ведущего прицепа и тягача. <br><br>Помните, что вы управляете задним прицепом с помощью переднего. В каком бы направлении вы ни направили передний прицеп, это изменит траекторию заднего."

	key[]: "aca_msg_book3_urf_cutscene2"
	val[]: "В этом случае мы хотим повернуть задний прицеп в сторону водителя. <br><br >Для этого нужно передний прицеп направить в сторону пассажира."

	key[]: "aca_msg_book3_urf_cutscene3"
	val[]: "Именно здесь большинство людей совершают свою первую ошибку. Как только задний прицеп начинает поворачивать, необходимо выровнять тягач с помощью ведущего..."

	key[]: "aca_msg_book3_urf_cutscene4"
	val[]: "...иначе вы так же сложитесь, как этот."

	key[]: "aca_msg_book3_urf_cutscene5"
	val[]: "Складывание происходит, когда угол между любыми двумя сцепками становится равным примерно 90 градусам. Как только это произойдёт, спасения уже не будет - вы должны проехать вперёд и предпринять ещё одну попытку. <br><br>Как и при движении задним ходом с одним прицепом, цель всегда должна заключаться в том, чтобы все колеса прицепов двигались. Если одно колесо останавливается, а прицеп вращается на месте, значит всё закончено."

	key[]: "aca_msg_book3_urf_cutscene6"
	val[]: "Вы можете вернуться к тому месту, где всё было в порядке, или к позиции, с которой вы сможете продолжить движение назад, не повторив ту же ошибку снова, или просто вернуться вперёд, пока не выровняетесь."

	key[]: "aca_msg_book3_urf_cutscene7"
	val[]: "Помните: как только задний прицеп начнёт поворот, выставьте тягач перед ведущим прицепом и дайте заднему прицепу поворачивать самостоятельно в течение некоторого времени."

	key[]: "aca_msg_book3_urf_cutscene8"
	val[]: "Теперь, когда задний прицеп хорошо поворачивает, пора направить за ним ведущий прицеп. Вы можете регулировать угол между ведущим и задним прицепом, чтобы контролировать поворот и делать его более резким или широким."

	key[]: "aca_msg_book3_urf_cutscene9"
	val[]: "Завершающий этап маневра — выравнивание. Нужно выровнять ведущий прицеп с замыкающим в одну линию."

	key[]: "aca_msg_book3_urf_cutscene10"
	val[]: "Стоит помнить о времени, необходимом для перемещения ведущего прицепа, а также о том, что вам нужно будет выровнять тягач."

	key[]: "aca_msg_book3_urf_cutscene11"
	val[]: "Не стесняйтесь проводить здесь столько времени, сколько захотите, экспериментируйте с различными манёврами, пока не получите приблизительное представление о том, как управлять прицепами при движении назад."

#### urf Driving Instructions

	key[]: "aca_msg_book3_urf_start"
	val[]: "Приготовьтесь к началу движения."

	key[]: "aca_msg_book3_urf_move"
	val[]: "Воспользуйтесь этой парковкой, чтобы получить представление о том, как управлять прицепами, двигаясь назад. <br><br>@@aca_goal_tip@@. Впервые пытаетесь двигаться назад? Воспользуйтесь разделом \"Основы вождения грузовика\"."

	key[]: "aca_msg_book3_urf_stop"
	val[]: "Тренируйтесь столько, сколько захотите. <br><br>Когда вы будете удовлетворены, остановитесь и активируйте ручной тормоз, чтобы завершить упражнение."

	key[]: "aca_msg_book3_urf_end"
	val[]: "Заглушите двигатель, чтобы завершить упражнение."
#@}


