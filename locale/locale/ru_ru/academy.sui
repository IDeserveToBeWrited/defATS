#### finex common

	key[]: "aca_scenario_book3_finex_title"
	val[]: "Выпускной экзамен"

	key[]: "aca_scenario_book3_finex_desc"
	val[]: "В этом упражнении вы проверите свои новые навыки на практике, пройдя экзамен, разработанный для проверки вашей точности и понимания управления сцепкой с двумя прицепами."

#### finex goal

	key[]: "aca_goal_book3_finex_check0"
	val[]: "Движение назад"

	key[]: "aca_goal_book3_finex_check1"
	val[]: "Выезд на маршрут"

	key[]: "aca_goal_book3_finex_check2"
	val[]: "Набираем скорость"

	key[]: "aca_goal_book3_finex_check22"
	val[]: "Подготовка к торможению"

	key[]: "aca_goal_book3_finex_speed"
	val[]: "Недостаточная скорость"

