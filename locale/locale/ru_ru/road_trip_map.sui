#+ Washington TBs and POIs localization.
#@{
	key[]: "tb_wa1"
	val[]: "Полуостров Олимпик"

	key[]: "tb_wa1_desc"
	val[]: "Полуостров Олимпик — это место, где океан, леса и горы сосуществуют в постоянно меняющейся красоте. Туман стелется над скалистыми берегами, а водопады низвергаются с высокогорий, где в скрытых долинах находятся небольшие исторические города."

	key[]: "poi_wa1_01"
	val[]: "Историческое здание почты США"

	key[]: "poi_wa1_01_desc"
	val[]: "Возведённое в 1893 году на утёсе над набережной Порт-Таунсенда, это здание изначально проектировалось как федеральное учреждение с таможней. В его облике отразились ранние амбиции города, стремившегося стать крупным центром международной торговли."

	key[]: "poi_wa1_02"
	val[]: "Порт-Анджелес"

	key[]: "poi_wa1_02_desc"
	val[]: "Порт-Анджелес — прибрежный город, основанный в XIX веке как гавань и пункт снабжения. Сегодня он служит главными воротами в национальный парк Олимпик и важным паромным портом, связывающим США и Канаду."

	key[]: "poi_wa1_03"
	val[]: "Озеро Кресент"

	key[]: "poi_wa1_03_desc"
	val[]: "Озеро Кресент — второе по глубине в штате Вашингтон. Оно славится кристально чистой водой насыщенного синего цвета из-за крайне низкого содержания азота. Расположенное в популярной зоне отдыха озеро со всех сторон окружено туристическими тропами и вековыми лесами."
	
	key[]: "poi_wa1_04"
	val[]: "Пляж Калалох"

	key[]: "poi_wa1_04_desc"
	val[]: "Пляж Калалох известен благодаря «Древу жизни» — ситхинской ели с обнажёнными корнями, перекинутыми через небольшой ручей к берегу. В отличие от обычных высоких елей, это дерево ниже, толще и искорёжено ветрами, что делает его уникальной и популярной местной достопримечательностью."

	key[]: "poi_wa1_05"
	val[]: "Национальный парк Олимпик"

	key[]: "poi_wa1_05_desc"
	val[]: "Национальный парк Олимпик сохраняет разнообразные экосистемы — от скалистого тихоокеанского побережья и дождевых лесов умеренного пояса до высокогорных вершин. Получив статус национального памятника в 1909 году, в 1938 году он был официально объявлен федеральным правительством национальным парком."

	key[]: "poi_wa1_06"
	val[]: "Гринхед-Слу"

	key[]: "poi_wa1_06_desc"
	val[]: "Гринхед-Слу — это небольшая заводь и мелководный залив вдоль шоссе 101 неподалёку от бухты Уиллапа. Уникальная среда прибрежного эстуария была восстановлена ради нереста лосося и привлекает любителей понаблюдать за дикими птицами."

	key[]: "poi_wa1_07"
	val[]: "Залив Дабоб"

	key[]: "poi_wa1_07_desc"
	val[]: "Залив Дабоб — глубоководный фьорд, служащий средой обитания для лосося, моллюсков и диких животных. Созданный в 1984 году природный заказник залива Дабоб оберегает редкие растения солончаковых маршей и песчаных кос в составе полноценной приливной экосистемы."


##########################################################################################

	key[]: "tb_wa2"
	val[]: "Сердце штата"

	key[]: "tb_wa2_desc"
	val[]: "Сердце штата Вашингтон манит путешественников проехать по живописным дорогам среди вечнозелёных лесов и тихих высокогорных озёр. Над горизонтом величественно возвышается гора Рейнир, открывая легендарные панорамы и даря спокойное путешествие по просторам Тихоокеанского Северо-Запада."

	key[]: "poi_wa2_01"
	val[]: "Гора Рейнир"

	key[]: "poi_wa2_01_desc"
	val[]: "Гора Рейнир — действующий стратовулкан и высочайшая вершина штата Вашингтон высотой 14 411 футов (4392 м). Её ледники питают реки, вытачивают долины и дают жизнь густым лесам и фауне, делая вулкан главным природным ориентиром региона."

	key[]: "poi_wa2_02"
	val[]: "Национальный лес Уэнатчи"

	key[]: "poi_wa2_02_desc"
	val[]: "Национальный лес Уэнатчи раскинулся среди гор, рек и высокогорных долин. В 1933 году Гражданский корпус охраны окружающей среды проложил здесь туристические тропы и возвёл пожарные вышки, внеся огромный вклад в охрану и туристическое освоение этих мест."

	key[]: "poi_wa2_03"
	val[]: "Национальный лес Маунт Бейкер-Сноквалми"

	key[]: "poi_wa2_03_desc"
	val[]: "В национальном лесе Маунт Бейкер-Сноквалми находятся одни из старейших в США станций мониторинга ледников. Здесь с начала XX века отслеживают движение вулканических льдов и климатические изменения в Каскадных горах."
	
	key[]: "poi_wa2_04"
	val[]: "Река Уэнатчи"

	key[]: "poi_wa2_04_desc"
	val[]: "Вдоль реки Уэнатчи сохранились остатки оросительных каналов и мельниц начала XIX века, наглядно показывающие, как переселенцы обуздывали её воды. А задолго до прихода европейцев эти богатые лососем воды кормили коренные племена и служили основой для торговли."

	key[]: "poi_wa2_05"
	val[]: "Пик Клаватти"

	key[]: "poi_wa2_05_desc"
	val[]: "Впервые покорённый в середине XX века, пик Клаватти и по сей день остаётся редко посещаемым из-за крутых, покрытых ледниками склонов. Это делает его желанной целью для альпинистов, ищущих уединения в Норт-Каскейдс."

	key[]: "poi_wa2_06"
	val[]: "Плотина Драй-Фолс"

	key[]: "poi_wa2_06_desc"
	val[]: "Возведённая для регулирования местных вод, плотина Драй-Фолс расположена на доисторических базальтовых скалах. Контролируя уровень воды, она обнажает террасы и глубокие чаши, выточенные наводнениями ледникового периода."

	key[]: "poi_wa2_07"
	val[]: "Смотровая площадка: пожар на горе Уайт-Маунтин"

	key[]: "poi_wa2_07_desc"
	val[]: "Здесь установлены информационные стенды, рассказывающие о пожаре на горе Уайт-Маунтин 1988 года — одном из крупнейших в новейшей истории штата Вашингтон. Отсюда хорошо видны как оставленные огнём шрамы, так и постепенно возрождающийся лес."

	key[]: "wa_cut_helen_desc"
	val[]: "До 1980 года вулкан Сент-Хеленс имел форму правильного конуса и был известен как «американская Фудзияма». Извержение 1980 года снесло 1300 футов его вершины, оставив гигантский подковообразный кратер, который сегодня частично заполнен лавовым куполом и ледником."


##########################################################################################


	key[]: "tb_wa3"
	val[]: "Винный край"

	key[]: "tb_wa3_desc"
	val[]: "К востоку от Каскадных гор раскинулся винный край штата Вашингтон, охватывающий винодельческую зону (AVA) Долина Колумбия. Этот регион, включающий реку Села-Крик, парк штата Льюис и Кларк и исторические земли коренных народов, встречает гостей сухими солнечными пейзажами с пологими холмами и речными долинами."

	key[]: "poi_wa3_01"
	val[]: "Водопад Клир-Крик"

	key[]: "poi_wa3_01_desc"
	val[]: "Смотровая площадка у водопада Клир-Крик — популярное место для остановки чуть восточнее перевала Уайт-Пасс. Примерно через милю к востоку находится съезд к зоне отдыха Клир-Лейк, которая славится отличной рыбалкой и возможностью понаблюдать за дикой природой."

	key[]: "poi_wa3_02"
	val[]: "Мост Села-Крик"

	key[]: "poi_wa3_02_desc"
	val[]: "Мост имени Фреда Г. Редмона, также известный как Села-Крик — это двухпролётный арочный мост в округе Якима. На момент открытия он являлся самым длинным сооружением такого типа в США и самым высоким автомобильным мостом в штате."

	key[]: "poi_wa3_03"
	val[]: "Виноградники"
	
	key[]: "poi_wa3_03_desc"
	val[]: "Долины и плодородная почва штата Вашингтон отлично подходят для винограда — рислинга, каберне и мерло. Виноградники играют важную роль в сельском хозяйстве штата и формируют его живописные пейзажи."

	key[]: "poi_wa3_04"
	val[]: "Мост Эда Хендлера"

	key[]: "poi_wa3_04_desc"
	val[]: "Построенный в 1978 году мост, также известный как Межгородской, перекинут через реку Колумбия между городами Паско и Кенневик на юго-востоке штата Вашингтон. С момента открытия он считается знаковой достопримечательностью и символом агломерации Три-Ситис."

	key[]: "poi_wa3_05"
	val[]: "Парк штата Льюис и Кларк"

	key[]: "poi_wa3_05_desc"
	val[]: "Один из старейших в Вашингтоне, парк штата Льюис и Кларк сберегает реликтовые леса вдоль исторического пути коренных народов. Названный в честь Корпуса открытий, он хранит первозданный облик тех лесов, которые Мериуэзер Льюис когда-то описывал в своих путевых дневниках."

	key[]: "poi_wa3_06"
	val[]: "Здание суда округа Колумбия"

	key[]: "poi_wa3_06_desc"
	val[]: "Здание суда округа Колумбия напоминает об эпохе, когда местное самоуправление играло ключевую роль в повседневной жизни. Во времена бурного роста и слабой связи со столицей штата именно суды были главным источником власти и напрямую решали насущные вопросы жителей."

	key[]: "poi_wa3_07"
	val[]: "Племена коренных народов"

	key[]: "poi_wa3_07_desc"
	val[]: "Долина реки Колумбия и её окрестности издревле были домом для коренных народов, в том числе племён якама, валла-валла и юматилла. Сегодня их общины продолжают жить в этом регионе, бережно сохраняя культурные традиции и управляя земельными и водными ресурсами края."

##########################################################################################

#@}




#+ Oregon TBs and POIs localization.
#@{
	key[]: "tb_or1"
	val[]: "Тихоокеанское побережье"

	key[]: "tb_or1_desc"
	val[]: "Тихоокеанское побережье штата Орегон встречает скалистыми мысами с живописными обзорными точками. Пока маяк Хесета-Хед возвышается над бушующими волнами, базальтовые утёсы Силвер-Пойнт, зоны отдыха Офир-Вейсайд, скал Систерс-Рокс и Киссинг-Рок встают вдоль пути навстречу океанскому прибою."

	key[]: "landmark_or_astoria_b_desc"
	val[]: "Этот четырёхмильный мост через реку Колумбия связывает штаты Орегон и Вашингтон, открывая великолепные виды на устье реки и просторы Тихого океана."

	key[]: "poi_or1_01"
	val[]: "Смотровая площадка Силвер-Пойнт"

	key[]: "poi_or1_01_desc"
	val[]: "Расположенная к югу от Кэннон-Бич, эта смотровая площадка открывает захватывающий вид на утёс Хейстек и скалистое побережье, особенно впечатляющее в лучах заката."

	key[]: "or_cut_lighthouse_desc"
	val[]: "Самый высокий маяк штата Орегон, построенный в 1873 году, возвышается на базальтовом мысе неподалёку от Ньюпорта."

	key[]: "or_cut_newport_desc"
	val[]: "Мост через залив Яквина, построенный в 1936 году, — одна из самых узнаваемых достопримечательностей побережья штата Орегон. Созданный по проекту знаменитого инженера Конде Маккалоу, он перекинут изящной аркой через залив и остаётся визитной карточкой шоссе US 101."

	key[]: "or_cut_thor_desc"
	val[]: "Естественная воронка на мысе Перпетуа, куда с грохотом обрушиваются накатывающие волны, создавая иллюзию, будто океан утекает в бездну."

	key[]: "poi_or1_02"
	val[]: "Офир Уэйсайд"

	key[]: "poi_or1_02_desc"
	val[]: "Тихая площадка для отдыха неподалёку от Голд-Бич, где путешественники могут размяться с дороги, полюбоваться прибоем или побродить по пляжу в поисках агатов и причудливых коряг."

	key[]: "poi_or1_03"
	val[]: "Смотровая площадка Систерс-Рок"

	key[]: "poi_or1_03_desc"
	val[]: "Прибрежные скалы выступают прямо из волн, а сбегающие вниз тропы ведут к укромным пляжам, укрытым среди отвесных утёсов."

	key[]: "poi_or1_04"
	val[]: "Скала Киссинг-Рок"

	key[]: "poi_or1_04_desc"
	val[]: "Придорожная площадка к югу от Голд-Бич, где две массивные скалы склоняются друг к другу над песчаным берегом, — излюбленное место для памятных фотографий."


##########################################################################################

	key[]: "tb_or2"
	val[]: "Дикий Восток"

	key[]: "tb_or2_desc"
	val[]: "Этот край, нередко именуемый «Диким Востоком» Орегона, открывает взору ландшафты, созданные геологическими силами за сотни миллионов лет. Многие из этих процессов продолжаются по сей день. В сравнении с этим история человека кажется краткой, но полной событий не менее впечатляющих, чем сам край."

	key[]: "landmark_or_deadman_p_desc"
	val[]: "Около города Пендлтон с этой смотровой площадки открывается вид на перевал Дедмен. Название восходит к Баннокской войне 1870-х, когда здесь погиб возница. А за несколько десятилетий до этого через эти холмы по Орегонской тропе непрерывно шли караваны повозок."

	key[]: "or_cut_395_desc"
	val[]: "Трасса US 395, некогда известная как «Шоссе трёх флагов», тянулась от Канады до Мексики, связывая воедино пустыни, леса и горные хребты. Сегодня она заканчивается у магистрали I-15 в Калифорнии, хотя участки исторического маршрута сохранились около Сан-Диего."

	key[]: "poi_or2_01"
	val[]: "Национальный лес Малур"

	key[]: "poi_or2_01_desc"
	val[]: "Национальный лес Малур раскинулся в Голубых горах. Более 150 миллионов лет назад древнейшие породы этого края входили в состав вулканических островов в Тихом океане, которые позже стали частью материка."
	
	key[]: "poi_or2_02"
	val[]: "Заповедная зона Бедлендс"

	key[]: "poi_or2_02_desc"
	val[]: "Заповедная зона Бедлендс к востоку от Бенда — это суровый вулканический край, сформированный древними лавовыми потоками и пеплом. Причудливые формы из застывшей лавы, песчаные почвы и пустынный рельеф создают одну из самых самобытных высокогорных пустынь штата."

	key[]: "poi_or2_03"
	val[]: "Озеро Аберт"

	key[]: "poi_or2_03_desc"
	val[]: "Впервые нанесённое на карту в 1843 году, озеро Аберт привлекало человека более 10 000 лет. Из-за высокой солёности здесь не водится рыба, однако это крайне важная остановка для птиц на Тихоокеанском пролётном пути. В последние десятилетия из-за изменения климата оно стремительно мелеет."

	key[]: "poi_or2_04"
	val[]: "Маршрут «Восточный Стинс»"

	key[]: "poi_or2_04_desc"
	val[]: "Маршрут «Восточный Стинс» проходит по трассе 78 вдоль одноимённой горы и пустыни Алворд. Его главное украшение — высохшее озеро в пустыне Алворд, одно из крупнейших в штате Орегон, которое в зависимости от сезона превращается то в мелкий водоём, то в бескрайнюю пустынную равнину."

	key[]: "poi_or2_05"
	val[]: "Спуск Доэрти"

	key[]: "poi_or2_05_desc"
	val[]: "Поездка по спуску Доэрти — скальному массиву вулканического происхождения — занимает меньше часа. Однако природе потребовалось около 16 миллионов лет, чтобы этот ландшафт обрёл свой нынешний облик."


##########################################################################################

	key[]: "tb_or3"
	val[]: "Земля Огдена"

	key[]: "tb_or3_desc"
	val[]: "Этот маршрут пролегает по внутреннему коридору Орегона с севера на юг, пересекая лесные массивы и высокогорную пустыню. Впервые исследованный торговцем пушниной Питером Скином Огденом в 1820-х годах, во время Второй мировой войны стал стратегически важным из-за заготовок леса и дорожного сообщения."
	
	key[]: "poi_or3_01"
	val[]: "Скульптура «Пламя Спрингфилда»"

	key[]: "poi_or3_01_desc"
	val[]: "Эта скульптура высотой почти 65 футов (20 метров) украшает северный въезд в Спрингфилд. Созданная в форме пламени, она служит дорожным маяком для путешественников и узнаваемым символом как для жителей, так и для гостей города."

	key[]: "poi_or3_02"
	val[]: "Гужевая дорога Сантиам"

	key[]: "poi_or3_02_desc"
	val[]: "Перевал к востоку отсюда, некогда названный в честь Эндрю Уайли, был разведан в 1859 году первопроходцами в поисках путей к пастбищам. В 1864 году здесь планировали проложить военную дорогу, но проект остался на бумаге. С 1868 по 1914 год здесь действовала платная гужевая дорога Сантиам."

	key[]: "poi_or3_03"
	val[]: "Историческое шоссе ветеранов"

	key[]: "poi_or3_03_desc"
	val[]: "У северного въезда на трассу, к югу от Биггс-Джанкшен, 9 ноября 2012 года установили два последних из 18 памятных знаков. Они отмечают Кэмп-Руфус как северную точку первого в стране шоссе, посвящённого ветеранам Второй мировой войны."

	key[]: "poi_or3_04"
	val[]: "Обзорная точка имени Огдена"

	key[]: "poi_or3_04_desc"
	val[]: "Эта обзорная точка названа в честь Питера Скина Огдена — исследователя начала XIX века и старшего торговца Компании Гудзонова залива. Она хранит память о его экспедициях по бассейну реки Снейк и его роли в освоении района Большого Солёного озера."

	key[]: "landmark_or_fremont_b_desc"
	val[]: "Мост и улица Фримонт в Портленде названы в честь Джона Ч. Фримонта — исследователя земель Лас-Калифорниас и Орегонского региона. Обладает самым длинным основным пролётом в штате Орегон и занимает второе место в мире среди арочных мостов с затяжкой."

	
##########################################################################################

#@}



#+ California TBs and POIs localization.
#@{
	key[]: "tb_ca1"
	val[]: "Золотой горизонт"

	key[]: "tb_ca1_desc"
	val[]: "Легендарные мосты возвышаются над сверкающей гладью вод, связывая Алькатрас, Санта-Круз, окрестные холмы и городские кварталы. От оживлённых улиц и исторических достопримечательностей до залитых солнцем пляжей и живописного побережья — область Залива дарит ни с чем не сравнимый калифорнийский колорит."

	key[]: "ca_cut_golden_gate_bridge_desc"
	val[]: "Этот мост над проливом между заливом Сан-Франциско и Тихим океаном, — легендарный символ Сан-Франциско и всей Калифорнии. На момент открытия в 1937 году он удерживал мировые рекорды как самый длинный и самый высокий подвесной мост на планете."

	key[]: "poi_ca1_01"
	val[]: "Алькатрас"

	key[]: "poi_ca1_01_desc"
	val[]: "С 1934 по 1963 год на острове Алькатрас действовала федеральная тюрьма. Когда-то здесь отбывали заключение самые опасные и известные преступники страны, а сегодня это исторический памятник и популярное туристическое место."

	key[]: "ca_cut_richmond_desc"
	val[]: "Мост Ричмонд — Сан-Рафаэль пересекает залив Сан-Франциско, соединяя оба этих города. Открытый в 1956 году, этот мост с консольно-ферменной конструкцией обеспечивает движение на севере залива и остаётся важнейшей дорогой региона."
	
	key[]: "poi_ca1_02"
	val[]: "Трежер-Айленд"

	key[]: "poi_ca1_02_desc"
	val[]: "Искусственный остров Трежер-Айленд был насыпан специально для Всемирной выставки «Золотые Ворота» 1939 года. После закрытия расположенной здесь военно-морской базы его начали застраивать жилыми кварталами и коммерческими объектами."

	key[]: "poi_ca1_03"
	val[]: "Город сёрфинга"

	key[]: "poi_ca1_03_desc"
	val[]: "Памятник сёрферу в Санта-Крузе посвящён богатым традициям и культуре этого спорта. Установленная у самого побережья, он посвящён местным покорителям волн и сёрфингу, который сформировал неповторимый облик и образ жизни этого прибрежного города."

	key[]: "poi_ca1_04"
	val[]: "«Мадонна Инн»"

	key[]: "poi_ca1_04_desc"
	val[]: "Некогда популярный ресторан и площадка для мероприятий на вершине шоссе 152. Закрытое с 2004 года из-за проблем с трассой, заведение до сих пор остаётся частой темой в местных хрониках и на форумах о привидениях."



##########################################################################################

	key[]: "tb_ca2"
	val[]: "Маршрут Шаста"

	key[]: "tb_ca2_desc"
	val[]: "Этот маршрут петляет среди сосновых лесов и сверкающих высокогорных озёр у подножия горы Шаста. Дорога то взбирается на подъёмы, то спускается в укромные долины, уводя путешественников на юг, где горы постепенно отступают, сменяясь древними секвойями Северной Калифорнии."

	key[]: "poi_ca2_01"
	val[]: "Национальный лес Шаста-Тринити"

	key[]: "poi_ca2_01_desc"
	val[]: "Через Шаста-Тринити — крупнейший национальный лес Калифорнии — пролегает живописная дорога «Наследие Тринити». Маршрут повторяет пути, которыми в XIX веке пользовались золотоискатели и первые переселенцы."

	key[]: "poi_ca2_02"
	val[]: "Большая лагуна"

	key[]: "poi_ca2_02_desc"
	val[]: "Большая лагуна — самая крупная и южная из трёх лагун парка штата Гумбольдт-Лагунс. Эти мелководные прибрежные водоёмы расположены между скалистыми мысами, где океанские волны намыли песчаные косы, отделившие их от Тихого океана."

	key[]: "or_cut_sequoia_desc"
	val[]: "Национальный парк Редвуд оберегает одни из самых высоких и древних секвой на планете: их высота превышает 370 футов (110 метров), а возраст достигает 2000 лет. Вместе с соседними парками штата он сохраняет около 35% всех уцелевших на Земле реликтовых секвойных лесов."
	
	key[]: "poi_ca2_03"
	val[]: "Река Смит"

	key[]: "poi_ca2_03_desc"
	val[]: "Эту заповедную зону в лесу Сикс-Риверс на северо-западе Калифорнии Конгресс учредил в 1990 году для сохранения её ландшафтной, экологической и культурной ценности. Смит — единственная крупная река Калифорнии со свободным течением, не перекрытая ни одной плотиной."

	key[]: "poi_ca2_04"
	val[]: "Мост Уиски-Крик"

	key[]: "poi_ca2_04_desc"
	val[]: "Построенный в 1961 году мост Уиски-Крик представляет собой трёхпролётную конструкцию со сварными балками. Он известен как один из первых примеров в мостостроении, где применили сразу три разные марки стали — передовую для того времени технологию сварки."

	key[]: "poi_ca2_05"
	val[]: "Озеро Шаста"

	key[]: "poi_ca2_05_desc"
	val[]: "Озеро Шаста — крупнейшее водохранилище Калифорнии, образованное плотиной Шаста на реке Сакраменто. Завершённая в 1945 году, она обеспечивает штат водой и электроэнергией и служит живописным уголком для отдыха."

	key[]: "poi_ca2_06"
	val[]: "Гора Шаста"

	key[]: "poi_ca2_06_desc"
	val[]: "С 1820-х годов гора Шаста — вторая по высоте вершина Каскадных гор — служила главным ориентиром для путников на тропе Сискию у её подножия. Позже этот исторический путь превратился в автомагистраль I-5, по которой к горе ежегодно проезжают тысячи путешественников."



##########################################################################################

	key[]: "tb_ca3"
	val[]: "Перевал через Сьерру"

	key[]: "tb_ca3_desc"
	val[]: "У подножия величественной Сьерра-Невады, среди просторных долин и холмов, расположился отель Inn at Benton. Этот маршрут петляет по тихим дорогам высокогорной пустыни, где далёкие вершины и скалистые гряды складываются в неподвластную времени панораму, открывая путь к бескрайним просторам региона."

	key[]: "ca_cut_olmsted_point_desc"
	val[]: "Основанный в 1890 году Йосемитский национальный парк — один из самых посещаемых в США. Он славится водопадом Йосемите (высочайшим в Северной Америке), разветвлённой сетью туристических троп и гигантскими секвойями возрастом более 3000 лет."

	key[]: "poi_ca3_01"
	val[]: "Шоссе Тайога"

	key[]: "poi_ca3_01_desc"
	val[]: "Это культовый живописный маршрут, проходящий через самое сердце Йосемитского национального парка. Это самый высокогорный автомобильный перевал в Калифорнии, соединяющий западную и восточную части Сьерра-Невады."

	key[]: "poi_ca3_02"
	val[]: "Озеро Моно"

	key[]: "poi_ca3_02_desc"
	val[]: "Озеро Моно существует уже более миллиона лет и считается одним из древнейших в Северной Америке. Не имея естественного стока, этот бессточный водоём за долгие тысячелетия накопил огромное количество солей и минералов, принесённых ручьями с восточных склонов Сьерра-Невады."
	
	key[]: "poi_ca3_03"
	val[]: "Озеро Тахо"

	key[]: "poi_ca3_03_desc"
	val[]: "Озеро Тахо образовалось около 2 миллионов лет назад в котловине Тахо, а его нынешний облик сформировали древние ледники. Это крупнейшее высокогорное озеро Северной Америки и второе по глубине в США."

	key[]: "poi_ca3_04"
	val[]: "Национальный лес Эльдорадо"

	key[]: "poi_ca3_04_desc"
	val[]: "Национальный лес Эльдорадо — часть важнейшего водосборного бассейна, который снабжает водой миллионы жителей Калифорнии и питает фермерские хозяйства, производящие почти половину всех фруктов и овощей в стране."

	key[]: "poi_ca3_05"
	val[]: "Гостиница «Бентон-Хот-Спрингс»"

	key[]: "poi_ca3_05_desc"
	val[]: "Бентон, один из старейших посёлков округа Моно, был основан у горячих источников индейцами племени пайютов. В 1860-е годы он стал стоянкой для старателей и первопроходцев. Гостиница из местной пемзы, построенная в 1940-х годах, заменила старый отель 1904 года с десятью комнатами и одной общей ванной."



##########################################################################################

	key[]: "tb_ca4"
	val[]: "Пески и солнце"

	key[]: "tb_ca4_desc"
	val[]: "Пустыня Долины Смерти раскинулась под бескрайним небом — среди барханов, зубчатых хребтов и растрескавшейся земли. По раскалённым пескам скачут пустынные зайцы, черепа отмечают безмолвные тропы, а пустынные дороги петляют по суровому краю, испытывая на прочность и восхищая каждого, кто решился на этот путь."

	key[]: "poi_ca4_01"
	val[]: "Лоун-Пайн"

	key[]: "poi_ca4_01_desc"
	val[]: "Лоун-Пайн — небольшой городок в калифорнийской долине Оуэнс, у восточного подножия Сьерра-Невады. Знаменитый расположенными поблизости холмами Алабама-Хиллс, он давно служит отправной точкой для туристов, альпинистов и кинематографистов, исследующих окрестные горы и пустынные пейзажи."

	key[]: "poi_ca4_02"
	val[]: "Национальный парк «Долина Смерти»"

	key[]: "poi_ca4_02_desc"
	val[]: "Долина Смерти — один из самых экстремальных уголков Америки: самое низкое, жаркое и засушливое место на континенте, где при этом высятся крутые горные пики. Задолго до переселенцев XIX века здесь жили коренные племена, занимаясь охотой и собирательством в этих суровых, но исторически богатых краях."

	key[]: "poi_ca4_03"
	val[]: "Панорама «Отец Кроули»"

	key[]: "poi_ca4_03_desc"
	val[]: "Эта панорама у западной границы парка — популярное место остановки. Священник Джон Дж. Кроули, известный как «пустынный падре», часто отдыхал здесь. Отсюда открывается впечатляющий вид на Радужный каньон — разноцветное ущелье, сформированное древней вулканической активностью."
	
	key[]: "poi_ca4_04"
	val[]: "Вэлли-Уэллс (Мохаве)"

	key[]: "poi_ca4_04_desc"
	val[]: "В местечке Вэлли-Уэллс в пустыне Мохаве отложения древних источников хранят следы болот ледникового периода. Эти старинные колодцы напоминают о временах, когда грунтовые воды питали топи и буйную растительность посреди ныне засушливой пустыни."

	key[]: "poi_ca4_05"
	val[]: "Индейская резервация Колорадо-Ривер"

	key[]: "poi_ca4_05_desc"
	val[]: "Резервация раскинулась вдоль реки Колорадо на территории штатов Аризона и Калифорния. Основанная в 1865 году для прибрежных племён, сегодня она служит домом для народов мохаве, чемеуэви, хопи и навахо, обеспечивая развитие сельского хозяйства и сохраняя уклад местной общины."

##########################################################################################

#@}



#+ Idaho TBs and POIs localization.
#@{

    key[]: "tb_id1"
	val[]: "Трежер-Вэлли"

	key[]: "tb_id1_desc"
	val[]: "Долина Трежер-Вэлли на юго-западе Айдахо хранит богатую историю, которую создавали коренные племена, первые торговцы пушниной и переселенцы Орегонской тропы. Название отражает изобилие ресурсов и возможностей края, а дальнейшему развитию региона способствовали сельское хозяйство, железные дороги и торговля вокруг города Бойсе."

	key[]: "poi_id1_01"
	val[]: "Река Салмон"

	key[]: "poi_id1_01_desc"
	val[]: "Река Салмон в штате Айдахо протянулась на 425 миль (684 км) сквозь глубокий скалистый каньон. Своё прозвище «Река без возврата» она получила из-за того, что старинные лодки не могли подняться обратно вверх по течению против её бурного и мощного потока."

	key[]: "poi_id1_02"
	val[]: "Национальный лес Бойсе"

	key[]: "poi_id1_02_desc"
	val[]: "Расположенный на подверженном эрозии батолите Айдахо, национальный лес Бойсе отличается суровым рельефом, сформированным вулканической активностью. Это геологическое наследие ярче всего заметно в глубоких каньонах и многочисленных горячих источниках на всей его территории."

	key[]: "poi_id1_03"
	val[]: "Хорсшу-Бенд"

	key[]: "poi_id1_03_desc"
	val[]: "После того как в 1862 году в бассейне Бойсе нашли золото, зимовавшие у реки старатели основали Хорсшу-Бенд. Поначалу посёлок назывался Уорринерсвилл в честь владельца местной лесопилки, а своё нынешнее имя получил в 1867 году, став важным перевалочным пунктом для золотоискателей."
	
	key[]: "poi_id1_04"
	val[]: "Застава Толл-Гейт"

	key[]: "poi_id1_04_desc"
	val[]: "В 1864 году новая дорога через каньон пришла на смену крутой тропе Сироп-Крик. 20 лет сборы за проезд шли на её обслуживание, а знаменитая гостиница и молочная ферма Джеймса А. Портера стали излюбленным местом стоянки для путешественников."

	key[]: "poi_id1_05"
	val[]: "Касл-Рок"

	key[]: "poi_id1_05_desc"
	val[]: "На пути к Камас-Прери гранитные выступы скалы Касл-Рок служили главным ориентиром для переселенцев Орегонской тропы на пути Гудейла. Этот маршрут использовался с 1862 года до появления первых автомобилей, а редкие скальные формы впечатляли путников своим видом."

    key[]: "poi_id1_06"
	val[]: "Индейская резервация Дак-Вэлли"

	key[]: "poi_id1_06_desc"
	val[]: "В 1886 году президент Кливленд расширил резервацию Дак-Вэлли на территорию Айдахо с помощью указа о «расширении Пэдди-Кэпа». К 1934 году переселившиеся сюда разрозненные группы получили официальное федеральное признание как единое племенное объединение шошонов и пайютов."


##########################################################################################

    key[]: "tb_id2"
	val[]: "Мэджик-Вэлли"

	key[]: "tb_id2_desc"
	val[]: "В начале 1900-х годов Ай. Би. Перрайн превратил засушливую пустыню Айдахо в плодородные пашни, построив плотину Милнер. Построенная в 1905 году дамба использовала воды реки Снейк, чтобы «по волшебству» преобразить здешние земли. Это создало регион Мэджик-Вэлли и привело к расцвету фермерских городков, живущих и сегодня."

	key[]: "id_cut_perrine_desc"
	val[]: "Возвышаясь на 212 футов (65 метров), водопад Шошони на реке Снейк превосходит даже Ниагарский. Эта живописная природная достопримечательность находится прямо на окраине города Твин-Фолс."

	key[]: "id_cut_galena_desc"
	val[]: "Основанный в 1879 году благодаря открытию свинцово-серебряных руд, этот шахтерский посёлок угас к 1890-м годам из-за падения цен. Сегодня эти места стали центром туризма, где гостей встречают старинный отель «Галена-Лодж» и соседний живописный перевал Галена-Саммит."

	key[]: "poi_id2_01"
	val[]: "Бизоний обрыв"

	key[]: "poi_id2_01_desc"
	val[]: "Расположенный около городка Чаллис Бизоний обрыв — это историческое место, где коренные народы загоняли стада к обрыву для охоты. Использовавшаяся более 2000 лет, эта природная ловушка позволяет прикоснуться к древним традициям коллективной охоты."
	
	key[]: "poi_id2_02"
	val[]: "Каньон Гранд-Вью"

	key[]: "poi_id2_02_desc"
	val[]: "Каньон Гранд-Вью, расположенный на шоссе US-93 вдоль живописного маршрута «От вершин к кратерам», открывает потрясающий вид на хребет Лост-Ривер. В этой горной цепи возвышаются девять высочайших пиков Айдахо, что делает каньон одной из главных жемчужин панорамной дороги."

	key[]: "landmark_id_mackay_rs_desc"
	val[]: "Изначально названная рекой Годдина в честь траппера Тьери Годдина, река Биг-Лост известна тем, что исчезает в лавовых пластах. Эта «потерянная» вода течёт глубоко под землёй и в итоге вновь выходит на поверхность у потрясающих источников Таузанд-Спрингс около реки Снейк."

    key[]: "poi_id2_03"
	val[]: "Города-призраки Маккея"

	key[]: "poi_id2_03_desc"
	val[]: "Возникшие на «Шахтовом холме» в горнорудном районе Уайт-Ноб, такие городки, как Уайт-Ноб и Клифф-Крик, подпитывали бум добычи меди, золота и серебра вплоть до середины XX века. Сегодня эти места остаются важными памятниками горного дела в Айдахо."

	key[]: "id_cut_craters_desc"
	val[]: "Созданный вулканическими извержениями 15 000 лет назад, массив «Кратеры Луны» представляет собой бескрайний ландшафт из застывших лавовых потоков и шлаковых конусов. Его инопланетный рельеф настолько уникален, что астронавты НАСА тренировались здесь перед полётами на Луну."



##########################################################################################

#@}



#+ Montana TBs and POIs localization.
#@{

    key[]: "tb_mt1"
	val[]: "Ледниковый проход"

	key[]: "tb_mt1_desc"
	val[]: "В Ледниковом крае сохранились одни из последних действующих ледников Скалистых гор. На протяжении тысячелетий эти древние толщи льда прорезали глубокие долины, вытачивали острые пики и наполняли первозданные озёра, сформировав неповторимый ландшафт современной западной Монтаны."

	key[]: "poi_mt1_01"
	val[]: "Водопад Кутеней"

	key[]: "poi_mt1_01_desc"
	val[]: "Водопад Кутеней — крупнейший не перекрытый плотиной водопад в штате Монтана и главная достопримечательность региона. На коротком отрезке река Кутеней сбрасывает около 300 футов (91 м) высоты, образуя мощный живописный каскад, который привлекает путешественников незабываемыми видами."

	key[]: "poi_mt1_02"
	val[]: "Придорожный парк Берн"

	key[]: "poi_mt1_02_desc"
	val[]: "Каньон Бэд-Рок был популярным местом стоянки на реке Флатхед, известным рыбалкой, панорамными видами и природным источником, где когда-то охлаждали перегревшиеся радиаторы машин. В 1956 году он стал одной из первых площадок отдыха в Монтане под названием «Придорожный парк Берн»."

	key[]: "poi_mt1_03"
	val[]: "Пик Хевенс"

	key[]: "poi_mt1_03_desc"
	val[]: "Пик Хевенс, одна из самых узнаваемых вершин национального парка Глейшер, получил своё имя в 1890-х годах от старателя Луи Мейера. Поражённые красотой этой горы и возвышающимся рядом гребнем Гарден-Уолл, исследователи отмечали, что не видели ничего подобного за всё своё путешествие."

	key[]: "mt_cut_glacier_national_park_desc"
	val[]: "Национальный парк Глейшер, известный как «Корона континента», был основан в 1910 году. Этот край, сформированный древними ледниками, открылся для массового туризма в 1932 году с завершением строительства трассы «К солнцу» — признанного шедевра инженерной мысли."

	key[]: "poi_mt1_04"
	val[]: "Мемориал племени черноногих"

	key[]: "poi_mt1_04_desc"
	val[]: "У восточной границы национального парка Глейшер раскинулись земли племени черноногих. Прозванные «воинами равнин», они, как считается, получили своё название из-за мокасин, потемневших от пепла. Сегодня многие места на территории парка по-прежнему почитаются ими как священные."

	key[]: "mt_cut_flathead_lake_desc"
	val[]: "Озеро Флатхед — крупнейшее по площади естественное пресноводное озеро в континентальной части США. Питаемое талыми снегами с окрестных гор, оно славится кристально чистой водой, которая полностью обновляется всего за несколько лет, делая Флатхед одним из самых чистых крупных озёр в мире."

	key[]: "mt_cut_thompson_falls_desc"
	val[]: "Названный в честь британско-канадского торговца пушниной и картографа Дэвида Томпсона, город вырос с появлением железной дороги в 1881 году. Он расширился ещё сильнее во время золотой лихорадки в Кёр-д’Алене, превратившись в важную стоянку для золотоискателей, шедших по тропе Мюррея."

	key[]: "landmark_mt_missoula_desc"
	val[]: "Неоклассическое здание суда округа Миссула из песчаника, спроектированное архитектором Эй Джеем Гибсоном в 1910 году, пришло на смену более скромной прежней постройке. Округ Миссула, основанный ещё в 1860 году, — один из старейших административных регионов Монтаны, простирающийся от хребта Биттеррут до Скалистых гор."

    key[]: "poi_mt1_05"
	val[]: "Лоло-Крик"

	key[]: "poi_mt1_05_desc"
	val[]: "Участок пути между Лоло и перевалом Лоло-Пасс повторяет исторический маршрут вдоль ручья Лоло-Крик. Бывший некогда дорогой для племени не-персе, ранних поселенцев и экспедиции Льюиса и Кларка, этот район остаётся важным культурным памятником с тематическими информационными площадками."

##########################################################################################

    key[]: "tb_mt2"
	val[]: "Великие равнины"

	key[]: "tb_mt2_desc"
	val[]: "Великие равнины Монтаны простираются по всей восточной части штата, встречая путешественников бескрайними просторами, холмистыми прериями и необъятным открытым небом. Именно здесь были найдены одни из важнейших окаменелостей динозавров в Северной Америке, позволяющие заглянуть в мир, существовавший миллионы лет назад."

	key[]: "poi_mt2_01"
	val[]: "Формация Хелл-Крик"

	key[]: "poi_mt2_01_desc"
	val[]: "Формация Хелл-Крик, сосредоточенная вдоль ручья Хелл-Крик около города Джордан в штате Монтана, хранит память о древнем субтропическом мире рек, лесов и болот. Возникнув 67–66 миллионов лет назад, она всемирно известна богатейшими находками окаменелостей динозавров, среди которых и знаменитый тираннозавр рекс."

	key[]: "poi_mt2_02"
	val[]: "Река Йеллоустоун"

	key[]: "poi_mt2_02_desc"
	val[]: "Река Йеллоустон — самая длинная свободно текущая река в континентальной части США. Беря начало в национальном парке Йеллоустон, она течёт 676 миль (1088 км) по территории штатов Вайоминг и Монтана и впадает в Миссури, не имея на всём своём протяжении ни единой плотины."

	key[]: "poi_mt2_03"
	val[]: "Глендизавр"

	key[]: "poi_mt2_03_desc"
	val[]: "Глендизавр, статуя трицератопса в натуральную величину в Глендайве, напоминает о богатом палеонтологическом наследии региона. Имея высоту в 10 футов (3 м), она является излюбленной достопримечательностью туристов вдоль «Тропы динозавров»."
	
	key[]: "poi_mt2_04"
	val[]: "Река Миссури"

	key[]: "poi_mt2_04_desc"
	val[]: "Река Миссури, известная под прозвищем «Биг-Мадди» («Большая мутная»), — самая длинная река в США. Преодолевая 2341 милю (3767 км) от Скалистых гор Монтаны до слияния с Миссисипи, она сыграла важнейшую роль в исследованиях, торговле и освоении американского фронтира."

	key[]: "mt_cut_fort_peck_spillway_desc"
	val[]: "Плотина Форт-Пек, построенная в годы Великой депрессии, — крупнейшая в мире намывная земляная плотина. Будучи одним из крупнейших проектов общественных сооружений в Америке, она была призвана создать рабочие места, сдерживать наводнения и вырабатывать электроэнергию."

    key[]: "poi_mt2_05"
	val[]: "Музей первопроходцев округа Валли"

	key[]: "poi_mt2_05_desc"
	val[]: "Музей раскрывает историю северо-восточной Монтаны с помощью выставок о народе ассинибойнов, железных дорогах, земледелии, плотине Форт-Пек и экспедиции Льюиса и Кларка. В нём также собраны богатые архивы и одна из самых больших коллекций предметов культуры ассинибойнов в стране."

	key[]: "poi_mt2_06"
	val[]: "Камень «Спящий бизон»"

	key[]: "poi_mt2_06_desc"
	val[]: "Эти крупные ледниковые валуны были священными ориентирами для индейских племён. Древние ледники обточили и переместили их. Меньший камень, «Бизон», был обтёсан в виде фигуры бизона, а на более крупном, «Медисин-Рок», сохранились различные петроглифы."



##########################################################################################

#@}



#+ Wyoming TBs and POIs localization.
#@{

    key[]: "tb_wy1"
	val[]: "Тропа Бизонов"

	key[]: "tb_wy1_desc"
	val[]: "Место, где расположены национальные парки Йеллоустон и Гранд-Титон. Стоит на действующей вулканической системе, питающей гейзеры и горячие источники, а ледники и тектонические разломы сформировали его пики и долины. Вместе эти природные силы превратили северо-запад штата Вайоминг в один из самых геологически динамичных и узнаваемых ландшафтов американского Запада."

	key[]: "landmark_wy_yellowsto_desc"
	val[]: "Йеллоустон, основанный в 1872 году как первый в мире национальный парк, расположен над гигантским спящим вулканом. Здесь находится половина всех гейзеров планеты, а под охраной парка находится одна из крупнейших и наиболее сохранившихся экосистем умеренного пояса на Земле."

	key[]: "poi_wy1_01"
	val[]: "Нижний бассейн гейзеров"

	key[]: "poi_wy1_01_desc"
	val[]: "Нижний бассейн гейзеров — самый обширный в Йеллоустоне. В нём сосредоточено огромное количество гейзеров, горячих источников и фумарол. Питаемый жаром глубинного магматического очага, он представляет собой один из наиболее активных геотермальных уголков парка."

	key[]: "poi_wy1_02"
	val[]: "Озеро Йеллоустон"

	key[]: "poi_wy1_02_desc"
	val[]: "Озеро Йеллоустон — крупнейшее высокогорное озеро Северной Америки; здесь обитает самая большая на континенте популяция дикой красногорлой форели. Учёные считают, что в прошлом озеро имело сток в Тихий океан, что позволило рыбе преодолеть Континентальный водораздел через перевал Двух Океанов."
	
	key[]: "poi_wy1_03"
	val[]: "Плотина Баффало-Билл"

	key[]: "poi_wy1_03_desc"
	val[]: "Построенная в 1910 году плотина Баффало-Билл стала одной из первых бетонных арочных плотин в США. Имея высоту 325 футов (99 м), она стала самой высокой плотиной в мире на тот момент и выдающимся памятником инженерного искусства."

	key[]: "poi_wy1_04"
	val[]: "Ад Колтера"

	key[]: "poi_wy1_04_desc"
	val[]: "«Ад Колтера» — историческая геотермальная зона вдоль реки Шошони, названная в честь первопроходца Джона Колтера в 1807 году. Ранние маунтинмены окрестили это место «адом» из-за клубящихся струй пара и запаха серы. Сегодня активными здесь остаются лишь горячие источники и фумаролы."

	key[]: "wy_cut_grand_teton_desc"
	val[]: "Облик нацпарка Гранд-Титон определяют выточенные ледниками пики, резко вздымающиеся над долиной Джексон-Хоул. Прозванные трапперами «Вершинами-ориентирами» за отличную видимость с дальних равнин, эти горы остаются одной из самых узнаваемых достопримечательностей американского Запада."

	key[]: "poi_wy1_05"
	val[]: "Кроухарт-Бьютт"

	key[]: "poi_wy1_05_desc"
	val[]: "Кроухарт-Бьютт — приметная гора, названная в память о битве 1866 года между племенами шошонов и кроу. Согласно преданию, после победы шошонов их вождь Вашаки водрузил сердце поверженного предводителя кроу на вершину скалы в качестве грозного предостережения, что и дало этой горе её имя."

##########################################################################################

    key[]: "tb_wy2"
	val[]: "Красная пустыня"

	key[]: "tb_wy2_desc"
	val[]: "Красная пустыня Вайоминга — огромная высокогорная котловина с созданными ветром песчаными дюнами, полынными степями и эффектными красными скалами. Будучи одной из крупнейших необитаемых территорий Северной Америки, она сформирована суровым климатом, котловинами древних озёр и протяжёнными путями миграции животных."

	key[]: "poi_wy2_01"
	val[]: "Красный каньон"

	key[]: "poi_wy2_01_desc"
	val[]: "Красный каньон сформировался при поднятии хребта Уинд-Ривер около 60 миллионов лет назад. Его характерные красные обрывы состоят из пород Чагуотер, где окисленное железо даёт каньону яркий цвет, вдохновивший его название."

	key[]: "poi_wy2_02"
	val[]: "Ландшафты силы"

	key[]: "poi_wy2_02_desc"
	val[]: "Скала «Клык вепря», возвышающаяся более чем на 400 футов (120 м) над Красной пустыней Вайоминга, представляет собой разрушенное эрозией ядро вулкана, возникшего миллионы лет назад. Она возвышается над просторами дюн Киллпекер, части самого большого поля действующих дюн в Северной Америке."

	key[]: "poi_wy2_03"
	val[]: "Рок-Спрингс"

	key[]: "poi_wy2_03_desc"
	val[]: "Рок-Спрингс известен как «Город 56 национальностей» благодаря своему богатому иммигрантскому наследию. В конце XIX века сюда со всего мира съезжались люди для работы на угольных шахтах компании «Юнион Пасифик». Город также тесно связан с именем знаменитого разбойника Бутча Кэссиди."
	
	key[]: "poi_wy2_04"
	val[]: "Хижина Бутча Кэссиди"

	key[]: "poi_wy2_04_desc"
	val[]: "Бутч Кэссиди — знаменитый американский разбойник, возглавлявший «Дикую банду», которая прославилась ограблениями поездов и банков на Диком Западе. Своё прозвище «Бутч» он получил во время работы в мясной лавке городка Рок-Спрингс. Самым легендарным и громким преступлением банды стало ограбление поезда в Уилкоксе в 1899 году."

	key[]: "wy_cut_evanston_desc"
	val[]: "Основанный в 1869 году железнодорожной компанией «Юнион Пасифик», Эванстон назван в честь геодезиста Джеймса А. Эванса. Город вырос как железнодорожный узел, а со временем превратился в региональный центр сельского хозяйства, добычи нефти и газа."

    key[]: "poi_wy2_05"
	val[]: "Прямой путь Ландера"

	key[]: "poi_wy2_05_desc"
	val[]: "Построенный после Закона о фургонных дорогах к Тихому океану 1857 года, прямой путь Ландера был одной из первых дорог на американском Западе с федеральным финансированием. Названная в честь инженера Фредерика У. Ландера, она открыла более короткий путь для переселенцев, двигавшихся на запад."

	

##########################################################################################

#@}


#+ South Dakota TBs and POIs localization.
#@{

    key[]: "tb_sd1"
	val[]: "Блэк-Хилс"

	key[]: "tb_sd1_desc"
	val[]: "Облик запада Южной Дакоты определяют регион Блэк-Хилс и пустоши Бэдлендс. Здесь бескрайние прерии сменяются поросшими сосной горами и гранитными пиками, среди которых бродят стада бизонов. А чуть дальше раскинулись суровые Бэдлендс — поразительный ландшафт, выточенный ветром и водой за миллионы лет."

	key[]: "poi_sd1_01"
	val[]: "Национальный лес Блэк-Хилс"

	key[]: "poi_sd1_01_desc"
	val[]: "Известный индейцам лакота как Паха-Сапа, что означает «Чёрные холмы», этот сосновый край является домом для пика Блэк-Элк — высшей точки Южной Дакоты, достигающей 7244 футов (2208 м). Переименованный в честь знаменитого целителя лакота, он является самой высокой вершиной к востоку от Скалистых гор."

	key[]: "sd_cut_rush_desc"
	val[]: "Гора Рашмор, известная как «Святилище демократии», создавалась в гранитных скалах массива Блэк-Хиллс с 1927 по 1941 год. Мемориал представляет собой 60-футовые (18-метровые) скульптурные портреты президентов Вашингтона, Джефферсона, Рузвельта и Линкольна, которые символизируют рождение, расширение, развитие и сохранение нации."

	key[]: "poi_sd1_02"
	val[]: "Мост Бивер-Крик"

	key[]: "poi_sd1_02_desc"
	val[]: "Построенный в 1929 году, этот 225-футовый (68 м) арочный мост из стали и бетона пересекает каньон около нацпарка Уинд-Кейв. Поднимаясь на 115 футов (35 м) над дном ущелья, он остаётся единственным подобным мостом в Южной Дакоте и был спроектирован так, чтобы органично сливаться с окружающими скалами."

	key[]: "sd_cut_sturgis_desc"
	val[]: "Стерджис знаменит проведением крупнейшего в мире мотоциклетного ралли. Основанный в 1938 году местным дилером мотоциклов Indian «Паппи» Хулом, этот ежегодный 10-дневный фестиваль собирает в холмах Блэк-Хиллс байкеров со всего света ради мотошоу, гонок, живой музыки и праздничной атмосферы."

	key[]: "sd_cut_deadwood_desc"
	val[]: "Дедвуд возник в разгар золотой лихорадки в Блэк-Хиллс 1876 года и стал одним из самых одиозных городков Дикого Запада. В 1961 году он был объявлен Национальным историческим памятником: это единственный город в США с таким статусом, что позволило сохранить большую часть его исторического центра."

	key[]: "sd_cut_badlands_desc"
	val[]: "Национальный парк Бэдлендс охватывает 244 000 акров (около 990 км²) плосковершинных гор, скальных башен и шпилей, соседствующих с крупнейшей в США охраняемой разнотравной прерией. Здесь залегает один из богатейших в мире слоёв окаменелостей, хранящий следы древних млекопитающих Великих равнин."

	key[]: "poi_sd1_03"
	val[]: "Тоннель Доана Робинсона"

	key[]: "poi_sd1_03_desc"
	val[]: "Доан Робинсон, известный как «отец горы Рашмор», задумал создать грандиозный монумент в холмах Блэк-Хиллс для привлечения путешественников в Южную Дакоту. Сегодня его наследие продолжает жить, а гора Рашмор идеально обрамляется сводами живописного тоннеля Доана Робинсона."

	key[]: "sd_cut_hot_springs_desc"
	val[]: "Хот-Спрингс, который индейцы сиу изначально нарекли «Миннекахта» («тёплые воды»), был основан в 1879 году вокруг минеральных источников с целебными свойствами. Переименованный в 1882 году, он стал бальнеологическим курортом и сохраняет известность благодаря исторической купальне «Эванс Пландж»."

	key[]: "poi_sd1_04"
	val[]: "Музей «Мамонт-Сайт»"

	key[]: "poi_sd1_04_desc"
	val[]: "«Мамонт Сайт» — это всемирно известное место палеонтологических раскопок ледникового периода, где обнаружены останки 61 мамонта. Открытый в 1974 году древний провал хранит крупнейшую в Северной Америке коллекцию костей колумбийских мамонтов, а исследования ведутся здесь и по сей день."

##########################################################################################

    key[]: "tb_sd2"
	val[]: "Великий раздел"

	key[]: "tb_sd2_desc"
	val[]: "Бассейн реки Миссури делит Южную Дакоту на широкие равнины и холмистый край. Этот регион служил ключевым коридором для коренных народов, торговцев пушниной и экспедиции Льюиса и Кларка, а со временем стал местом строительства крупных плотин, приграничных городов и активного речного судоходства."

	key[]: "poi_sd2_01"
	val[]: "Четыре Великих озера"

	key[]: "poi_sd2_01_desc"
	val[]: "Образованные плотинами на реке Миссури в конце 1940-х годов, озёра Оахи, Шарп, Фрэнсис-Кейс и Льюис-энд-Кларк определяют нынешний облик центральной части Южной Дакоты. Вместе эти водохранилища образуют более 440 миль (свыше 700 км) береговой линии для рыбалки, лодочных прогулок и активного отдыха."

	key[]: "poi_sd2_02"
	val[]: "Город-призрак Бангор"

	key[]: "poi_sd2_02_desc"
	val[]: "Бангор некогда являлся центром округа Уолворт, однако стал городом-призраком после того, как в 1899 году все его здания переместили в близлежащий Селби. Сегодня лишь памятник отмечает место, где когда-то стоял этот город."

	key[]: "landmark_sd_state_capitol_desc"
	val[]: "Основанный в 1880 году, Пирр стал столицей Южной Дакоты после вхождения штата в состав Союза в 1889 году. Выбранный из-за центрального положения и переправы через Миссури, он был назван в честь франко-американского торговца пушниной Пьера Шото-мл."

	key[]: "sd_cut_corn_desc"
	val[]: "«Кукурузный дворец» в Митчелле — единственный в мире дворец, целиком украшенный кукурузой. Каждый год местные художники и фермеры создают новые панно из разноцветных природных початков, злаков и трав, превращая здание в одну из самых самобытных достопримечательностей Южной Дакоты."

	key[]: "landmark_sd_largest_pheasant_desc"
	val[]: "В городе Хьюрон находится «Самый большой в мире фазан» — 40-футовая (около 12 м) скульптура из стали и стекловолокна, возведённая в 1959 году. Памятник весом 22 тонны прославляет давнюю славу региона как одного из главных центров охоты на фазанов в Америке."

	key[]: "landmark_sd_dignity_of_earth_and_sky_desc"
	val[]: "«Достоинство земли и неба» — это 50-футовая (15-метровая) скульптура из нержавеющей стали, возвышающаяся над рекой Миссури около города Чемберлен. Созданный художником Дейлом Ламфером монумент воспевает наследие, стойкость и культуру индейских народов лакота и дакота."

##########################################################################################

#@}
