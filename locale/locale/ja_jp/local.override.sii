#+ Text deviations for American Truck Simulator. Please, use only terms appropriate for USA (i.e. culture specific nuances, not American English).
#@{

#+ Music/radio player
#@{

#+ Hint shown if no music files are found. Also shown as tooltip when hovering over music_player button.

	key[]: "music_player_hint"
	val[]: "<color value=@@clr_sel@@>Documents<color value=@@clr_txt@@> フォルダの <color value=@@clr_sel@@>American Truck Simulator/music<color value=@@clr_txt@@> フォルダへ音楽ファイルを置くとここに一覧表示されます."

#+ Tooltip shown when hovering over the radio_stream button.

	key[]: "radio_hint"
	val[]: "<color value=@@clr_sel@@>Documents<color value=@@clr_txt@@> フォルダの <color value=@@clr_sel@@>American Truck Simulator<color value=@@clr_txt@@> フォルダ内にある <color value=@@clr_sel@@>live_streams.sii<color value=@@clr_txt@@> を編集して, ゲーム内でお気に入りのラジオストリームを聴きましょう!"

#+ Hint shown if no online radio streams are defined.

	key[]: "empty_radio_hint"
	val[]: "ラジオ放送の追加方法は, <color value=@@clr_sel@@>Documents<color value=@@clr_txt@@> の <color value=@@clr_sel@@>American Truck Simulator <color value=@@clr_txt@@> フォルダ内にある <color value=@@clr_sel@@>readme.rtf <color value=@@clr_txt@@> を参照してください."
#@}

