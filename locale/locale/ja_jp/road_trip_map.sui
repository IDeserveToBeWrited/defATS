#+ Washington TBs and POIs localization.
#@{
	key[]: "tb_wa1"
	val[]: "オリンピック半島"

	key[]: "tb_wa1_desc"
	val[]: "オリンピック半島は、海、森、山が共存し、刻々と変化する美しさを湛えた場所です。岩だらけの海岸には霧が漂い、高地からは滝が轟音を立てて流れ落ち、その隠れた谷間には歴史ある小さな町々がひっそりと点在しています。"

	key[]: "poi_wa1_01"
	val[]: "歴史的な合衆国郵便局"

	key[]: "poi_wa1_01_desc"
	val[]: "1893年にポートタウンゼンドのウォーターフロントを見下ろす崖の上に完成したこの建物は、税関を併設した連邦施設として設計され、国際貿易の新興拠点として台頭しつつあった当時の同市の意気込みを感じさせます。"

	key[]: "poi_wa1_02"
	val[]: "ポートエンジェルス"

	key[]: "poi_wa1_02_desc"
	val[]: "ポートエンジェルスは、19世紀に港湾および補給拠点として設立された沿岸都市です。現在では、オリンピック国立公園への主要な玄関口として、また米国とカナダを結ぶフェリーの港として役割を担っています。"

	key[]: "poi_wa1_03"
	val[]: "クレセント湖"

	key[]: "poi_wa1_03_desc"
	val[]: "ワシントン州で二番目に深い湖であるクレセント湖は、窒素濃度が低いことで生まれる鮮やかな青色の透き通った水で知られています。人気のレクリエーションエリアに位置し、周囲には遊歩道や原生林が広がっています。"
	
	key[]: "poi_wa1_04"
	val[]: "カラロック・ビーチ"

	key[]: "poi_wa1_04_desc"
	val[]: "カラロック・ビーチは、「生命の木」として知られるシトカトウヒで有名です。この木は、小さな小川を跨いで岸まで伸びる露出した根が特徴的です。一般的な背の高いトウヒとは異なり、背は低く、幹は太く、風で曲がりくねった姿をしているため、地元でも人気の高い特徴的なランドマークとなっています。"

	key[]: "poi_wa1_05"
	val[]: "オリンピック国立公園"

	key[]: "poi_wa1_05_desc"
	val[]: "オリンピック国立公園は、険しい太平洋沿岸や温帯雨林から高山帯の峰々に至るまで、多様な生態系を保護しています。1909年に初めて「国定記念物」に指定され、1938年に連邦政府によって「国立公園」に指定されました。"

	key[]: "poi_wa1_06"
	val[]: "グリーンヘッド・スラウ"

	key[]: "poi_wa1_06_desc"
	val[]: "グリーンヘッド・スラウは、ウィラパ湾近くのハイウェイ101号線沿いにある小さな入り江であり、湿地の水路です。サケの産卵を支え、多くの水鳥を観察できるよう復元された沿岸河口域の生息地に位置しています。"

	key[]: "poi_wa1_07"
	val[]: "ダボブ湾"

	key[]: "poi_wa1_07_desc"
	val[]: "ダボブ湾は、サケや貝類、野生生物が生息する深いフィヨルドです。1984年に指定された「ダボブ湾自然保護区」は、機能性の高い潮間帯湿地システム内に広がる、希少な塩性湿地や砂州の植生群落を保護しています。"


##########################################################################################

	key[]: "tb_wa2"
	val[]: "ハートランド"

	key[]: "tb_wa2_desc"
	val[]: "ワシントン州のハートランドでは、常緑樹の森や穏やかな高山湖を縫う絵のように美しい道路が、旅行者を誘います。地平線にそびえ立つレーニア山は、象徴的な景色を呈し、太平洋岸北西部の自然景観の中での穏やかな旅を約束してくれます。"

	key[]: "poi_wa2_01"
	val[]: "レーニア山"

	key[]: "poi_wa2_01_desc"
	val[]: "標高14,411フィートを誇るワシントン州最高峰のレーニア山は、活火山である成層火山です。その氷河は河川に水を供給し、谷を形成し、豊かな森林と野生生物を支えており、重要な自然のランドマークとなっています。"

	key[]: "poi_wa2_02"
	val[]: "ワナッチー国有林"

	key[]: "poi_wa2_02_desc"
	val[]: "ワナッチー国有林は、山々や河川、高山帯の谷にまたがる広大な森林です。1933年には市民保全部隊がこの地に遊歩道や火災監視所を整備し、森林のレクリエーションや自然保護の発展に大きく貢献しました。"

	key[]: "poi_wa2_03"
	val[]: "ベイカー山・スノコルミー国有林"

	key[]: "poi_wa2_03_desc"
	val[]: "ベイカー山・スノクォルミー国有林には、アメリカでも最古の氷河観測地点がいくつかあります。これらの観測地点では、1900年代初頭からカスケード山脈の氷河の流れや気候変動が観測され続けています。"
	
	key[]: "poi_wa2_04"
	val[]: "ワナッチー川"

	key[]: "poi_wa2_04_desc"
	val[]: "ウェナチー川沿いには、19世紀初頭の灌漑用水路や水車の跡が残っており、開拓者たちがこの川の水を利用していた様子がうかがえます。また、ヨーロッパ人による入植よりずっと以前から、先住民の部族たちも、サケが豊富なこの川の水を食料や交易の手段として頼りにしていました。"

	key[]: "poi_wa2_05"
	val[]: "クラワッティ・ピーク"

	key[]: "poi_wa2_05_desc"
	val[]: "20世紀半ばに初登頂されたクラワッティ・ピークは、氷河に覆われた急峻な斜面のため、現在も登る者が極めて少なく、ノース・カスケード山脈で人里離れた場所を求める登山家たちにとって、憧れの目標となっています。"

	key[]: "poi_wa2_06"
	val[]: "ドライフォールズ・ダム"

	key[]: "poi_wa2_06_desc"
	val[]: "地域の水路を管理するために建設されたドライフォールズ・ダムは、先史時代の玄武岩の断崖の上に位置しており、季節ごとの水流を調節すると同時に、氷河期の洪水によって削り出された段丘や滝壺を露わにしています。"

	key[]: "poi_wa2_07"
	val[]: "ホワイト・マウンテン火災展望台"

	key[]: "poi_wa2_07_desc"
	val[]: "この展望台には、ワシントン州の近年の歴史上最大級の山火事の一つである1988年のホワイト・マウンテン火災に関する解説看板が設置されており、森林に残された傷跡や再生の跡を見ることができます。"

	key[]: "wa_cut_helen_desc"
	val[]: "1980年以前、セント・ヘレンズ山は円錐形をしており、「アメリカの富士山」と呼ばれていました。1980年の噴火により、山頂の1,300フィートが削り取られ、馬蹄形の火口が形成されました。現在、その火口の一部は溶岩ドームと氷河で埋まっています。"


##########################################################################################


	key[]: "tb_wa3"
	val[]: "ワインカントリー"

	key[]: "tb_wa3_desc"
	val[]: "カスケード山脈の東側に位置するワシントン州のワインカントリーは、コロンビア・バレーAVAに広がっています。この地域にはセラ・クリーク、ルイス・アンド・クラーク州立公園、先住民が古くから暮らしてきた土地などがあり、乾燥した晴れの日が多く、なだらかな丘陵や川の谷間が広がる景観が特徴です。"

	key[]: "poi_wa3_01"
	val[]: "クリア・クリーク・フォールズ"

	key[]: "poi_wa3_01_desc"
	val[]: "クリア・クリーク・フォールズ展望台は、ホワイト・パス・サミットのすぐ東にある人気の立ち寄りスポットです。そこからさらに東へ約１マイル進むと分岐点があり、クリア・レイク・レクリエーションエリアへと続きます。このエリアは、釣りが楽しめるほか、地元の野生動物を観察する絶好の場所としても知られています。"

	key[]: "poi_wa3_02"
	val[]: "セラ・クリーク橋"

	key[]: "poi_wa3_02_desc"
	val[]: "フレッド・Ｇ・レッドモン橋、別名セラ・クリーク橋は、ヤキマ郡にあるツインアーチ構造の橋です。完成当時、これはアメリカで最も長いコンクリートアーチ橋であり、同州で最も高い自動車用橋でした。"

	key[]: "poi_wa3_03"
	val[]: "ブドウ畑"
	
	key[]: "poi_wa3_03_desc"
	val[]: "ワシントン州の谷間と肥沃な土壌は、リースリング、カベルネ、メルローなど、さまざまな品種のブドウが栽培されています。これらのブドウ畑は、同州の農業および地域の景観において重要な役割を果たしています。"

	key[]: "poi_wa3_04"
	val[]: "エド・ヘンドラー橋"

	key[]: "poi_wa3_04_desc"
	val[]: "1978年に建設されたこの橋は、「インターシティ・ブリッジ」とも呼ばれ、ワシントン州南東部のパスコとケニウィックの間を流れるコロンビア川に架かっています。開通以来、トリシティズのランドマークであり、その象徴として親しまれています。"

	key[]: "poi_wa3_05"
	val[]: "ルイス・アンド・クラーク州立公園"

	key[]: "poi_wa3_05_desc"
	val[]: "ワシントン州で最も早く設立された州立公園の一つであるルイス・アンド・クラーク州立公園は、先住民が古くから利用してきたルート沿いの原生林を保護しています。ルイス・クラーク探検隊に敬意を表して名付けられたこの公園の森林は、メリウェザー・ルイスが日記に記した鬱蒼とした森を彷彿とさせます。"

	key[]: "poi_wa3_06"
	val[]: "コロンビア郡庁舎"

	key[]: "poi_wa3_06_desc"
	val[]: "コロンビア郡庁舎は、郡政府が人々の暮らしの中心を担っていた時代を今に伝えています。急速な成長を遂げながらも州都とのつながりが限られていた当時、郡庁舎は行政の中心として、市民のさまざまなニーズに応えていました。"

	key[]: "poi_wa3_07"
	val[]: "ネイティブ・アメリカンの部族"

	key[]: "poi_wa3_07_desc"
	val[]: "コロンビア・バレーとその周辺地域には、ヤカマ族、ワラワラ族、ウマティラ族をはじめとする先住民族が暮らしていました。現在も、これらのコミュニティはこの地域に暮らし続け、文化的伝統を守りながら、土地や水資源の管理を行っています。"

##########################################################################################

#@}




#+ Oregon TBs and POIs localization.
#@{
	key[]: "tb_or1"
	val[]: "太平洋沿岸"

	key[]: "tb_or1_desc"
	val[]: "オレゴン州の太平洋沿岸は、風光明媚な展望スポットが点在する険しい岬が連なっています。ヘセタ・ヘッド灯台が打ち寄せる波を見下ろし、シルバー・ポイント、オフィル・ウェイサイド、シスターズ・ロックス、キッシング・ロックスなどでは、玄武岩の断崖が太平洋に面してそびえ立っています。"

	key[]: "landmark_or_astoria_b_desc"
	val[]: "コロンビア川に4マイルにわたって架かるこの橋は、オレゴン州とワシントン州を結び、川の河口や太平洋の水平線を望むことができます。"

	key[]: "poi_or1_01"
	val[]: "シルバー・ポイント観光展望台"

	key[]: "poi_or1_01_desc"
	val[]: "キャノン・ビーチのすぐ南に位置するこの展望台からは、ヘイスタック・ロックや険しい海岸線の雄大な風景を一望でき、特に夕暮れ時は息をのむほど美しい景色を観ることができます。"

	key[]: "or_cut_lighthouse_desc"
	val[]: "1873年に建設されたオレゴン州で最も高い灯台であり、ニューポート近郊の玄武岩の岬にそびえ立っています。"

	key[]: "or_cut_newport_desc"
	val[]: "1936年に完成したヤキーナ・ベイブリッジは、オレゴン州を代表する海岸沿いのランドマークの一つです。著名な技師であるコンデ・マッカローによって設計されたその優雅なアーチはヤキーナ湾に架かり、今もなおアメリカ国道101号線の象徴的な存在となっています。"

	key[]: "or_cut_thor_desc"
	val[]: "パーペチュア岬にある天然の陥没穴です。ここに押し寄せる波が崩れ落ちる様子は、見る者にまるで海の水が引き去っていくかのような錯覚を与えます。"

	key[]: "poi_or1_02"
	val[]: "オフィール・ウェイサイド"

	key[]: "poi_or1_02_desc"
	val[]: "ゴールド・ビーチの近くにある静かな休憩スポットです。ここでは休憩したり、波を眺めたり、ビーチを散策して流木やメノウを探したりできます。"

	key[]: "poi_or1_03"
	val[]: "シスターズ・ロック展望台"

	key[]: "poi_or1_03_desc"
	val[]: "波打ち際から迫力のある景観をなす沖合の海食柱がそびえ立ち、崖の間に隠れた小さなビーチへと続く小道が伸びています。"

	key[]: "poi_or1_04"
	val[]: "キッシング・ロック"

	key[]: "poi_or1_04_desc"
	val[]: "ゴールドビーチの南にある道沿いの立ち寄りスポットです。砂浜の上で２つの巨大な岩が互いに寄り添うようにそびえ立ち、人気の撮影スポットとなっています。"


##########################################################################################

	key[]: "tb_or2"
	val[]: "ワイルド・イースト"

	key[]: "tb_or2_desc"
	val[]: "しばしば「オレゴンのワイルド・イースト」と呼ばれるこの地域の地形は、数億年にわたる地質学的作用によって形作られ、その多くが今もなお活動しています。その途方もない時間のスケールに比べれば、人類の歴史は短いものです。しかしそこには、大地そのものに劣らぬ数多くのドラマチックな瞬間が刻まれています。"

	key[]: "landmark_or_deadman_p_desc"
	val[]: "ペンドルトンの近くにあるこの展望スポットからは、デッドマン・パスの景色を一望できます。この峠の名前は、1870年代のバノック戦争中に、荷馬車の御者が遺体となって発見された事件に由来しています。その数十年前には、オレゴン・トレイル沿いに無数の荷馬車がこれらの丘を越えていました。"

	key[]: "or_cut_395_desc"
	val[]: "かつて「スリー・フラッグス・ハイウェイ」として知られていたUS-395号線は、カナダからメキシコまで伸び、砂漠、森林、山々をつないでいました。現在ではカリフォルニア州のI-15号線で終点となっていますが、サンディエゴ近郊にはかつてのルートの名残が残っています。"

	key[]: "poi_or2_01"
	val[]: "マルール国有林"

	key[]: "poi_or2_01_desc"
	val[]: "マルール国有林はブルー・マウンテンズに位置しています。1億5000万年以上前、この地域で最も古い岩石の一部は太平洋上の火山島を構成していましたが、後に大陸と合体しました。"
	
	key[]: "poi_or2_02"
	val[]: "バッドランズ・ウィルダネス"

	key[]: "poi_or2_02_desc"
	val[]: "ベンドのすぐ東に位置するバッドランズ・ウィルダネスは、太古の溶岩流と風で運ばれた火山灰によって形作られた、荒々しい火山地形です。ねじれた溶岩の造形、砂質の土壌、そして荒涼とした地形が、この州で最も独特な高地砂漠環境の一つを形成しています。"

	key[]: "poi_or2_03"
	val[]: "アバート湖"

	key[]: "poi_or2_03_desc"
	val[]: "1843年に初めて地図に記されたアバート湖は、１万年以上にわたり人々の生活を支えてきました。高すぎる塩分濃度のため魚は生息していませんが、太平洋沿岸の渡り鳥たちにとっては依然として重要な中継地となっています。ここ数十年は気候変動の影響で湖の面積は縮小し続けています。"

	key[]: "poi_or2_04"
	val[]: "イースト・スティーンズ・ツアールート"

	key[]: "poi_or2_04_desc"
	val[]: "イースト・スティーンズ・ツアールートは、スティーンズ山とアルヴォード砂漠沿いのハイウェイ78号線をたどるルートです。このルートの見どころは、オレゴン州最大級の干湖床の一つであるアルヴォード砂漠のプラヤ（乾湖）で、季節によって浅い湖と広大な砂漠の平原へと姿を変えます。"

	key[]: "poi_or2_05"
	val[]: "ドハティ・スライド"

	key[]: "poi_or2_05_desc"
	val[]: "火山活動によって形成された岩層「ドハティ・スライド」車で1時間足らずで走り抜けられます。しかし、自然が現在のこの景観を形作るのに要した時間は、およそ1,600万年にも及びます。"


##########################################################################################

	key[]: "tb_or3"
	val[]: "オグデン・ステート"

	key[]: "tb_or3_desc"
	val[]: "このルートは、オレゴン州内陸部を南北に走り、森林や高地砂漠を通り抜けます。1820年代に毛皮商人のピーター・スキーン・オグデンによって初めて探検され、その後、第二次世界大戦中には、その木材資源と交通路の重要性が認められ、戦略的価値を帯びるようになりました。"
	
	key[]: "poi_or3_01"
	val[]: "スプリングフィールド・フレイム"

	key[]: "poi_or3_01_desc"
	val[]: "高さ約65フィートあるこの彫刻は、スプリングフィールドの北の玄関口にそびえ立ち、旅人にとっては道しるべとして、また住民や観光客にとってはランドマークとなるよう、炎をモチーフにデザインされています。"

	key[]: "poi_or3_02"
	val[]: "サンティアム・ワゴン・ロード"

	key[]: "poi_or3_02_desc"
	val[]: "この場所の東にある峠は、1859年に放牧ルートを探していた開拓者たちによって調査され、かつてはアンドルー・ワイリーにちなんで「ワイリー・パス」と呼ばれていました。1864年には軍用道路の建設が計画されましたが、実際には完成に至りませんでした。有料道路である「サンティアム・ワゴン・ロード」は、1868年から1914年まで運営されていました。"

	key[]: "poi_or3_03"
	val[]: "ベテラン・ヒストリック・ハイウェイ"

	key[]: "poi_or3_03_desc"
	val[]: "この道路の北側の入口であるビッグス・ジャンクションの南側で、2012年11月9日、18基ある記念看板のうち最後の2基が設置されました。これらの看板は、キャンプ・ルーファスが、第二次世界大戦の退役軍人に捧げられた全米初のハイウェイの北側の入口であることを示しています。"

	key[]: "poi_or3_04"
	val[]: "オグデン州立展望台"

	key[]: "poi_or3_04_desc"
	val[]: "19世紀初頭の探検家であり、ハドソンズ・ベイ・カンパニーの取引主任であったピーター・スキーン・オグデンにちなんで名付けられたこの道端の記念碑は、スネーク川流域を横断した彼の遠征と、グレートソルト湖盆地を最初に探検した人物の一人としての彼の功績を称えています。"

	key[]: "landmark_or_fremont_b_desc"
	val[]: "この橋とポートランドのフレモント・ストリートは、ラス・カリフォルニアスやオレゴン・カントリーの初期の探検家であるジョン・Ｃ・フレモントにちなんで名付けられました。オレゴン州で最も長い主径間を誇り、世界でも２番目に長いタイドアーチ橋として知られています。"

	
##########################################################################################

#@}



#+ California TBs and POIs localization.
#@{
	key[]: "tb_ca1"
	val[]: "ゴールデン・ホライズン"

	key[]: "tb_ca1_desc"
	val[]: "きらめく水面に架かる印象的な橋が、アルカトラズ島、サンタクルーズ、そしてこの地域の丘陵地帯や住宅街をつないでいます。賑やかな通りや歴史的な名所から、陽光が降り注ぐビーチや風光明媚な海岸線に至るまで、ベイエリアならではのカリフォルニアの魅力を味わえます。"

	key[]: "ca_cut_golden_gate_bridge_desc"
	val[]: "サンフランシスコ湾と太平洋を隔てるこの橋は、サンフランシスコおよびカリフォルニア州を象徴する存在です。1937年に開通した当時、この橋は世界最長かつ最高の高さを誇る吊り橋として、当時の記録を保持していました。"

	key[]: "poi_ca1_01"
	val[]: "アルカトラズ"

	key[]: "poi_ca1_01_desc"
	val[]: "アルカトラズ島には、1934年から1963年まで連邦刑務所が置かれていました。全米でも特に悪名高い犯罪者たちが収監されていたことで知られ、現在は史跡として、また人気の観光地となっています。"

	key[]: "ca_cut_richmond_desc"
	val[]: "リッチモンド・サンラファエル橋は、サンフランシスコ湾に架かり、リッチモンドとサンラファエルを結んでいます。1956年に開通し、片持ち梁構造とトラス構造を特徴とするこの橋は、湾の北部を横断しており、地域における重要な交通網となっています。"
	
	key[]: "poi_ca1_02"
	val[]: "トレジャー・アイランド"

	key[]: "poi_ca1_02_desc"
	val[]: "トレジャーアイランドは、1939年のゴールデンゲート国際博覧会のために建設された人工島です。かつては海軍基地として利用されていましたが、現在は住宅・商業施設として再開発が進められています。"

	key[]: "poi_ca1_03"
	val[]: "サーフィン・シティ"

	key[]: "poi_ca1_03_desc"
	val[]: "サンタクルーズにある「サーフィンの像」は、この街のサーフィンの伝統と文化を称えるものです。ビーチフロントの近くに設置されたこの像は、地元のサーファーたち、そしてサンタクルーズのアイデンティティと沿岸コミュニティを形作ってきたこのスポーツを称えています。"

	key[]: "poi_ca1_04"
	val[]: "マドンナ・イン"

	key[]: "poi_ca1_04_desc"
	val[]: "かつてハイウェイ152号線の頂上付近にあった人気のレストラン。地域のイベント名所としても知られていましたが、2004年に道路問題により閉店。しかし現在でも地元の歴史や心霊談の掲示板で頻繁に話題に上っています。"



##########################################################################################

	key[]: "tb_ca2"
	val[]: "シャスタ・ルート"

	key[]: "tb_ca2_desc"
	val[]: "シャスタ・ルートは、シャスタ山の麓にある松林やきらめく高山湖の間を縫うように伸びています。道は人知れぬ谷間を登ったり下ったりしながら南へと続き、山々の姿が徐々に遠ざかっていくにつれて、北カリフォルニアの古代セコイアの林へと景色が移り変わっていきます。"

	key[]: "poi_ca2_01"
	val[]: "シャスタ＝トリニティ国有林"

	key[]: "poi_ca2_01_desc"
	val[]: "カリフォルニア州最大のシャスタ＝トリニティ国有林には、トリニティ・ヘリテージ・シーニック・バイウェイが通っています。この道は、19世紀の金鉱夫や入植者たちが利用したルートをたどっています。"

	key[]: "poi_ca2_02"
	val[]: "ビッグ・ラグーン"

	key[]: "poi_ca2_02_desc"
	val[]: "ビッグ・ラグーンは、ハンボルト・ラグーン州立公園にある３つのラグーンのうちで最も大きく、最も南に位置するものです。これらの浅い沿岸の盆地は岩だらけの岬の間にあり、そこでは海の波が砂の防波堤を作り出し、ラグーンを太平洋から隔てています。"

	key[]: "or_cut_sequoia_desc"
	val[]: "レッドウッド国立公園では、高さ370フィートを超え、樹齢2,000年に達するものもある、世界でも有数の高さと樹齢を誇るセコイアが保護されています。近隣の州立公園と合わせ、地球上に残存する古代の原生セコイア林の約35％が保全されています。"
	
	key[]: "poi_ca2_03"
	val[]: "スミス川"

	key[]: "poi_ca2_03_desc"
	val[]: "カリフォルニア州北西部のシックス・リバーズ国有林内にあるこの保護区は、景観的、生態学的、文化的な価値を保全するため、1990年に連邦議会によって指定されました。スミス川は、カリフォルニア州で唯一、ダムに阻まれることなく自由に流れる主要河川です。"

	key[]: "poi_ca2_04"
	val[]: "ウィスキー・クリーク橋"

	key[]: "poi_ca2_04_desc"
	val[]: "1961年に完成したウィスキー・クリーク橋は、３スパンの溶接プレートガーダー構造の橋です。当時としては画期的な溶接技術を用い、３種類の異なる等級の鋼材を採用した橋梁設計の初期の事例として注目されています。"

	key[]: "poi_ca2_05"
	val[]: "シャスタ湖"

	key[]: "poi_ca2_05_desc"
	val[]: "カリフォルニア州最大の貯水池であるシャスタ湖は、サクラメント川に建設されたシャスタダムによって形成されました。1945年に完成したこのダムは、水資源や水力発電を提供するとともに、レクリエーションを楽しめる景勝地としても親しまれています。"

	key[]: "poi_ca2_06"
	val[]: "シャスタ山"

	key[]: "poi_ca2_06_desc"
	val[]: "1820年代以降、カスケード山脈で２番目に高い峰であるシャスタ山は、その麓を走るシスキュー・トレイルを旅する人々の道しるべとなってきました。そのルートは後に州間高速道路５号線へと発展し、現在では毎年何千人もの人々がこのルートを通って山を訪れています。"



##########################################################################################

	key[]: "tb_ca3"
	val[]: "シエラ・クロッシング"

	key[]: "tb_ca3_desc"
	val[]: "そびえ立つシエラネバダ山脈の麓、広々とした谷となだらかな丘に囲まれて「イン・アット・ベントン」は佇んでいます。シエラ・クロッシングは、静かな高地の砂漠の道路に沿ってうねるように伸びており、遠くにそびえる峰々と険しい尾根が、時を超えたパノラマを織りなしています。この景色は、旅人たちにこの地域の広大な風景を探索するよう誘いかけています。"

	key[]: "ca_cut_olmsted_point_desc"
	val[]: "1890年に設置されたヨセミテ国立公園は、最も多くの観光客が訪れる公園の一つです。北米で落差が最大であるヨセミテ・フォールズや広大な遊歩道ネットワーク、樹齢3,000年以上のジャイアントセコイアなどで知られています。"

	key[]: "poi_ca3_01"
	val[]: "タイオガ・ロード"

	key[]: "poi_ca3_01_desc"
	val[]: "タイオガ・ロードは、ヨセミテ国立公園の中心部を貫く、象徴的で景観に優れた道路です。カリフォルニア州で最も標高の高い峠道で、シエラネバダ山脈の東西を繋いでいます。"

	key[]: "poi_ca3_02"
	val[]: "モノ湖"

	key[]: "poi_ca3_02_desc"
	val[]: "モノ湖は、100万年以上前に形成され、北米で最古の湖の一つです。この湖には自然の流出路がないため、シエラネバダ山脈東部から流れ込む小川によって数千年にわたって運ばれた塩分やミネラルが蓄積されてきました。"
	
	key[]: "poi_ca3_03"
	val[]: "タホ湖"

	key[]: "poi_ca3_03_desc"
	val[]: "タホ湖は、およそ200万年前にタホ盆地の中に形成され、氷河期に氷河によって削られ、現在の形となりました。この湖は北米最大の高山湖で、アメリカで２番目に深い湖でもあります。"

	key[]: "poi_ca3_04"
	val[]: "エルドラド国有林"

	key[]: "poi_ca3_04_desc"
	val[]: "エルドラド国有林がその一部を構成する大規模な水系は、カリフォルニア州の何百万人もの人々に水を供給し、全米の果物と野菜の生産量のほぼ半分を担う農場を支えています。"

	key[]: "poi_ca3_05"
	val[]: "イン・アット・ベントン・ホットスプリングス"

	key[]: "poi_ca3_05_desc"
	val[]: "モノ郡最古の街の一つであるベントンは、その温泉を利用してパイユート族によって開拓されました。1860年代には、この街は入植者や鉱夫たちの宿泊地となりました。1940年代に地元の軽石を使って建てられたこの宿は、10で室が１つの浴場を共有していた1904年築のホテルに取って代わったものです。"



##########################################################################################

	key[]: "tb_ca4"
	val[]: "太陽、そして砂"

	key[]: "tb_ca4_desc"
	val[]: "デスバレーの砂漠は果てしない空の下に広がり、砂丘や切り立った峰々、ひび割れた平原が点在しています。日差しの降り注ぐ砂の上をジャックラビットが跳ね回り、頭蓋骨が静かな道標となっています。ここを訪れるすべての人に試練を与え畏敬の念を抱かせるような荒涼として容赦のない風景の中を、１本の道路が曲がりくねって伸びています。"

	key[]: "poi_ca4_01"
	val[]: "ローン・パイン"

	key[]: "poi_ca4_01_desc"
	val[]: "ローン・パインは、シエラ山脈の東麓、カリフォルニア州オーウェンズ・バレーにある小さな町です。近隣のアラバマ・ヒルズで知られ、周辺の山々や砂漠の風景を探索するハイカーや登山者、映画製作者たちの玄関口としての役割を長年にわたって果たしてきました。"

	key[]: "poi_ca4_02"
	val[]: "デスバレー国立公園"

	key[]: "poi_ca4_02_desc"
	val[]: "デスバレーはアメリカで最も過酷な景観の一つであり、最も標高が低く、最も暑く、最も乾燥していて、場所によっては最も標高が高いこともある。1800年代の開拓者が訪れるはるか以前から、先住民の部族がこの地に住み、厳しい自然環境の中にも豊かな歴史が息づくこの地域で狩猟や採集を行っていた。"

	key[]: "poi_ca4_03"
	val[]: "ファーザー・クローリー・ビスタ・ポイント"

	key[]: "poi_ca4_03_desc"
	val[]: "この景勝地は、旅行者に人気の観光スポットです。「砂漠の司祭」として知られるジョン・J・クローリー神父がよくここで足を止めていました。国立公園の西端近くに位置し、古代の火山活動によって形成された色鮮やかな地形であるレインボー・キャニオンの見事な景色を一望できます。"
	
	key[]: "poi_ca4_04"
	val[]: "モハベ・バレー・ウェルズ"

	key[]: "poi_ca4_04_desc"
	val[]: "モハベのバレー・ウェルズでは、古代の地下水流出堆積物が、氷河期における過去の湿地環境を物語っています。これらの歴史的な井戸は、一見乾燥した砂漠であるこの地で、かつて地下水がどのように湿地や豊かな植生を支えていたかを明らかにしています。"

	key[]: "poi_ca4_05"
	val[]: "コロラド川インディアン居留地"

	key[]: "poi_ca4_05_desc"
	val[]: "アリゾナ州とカリフォルニア州のコロラド川沿いに広がる居留地です。1865年に川沿いの部族のために設立され、現在はモハーベ族、チェメヒューヴィ族、ホピ族、ナバホ族が暮らしており、農業や地域社会を支えています。"

##########################################################################################

#@}



#+ Idaho TBs and POIs localization.
#@{

    key[]: "tb_id1"
	val[]: "トレジャー・バレー"

	key[]: "tb_id1_desc"
	val[]: "アイダホ州南西部に位置するトレジャー・バレーは、ネイティブアメリカンの部族、初期の毛皮商人、そしてオレゴン・トレイルの開拓者たちによって形作られてきた豊かな歴史を持っています。その名称は、この地域の資源と可能性を反映しており、その後、ボイシを中心とした農業、鉄道、地域貿易が発展し、地域はさらに成長を遂げました。"

	key[]: "poi_id1_01"
	val[]: "サーモン川"

	key[]: "poi_id1_01_desc"
	val[]: "アイダホ州を流れるサーモン川は、深く険しい峡谷を425マイルにわたって流れています。かつては、その激しい流れに逆らって上流へ戻ることができなかったため、「帰らざる川」という異名がついていました。"

	key[]: "poi_id1_02"
	val[]: "ボイシ国有林"

	key[]: "poi_id1_02_desc"
	val[]: "侵食されやすいアイダホ・バソリスにまたがるボイシ国有林は、火山活動によって形作られた険しい景観が特徴です。この地域の地質的な特徴は、険しい峡谷や各地に点在する数多くの天然温泉によく表れています。"

	key[]: "poi_id1_03"
	val[]: "ホースシュー・ベンド"

	key[]: "poi_id1_03_desc"
	val[]: "1862年にボイシ盆地で金が発見されると、川沿いで越冬していた鉱夫たちによってホースシュー・ベンドが設立されました。当初は地元の製材所経営者にちなんで「ワリナーズビル」と呼ばれていましたが、1867年、探鉱者たちの重要な中継地となったことから、現在の名称に改められました。"
	
	key[]: "poi_id1_04"
	val[]: "トールゲート"

	key[]: "poi_id1_04_desc"
	val[]: "1864年、急勾配のシロップ・クリーク・トレイルに代わり、新しい峡谷ルートが開通しました。その後20年間、ルートの維持管理費は通行料で賄われ、ジェームズ・Ａ・ポーターが経営する有名なホテルと酪農場は、休息を求める旅行者たちの主要な立ち寄り先となりました。"

	key[]: "poi_id1_05"
	val[]: "キャッスル・ロック"

	key[]: "poi_id1_05_desc"
	val[]: "カマス・プレーリーに向かう道中、キャッスル・ロックの花崗岩の露頭は、グッデール・カットオフを旅するオレゴン・トレイルの移民たちにとって、象徴的なランドマークとなっていました。1862年から自動車が普及する時代に至るまで利用されたこれらの珍しい地層は、ルートを行く旅人たちの目を引く景観でした。"

    key[]: "poi_id1_06"
	val[]: "ダック・バレー・インディアン居留地"

	key[]: "poi_id1_06_desc"
	val[]: "1886年、クリーブランド大統領は「パディ・キャップ居留地拡張」により、ダック・バレーをアイダホ州にまで拡大しました。1934年までに、この居留地に移住したさまざまな部族集団は、統一された「ショショーニ・パイユート族」として連邦政府から正式に承認されました。"


##########################################################################################

    key[]: "tb_id2"
	val[]: "マジック・バレー"

	key[]: "tb_id2_desc"
	val[]: "1900年代初頭、Ｉ.Ｂ. ペリンはミルナー・ダムを建設し、アイダホ州の乾燥した砂漠を農地に変えました。1905年に完成したこのダムは、スネーク川の水を利用して、この地域の景観を「魔法のように」一変させました。こうして「マジック・バレー」が生まれ、今日でも繁栄を続ける農業の町々が発展することになりました。"

	key[]: "id_cut_perrine_desc"
	val[]: "高さ212フィートでナイアガラの滝よりも高いショショーニの滝は、ツインフォールズのすぐそばに位置する、スネーク川を代表する美しい名所です。"

	key[]: "id_cut_galena_desc"
	val[]: "1879年に鉛・銀の鉱床が発見されたことをきっかけに設立されたこの鉱山町は、1890年代には価格の下落により衰退しました。今日、この地域は活気あふれるレクリエーションの拠点となっており、歴史あるガレナ・ロッジや、近隣にある風光明媚なガレナ・サミットなども知られています。"

	key[]: "poi_id2_01"
	val[]: "バイソン・ジャンプ"

	key[]: "poi_id2_01_desc"
	val[]: "チャリスにある「バイソン・ジャンプ」は、先住民がバッファローを崖から突き落として狩猟を行っていた歴史的な場所です。2,000年以上にわたり利用されてきたこの戦略的な地形は、古代の共同狩猟の伝統を垣間見せてくれます。"
	
	key[]: "poi_id2_02"
	val[]: "グランド・ビュー・キャニオン"

	key[]: "poi_id2_02_desc"
	val[]: "米国国道93号線の「ピークス・トゥ・クレーターズ・シーニック・バイウェイ」沿いに位置するグランド・ビュー・キャニオンからは、ロスト・リバー山脈の息をのむような絶景が広がります。この山脈にはアイダホ州で最も高い山々のうち９座がそびえており、峡谷の景観ルートの見どころとなっています。"

	key[]: "landmark_id_mackay_rs_desc"
	val[]: "もともと毛皮猟師ティエリー・ゴディンにちなんで「ゴディンズ川」と呼ばれていたビッグ・ロスト川は、溶岩台地に沈んでいくことで有名です。この「失われた」水は地下を流れ、やがてスネーク川近くの壮観な「サウザンド・スプリングス」で再び地表に現れます。"

    key[]: "poi_id2_03"
	val[]: "マッケイのゴーストタウン"

	key[]: "poi_id2_03_desc"
	val[]: "ホワイト・ノブやクリフ・クリークといった町は、ホワイト・ノブ鉱区にある「マイン・ヒル」を拠点として、20世紀半ばまで銅、金、銀の採掘ブームを牽引しました。これらの場所は、アイダホ州の歴史的な鉱業の重要な遺構として今なお残っています。"

	key[]: "id_cut_craters_desc"
	val[]: "1万5000年前の火山噴火によって形成された「クレーターズ・オブ・ザ・ムーン」は、溶岩流やシンダーコーンが広がる広大な景観が特徴です。その異世界のような地形は非常に独特であるため、かつてNASAの宇宙飛行士たちが月面ミッションの訓練に利用したほどです。"



##########################################################################################

#@}



#+ Montana TBs and POIs localization.
#@{

    key[]: "tb_mt1"
	val[]: "氷河の回廊"

	key[]: "tb_mt1_desc"
	val[]: "グレイシャー・カントリーには、ロッキー山脈に残る数少ない現役の氷河がいくつかあります。数千年にわたり、これらの古い氷河は深い谷や険しい峰、澄みきった湖を形作り、今日のモンタナ州西部を特徴づける景観を形作ってきました。"

	key[]: "poi_mt1_01"
	val[]: "クートニー滝"

	key[]: "poi_mt1_01_desc"
	val[]: "クートニー滝は、モンタナ州で最大のダムのない滝であり、この地域の主要な観光名所です。クートニー川は、短い区間で約300フィートの落差を流れ落ち、迫力のある美しい滝を形成しており、その忘れがたい景色を求めて多くの観光客が訪れています。"

	key[]: "poi_mt1_02"
	val[]: "バーン・ロードサイド・パーク"

	key[]: "poi_mt1_02_desc"
	val[]: "バッド・ロック・キャニオンは、フラットヘッド川沿いを旅する人々に人気の立ち寄りスポットでした。釣りや絶景で知られ、かつては過熱した車のラジエーターを冷やすために利用されていた天然の泉もありました。1956年、ここはモンタナ州で最初の休憩所のひとつとなり、「バーン・ロードサイド・パーク」と名付けられました。"

	key[]: "poi_mt1_03"
	val[]: "ヘブンズ・ピーク"

	key[]: "poi_mt1_03_desc"
	val[]: "グレイシャー国立公園を代表する山の一つであるヘブンズ・ピークは、1890年代に探鉱者のルーイ・マイヤーによって名付けられました。その美しさとそびえ立つ「ガーデン・ウォール」に心を打たれた探検家たちは、この山をこれまでの旅で見たどの山とも異なるものだと感じたそうです。"

	key[]: "mt_cut_glacier_national_park_desc"
	val[]: "「大陸の冠」と称されるグレイシャー国立公園は、1910年に設立されました。太古の氷河によって形作られたこの公園は、1932年に「ゴーイング・トゥ・ザ・サン・ロード」が完成したことで、より多くの人々が訪れやすくなりました。この道路は現在、歴史的な土木遺産として知られています。"

	key[]: "poi_mt1_04"
	val[]: "ブラックフィート・インディアン記念碑"

	key[]: "poi_mt1_04_desc"
	val[]: "グレイシャー国立公園の東端には、ブラックフィート族の居留地があります。「平原の戦士たち」として知られるこの部族の名は、灰で黒く染まったモカシンに由来すると考えられています。現在でも、公園内にはこの部族にとって神聖な場所がいくつか残っています。"

	key[]: "mt_cut_flathead_lake_desc"
	val[]: "フラットヘッド湖は、米国本土において水面積が最大の天然淡水湖です。周囲の山々からの雪解け水によって水量が保たれており、その極めて澄んだ水は数年ごとに完全に入れ替わるため、世界でも有数の清浄な大湖の一つとなっています。"

	key[]: "mt_cut_thompson_falls_desc"
	val[]: "イギリス系カナダ人の毛皮商人であり地図製作者でもあったデビッド・トンプソンにちなんで名付けられたこの町は、1881年に鉄道が開通したことをきっかけに発展しました。その後、近隣のクール・ダレーンでゴールドラッシュが起こると、マレー・トレイルを行き交う鉱夫たちの重要な中継地となり、さらに発展しました。"

	key[]: "landmark_mt_missoula_desc"
	val[]: "1910年にＡ. Ｊ. ギブソンが設計し、砂岩で建てられた新古典主義様式のミズーラ郡庁舎は、それ以前にあったより小規模な建物を置き換えたものです。1860年に設立されたミズーラ郡は、モンタナ州で最も古い行政区の一つであり、ビタールートからロッキー山脈にかけて広がっています。"

    key[]: "poi_mt1_05"
	val[]: "ロロ・クリーク"

	key[]: "poi_mt1_05_desc"
	val[]: "ロロとロロ峠の間を結ぶこのルートは、ロロ・クリーク沿いの歴史的な道をたどっています。かつてネズパース族や初期の入植者、ルイス・クラーク探検隊が通ったこの道は、現在も解説施設が点在する、文化・歴史的に重要な景観として残っています。"

##########################################################################################

    key[]: "tb_mt2"
	val[]: "グレートプレーンズ"

	key[]: "tb_mt2_desc"
	val[]: "モンタナ州のグレートプレーンズは州東部に広がり、広大な草原やなだらかな平原、どこまでも続く大空が特徴です。この地域からは、北米で最も重要な恐竜の化石がいくつか発見されており、数百万年前に存在した風景を垣間見ることができます。"

	key[]: "poi_mt2_01"
	val[]: "ヘルクリーク層"

	key[]: "poi_mt2_01_desc"
	val[]: "モンタナ州ジョーダン近郊のヘルクリーク沿いを中心とするヘルクリーク層には、川や森林、沼地からなる古代の亜熱帯の景観が保存されています。6,700万～6,600万年前の地層であり、象徴的なティラノサウルス・レックスをはじめとする豊富な恐竜化石で世界的に有名です。"

	key[]: "poi_mt2_02"
	val[]: "イエローストーン川"

	key[]: "poi_mt2_02_desc"
	val[]: "イエローストーン川は、米国本土で最も長い、ダムに阻まれることなく自然に流れる川です。イエローストーン国立公園を源流とし、ワイオミング州とモンタナ州を676マイルにわたり流れ、ミズーリ川に合流するまで、その全行程にダムは一つもありません。"

	key[]: "poi_mt2_03"
	val[]: "グレンディサウルス"

	key[]: "poi_mt2_03_desc"
	val[]: "グレンダイブにある等身大のトリケラトプスの像「グレンディサウルス」は、この地域の豊かな恐竜の歴史を象徴するものです。高さ約10フィートのこの像は、「ダイナソー・トレイル」沿いの人気のあるランドマークとなっています。"
	
	key[]: "poi_mt2_04"
	val[]: "ミズーリ川"

	key[]: "poi_mt2_04_desc"
	val[]: "「ビッグ・マディ」の愛称で知られるミズーリ川は、アメリカ合衆国で最も長い川です。モンタナ州のロッキー山脈からミシシッピ川まで2,341マイルにわたり流れ、探検、貿易、そしてアメリカの西部開拓時代において極めて重要な役割を果たしました。"

	key[]: "mt_cut_fort_peck_spillway_desc"
	val[]: "大恐慌時代に建設されたフォートペック・ダムは、世界最大水力充填式ダムです。米国最大級の公共事業の一つとして完成したこのダムは、雇用の創出、洪水調節、水力発電を目的として設計されました。"

    key[]: "poi_mt2_05"
	val[]: "バレー郡パイオニア博物館"

	key[]: "poi_mt2_05_desc"
	val[]: "この博物館では、アッシニボイン族、鉄道、農業、フォートペック・ダム、ルイス・アンド・クラーク探検隊に関する展示を通じて、モンタナ州北東部の歴史を紹介しています。また、膨大な資料を所蔵しており、全米でも最大級のアッシニボイン族関連コレクションの一つを誇っています。"

	key[]: "poi_mt2_06"
	val[]: "スリーピング・バッファロー・ロック"

	key[]: "poi_mt2_06_desc"
	val[]: "これらの氷河由来の巨岩は、先住民族にとって神聖なランドマークでした。太古の氷河によって削られ、運ばれてきたものです。小さい方の岩「バッファロー・ロック」はバッファローに似せて彫られており、大きい方の「メディシン・ロック」には様々な岩刻画が残されています。"



##########################################################################################

#@}



#+ Wyoming TBs and POIs localization.
#@{

    key[]: "tb_wy1"
	val[]: "バッファロー・トレイル"

	key[]: "tb_wy1_desc"
	val[]: "イエローストーンやグランド・ティトンがあるこの地域は、間欠泉や温泉を生み出す活火山地帯の上に位置しており、氷河や断層によって山々や谷が形作られています。こうした自然の力により、ワイオミング州北西部は、アメリカ西部において地質活動が活発で、見た目も象徴的な景観の一つとなっています。"

	key[]: "landmark_wy_yellowsto_desc"
	val[]: "1872年に世界初の国立公園として設立されたイエローストーンは、巨大な休火山の上に位置しています。世界の活動中の間欠泉の約半数がここにあり、地球上でも最大級かつ最も手つかずの状態で残る温帯生態系の一つが保護されています。"

	key[]: "poi_wy1_01"
	val[]: "ロウアー・ガイザー・ベイスン"

	key[]: "poi_wy1_01_desc"
	val[]: "ロウアー・ガイザー・ベイスンはイエローストーンで最大の間欠泉地帯であり、間欠泉、温泉、蒸気噴出口が広範囲に集中しています。地下深部のマグマから供給される熱によって活動しており、公園内で最も活発な地熱景観の一つを見ることができます。"

	key[]: "poi_wy1_02"
	val[]: "イエローストーン湖"

	key[]: "poi_wy1_02_desc"
	val[]: "イエローストーン湖は北米最大の高地湖であり、同大陸で最大の野生のノドキリマスの生息地となっています。科学者たちは、かつてこの湖が太平洋へと流れ込んでおり、魚たちがトゥー・オーシャン・パスを通って大陸分水嶺を越えていたと推測しています。"
	
	key[]: "poi_wy1_03"
	val[]: "バッファロー・ビル・ダム"

	key[]: "poi_wy1_03_desc"
	val[]: "1910年に完成したバッファロー・ビル・ダムは、米国で最初に建設されたコンクリートアーチダムの一つでした。高さ325フィートを誇るこのダムは、当時世界一の高さを誇り、初期のダム建設技術の革新を象徴する存在となりました。"

	key[]: "poi_wy1_04"
	val[]: "コルターズ・ヘル"

	key[]: "poi_wy1_04_desc"
	val[]: "コルターズ・ヘルは、ショショーニ川沿いにある歴史的な地熱地帯で、1807年に探検家のジョン・コルターによって名付けられました。初期のマウンテンマンたちは、ここから立ち上る蒸気や硫黄の臭いを「地獄」に例えました。現在、活動しているのは温泉と蒸気噴出口のみとなっています。"

	key[]: "wy_cut_grand_teton_desc"
	val[]: "グランドティトン国立公園は、ジャクソン・ホールの上に鋭くそびえ立つ、氷河で削り出された山々によって特徴づけられています。かつては平原の向こうからもはっきりと見えることから、毛皮猟師たちによって「パイロット・ノブス」と呼ばれていたこれらの山々は、今もなおアメリカ西部の最も象徴的なランドマークの一つとなっています。"

	key[]: "poi_wy1_05"
	val[]: "クロウハート・ビュート"

	key[]: "poi_wy1_05_desc"
	val[]: "クロウハート・ビュートは、1866年にショショーニ族とクロウ族の間で繰り広げられた戦いにちなんで名付けられた、よく知られたランドマークです。伝承によると、ショショーニ族の勝利後、ワシャキー酋長は警告としてクロウ族の酋長の心臓をこのビュートの頂上に置いたとされ、それがこの地形の不朽の名称の由来となっています。"

##########################################################################################

    key[]: "tb_wy2"
	val[]: "レッド・デザート"

	key[]: "tb_wy2_desc"
	val[]: "ワイオミング州のレッド・デザートは、風によって形作られた砂地、ヤマヨモギの平原、そして印象的な赤い岩層が特徴の、広大な高地砂漠の盆地です。北米でも有数の広さを誇る無人地帯の一つであり、その地形は過酷な気候、太古の湖底、そして長い移動経路によって形成されています。"

	key[]: "poi_wy2_01"
	val[]: "レッドキャニオン"

	key[]: "poi_wy2_01_desc"
	val[]: "レッド・キャニオンは、約6,000万年前にウィンド・リバー山脈が隆起した際に形成されました。その特徴的な赤い断崖はチャグウォーター岩から成り、この岩に含まれる酸化鉄が峡谷に鮮やかな色を与え、それがこの地名の由来となっています。"

	key[]: "poi_wy2_02"
	val[]: "権力の風景"

	key[]: "poi_wy2_02_desc"
	val[]: "ワイオミング州のレッド・デザートに400フィート以上もそびえ立つ火山岩の岩層「ボアーズ・タスク」は、数百万年前に形成された火山の侵食された中心部です。そこからは、北米最大の砂丘地帯の一部である広大なキルペッカー砂丘を見下ろすことができます。"

	key[]: "poi_wy2_03"
	val[]: "ロックスプリングス"

	key[]: "poi_wy2_03_desc"
	val[]: "ロックスプリングスは、多様な移民の歴史から「56の民族が暮らす街」として知られています。1800年代後半、世界中から人々がユニオン・パシフィック鉄道の炭鉱で働くためにこの地を訪れました。また、この街は有名な無法者ブッチ・キャシディともゆかりがあります。"
	
	key[]: "poi_wy2_04"
	val[]: "ブッチ・キャシディの小屋"

	key[]: "poi_wy2_04_desc"
	val[]: "ブッチ・キャシディは、オールド・ウェストで列車や銀行強盗で知られたギャング「ワイルド・バンチ」を率いた、有名なアメリカの無法者でした。彼はロックスプリングスの精肉店で働いていた際に、「ブッチ」というあだ名をつけられました。最も伝説的で影響力の大きかった強盗事件として、1899年のウィルコックス列車強盗事件が挙げられます。"

	key[]: "wy_cut_evanston_desc"
	val[]: "1869年にユニオン・パシフィック鉄道によって設立されたエバンストンは、測量技師のジェームズ・Ａ・エバンスにちなんで名付けられました。この街は鉄道の要衝として発展し、後に農業、石油、ガスの地域拠点となりました。"

    key[]: "poi_wy2_05"
	val[]: "ランダー・カットオフ"

	key[]: "poi_wy2_05_desc"
	val[]: "1857年の「太平洋馬車道路法」の制定後に建設されたランダー・カットオフは、アメリカ西部において連邦政府の資金で整備された最初の馬車道路の一つでした。技術者のフレデリック・Ｗ・ランダーにちなんで名付けられたこの道路は、西へ移住する移民たちに、より短いルートを提供しました。"

	

##########################################################################################

#@}


#+ South Dakota TBs and POIs localization.
#@{

    key[]: "tb_sd1"
	val[]: "ブラックヒルズ"

	key[]: "tb_sd1_desc"
	val[]: "サウスダコタ州西部は、ブラックヒルズとバッドランズによって特徴づけられています。ここでは、広大な大草原が、松林に覆われた山々、花崗岩の尖塔、そして自由に駆け巡るバイソンの群れへと続いています。そのすぐ先には、風と水が数百万年をかけて削り出した、印象的な景観を誇る荒涼としたバッドランズが広がっています。"

	key[]: "poi_sd1_01"
	val[]: "ブラックヒルズ国有林"

	key[]: "poi_sd1_01_desc"
	val[]: "ラコタ族の間では「黒い丘」を意味する「パハ・サパ」として知られるこの松林に覆われた地域には、サウスダコタ州最高峰である標高7,244フィートのブラック・エルク・ピークがあります。この山は、ラコタ族の有名な治療師に敬意を表して改名されたもので、ロッキー山脈の東側で最も高い山頂でもあります。"

	key[]: "sd_cut_rush_desc"
	val[]: "アメリカの「民主主義の聖地」として知られるラシュモア山は、1927年から1941年にかけてブラックヒルズに彫刻されました。この記念碑には、ワシントン、ジェファーソン、ルーズベルト、リンカーンの各大統領の60フィートの彫像が刻まれており、これらは米国の誕生、成長、発展、そしてその保全を象徴しています。"

	key[]: "poi_sd1_02"
	val[]: "ビーバー・クリーク橋"

	key[]: "poi_sd1_02_desc"
	val[]: "1929年に建設されたこの225フィートの鉄筋コンクリート製アーチ橋は、ウィンド・ケイブ国立公園近くの峡谷に架かっています。峡谷の底から115フィートの高さに位置するこの橋は、周囲の岩肌と自然に調和するよう設計されており、州で唯一の鉄筋コンクリート製アーチ橋として知られています。"

	key[]: "sd_cut_sturgis_desc"
	val[]: "スタージスは、世界最大のオートバイ・ラリーの開催地として知られています。1938年に地元のインディアン販売店主パピー・ホエルによって始められた10日間にわたる毎年恒例のこのイベントには、世界中からライダーたちがブラックヒルズに集まり、オートバイの展示会、レース、音楽、そして祝賀行事を楽しみます。"

	key[]: "sd_cut_deadwood_desc"
	val[]: "デッドウッドは、1876年のブラックヒルズ・ゴールドラッシュの最中に発展し、ワイルド・ウェストで最も悪名高い町の一つとなりました。1961年にはアメリカ合衆国国定歴史建造物地区に指定され、現在においてもその地位を持つ米国で唯一の都市であり、歴史的なダウンタウンの大部分が保存されています。"

	key[]: "sd_cut_badlands_desc"
	val[]: "バッドランズ国立公園は、244,000エーカーに及ぶ荒々しい岩山や丘が点在するほか、国内最大規模の保護された混合草地帯も擁しています。また、世界でも有数の豊富な化石層が保存されており、かつてグレートプレーンズを駆け巡っていた古代の哺乳類の姿を今に伝えています。"

	key[]: "poi_sd1_03"
	val[]: "ドーン・ロビンソン・トンネル"

	key[]: "poi_sd1_03_desc"
	val[]: "「ラシュモア山の父」として知られるドーン・ロビンソンは、サウスダコタ州に観光客を呼び込むため、ブラックヒルズに壮大な記念碑を建設することを構想しました。今日、その遺志は受け継がれており、風光明媚なドーン・ロビンソン・トンネルからは、ラシュモア山を絶好の構図で眺めることができます。"

	key[]: "sd_cut_hot_springs_desc"
	val[]: "ホットスプリングスは、もともとスー族によって「熱い水」を意味する「ミネカハタ」と呼ばれ、1879年には治癒力があると信じられていた鉱泉の周辺に開拓地が形成されました。1882年に改名され、保養地として発展し、現在も歴史ある「エヴァンス・プランジ」で知られています。"

	key[]: "poi_sd1_04"
	val[]: "マンモス・サイト"

	key[]: "poi_sd1_04_desc"
	val[]: "マンモス・サイトは、61頭のマンモスの化石が発見された、世界的に有名な氷河期の化石発掘地です。1974年に発見されたこの古代の陥没穴には、北米で最大規模のコロンビアマンモスの遺骸が保存されており、現在も発掘調査が続けられています。"

##########################################################################################

    key[]: "tb_sd2"
	val[]: "グレートディバイド"

	key[]: "tb_sd2_desc"
	val[]: "サウスダコタ州のミズーリ川流域は、同州の中央分水嶺となっており、片側には広大な平原が、もう片側にはなだらかな丘陵が広がっています。この地域は、先住民の部族や毛皮商人、そしてルイス・クラーク探検隊にとって重要な経路として機能し、後に大規模なダムや開拓時代の町が立ち並び、川にまつわる豊かな歴史が刻まれてきました。"

	key[]: "poi_sd2_01"
	val[]: "四大湖"

	key[]: "poi_sd2_01_desc"
	val[]: "1940年代後半、ミズーリ川に建設されたダムによって誕生したオアヘ湖、シャープ湖、フランシス・ケース湖、ルイス＆クラーク湖は、今やサウスダコタ州中部の象徴となっています。これらの貯水池を合わせると、ボート遊びや釣り、レクリエーションを楽しめる440マイル以上の湖岸線を形成しています。"

	key[]: "poi_sd2_02"
	val[]: "バンゴールのゴーストタウン"

	key[]: "poi_sd2_02_desc"
	val[]: "バンゴールはかつてウォルワース郡の郡庁所在地でしたが、1899年に建物が近くのセルビーに移転された後、ゴーストタウンとなりました。現在、かつて町があった場所を示すのは、記念碑だけです。"

	key[]: "landmark_sd_state_capitol_desc"
	val[]: "1880年に設立されたピエールは、1889年にサウスダコタ州が合衆国に加盟した際、同州の州都となりました。中心的な立地とミズーリ川渡河地点であることから選定されたこの都市は、フランス系アメリカ人の毛皮商人、ピエール・シュートー・ジュニアにちなんで名付けられました。"

	key[]: "sd_cut_corn_desc"
	val[]: "ミッチェルにあるコーン・パレスは、その外観がすべてトウモロコシで装飾された世界で唯一の宮殿です。毎年、地元のアーティストや農家たちが、自然な色合いのトウモロコシや穀物、草を使って新しい壁画を制作しており、サウスダコタ州を代表する特徴的なランドマークの一つとなっています。"

	key[]: "landmark_sd_largest_pheasant_desc"
	val[]: "ヒューロンには、1959年に制作された高さ40フィートのガラス繊維と鋼鉄製の彫刻「世界最大のキジ」があります。重さ22トンのこの彫刻は、この地域が長年にわたり、アメリカ有数のキジ狩りの名所として知られてきたことを象徴しています。"

	key[]: "landmark_sd_dignity_of_earth_and_sky_desc"
	val[]: "「大地と空の尊厳」は、チェンバレン近郊のミズーリ川を見下ろす、高さ50フィートのステンレス製の彫刻です。アーティストのデール・ランプヒアによって制作されたこの作品は、ラコタ族とダコタ族の伝統、不屈の精神、そして文化を称えるものです。"

##########################################################################################

#@}
