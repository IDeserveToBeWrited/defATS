#+ Washington TBs and POIs localization.
#@{
	key[]: "tb_wa1"
	val[]: "Olympijský poloostrov"

	key[]: "tb_wa1_desc"
	val[]: "Olympijský poloostrov představuje místo, kde oceán, lesy a hory koexistují v proměnlivé kráse. Nad skalnatým pobřežím se vznáší mlha, zatímco z pohoří se valí vodopády a ve skrytých údolích se ukrývají malá historická městečka."

	key[]: "poi_wa1_01"
	val[]: "Historická budova pošty Spojených států"

	key[]: "poi_wa1_01_desc"
	val[]: "Budova na útesu nad nábřežím města Port Townsend, dokončená v roce 1893, byla navržena jako federální zařízení s celním úřadem, což odráželo rané ambice města stát se novým centrem mezinárodního obchodu."

	key[]: "poi_wa1_02"
	val[]: "Port Angeles"

	key[]: "poi_wa1_02_desc"
	val[]: "Port Angeles je pobřežní město, založené v 19. století jako přístav a zásobovací středisko. Dnes slouží jako vstupní brána do Olympijského národního parku a jako přístav pro trajekty spojující Spojené státy a Kanadu."

	key[]: "poi_wa1_03"
	val[]: "Půlměsícové jezero"

	key[]: "poi_wa1_03_desc"
	val[]: "Půlměsícové jezero, druhé nejhlubší jezero státu Washinghton, je známé svou sytě modrou křišťálově čistou vodou, z důvodu nízkého obsahu dusíku. Nachází se v oblíbené rekreační oblasti a je obklopeno turistickými stezkami a pralesem."
	
	key[]: "poi_wa1_04"
	val[]: "Pláž Kalaloch"

	key[]: "poi_wa1_04_desc"
	val[]: "Pláž Kalaloch je známá díky „Stromu života“ – smrku sitka, jehož obnažené kořeny se táhnou přes malý potok až ke břehu. Na rozdíl od typických vysokých smrků je nižší, silnější a ošlehaný větrem, což z něj dělá jedinečnou a oblíbenou dominantu tohoto místa."

	key[]: "poi_wa1_05"
	val[]: "Olympijský národní park"

	key[]: "poi_wa1_05_desc"
	val[]: "Olympijský národní park chrání rozmanité ekosystémy, od drsného pobřeží Tichého oceánu a deštných pralesů mírného pásu až po alpské vrcholy. V roce 1909 byl poprvé vyhlášen národní památkou a v roce 1938 jej federální vláda přejmenovala na národní park."

	key[]: "poi_wa1_06"
	val[]: "Greenhead Slough"

	key[]: "poi_wa1_06_desc"
	val[]: "Greenhead Slough je malá zátoka a mokřad podél silnice US 101 nedaleko zátoky Willapa Bay. Nachází se v pobřežním estuáru, který byl obnoven s cílem podpořit tření lososů a umožnit pozorování hojného výskytu vodního ptactva."

	key[]: "poi_wa1_07"
	val[]: "Dabob Bay"

	key[]: "poi_wa1_07_desc"
	val[]: "Dabob Bay je hluboký fjord, který je domovem lososů, měkkýšů, korýšů a divoké zvěře. Přírodní oblast Dabob Bay, založená v roce 1984, chrání vzácná rostlinná společenstva slanisek a písečných kos v rámci dobře fungujícího systému přílivových mokřadů."


##########################################################################################

	key[]: "tb_wa2"
	val[]: "Heartland"

	key[]: "tb_wa2_desc"
	val[]: "Srdce státu Washington láká cestovatele na malebné silnice vedoucí stálezelenými lesy a klidnými horskými jezery. Na obzoru se tyčí sopka Mount Rainier nabízející nezapomenutelné výhledy a poklidnou cestu přírodními krajinami severozápadního pobřeží Tichého oceánu."

	key[]: "poi_wa2_01"
	val[]: "Mount Rainier"

	key[]: "poi_wa2_01_desc"
	val[]: "Mount Rainier, nejvyšší vrchol státu Washington s výškou 4 392 metrů, je aktivní stratovulkán. Jeho ledovce napájejí řeky, formují údolí a živí bohaté lesy i divokou zvěř, což z něj činí důležitou přírodní dominantu."

	key[]: "poi_wa2_02"
	val[]: "Národní les Wenatchee"

	key[]: "poi_wa2_02_desc"
	val[]: "Národní les Wenatchee se rozprostírá přes hory, řeky a horská údolí. V roce 1933 zde byly v rámci programu Civilian Conservation Corps vybudovány turistické stezky a požární rozhledny a trvale tak poznamenaly historii rekreačního využití i ochrany tohoto lesa."

	key[]: "poi_wa2_03"
	val[]: "Národní les Mount Baker-Snoqualmie"

	key[]: "poi_wa2_03_desc"
	val[]: "V národním lese Mount Baker-Snoqualmie se nacházejí některá z nejstarších amerických stanovišť pro monitorování ledovců, kde se již od počátku 20. století sledují ledové toky z vulkánů a klimatické změny v Kaskádovém pohoří."
	
	key[]: "poi_wa2_04"
	val[]: "Řeka Wenatchee"

	key[]: "poi_wa2_04_desc"
	val[]: "Podél řeky Wenatchee dokazují pozůstatky zavlažovacích kanálů a mlýnů z počátku 19. století, jak osadníci využívali její vodu. Domorodé kmeny se na její vody bohaté na lososy spoléhaly jako na zdroj potravy a obchodu už dlouho před příchodem Evropanů."

	key[]: "poi_wa2_05"
	val[]: "Vrchol Klawatti"

	key[]: "poi_wa2_05_desc"
	val[]: "Vrchol Klawatti, na který se poprvé vystoupilo v polovině 20. století, je i nyní vzácně zdoláván kvůli svým strmým, ledovcem pokrytým svahům, což z něj činí vyhledávanou výzvu pro horolezce hledající samotu v Severních Kaskádách."

	key[]: "poi_wa2_06"
	val[]: "Přehrada Dry Falls"

	key[]: "poi_wa2_06_desc"
	val[]: "Přehrada Dry Falls, postavená za účelem regulace místních vodních toků, se tyčí na vrcholu pravěkých čedičových útesů. Reguluje sezónní průtoky a zároveň odhaluje terasy a hluboké tůně, které zde vyhloubily povodně z doby ledové."

	key[]: "poi_wa2_07"
	val[]: "Vyhlídka na požářiště White Mountain"

	key[]: "poi_wa2_07_desc"
	val[]: "Na vyhlídce jsou umístěny informační tabule věnované požáru White Mountain z roku 1988, jednomu z největších lesních požárů ve státě Washington v nedávné historii. Tabule ukazují, jak byl les poznamenán a jak se obnovuje."

	key[]: "wa_cut_helen_desc"
	val[]: "Před rokem 1980 měla Mount St. Helens kuželovitý tvar a byla označována jako „americká Fudži“. Erupce v roce 1980 snížila vrchol hory o necelých 400 metrů a vytvořila kráter ve tvaru podkovy, který je dnes částečně zaplněn sopečným dómem a ledovcem."


##########################################################################################


	key[]: "tb_wa3"
	val[]: "Vinařská oblast"

	key[]: "tb_wa3_desc"
	val[]: "Na východ od Kaskádového pohoří se washingtonské vinice rozprostírají po vinařské oblasti Columbia Valley AVA. Tato oblast zahrnuje státní park Lewise a Clarka, řeku Selah Creek i území, která v minulosti obývaly domorodé kmeny, a vyznačuje se suchou, slunnou krajinou s mírně zvlněnými kopci a říčními údolími."

	key[]: "poi_wa3_01"
	val[]: "Vodopády Clear Creek"

	key[]: "poi_wa3_01_desc"
	val[]: "Kousek na východ od vrcholu průsmyku White Pass se nachází oblíbená vyhlídka na vodopád na řece Clear Creek. Zhruba jednu míli dále na východ vede odbočka k rekreační oblasti Clear Lake, která je známá rybařením a skvělými možnostmi pozorování místní divoké zvěře."

	key[]: "poi_wa3_02"
	val[]: "Most přes Selah Creek"

	key[]: "poi_wa3_02_desc"
	val[]: "Most Freda G. Redmona, známý také jako most přes Selah Creek, je dvojoblouková stavba v okrese Yakima. V době svého dokončení se jednalo o nejdelší betonový obloukový most v Americe a nejvyšší silniční most ve státě Washington."

	key[]: "poi_wa3_03"
	val[]: "Vinice"
	
	key[]: "poi_wa3_03_desc"
	val[]: "Údolí a úrodná půda státu Washington umožňují pěstování mnoha odrůd vinné révy, včetně Rieslingu, Cabernetu a Merlotu. Vinice představují důležitou součást zemědělství tohoto státu i místní krajiny."

	key[]: "poi_wa3_04"
	val[]: "Most Eda Hendlera"

	key[]: "poi_wa3_04_desc"
	val[]: "Tento most, postavený v roce 1978 a někdy nazývaný Intercity Bridge, překlenuje řeku Columbia mezi městy Pasco a Kennewick v jihovýchodní části státu Washington. Od svého otevření je považován za dominantní stavbu a symbol oblasti Tri-Cities."

	key[]: "poi_wa3_05"
	val[]: "Státní park Lewise a Clarka"

	key[]: "poi_wa3_05_desc"
	val[]: "Státní park Lewise and Clarka, jeden z prvních státních parků ve státě Washington, chrání staré lesy podél historické stezky původních obyvatel. Park je pojmenován na počest výpravy Corps of Discovery a jeho lesy připomínají husté hvozdy, které Meriwether Lewis popsal ve svých denících."

	key[]: "poi_wa3_06"
	val[]: "Budova okresního soudu Columbia County"

	key[]: "poi_wa3_06_desc"
	val[]: "Budova okresního soudu Columbia County odráží dobu, kdy okresní správa hrála ústřední roli v každodenním životě. V období rychlého růstu a omezeného spojení s hlavním městem sloužily okresní budovy jako hlavní zdroj autority a řešily bezprostřední potřeby občanů."

	key[]: "poi_wa3_07"
	val[]: "Kmeny původních amerických obyvatel"

	key[]: "poi_wa3_07_desc"
	val[]: "Údolí Columbia Valley a okolní oblasti byly domovem původních obyvatel, mezi něž patřily kmeny Jakima, Valla Valla a Umatilla. Tyto komunity zde žijí dodnes, zachovávají si své kulturní tradice a spravují půdní a vodní zdroje."

##########################################################################################

#@}




#+ Oregon TBs and POIs localization.
#@{
	key[]: "tb_or1"
	val[]: "Pobřeží Tichého oceánu"

	key[]: "tb_or1_desc"
	val[]: "Oregonské pobřeží Tichého oceánu se táhne podél členitých mysů s malebnými vyhlídkami. Zatímco maják Heceta Head shlíží na narážející vlny, Silver Point, Ophir Wayside, Sisters Rocks a Kissing Rock se cestou zvedají čedičovými útesy vstříc tichomořskému příboji."

	key[]: "landmark_or_astoria_b_desc"
	val[]: "Tento most se klene přes řeku Columbia v délce šesti kilometrů, spojuje státy Oregon a Washington a nabízí výhled na ústí řeky i na tichomořský obzor."

	key[]: "poi_or1_01"
	val[]: "Vyhlídka Silver Point"

	key[]: "poi_or1_01_desc"
	val[]: "Tato vyhlídka jižně od Cannon Beach nabízí úchvatný výhled na skálu Haystack Rock a členité pobřeží, které je obzvláště působivé při západu slunce."

	key[]: "or_cut_lighthouse_desc"
	val[]: "Nejvyšší maják v Oregonu, postavený v roce 1873, se tyčí na čedičovém mysu nedaleko Newportu."

	key[]: "or_cut_newport_desc"
	val[]: "Most přes záliv Yaquina, dokončený v roce 1936, patří k nejznámějším pobřežním památkám státu Oregon. Jeho elegantní oblouk, navržený renomovaným inženýrem Conde McCulloughem, se klene nad zálivem Yaquina a dodnes představuje charakteristický prvek silnice US 101."

	key[]: "or_cut_thor_desc"
	val[]: "Přírodní propadlina na mysu Perpetua, kde se rozbíjejí rozbouřené vlny, a vytvářejí tak iluzi odtékajícího oceánu."

	key[]: "poi_or1_02"
	val[]: "Ophir Wayside"

	key[]: "poi_or1_02_desc"
	val[]: "Klidné odpočívadlo nedaleko Gold Beach, kde si návštěvníci mohou protáhnout nohy, pozorovat vlny nebo prozkoumat pláž a hledat naplavené dřevo či acháty."

	key[]: "poi_or1_03"
	val[]: "Vyhlídka Sisters Rock"

	key[]: "poi_or1_03_desc"
	val[]: "Z příboje se tyčí impozantní mořské útesy a stezky vedoucí dolů k malým plážím ukrytým mezi útesy."

	key[]: "poi_or1_04"
	val[]: "Kissing Rock"

	key[]: "poi_or1_04_desc"
	val[]: "Zastávka u silnice jižně od Gold Beach, kde se nad pískem k sobě naklánějí dva mohutné skalní útvary. Díky tomu je toto místo oblíbeným místem pro fotografování."


##########################################################################################

	key[]: "tb_or2"
	val[]: "Divoký východ"

	key[]: "tb_or2_desc"
	val[]: "Tento region, často nazývaný „divoký východ Oregonu“, odhaluje krajinu formovanou geologickými silami v průběhu stovek milionů let, z nichž mnohé jsou aktivní dodnes. V porovnání s tímto časovým měřítkem je lidská historie krátká, přesto je však poznamenána okamžiky stejně dramatickými jako samotná krajina."

	key[]: "landmark_or_deadman_p_desc"
	val[]: "Tato vyhlídka nedaleko Pendletonu nabízí výhled na průsmyk Deadman Pass, pojmenovaný podle události ze 70. let 19. století během války Bannoků, kdy zde byl nalezen mrtvý vozka. O několik desetiletí dříve projíždělo těmito kopci po Oregonské stezce nespočetně vozů."

	key[]: "or_cut_395_desc"
	val[]: "Silnice US 395, kdysi známá jako „Three Flags Highway“, se táhla od Kanady až po Mexiko a spojovala pouště, lesy i hory. Dnes končí u dálnice I-15 v Kalifornii, přičemž v okolí San Diega se dochovaly zbytky původní trasy."

	key[]: "poi_or2_01"
	val[]: "Národní les Malheur"

	key[]: "poi_or2_01_desc"
	val[]: "Národní les Malheur se rozkládá v pohoří Modré hory. Před více než 150 miliony let tvořily některé z nejstarších hornin v této oblasti část sopečných ostrovů v Tichém oceánu, které se později spojily s kontinentem."
	
	key[]: "poi_or2_02"
	val[]: "Přírodní rezervace Badlands"

	key[]: "poi_or2_02_desc"
	val[]: "Přírodní rezervace Badlands, ležící východně od města Bend, představuje drsnou sopečnou krajinu, kterou formovaly dávné lávové proudy a popel navátý větrem. Zdejší zkroucené lávové útvary, písčité půdy a surový terén vytvářejí jedno z nejunikátnějších prostředí vysoko položené pouště v tomto státě."

	key[]: "poi_or2_03"
	val[]: "Jezero Abert"

	key[]: "poi_or2_03_desc"
	val[]: "V okolí jezera Abert, které bylo poprvé zmapováno v roce 1843, žijí lidé už přes 10 000 let. Ačkoli je kvůli vysoké salinitě nevhodné pro ryby, zůstává důležitou zastávkou pro ptáky na migrační trase Pacific Flyway. V posledních desetiletích se v důsledku klimatických změn zmenšuje."

	key[]: "poi_or2_04"
	val[]: "Vyhlídková trasa East Steens"

	key[]: "poi_or2_04_desc"
	val[]: "Trasa East Steens vede po silnici č. 78 podél hory Steens Mountain a pouště Alvord Desert. Jejím zlatým hřebem je solná pláň v poušti Alvord Desert, jedno z největších vyschlých jezer v Oregonu, které se v závislosti na ročním období mění z mělkého jezera na rozlehlou pouštní pláň."

	key[]: "poi_or2_05"
	val[]: "Doherty Slide"

	key[]: "poi_or2_05_desc"
	val[]: "Cesta autem podél Doherty Slide, skalního útvaru vzniklého sopečnou činností, trvá méně než hodinu. Přírodě však trvalo přibližně 16 milionů let, než tuto krajinu vytvarovala do nynější podoby."


##########################################################################################

	key[]: "tb_or3"
	val[]: "Ogdenův stát"

	key[]: "tb_or3_desc"
	val[]: "Tato trasa vede podél vnitrozemského severojižního koridoru v Oregonu a prochází lesy a vysoko položenou pouští. Poprvé ji prozkoumal obchodník s kožešinami Peter Skene Ogden ve 20. letech 19. století a během druhé světové války získala strategický význam díky svým lesním porostům a dopravním trasám."
	
	key[]: "poi_or3_01"
	val[]: "Socha Springfield Flame"

	key[]: "poi_or3_01_desc"
	val[]: "Socha, která je vysoká téměř 20 metrů, označuje severní vjezd do Springfieldu. Je navržena ve tvaru plamene, aby sloužila jako maják pro cestovatele a jako orientační bod pro místní obyvatele i návštěvníky."

	key[]: "poi_or3_02"
	val[]: "Cesta Santiam Wagon Road"

	key[]: "poi_or3_02_desc"
	val[]: "Průsmyk východně od tohoto místa, kdysi známý jako Wiley Pass podle Andrewa Wileyho, prozkoumali v roce 1859 průkopníci hledající cesty pro přehánění dobytka. V roce 1864 se plánovala výstavba vojenské silnice, jejíž podstatná část však nikdy nevznikla. V letech 1868 až 1914 zde fungovala mýtná silnice zvaná Santiam Wagon Road."

	key[]: "poi_or3_03"
	val[]: "Pamětní silnice veteránů"

	key[]: "poi_or3_03_desc"
	val[]: "Na severním vjezdu silnice byly 9. listopadu 2012 jižně od křižovatky Biggs Junction instalovány poslední dvě z celkem 18 pamětních tabulí. Ty označují Camp Rufus jako severní vjezd na první silnici v zemi věnovanou veteránům 2. světové války."

	key[]: "poi_or3_04"
	val[]: "Vyhlídka Ogden State"

	key[]: "poi_or3_04_desc"
	val[]: "Tato vyhlídka, pojmenovaná po Peteru Skene Ogdenovi, průzkumníkovi z počátku 19. století a vedoucímu obchodníkovi společnosti Hudson’s Bay Company, připomíná jeho výpravy po území řeky Snake a jeho roli jako jednoho z prvních průzkumníků povodí Velkého Solného jezera."

	key[]: "landmark_or_fremont_b_desc"
	val[]: "Most a portlandská ulice Fremont Street jsou pojmenovány po Johnu C. Frémontovi, jednom z prvních průzkumníků oblastí Kalifornie a Oregonu. Most se pyšní nejdelším hlavním rozpětím v Oregonu a řadí se na druhé místo mezi nejdelšími mosty s vázaným obloukem na světě."

	
##########################################################################################

#@}



#+ California TBs and POIs localization.
#@{
	key[]: "tb_ca1"
	val[]: "Zlatý horizont"

	key[]: "tb_ca1_desc"
	val[]: "Nad třpytivými vodami se tyčí ikonické mosty, které spojují Alcatraz, Santa Cruz a okolní kopce i čtvrti. Ať už jde o rušné ulice a historické památky, nebo o sluncem zalité pláže a malebné pobřeží, oblast Bay Area umožňuje zažít Kalifornii jako nikde jinde."

	key[]: "ca_cut_golden_gate_bridge_desc"
	val[]: "Most spojující Sanfranciský záliv s Tichým oceánem je ikonickým symbolem San Francisca a Kalifornie. Když byl v roce 1937 otevřen, držel rekord jako nejdelší a nejvyšší visutý most na světě."

	key[]: "poi_ca1_01"
	val[]: "Alcatraz"

	key[]: "poi_ca1_01_desc"
	val[]: "Na ostrově Alcatraz se v letech 1934 až 1963 nacházela federální věznice. Ostrov se proslavil tím, že zde byli vězněni někteří z nejznámějších zločinců v zemi. Dnes je historickou památkou a oblíbenou turistickou destinací."

	key[]: "ca_cut_richmond_desc"
	val[]: "Most Richmond–San Rafael se klene přes Sanfranciský záliv a spojuje města Richmond a San Rafael. Byl otevřen v roce 1956, umožňuje dopravu přes severní část zálivu, vyznačuje se konstrukcí s konzolovými i příhradovými nosníky a představuje klíčové regionální dopravní spojení."
	
	key[]: "poi_ca1_02"
	val[]: "Treasure Island"

	key[]: "poi_ca1_02_desc"
	val[]: "Treasure Island je umělý ostrov vybudovaný pro Mezinárodní výstavu Golden Gate v roce 1939. Původně sloužil jako námořní základna, ale v současnosti je přestavován pro rezidenční a komerční účely."

	key[]: "poi_ca1_03"
	val[]: "Město surfařů"

	key[]: "poi_ca1_03_desc"
	val[]: "Socha surfaře v Santa Cruz je poctou surfovému dědictví a kultuře města. Socha, umístěná nedaleko pláže, vzdává hold místním surfařům a tomuto sportu, který formoval identitu města Santa Cruz i zdejší pobřežní komunitu."

	key[]: "poi_ca1_04"
	val[]: "Madonna Inn"

	key[]: "poi_ca1_04_desc"
	val[]: "Dříve oblíbená restaurace a významné místo pro pořádání akcí na silnici 152. Od roku 2004 je kvůli problémům se silnicí uzavřena, ale pořád zůstává častým tématem na fórech věnovaných místní historii a strašidelným příběhům."



##########################################################################################

	key[]: "tb_ca2"
	val[]: "Trasa Shasta Route"

	key[]: "tb_ca2_desc"
	val[]: "Trasa Shasta Route se vine borovicovými lesy a kolem třpytivých vysokohorských jezer pod horou Mount Shasta. Silnice stoupají a klesají skrytými údolími a vedou cestovatele na jih, zatímco hory postupně mizí z dohledu a ustupují prastarým sekvojím severní Kalifornie."

	key[]: "poi_ca2_01"
	val[]: "Národní les Shasta-Trinity"

	key[]: "poi_ca2_01_desc"
	val[]: "Národní scénická silnice Trinity se vine národním lesem Shasta-Trinity, největším v Kalifornii, a kopíruje trasy, po kterých se v 19. století pohybovali zlatokopové a osadníci."

	key[]: "poi_ca2_02"
	val[]: "Velká laguna"

	key[]: "poi_ca2_02_desc"
	val[]: "Velká laguna je největší a nejjižnější ze tří lagun ve státním parku Humboldt Lagoons. Tyto mělké pobřežní pánve leží mezi skalnatými mysy, kde oceánské vlny vytvořily písčité bariéry oddělující laguny od Tichého oceánu."

	key[]: "or_cut_sequoia_desc"
	val[]: "Národní park Redwood chrání některé z nejvyšších a nejstarších sekvojí vždyzelených na světě, které dosahují výšky přes 110 metrů a mohou se dožít až 2 000 let. Spolu s okolními státními parky chrání asi 35 % zbývajících sekvojových pralesů na světě."
	
	key[]: "poi_ca2_03"
	val[]: "Řeka Smith"

	key[]: "poi_ca2_03_desc"
	val[]: "Tato chráněná oblast, nacházející se v národním lese Six Rivers v severozápadní Kalifornii, byla vyhlášena Kongresem v roce 1990 za účelem zachování krajinných, ekologických a kulturních hodnot. Řeka Smith je jedinou významnou kalifornskou řekou, na které není žádná přehrada a teče volně."

	key[]: "poi_ca2_04"
	val[]: "Most přes Whiskey Creek"

	key[]: "poi_ca2_04_desc"
	val[]: "Most přes Whiskey Creek, dokončený v roce 1961, je třípolová konstrukce se svařovanými deskovými nosníky. Je významný jako jeden z prvních příkladů konstrukce mostu využívající tři různé třídy oceli, což v té době umožnila inovativní svařovací technika."

	key[]: "poi_ca2_05"
	val[]: "Jezero Shasta"

	key[]: "poi_ca2_05_desc"
	val[]: "Jezero Shasta, největší kalifornská nádrž, vzniklo díky stejnojmenné přehradě na řece Sacramento. Bylo dokončeno v roce 1945 a slouží nejen jako zdroj vody a vodní energie, ale i jako malebné místo pro rekreaci."

	key[]: "poi_ca2_06"
	val[]: "Hora Mount Shasta"

	key[]: "poi_ca2_06_desc"
	val[]: "Od 20. let 19. století sloužila hora Mount Shasta, druhý nejvyšší vrchol Kaskádového pohoří, jako orientační bod cestovatelů putujících po stezce Siskiyou Trail na svém úpatí. Z této trasy se později vyvinula dálnice I-5, po které dnes k hoře každoročně směřují tisíce lidí."



##########################################################################################

	key[]: "tb_ca3"
	val[]: "Sierra Crossing"

	key[]: "tb_ca3_desc"
	val[]: "Na úpatí majestátního pohoří Sierra Nevada, uprostřed rozlehlých údolí a zvlněných kopců, leží hotel Inn at Benton. Trasa Sierra Crossing se vine po tichých silnicích vysoko položené pouště, kde vzdálené vrcholy a členité hřebeny vytvářejí nadčasové panorama lákající cestovatele k prozkoumání rozlehlých krajin tohoto regionu."

	key[]: "ca_cut_olmsted_point_desc"
	val[]: "Yosemitský národní park, založený v roce 1890, patří k nejnavštěvovanějším parkům světa. Je známý Yosemitským vodopádem, nejvyšším vodopádem v Severní Americe, rozsáhlou sítí turistických stezek a obřími sekvojemi starými přes 3 000 let."

	key[]: "poi_ca3_01"
	val[]: "Tioga Road"

	key[]: "poi_ca3_01_desc"
	val[]: "Tioga Road je legendární scénická trasa vedoucí srdcem Yosemitského národního parku. Jedná se o nejvýše položené silniční sedlo v Kalifornii, které spojuje západní a východní část pohoří Sierra Nevada."

	key[]: "poi_ca3_02"
	val[]: "Jezero Mono"

	key[]: "poi_ca3_02_desc"
	val[]: "Jezero Mono je staré více než milion let, což z něj činí jedno z nejstarších jezer v Severní Americe. Jelikož nemá žádný přirozený odtok, hromadily se v něm po tisíce let soli a minerály, které sem přinášely potoky tekoucí z východní části pohoří Sierra Nevada."
	
	key[]: "poi_ca3_03"
	val[]: "Jezero Tahoe"

	key[]: "poi_ca3_03_desc"
	val[]: "Jezero Tahoe vzniklo přibližně před 2 miliony let v povodí Tahoe a jeho současný tvar mu daly ledovce z doby ledové. Jedná se o největší horské jezero v Severní Americe a druhé nejhlubší jezero ve Spojených státech."

	key[]: "poi_ca3_04"
	val[]: "Národní les Eldorado"

	key[]: "poi_ca3_04_desc"
	val[]: "Národní les Eldorado je součástí rozsáhlého povodí, které zásobuje vodou miliony obyvatel Kalifornie a podporuje farmy produkující téměř polovinu ovoce a zeleniny v celé zemi."

	key[]: "poi_ca3_05"
	val[]: "Hotel Inn at Benton Hot Springs"

	key[]: "poi_ca3_05_desc"
	val[]: "Benton, jedno z nejstarších měst v okrese Mono County, založili Pajutové, kteří zde využívali horké prameny. V 60. letech 19. století se stalo zastávkou pro osadníky a horníky. Hostinec, postavený ve 40. letech 20. století z místní pemzy, nahradil hotel z roku 1904, který měl 10 pokojů s jedinou společnou koupelnou."



##########################################################################################

	key[]: "tb_ca4"
	val[]: "Slunce a písek"

	key[]: "tb_ca4_desc"
	val[]: "Poušť v Údolí smrti se rozprostírá pod nekonečnou oblohou, s dunami, rozeklanými vrcholy a popraskanými pláněmi. Zajíci poskakují po sluncem zalitém písku, lebky označují tiché stezky a izolované silnice se vinou drsnou, neúprosnou krajinou, která prověřuje a budí úctu u všech, kdo se sem odváží."

	key[]: "poi_ca4_01"
	val[]: "Lone Pine"

	key[]: "poi_ca4_01_desc"
	val[]: "Lone Pine je malé městečko v kalifornském údolí Owens Valley, na východním úpatí pohoří Sierra Nevada. Je známé díky nedalekým skalám Alabama Hills a již dlouhou dobu slouží jako výchozí bod pro turisty, horolezce a filmaře objevující okolní hory a pouštní krajinu."

	key[]: "poi_ca4_02"
	val[]: "Národní park Death Valley"

	key[]: "poi_ca4_02_desc"
	val[]: "Údolí smrti patří k nejextrémnějším krajinám Ameriky – najdeš tady nejnížě položená, nejvýše položená, nejteplejší a nejsušší místa. Dlouho před příchodem průkopníků v 19. století zde žily domorodé kmeny, které se v této drsné, avšak historicky bohaté oblasti věnovaly lovu a sběru."

	key[]: "poi_ca4_03"
	val[]: "Vyhlídka Otce Crowleyho"

	key[]: "poi_ca4_03_desc"
	val[]: "Tento vyhlídkový bod je oblíbeným cílem turistů. Často zde zastavoval otec John J. Crowley, známý jako „pouštní kněz“. Nachází se poblíž západní hranice parku a nabízí úchvatný výhled na Rainbow Canyon, barevný útvar formovaný dávnou sopečnou činností."
	
	key[]: "poi_ca4_04"
	val[]: "Valley Wells v Mohavské poušti"

	key[]: "poi_ca4_04_desc"
	val[]: "Ve Valley Wells v Mohavské poušti se nacházejí pravěké usazeniny vzniklé vývěrem podzemní vody, které dokládají mokřadní prostředí z doby ledové. Tyto historické studny odhalují, jak podzemní voda kdysi živila bažiny a bujnou vegetaci v jinak vyprahlé poušti."

	key[]: "poi_ca4_05"
	val[]: "Indiánská rezervace u řeky Colorado"

	key[]: "poi_ca4_05_desc"
	val[]: "Rezervace se rozkládá podél řeky Colorado v Arizoně a Kalifornii. Byla založena v roce 1865 pro kmeny žijící podél řeky a dnes je domovem kmenů Mohave, Čemevevi, Hopi a Navaho, kde podporuje zemědělství a komunitní život."

##########################################################################################

#@}



#+ Idaho TBs and POIs localization.
#@{

    key[]: "tb_id1"
	val[]: "Treasure Valley"

	key[]: "tb_id1_desc"
	val[]: "Údolí Treasure Valley v jihozápadní části státu Idaho má bohatou historii, kterou formovaly indiánské kmeny, první obchodníci s kožešinami a osadníci z Oregonské stezky. Jeho název odráží přírodní zdroje a příležitosti této oblasti a později se region rozvíjel díky zemědělství, železnici a obchodu soustředěnému kolem města Boise."

	key[]: "poi_id1_01"
	val[]: "Řeka Salmon"

	key[]: "poi_id1_01_desc"
	val[]: "Řeka Salmon v Idahu se táhne 684 km hlubokým a členitým kaňonem. Získala si přezdívku „Řeka, odkud není návratu“, protože dřívější plavidla nedokázala plout zpět proti jejímu silnému a náročnému proudu."

	key[]: "poi_id1_02"
	val[]: "Národní les Boise"

	key[]: "poi_id1_02_desc"
	val[]: "Národní les Boise, který se nachází idažském batolitu snadno podléhajícím erozi, se vyznačuje drsnou krajinou utvářenou sopečnou činností. Toto geologické dědictví je nejlépe patrné na strmých kaňonech a mnoha přírodních horkých pramenech rozprostřených po celém území."

	key[]: "poi_id1_03"
	val[]: "Horseshoe Bend"

	key[]: "poi_id1_03_desc"
	val[]: "Poté, co bylo v roce 1862 v pánvi Boise nalezeno zlato, založili horníci zimující u řeky město Horseshoe Bend. Město, které se původně jmenovalo Warrinersville podle místního majitele pily, přijalo svůj současný název v roce 1867, když se stalo klíčovou zastávkou zlatokopů."
	
	key[]: "poi_id1_04"
	val[]: "Toll Gate"

	key[]: "poi_id1_04_desc"
	val[]: "V roce 1864 nahradila strmou stezku Syrup Creek nová trasa vedoucí kaňonem. Její údržbu po dobu 20 let financovaly mýtné poplatky, zatímco slavný hotel a mlékárna Jamese A. Portera se staly oblíbeným místem cestovatelů hledajících útočiště."

	key[]: "poi_id1_05"
	val[]: "Castle Rock"

	key[]: "poi_id1_05_desc"
	val[]: "Směrem k Camas Prairie sloužily žulové skalní výchozy Castle Rock jako charakteristické orientační body pro osadníky putující po Oregonské stezce trasou Goodale’s Cutoff. Tyto vzácné útvary, které se využívaly od roku 1862 až do éry automobilů, nabízely cestovatelům podél trasy působivé pohledy."

    key[]: "poi_id1_06"
	val[]: "Indiánská rezervace Duck Valley"

	key[]: "poi_id1_06_desc"
	val[]: "V roce 1886 prezident Cleveland rozšířil Duck Valley do státu Idaho prostřednictvím „Paddy Cap Extension“. Do roku 1934 získaly různé kmeny, které se přestěhovaly do rezervace, oficiální federální uznání jako sjednocené kmeny Šošonů a Pajutů."


##########################################################################################

    key[]: "tb_id2"
	val[]: "Údolí Magic Valley"

	key[]: "tb_id2_desc"
	val[]: "Na počátku 20. století proměnil I. B. Perrine suchou poušť v Idahu v zemědělskou půdu vybudováním přehrady Milner. Přehrada, jejíž stavba byla dokončena v roce 1905, využívala vodu z řeky Snake a „magicky“ proměnila krajinu. Tak vzniklo údolí Magic Valley, které vedlo k rozkvětu dodnes existujících zemědělských městeček."

	key[]: "id_cut_perrine_desc"
	val[]: "Vodopády Shoshone Falls, které jsou se svými 64 metry vyšší než Niagarské vodopády, jsou nádhernou dominantou řeky Snake a nacházejí se přímo na okraji města Twin Falls."

	key[]: "id_cut_galena_desc"
	val[]: "Toto hornické město, založené v roce 1879 po objevu ložiska olova a stříbra, začalo po roce 1890 upadat v důsledku poklesu cen. Dnes se tato oblast těší rozkvětu jako rekreační letovisko, kde se nachází historický hotel Galena Lodge a nedaleký malebný vrchol Galena Summit."

	key[]: "poi_id2_01"
	val[]: "Bison Jump"

	key[]: "poi_id2_01_desc"
	val[]: "Bison Jump, nacházející se v městečku Challis, je historické místo, kde domorodí obyvatelé hnali bizony z útesů, aby je ulovili. Tato strategická lokalita, využívaná již více než 2 000 let, nabízí nahlédnutí do starodávných tradic komunitního lovu."
	
	key[]: "poi_id2_02"
	val[]: "Grand View Canyon"

	key[]: "poi_id2_02_desc"
	val[]: "Grand View Canyon, který se rozkládá podél vyhlídkové trasy Peaks to Craters Scenic Byway na silnici US 93, nabízí úchvatné výhledy na pohoří Lost River Range. V tomto horském masivu se nachází devět nejvyšších vrcholů státu Idaho, díky čemuž je tento kaňon jedním ze zlatých hřebů této vyhlídkové trasy."

	key[]: "landmark_id_mackay_rs_desc"
	val[]: "Řeka Big Lost River, původně nazývaná Goddin’s River podle lovce kožešin Thyeryho Goddina, je známá tím, že mizí v lávových polích. Tato „ztracená“ voda teče v podzemí a nakonec znovu vyvěrá v nádherném místě zvaném Thousand Springs nedaleko řeky Snake."

    key[]: "poi_id2_03"
	val[]: "Opuštěná města Mackay"

	key[]: "poi_id2_03_desc"
	val[]: "Města jako White Knob a Cliff Creek, která vznikla kolem dolu Mine Hill v těžebním revíru White Knob, vzkvétala až do poloviny 20. století díky rozmachu těžby mědi, zlata a stříbra. Tato místa dodnes představují klíčové pozůstatky historického těžebního průmyslu státu Idaho."

	key[]: "id_cut_craters_desc"
	val[]: "Oblast Craters of the Moon, která vznikla v důsledku sopečných erupcí před 15 000 lety, se vyznačuje rozlehlou krajinou tvořenou lávovými proudy a struskovými kužely. Její mimozemsky působící terén je natolik jedinečný, že jej v minulosti astronauti NASA využívali k přípravě pro mise na Měsíc."



##########################################################################################

#@}



#+ Montana TBs and POIs localization.
#@{

    key[]: "tb_mt1"
	val[]: "Průsmyk Glacier"

	key[]: "tb_mt1_desc"
	val[]: "Na území Glacier Country se nacházejí některé z posledních aktivních ledovců ve Skalnatých horách. V průběhu tisíciletí tyto prastaré ledové masy vytesaly hluboká údolí, ostré vrcholy a nedotčená jezera, a tak utvářely krajinu, která dnes charakterizuje západní Montanu."

	key[]: "poi_mt1_01"
	val[]: "Vodopád Kootenai"

	key[]: "poi_mt1_01_desc"
	val[]: "Vodopád Kootenai Falls je největším vodopádem v Montaně, který není součástí přehrady, a představuje významnou regionální atrakci. Řeka Kootenai klesá během krátké vzdálenosti o přibližně 90 metrů, čímž vytváří mohutnou a malebnou kaskádu lákající návštěvníky svými nezapomenutelnými výhledy."

	key[]: "poi_mt1_02"
	val[]: "Berne Roadside Park"

	key[]: "poi_mt1_02_desc"
	val[]: "Kaňon Bad Rock byl oblíbenou zastávkou cestovatelů podél řeky Flathead, známou díky rybaření, malebným výhledům a přírodnímu prameni, který se kdysi používal k chlazení přehřátých chladičů automobilů. V roce 1956 se stal jedním z prvních odpočívadel v Montaně pod názvem Berne Roadside Park."

	key[]: "poi_mt1_03"
	val[]: "Heavens Peak"

	key[]: "poi_mt1_03_desc"
	val[]: "Heavens Peak, jedna z nejznámějších hor národního parku Glacier, byla pojmenována v 90. letech 19. století prospektorem Louiem Meyerem. Průzkumníci, ohromeni její krásou a impozantní stěnou Garden Wall, ji považovali za něco, s čím se na své cestě dosud nesetkali."

	key[]: "mt_cut_glacier_national_park_desc"
	val[]: "Národní park Glacier, označovaný jako „Koruna kontinentu“, byl založen v roce 1910. Vznikl díky pravěkým ledovcům a široké veřejnosti se stal přístupnějším v roce 1932 po dokončení silnice „Going-to-the-Sun“, která je dnes historickou inženýrskou dominantou."

	key[]: "poi_mt1_04"
	val[]: "Památník Černonožců"

	key[]: "poi_mt1_04_desc"
	val[]: "Na východním okraji národního parku Glacier se rozkládá území Černonožců. Tento kmen, známý jako „válečníci z plání“, získal své jméno pravděpodobně podle mokasínů ztmavených popelem. Dodnes je v parku několik míst, která jsou pro tento kmen posvátná."

	key[]: "mt_cut_flathead_lake_desc"
	val[]: "Jezero Flathead je rozlohou největším přírodním sladkovodním jezerem v sousedících státech Spojených států. Je napájeno tajícími sněhy z okolních hor a jeho mimořádně čistá voda se každých několik let plně obnovuje, což z něj činí jedno z nejčistších velkých jezer na světě."

	key[]: "mt_cut_thompson_falls_desc"
	val[]: "Město, pojmenované po britsko-kanadském obchodníkovi s kožešinami a kartografovi Davidu Thompsonovi, se začalo rozrůstat po přivedení železnice v roce 1881. Dále se rozšiřovalo během zlaté horečky v nedalekém Coeur d’Alene, kdy se stalo klíčovou zastávkou pro horníky směřující po stezce Murray Trail."

	key[]: "landmark_mt_missoula_desc"
	val[]: "Neoklasicistní budova okresního soudu Missoula, postavená z pískovce podle návrhu A. J. Gibsona z roku 1910, nahradila dřívější, menší stavbu. Okres Missoula County, založený v roce 1860, je jednou z nejstarších správních jednotek státu Montana a rozprostírá se od pohoří Bitterroot až po Skalnaté hory."

    key[]: "poi_mt1_05"
	val[]: "Lolo Creek"

	key[]: "poi_mt1_05_desc"
	val[]: "Koridor mezi obcí Lolo a průsmykem Lolo Pass kopíruje historickou trasu podél potoka Lolo Creek. Tuto trasu kdysi využívali indiáni kmene Nez Perce, první osadníci i Lewisova a Clarkova expedice, a dodnes představuje významnou kulturní a historickou krajinu s řadou informačních stanovišť."

##########################################################################################

    key[]: "tb_mt2"
	val[]: "Velké pláně"

	key[]: "tb_mt2_desc"
	val[]: "Velké pláně v Montaně se rozprostírají ve východní části státu a vyznačují se rozsáhlými travnatými porosty, zvlněnými prériemi a širokou otevřenou oblohou. V této oblasti byly objeveny některé z nejvýznamnějších fosilií dinosaurů v Severní Americe, které nám umožňují nahlédnout do krajiny, jaká zde existovala před miliony let."

	key[]: "poi_mt2_01"
	val[]: "Souvrství Hell Creek"

	key[]: "poi_mt2_01_desc"
	val[]: "Souvrství Hell Creek, které se soustředí podél potoka Hell Creek nedaleko města Jordan v Montaně, zachovává prastarou subtropickou krajinu s řekami, lesy a bažinami. Tato formace, jejíž stáří se odhaduje na 66–67 milionů let, je proslulá po celém světě bohatým nalezištěm fosilií dinosaurů, včetně ikonického Tyrannosaura rexe."

	key[]: "poi_mt2_02"
	val[]: "Řeka Yellowstone"

	key[]: "poi_mt2_02_desc"
	val[]: "Řeka Yellowstone je nejdelší volně tekoucí řeka v sousedících státech Spojených států. Pramení v Yellowstonském národním parku a protéká 1 088 km přes Wyoming a Montanu, než se vlije do řeky Missouri, přičemž po celé své délce teče bez jediné přehrady."

	key[]: "poi_mt2_03"
	val[]: "Glendisaurus"

	key[]: "poi_mt2_03_desc"
	val[]: "Glendisaurus, socha triceratopse v životní velikosti v Glendive, připomíná bohatou historii dinosaurů v tomto regionu. Je vysoká přibližně 3 metry a je oblíbenou dominantou, která je na Dinosaur Trail k vidění."
	
	key[]: "poi_mt2_04"
	val[]: "Řeka Missouri"

	key[]: "poi_mt2_04_desc"
	val[]: "Řeka Missouri, známá pod přezdívkou „Big Muddy“, je nejdelší řekou ve Spojených státech. Protéká v délce 2 341 mil od Skalnatých hor v Montaně až k řece Mississippi a sehrála klíčovou roli při průzkumu, obchodu a rozšíření americké hranice směrem na západ."

	key[]: "mt_cut_fort_peck_spillway_desc"
	val[]: "Přehrada Fort Peck, postavená během Velké hospodářské krize, je největší hydraulicky plněnou zemní hrází na světě. Byla dokončena jako jeden z největších amerických veřejných stavebních projektů s cílem zajistit pracovní místa, zadržet povodně a vyrábět vodní energii."

    key[]: "poi_mt2_05"
	val[]: "Muzeum průkopníků Valley County"

	key[]: "poi_mt2_05_desc"
	val[]: "Toto muzeum přibližuje historii severovýchodní Montany prostřednictvím expozic věnovaných kmeni Assiniboinů, železnicím, zemědělství, přehradě Fort Peck či expedici Lewise a Clarka. Nachází se zde také rozsáhlý archiv a jedna z největších sbírek kmene Assiniboinů v celé zemi."

	key[]: "poi_mt2_06"
	val[]: "Balvan spícího bizona"

	key[]: "poi_mt2_06_desc"
	val[]: "Tyto velké balvany, vytvořené a přesunuté pravěkými ledovci, byly pro domorodé kmeny posvátnými orientačními body. Menší balvan „Buffalo Rock“ byl vytesán tak, aby připomínal bizona, zatímco na větším „Medicine Rock“ se nacházejí různé petroglyfy."



##########################################################################################

#@}



#+ Wyoming TBs and POIs localization.
#@{

    key[]: "tb_wy1"
	val[]: "Stezka Buffalo"

	key[]: "tb_wy1_desc"
	val[]: "Tato oblast, v níž se nacházejí národní parky Yellowstone a Grand Teton, leží na aktivním vulkanickém systému, který dodává energii gejzírům a horkým pramenům, zatímco ledovce a zlomy utvářely zdejší vrcholy a údolí. Díky těmto silám patří severozápadní Wyoming ke geologicky nejdynamičtějším a opticky nejpůsobivějším krajinám amerického Západu."

	key[]: "landmark_wy_yellowsto_desc"
	val[]: "Yellowstone, založený v roce 1872 jako první národní park na světě, leží na vrcholu mohutné spící sopky. Nachází se zde přibližně polovina všech aktivních gejzírů na světě a park zároveň chrání jeden z největších a nejzachovalejších ekosystémů mírného pásma na Zemi."

	key[]: "poi_wy1_01"
	val[]: "Lower Geyser Basin"

	key[]: "poi_wy1_01_desc"
	val[]: "Lower Geyser Basin je největší gejzírové pole Yellowstonského národního parku, kde se nachází obrovské množství gejzírů, horkých pramenů a fumarol. Díky teplu z hlubokého podzemního magmatu představuje jednu z geotermálně nejaktivnějších oblastí parku."

	key[]: "poi_wy1_02"
	val[]: "Jezero Yellowstone"

	key[]: "poi_wy1_02_desc"
	val[]: "Jezero Yellowstone je největším vysokohorským jezerem v Severní Americe a je domovem největší populace divokých pstruhů žlutohrdlých na tomto kontinentu. Vědci se domnívají, že kdysi odtékalo do Tichého oceánu, což rybám umožňovalo překonávat kontinentální rozvodí přes průsmyk Two Ocean Pass."
	
	key[]: "poi_wy1_03"
	val[]: "Přehrada Buffalo Billa"

	key[]: "poi_wy1_03_desc"
	val[]: "Přehrada Buffalo Billa, dokončená v roce 1910, byla jednou z prvních betonových obloukových přehrad ve Spojených státech. Se svou výškou 100 metrů byla v té době nejvyšší přehradou na světě a stala se symbolem raných inženýrských inovací."

	key[]: "poi_wy1_04"
	val[]: "Colterovo peklo"

	key[]: "poi_wy1_04_desc"
	val[]: "Colterovo peklo je historická geotermální oblast podél řeky Shoshone, kterou v roce 1807 pojmenoval průzkumník John Colter. První trapeři přirovnávali její kouřící průduchy a sirný zápach k „peklu“. Dnes jsou aktivní již pouze horké prameny a fumaroly."

	key[]: "wy_cut_grand_teton_desc"
	val[]: "Národní park Grand Teton se vyznačuje svými ledovcem vytesanými vrcholy, které se strmě tyčí nad údolím Jackson Hole. Tyto hory, které lovci kožešin kdysi nazývali „Pilot Knobs“ kvůli jejich dobré viditelnosti přes pláně, patří i nadále k nejznámějším dominantám amerického Západu."

	key[]: "poi_wy1_05"
	val[]: "Crowheart Butte"

	key[]: "poi_wy1_05_desc"
	val[]: "Crowheart Butte je výrazná přírodní dominanta, která byla pojmenována podle bitvy z roku 1866 mezi Šošony a Vraními indiány. Podle tradice umístil náčelník Washakie po vítězství Šošonů srdce náčelníka Vraních indiánů na vrchol kopce jako varování, a tím tento útvar získal jméno, které už mu zůstalo."

##########################################################################################

    key[]: "tb_wy2"
	val[]: "Červená poušť"

	key[]: "tb_wy2_desc"
	val[]: "Červená poušť ve Wyomingu je rozlehlá vysokohorská pouštní kotlina, kterou charakterizují větrem tvarované písečné duny, pláně porostlé pelyňkem a působivé červené skalní útvary. Jedná se o jednu z největších neobydlených oblastí v Severní Americe, jejíž podobu formovalo extrémní klima, starodávná jezerní dna a dlouhé migrační trasy."

	key[]: "poi_wy2_01"
	val[]: "Červený kaňon"

	key[]: "poi_wy2_01_desc"
	val[]: "Červený kaňon vznikl zdvihem pohoří Wind River před přibližně 60 miliony let. Jeho charakteristické červené útesy jsou tvořeny horninou zvanou Chugwater, jejíž oxidované železo dodává kaňonu sytou barvu a název."

	key[]: "poi_wy2_02"
	val[]: "Mocné přírodní scenérie"

	key[]: "poi_wy2_02_desc"
	val[]: "Boar’s Tusk, sopečný skalní útvar tyčící se více než 120 metrů nad Červenou pouští ve Wyomingu, je erodovaným jádrem sopky, která vznikla před miliony let. Shlíží na rozlehlé písečné duny Killpecker, které jsou součástí největšího aktivního dunového pole v Severní Americe."

	key[]: "poi_wy2_03"
	val[]: "Rock Springs"

	key[]: "poi_wy2_03_desc"
	val[]: "Rock Springs je díky své rozmanité přistěhovalecké historii známé jako „město 56 národností“. Na konci 19. století sem přicházeli lidé z celého světa, aby pracovali v uhelných dolech společnosti Union Pacific. Město je také spojováno se slavným psancem Butchem Cassidym."
	
	key[]: "poi_wy2_04"
	val[]: "Chata Butche Cassidyho"

	key[]: "poi_wy2_04_desc"
	val[]: "Butch Cassidy byl slavný americký psanec, který stál v čele bandy „Wild Bunch“, známé svými loupežemi vlaků a bank na Divokém západě. Přezdívku „Butch“ získal během svého působení v řeznictví v Rock Springs. Jeho nejlegendárnější a nejvlivnější loupeží byla loupež vlaku ve Wilcoxu v roce 1899."

	key[]: "wy_cut_evanston_desc"
	val[]: "Město Evanston, založené v roce 1869 společností Union Pacific Railroad, bylo pojmenováno po zeměměřiči Jamesovi A. Evansovi. Město se rozrostlo jako železniční uzel a později se stalo regionálním centrem zemědělského, ropného a plynárenského průmyslu."

    key[]: "poi_wy2_05"
	val[]: "Lander Cutoff"

	key[]: "poi_wy2_05_desc"
	val[]: "Lander Cutoff, vybudovaný na základě zákona o pacifických vozových cestách z roku 1857, byl jednou z prvních federálně financovaných vozových cest na americkém Západě. Pojmenován byl po inženýrovi Fredericku W. Landerovi a poskytoval kratší trasu pro emigranty směřující na západ."

	

##########################################################################################

#@}


#+ South Dakota TBs and POIs localization.
#@{

    key[]: "tb_sd1"
	val[]: "Pohoří Black Hills"

	key[]: "tb_sd1_desc"
	val[]: "Západ Jižní Dakoty charakterizují pohoří Black Hills a rezervace Badlands. Zde se rozlehlé prérie mění v borovicemi porostlé hory, žulové věže a volně se pasoucí stáda bizonů. Hned za nimi se rozprostírá drsná oblast Badlands s působivou krajinou, kterou po miliony let formoval vítr a voda."

	key[]: "poi_sd1_01"
	val[]: "Národní les Black Hills"

	key[]: "poi_sd1_01_desc"
	val[]: "Tato oblast porostlá borovicemi, které se mezi Lakoty říká Paha Sapa (což znamená „Černé kopce“), je místem, kde se nachází vrchol Black Elk Peak, nejvyšší bod Jižní Dakoty s výškou 2 207 metrů. Byl přejmenován na počest jednoho slavného lakotského léčitele a zároveň je nejvyšším vrcholem na východ od Skalnatých hor."

	key[]: "sd_cut_rush_desc"
	val[]: "Mount Rushmore, známý jako americká „svatyně demokracie“, byl vytesán do pohoří Black Hills v letech 1927 až 1941. Součástí památníku jsou téměř dvacetimetrové sochy prezidentů Washingtona, Jeffersona, Roosevelta a Lincolna, které symbolizují zrod, růst, rozvoj a ochranu země."

	key[]: "poi_sd1_02"
	val[]: "Most přes Beaver Creek"

	key[]: "poi_sd1_02_desc"
	val[]: "Tento ocelobetonový obloukový most, postavený v roce 1929, má na délku 69 m a klene se nad kaňonem nedaleko národního parku Wind Cave. Tyčí se 35 metrů nad dnem kaňonu a jako jediný most svého druhu v Jižní Dakotě byl navržen tak, aby plynule splynul s okolními skalami."

	key[]: "sd_cut_sturgis_desc"
	val[]: "Město Sturgis je známé tím, že se zde koná největší sraz motorkářů na světě. Tuto každoroční desetidenní akci, kterou v roce 1938 založil místní prodejce motocyklů značky Indian Pappy Hoel, navštěvují motorkáři z celého světa, kteří se sjíždějí do pohoří Black Hills, aby si užili motocyklové výstavy, závody, hudbu a oslavy."

	key[]: "sd_cut_deadwood_desc"
	val[]: "Město Deadwood vzniklo během zlaté horečky v pohoří Black Hills v roce 1876 a stalo se jedním z nejznámějších měst Divokého západu. V roce 1961 bylo prohlášeno za národní historickou památku a je jediným městem v USA s tímto statusem, které si zachovalo velkou část svého historického centra."

	key[]: "sd_cut_badlands_desc"
	val[]: "Národní park Badlands se rozkládá na ploše přibližně 99 000 hektarů a tvoří jej skalní pahorky, jehly a věže, spolu s největší chráněnou smíšenou travnatou prérií v zemi. Nachází se zde také jedno z nejbohatších nalezišť zkamenělin na světě, které odhaluje pravěké savce kdysi obývající Velké pláně."

	key[]: "poi_sd1_03"
	val[]: "Tunel Doane Robinsona"

	key[]: "poi_sd1_03_desc"
	val[]: "Doane Robinson, známý jako „otec Mount Rushmore“, měl vizi velkolepého památníku v pohoří Black Hills, který by přilákal návštěvníky do Jižní Dakoty. Jeho odkaz žije dodnes – vyhlídkový tunel Doane Robinsona nabízí dokonalý pohled na Mount Rushmore jako v rámu."

	key[]: "sd_cut_hot_springs_desc"
	val[]: "Město Hot Springs, které Siouxové původně nazývali Minnekahta kvůli jeho horkým vodám, bylo založeno v roce 1879 v okolí minerálních pramenů, o nichž se věřilo, že mají léčivé účinky. V roce 1882 bylo přejmenováno, stalo se lázeňským střediskem a dodnes je známé díky historickému koupališti Evans Plunge."

	key[]: "poi_sd1_04"
	val[]: "Naleziště Mammoth Site"

	key[]: "poi_sd1_04_desc"
	val[]: "Mammoth Site je světově proslulé naleziště fosilií z doby ledové, kde bylo odkryto 61 mamutů. Tato prastará propadlina, objevená v roce 1974, uchovává největší sbírku pozůstatků mamuta kolumbijského v Severní Americe a vykopávky zde probíhají dodnes."

##########################################################################################

    key[]: "tb_sd2"
	val[]: "Velké rozvodí"

	key[]: "tb_sd2_desc"
	val[]: "Oblast řeky Missouri v Jižní Dakotě rozděluje stát na dvě poloviny, přičemž na jedné straně se rozprostírají široké pláně a na druhé zvlněné kopce. Tato oblast byla klíčovou trasou pro domorodé kmeny, obchodníky s kožešinami i expedici Lewise a Clarka, a později se stala domovem velkých přehrad, pohraničních měst a bohaté historie spojené s řekou."

	key[]: "poi_sd2_01"
	val[]: "Čtyři velká jezera"

	key[]: "poi_sd2_01_desc"
	val[]: "Jezera Oahe, Sharpe, Francise Case i Lewise a Clarka, která vznikla na konci 40. let 20. století díky přehradám na řece Missouri, dnes tvoří charakteristický rys střední části Jižní Dakoty. Tyto přehradní nádrže dohromady nabízejí více než 700 kilometrů břehů pro plavbu lodí, rybaření a rekreaci."

	key[]: "poi_sd2_02"
	val[]: "Opuštěné město Bangor"

	key[]: "poi_sd2_02_desc"
	val[]: "Bangor byl kdysi správním centrem okresu Walworth, ale když byly v roce 1899 jeho budovy přemístěny do nedalekého Selby, stalo se z něj opuštěné město. Místo, kde kdysi město stávalo, už v současnosti připomíná pouze památník."

	key[]: "landmark_sd_state_capitol_desc"
	val[]: "Město Pierre, založené v roce 1880, se stalo hlavním městem Jižní Dakoty, když se tento stát v roce 1889 připojil k Unii. Město, které bylo vybráno díky své centrální poloze a přechodu přes řeku Missouri, bylo pojmenováno po francouzsko-americkém obchodníkovi s kožešinami Pierrovi Chouteauovi juniorovi."

	key[]: "sd_cut_corn_desc"
	val[]: "Corn Palace v Mitchellu je jediný palác na světě, který je celý vyzdoben kukuřicí. Každý rok zde místní umělci a zemědělci vytvářejí nové nástěnné malby z přirozeně zbarvené kukuřice, obilovin a trav, díky čemuž patří k nejunikátnějším památkám Jižní Dakoty."

	key[]: "landmark_sd_largest_pheasant_desc"
	val[]: "V Huronu se nachází „Největší bažant světa“ – 12 metrů vysoká socha ze sklolaminátu a oceli, postavená v roce 1959. Tato socha, která váží 22 tun, připomíná dlouholetou pověst regionu jako jedné z nejvýznamnějších destinací pro lov bažantů v Americe."

	key[]: "landmark_sd_dignity_of_earth_and_sky_desc"
	val[]: "Důstojnost země a nebe je 15 metrů vysoká socha z nerezové oceli, která se tyčí nad řekou Missouri nedaleko města Chamberlain. Jejím autorem je umělec Dale Lamphere a socha vzdává hold dědictví, odolnosti a kulturám kmenů Lakota a Dakota."

##########################################################################################

#@}
