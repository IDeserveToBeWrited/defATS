#+ Text deviations for American Truck Simulator. Please, use only terms appropriate for USA (i.e. culture specific nuances, not American English).
#@{

#+ Music/radio player
#@{

#+ Hint shown if no music files are found. Also shown as tooltip when hovering over music_player button.

	key[]: "music_player_hint"
	val[]: "Vlož své skladby do složky <color value=@@clr_sel@@>American Truck Simulator/music<color value=@@clr_txt@@>, která je umístěna v <color value=@@clr_sel@@>Dokumentech<color value=@@clr_txt@@>, a uvidíš je zde."

#+ Tooltip shown when hovering over the radio_stream button.

	key[]: "radio_hint"
	val[]: "Uprav soubor <color value=@@clr_sel@@>live_streams.sii<color value=@@clr_txt@@> ve složce <color value=@@clr_sel@@>American Truck Simulator<color value=@@clr_txt@@>, která je umístěna v <color value=@@clr_sel@@>Dokumentech<color value=@@clr_txt@@>, a poslouchej své oblíbené internetové rádio přímo ve hře!"

#+ Hint shown if no online radio streams are defined.

	key[]: "empty_radio_hint"
	val[]: "Pročti si prosím soubor <color value=@@clr_sel@@>readme.rtf<color value=@@clr_txt@@> ve složce <color value=@@clr_sel@@>American Truck Simulator<color value=@@clr_txt@@>, která je umístěna v <color value=@@clr_sel@@>Dokumentech<color value=@@clr_txt@@>, abys zjistil, jak přidat svou vlastní hudbu a streamovaná rádia."
#@}

#+ Messages shown as part of the tutorial.
#+
