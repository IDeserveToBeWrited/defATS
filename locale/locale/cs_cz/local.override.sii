#@{

	key[]: "intro_1"
	val[]: "Vítejte v American Truck Simulator!"
#@}

#+ Input wizard
#@{
	key[]: "wiz_cfg_steam"
	val[]: "Pro tento ovladač můžeš zkontrolovat i nakonfigurovat mapování tlačítek a os pomocí klienta služby Steam. Nastavení gamepadu pro hru přes službu Steam je k dispozici v Steam > Knihovna > American Truck Simulator > Nastavení ovladače."
#@}

