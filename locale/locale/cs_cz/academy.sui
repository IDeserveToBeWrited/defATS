	val[]: "Rozjeď se, najdi své parkovací místo a připrav se na couvání."

	key[]: "aca_msg_book3_parallel_check1"
	val[]: "Zacouvej na místo."

	key[]: "aca_msg_book3_parallel_stop"
	val[]: "Zastav na vyznačeném místě."

	key[]: "aca_msg_book3_parallel_end"
	val[]: "Zajisti tahač a vypni motor."
