#### 3_20 msg - intro text

	key[]: "aca_msg_book1_3_20_cutscene01"
	val[]: "Vítej ve druhé části závěrečné zkoušky. Přesuneme se na nedaleké parkoviště a otestujeme tvé dovednosti v couvání a manévrování do parkovacích míst."

	key[]: "aca_msg_book1_3_20_cutscene02"
	val[]: "Čeká tě několik parkovacích výzev v řadě, které otestují tvé schopnosti."

	key[]: "aca_msg_book1_3_20_cutscene03"
	val[]: "Místa je málo, takže buď opatrný a nespěchej."

	key[]: "aca_msg_book1_3_20_cutscene04"
	val[]: "Využívej prostoru kolem sebe a používej všechna zrcátka ve svůj prospěch. Hodně štěstí!"




#### 3_20 outro text

	key[]: "aca_msg_book1_3_20_outro01"
	val[]: "Gratulujeme, úspěšně jsi dokončil zkoušky Základy řízení kamionu a naučil ses všechny potřebné dovednosti ke správnému ovládání kamionu."

	key[]: "aca_msg_book1_3_20_outro02"
	val[]: "Tohle je první krok ke splnění tvého snu stát se profesionálním řidičem kamionu."

	key[]: "aca_msg_book1_3_20_outro03"
	val[]: "Nyní jsi připraven vyrazit na americké silnice a čelit svým prvním výzvám..."

	key[]: "aca_msg_book1_3_20_outro04"
	val[]: "...ale dobrodružství teprve začíná."


#### 3_20 Driving Instructions

	key[]: "aca_msg_book1_3_20_start"
	val[]: "Buď opatrný a nespěchej. Je v pořádku, pokud se ti to nepovede na první pokus, důležité je nepoškodit kamion nebo věci kolem sebe.<font face=/font/big_bold.font>Připrav se k jízdě.</font>"

	key[]: "aca_msg_book1_3_20_forward"
	val[]: "<font face=/font/big_bold.font>Jeď vpřed k první části zkoušky.</font>"

	key[]: "aca_msg_book1_3_20_park1"
	val[]: "Tvým prvním úkolem je předvést parkování do strany. Místo, kam musíš zacouvat, je po tvé levici.<br><br><font face=/font/big_bold.font>Zacouvej do strany na parkovací místo.</font>"

	key[]: "aca_msg_book1_3_20_park2"
	val[]: "Dalším úkolem je zacouvání mezi řadu zaparkovaných kamionů. Buď opatrný, abys nepoškodil ostatní kamiony!<br><br><font face=/font/big_bold.font>Zaparkuj pod úhlem.</font>"

	key[]: "aca_msg_book1_3_20_park3"
	val[]: "Pokračuj parkovištěm. Dávej pozor na nečekané situace.<br><br><font face=/font/big_bold.font>Pokračuj v jízdě.</font>"

	key[]: "aca_msg_book1_3_20_park4"
	val[]: "Nyní vyzkoušíme podélné parkování mezi dvěma kamiony u krajnice před tebou.<br><br><font face=/font/big_bold.font>Zaparkuj podélně.</font>"

	key[]: "aca_msg_book1_3_20_park5"
	val[]: "Poslední parkovací manévr je po tvé levici. Můžeš si vybrat, jak ho provedeš.<br><br><font face=/font/big_bold.font>Zacouvej do vyznačeného místa.</font>"

	key[]: "aca_msg_book1_3_20_park6"
	val[]: "Téměř hotovo. Opusť testovací plochu a zaparkuj kamion.<br><br><font face=/font/big_bold.font>Vlevo vyjeď z testovací plochy.</font>"

	key[]: "aca_msg_book1_3_20_stop"
	val[]: "Můžeš zaparkovat kamion napravo mezi ostatní.<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_20_end"
	val[]: "@@aca_msg_book1_2_01_end@@"


#!}

#@}


#+ Book 1 Scenario 3_22
#@{

#### 3_22 common
	key[]: "aca_scenario_book1_3_22_title"
	val[]: "Podélné parkování s návěsem"

	key[]: "aca_scenario_book1_3_22_desc"
	val[]: "V tomto scénáři se podíváme na podélné parkování s připojeným návěsem."

#### 3_22 goal


	key[]: "aca_goal_book1_3_22_stopmid"
	val[]: "Zastavení na vyznačeném místě"
#!{
	key[]: "aca_goal_book1_3_22_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_22_check1"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_22_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_22_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_22_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
  #!}
#### 3_22 msg - intro text

	key[]: "aca_msg_book1_3_22_cutscene1"
	val[]: "Podélné parkování s návěsem je důležitá dovednost všech řidičů kamionu.<br>Ať už parkování na ulici ve velkoměstě nebo na odpočívadle na venkově, každý kamioňák by ho měl zvládnout."

	key[]: "aca_msg_book1_3_22_cutscene2"
	val[]: "Jak budeš projíždět kolem parkovacího místa, pořádně se rozhlédni, aby ses ujistil, že máš dostatek místa pro tahač i návěs. V tomto případě jsme zajistili, že dostatek místa máš."

	key[]: "aca_msg_book1_3_22_cutscene3"
	val[]: "Vyrovnej se s kamionem před parkovacím místem. Nejezdi příliš blízko, abys měl dostatek prostoru pro manévrování."

	key[]: "aca_msg_book1_3_22_cutscene4"
	val[]: "Ostře zatoč směrem od parkovacího místa a začni couvat. Návěs by se měl rovnou natočit k parkovacímu místu."

	key[]: "aca_msg_book1_3_22_cutscene5"
	val[]: "Jakmile je návěs správně natočen k parkovacímu místu, můžeš ho následovat."

	key[]: "aca_msg_book1_3_22_cutscene6"
	val[]: "Začni natáčet návěs směrem od krajnice ještě předtím, než kola návěsu na řidičově straně přejedou do parkovacího místa."

	key[]: "aca_msg_book1_3_22_cutscene7"
	val[]: "Srovnej tahač s návěsem a zarovnej se doprostřed parkovacího místa.<br><br>Zaparkuj, vypni motor a zajisti tahač."

#### 3_22 Driving Instructions

	key[]: "aca_msg_book1_3_22_start"
	val[]: "Před sebou můžeš mezi dalšími kamiony vidět parkovací místo. Při parkování nezapomínej kontrolovat zrcátka a udržovat bezpečnou vzdálenost mezi svým tahačem a překážkami kolem sebe.<br><br><font face=/font/big_bold.font>Připrav se k jízdě.</font>"

	key[]: "aca_msg_book1_3_22_check1"
	val[]: "Projeď parkovištěm a najdi své parkovací místo.<br><br><font face=/font/big_bold.font>Jeď dopředu.</font>"

	key[]: "aca_msg_book1_3_22_stopmid"
	val[]: "<color value=@@clr_white@@>Projeď kolem svého vybraného parkovacího místa na vyznačené místo. Odtud můžeš začít couvat.<br><br><font face=/font/big_bold.font>Zastav na vyznačeném místě.</font>"

	key[]: "aca_msg_book1_3_22_backward"
	val[]: "Zatoč tahačem směrem od parkovacího místa, aby ses k němu natočil návěsem. Nezatáčej příliš ostře, abys nenajel na obrubník.<br><br><font face=/font/big_bold.font>Začni couvat.</font>"

	key[]: "aca_msg_book1_3_22_stop"
	val[]: "Vyrovnej návěs s místem. Pokud je to nutné, popojeď dopředu nebo dozadu a proveď nezbytné zásahy do řízení pro upravení své polohy.<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_22_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
 #!}

#@}

#+ Book 1 Scenario 3_21
#@{
#### 3_21 common
	key[]: "aca_scenario_book1_3_21_title"
	val[]: "Couvání po diagonále"

	key[]: "aca_scenario_book1_3_21_desc"
	val[]: "V tomto scénáři se podíváme na couvání z pozice pod úhlem 45 stupňů."

#### 3_21 goal
#!{
	key[]: "aca_goal_book1_3_21_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_21_forward"
	val[]: "@@aca_goal_book1_1_03_forward@@"

	key[]: "aca_goal_book1_3_21_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}
	key[]: "aca_goal_book1_3_21_check1"
	val[]: "Kontrolní bod"

	key[]: "aca_goal_book1_3_21_check2"
	val[]: "Zjištění správné vzdálenost při couvání"

	key[]: "aca_goal_book1_3_21_stop"
	val[]: "Zaparkování na vyznačeném místě"



#### 3_21 msg - intro text

	key[]: "aca_msg_book1_3_21_cutscene1"
	val[]: "V této lekci se podíváme na parkování pod úhlem 45 stupňů. Pokud to situace dovoluje, je to mnohými preferovaný způsob couvání na parkovací místa. Tím, že již začínáš s návěsem nasměrovaným tam, kam chceš jet, není potřeba pro zaparkování tolik manévrovat."

	key[]: "aca_msg_book1_3_21_cutscene2"
	val[]: "Tato počáteční pozice ti také umožní vidět dále do parkovacího místa, což zlepšuje orientaci v prostoru, kam jedeš."

	key[]: "aca_msg_book1_3_21_cutscene3"
	val[]: "Zajeď daleko za parkovací místo a nastav se zhruba pod úhlem 45 stupňů. Návěs by měl směřovat ke kamionu na vzdálenější straně parkovacího místa, na které hodláš zacouvat."

	key[]: "aca_msg_book1_3_21_cutscene4"
	val[]: "Posuň přední část návěsu zatočením tahače tak, aby zadní část návěsu směrovala k parkovacímu místu. Dávej pozor, abys to nepřehnal. Jakmile začneš zatáčet, je snazší zatáčku utáhnout než otevřít."

	key[]: "aca_msg_book1_3_21_cutscene5"
	val[]: "Jakmile návěs vjede na parkovací místo, dostaň tahač před něj a vyrovnej soupravu."

	key[]: "aca_msg_book1_3_21_cutscene6"
	val[]: "Zastav na vyznačeném místě a zajisti tahač."

#### 3_21 Driving Instructions
#!{
	key[]: "aca_msg_book1_3_21_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

	key[]: "aca_msg_book1_3_21_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
	key[]: "aca_msg_book1_3_21_forward"
	val[]: "Po levé straně je parkovací místo. Projeď kolem něj a nastav se pod úhlem 45 stupňů.<br><br><font face=/font/big_bold.font>Jeď dopředu.</font>"

	key[]: "aca_msg_book1_3_21_check1"
	val[]: "Vyrovnej kamion podle značení.<br><br><font face=/font/big_bold.font>Zastav na vyznačeném místě.</font>"

	key[]: "aca_msg_book1_3_21_check2"
	val[]: "S využitím znalostí získaných v předchozích scénářích nasměruj návěs na parkovací místo.<br><br><font face=/font/big_bold.font>Začni couvat.</font>"

	key[]: "aca_msg_book1_3_21_stop"
	val[]: "Pokračuj v zatáčení návěsu na parkovací místo.<br><br>@@aca_msg_book1_2_01_stop@@"


#@}

