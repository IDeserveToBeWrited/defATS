	key[]: "aca_goal_book1_3_15_check1"
	val[]: "Zatáčka s nadjetím"

	key[]: "aca_goal_book1_3_15_check2"
	val[]: "Zatáčka a rovný úsek"

	key[]: "aca_goal_book1_3_15_check3"
	val[]: "Zatáčka s najetím"

	key[]: "aca_goal_book1_3_15_check4"
	val[]: "Rovný úsek a zatáčka"

	key[]: "aca_goal_book1_3_15_check5"
	val[]: "Kombinace odboček"



#### 3_15 msg - intro text

	key[]: "aca_msg_book1_3_15_cutscene01"
	val[]: "Čeká tě několik prudkých zatáček, kde není místa nazbyt.<br>Pomůžou ti naučit se manévrovat s návěsem efektivně."

	key[]: "aca_msg_book1_3_15_cutscene02"
	val[]: "@@aca_msg_book1_3_15_cutscene02_img@@<br>První odbočka vyžaduje manévr s nadjetím. Tento termín se vztahuje na odbočení, při kterém máš omezený prostor na silnici, na kterou odbočuješ, a místo toho musíš využít více prostoru na silnici, po které právě jedeš."

	key[]: "aca_msg_book1_3_15_cutscene03"
	val[]: "Sleduj značení pruhů a nadjeď si s tahačem zeširoka daleko od vnitřního obrubníku.<br>Tím se návěs vzdálí od obrubníku, takže budeš mít dostatek prostoru pro manévrování."

	key[]: "aca_msg_book1_3_15_cutscene04"
	val[]: "Při výjezdu ze zatáčky se drž blízko překážky, aby návěs pokračoval v co nejširším oblouku."

	key[]: "aca_msg_book1_3_15_cutscene05"
	val[]: "Při vjezdu do táhlé zatáčky je nutné držet tahač směrem ke středu vozovky, aby kola návěsu nepřejela obrubník."

	key[]: "aca_msg_book1_3_15_cutscene06"
	val[]: "Pokračuj po silnici."

	key[]: "aca_msg_book1_3_15_cutscene07"
	val[]: "@@aca_msg_book1_3_15_cutscene07_img@@<br>Další odbočka vyžaduje manévr s najetím. Tento způsob je vhodnější, protože neumožňuje nepozornému řidiči podjetí zprava. Najížděj si vždy, pokud máš na silnici, na kterou odbočuješ, dostatek místa."

	key[]: "aca_msg_book1_3_15_cutscene08"
	val[]: "Vjeď hluboko do křižovatky a zatoč ostře doprava."

	key[]: "aca_msg_book1_3_15_cutscene09"
	val[]: "Po průjezdu kolem překážky se můžeš vyrovnat a opět se držet na levé straně jízdního pruhu.<br>Všechno to slouží k tomu, aby kola návěsu nepřejela obrubník."

	key[]: "aca_msg_book1_3_15_cutscene10"
	val[]: "Pokračuj k další zatáčce."

	key[]: "aca_msg_book1_3_15_cutscene11"
	val[]: "Opět se drž ke středu vozovky, aby se kola návěsu nepřibližovala k obrubníku."

	key[]: "aca_msg_book1_3_15_cutscene12"
	val[]: "Obzvláště problematická je odbočka před tebou. V takových případech nemáš vhodné podmínky pro nadjetí ani najetí a musíš zkombinovat oba manévry dohromady, abys ses dostal tam, kam potřebuješ."

	key[]: "aca_msg_book1_3_15_cutscene13"
	val[]: "Před zatáčkou si pořádně nadjeď, vjeď hluboko do křižovatky a ostře zatoč. Opět je ideální zůstat co nejblíže překážce, aby byl průjezd zatáčkou co nejširší."

	key[]: "aca_msg_book1_3_15_cutscene14"
	val[]: "Zaparkuj na vyznačeném místě, zajisti tahač a vypni motor."

	# Book 1 Scenario 3_15 formatting
#!{
	key[]: "aca_msg_book1_3_15_cutscene02_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/jug_handle.mat bottom=p256 right=p256 color=FFFFFFFF></align><offset vshift=256>"

	key[]: "aca_msg_book1_3_15_cutscene07_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/button_hook.mat bottom=p256 right=p256 color=FFFFFFFF></align><offset vshift=256>"

#!}


#### 3_15 Driving Instructions

	key[]: "aca_msg_book1_3_15_forward"
	val[]: "Nazapomeň plně využít dostupné místo v každé zatáčce.<br><br><font face=/font/big_bold.font>Rozjeď se a jeď podle značení na silnici doleva.</font>"

	key[]: "aca_msg_book1_3_15_check1"
	val[]: "Využij veškerý prostor, který máš k dispozici, aby sis nadjel zeširoka a návěs nepřejel obrubník.<br><br><font face=/font/big_bold.font>Projeď zatáčkou s nadjetím.</font>"

	key[]: "aca_msg_book1_3_15_check2"
	val[]: "Za zatáčkou se drž směrem ke středu silnice a pak pokračujte rovně k další zatáčce.<br><br><font face=/font/big_bold.font>Pokračuj v jízdě.</font>"

	key[]: "aca_msg_book1_3_15_check3"
	val[]: "Nalevo je omezený prostor, takže musíš najet dál do křižovatky, aby se návěs nedostal k obrubníku.<br><br><font face=/font/big_bold.font>Projeď zatáčku s najetím.</font>"

	key[]: "aca_msg_book1_3_15_check4"
	val[]: "Pokračuj k další zatáčce a objeď ji.<br><br><font face=/font/big_bold.font>Pokračuj v jízdě.</font>"

	key[]: "aca_msg_book1_3_15_check5"
	val[]: "Tato zatáčka je zatím nejtěsnější a žádný z manévrů sám o sobě nebude stačit.<br><br><font face=/font/big_bold.font>Projeď zatáčkou co nejvíce zeširoka.</font>"

	key[]: "aca_msg_book1_3_15_check6"
	val[]: "<font face=/font/big_bold.font>Pokračuj na parkovací místo před tebou vpravo.</font>"
#!{
	key[]: "aca_msg_book1_3_15_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_15_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_15_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}


#@}

#+ Book 1 Scenario 3_16
#@{

#### 3_16 common
	key[]: "aca_scenario_book1_3_16_title"
	val[]: "Couvání při parkování pod úhlem"

	key[]: "aca_scenario_book1_3_16_desc"
	val[]: "V tomto scénáři prozkoumáme parkování pod úhlem při couvání. S tím se můžeš setkat na odpočívadlech, motorestech a dokonce i u dopravců. Často je málo místa, protože parkoviště jsou zaplněná kamiony, takže parkování je těžší."

#### 3_16 goal

	key[]: "aca_goal_book1_3_16_check1"
	val[]: "Zatočení návěsu"
#!{
	key[]: "aca_goal_book1_3_16_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_16_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_16_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_16_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
 #!}
#### 3_16 msg - intro text

	key[]: "aca_msg_book1_3_16_cutscene1"
	val[]: "Parkování pod úhlem se na první pohled zdá jednoduché, ale často je těžší než couvání při běžném kolmém parkování."

	key[]: "aca_msg_book1_3_16_cutscene2"
	val[]: "Zacouvej k parkovacímu místu. Udržuj tahač rovně s návěsem."

	key[]: "aca_msg_book1_3_16_cutscene3"
	val[]: "Jakmile se začneš přibližovat, nech jet návěs těsněji k zaparkovaným kamionům. To ti pomůže zatočit na parkovací místo, jakmile se k němu dostaneš."

	key[]: "aca_msg_book1_3_16_cutscene4"
	val[]: "Začni natáčet návěs na parkovací místo. Udržuj svůj návěs blízko kamionu po straně řidiče, neboť místo na druhé straně budeš ještě potřebovat."

	key[]: "aca_msg_book1_3_16_cutscene5"
	val[]: "V momentě, kdy je návěs téměř celý na parkovacím místě, začni otáčet tahač a následuj návěs dovnitř."

	key[]: "aca_msg_book1_3_16_cutscene6"
	val[]: "Zaparkuj na vyznačeném místě, zajisti tahač a vypni motor."

#### 3_16 Driving Instructions

	key[]: "aca_msg_book1_3_16_start"
	val[]: "Zaparkuj na místo za sebou. Při couvání využívej obě zrcátka.<br><br><font face=/font/big_bold.font>Připrav se k jízdě.</font>"

	key[]: "aca_msg_book1_3_16_backward"
	val[]: "Zkontroluj své okolí a následně vyraž k parkovacímu místu.<br><br><font face=/font/big_bold.font>Začni couvat.</font>"

	key[]: "aca_msg_book1_3_16_check1"
	val[]: "Začni se návěsem přibližovat ke kamionům vedle sebe. Jakmile budeš připraven, zatoč návěs na parkovací místo. Nezapomeň na vybočení návěsu.<br><br><font face=/font/big_bold.font>Zatoč na parkovací místo.</font>"
#!{
	key[]: "aca_msg_book1_3_16_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_16_end"
	val[]: "@@aca_msg_book1_2_01_end@@"


 #!}


#@}

#+ Book 1 Scenario 3_17
