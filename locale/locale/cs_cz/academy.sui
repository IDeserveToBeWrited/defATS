#+ Book 1 Scenario 1_05
#@{

#### 1_05 common
	key[]: "aca_scenario_book1_1_05_title"
	val[]: "Světla a stěrače"

	key[]: "aca_scenario_book1_1_05_desc"
	val[]: "V tomto scénáři se seznámíš s některými základními ovládacími prvky tahače, abys měl přehled o svém okolí a aby tvá jízda byla předvídatelná pro ostatní účastníky silničního provozu.<br><br>Osvojíš si ovládání stěračů pro udržení dobrého výhledu i za špatného počasí a také ovládání světel."

#### 1_05 goal

	key[]: "aca_goal_book1_1_05_start"
	val[]: "Nastartování motoru"

	key[]: "aca_goal_book1_1_05_parking"
	val[]: "Obrysová světla"

	key[]: "aca_goal_book1_1_05_low_beam"
	val[]: "Potkávací světla"

	key[]: "aca_goal_book1_1_05_high_beam"
	val[]: "Dálková světla"

	key[]: "aca_goal_book1_1_05_lblinkers"
	val[]: "Levé směrové světlo"

	key[]: "aca_goal_book1_1_05_rblinkers"
	val[]: "Pravé směrové světlo"

	key[]: "aca_goal_book1_1_05_hazard"
	val[]: "Výstražná světla"

	key[]: "aca_goal_book1_1_05_wipers"
	val[]: "Stěrače"

	key[]: "aca_goal_book1_1_05_end"
	val[]: "Vypnutí motoru"

#### 1_05 msg - intro text

	key[]: "aca_msg_book1_1_05_cutscene1"
	val[]: "V tomto scénáři si projdeme některé prvky tahače, které zajistí, abys viděl a zároveň byl viděn."

	key[]: "aca_msg_book1_1_05_cutscene2"
	val[]: "Zapneme různé druhy světel a naučíme se, kdy je potřeba je použít."

	key[]: "aca_msg_book1_1_05_cutscene3"
	val[]: "Budeme ovládat levé a pravé směrové světlo."

	key[]: "aca_msg_book1_1_05_cutscene4"
	val[]: "A nakonec si ukážeme, jak nastavit stěrače, aby fungovaly efektivně při různém množství srážek."



#### 1_05 Driving Instructions

	key[]: "aca_msg_book1_1_05_start"
	val[]: "Pojďme si projít různé druhy světel a jak ovládat stěrače.<br><br>Potkávací a dálková světla zajištují dobrý výhled na cestu před tebou. Směrová a výstražná světla se používají k tomu, aby ostatní účastníci provozu mohli předvídat tvé manévry.<br><br>Stěrače slouží k ochraně čelního skla před vodou a jinými nečistotami.<font face=/font/big_bold.font><br><br>Nastartuj motor, ale neuvolňuj parkovací brzdu.</font>"

	key[]: "aca_msg_book1_1_05_parking"
	val[]: "Doposud jsi používal jen denní svícení, které se automaticky aktivuje po zapnutí napájení a slouží k viditelnosti vozidla za dobrých světelných podmínek. Nyní však panují horší, takže bude potřeba použít kompletní systém osvětlení.<font face=/font/big_bold.font><br><br>Stisknutím @@imv_nrm_light@@ zapni parkovací světla.</font>"

	key[]: "aca_msg_book1_1_05_low_beam"
	val[]: "@@aca_msg_book1_1_05_low_beam_img@@<br>Parkovací světla rozsvěcují přední, boční a zadní obrysová světla. Používají se při stání za horších světelných podmínek, aby tě viděli ostatní řidiči.<font face=/font/big_bold.font><br><br>Stiskni @@imv_nrm_light@@ pro přepnutí na potkávací světla.</font>"

	key[]: "aca_msg_book1_1_05_high_beam_on"
	val[]: "@@aca_msg_book1_1_05_high_beam_on_img@@<br>Potkávací světla ti umožňují vidět před vozidlo a zlepšují jeho viditelnost v horších světelných podmínkách.<font face=/font/big_bold.font><br><br>Použij @@imv_nrm_hblight@@ pro přepnutí na dálková světla.</font>"

	key[]: "aca_msg_book1_1_05_high_beam_off"
	val[]: "@@aca_msg_book1_1_05_high_beam_off_img@@<br>Dálková světla ti umožňují vidět na delší vzdálenost ve špatných světelných podmínkách.<br><br>Zároveň ovšem oslňují ostatní účastníky silničního provozu, zvláště pak ty v protijedoucích vozidlech, takže při setkání s nimi v dostatečném předstihu světla vypínej.<font face=/font/big_bold.font><br><br>Stiskni @@imv_nrm_hblight@@ pro vypnutí dálkových světel.</font>"

	key[]: "aca_msg_book1_1_05_lblinker_on"
	val[]: "Nyní se podíváme na směrová světla. Funkcí směrových světel je dát vizuální signál ostatním účastníkům silničního provozu o změně jízdního pruhu nebo změně směru jízdy.<font face=/font/big_bold.font><br><br>Stiskni @@imv_nrm_lblinker@@ pro zapnutí levého směrového světla.</font>"

	key[]: "aca_msg_book1_1_05_lblinker_off"
	val[]: "@@aca_msg_book1_1_05_lblinker_off_img@@<br>Můžeš si všimnout, že na přístrojové desce bliká kontrolka levého směrového světla. Zároveň směrová světla blikají na levé straně tahače.<font face=/font/big_bold.font><br><br>Nyní stiskni @@imv_nrm_lblinker@@ pro vypnutí levého směrového světla.</font>"

	key[]: "aca_msg_book1_1_05_rblinker_on"
	val[]: "Signály o změně směru jízdy je potřeba dávat včas, aby ostatní účastnici silničního provozu stihli přizpůsobit svou jízdu tvému manévru.<font face=/font/big_bold.font><br><br>Stiskni @@imv_nrm_rblinker@@ pro zapnutí pravého směrového světla.</font>"

	key[]: "aca_msg_book1_1_05_rblinker_off"
	val[]: "@@aca_msg_book1_1_05_rblinker_off_img@@<br>Na přístrojové desce nyní bliká kontrolka pravého směrového světla. Zároveň směrová světla blikají na pravé straně tahače.<font face=/font/big_bold.font><br><br>Nyní stiskni @@imv_nrm_rblinker@@ pro vypnutí pravého směrového světla.</font>"

	key[]: "aca_msg_book1_1_05_hazard_on"
	val[]: "@@aca_msg_book1_1_05_hazard_on_img@@<br>Tlačítko výstražných světel je označeno červeným logem ve tvaru trojúhelníku. Tato světla jsou důležitou součástí bezpečnosti silničního provozu a měla by se používat pouze v nezbytných případech. Tímto tlačítkem se aktivují levá i pravá směrová světla najednou.<font face=/font/big_bold.font><br><br>Stiskni @@imv_nrm_flasher4way@@ pro zapnutí výstražných světel.</font>"

	key[]: "aca_msg_book1_1_05_hazard_off"
	val[]: "@@aca_msg_book1_1_05_hazard_off_img@@<br>Obě kontrolky směrových světel nyní blikají, což značí, že jsou zapnutá výstražná světla. Zároveň směrová světla blikají na obou stranách tahače.<br><br>Výstražná světla se obvykle používají, pokud vozidlo zastaví na místě, kde by standardně nestálo, například na okraji silnice kvůli technické nebo mechanické závadě. Mohou být také použita k varování řidičů jedoucích za tebou, pokud se zastaví provoz před tebou.<font face=/font/big_bold.font><br><br>Nyní stiskni @@imv_nrm_flasher4way@@ pro vypnutí výstražných světel.</font>"

	key[]: "aca_msg_book1_1_05_wipers_on"
	val[]: "Nyní se dostáváme ke stěračům. Stěrače slouží k odstraňování kapek deště a dalších nečistot z čelního skla vozidla. Jejich hlavní funkcí je zajistit čistotu a průhlednost skla. Stěrače mají několik rychlostí.<br><br><font face=/font/big_bold.font>Stiskni @@imv_nrm_wipers@@ pro nastavení přerušovaného stírání.</font>@@aca_goal_tip@@ V kariéře můžeš použít dešťový senzor pro automatickou funkci stěračů za deště. @@rain_sensor@@ najdeš na obrazovce nastavení - \"Hra\"."

	key[]: "aca_msg_book1_1_05_wipers2"
	val[]: "Toto nastavení umožňuje periodické stírání stěračů, což se hodí, když jsou velmi slabé srážky.<br><br>Jak můžeš vidět, déšť je příliš hustý a stěrače nestíhají stírat veškeré kapky dopadající na čelní sklo.<font face=/font/big_bold.font><br><br>Stiskni znovu @@imv_nrm_wipers@@ pro nastavení nízké rychlosti stírání.</font>"

	key[]: "aca_msg_book1_1_05_wipers3"
	val[]: "Nyní stěrače stírají déšť stálou rychlostí.<font face=/font/big_bold.font><br><br>Stiskni @@imv_nrm_wipers@@ ještě jednou pro nastavení vyšší rychlosti.</font>"

	key[]: "aca_msg_book1_1_05_wipers_off"
	val[]: "Jak můžeš vidět, stěrače nyní stírají mnohem rychleji pro maximální viditelnost.<font face=/font/big_bold.font><br><br>Stiskni @@imv_nrm_wipers@@ pro vypnutí stěračů.</font>@@aca_goal_tip@@ Můžeš použít také funkci @@o_im_wipers_back@@ pro procházení pozic rychlostí stěračů v opačném pořadí. Zkontroluj obrazovku Nastavení - „@@options_bindings_screen@@“ pro zobrazení nebo změnu příslušných ovládacích prvků."

	key[]: "aca_msg_book1_1_05_wipers_off_back"
	val[]: "Jak můžeš vidět, stěrače nyní stírají mnohem rychleji pro maximální viditelnost.<font face=/font/big_bold.font><br><br>Stiskni @@imv_nrm_wipersback@@ několikrát, dokud se stěrače nevypnou.</font>"

	key[]: "aca_msg_book1_1_05_end"
	val[]: "<font face=/font/big_bold.font>Vypni světla a motor.</font>"
#@}

#+ Book 1 Scenario 2_01
#@{

#### 2_01 common
	key[]: "aca_scenario_book1_2_01_title"
	val[]: "Slalom mezi kužely"

	key[]: "aca_scenario_book1_2_01_desc"
	val[]: "V tomto scénáři se naučíš manévrovat s tahačem kolem dopravních kuželů pomocí zrcátek."

#### 2_01 goal

	key[]: "aca_goal_book1_2_01_summary"
	val[]: "Dodržování pokynů"

	key[]: "aca_goal_book1_2_01_mirror"
	val[]: "Kontrola zrcátek"

	key[]: "aca_goal_book1_2_01_start"
	val[]: "Příprava"

	key[]: "aca_goal_book1_2_01_steering"
	val[]: "Zatočení s tahačem"
#!{
	key[]: "aca_goal_book1_2_01_forward"
	val[]: "@@aca_goal_book1_1_03_forward@@"

	key[]: "aca_goal_book1_2_01_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

#!}
	key[]: "aca_goal_book1_2_01_check1"
	val[]: "Příjezd ke slalomu"

	key[]: "aca_goal_book1_2_01_check2"
	val[]: "Vyhýbání se kuželům"

	key[]: "aca_goal_book1_2_01_check_all"
	val[]: "Kličkování mezi kužely"


	key[]: "aca_goal_book1_2_01_end"
	val[]: "Zajištění vozidla"

#### 2_01 msg - intro text

	key[]: "aca_msg_book1_2_01_cutscene1"
	val[]: "V tomto scénáři si s tahačem projedeme krátký slalom z dopravních kuželů."

	key[]: "aca_msg_book1_2_01_cutscene2"
	val[]: "Jeď opatrně a dávej pozor na své okolí. Hlídej si obě strany tahače a nezapomeň používat zrcátka, která ti pomohou tratí projet."

	key[]: "aca_msg_book1_2_01_cutscene3"
	val[]: "Vzdálenost mezi kužely se na konci zkracuje, takže přesnost je klíčová."

	key[]: "aca_msg_book1_2_01_cutscene4"
	val[]: "Zaparkuj na vyznačeném místě a zajisti tahač."

#### 2_01 Driving Instructions

	key[]: "aca_msg_book1_2_01_summary"
	val[]: "Pro splnění scénáře musíš objet všechny kužely, aniž bys do některého z nich narazil.<br><br><font face=/font/big_bold.font>Stiskni @@imv_nrm_activate@@ pro potvrzení.</font>"

	key[]: "aca_msg_book1_2_01_mirror"
	val[]: "Používej zrcátka, abys viděl po obou stranách tahače.<br><br>Na straně spolujezdce může být pro přehlednost užitečné přední a postranní zrcátko.<br><br><font face=/font/big_bold.font>Stiskni @@imv_nrm_activate@@ pro potvrzení.</font>"

	key[]: "aca_msg_book1_2_01_start"
	val[]: "V případě potřeby si uprav zrcátka přes \"@@adjust_link_t@@\" (dostaneš se k ní v menu pauzy).<br><br><font face=/font/big_bold.font>Připrav se k jízdě.</font>"

	key[]: "aca_msg_book1_2_01_start_fail"
	val[]: "Tahač stále není připraven k jízdě, nezapomněl jsi na něco?<br><br>Nastartoval jsi motor? Uvolnil jsi parkovací brzdu?"

	key[]: "aca_msg_book1_2_01_forward"
	val[]: "<font face=/font/big_bold.font>Pomalu se rozjeď a projeď slalomem.</font>"

	key[]: "aca_msg_book1_2_01_check2"
	val[]: "<font face=/font/big_bold.font>Pokračuj kolem kuželů. Obzvlášť pozor si dávej na stranu spolujezdce.</font>"

	key[]: "aca_msg_book1_2_01_check_all"
	val[]: "<font face=/font/big_bold.font>Prokličkuj slalomem, aniž bys narazil do jakéhokoliv kuželu.</font>"

	key[]: "aca_msg_book1_2_01_stop"
	val[]: "<font face=/font/big_bold.font>Zastav na vyznačeném místě.</font>"

	key[]: "aca_msg_book1_2_01_end"
	val[]: "<font face=/font/big_bold.font>Zajisti tahač a vypni motor.</font>"
#@}

# Book 1 Scenario 2_02 formatting
