	val[]: "Zatáčka s nadjetím"

	key[]: "aca_goal_book1_3_03_check5"
	val[]: "Zatáčka s najetím"

	key[]: "aca_goal_book1_3_03_check6"
	val[]: "Prudká zatáčka"


#### generic phrase

	key[]: "aca_goal_book1_3_03_chk_point"
	val[]: "Jízda kolem bariér"

#### 3_03 msg - intro text

	key[]: "aca_msg_book1_3_03_cutscene01"
	val[]: "Před námi je řada složitých zatáček a překážek.<br>Uvědom si vše, co ses doposud naučil, a neměl bys mít problém."

	key[]: "aca_msg_book1_3_03_cutscene02"
	val[]: "První odbočení je snadná zatáčka s najetím. Najeď si zeširoka a neměl bys mít problém."

	key[]: "aca_msg_book1_3_03_cutscene03"
	val[]: "Pokračuj ke kruhovému objezdu."

	key[]: "aca_msg_book1_3_03_cutscene04"
	val[]: "Udržuj návěs mimo vnitřní stranu kruhového objezdu tak, že s tahačem pojedeš co nejširším obloukem."

	key[]: "aca_msg_book1_3_03_cutscene05"
	val[]: "Pravoúhlá zatáčka doleva není nijak zvlášť úzká, ale dej pozor, abys nesrazil žádný kužel."

	key[]: "aca_msg_book1_3_03_cutscene06"
	val[]: "Tato zatáčka je výrazně užší. K jejímu projetí využij manévr s nadjetím."

	key[]: "aca_msg_book1_3_03_cutscene07"
	val[]: "V této zatáčce můžeš použít manévr s najetím, ale pozor na další překážky, kterým se musíš vyhnout."

	key[]: "aca_msg_book1_3_03_cutscene09"
	val[]: "Závěrečné odbočení je opět velmi těsné a k jejímu dokončení je zapotřebí kombinace manévrů s nadjetím a najetím."

	key[]: "aca_msg_book1_3_03_cutscene10"
	val[]: "Zaparkuj na vyznačeném místě, zajisti tahač a vypni motor."


#### 3_03 Driving Instructions



	key[]: "aca_msg_book1_3_03_forward"
	val[]: "<font face=/font/big_bold.font>Pokračuj k prvnímu odbočení.</font>"

	key[]: "aca_msg_book1_3_03_check1"
	val[]: "První odbočení je snadná zatáčka s najetím.<br><br><font face=/font/big_bold.font><color value=@@clr_txt@@>Projeď zatáčkou.</font>"

	key[]: "aca_msg_book1_3_03_check2"
	val[]: "Pokračuj na kruhový objezd. Nezapomeň ho projet širokým obloukem.<br><br><font face=/font/big_bold.font>Jeď ke kruhovému objezdu a projeď přes něj.</font>"

	key[]: "aca_msg_book1_3_03_check3"
	val[]: "Tato pravoúhlá zatáčka je trochu úžší, takže dávej pozor, abys nesrazil žádný kužel.<br><br><font face=/font/big_bold.font>Projeď zatáčkou.</font>"

	key[]: "aca_msg_book1_3_03_check4"
	val[]: "K tomuto odbočení je nejlepší přistupovat pomocí manévru s nadjetím. Před vjezdem do křižovatky si pořádně nadjeď.<br><br><font face=/font/big_bold.font>Projeď zatáčkou s nadjetím.</font>"

	key[]: "aca_msg_book1_3_03_check5"
	val[]: "Toto odbočení je lemováno několika různými překážkami, ale lze jej zvládnout pomocí manévru s najetím.<br><br><font face=/font/big_bold.font>Pokračuj opatrně.</font>"

	key[]: "aca_msg_book1_3_03_check6"
	val[]: "Toto odbočení ja zatím nejužší. Projeď jej, jak uznáš za vhodné.<br><br><font face=/font/big_bold.font>Odboč na parkoviště.</font>"
