#+ Book 1 Scenario 1_01
#@{

#### 1_01 common
	key[]: "aca_scenario_book1_1_01_title"
	val[]: "Příprava před jízdou"

	key[]: "aca_scenario_book1_1_01_desc"
	val[]: "Ve tvém prvním scénáři si projdeme základy v kabině řidiče. Je potřeba nastavit sedadlo, volant a zpětná zrcátka, protože správný výhled je kritický pro zvládnutí stresových a náročných situací.<br><br>Ovládací prvky pro přizpůsobení těchto částí si postupně projdeme."

#### 1_01 goal

	key[]: "aca_goal_book1_1_01_adjuster"
	val[]: "Nastavení sedadla a zrcátek"

	key[]: "aca_goal_book1_1_01_check_adj"
	val[]: "Kontrola zrcátek a výhledu"

#### 1_01 msg - intro text

	key[]: "aca_msg_book1_1_01_cutscene1"
	val[]: "Vítej na své první lekci!<br>Nejdříve se naučíme, jak připravit tahač na cestu."

	key[]: "aca_msg_book1_1_01_cutscene2"
	val[]: "Je potřeba zajistit, aby jízda byla bezpečná, profesionální a plně pod tvou kontrolou.<br>K tomu slouží nastavení sedadla, volantu a zrcátek."

	key[]: "aca_msg_book1_1_01_cutscene3"
	val[]: "Po obou stranách tvého tahače je několik vozidel.<br>Pomůžou ti správně si přizpůsobit zpětná zrcátka."

	key[]: "aca_msg_book1_1_01_cutscene4"
	val[]: "Nastav si vše poctivě, protože to bude mít výrazný vliv na tvou schopnost ovládání tahače."

#### 1_01 Driving Instructions

	key[]: "adj_tut_title_0"
	val[]: "Nastavení sedadla a volantu"

	key[]: "adj_tut_title_1"
	val[]: "Nastavení hlavních zrcátek"

	key[]: "adj_tut_title_2"
	val[]: "Nastavení vypouklých zrcátek"

	key[]: "adj_tut_title_3_hood"
	val[]: "Nastavení zrcátek na kapotě"

	key[]: "adj_tut_title_3"
	val[]: "Kontrola výhledu a finální nastavení zrcátek"

	key[]: "adj_tut_open_adj_keyboard"
	val[]: "stiskni @@imv_nrm_adjuster@@ nebo otevři úpravu vozidla v menu pauzy"

	key[]: "adj_tut_open_adj_gamepad"
	val[]: "otevři úpravu vozidla v menu pauzy"

	key[]: "adj_tut_open_adj"
	val[]: "Pro zobrazení \"@@adjust_link_t@@\" během hry, $OPEN_ADJUSTER$."

	key[]: "adj_tut_open_seat"
	val[]: "Nejdříve si nastavíme sedadlo řidiče a volant.<br><br><font face=/font/big_bold.font>Otevři \"@@adj_seats@@\" pro pokračování.</font>"

	key[]: "adj_tut_open_mirrors"
	val[]: "<font face=/font/big_bold.font>Otevři @@adj_mirrors@@ pro nastavení zrcátek.</font>"

	key[]: "adj_tut_open_adj_intro"
	val[]: "Když poprvé nasedneš do tahače, je důležité si nejdříve nastavit sedadlo, volant a zrcátka podle svých představ.<br><br>Správná poloha za volantem je pro výhled zásadní. Všechny ovládací prvky musí být na dosah a řidič musí mít jasný výhled dopředu, do stran a do zrcátek.<br><br><font face=/font/big_bold.font>Pro zobrazení konfiguračního menu $OPEN_ADJUSTER$.</font>"

	key[]: "adj_tut_set_seat_and_back_adj"
	val[]: "@@adj_tut_set_seat_and_back_adj_img@@<br>Nastav si sedadlo tak, abys měl jasný výhled okolo sebe i na zrcátka a abys dosáhl na všechny ovládací prvky.<br><br>Nastav si volant tak, aby byl v pohodlné poloze a nebránil ve výhledu na přístrojovou desku.<br><br><font face=/font/big_bold.font>Jakmile budeš se svými úpravami spokojen, stiskni @@imv_nrm_back@@ pro návrat do konfiguračního menu.</font>"

	key[]: "adj_tut_open_mirrors_intro"
	val[]: "@@adj_tut_open_mirrors_intro_img@@<br>Tahače mají mnoho slepých úhlů, proto jsou vybaveny několika vnějšími zrcátky, aby řidič viděl co nejvíce.<br><br>Správné nastavení těchto zrcátek ti umožní co nejlepší výhled kolem sebe.<br><br><font face=/font/big_bold.font>Otevři \"@@adj_mirrors@@\" pro pokračování.</font>"

	key[]: "adj_tut_set_mirrors_t1_1_adj"
	val[]: "@@adj_tut_set_mirrors_t1_1_adj_img@@<br>Plochá zrcátka vykrývají prostor podél kamionu.<br><br>Pro nastavení správné pozice hlavních zrcátek se orientuj podle aut po obou stranách tvého vozidla.<br><br><font face=/font/big_bold.font>Stiskni @@imv_nrm_selectfcs@@ pro pokračování.</font>"

	key[]: "adj_tut_set_mirrors_t1_2_adj"
	val[]: "Hlavní zrcátka jsou primárním nástrojem pro sledování toho, co se děje vedle tebe a za tebou. Měl bys mít dobrý výhled na auto vedle tebe, ale nezapomeň mít v zrcátku i část návěsu, což ti pomůže lépe odhadnout polohu překážek okolo."

	key[]: "adj_tut_set_mirrors_t1_2_adj_big"
	val[]: "Jakmile budeš se svými úpravami spokojen, přepni na nastavení hlavního zrcátka na straně spolujezdce."

	key[]: "adj_tut_set_mirrors_t1_2_adj_moved"
	val[]: "Opět bys měl v zrcátku dobře vidět auto vedle tebe a zároveň část svého návěsu."

	key[]: "adj_tut_set_mirrors_t1_2_adj_moved_big"
	val[]: "Jakmile budeš se svými úpravami spokojen, přepni na nastavení vypouklého zrcátka na straně řidiče."

	key[]: "adj_tut_set_mirrors_t1_3_adj"
	val[]: "@@adj_tut_set_mirrors_t1_3_adj_img@@<br>Vypouklá zrcátka rozšiřují zorné pole, díky čemuž máš větší přehled o dění kolem sebe.<br><br><font face=/font/big_bold.font>Stiskni @@imv_nrm_selectfcs@@ pro pokračování.</font>"

	key[]: "adj_tut_set_mirrors_t1_4_adj"
	val[]: "V ideálním případě bys měl vidět auto i kamion zaparkovaný vedle sebe a zároveň stále vidět velmi malou část svého tahače."

	key[]: "adj_tut_set_mirrors_t1_4_adj_big"
	val[]: "Jakmile budeš se svou úpravou zrcátka spokojen, přepni na nastavení vypouklého zrcátka na straně spolujezdce."

	key[]: "adj_tut_set_mirrors_t1_4_adj_moved"
	val[]: "V ideálním případě bys měl vidět auto i kamion zaparkované vedle tebe a zároveň stále vidět velmi malou část svého tahače."

	key[]: "adj_tut_set_mirrors_t1_4_adj_moved_big"
	val[]: "Jakmile budeš se svou úpravou zrcátka spokojen, přepni na zrcátko na kapotě."

	key[]: "adj_tut_set_mirrors_t1_5_adj"
	val[]: "@@adj_tut_set_mirrors_t1_5_adj_img@@<br>Zrcátka na kapotě poskytují výhled do mrtvých úhlů na obou stranách kabiny tahače a umožňují vidět malá vozidla a překážky, které by jinak mohly vzhledem k velkým rozměrům tahače zůstat skryté.<br><br><font face=/font/big_bold.font>Stiskni @@imv_nrm_selectfcs@@ pro pokračování.</font>"

	key[]: "adj_tut_set_mirrors_t1_6_adj"
	val[]: "@@adj_tut_set_mirrors_t1_6_adj_img@@<br>Vzhledem k tomu, že výhled za sebe zajišťují jiná zrcátka, jsou tato zrcátka určena pouze k výhledu vedle tebe. Kapota a ramena bočních zrcátek poskytují dobrou referenci pro určení, jak velká část tvého tahače by měla být ještě viditelná. Nastav zrcátka do správné polohy podle obrázku.<br><br><font face=/font/big_bold.font>Jakmile budeš se svými úpravami spokojen, přepni na nastavení zrcátka na straně spolujezdce.</font>"

	key[]: "adj_tut_set_mirrors_t1_6_adj_moved"
	val[]: "@@adj_tut_set_mirrors_t1_6_adj_moved_img@@<br>Stejným způsobem si nastav pozici tohoto zrcátka.<br><br><font face=/font/big_bold.font>Jakmile budeš se svou úpravou zrcátka spokojen, stiskni @@imv_nrm_back@@ pro zavření nastavení zrcátek.</font>"

	key[]: "adj_tut_back_adj"
	val[]: "<font face=/font/big_bold.font>Stiskni @@imv_nrm_back@@ pro návrat do konfiguračního menu.</font>"

	key[]: "adj_tut_close_adj"
	val[]: "Výborně, se sedadlem a zrcátky nastavenými podle svých představ jsi o krok blíž k vyjetí na silnici!<br><br><font face=/font/big_bold.font>Zavři konfigurační menu pomocí @@imv_nrm_back@@.</font>"

	key[]: "adj_tut_open_con"
	val[]: "Rozhlédni se ještě jednou kolem sebe a zkontroluj, zda máš dobrý výhled z kabiny a zda ti zrcátka poskytují dostatečný přehled o dění kolem kamionu.<br><br>Pokud ti něco nevyhovuje, můžeš zrcátka přenastavit přes „@@adjust_link_t@@“ v konfiguračním menu.<br><br><font face=/font/big_bold.font>Stiskni @@imv_nrm_activate@@ pro ukončení prvního scénáře.</font> @@aca_goal_tip@@ Pro zobrazení nebo skrytí zrcátek na obrazovce přejdi do „@@adjust_link_t@@“ — „@@adj_ui_mirrors@@“ v menu pauzy. Zrcátka na obrazovce usnadňují výhled na stranu spolujezdce."
#@}

# Book 1 Scenario 1_02 - strings not needing translation
