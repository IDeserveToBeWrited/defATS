#+ Book 3 Scenario urf
#@{

#### urf common
	key[]: "aca_scenario_book3_urf_title"
	val[]: "Volné couvání"

	key[]: "aca_scenario_book3_urf_desc"
	val[]: "V tomto scénáři budeš na prázdném parkovišti cvičit couvání s B-double návěsy."

#### urf goal

	key[]: "aca_goal_book3_urf_start"
	val[]: "Příprava"

	key[]: "aca_goal_book3_urf_move"
	val[]: "Experimentování"

	key[]: "aca_goal_book3_urf_stop"
	val[]: "Závěrečné kroky"

	key[]: "aca_goal_book3_urf_end"
	val[]: "Ukončení scénáře"

	#### urf msg - intro text

	key[]: "aca_msg_book3_urf_cutscene1"
	val[]: "Couvání s B-double návěsy vyžaduje mnohem více pozornosti než s jedním. Musíš předem naplánovat, kam chceš zadní návěs nasměrovat, a zároveň udržet kontrolu nad předním návěsem s tahačem.<br><br>Můžeš o tom přemýšlet nějak takto - je potřeba použít přední návěs pro řízení zadního návěsu. Takže ať už namíříš přední návěs kamkoliv, změní se i trajektorie zadního návěsu."

	key[]: "aca_msg_book3_urf_cutscene2"
	val[]: "V tomto případě chceme zatočit zadním návěsem na stranu řidiče.<br><br>Abychom to zvládli, stočili jsme přední návěs na stranu spolujezdce."

	key[]: "aca_msg_book3_urf_cutscene3"
	val[]: "Právě v tomto okamžiku většina lidí obvykle udělá první chybu. Jakmile se zadní návěs začne otáčet, je potřeba vyrovnat tahač s předním návěsem..."

	key[]: "aca_msg_book3_urf_cutscene4"
	val[]: "...jinak skončíš takto zalomený."

	key[]: "aca_msg_book3_urf_cutscene5"
	val[]: "K zalomení dochází, když úhel mezi dvěma vozidly v kombinaci dosáhne přibližně 90 stupňů. Jakmile k tomu dojde, není možné situaci zachránit - jedinou možností je popojet dopředu a zkusit to znovu.<br><br>Stejně jako při couvání s jedním návěsem je cílem vždy zajistit, aby se všechna kola návěsů pohybovala. Jakmile se jedno kolo zastaví a návěs se otáčí na místě, nemůžeš pokračovat."

	key[]: "aca_msg_book3_urf_cutscene6"
	val[]: "Můžeš se vrátit na místo, kde jsi naposledy postupoval správně, respektive na místo, kde můžeš pokračovat v couvání, aniž by ses znovu dostal do stejné situace, nebo se prostě vyrovnej popojetím dopředu."

	key[]: "aca_msg_book3_urf_cutscene7"
	val[]: "Jakmile se zadní návěs začne otáčet, opět dostaň tahač dopředu a nech zadní návěs chvíli otáčet se sám."

	key[]: "aca_msg_book3_urf_cutscene8"
	val[]: "Nyní, když se zadní návěs hezky otáčí, je čas nasměrovat přední návěs tak, aby ho následoval. Můžeš upravovat úhel mezi předním a zadním návěsem při průjezdu zatáčkou a projel ji tak ostřeji nebo více ze široka."

	key[]: "aca_msg_book3_urf_cutscene9"
	val[]: "Poslední částí manévru je vše vyrovnat. Dostaň přední část před zadní návěs."

	key[]: "aca_msg_book3_urf_cutscene10"
	val[]: "Měj na paměti, kolik času zabere přesun předního návěsu a že budeš muset vyrovnat i tahač."

	key[]: "aca_msg_book3_urf_cutscene11"
	val[]: "Zde můžeš strávit tolik času, kolik jen chceš, a vyzkoušet si různé manévry, dokud nezískáš hrubou představu o tom, jak manipulovat s návěsy při couvání."

#### urf Driving Instructions

	key[]: "aca_msg_book3_urf_start"
	val[]: "Připrav se k jízdě."

	key[]: "aca_msg_book3_urf_move"
	val[]: "Využij tohoto parkoviště k vyzkoušení couvání s návěsem.<br><br>@@aca_goal_tip@@ Jsi v couvání s návěsem úplným začátečníkem? Zkus si nejdříve zahrát část Základy řízení kamionu."

	key[]: "aca_msg_book3_urf_stop"
	val[]: "Zkoušej si to jak dlouho jen budeš chtít.<br><br>Jakmile budeš spokojen, zastav a zajisti tahač, čímž scénář ukončíš."

	key[]: "aca_msg_book3_urf_end"
	val[]: "Pro ukončení scénáře vypni motor."
#@}


#+ Book 3 Scenario sup
#@{

#### sup common
	key[]: "aca_scenario_book3_sup_title"
	val[]: "Parkování v úzkém prostoru"

	key[]: "aca_scenario_book3_sup_desc"
	val[]: "V tomto scénáři máš za úkol zaparkovat s B-double návěsem na úzkém místě."

#### sup goal

	key[]: "aca_goal_book3_sup_start"
	val[]: "Příprava"

	key[]: "aca_goal_book3_sup_forward"
	val[]: "Rozjezd"

	key[]: "aca_goal_book3_sup_check1"
	val[]: "Pokračování jízdy"

	key[]: "aca_goal_book3_sup_stop"
	val[]: "Zastavení"

	key[]: "aca_goal_book3_sup_end"
	val[]: "Zajištění vozidla"

#### sup msg - intro text

	key[]: "aca_msg_book3_sup_cutscene1"
	val[]: "Jízda s B-double návěsem může vypadat náročně, ale není zas o moc složitější než jízda s jedním návěsem - stačí jen brát v úvahu dráhu zadního návěsu!"

	key[]: "aca_msg_book3_sup_cutscene2"
	val[]: "Před tebou je úzké parkovací místo. Před vjezdem nebudeš mít dostatek prostoru pro vyrovnání, takže budeš muset pečlivě zvážit, jak se tam s oběma návěsy dostaneš."

	key[]: "aca_msg_book3_sup_cutscene3"
	val[]: "Okamžitě zatoč směrem k protější straně parkovacího místa a projeď daleko za místo, kde bys běžně zatáčel."

	key[]: "aca_msg_book3_sup_cutscene4"
	val[]: "Nyní, když je tvůj zadní návěs ve správné pozici, můžeš zamířit k místu určení; možná bude potřeba jet směrem k protější straně, abys pomohl otočit první návěs."

	key[]: "aca_msg_book3_sup_cutscene5"
	val[]: "Pokračuj na místo, oba návěsy tě budou následovat a vyrovnají se během jízdy."

	key[]: "aca_msg_book3_sup_cutscene6"
	val[]: "Zaparkuj na vyznačeném místě a zajisti tahač."

#### sup Driving Instructions

	key[]: "aca_msg_book3_sup_start"
	val[]: "Připrav se k jízdě."

	key[]: "aca_msg_book3_sup_forward"
	val[]: "Rozjeď se a vjeď do úzkého prostoru."

	key[]: "aca_msg_book3_sup_check1"
	val[]: "Pokračuj v jízdě."

	key[]: "aca_msg_book3_sup_stop"
	val[]: "Zastav na vyznačeném místě."

	key[]: "aca_msg_book3_sup_end"
	val[]: "Zajisti tahač a vypni motor."
#@}


