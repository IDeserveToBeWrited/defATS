 #!}
#### 3_17 msg - intro text

	key[]: "aca_msg_book1_3_17_cutscene01"
	val[]: "V tomto scénáři budeš couvat na parkovací místo, které je na straně řidiče za tebou."

	key[]: "aca_msg_book1_3_17_cutscene02"
	val[]: "Je třeba pamatovat na několik tipů, které ti při couvání s návěsem přijdou vhod.<br>První je, že návěs vždy zatáčí na opačnou stranu než tahač."

	key[]: "aca_msg_book1_3_17_cutscene03"
	val[]: "Druhý tip je, že kam směřuje návěs, poznáš lépe, když budeš sledovat nápravy tahače a návěsu."

	key[]: "aca_msg_book1_3_17_cutscene04"
	val[]: "Třetí tip je, že i malé korekce tě dostanou, kam potřebuješ, není třeba to přehánět."

	key[]: "aca_msg_book1_3_17_cutscene05"
	val[]: "Začni lehce stáčet tahač směrem od parkovacího místa a návěs se tak natočí směrem k němu."

	key[]: "aca_msg_book1_3_17_cutscene06"
	val[]: "Následuj návěs a průběžně vyrovnávej, abys udržel správný směr."

	key[]: "aca_msg_book1_3_17_cutscene07"
	val[]: "Sleduj kola návěsu a zadní kola tahače. Pomohou ti určit, jak je tvůj návěs natočen a kam ho tahač tlačí."

	key[]: "aca_msg_book1_3_17_cutscene08"
	val[]: "Čtvrtý tip je, že je vždy jednodušší si s návěsem více najet a zatočit ostře, než se ho pokoušet vyrovnávat z přetočení. Zaměř se na vnější část parkovacího místa, dokud k němu nejsi blíže, a pak zatoč trochu víc, abys vyrovnal návěs."

	key[]: "aca_msg_book1_3_17_cutscene09"
	val[]: "Jakmile návěs vjede do parkovacího místa, vyrovnej tahač před návěsem. Pokus se vyhnout přílišnému korigování uvnitř parkovacího místa."

	key[]: "aca_msg_book1_3_17_cutscene10"
	val[]: "Zacouvej mezi bariéry, hlídej si přitom obě strany."

	key[]: "aca_msg_book1_3_17_cutscene11"
	val[]: "Zajisti tahač a vypni motor."

#### 3_17 Driving Instructions

	key[]: "aca_msg_book1_3_17_start"
	val[]: "Pamatuj si následující tipy při couvání do zatáčky s návěsem:<br><br>— Návěs zatáčí na druhou stranu než tahač<br><br>— Hlídej si kola návěsu, abys viděl, kam míří<br><br>Hlídej si zadní kola tahače, abys viděl, kam tlačí návěs<br><br>— Nech jet návěs přirozeně, nepřetáčej ho<br><br>Vždy je jednodušší si s návěsem více najet a zatočit, než se ho snažit vyrovnat<br><br><font face=/font/big_bold.font>Připrav se k jízdě.</font>"

	key[]: "aca_msg_book1_3_17_backward"
	val[]: "Podívej se za sebe, kam potřebuješ jet. Před couváním vždy zkontroluj své okolí.<br><br><font face=/font/big_bold.font>Začni couvat k parkovacímu místu.</font>"

	key[]: "aca_msg_book1_3_17_check1"
	val[]: "<font face=/font/big_bold.font>Začni stáčet návěs k parkovacímu místu a následuj ho.</font>"

	key[]: "aca_msg_book1_3_17_stop"
	val[]: "<font face=/font/big_bold.font>Zastav na vyznačeném místě.</font>"
#!{
	key[]: "aca_msg_book1_3_17_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_18
#@{

#### 3_18 common
	key[]: "aca_scenario_book1_3_18_title"
	val[]: "Kolmé parkování"

	key[]: "aca_scenario_book1_3_18_desc"
	val[]: "V tomto scénáři budeš mít za úkol zacouvat s návěsem do úzké uličky mimo silnici."

#### 3_18 goal

	key[]: "aca_goal_book1_3_18_check1"
	val[]: "Zatočení návěsu"
#!{
	key[]: "aca_goal_book1_3_18_start"
