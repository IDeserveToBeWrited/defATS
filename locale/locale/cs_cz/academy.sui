	key[]: "aca_msg_book1_2_02_check3_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/turning1_2_02.mat width=202 height=221 color=FFFFFFFF></align><offset vshift=221>"
#!}

#+ Book 1 Scenario 2_02
#@{

#### 2_02 common
	key[]: "aca_scenario_book1_2_02_title"
	val[]: "Kombinované jízdní úkony"

	key[]: "aca_scenario_book1_2_02_desc"
	val[]: "V tomto scénáři zkombinujeme tebou nově naučené dovednosti na krátké, ale technicky náročnější trati, která obsahuje couvání do zatáčky a projetí úzkou kolmou zatáčkou."

#### 2_02 goal
#!{
	key[]: "aca_goal_book1_2_02_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_02_check1"
	val[]: "@@aca_goal_book1_1_03_forward@@"

	key[]: "aca_goal_book1_2_02_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

#!}
	key[]: "aca_goal_book1_2_02_check2"
	val[]: "Couvání na stranu řidiče"

	key[]: "aca_goal_book1_2_02_check3"
	val[]: "Pravoúhlá zatáčka"

	key[]: "aca_goal_book1_2_02_check4"
	val[]: "Projetí zatáčky"



#### 2_02 msg - intro text

	key[]: "aca_msg_book1_2_02_cutscene1"
	val[]: "Před tebou se nachází bariéra. Najeď k ní a zastav."

	key[]: "aca_msg_book1_2_02_cutscene2"
	val[]: "Za tahačem na straně řidiče je další bariéra. Zacouvej k ní obloukem. Navést tě může značení na zemi."

	key[]: "aca_msg_book1_2_02_cutscene3"
	val[]: "Přímo před tebou je ostrá kolmá zatáčka. Jeď k ní."

	key[]: "aca_msg_book1_2_02_cutscene4"
	val[]: "Musíš si hodně najet, aby se zadní kola vyhnula kuželu na vnitřní straně zatáčky.<br>Používej zrcátka!"

	key[]: "aca_msg_book1_2_02_cutscene5"
	val[]: "Vyrovnej tahač, dojeď k poslední bariéře, poté zastav a zajisti tahač."

#### 2_02 Driving Instructions

	key[]: "aca_msg_book1_2_02_start"
	val[]: "<font face=/font/big_bold.font>Připrav se k jízdě.</font>"

	key[]: "aca_msg_book1_2_02_start_fail"
	val[]: "Tahač stále není připraven k jízdě, nezapomněl jsi na něco?<br><br>Nastartoval jsi motor? Uvolnil jsi parkovací brzdu?"

	key[]: "aca_msg_book1_2_02_check1"
	val[]: "U bariéry přímo před tebou je vyznačené místo.<br><br><font face=/font/big_bold.font>Jeď dopředu a zastav na vyznačeném místě.</font>"

	key[]: "aca_msg_book1_2_02_check2"
	val[]: "Podívej se za sebe na straně řidiče, uvidíš tam další vyznačené místo. Budeš muset couvat a zatáčet zároveň.<br><br><font face=/font/big_bold.font>Zacouvej obloukem a zastav na vyznačeném místě.</font>"

	key[]: "aca_msg_book1_2_02_check3"
	val[]: "@@aca_msg_book1_2_02_check3_img@@<br>Trať před tebou pokračuje kolmou zatáčkou.<br><br>Drž se na levé straně zatáčky, co nejvíce si najeď a poté zatoč ostře doprava. Dávej pozor, abys nenarazil do dopravního kuželu na vnitřní straně.<br><br><font face=/font/big_bold.font>Jeď dopředu a projeď zatáčkou.</font>"

	key[]: "aca_msg_book1_2_02_check4"
	val[]: "@@aca_msg_book1_2_02_check3_img@@ <br>Používej postranní zrcátko, abys do ničeho nenarazil.<br><br><font face=/font/big_bold.font>Dokonči zatáčku a zastav na vyznačeném místě.</font>"

	key[]: "aca_msg_book1_2_02_end"
	val[]: "<font face=/font/big_bold.font>Vypni motor a zajisti tahač.</font>"
#@}

# Book 1 Scenario 2_03 formatting
#!{
	key[]: "aca_msg_book1_2_03_mirror_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/front_mirror_possition_1.mat width=336 height=189 color=FFFFFFFF></align><offset vshift=189>"

	key[]: "aca_msg_book1_2_03_mirror_msg_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/front_mirror.mat width=336 height=189 color=FFFFFFFF></align><offset vshift=189>"

	key[]: "aca_msg_book1_2_03_check1_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/where_to_park.mat width=336 height=248 color=FFFFFFFF></align><offset vshift=248>"
#!}

#+ Book 1 Scenario 2_03
#@{

#### 2_03 common
	key[]: "aca_scenario_book1_2_03_title"
	val[]: "Zastavení u překážky"

	key[]: "aca_scenario_book1_2_03_desc"
	val[]: "V tomto scénáři si povíme o předním zrcátku - jeho umístění a efektivní využití při zastavení u překážky před tahačem."

#### 2_03 goal

	key[]: "aca_goal_book1_2_03_mirror"
	val[]: "Kontrola předního zrcátka"

	key[]: "aca_goal_book1_2_03_check1"
	val[]: "Zastavení u překážky"

	key[]: "aca_goal_book1_2_03_mirror_msg"
	val[]: "Pochopení funkce zrcátka"
#!{
	key[]: "aca_goal_book1_2_03_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_03_check1_msg"
	val[]: "@@aca_goal_book1_1_03_forward@@"

	key[]: "aca_goal_book1_2_03_end"
	val[]: "@@aca_goal_book1_2_01_end@@"


 #!}
#### 2_03 msg - intro

	key[]: "aca_msg_book1_2_03_cutscene1"
	val[]: "Tahače mají před sebou široký mrtvý úhel. V tomto prostoru lze snadno přehlédnout chodce či dokonce auto, proto jsou tahače vybaveny předním zrcátkem, které můžeš vidět přes čelní sklo."

	key[]: "aca_msg_book1_2_03_cutscene2"
	val[]: "Přední zrcátko je navržené tak, aby řidič do tohoto mrtvého úhlu viděl.<br>Slouží k zajištění bezpečnosti při manévrování ve stísněných prostorách."

	key[]: "aca_msg_book1_2_03_cutscene3"
	val[]: "Vyjeď směrem k bariérám před tebou a zpomal, jakmile se k nim přiblížíš.<br>Hlídej si přední zrcátko."

	key[]: "aca_msg_book1_2_03_cutscene4"
	val[]: "Zastav mezi čárou a překážkou."

#### 2_03 Driving Instructions

	key[]: "aca_msg_book1_2_03_mirror"
	val[]: "@@aca_msg_book1_2_03_mirror_img@@<br>V tomto scénáři se naučíme používat přední zrcátko, které vidíš na obrázku.<br><br><font face=/font/big_bold.font>Podívej se přes čelní sklo na straně spolujezdce.</font>"

	key[]: "aca_msg_book1_2_03_mirror_msg"
	val[]: "@@aca_msg_book1_2_03_mirror_msg_img@@<br>Přední zrcátko umožňuje vidět do mrtvého úhlu před tahačem. Pomůže ti řídit bezpečně a přesně.<br><br>Pokud ti jeho nastavení nevyhovuje, otevři '@@adjust_link_t@@' (dostaneš se k ní v menu pauzy) pro přizpůsobení dle svých představ.<br><br><font face=/font/big_bold.font>Stiskni @@imv_nrm_activate@@ pro pokračování.</font>"

	key[]: "aca_msg_book1_2_03_start"
	val[]: "Přímo před tahačem je vyznačené místo. Všimni si, že za tímto místem je překážka; až se k ní budeš blížit, jeď velmi pomalu a pomocí předního zrcátka si kontroluj vzdálenost od překážky.<br><br><font face=/font/big_bold.font>Připrav se k jízdě.</font>"

	key[]: "aca_msg_book1_2_03_start_fail"
	val[]: "Tahač stále není připraven k jízdě, nezapomněl jsi na něco?<br><br>Nastartoval jsi motor? Uvolnil jsi parkovací brzdu?"

	key[]: "aca_msg_book1_2_03_check1_msg"
	val[]: "<font face=/font/big_bold.font>Rozjeď se k parkovacímu místu.</font>"

	key[]: "aca_msg_book1_2_03_check1"
	val[]: "@@aca_msg_book1_2_03_check1_img@@<br><font face=/font/big_bold.font>Zastav předkem tahače mezi překážkou a čárou namalovanou na zemi.</font>"
#!{
	key[]: "aca_msg_book1_2_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

# Book 1 Scenario 2_04 formatting
#!{
	key[]: "aca_msg_book1_2_04_mirror_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/side_mirror_posisiton_1.mat width=336 height=189 color=FFFFFFFF></align><offset vshift=189>"

	key[]: "aca_msg_book1_2_04_start_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/side_mirror.mat width=336 height=189 color=FFFFFFFF></align><offset vshift=189>"
