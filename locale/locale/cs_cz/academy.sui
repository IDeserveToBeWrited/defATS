	key[]: "aca_scenario_book1_2_05_title"
	val[]: "Parkování u překážky pozadu"

	key[]: "aca_scenario_book1_2_05_desc"
	val[]: "V tomto scénáři budeš couvat s tahačem do parkovacího místa vedle obrubníku."

#### 2_05 goal
	key[]: "aca_goal_book1_2_05_summary"
	val[]: "Instrukce"
