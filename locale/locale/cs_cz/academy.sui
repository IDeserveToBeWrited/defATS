#+ Chapters general
#@{
	key[]: "aca_chapter_book1_1_title"
	val[]: "Základní ovládání a pohyb"

	key[]: "aca_chapter_book1_1_desc"
	val[]: "Nauč se základní ovládací prvky vozidla a jak pohybovat tahačem vpřed i vzad."

	key[]: "aca_chapter_book1_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Gratulujeme!<br>Dokončil jsi první kapitolu: @@aca_chapter_book1_1_title@@.<br><br>Naučil ses, jak připravit tahač před jízdou,<br>jízdu vpřed i vzad a jak použít světla a stěrače.</font><br><br>"

	key[]: "aca_chapter_book1_2_title"
	val[]: "Základní manévry"

	key[]: "aca_chapter_book1_2_desc"
	val[]: "Nauč se jezdit, manévrovat a parkovat s tahačem. Prozkoumej účel každého typu zrcátka a jak jej používat."

	key[]: "aca_chapter_book1_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Gratulujeme!<br>Dokončil jsi druhou kapitolu: @@aca_chapter_book1_2_title@@.<br><br>Naučil ses používat jednotlivá zrcátka na tahači, kontrolovat prostor kolem tahače před jízdou a provádět základní i pokročilé manévry.</font>"

	key[]: "aca_chapter_book1_3_title"
	val[]: "Manévrování s návěsem"

	key[]: "aca_chapter_book1_3_desc"
	val[]: "Nauč se připojovat návěs a manévrovat s ním v různých situacích."

	key[]: "aca_chapter_book1_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Gratulujeme!<br>Dokončil jsi třetí kapitolu: @@aca_chapter_book1_3_title@@.<br><br>Naučil ses připojovat a odpojovat návěs,<br>vnímat váhu a rozměry tahače s návěsem<br>a jezdit na náročných tratích s návěsem.</font><br><br>"

	key[]: "aca_chapter_book1_4_title"
	val[]: "Couvání s návěsem"

	key[]: "aca_chapter_book1_4_desc"
	val[]: "Nauč se nové manévry pro efektivní couvání a parkování s návěsem."

	key[]: "aca_chapter_book1_4_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Gratulujeme!<br>Dokončil jsi čtvrtou kapitolu: @@aca_chapter_book1_4_title@@.<br><br>Naučil ses couvání s návěsem<br>a různé techniky parkování.</font><br><br>"

	key[]: "aca_chapter_book1_5_title"
	val[]: "Závěrečná zkouška"

	key[]: "aca_chapter_book1_5_desc"
	val[]: "Předvěď své znalosti a dovednosti a dokaž, že máš na to být řidičem kamionu!"

	key[]: "aca_chapter_book1_5_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Gratulujeme!<br>Dokončil jsi pátou kapitolu: @@aca_chapter_book1_5_title@@.<br><br>Dokázal jsi, že máš všechny potřebné dovednosti<br>k řízení, manévrování a parkování kamionů!</font><br><br>"

	key[]: "aca_chapter_book2_0_title"
	val[]: "Zahřátí motoru"

	key[]: "aca_chapter_book2_0_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Dokončil jsi trénink: @@aca_chapter_book2_0_title@@.<br><br>Naučil ses pravidla a prvky modulu Odborné řízení kamionu.</font><br><br>"

	key[]: "aca_chapter_book2_1_title"
	val[]: "Zpátky do kabiny"

	key[]: "aca_chapter_book2_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font><font face=/font/big.font>Gratulujeme!<br>Dokončil jsi druhou kapitolu: @@aca_chapter_book2_1_title@@.<br><br>Zahřál jsi motor, vyzkoušel převody, pořádně roztočil kola a zkontroloval účinnost brzd. Následující kapitoly budou náročnější.</font><br><br>"

	key[]: "aca_chapter_book2_2_title"
	val[]: "Kola v pohybu"

	key[]: "aca_chapter_book2_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font><font face=/font/big.font>Gratulujeme!<br>Dokončil jsi třetí kapitolu: @@aca_chapter_book2_2_title@@.<br><br>Zvládl jsi náročné a různorodé scénáře. Předvedl jsi své dovednosti a výkonnost.</font><br><br>"

	key[]: "aca_chapter_book2_3_title"
	val[]: "Cílová rovinka"

	key[]: "aca_chapter_book2_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font><font face=/font/big.font>Gratulujeme!<br>Dokončil jsi čtvrtou kapitolu: @aca_chapter_book2_3_title@@.<br><br>Zvládl jsi mnoho obtížných situací při manévrování, parkování a couvání s návěsem. Prokázal jsi, že jsi zkušený řidič, který je schopen zvládnout jakékoliv náročné situace při řízení kamionu."

	key[]: "aca_chapter_book3_1_title"
	val[]: "Jízda vpřed"

	key[]: "aca_chapter_book3_1_desc"
	val[]: "Nauč se všechny základní techniky pro manévrování s B-double návěsy při jízdě vpřed."

	key[]: "aca_chapter_book3_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Gratulujeme!<br>Dokončil jsi první kapitolu: @@aca_chapter_book3_1_title@@.<br><br>Vyzkoušel sis efektivně řídit a manévrovat s B-double návěsy.</font><br><br>"

	key[]: "aca_chapter_book3_2_title"
	val[]: "Řízení při couvání"

	key[]: "aca_chapter_book3_2_desc"
	val[]: "Osvoj si nezbytné kroky pro manévrování s B-double návěsy při couvání."

	key[]: "aca_chapter_book3_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Gratulujeme!<br>Dokončil jsi druhou kapitolu: @@aca_chapter_book3_2_title@@.<br><br>Naučil ses úžasnou dovednost couvání s B-double návěsy.</font><br><br>"

	key[]: "aca_chapter_book3_3_title"
	val[]: "Příprava na skutečný svět"

	key[]: "aca_chapter_book3_3_desc"
	val[]: "Využij své nově nabyté znalosti v pokročilejších scénářích."

	key[]: "aca_chapter_book3_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font><font face=/font/big.font>Gratulujeme!<br>Dokončil jsi třetí kapitolu: @aca_chapter_book3_3_title@@.<br><br>Zvládl jsi mnoho obtížných situací při manévrování, parkování a couvání s B-double návěsy. Zde už ses dostatečně osvědčil a nyní můžeš vyrazit s B-double návěsy na silnice v American Truck Simulator!</font><br><br>"

#@}

