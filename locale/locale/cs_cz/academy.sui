#### 3_02 msg - intro text

	key[]: "aca_msg_book1_3_02_cutscene01"
	val[]: "V tomto scénáři vezmeme kamion na krátkou jízdu. Při sjíždění z mírného kopce před sebou si budeš moci vyzkoušet brzdění s návěsem. Připrav tahač na jízdu a rozjeď se."

	key[]: "aca_msg_book1_3_02_cutscene06"
	val[]: "Dosáhni rychlosti minimálně 60 km/h (37 mph). Připrav se na brzdnou zónu před sebou."

	key[]: "aca_msg_book1_3_02_cutscene08"
	val[]: "Začni brzdit do zastavení. Neotálej příliš dlouho, abys nenarazil do bariér před sebou!"

	key[]: "aca_msg_book1_3_02_cutscene10"
	val[]: "Zaparkuj na vyznačeném místě, poté zajisti tahač a vypni motor."


#### 3_02 Driving Instructions

	key[]: "aca_msg_book1_3_02_start"
	val[]: "Během této jízdy získáš cit pro používání provozní brzdy při sjíždění mírného kopce. Účelem tohoto cvičení je uvědomit si váhu za sebou a jak ovlivňuje brzdnou dráhu vozidla.<br><br><font face=/font/big_bold.font>Připrav se k jízdě.</font>"

	key[]: "aca_msg_book1_3_02_forward"
	val[]: "Rozjeď se a pamatuj, že potřebuješ dosáhnout rychlosti 60 km/h (37 mph) <font face=/font/big_bold.font>za</font> zatáčkou před tebou.<br><br><font face=/font/big_bold.font>Jeď k odbočce před tebou.</font>"

	key[]: "aca_msg_book1_3_02_check1"
	val[]: "Odboč vpravo a poté zrychli na 60 km/h (37 mph).<br><br><font face=/font/big_bold.font>Pokračuj v jízdě.</font>"

	key[]: "aca_msg_book1_3_02_check2"
	val[]: "<font face=/font/big_bold.font>Dosáhni rychlosti alespoň 60 km/h (37 mph).</font>"

	key[]: "aca_msg_book1_3_02_check3"
	val[]: "Dosáhl jsi požadované rychlosti.<br><br><font face=/font/big_bold.font>Zastav u bariér před tebou.</font>"
#!{
	key[]: "aca_msg_book1_3_02_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_02_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

