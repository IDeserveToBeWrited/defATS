#### 2_06 msg - intro text

	key[]: "aca_msg_book1_2_06_cutscene01"
	val[]: "V závěrečném scénáři této kapitoly si projedeme testovací polygon s komplexním uspořádáním."

	key[]: "aca_msg_book1_2_06_cutscene02"
	val[]: "První překážkou je slalom mezi bariérami. Projeď jím a nezapomeň používat zrcátka."

	key[]: "aca_msg_book1_2_06_cutscene04"
	val[]: "Následuje vlásenková zatáčka. Pořádně si najeď a neměl bys mít problém."

	key[]: "aca_msg_book1_2_06_cutscene05"
	val[]: "Cesta před tebou se výrazně zužuje. Jeď opatrně a použij postranní zrcátko, které ti pomůže."

	key[]: "aca_msg_book1_2_06_cutscene06"
	val[]: "Následuje řada snadných kolmých zatáček."

	key[]: "aca_msg_book1_2_06_cutscene08"
	val[]: "Další část musíš projet pozadu. Mysli na to, až budeš najíždět k bariérám před sebou."

	key[]: "aca_msg_book1_2_06_cutscene09"
	val[]: "Sleduj značení na silnici zpátky a kolem zatáček."

	key[]: "aca_msg_book1_2_06_cutscene10"
	val[]: "Zacouvej k bariérám, poté zastav a pokračuj vpřed doprava."

	key[]: "aca_msg_book1_2_06_cutscene11"
	val[]: "Tento průjezd mezi kužely je velmi těsný. Jeď pomalu a při průjezdu se orientuj pomocí zrcátek."

	key[]: "aca_msg_book1_2_06_cutscene13"
	val[]: "Před tebou je řada střídavě levotočivých a pravotočivých kolmých zatáček."

	key[]: "aca_msg_book1_2_06_cutscene15"
	val[]: "Na tomto přejezdu můžeš potkat vlak. Pokud se tak stane, zastav a počkej. Poté můžeš odbočit vpravo na příjezdovou komunikaci."

	key[]: "aca_msg_book1_2_06_cutscene16"
	val[]: "Odboč vlevo na silnici. Po odbočení můžeš nabrat rychlost."

	key[]: "aca_msg_book1_2_06_cutscene18"
	val[]: "Ještě několik odboček doleva a budeš v cíli!"

	key[]: "aca_msg_book1_2_06_cutscene19"
	val[]: "Přijeď k bariérám před sebou a připrav se zaparkovat na parkovacím místě vpravo."

	key[]: "aca_msg_book1_2_06_cutscene20"
	val[]: "Zacouvej do parkovacího místa, poté vypni motor a zajisti tahač."

#### 2_06 Driving Instructions



	key[]: "aca_msg_book1_2_06_forward"
	val[]: "Před tebou je slalom z bariér.<br><br><font face=/font/big_bold.font>Projeď slalomem.</font>"

	key[]: "aca_msg_book1_2_06_forward2"
	val[]: "<font face=/font/big_bold.font>Pokračuj po cestě kolem vlásenkové zatáčky.</font>"

	key[]: "aca_msg_book1_2_06_check1"
	val[]: "Cesta před tebou se výrazně zužuje. K orientaci můžeš použít postranní zrcátko.<br><br><font face=/font/big_bold.font>Postupuj opatrně.</font>"

	key[]: "aca_msg_book1_2_06_check2"
	val[]: "Po téhle zatáčce následuje pravoúhlá zatáčka.<br><br><font face=/font/big_bold.font>Jeď přiměřeně rychle.</font>"

	key[]: "aca_msg_book1_2_06_check3"
	val[]: "Před sebou máš několik snadných zatáček, v nichž podle potřeby upravuj rychlost.<br><br><font face=/font/big_bold.font>Pokračuj v jízdě.</font>"

	key[]: "aca_msg_book1_2_06_check4"
	val[]: "V následujícím úseku budeš muset couvat. Zastav u bariér před sebou tak, abys mohl následně zacouvat doprava.<br><br><font face=/font/big_bold.font>Zastav u bariér.</font>"

	key[]: "aca_msg_book1_2_06_check5"
	val[]: "Otoč se směrem k oblasti za sebou a doprava.<br><br><font face=/font/big_bold.font>Začni couvat.</font>"

	key[]: "aca_msg_book1_2_06_reverse"
	val[]: "Jeď po cestě kolem zatáček.<br><br><font face=/font/big_bold.font>Pokračuj v couvání.</font>"

	key[]: "aca_msg_book1_2_06_check6"
	val[]: "Za tebou vlevo jsou nějaké bariéry.<br><br><font face=/font/big_bold.font>Otoč se směrem k bariérám a připrav se zastavit.</font>"

	key[]: "aca_msg_book1_2_06_check7"
	val[]: "Zastav a zařaď dopředu, poté pokračuj vpravo.<br><br><font face=/font/big_bold.font>Jeď dopředu.</font>"

	key[]: "aca_msg_book1_2_06_check8"
	val[]: "Před tebou je úzká klikatá cesta s kužely. Jeď opatrně a v případě potřeby použij zrcátka.<br><br><font face=/font/big_bold.font>Projeď mezi kužely.</font>"

	key[]: "aca_msg_book1_2_06_check9"
	val[]: "Následuje kombinace různých pravoúhlých zatáček. Dbej na to, aby sis do každé zatáčky pořádně najížděl.<br><br><font face=/font/big_bold.font>Pokračuj v jízdě.</font>"

	key[]: "aca_msg_book1_2_06_check10"
	val[]: "Pozoruj železniční přejezd, když se k němu blížíš. Signalizace může značit blížící se vlak.<br><br><font face=/font/big_bold.font>Postupuj obezřetně.</font>"

	key[]: "aca_msg_book1_2_06_check11"
	val[]: "Odbočení na příjezdovou cestu částečně blokuje překážka, takže se při příjezdu drž vlevo, abys měl více místa.<br><br><font face=/font/big_bold.font>Projeď zatáčkou.</font>"

	key[]: "aca_msg_book1_2_06_check12"
	val[]: "Můžeš se rozhodnout, zda stopku dodržíš, nebo ji budeš ignorovat. Oblast byla pro naše potřeby uzavřena.<br><br><font face=/font/big_bold.font>Odboč vlevo.</font>"

	key[]: "aca_msg_book1_2_06_check13"
	val[]: "Zde můžeš trochu zrychlit, ale na další křižovatce budeš muset odbočit.<br><br><font face=/font/big_bold.font>Pokračuj po trati.</font>"

	key[]: "aca_msg_book1_2_06_check14"
	val[]: "Pokračuj do města odbočením vlevo, po kterém následují další dvě odbočení vlevo do poslední oblasti.<br><br><font face=/font/big_bold.font>Projeď městem.</font>"

	key[]: "aca_msg_book1_2_06_check15"
	val[]: "Na vzdálenější straně parkoviště jsou bariéry. Zajeď k nim.<br><br><font face=/font/big_bold.font>Zastav u bariér.</font>"

	key[]: "aca_msg_book1_2_06_check16"
	val[]: "Vpravo za tebou je parkovací místo.<br><br><font face=/font/big_bold.font>Zacouvej na parkovací místo.</font>"
#!{
	key[]: "aca_msg_book1_2_06_check17"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_06_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

