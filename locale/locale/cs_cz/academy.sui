	key[]: "aca_book_disclaimer"
	val[]: "<color value=@@clr_sel@@><font face=/font/big_bold.font>@@driving_academy@@ není náhradou skutečného výcviku v kabině.</font><br><br><color value=@@clr_txt@@>Důrazně doporučujeme vyhledat pokyny akreditované instituce zajišťující výcvik řízení nákladních vozidel, než se pokusíte řídit nákladní vozidlo v reálném životě.<br><br>Výcvikové instituce, které mají zájem využít @@driving_academy@@ jako doplněk výcviku řidičů, nás mohou kontaktovat na academy@scssoft.com."

	key[]: "aca_book_book1_title"
	val[]: "Základy řízení kamionu"

	key[]: "aca_book_book1_desc"
	val[]: "Nauč se základy řízení tahače, od základních funkcí a ovládacích prvků až po manévrování s návěsem."

	key[]: "aca_book_book2_title"
	val[]: "Odborné řízení kamionu"

	key[]: "aca_book_book2_desc"
	val[]: "Zdokonal své řidičské dovednosti s novými scénáři v náročnějších podmínkách."

	key[]: "aca_book_book3_title"
	val[]: "Řízení s dvojitým návěsem"

	key[]: "aca_book_book3_desc"
	val[]: "Vyzkoušej si zajímavé výzvy při jízdě a couvání s B-double návěsy."
