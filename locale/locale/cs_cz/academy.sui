	#### diag common

	key[]: "aca_scenario_book3_diag_title"
	val[]: "Parkování pod úhlem s B-double návěsy"

	key[]: "aca_scenario_book3_diag_desc"
	val[]: "V tomto scénáři zaparkuješ svůj B-double návěs na šikmém místě rušného parkoviště."

#### diag msg - intro text

	key[]: "aca_msg_book3_diag_cutscene1"
	val[]: "Šikmá parkovací místa jako je tohle jsou velmi běžná. Obzvláště typická jsou pro starší parkoviště, ale také mnoho odpočívadel na amerických dálnicích."

	key[]: "aca_msg_book3_diag_cutscene2"
	val[]: "Jeď k vyznačenému parkovacímu místu na konci řady."

	key[]: "aca_msg_book3_diag_cutscene3"
	val[]: "Drž se na vnější straně jízdního pruhu, ale ne těsně u svodidel, protože by do nich mohla při zatáčení narazit zadní část návěsu."

	key[]: "aca_msg_book3_diag_cutscene4"
	val[]: "Projeď kolem parkovacího místa tak, aby oba návěsy mohly vjet dovnitř. Pak se drž po vnější straně, aby se na parkovací místo dostal první návěs."

	key[]: "aca_msg_book3_diag_cutscene5"
	val[]: "Vyrovnej se, zastav na vyznačeném místě a zajisti tahač."

#### diag Driving Instructions

#!{
	key[]: "aca_msg_book3_diag_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_diag_forward"
	val[]: "Pokračuj směrem na konec řady a najdi své parkovací místo."

	key[]: "aca_msg_book3_diag_check1"
	val[]: "Pořádně si najeď před parkovací místo, aby ses ujistil, že do něj vjede i zadní návěs, poté ostře zatoč a zároveň dbej na to, aby se přední část prvního návěsu nestřetla s tahačem vedle tebe."

	key[]: "aca_msg_book3_diag_stop"
	val[]: "Pomalu pokračuj v narovnávání soupravy a poté zastav na vyznačeném místě."

#!{
	key[]: "aca_msg_book3_diag_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


