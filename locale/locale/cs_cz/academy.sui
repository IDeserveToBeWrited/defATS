#### 3_19 msg - intro text

	key[]: "aca_msg_book1_3_19_cutscene01"
	val[]: "Vítej v první části závěrečné zkoušky. Zjistíme, jak dobře ses naučil během svého času v Academy řídit kamion."

	key[]: "aca_msg_book1_3_19_cutscene02"
	val[]: "Nejprve připojíš návěs. Poté projedeš kamionem celou testovací oblast."

	key[]: "aca_msg_book1_3_19_cutscene03"
	val[]: "První část zkoušky vede po vedlejších silnicích směrem do centra města."

	key[]: "aca_msg_book1_3_19_cutscene04"
	val[]: "Testovací trasa obsahuje různé druhy zatáček a překážek."

	key[]: "aca_msg_book1_3_19_cutscene05"
	val[]: "Krátká část trasy vede centrem města."

	key[]: "aca_msg_book1_3_19_cutscene06"
	val[]: "Otestujeme tvou schopnost manévrovat s kamionem v různých složitých situacích."

	key[]: "aca_msg_book1_3_19_cutscene07"
	val[]: "Setkáš se s různými situacemi, které prověří tvou pozornost vůči okolí."

	key[]: "aca_msg_book1_3_19_cutscene08"
	val[]: "Budeš muset couvat při průjezdu průmyslovým areálem."

	key[]: "aca_msg_book1_3_19_cutscene09"
	val[]: "Po jízdě po silnicích, přes centrum města a průmyslový areál zamíříš k sídlu @@driving_academy@@."

	key[]: "aca_msg_book1_3_19_cutscene10"
	val[]: "Krátká jízda po silnici a máš téměř hotovo."

	key[]: "aca_msg_book1_3_19_cutscene11"
	val[]: "Pro dokončení zkoušky musíš přesně zaparkovat. Můžeš si vybrat, který manévr ti nejlépe vyhovuje."

	key[]: "aca_msg_book1_3_19_cutscene12"
	val[]: "Není důvod být nervózní, naučil ses vše, co budeš potřebovat pro úspěšné splnění.<br><br>Hodně štěstí!"

#### 3_19 Driving Instructions



	key[]: "aca_msg_book1_3_19_forward"
	val[]: "Nejprve je třeba najít a připojit návěs. Je zaparkovaný vpředu napravo.<br><br><font face=/font/big_bold.font>Jeď k návěsu.</font>"

	key[]: "aca_msg_book1_3_19_coupling"
	val[]: "Odboč vlevo, pak zacouvej k návěsu a vyrovnej se s ním.<br><br><font face=/font/big_bold.font>Zacouvej k návěsu.</font>"

	key[]: "aca_msg_book1_3_19_park_br_on"
	val[]: "<font face=/font/big_bold.font>Zajisti tahač.</font>"

	key[]: "aca_msg_book1_3_19_connect"
	val[]: "<font face=/font/big_bold.font>Stiskni @@imv_nrm_attach@@ pro přípojení návěsu.</font>"

	key[]: "aca_msg_book1_3_19_park_br_off"
	val[]: "Návěs je připojen a kamion je připraven k jízdě.<br><br><font face=/font/big_bold.font>Uvolni parkovací brzdu.</font>"

	key[]: "aca_msg_book1_3_19_b_trailer"
	val[]: "Silnice byla pro účely našeho testování uzavřena. Dopravní značení můžeš buď dodržovat, nebo ignorovat, jak uznáš za vhodné.<br><br><font face=/font/big_bold.font>Jeď k silnici.</font>"

	key[]: "aca_msg_book1_3_19_check01"
	val[]: "Projeď prvními zatáčkami.<br><br><font face=/font/big_bold.font>Pokračuj v jízdě.</font>"

	key[]: "aca_msg_book1_3_19_check02"
	val[]: "Za další odbočkou je slalom z dopravních kuželů.<br><br><font face=/font/big_bold.font>Opatrně projížděj mezi dopravními kužely.</font>"

	#key[]: "aca_msg_book1_3_19_check02a"
	#val[]: "Continue through the roundabout into the town.<br><br><font face=/font/big_bold.font>Negotiate the roundabout.</font>"

	key[]: "aca_msg_book1_3_19_check02b"
	val[]: "Čeká tě několik dalších pravoúhlých zatáček.<br><br><font face=/font/big_bold.font>Pokračuj v jízdě.</font>"

	key[]: "aca_msg_book1_3_19_check03"
	val[]: "Další odbočka je velmi těsná a k úspěšnému projetí je potřeba celá silnice.<br><br><font face=/font/big_bold.font>Odboč vpravo a projeď uličkou.</font>"

	key[]: "aca_msg_book1_3_19_check04"
	val[]: "Z uličky odboč vlevo a poté vpravo na hlavní silnici.<br><br><font face=/font/big_bold.font>Pokračuj v jízdě.</font>"

	key[]: "aca_msg_book1_3_19_check05"
	val[]: "Při jízdě po hlavní silnici si můžeš na chvíli odpočinout.<br><br><font face=/font/big_bold.font>Pokračuj rovně.</font>"

	key[]: "aca_msg_book1_3_19_check06"
	val[]: "Na vjezdu a výjezdu z této cesty je několik ostrých zatáček.<br><br><font face=/font/big_bold.font>Opatrně projeď zatáčkami.</font>"

	key[]: "aca_msg_book1_3_19_check07"
	val[]: "Vjíždíš do složitějšího slalomu. Postupuj pomalu a používej zrcátka.<br><br><font face=/font/big_bold.font>Pokračuj v jízdě a opatrně projeď slalomem.</font>"

	key[]: "aca_msg_book1_3_19_check08"
	val[]: "Odboč vlevo do průmyslové zóny a dej pozor na sloup veřejného osvětlení.<br><br><font face=/font/big_bold.font>Odboč vlevo.</font>"

	key[]: "aca_msg_book1_3_19_check09"
	val[]: "Připrav se na couvání.<br><br><font face=/font/big_bold.font>Odboč vpravo a zastav v odděleném prostoru.</font>"

	key[]: "aca_msg_book1_3_19_check10"
	val[]: "Při couvání sleduj trať vlevo za sebou.<br><br><font face=/font/big_bold.font>Začni couvat.</font>"

	key[]: "aca_msg_book1_3_19_check11"
	val[]: "Pokračuj po trati doleva.<br><br><br><br><font face=/font/big_bold.font>Pokračuj v couvání.</font>"

	key[]: "aca_msg_book1_3_19_check12"
	val[]: "<font face=/font/big_bold.font>Jeď dopředu a odboč vpravo.</font>"

	key[]: "aca_msg_book1_3_19_check13"
	val[]: "<font face=/font/big_bold.font>Pokračuj k bráně.</font>"

	key[]: "aca_msg_book1_3_19_check14"
	val[]: "Počkej, až se brána otevře, a vrať se na hlavní silnici.<br><br><font face=/font/big_bold.font>Pokračuj v jízdě.</font>"

	key[]: "aca_msg_book1_3_19_check15"
	val[]: "Dávej pozor, abys nenarazil do značky.<br><br><font face=/font/big_bold.font>Odboč a pokračuj v jízdě.</font>"

	key[]: "aca_msg_book1_3_19_check16"
	val[]: "<font face=/font/big_bold.font>Odboč vlevo do oblasti Academy.</font>"

	key[]: "aca_msg_book1_3_19_check17"
	val[]: "<font face=/font/big_bold.font>Pokračuj rovně.</font>"

	key[]: "aca_msg_book1_3_19_check18"
	val[]: "Drž se na vnější straně, protože za zatáčkou je ostrá odbočka.<br><br><font face=/font/big_bold.font>Projeď zatáčkou.</font>"

	key[]: "aca_msg_book1_3_19_check19"
	val[]: "<font face=/font/big_bold.font>Odboč vlevo a připrav se na zaparkování nalevo.</font>"

	key[]: "aca_msg_book1_3_19_check20"
	val[]: "<font face=/font/big_bold.font>Zacouvej na parkovací místo.</font>"
