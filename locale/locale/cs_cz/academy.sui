#+ Book 1 Scenario 2_08
#@{

#### 2_08 common
	key[]: "aca_scenario_book1_2_08_title"
	val[]: "Jednoduchá testovací trať"

	key[]: "aca_scenario_book1_2_08_desc"
	val[]: "V tomto scénáři využiješ dovednosti, které ses dosud naučil, a vyzkoušíme si je při jízdě na jednoduché testovací trati."

#### 2_08 goal
#!{
	key[]: "aca_goal_book1_2_08_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_08_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_2_08_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
#!}
	key[]: "aca_goal_book1_2_08_forward"
	val[]: "Vjezd na trať"

	key[]: "aca_goal_book1_2_08_check1"
	val[]: "Široká vlásenková zatáčka"

	key[]: "aca_goal_book1_2_08_check2"
	val[]: "Průjezd slalomem"

	key[]: "aca_goal_book1_2_08_check3"
	val[]: "Úzká vlásenková zatáčka"

	key[]: "aca_goal_book1_2_08_check4"
	val[]: "Úzká zatáčka"

	key[]: "aca_goal_book1_2_08_check6"
	val[]: "Technický úsek"

	key[]: "aca_goal_book1_2_08_check7"
	val[]: "Otevřený úsek"



#### 2_08 msg - intro text

	key[]: "aca_msg_book1_2_08_cutscene1"
	val[]: "V tomto scénáři se vydáme s tahačem na krátkou projížďku, abychom zjistili, jak si s ní poradíš s nově nabytými dovednostmi.<br>Na trati jsou různé typy a kombinace zatáček. Není to závod, nejde ani o čas. Buď trpělivý a přizpůsob rychlost jízdy zatáčkám a překážkám, které potkáš."

	key[]: "aca_msg_book1_2_08_cutscene2"
	val[]: "Vjeď na trať širokou vlásenkovou zatáčkou."

	key[]: "aca_msg_book1_2_08_cutscene3"
	val[]: "Poté potkáš řadu překážek, které tě zavedou do nepravidelného slalomu."

	key[]: "aca_msg_book1_2_08_cutscene4"
	val[]: "Po projetí několika lehkých pravoúhlých zatáček narazíš na ostrou vlásenkovou zatáčku. Je důležité se správně napozicovat, abys zatáčku projel a plynule vjel do dalšího úseku."

	key[]: "aca_msg_book1_2_08_cutscene5"
	val[]: "Při průjezdu dlouhou zatáčkou dávej pozor na kužely, protože viditelnost přes kapotu je omezená."

	key[]: "aca_msg_book1_2_08_cutscene6"
	val[]: "Další sada bariér tě navede do širokého slalomu."

	key[]: "aca_msg_book1_2_08_cutscene7"
	val[]: "Trať se trochu otevře, ale nespěchej. Ještě pár snadných zatáček a máš hotovo."

	key[]: "aca_msg_book1_2_08_cutscene8"
	val[]: "Zastav na vyznačeném místě a zajisti tahač."


#### 2_08 Driving Instructions

	key[]: "aca_msg_book1_2_08_start"
	val[]: "Chceš-li úspěšně dokončit tento scénář, nesmíš nabourat, vyjet mimo trať ani narazit do žádného dopravního kuželu.<br><br><font face=/font/big_bold.font>Připrav se k jízdě.</font>"

	key[]: "aca_msg_book1_2_08_forward"
	val[]:"<font face=/font/big_bold.font>Pokračuj vpřed do široké vlásenkové zatáčky, abys vjel na trať.</font>"

	key[]: "aca_msg_book1_2_08_check1"
	val[]: "<font face=/font/big_bold.font>Projeď vlásenkovou zatáčkou.</font>"

	key[]: "aca_msg_book1_2_08_check2"
	val[]: "Blížíš se k několika bariérám zhruba uspořádaným do slalomu.<br><br><font face=/font/big_bold.font>Přizpůsob rychlost a pokračuj.</font>"

	key[]: "aca_msg_book1_2_08_check3"
	val[]: "Následují dvě lehké pravoúhlé zatáčky a po nich ostrá vlásenková zatáčka. Jeď pomalu.<br><br><font face=/font/big_bold.font>Pokračuj do úzké vlásenkové zatáčky.</font>"

	key[]: "aca_msg_book1_2_08_check4"
	val[]: "Při výjezdu z vlásenky narazíš na úzkou stáčející se cestu. Musíš se držet dál od vnitřní bariéry, ale dávej pozor, abys nenarazil do kuželů před tebou.<br><br><font face=/font/big_bold.font>Pokračuj v průjezdu zatáčkou.</font>"

	key[]: "aca_msg_book1_2_08_check6"
	val[]: "Na cestě před tebou je několik úzkých technických zatáček. Přizpůsob rychlost a opatrně projeď úsekem.<br><br><font face=/font/big_bold.font>Pokračuj v jízdě.</font>"

	key[]: "aca_msg_book1_2_08_check7"
	val[]: "Další úsek je otevřenější s několika snadnými zatáčkami. Nespěchej.<br><br><font face=/font/big_bold.font>Pokračuj v jízdě.</font>"
#!{
	key[]: "aca_msg_book1_2_08_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_08_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

#@}

#+ Book 1 Scenario 2_09
#@{

#### 2_09 common
	key[]: "aca_scenario_book1_2_09_title"
	val[]: "Podélné parkování"

	key[]: "aca_scenario_book1_2_09_desc"
	val[]: "V tomto scénáři se podíváme na podélné parkování mezi další dva tahače."

#### 2_09 goal

	key[]: "aca_goal_book1_2_09_stopmid"
	val[]: "Zastavení před parkovacím místem"

	key[]: "aca_goal_book1_2_09_checkmirror"
	val[]: "Kontrola zpětného zrcátka"

	key[]: "aca_goal_book1_2_09_backward"
	val[]: "Couvání na parkovací místo"

	key[]: "aca_goal_book1_2_09_stop"
	val[]: "Vyrovnání tahače na parkovacím místě"

#!{
	key[]: "aca_goal_book1_2_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_09_check1"
	val[]: "@@aca_goal_book1_1_03_forward@@"


	key[]: "aca_goal_book1_2_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"



 #!}
#### 2_09 msg - intro text

	key[]: "aca_msg_book1_2_09_cutscene1"
	val[]: "Podélné parkování je základní dovednost, kterou by měl každý kamioňák umět.<br>Připrav se k jízdě."

	key[]: "aca_msg_book1_2_09_cutscene2"
	val[]: "Jeď k parkovacímu místu.<br>Kontroluj své okolí."

	key[]: "aca_msg_book1_2_09_cutscene3"
	val[]: "Vyrovnej se s tahačem před parkovacím místem. Nejezdi příliš blízko, abys měl dostatek prostoru pro manévrování."

	key[]: "aca_msg_book1_2_09_cutscene4"
	val[]: "Zatoč ostře směrem k parkovacímu místu a začni couvat."

	key[]: "aca_msg_book1_2_09_cutscene5"
	val[]: "Při pohledu přes zrcátko na straně řidiče se zaměř na obrubník těsně před tahačem za sebou."

	key[]: "aca_msg_book1_2_09_cutscene6"
	val[]: "Jakmile předním nárazníkem zajedeš za tahač před sebou, můžeš začít zatáčet a vyrovávat se s parkovacím místem."

	key[]: "aca_msg_book1_2_09_cutscene7"
	val[]: "Narovnej kola a vycentruj tahač na parkovacím místě.<br>Zaparkuj a zajisti tahač."

#### 2_09 Driving Instructions

	key[]: "aca_msg_book1_2_09_start"
	val[]: "Před tebou jsou zaparkované tahače. Zbývá jedno volné místo, kde můžeš zaparkovat.<br><br><font face=/font/big_bold.font>Připrav se k jízdě.</font>"

	key[]: "aca_msg_book1_2_09_check1"
	val[]: "Nezapomeň si hlídat okolí. Během manévrování pořádně využívej zrcátka.<br><br><font face=/font/big_bold.font>Jeď dopředu.</font>"

	key[]: "aca_msg_book1_2_09_stopmid"
	val[]: "<color value=@@clr_white@@>Projeď kolem parkovacího místa na vyznačené místo. Odtud můžeš začít couvat.<br><br><font face=/font/big_bold.font>Zastav na vyznačeném místě.</font>"

	key[]: "aca_msg_book1_2_09_checkmirror"
	val[]: "Ujisti se, že v okolí nejsou žádné překážky a že máš prostor na couvání.<br><br><font face=/font/big_bold.font>Podívej se do zrcátka na straně spolujezdce.</font>"

	key[]: "aca_msg_book1_2_09_backward"
	val[]: "Natoč kola a zacouvej na parkovací místo.<br><br><font face=/font/big_bold.font>Začni couvat.</font>"

	key[]: "aca_msg_book1_2_09_stop"
	val[]: "Ve vhodný okamžik začni vyrovnávat tahač. Nenajeď na obrubník!<br><br><font face=/font/big_bold.font>Vyrovnej se s parkovacím místem.</font>"
#!{
	key[]: "aca_msg_book1_2_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

