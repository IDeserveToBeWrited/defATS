#+ Book 1 Scenario 3_09
#@{

#### 3_09 common
	key[]: "aca_scenario_book1_3_09_title"
	val[]: "Parkování pod úhlem"

	key[]: "aca_scenario_book1_3_09_desc"
	val[]: "V tomto scénáři zaparkuješ pod úhlem na zaplněném parkovišti.<br><br>Není zde dost prostoru pro manévrování, takže budeš muset být velmi přesný a rozvážný."

#### 3_09 goal

	key[]: "aca_goal_book1_3_09_check1"
	val[]: "Příjezd k parkovacímu místu"
#!{
	key[]: "aca_goal_book1_3_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_09_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_09_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
 #!}
#### 3_09 msg - intro text

	key[]: "aca_msg_book1_3_09_cutscene1"
	val[]: "Šikmá parkovací místa jako je tohle jsou velmi běžná. Můžeš je potkat na odpočívadlech po celé Americe.<br>Opět budeš muset popředu najet do parkovacího místa před sebou."

	key[]: "aca_msg_book1_3_09_cutscene2"
	val[]: "Jeď k vyznačenému parkovacímu místu na konci řady."

	key[]: "aca_msg_book1_3_09_cutscene3"
	val[]: "Drž se uprostřed pruhu nebo mírně vlevo. Potřebuješ si nechat prostor pro manévrování s návěsem."

	key[]: "aca_msg_book1_3_09_cutscene4"
	val[]: "Najeď si před parkovací místo, poté k němu ostře zatoč. Musíš si hlídat pravé postranní zrcátko, abys viděl, že návěs bezpečně vjíždí na parkovací místo."

	key[]: "aca_msg_book1_3_09_cutscene5"
	val[]: "Zastav na vyznačeném místě, zajisti tahač a vypni motor."


#### 3_09 Driving Instructions

	key[]: "aca_msg_book1_3_09_start"
	val[]: "@@aca_msg_book1_3_09_start_img@@<br>Při parkování pod úhlem je důležité správně odhadnout svou pozici. Když už jsi uprostřed manévru, tak se těžko přesouvá pozice, takže se ujisti, že máš dostatek místa od začátku.<br><br><font face=/font/big_bold.font>Připrav se k jízdě.</font>"

	key[]: "aca_msg_book1_3_09_forward"
	val[]: "<font face=/font/big_bold.font>Rozjeď se k parkovacímu místu.</font>"

	key[]: "aca_msg_book1_3_09_check1"
	val[]: "Přejeď parkovací místo, aby měl tvůj návěs dostatek prostoru k otočení kolem tahače na tvé vnitřní straně.<br><br><font face=/font/big_bold.font>Odboč na parkovací místo.</font>"
#!{
	key[]: "aca_msg_book1_3_09_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}

#@}

#+ Book 1 Scenario 3_10
#@{

#### 3_10 common
	key[]: "aca_scenario_book1_3_10_title"
	val[]: "Couvání přes ruku"

	key[]: "aca_scenario_book1_3_10_desc"
	val[]: "V tomto scénáři se zaměříme na couvání s kamionem na parkovací místo takzvaně přes ruku. Bez možnosti podívat se z okénka, abys viděl, kam jedeš, se musíš spoléhat pouze na svá zrcátka."

#### 3_10 goal
#!{
	key[]: "aca_goal_book1_3_10_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_10_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_10_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_10_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

 #!}
#### 3_10 msg - intro text

	key[]: "aca_msg_book1_3_10_cutscene1"
	val[]: "V tomto scénáři se naučíš manévr couvání přes ruku. Je lepší se tomuto typu couvání vyhnout, pokud je to možné, protože značně limituje tvůj výhled. Nespěchej a raději jeď velmi opatrně."

	key[]: "aca_msg_book1_3_10_cutscene2"
	val[]: "Pořádně si najeď před parkovací místo, abys měl dostatek prostoru k manévrování."

	key[]: "aca_msg_book1_3_10_cutscene3"
	val[]: "Zastav, rozhlédni se a začni couvat."

	key[]: "aca_msg_book1_3_10_cutscene4"
	val[]: "Natoč tahač směrem od parkovacího místa. Tím vystrčíš předek návěsu a zadek návěsu se natočí k parkovacímu místu. Buď opatrný, abys to nepřehnal a nezalomil návěs."

	key[]: "aca_msg_book1_3_10_cutscene5"
	val[]: "Jakmile návěs vjede do parkovacího místa, začni vyrovnávat tahač."

	key[]: "aca_msg_book1_3_10_cutscene6"
	val[]: "Zastav na vyznačeném místě a zajisti tahač."

#### 3_10 Driving Instructions

	key[]: "aca_msg_book1_3_10_start"
	val[]: "Couvání přes ruku funguje stejně jako klasické couvání, ale se stíženým výhledem na dané straně. Používej zrcátka a svůj nejlepší úsudek, abys s kamionem zaparkoval.<br><br><font face=/font/big_bold.font>Připrav se k jízdě.</font>"

	key[]: "aca_msg_book1_3_10_forward"
	val[]: "Před tebou na pravé straně je parkovací místo. Musíš si hodně najet, abys měl dostatek prostoru pro manévrování během couvání.<br><br><font face=/font/big_bold.font>Jeď dopředu.</font>"
#!{
	key[]: "aca_msg_book1_3_10_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
	key[]: "aca_msg_book1_3_10_check2"
	val[]: "Nezapomeň, že zatáčení tahače směrem od parkovacího místa natočí návěs směrem k parkovacímu místu. Používej zrcátka jak nejlépe umíš, aby ses na parkovací místo dostal.<br><br><font face=/font/big_bold.font>Začni couvat.</font>"


#@}

#+ Book 1 Scenario 3_11
#@{

#### 3_11 common
	key[]: "aca_scenario_book1_3_11_title"
	val[]: "Jízda po kruhovém objezdu"

	key[]: "aca_scenario_book1_3_11_desc"
	val[]: "V tomto scénáři se naučíš, jak jezdit po kruhovém objezdu.<br><br>Budeš si muset bedlivě hlídat návěs, jelikož tě bude následovat po jiné trajektorii než pojedeš ty."

#### 3_11 goal
#!{
	key[]: "aca_goal_book1_3_11_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_11_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


	key[]: "aca_goal_book1_3_11_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_11_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
 #!}

	key[]: "aca_goal_book1_3_11_check1"
	val[]: "Vjezd na kruhový objezd"

	key[]: "aca_goal_book1_3_11_check2"
	val[]: "Jízda po kruhovém objezdu"

	key[]: "aca_goal_book1_3_11_check3"
	val[]: "Jízda po kruhovém objezdu"

	key[]: "aca_goal_book1_3_11_check5"
	val[]: "Výjezd z kruhového objezdu"

	key[]: "aca_goal_book1_3_11_check6"
	val[]: "Jízda k vyznačenému místu"

#### 3_11 msg - intro text

	key[]: "aca_msg_book1_3_11_cutscene1"
	val[]: "Kruhové objezdy jsou v Americe stále častější, takže je potřeba vědět, jak jimi projíždět."

	key[]: "aca_msg_book1_3_11_cutscene3"
	val[]: "Když přijíždíš ke kruhovému objezdu, drž se na vnější straně svého pruhu. Tím získáš pro návěs dostatek místa v první zatáčce."

	key[]: "aca_msg_book1_3_11_cutscene4"
	val[]: "Vjeď k prostředku kruhového objezdu. Jakmile budeš celý uvnitř, zamiř ke vnější straně. Tím udržíš svůj návěs mimo ostrůvek."

	key[]: "aca_msg_book1_3_11_cutscene5"
	val[]: "Hlídej si v zrcátkách, že se návěs nepřibližuje k vnitřním bariérám."

	key[]: "aca_msg_book1_3_11_cutscene6"
	val[]: "Opuštění kruhového objezdu je vcelku snadné, jelikož tvůj návěs je již v pozici mimo vnitřní stranu výjezdu. Najeď si k výjezdu a návěs by tě měl hezky následovat."

	key[]: "aca_msg_book1_3_11_cutscene7"
	val[]: "Zaparkuj na vyznačeném místě a zajisti tahač."



#### 3_11 Driving Instructions
#!{
	key[]: "aca_msg_book1_3_11_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

	key[]: "aca_msg_book1_3_11_forward"
	val[]: "Před tebou je pro tebe přichystaný kruhový objezd.<br><br><font face=/font/big_bold.font>Pomalu se k němu přibližuj.</font>"

	key[]: "aca_msg_book1_3_11_check1"
	val[]: "Najeď si do něj zeširoka, aby tě návěs bez problému následoval.<br><br><font face=/font/big_bold.font>Vjeď na kruhový objezd.</font>"

	key[]: "aca_msg_book1_3_11_check2"
	val[]: "Jeď směrem k vnější straně objezdu. Drž se co nejvíce od středu, jak jen to bude možné, abys návěs udržel co nejdál od vnitřních bariér.<br><br><font face=/font/big_bold.font>Pokračuj jízdou kruhovým objezdem.</font>"

	key[]: "aca_msg_book1_3_11_check3"
	val[]: "Jeď blízko vnějších kuželů.<br><br><font face=/font/big_bold.font>Pokračuj v jízdě.</font>"

	key[]: "aca_msg_book1_3_11_check5"
	val[]: "<font face=/font/big_bold.font>Opusť kruhový objezd.</font>"

	key[]: "aca_msg_book1_3_11_check6"
	val[]: "<font face=/font/big_bold.font>Pokračuj na parkovací místo před tebou.</font>"

	key[]: "aca_msg_book1_3_11_stop"
	val[]: "<font face=/font/big_bold.font>Zastav na vyznačeném místě.</font>"

	key[]: "aca_msg_book1_3_11_end"
	val[]: "<font face=/font/big_bold.font>Zajisti tahač a vypni motor.</font>"
#@}

#+ Book 1 Scenario 3_12
#@{

#### 3_12 common
	key[]: "aca_scenario_book1_3_12_title"
	val[]: "Manévrování ve stísněném prostoru"

	key[]: "aca_scenario_book1_3_12_desc"
	val[]: "V tomto scénáři budeš mít za úkol otočit kamion ve stísněném prostoru, což vyžaduje sledování okolí a chytré využívání prostoru."

#### 3_12 goal



	key[]: "aca_goal_book1_3_12_check1"
	val[]: "Příprava na couvání"

	key[]: "aca_goal_book1_3_12_check2"
	val[]: "Opuštění oblasti"

	key[]: "aca_goal_book1_3_12_check3"
	val[]: "Couvání na místo"

	key[]: "aca_goal_book1_3_12_check4"
	val[]: "Dokončení couvání přes ruku"
#!{
	key[]: "aca_goal_book1_3_12_check5"
	val[]: "Unused"

	key[]: "aca_goal_book1_3_12_check6"
	val[]: "@@aca_goal_book1_3_11_check6@@"

	key[]: "aca_goal_book1_3_12_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_12_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_12_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_12_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"
 #!}

#### 3_12 msg - intro text

	key[]: "aca_msg_book1_3_12_cutscene01"
	val[]: "V tomto scénáři si projdeme, jak se otočit ve stísněném prostoru.<br>Ne vždy budeš mít pro manévrování s kamionem dostatek prostoru a budeš se muset přizpůsobit i méně vhodným situacím."

	key[]: "aca_msg_book1_3_12_cutscene02"
	val[]: "Projeď uličkou směrem k volnému prostranství."

	key[]: "aca_msg_book1_3_12_cutscene03"
	val[]: "Nalevo je další ulička, do které musíš zacouvat. Nastav se tak, jak potřebuješ.<br>Může být jednodušší pokusit se před zahájením couvání nasměrovat návěs do uličky."

	key[]: "aca_msg_book1_3_12_cutscene04"
	val[]: "Couvej směrem do uličky. Dávej pozor na všechny strany tahače a návěsu."

	key[]: "aca_msg_book1_3_12_cutscene05"
	val[]: "V uličce jsou překážky, takže se drž ke straně řidiče."

	key[]: "aca_msg_book1_3_12_cutscene06"
	val[]: "Po dokončení couvání můžeš pokračovat vpřed a vrátit se zpět směrem, odkud jsi přijel."

	key[]: "aca_msg_book1_3_12_cutscene07"
	val[]: "Při výjezdu můžeš mít problém s viditelností návěsu v zráctku na straně spolujezdce, proto využij veškerý dostupný prostor ve svůj prospěch."

	key[]: "aca_msg_book1_3_12_cutscene08"
	val[]: "Pokračuj v jízdě k výjezdu."

	key[]: "aca_msg_book1_3_12_cutscene09"
	val[]: "Zaparkuj na vyznačeném místě a zajisti tahač."
#!{
	key[]: "aca_msg_book1_3_12_cutscene10"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_12_cutscene11"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_12_cutscene12"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_12_cutscene13"
	val[]: "Unused"
#!}
#### 3_12 Driving Instructions

	key[]: "aca_msg_book1_3_12_start"
	val[]: "Před tebou se nachází prostor představující parkoviště spediční společnosti. Tvým úkolem je tam zajet, otočit se a přijet zpátky. Dobře využij dostupné místo kolem sebe.<br><br><font face=/font/big_bold.font>Připrav se k jízdě.</font>"

	key[]: "aca_msg_book1_3_12_forward"
	val[]: "<font face=/font/big_bold.font>Projeď uličkou.</font>"

	key[]: "aca_msg_book1_3_12_check1"
	val[]: "Hned za budovou vlevo je další ulička, do které musíš zacouvat. Nastav se tak, jak potřebuješ.<br><br><font face=/font/big_bold.font>Pokračuj v jízdě k bariérám.</font>"



	key[]: "aca_msg_book1_3_12_check3"
	val[]: "Začni couvat a natoč návěs směrem k uličce tak, abys tahačem nenarazil do ničeho na pravé straně.<br><br><font face=/font/big_bold.font>Začni couvat a natoč návěs do uličky. Zastav na vyznačeném místě.</font>"

	key[]: "aca_msg_book1_3_12_check4"
	val[]: "Nyní můžeš vyjet ven stejným směrem, odkud jsi přijel. Pořádně využij prostor, který máš k dispozici.<br><br><font face=/font/big_bold.font>Jeď dopředu a odboč vpravo.</font>"


	key[]: "aca_msg_book1_3_12_check6"
	val[]: "Pokračuj uličkou k vyznačenému místu."
#!{
	key[]: "aca_msg_book1_3_12_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_12_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_12_check5"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_12_check2"
	val[]: "Unused"
#!}

#@}

#+ Book 1 Scenario 3_13
#@{

#### 3_13 common
	key[]: "aca_scenario_book1_3_13_title"
	val[]: "Couvání při parkování do strany"

	key[]: "aca_scenario_book1_3_13_desc"
	val[]: "V tomto scénáři budeš mít za úkol zacouvat na parkovací místo, které není přímo za tebou. Prostor pro manévrování je omezený, takže ho musíš využít moudře."

#### 3_13 goal

#!{
	key[]: "aca_goal_book1_3_13_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_13_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_13_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_13_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

#!}

#### 3_13 msg - intro text

	key[]: "aca_msg_book1_3_13_cutscene01"
	val[]: "V tomto scénáři bude tvým úkolem zaparkovat na místě vedle tebe. Není zde mnoho prostoru pro manévrování, takže se budeš muset trochu více snažit, abys návěs dostal tam, kam chceš."

	key[]: "aca_msg_book1_3_13_cutscene02"
	val[]: "Jeď rovně až k bariéře."

	key[]: "aca_msg_book1_3_13_cutscene03"
	val[]: "Zastav před bariérou."

	key[]: "aca_msg_book1_3_13_cutscene04"
	val[]: "Před rozjetím ostře zatoč volantem na stranu řidiče. Tím se návěs začne stáčet k parkovacímu místu hned jakmile začneš couvat, čímž ušetříš cenný prostor."

	key[]: "aca_msg_book1_3_13_cutscene05"
	val[]: "Jakmile nasměruješ návěs tam, kam chceš, dostaň tahač před návěs a začni s ním zatáčet na parkovací místo."

	key[]: "aca_msg_book1_3_13_cutscene06"
	val[]: "Odtud už se to v zásadě neliší od běžného parkovacího manévru."

	key[]: "aca_msg_book1_3_13_cutscene07"
	val[]: "Pokračuj v couvání a sleduj obě strany. Udržuj tahač a návěs srovnaný s parkovacím místem."

	key[]: "aca_msg_book1_3_13_cutscene08"
	val[]: "Zastav na vyznačeném místě, zajisti tahač a vypni motor."


#### 3_13 Driving Instructions

	key[]: "aca_msg_book1_3_13_start"
	val[]: "Nacházíš se na parkovacím místě, ale po své pravici máš druhé parkovací místo, na které musíš přejet.<br><br><font face=/font/big_bold.font>Připrav se k jízdě.</font>"

	key[]: "aca_msg_book1_3_13_forward"
	val[]: "Před tebou je vyznačená oblast.<br><br><font face=/font/big_bold.font>Jeď dopředu.</font>"
#!{
	key[]: "aca_msg_book1_3_13_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

	key[]: "aca_msg_book1_3_13_check2"
	val[]: "Nezapomeň okamžitě začít zatáčet, protože tam není mnoho místa.<br><br><font face=/font/big_bold.font>Zacouvej na označené místo za sebou.</font>"


#@}

#+ Book 1 Scenario 3_15
#@{

#### 3_15 common
	key[]: "aca_scenario_book1_3_15_title"
	val[]: "Zatáčky s nadjetím a najetím"

	key[]: "aca_scenario_book1_3_15_desc"
	val[]: "V tomto scénáři se projedeš krátkou cvičnou dráhou, která ti pomůže naučit se manévrovat s návěsem přes úzké pravoúhlé zatáčky pomocí dvou různých způsobů zatáčení."

#### 3_15 goal
#!{
	key[]: "aca_goal_book1_3_15_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

