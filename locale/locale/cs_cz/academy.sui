#### 3_11 msg - intro text

	key[]: "aca_msg_book3_3_11_cutscene1"
	val[]: "Kruhové objezdy se s B-double návěsy projíždějí o něco složitěji než s jedním návěsem."

	key[]: "aca_msg_book3_3_11_cutscene2"
	val[]: "Musíš si dostatečně nadjet tak, aby oba návěsy úspěšně vjely dovnitř, ale pak musíš jet po vnější straně, aby návěsy zůstaly mimo střed."

	key[]: "aca_msg_book3_3_11_cutscene3"
	val[]: "Je v pořádku, pokud se oba návěsy nevejdou do jednoho pruhu - ve skutečnosti může být dokonce lepší zabrat oba pruhy, aby se tě optimistický řidič nepokoušel předjíždět."

	key[]: "aca_msg_book3_3_11_cutscene4"
	val[]: "Přejeď na vzdálenější stranu svého výjezdového pruhu, aby ses znovu ujistili, že oba návěsy nemůžou do ničeho narazit."

	key[]: "aca_msg_book3_3_11_cutscene5"
	val[]: "Pokračuj ke druhému kruhovému objezdu."

	key[]: "aca_msg_book3_3_11_cutscene6"
	val[]: "Tento kruhový objezd má pouze jeden pruh, tak jeď přesně a nespěchej."

	key[]: "aca_msg_book3_3_11_cutscene7"
	val[]: "Využij veškerý dostupný prostor - zkracování zatáček ti jen zkomplikuje práci."

	key[]: "aca_msg_book3_3_11_cutscene8"
	val[]: "Projeď výjezdem a pokračuj směrem k parkovacímu místu."

	key[]: "aca_msg_book3_3_11_cutscene9"
	val[]: "Zaparkuj a zajisti tahač."

#### 3_11 infinite Fun Driving Instructions

#!{
	key[]: "aca_msg_book3_3_11_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_3_11_forward"
	val[]: "Nacházíš se na trati, která tě naučí projíždět kruhovými objezdy. Jakmile budeš připraveni, rozjeď se."

	key[]: "aca_msg_book3_3_11_check1"
	val[]: "Najeď si pořádně do kruhového objezdu, než zamíříš k vnějším kuželům, aby oba návěsy bezpečně vjely dovnitř."

	key[]: "aca_msg_book3_3_11_check2"
	val[]: "Budeš chtít jet na protější stranu výjezdu, aby se tvé návěsy vyhnuly kuželům.<br><br>Těsně před výjezdem z kruhového objezdu může být užitečné zatočit směrem k jeho středu."

#!{
	key[]: "aca_msg_book3_3_11_check3"
	val[]: "@@aca_msg_book3_sup_check1@@"
#!}
	key[]: "aca_msg_book3_3_11_check4"
	val[]: "Vše bys měl v pohodě zvládnout sám, nespěchej a chytře využívej dostupného místa."

	key[]: "aca_msg_book3_3_11_check5"
	val[]: "Opatrně vyjeď z kruhového objezdu."

#!{
	key[]: "aca_msg_book3_3_11_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_3_11_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


