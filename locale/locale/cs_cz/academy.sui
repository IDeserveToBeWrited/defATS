#### 3_04 msg - intro text

	key[]: "aca_msg_book1_3_04_cutscene01"
	val[]: "Nezapomeň si každou zatáčku dopředu naplánovat a pořádně využívat prostor kolem sebe. Objeď první sadu bariér a vjeď na trať."

	key[]: "aca_msg_book1_3_04_cutscene02"
	val[]: "Prvních několik zatáček se postupně utahuje."

	key[]: "aca_msg_book1_3_04_cutscene03"
	val[]: "Nezapomeň, že způsob, jakým vyjedeš z jedné zatáčky, může ovlivnit vjezd do další."

	key[]: "aca_msg_book1_3_04_cutscene04"
	val[]: "První z náročnějších rohů kombinuje dvě vlásenkové zatáčky do jedné. Při jízdě buď velmi opatrný, rozvážný a využívej zrcátka ve svůj prospěch."

	key[]: "aca_msg_book1_3_04_cutscene05"
	val[]: "Pokračuj úzkým úsekem."

	key[]: "aca_msg_book1_3_04_cutscene06"
	val[]: "Následuje několik snadných zatáček na cestě k úzké vlásenkové zatáčce."

	key[]: "aca_msg_book1_3_04_cutscene07"
	val[]: "Dávej pozor, ať nenarazíš do některé z bariér. Jeď tak pomalu, jak potřebuješ."

	key[]: "aca_msg_book1_3_04_cutscene08"
	val[]: "I když se zdá, že máš dostatek manévrovacího prostoru, můžeš se dostat do svízelné situace."

	key[]: "aca_msg_book1_3_04_cutscene09"
	val[]: "Nejsložitější zatáčka je přímo před tebou. Tvůj vjezd do zatáčky rozhodne o tom, zda ji úspěšně projedeš."

	key[]: "aca_msg_book1_3_04_cutscene10"
	val[]: "Pokračuj závěrečnou zatáčkou."

	key[]: "aca_msg_book1_3_04_cutscene11"
	val[]: "Zastav na vyznačeném místě, zajisti tahač a vypni motor."
#!{
	key[]: "aca_msg_book1_3_04_cutscene12"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_04_cutscene13"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_04_cutscene14"
	val[]: "Unused"
#!}

#### 3_04 Driving Instructions



	key[]: "aca_msg_book1_3_04_forward"
	val[]: "<font face=/font/big_bold.font>Rozjeď se a projeď kolem bariér.</font>"

	key[]: "aca_msg_book1_3_04_check1"
	val[]: "Pokračuj na trať a projeď první dvě snadné zatáčky.<br><br><font face=/font/big_bold.font>Pokračuj v jízdě.</font>"

	key[]: "aca_msg_book1_3_04_check2"
	val[]: "<font face=/font/big_bold.font>Projeď pravoúhlou zatáčkou.</font>"

	key[]: "aca_msg_book1_3_04_check3"
	val[]: "Dalším úsekem trati je dvojitá vlásenka. To, jak manévruješ v první části, přímo ovlivní tvůj průjezd druhou částí.<br><br><font face=/font/big_bold.font>Postupuj obezřetně.</font>"

	key[]: "aca_msg_book1_3_04_check4"
	val[]: "Při výjezdu z vlásenek se drž vlevo, aby ses připravil na vjezd do úzkého úseku.<br><br><font face=/font/big_bold.font>Pokračuj v jízdě.</font>"

	key[]: "aca_msg_book1_3_04_check5"
	val[]: "<font face=/font/big_bold.font>Pokračuj úzkým úsekem.</font>"

	key[]: "aca_msg_book1_3_04_check6"
	val[]: "Následuje pár snadných pravoúhlých zatáček.<br><br><font face=/font/big_bold.font>Projeď zatáčkami.</font>"

	key[]: "aca_msg_book1_3_04_check7"
	val[]: "Blížíš se k další vlásence. Při přiblížení sleduj svůj návěs v zrcátku.<br><br><font face=/font/big_bold.font>Projeď vlásenkou.</font>"

	key[]: "aca_msg_book1_3_04_check8"
	val[]: "Pravoúhlá zatáčka před tebou je mnohem užší, než se zdá. Využívej prostoru rozvážně.<br><br><font face=/font/big_bold.font>Pokračuj v jízdě.</font>"

	key[]: "aca_msg_book1_3_04_check9"
	val[]: "Závěrečná vlásenka je náročná a není v ní téměř žádný volný prostor.<br><br><font face=/font/big_bold.font>Postupuj obezřetně.</font>"

	key[]: "aca_msg_book1_3_04_check10"
	val[]: "Čeká tě poslední pravoúhlá zatáčka.<br><br><font face=/font/big_bold.font>Pokračuj v jízdě.</font>"

	key[]: "aca_msg_book1_3_04_check11"
	val[]: "Pokračuj na vyznačené místo."
