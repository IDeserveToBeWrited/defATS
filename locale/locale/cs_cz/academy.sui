	key[]: "aca_scenario_book3_3_11_title"
	val[]: "Nekonečná zábava"

	key[]: "aca_scenario_book3_3_11_desc"
	val[]: "V tomto scénáři projedeme dvěma různými kruhovými objezdy s B-double návěsy."

#### 3_11 goal

#!{
	key[]: "aca_goal_book3_3_11_start"
