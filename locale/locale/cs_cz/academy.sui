#### 3_05 common
	key[]: "aca_scenario_book1_3_05_title"
	val[]: "Couvání s návěsem"

	key[]: "aca_scenario_book1_3_05_desc"
	val[]: "V tomto scénáři si poprvé vyzkoušíš couvání s návěsem. Jedná se o poměrně jednoduchý manévr, ale pořád budeš muset správně zatáčet, abys návěs nasměroval do správné pozice."

	#### 3_05 goal



	key[]: "aca_goal_book1_3_05_check_con"
	val[]: "Couvání k návěsu"

	key[]: "aca_goal_book1_3_05_connect"
	val[]: "Připojení návěsu"

	key[]: "aca_goal_book1_3_05_park_br_off"
	val[]: "Uvolnění parkovací brzdy"

	key[]: "aca_goal_book1_3_05_b_trailer"
	val[]: "Srovnání s parkovacím místem"

	key[]: "aca_goal_book1_3_05_check1"
	val[]: "Couvání k parkovacímu místu"

	key[]: "aca_goal_book1_3_05_check2"
	val[]: "Srovnání s parkovacím místem"
