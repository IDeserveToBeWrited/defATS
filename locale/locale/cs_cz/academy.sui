#+ Book 1 Scenario 2_04
#@{

#### 2_04 common
	key[]: "aca_scenario_book1_2_04_title"
	val[]: "Parkování u překážky"

	key[]: "aca_scenario_book1_2_04_desc"
	val[]: "V tomto scénáři se naučíš parkovat u obrubníku s použitím postranního zrcátka."

#### 2_04 goal

	key[]: "aca_goal_book1_2_04_mirror"
	val[]: "Kontrola postranního zrcátka"

	key[]: "aca_goal_book1_2_04_check1"
	val[]: "Jízda k obrubníku"

#!{
	key[]: "aca_goal_book1_2_04_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_04_forward"
	val[]: "@@aca_goal_book1_1_03_forward@@"


	key[]: "aca_goal_book1_2_04_check2"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_2_04_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

 #!}

#### 2_04 msg - intro text

	key[]: "aca_msg_book1_2_04_cutscene1"
	val[]: "Postranní zrcátko je další nástroj, který ti pomůže bezpečně manévrovat s tahačem. Nachází se nad horním rámem okna spolujezdce."

	key[]: "aca_msg_book1_2_04_cutscene2"
	val[]: "Tato dřevená prkna představují obrubník. Budeš muset zastavit vedle nich.<br>Zatoč k obrubníku, abys ses dostal do vhodné pozice pro vyrovnání se s parkovacím místem."

	key[]: "aca_msg_book1_2_04_cutscene3"
	val[]: "Před obrubníkem hodně zpomal a zatoč směrem k parkovacímu místu. Při vyrovnávání můžeš používat postranní zrcátko, abys odhadnul svou vzdálenost od obrubníku."

	key[]: "aca_msg_book1_2_04_cutscene4"
	val[]: "Zastav na parkovacím místě a zajisti tahač."

#### 2_04 Driving Instructions

	key[]: "aca_msg_book1_2_04_mirror"
	val[]: "@@aca_msg_book1_2_04_mirror_img@@<br><font face=/font/big_bold.font>Podívej se skrz okno spolujezdce. Můžeš tam vidět postranní zrcátko.</font>@@aca_goal_tip@@ Musíš být uvnitř vozidla."

	key[]: "aca_msg_book1_2_04_start"
	val[]: "@@aca_msg_book1_2_04_start_img@@<br>Postranní zráctko pokrývá oblast na straně spolujezdce, kam řidič nevidí. Je to jeden z nejproblematičtějších mrtvých úhlů tahače. Pokud ti úhel zrcátka nevyhovuje, můžeš ho upravit v „@@adjust_link_t@@“.<br><br><font face=/font/big_bold.font>Připrav se k jízdě.</font>"

	key[]: "aca_msg_book1_2_04_start_fail"
	val[]: "Tahač stále není připraven k jízdě, nezapomněl jsi na něco?<br><br>Nastartoval jsi motor? Uvolnil jsi parkovací brzdu?"

	key[]: "aca_msg_book1_2_04_forward"
	val[]: "Před tebou je řada prken, která představují obrubník. Na konci obrubníku je parkovací místo. Tam musíš zajet.<br><br><font face=/font/big_bold.font>Pokračuj, jakmile budeš připraven.</font>"

	key[]: "aca_msg_book1_2_04_check1"
	val[]: "Zatoč směrem k obrubníku. Pomocí postranního zrcátka kontroluj svou polohu vůči obrubníku, ale zároveň si hlídej, abys nepřejel žádný dopravní kužel.<br><br><font face=/font/big_bold.font>Jeď k obrubníku a na parkovací místo.</font>"
#!{
	key[]: "aca_msg_book1_2_04_check2"
	val[]: "@@aca_msg_book1_2_01_stop@@"
#!}
	key[]: "aca_msg_book1_2_04_end"
	val[]: "<font face=/font/big_bold.font>Zajisti tahač a vypni motor.</font>@@aca_goal_tip@@ Pro snadnější sledování zrcátek můžeš využít přednastavené pozice vnitřních pohledů. Pro kontrolu/změnu ovládání přejdi do Nastavení - „@@options_bindings_screen@@“."
#@}

#+ Book 1 Scenario 2_05
