	key[]: "aca_goal_book1_3_19_check04"
	val[]: "Easy Turns"

	key[]: "aca_goal_book1_3_19_check05"
	val[]: "Guida in linea retta"

	key[]: "aca_goal_book1_3_19_check06"
	val[]: "Svolte strette"

	key[]: "aca_goal_book1_3_19_check07"
	val[]: "Slalom stretto"

	key[]: "aca_goal_book1_3_19_check08"
	val[]: "Avvicinarsi alla sezione di retromarcia"

	key[]: "aca_goal_book1_3_19_check09"
	val[]: "Preparazione alla retromarcia"


	key[]: "aca_goal_book1_3_19_check12"
	val[]: "Uscire dalla sezione di retromarcia"

	key[]: "aca_goal_book1_3_19_check13"
	val[]: "Guidare verso l'uscita"

	key[]: "aca_goal_book1_3_19_check14"
	val[]: "Uscita dalla zona industriale"

	key[]: "aca_goal_book1_3_19_check15"
	val[]: "Svolta stretta a destra"

	key[]: "aca_goal_book1_3_19_check16"
	val[]: "Ingresso nell'area della scuola"

	key[]: "aca_goal_book1_3_19_check17"
	val[]: "Guidare nell'area della Scuola"

	key[]: "aca_goal_book1_3_19_check18"
	val[]: "Gentle Curve"

	key[]: "aca_goal_book1_3_19_check19"
	val[]: "Svolta stretta a sinistra nell'area di parcheggio"

	key[]: "aca_goal_book1_3_19_check20"
	val[]: "Parking"

	key[]: "aca_goal_book1_3_19_stop"
	val[]: "Stopping in Designated Area"


#### 3_19 msg - intro text

	key[]: "aca_msg_book1_3_19_cutscene01"
	val[]: "Ti diamo il benvenuto alla prima parte dell'esame finale. Qui vedremo quanto bene hai imparato a guidare un camion dopo la tua permanenza nella Scuola Guida."

	key[]: "aca_msg_book1_3_19_cutscene02"
	val[]: "Come prima cosa, devi collegare il rimorchio. Una volta accoppiato, guida il camion lungo l'intero percorso di prova."

	key[]: "aca_msg_book1_3_19_cutscene03"
	val[]: "La prima sezione della prova ti porterà su alcune strade laterali che conducono verso il centro cittadino."

	key[]: "aca_msg_book1_3_19_cutscene04"
	val[]: "Il percorso della prova include vari tipi di curve e ostacoli."

	key[]: "aca_msg_book1_3_19_cutscene05"
	val[]: "Una piccola parte del percorso passa per il centro cittadino."

	key[]: "aca_msg_book1_3_19_cutscene06"
	val[]: "Metteremo alla prova la tua abilità di manovra del camion attraverso ostacoli e percorsi differenti."

	key[]: "aca_msg_book1_3_19_cutscene07"
	val[]: "Ti troverai ad affrontare varie situazioni che metteranno alla prova la tua attenzione all'ambiente circostante."

	key[]: "aca_msg_book1_3_19_cutscene08"
	val[]: "Ti faremo fare retromarcia in un impianto industriale."

	key[]: "aca_msg_book1_3_19_cutscene09"
	val[]: "Dopo aver guidato su strada, attraverso il centro cittadino e nell'impianto industriale, andrai verso il quartier generale della @@driving_academy@@."

	key[]: "aca_msg_book1_3_19_cutscene10"
	val[]: "Un breve tratto di strada, e avrai finito."

	key[]: "aca_msg_book1_3_19_cutscene11"
	val[]: "Per completare il test, dovrai parcheggiare con cura, scegliendo la manovra che preferisci."

	key[]: "aca_msg_book1_3_19_cutscene12"
	val[]: "Non c'è bisogno di essere nervosi, hai già imparato tutto quello che sarà richiesto per passare.<br><br>Buona fortuna!"

#### 3_19 Driving Instructions



	key[]: "aca_msg_book1_3_19_forward"
	val[]: "Come prima cosa, dovrai trovare e agganciare il rimorchio. È parcheggiato qui sopra, a destra.<br><br><font face=/font/big_bold.font>Guida verso il rimorchio. </font>"

	key[]: "aca_msg_book1_3_19_coupling"
	val[]: "Gira a sinistra, poi fai retromarcia verso il rimorchio e allineati ad esso.<br><br><font face=/font/big_bold.font>Fai retromarcia verso il rimorchio. </font>"

	key[]: "aca_msg_book1_3_19_park_br_on"
	val[]: "<font face=/font/big_bold.font>Assicura il camion. </font>"

	key[]: "aca_msg_book1_3_19_connect"
	val[]: "<font face=/font/big_bold.font>Premi @@imv_nrm_attach@@ per collegare il rimorchio. </font>"

	key[]: "aca_msg_book1_3_19_park_br_off"
	val[]: "Il rimorchio è collegato e il camion è pronto a partire.<br><br><font face=/font/big_bold.font>Rilascia il freno di stazionamento. </font>"

	key[]: "aca_msg_book1_3_19_b_trailer"
	val[]: "La strada è stata chiusa per il nostro test. Puoi scegliere se rispettare o ignorare i segnali stradali, come meglio credi.<br><br><font face=/font/big_bold.font>Guida verso la strada. </font>"

	key[]: "aca_msg_book1_3_19_check01"
	val[]: "Procedi lungo la prima serie di curve. <br><br><font face=/font/big_bold.font>Continua a guidare. </font>"

	key[]: "aca_msg_book1_3_19_check02"
	val[]: "Dopo la prossima curva c'è uno slalom fatto di coni.<br><br><font face=/font/big_bold.font>Guida con cautela tra i coni. </font>"

	#key[]: "aca_msg_book1_3_19_check02a"
	#val[]: "Continue through the roundabout into the town.<br><br><font face=/font/big_bold.font>Negotiate the roundabout.</font>"

	key[]: "aca_msg_book1_3_19_check02b"
	val[]: "Altre curve a 90 gradi ti aspettano.<br><br><font face=/font/big_bold.font>Continua a guidare. </font>"

	key[]: "aca_msg_book1_3_19_check03"
	val[]: "La prossima curva è molto stretta e richiederà tutta la strada per essere superata.<br><br><font face=/font/big_bold.font>Gira a destra e procedi attraverso il vicolo.</font>"

	key[]: "aca_msg_book1_3_19_check04"
	val[]: "Gira a sinistra fuori dal vicolo, poi gira a destra sulla strada principale.<br><br><font face=/font/big_bold.font>Continua a guidare. </font>"

	key[]: "aca_msg_book1_3_19_check05"
	val[]: "Puoi rilassarti un po' mentre guidi lungo la strada principale. <br><br><font face=/font/big_bold.font>Prosegui diritto. </font>"

	key[]: "aca_msg_book1_3_19_check06"
	val[]: "Ci sono alcune curve strette sulla strada di servizio e fuori.<br><br><font face=/font/big_bold.font>Guida con cautela attraverso le curve. </font>"

	key[]: "aca_msg_book1_3_19_check07"
	val[]: "Stai per entrare in uno slalom più complesso. Procedi lentamente e usa gli specchietti. <br><br><font face=/font/big_bold.font>Continua a guidare e percorri lo slalom con cautela.</font>"

	key[]: "aca_msg_book1_3_19_check08"
	val[]: "Gira a sinistra nella zona industriale, occhio al lampione.<br><br><font face=/font/big_bold.font>Effettua la curva a sinistra. </font>"

	key[]: "aca_msg_book1_3_19_check09"
	val[]: "Preparati alla retromarcia.<br><br><font face=/font/big_bold.font>Gira a destra e fermati nell'area riservata. </font>"

	key[]: "aca_msg_book1_3_19_check10"
	val[]: "Guida in retromarcia e segui il percorso verso sinistra dietro di te.<br><br><font face=/font/big_bold.font>Inizia la retromarcia.</font>"

	key[]: "aca_msg_book1_3_19_check11"
	val[]: "Segui il percorso a sinistra. <br><br><font face=/font/big_bold.font>Continua la retromarcia. </font>"

	key[]: "aca_msg_book1_3_19_check12"
	val[]: "<font face=/font/big_bold.font>Vai avanti e gira a destra. </font>"

	key[]: "aca_msg_book1_3_19_check13"
	val[]: "<font face=/font/big_bold.font>Continua verso il cancello. </font>"

	key[]: "aca_msg_book1_3_19_check14"
	val[]: "Aspetta che il cancello si apra, poi procedi di nuovo sulla strada principale.<br><br><font face=/font/big_bold.font>Continua a guidare. </font>"

	key[]: "aca_msg_book1_3_19_check15"
	val[]: "Occhio a non colpire il cartello.<br><br><font face=/font/big_bold.font>Fai la curva e continua a guidare. </font>"

	key[]: "aca_msg_book1_3_19_check16"
	val[]: "<font face=/font/big_bold.font>Gira a sinistra nella Scuola. </font>"

	key[]: "aca_msg_book1_3_19_check17"
	val[]: "<font face=/font/big_bold.font>Continua dritto.</font>"

	key[]: "aca_msg_book1_3_19_check18"
	val[]: "Tieniti verso l'esterno, dopo questa curva ce n'è un'altra più stretta.<br><br><font face=/font/big_bold.font>Segui la curva.</font>"

	key[]: "aca_msg_book1_3_19_check19"
	val[]: "<font face=/font/big_bold.font>Gira a sinistra e preparati a parcheggiare sulla sinistra.</font>"

	key[]: "aca_msg_book1_3_19_check20"
	val[]: "<font face=/font/big_bold.font>Prosegui in retromarcia fino al parcheggio.</font>"
#!{
	key[]: "aca_msg_book1_3_19_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_19_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_19_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
 #!}


#@}


#+ Book 1 Scenario 3_20
#@{

#### 3_20 common
	key[]: "aca_scenario_book1_3_20_title"
	val[]: "Esame Finale (Parte 2)"

	key[]: "aca_scenario_book1_3_20_desc"
	val[]: "Ti aspetta l'ultima parte dell'esame finale, dove verrà valuta l'abilità di parcheggio appresa negli scenari precedenti. Parcheggia con cura e sarai pronto a percorrere le strade d'America da abile camionista!"

#### 3_20 goal
#!{
	key[]: "aca_goal_book1_3_20_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_20_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_20_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_20_forward"
	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}


	key[]: "aca_goal_book1_3_20_park1"
	val[]: "Manovra in Offset"

	key[]: "aca_goal_book1_3_20_park2"
	val[]: "Parcheggio Diagonale"

	key[]: "aca_goal_book1_3_20_park3"
	val[]: "Guidare Attraverso il Parcheggio"

	key[]: "aca_goal_book1_3_20_park4"
	val[]: "Parcheggio Parallelo"

	key[]: "aca_goal_book1_3_20_park5"
	val[]: "Ultimo Parcheggio"


#### 3_20 msg - intro text

	key[]: "aca_msg_book1_3_20_cutscene01"
	val[]: "Benvenuto alla seconda parte dell'esame finale. Ci sposteremo in un parcheggio vicino e metteremo alla prova le tue abilità di retromarcia e manovra nei parcheggi."

	key[]: "aca_msg_book1_3_20_cutscene02"
	val[]: "Diverse sfide di parcheggio consecutive ti aspettano, per certificare le tue abilità."

	key[]: "aca_msg_book1_3_20_cutscene03"
	val[]: "Lo spazio qui è limitato, perciò fai attenzione e prenditi del tempo."

	key[]: "aca_msg_book1_3_20_cutscene04"
	val[]: "Fai buon uso dello spazio intorno a te e usa gli specchietti a tuo vantaggio. Buona fortuna!"




#### 3_20 outro text

	key[]: "aca_msg_book1_3_20_outro01"
	val[]: "Congratulations, you've successfully completed the exams for Truck Driving Basics, and learned all the skills necessary to properly manoeuvre your truck."

	key[]: "aca_msg_book1_3_20_outro02"
	val[]: "This is the first step in your journey towards realizing your dream of becoming a professional truck driver."

	key[]: "aca_msg_book1_3_20_outro03"
	val[]: "Ora sei pronto per affrontare le strade d'America e le tue prime sfide..."

	key[]: "aca_msg_book1_3_20_outro04"
	val[]: "...but the adventure has just begun."


#### 3_20 Driving Instructions

	key[]: "aca_msg_book1_3_20_start"
	val[]: "Ricordati di prestare attenzione e non essere frettoloso. Va bene anche se non ci riesci al primo colpo, la cosa importante è di non danneggiare il camion o i dintorni. <font face=/font/big_bold.font><br><br>Preparati a partire. </font>"

	key[]: "aca_msg_book1_3_20_forward"
	val[]: "<font face=/font/big_bold.font>Vai avanti verso la prima parte dell'esame.</font>"

	key[]: "aca_msg_book1_3_20_park1"
	val[]: "Il tuo primo compito è di dimostrare la manovra di parcheggio in offset. Il punto dove dovrai fare inversione con il rimorchio è alla tua sinistra.<br><br><font face=/font/big_bold.font>Effettua una manovra di parcheggio in offset.</font>"

	key[]: "aca_msg_book1_3_20_park2"
	val[]: "Il prossimo incarico è di fare retromarcia tra una fila di camion parcheggiati. Occhio a non colpirli!<br><br><font face=/font/big_bold.font>Effettua una manovra di parcheggio in diagonale.</font>"

	key[]: "aca_msg_book1_3_20_park3"
	val[]: "Continua attraverso il parcheggio. Tieni d'occhio eventuali situazioni inaspettate.<br><br><font face=/font/big_bold.font>Continua a guidare.</font>"

	key[]: "aca_msg_book1_3_20_park4"
	val[]: "Ora proviamo il parcheggio in parallelo tra i due camion vicini al cordolo davanti a te.<br><br><font face=/font/big_bold.font>Effettua una manovra di parcheggio in parallelo.</font>"

	key[]: "aca_msg_book1_3_20_park5"
	val[]: "Un'ultima manovra di parcheggio alla tua sinistra! Puoi scegliere di affrontarla in qualsiasi modo.<br><br><font face=/font/big_bold.font>Fai retromarcia nell'area designata.</font>"

	key[]: "aca_msg_book1_3_20_park6"
	val[]: "Ci siamo quasi. Lascia l'area di prova e parcheggia il camion.<br><br><font face=/font/big_bold.font>Esci dall'area di prova alla tua sinistra.</font>"

	key[]: "aca_msg_book1_3_20_stop"
	val[]: "Puoi parcheggiare il camion sulla destra insieme agli altri.<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_20_end"
	val[]: "@@aca_msg_book1_2_01_end@@"


#!}

#@}


#+ Book 1 Scenario 3_22
#@{

#### 3_22 common
	key[]: "aca_scenario_book1_3_22_title"
	val[]: "Parcheggio in Parallelo con un Rimorchio"

	key[]: "aca_scenario_book1_3_22_desc"
	val[]: "In questo scenario, daremo un'occhiata al parcheggio parallelo con il rimorchio collegato."

#### 3_22 goal


	key[]: "aca_goal_book1_3_22_stopmid"
	val[]: "Fermarsi nell'Area Contrassegnata"
#!{
	key[]: "aca_goal_book1_3_22_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_22_check1"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_22_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_22_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_22_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
  #!}
#### 3_22 msg - intro text

	key[]: "aca_msg_book1_3_22_cutscene1"
	val[]: "Il parcheggio parallelo con un rimorchio è un'abilità fondamentale per tutti i camionisti.<br>Che si tratti di parcheggio in strada in una grande città o di fermarsi in un'area di sosta in campagna, è qualcosa che ogni camionista dovrebbe sapere fare."

	key[]: "aca_msg_book1_3_22_cutscene2"
	val[]: "Superando il parcheggio, presta attenzione e assicurati di avere abbastanza spazio per far stare camion e rimorchio. In questo caso abbiamo fatto in modo di darti abbondante spazio."

	key[]: "aca_msg_book1_3_22_cutscene3"
	val[]: "Allineati al camion di fronte al parcheggio. Non stare troppo vicino, mantieni un po' di distanza per avere spazio di manovra."

	key[]: "aca_msg_book1_3_22_cutscene4"
	val[]: "Gira nettamente lontano dal parcheggio e inizia la retromarcia. L'idea è di far girare subito il rimorchio nel parcheggio."

	key[]: "aca_msg_book1_3_22_cutscene5"
	val[]: "Una volta che il rimorchio è orientato verso il punto, puoi iniziare a seguirlo."

	key[]: "aca_msg_book1_3_22_cutscene6"
	val[]: "Inizia a girare il rimorchio lontano dal cordolo prima che le ruote del rimorchio lato guida siano entrate nel parcheggio."

	key[]: "aca_msg_book1_3_22_cutscene7"
	val[]: "Raddrizza il trattore con il rimorchio, poi centrati all'interno dello spazio del parcheggio.<br><br>Parcheggia, spegni il motore e assicura il camion."

#### 3_22 Driving Instructions

	key[]: "aca_msg_book1_3_22_start"
	val[]: "Puoi vedere l'area di parcheggio di fronte a te, tra gli altri camion. Parcheggiando, assicurati di controllare gli specchietti e mantenere una distanza di sicurezza tra il camion e gli ostacoli intorno a te.<br><br><font face=/font/big_bold.font>Preparati a partire. </font>"

	key[]: "aca_msg_book1_3_22_check1"
	val[]: "Muoviti attraverso l'area per trovare lo spazio di parcheggio.<br><br><font face=/font/big_bold.font>Vai avanti. </font>"

	key[]: "aca_msg_book1_3_22_stopmid"
	val[]: "<color value=@@clr_white@@>Supera lo spazio di parcheggio desiderato nell'area contrassegnata. Da lì puoi iniziare la manovra di retromarcia.<br><br><font face=/font/big_bold.font>Fermati nel punto contrassegnato. </font>"

	key[]: "aca_msg_book1_3_22_backward"
	val[]: "Gira il trattore lontano dal punto per iniziare a girare il rimorchio verso di esso. Non girare troppo bruscamente o prenderai il cordolo. <br><br><font face=/font/big_bold.font>Inizia la retromarcia. </font>"

	key[]: "aca_msg_book1_3_22_stop"
	val[]: "Allinea il rimorchio con il punto. Se necessario, vai avanti o indietro mentre dai le sterzate necessarie per regolare la tua posizione.<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_22_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
 #!}

#@}

#+ Book 1 Scenario 3_21
#@{
#### 3_21 common
	key[]: "aca_scenario_book1_3_21_title"
	val[]: "Retromarcia da un'impostazione a 45 gradi"

	key[]: "aca_scenario_book1_3_21_desc"
	val[]: "In questo scenario esploreremo l'impostazione della retromarcia a 45 gradi."

#### 3_21 goal
#!{
	key[]: "aca_goal_book1_3_21_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_21_forward"
	val[]: "@@aca_goal_book1_1_03_forward@@"

	key[]: "aca_goal_book1_3_21_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}
	key[]: "aca_goal_book1_3_21_check1"
	val[]: "Checkpoint"

	key[]: "aca_goal_book1_3_21_check2"
	val[]: "Trovare la distanza giusta per la retromarcia"

	key[]: "aca_goal_book1_3_21_stop"
	val[]: "Parcheggiare nello spazio designato"



#### 3_21 msg - intro text

	key[]: "aca_msg_book1_3_21_cutscene1"
	val[]: "In questa lezione, daremo un'occhiata al parcheggio a 45 gradi. Quando la situazione lo permette, questo è il metodo preferito da molti per fare retromarcia nei parcheggi. Partendo con il rimorchio già puntato verso dove vuoi andare, dovrai fare meno manovre per parcheggiarti."

	key[]: "aca_msg_book1_3_21_cutscene2"
	val[]: "Questo tipo di impostazione ti permette di vedere più in profondità nel parcheggio, aumentando la visibilità della direzione in cui stai andando."

	key[]: "aca_msg_book1_3_21_cutscene3"
	val[]: "Vai un po' più avanti del parcheggio e allineati a un angolo di circa 45 gradi. Dovrai orientare il rimorchio in direzione del camion all'estremità opposta del parcheggio in cui intendi fare retromarcia."

	key[]: "aca_msg_book1_3_21_cutscene4"
	val[]: "Allontana il camion dal posto per spingere l'avantreno del rimorchio, guidando il retrotreno verso il parcheggio. Fai attenzione a non esagerare. Una volta iniziata la sterzata, è più facile renderla più stretta che allargarla."

	key[]: "aca_msg_book1_3_21_cutscene5"
	val[]: "Mentre il rimorchio entra nello spazio di parcheggio, porta il trattore di fronte a esso e allinea la coppia."

	key[]: "aca_msg_book1_3_21_cutscene6"
	val[]: "Fermati nel punto designato e metti il camion in sicurezza."

#### 3_21 Driving Instructions
#!{
	key[]: "aca_msg_book1_3_21_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

	key[]: "aca_msg_book1_3_21_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
	key[]: "aca_msg_book1_3_21_forward"
	val[]: "C'è uno spazio di parcheggio sulla sinistra. Vai un po' oltre e fai in modo di trovarti a un angolo di 45 gradi.<br><br><font face=/font/big_bold.font>Vai avanti. </font>"

	key[]: "aca_msg_book1_3_21_check1"
	val[]: "Allinea il camion con i segnali.<br><br><font face=/font/big_bold.font>Fermati nell'area contrassegnata. </font>"

	key[]: "aca_msg_book1_3_21_check2"
	val[]: "Utilizzando la conoscenza acquisita dagli scenari precedenti, gira il rimorchio nella zona di parcheggio.<br><br><font face=/font/big_bold.font>Inizia la retromarcia. </font>"

	key[]: "aca_msg_book1_3_21_stop"
	val[]: "Continua a manovrare il rimorchio nel parcheggio.<br><br>@@aca_msg_book1_2_01_stop@@"


#@}

