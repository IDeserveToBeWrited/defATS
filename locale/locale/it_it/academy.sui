#+ Book 1 Scenario 3_03
#@{

#### 3_03 common
	key[]: "aca_scenario_book1_3_03_title"
	val[]: "Guida in un percorso stradale"

	key[]: "aca_scenario_book1_3_03_desc"
	val[]: "In questo scenario esploreremo le manovre del rimorchio in un breve ma complesso percorso a ostacoli."

#### 3_03 goal
#!{
	key[]: "aca_goal_book1_3_03_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_03_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_03_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_03_end"
	val[]: "@@aca_goal_book1_2_01_end@@"


 #!}
	key[]: "aca_goal_book1_3_03_check1"
	val[]: "Prima curva"

	key[]: "aca_goal_book1_3_03_check2"
	val[]: "Roundabout"

	key[]: "aca_goal_book1_3_03_check3"
	val[]: "Curva a 90 gradi"

	key[]: "aca_goal_book1_3_03_check4"
	val[]: "Curva a ingresso allargato"

	key[]: "aca_goal_book1_3_03_check5"
	val[]: "Curva a ingresso allungato"

	key[]: "aca_goal_book1_3_03_check6"
	val[]: "Tight Turn"


#### generic phrase

	key[]: "aca_goal_book1_3_03_chk_point"
	val[]: "Guidare Intorno alle Barriere"

#### 3_03 msg - intro text

	key[]: "aca_msg_book1_3_03_cutscene01"
	val[]: "Qui davanti ci sono varie curve complesse e ostacoli.<br>Tieni in conto tutto quello che hai imparato finora e non dovrebbe essere troppo difficile."

	key[]: "aca_msg_book1_3_03_cutscene02"
	val[]: "La prima curva è una facile curva a ingresso allungato. Tieniti largo e non ci dovrebbero essere problemi."

	key[]: "aca_msg_book1_3_03_cutscene03"
	val[]: "Continua verso la rotatoria."

	key[]: "aca_msg_book1_3_03_cutscene04"
	val[]: "Mantieni il rimorchio distante dall'interno della rotatoria guidando la motrice il più largo possibile."

	key[]: "aca_msg_book1_3_03_cutscene05"
	val[]: "La curva a sinistra a 90 gradi non è particolarmente stretta, ma assicurati di non colpire nessun cono."

	key[]: "aca_msg_book1_3_03_cutscene06"
	val[]: "Questa curva è decisamente più stretta. Fai una manovra di ingresso allargato per completarla."

	key[]: "aca_msg_book1_3_03_cutscene07"
	val[]: "Puoi fare una manovra a ingresso allungato in questa curva, ma ci sono alcuni ostacoli extra da evitare."

	key[]: "aca_msg_book1_3_03_cutscene09"
	val[]: "Di nuovo, l'ultima curva è molto stretta e richiederà una combinazione di manovre a ingresso allargato e allungato per completarla."

	key[]: "aca_msg_book1_3_03_cutscene10"
	val[]: "Park in the designated area, secure the truck and shut down the engine."


#### 3_03 Driving Instructions



	key[]: "aca_msg_book1_3_03_forward"
	val[]: "<font face=/font/big_bold.font>Procedi verso la prima curva. </font>"

	key[]: "aca_msg_book1_3_03_check1"
	val[]: "La prossima è una facile curva a ingresso allungato.<br><br><font face=/font/big_bold.font><color value=@@clr_txt@@>Procedi nella curva. </font>"

	key[]: "aca_msg_book1_3_03_check2"
	val[]: "Continua verso la rotatoria. Ricordati di tenerti largo girandoci intorno.<br><br><font face=/font/big_bold.font>Guida verso la rotatoria.</font>"

	key[]: "aca_msg_book1_3_03_check3"
	val[]: "Questa curva a 90 gradi è un po' più stretta, occhio a non colpire i coni.<br><br><font face=/font/big_bold.font>Effettua la curva.</font>"

	key[]: "aca_msg_book1_3_03_check4"
	val[]: "Questa curva dovrebbe essere affrontata con una manovra a ingresso allargato. Tieniti largo prima di entrare nell'incrocio.<br><br><font face=/font/big_bold.font>Effettua una curva a ingresso allargato. </font>"

	key[]: "aca_msg_book1_3_03_check5"
	val[]: "Questa curva è piena di diversi ostacoli, ma può essere affrontata con una manovra a ingresso allungato.<br><br><font face=/font/big_bold.font>Procedi con cautela. </font>"

	key[]: "aca_msg_book1_3_03_check6"
	val[]: "Questa curva è la più stretta che abbiamo visto finora, affrontala come meglio credi.<br><br><font face=/font/big_bold.font>Svolta nel parcheggio.</font>"
#!{
	key[]: "aca_msg_book1_3_03_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_03_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

