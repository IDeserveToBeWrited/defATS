	key[]: "aca_goal_book1_3_06_check1"
	val[]: "Manovrare in Posizione"


#### 3_06 msg - intro text

	key[]: "aca_msg_book1_3_06_cutscene01"
	val[]: "Parcheggiare guidando in avanti, o 'entrando di muso', è piuttosto semplice per quanto riguarda le manovre di parcheggio. <br>Tuttavia, dovrai comunque compensare per lo spostamento laterale del rimorchio."

	key[]: "aca_msg_book1_3_06_cutscene02"
	val[]: "Dovrai guidare oltre il punto dove gireresti con il trattore da solo. Questo ti permetterà di avere il rimorchio allineato nel modo migliore."

	key[]: "aca_msg_book1_3_06_cutscene03"
	val[]: "Avvicinandoti al parcheggio, gira per posizionare il trattore di fronte al rimorchio. Allineati e procedi verso il posto. <br>Fermati, parcheggia e assicura il camion, e spegni il motore."

#### 3_06 Driving Instructions

	key[]: "aca_msg_book1_3_06_start"
	val[]: "Di fronte a te c'è un parcheggio in cui dovrai guidare e parcheggiare.<br><br><font face=/font/big_bold.font>Preparati a partire. </font>"

	key[]: "aca_msg_book1_3_06_forward"
	val[]: "<font face=/font/big_bold.font>Inizia a guidare e gira verso il parcheggio.</font>"

	key[]: "aca_msg_book1_3_06_check1"
	val[]: "Guida oltre il parcheggio per allineare il rimorchio all'area contrassegnata, poi porta il trattore sul punto e raddrizzati.<br><br><font face=/font/big_bold.font>Parcheggia nell'area designata.  </font>"

	key[]: "aca_msg_book1_3_06_stop"
	val[]: "<font face=/font/big_bold.font>Fermati nell'area designata.</font>"

	key[]: "aca_msg_book1_3_06_end"
	val[]: "<font face=/font/big_bold.font>Posteggia il camion e spegni il motore.</font>"
#@}

