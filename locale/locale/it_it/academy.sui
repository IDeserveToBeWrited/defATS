#### 3_12 msg - intro text

	key[]: "aca_msg_book1_3_12_cutscene01"
	val[]: "In questo scenario vedremo l'inversione in uno spazio stretto.<br>Non avrai sempre molto spazio per manovrare il camion, e ti dovrai adattare a situazioni poco ideali."

	key[]: "aca_msg_book1_3_12_cutscene02"
	val[]: "Guida attraverso il vicolo, verso lo spiazzo."

	key[]: "aca_msg_book1_3_12_cutscene03"
	val[]: "Sulla sinistra c'è un altro vicolo in cui dovrai fare retromarcia. Preparati come vuoi con questo a mente.<br>Potrebbe essere d'aiuto cercare di far puntare il rimorchio verso il vicolo prima di iniziare la retromarcia."

	key[]: "aca_msg_book1_3_12_cutscene04"
	val[]: "Fai retromarcia verso il vicolo. Tieni d'occhio tutti i lati del trattore e del rimorchio."

	key[]: "aca_msg_book1_3_12_cutscene05"
	val[]: "Ci sono ostacoli nel vicolo, quindi fai in modo di mantenerti verso il lato di guida."

	key[]: "aca_msg_book1_3_12_cutscene06"
	val[]: "Una volta finita la retromarcia, puoi procedere in avanti e ritornare nella direzione da cui sei venuto."

	key[]: "aca_msg_book1_3_12_cutscene07"
	val[]: "Mentre esci potresti avere difficoltà a vedere il rimorchio nello specchietto sul lato del passeggero, perciò usa tutto lo spazio a disposizione a tuo vantaggio."

	key[]: "aca_msg_book1_3_12_cutscene08"
	val[]: "Continua a guidare verso l'uscita."

	key[]: "aca_msg_book1_3_12_cutscene09"
	val[]: "Park in the designated area and secure the truck."
#!{
	key[]: "aca_msg_book1_3_12_cutscene10"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_12_cutscene11"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_12_cutscene12"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_12_cutscene13"
	val[]: "Unused"
#!}
#### 3_12 Driving Instructions

	key[]: "aca_msg_book1_3_12_start"
	val[]: "Di fronte a te c'è un'area che rappresenta il parcheggio di un'azienda. Il tuo compito è di entrare e girare il camion per uscire di nuovo. Assicurati di fare buon uso dello spazio intorno a te.<br><br><font face=/font/big_bold.font>Prepararti a partire </font>"

	key[]: "aca_msg_book1_3_12_forward"
	val[]: "<font face=/font/big_bold.font>Procedi nel vicolo. </font>"

	key[]: "aca_msg_book1_3_12_check1"
	val[]: "Appena dopo l'edificio sulla sinistra, c'è un altro vicolo in cui devi fare retromarcia. Preparati tenendo questo a mente.<br><br><font face=/font/big_bold.font>Continua verso le barriere. </font>"



	key[]: "aca_msg_book1_3_12_check3"
	val[]: "Fai retromarcia e gira il rimorchio verso il vicolo, assicurandoti di non urtare nulla sul lato destro con il trattore.<br><br><font face=/font/big_bold.font>Inizia la manovra e gira il rimorchio nel vicolo. Fermati nell'area contrassegnata. </font>"

	key[]: "aca_msg_book1_3_12_check4"
	val[]: "Puoi ora procedere fuori dall'area nella stessa direzione da cui sei venuto. Fai buon uso dello spazio a disposizione.<br><br><font face=/font/big_bold.font>Guida in avanti e gira a destra. </font>"


	key[]: "aca_msg_book1_3_12_check6"
	val[]: "Continua lungo il vicolo verso l'area designata."
#!{
	key[]: "aca_msg_book1_3_12_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_12_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_12_check5"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_12_check2"
	val[]: "Unused"
#!}

#@}

#+ Book 1 Scenario 3_13
#@{

#### 3_13 common
	key[]: "aca_scenario_book1_3_13_title"
	val[]: "Manovra di Retromarcia in Offset"

	key[]: "aca_scenario_book1_3_13_desc"
	val[]: "In questo scenario ti verrà richiesto di fare retromarcia in un'area che non è direttamente dietro di te. C'è poco spazio per manovrare, perciò dovrai usarlo intelligentemente."

#### 3_13 goal

#!{
	key[]: "aca_goal_book1_3_13_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_13_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_13_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_13_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

#!}

#### 3_13 msg - intro text

	key[]: "aca_msg_book1_3_13_cutscene01"
	val[]: "In questo scenario, il tuo compito sarà quello di parcheggiare nello spazio vicino a te. Non c'è molto spazio di manovra, perciò avrai bisogno di un piccolo lavoro extra per posizionare il rimorchio dove vuoi."

	key[]: "aca_msg_book1_3_13_cutscene02"
	val[]: "Guida dritto fino alla barriera."

	key[]: "aca_msg_book1_3_13_cutscene03"
	val[]: "Fermati prima della barriera."

	key[]: "aca_msg_book1_3_13_cutscene04"
	val[]: "Prima di muoverti, gira rapidamente lo sterzo verso il lato di guida. In questo modo, farai girare il rimorchio verso il parcheggio fin dall'inizio della manovra, risparmiando spazio utile."

	key[]: "aca_msg_book1_3_13_cutscene05"
	val[]: "Una volta che il rimorchio punta nella direzione desiderata, porta il trattore davanti al rimorchio e inizia a girare verso il parcheggio."

	key[]: "aca_msg_book1_3_13_cutscene06"
	val[]: "Da questo punto in poi, non è così diverso da una normale manovra di parcheggio."

	key[]: "aca_msg_book1_3_13_cutscene07"
	val[]: "Continua la retromarcia e controlla entrambi i lati. Mantieni il trattore e il rimorchio allineati al parcheggio."

	key[]: "aca_msg_book1_3_13_cutscene08"
	val[]: "Fermati nell'area designata, assicura il camion, e spegni il motore."


#### 3_13 Driving Instructions

	key[]: "aca_msg_book1_3_13_start"
	val[]: "Sei già in un parcheggio, ma c'è un'altra area di parcheggio alla tua destra dove dovrai spostarti.<br><br><font face=/font/big_bold.font>Preparati a partire. </font>"

	key[]: "aca_msg_book1_3_13_forward"
	val[]: "C'è un'area contrassegnata davanti a te.<br><br><font face=/font/big_bold.font>Vai avanti. </font>"
#!{
	key[]: "aca_msg_book1_3_13_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

	key[]: "aca_msg_book1_3_13_check2"
	val[]: "Ricorda di iniziare immediatamente a sterzare, perché non c'è molto spazio.<br><br><font face=/font/big_bold.font>Fai retromarcia nell'area contrassegnata dietro di te. </font>"


#@}

#+ Book 1 Scenario 3_15
#@{

#### 3_15 common
	key[]: "aca_scenario_book1_3_15_title"
	val[]: "Curve a ingresso allargato e a ingresso allungato"

	key[]: "aca_scenario_book1_3_15_desc"
	val[]: "In questo scenario guiderai lungo un breve percorso di pratica in cui imparerai a manovrare il rimorchio in curve strette con l'ausilio di due diverse procedure."

#### 3_15 goal
#!{
	key[]: "aca_goal_book1_3_15_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_15_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_15_check6"
	val[]: "@@aca_goal_book1_3_11_check6@@"

	key[]: "aca_goal_book1_3_15_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_15_end"
	val[]: "@@aca_goal_book1_2_01_end@@"


 #!}
	key[]: "aca_goal_book1_3_15_check1"
	val[]: "Curva a ingresso allargato"

	key[]: "aca_goal_book1_3_15_check2"
	val[]: "Curva e rettilineo"

	key[]: "aca_goal_book1_3_15_check3"
	val[]: "Curva a ingresso allungato"

	key[]: "aca_goal_book1_3_15_check4"
	val[]: "Rettilineo e curva"

	key[]: "aca_goal_book1_3_15_check5"
	val[]: "Svolta combinata"



#### 3_15 msg - intro text

	key[]: "aca_msg_book1_3_15_cutscene01"
	val[]: "Davanti a te ci sono alcune curve strette con poco spazio a disposizione.<br>Ti insegneranno come manovrare efficacemente il rimorchio."

	key[]: "aca_msg_book1_3_15_cutscene02"
	val[]: "@@aca_msg_book1_3_15_cutscene02_img@@<br>La prima curva richiede una manovra a 'ingresso allargato'. Questo termine si applica a curve dove hai spazio limitato nella strada in cui stai girando, e devi invece utilizzare dello spazio extra sulla strada che stai percorrendo attualmente."

	key[]: "aca_msg_book1_3_15_cutscene03"
	val[]: "Segui la segnaletica orizzontale per girare il trattore lontano dal cordolo interno.<br>Questo porterà il tuo rimorchio distante dal cordolo per darti sufficiente spazio di manovra."

	key[]: "aca_msg_book1_3_15_cutscene04"
	val[]: "Tieniti vicino all'ostacolo mentre esci dalla curva, così che il rimorchio continui a seguire l'arco più largo possibile."

	key[]: "aca_msg_book1_3_15_cutscene05"
	val[]: "Entrando nella lunga curva, devi tenere il trattore verso il centro della strada per mantenere le ruote del rimorchio fuori dal cordolo."

	key[]: "aca_msg_book1_3_15_cutscene06"
	val[]: "Continua lungo la strada."

	key[]: "aca_msg_book1_3_15_cutscene07"
	val[]: "@@aca_msg_book1_3_15_cutscene07_img@@<br>La prossima curva richiede l'uso di una manovra a 'ingresso allungato'. Questa è la tecnica preferibile, perché non apre la corsia dietro di te a un automobilista disattento per intrufolarsi a destra. Usala sempre quando hai abbastanza spazio nella strada dove stai girando."

	key[]: "aca_msg_book1_3_15_cutscene08"
	val[]: "Portati avanti nell'incrocio e svolta rapidamente e bruscamente a destra."

	key[]: "aca_msg_book1_3_15_cutscene09"
	val[]: "Avvicinandoti all'ostacolo, puoi raddrizzarti e tenerti sulla sinistra nella tua corsia.<br>Tutto questo serve a mantenere le ruote del rimorchio distanti dal cordolo."

	key[]: "aca_msg_book1_3_15_cutscene10"
	val[]: "Continua verso la prossima curva."

	key[]: "aca_msg_book1_3_15_cutscene11"
	val[]: "Di nuovo, tieniti verso il centro della strada per mantenere le ruote del rimorchio distanti dal cordolo."

	key[]: "aca_msg_book1_3_15_cutscene12"
	val[]: "La curva qui davanti è particolarmente problematica. In casi come questo non avrai le condizioni ideali per una manovra a ingresso allargato o a ingresso allungato, e dovrai combinarle insieme per raggiungere il punto desiderato."

	key[]: "aca_msg_book1_3_15_cutscene13"
	val[]: "Allarga la traiettoria prima della svolta, vai avanti nell'incrocio e poi sterza rapidamente. Anche in questo caso, è bene stare il più vicino possibile all'ostacolo per mantenere la svolta il più ampia possibile."

	key[]: "aca_msg_book1_3_15_cutscene14"
	val[]: "Park in the designated area, secure the truck and shut down the engine."

	# Book 1 Scenario 3_15 formatting
#!{
	key[]: "aca_msg_book1_3_15_cutscene02_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/jug_handle.mat bottom=p256 right=p256 color=FFFFFFFF></align><offset vshift=256>"

	key[]: "aca_msg_book1_3_15_cutscene07_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/button_hook.mat bottom=p256 right=p256 color=FFFFFFFF></align><offset vshift=256>"

#!}


#### 3_15 Driving Instructions

	key[]: "aca_msg_book1_3_15_forward"
	val[]: "Ricordati di usare tutto lo spazio a disposizione per aiutarti ad affrontare ciascuna curva.<br><br><font face=/font/big_bold.font>Parti e segui la segnaletica orizzontale a sinistra. </font>"

	key[]: "aca_msg_book1_3_15_check1"
	val[]: "Usa tutto lo spazio disponibile per girare largo e mantenere il rimorchio distante dal cordolo all'interno.<br><br><font face=/font/big_bold.font>Effettua una manovra a ingresso allargato. </font>"

	key[]: "aca_msg_book1_3_15_check2"
	val[]: "Tieniti verso il centro della strada lungo la curva, poi continua dritto verso la prossima curva.<br><br><font face=/font/big_bold.font>Continua a guidare. </font>"

	key[]: "aca_msg_book1_3_15_check3"
	val[]: "Lo spazio a sinistra è limitato, quindi dovrai andare molto più avanti nell'incrocio per mantenere il rimorchio fuori dal cordolo.<br><br><font face=/font/big_bold.font>Effettua una manovra a ingresso allungato. </font>"

	key[]: "aca_msg_book1_3_15_check4"
	val[]: "Guida in avanti verso la prossima curva.<br><br><font face=/font/big_bold.font>Continua a guidare. </font>"

	key[]: "aca_msg_book1_3_15_check5"
	val[]: "Questa curva è la più stretta che abbiamo visto finora, e nessuna manovra da sola sarà sufficiente.<br><br><font face=/font/big_bold.font>Fai la curva, tieniti il più largo possibile.</font>"

	key[]: "aca_msg_book1_3_15_check6"
	val[]: "<font face=/font/big_bold.font>Procedi verso il parcheggio più avanti a destra. </font>"
#!{
	key[]: "aca_msg_book1_3_15_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_15_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_15_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}


#@}

#+ Book 1 Scenario 3_16
#@{

#### 3_16 common
	key[]: "aca_scenario_book1_3_16_title"
	val[]: "Parcheggio in Diagonale in Retromarcia"

	key[]: "aca_scenario_book1_3_16_desc"
	val[]: "In questo scenario, vedremo come parcheggiare in diagonale in retromarcia. Questo può succedere in aree di servizio, aree di sosta e addirittura nelle aziende. Spesso, c'è poco spazio perché le aree sono affollate di camion, perciò il parcheggio è ancora più difficile per la mancanza di spazio."

#### 3_16 goal

	key[]: "aca_goal_book1_3_16_check1"
	val[]: "Girare il Rimorchio"
#!{
	key[]: "aca_goal_book1_3_16_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_16_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_16_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_16_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
 #!}
#### 3_16 msg - intro text

	key[]: "aca_msg_book1_3_16_cutscene1"
	val[]: "A prima vista, il parcheggio in diagonale sembra facile, ma spesso è più difficoltoso delle tipiche manovre in retromarcia."

	key[]: "aca_msg_book1_3_16_cutscene2"
	val[]: "Fai retromarcia verso il parcheggio. Mantieni dritti trattore e rimorchio per ora."

	key[]: "aca_msg_book1_3_16_cutscene3"
	val[]: "Man mano che ti avvicini, lascia che il rimorchio vada più vicino ai camion parcheggiati. Questo ti aiuterà a girarlo nel parcheggio quando lo raggiungerai."

	key[]: "aca_msg_book1_3_16_cutscene4"
	val[]: "Inizia a girare il rimorchio nel parcheggio. Mantieni il rimorchio vicino al camion dal lato di guida, perché ti servirà spazio dall'altro lato."

	key[]: "aca_msg_book1_3_16_cutscene5"
	val[]: "Una volta che il rimorchio è ben posizionato nel parcheggio, inizia a girare il trattore per seguire il rimorchio."

	key[]: "aca_msg_book1_3_16_cutscene6"
	val[]: "Parcheggia nell'area designata, assicura il camion e spegni il motore."

#### 3_16 Driving Instructions

	key[]: "aca_msg_book1_3_16_start"
	val[]: "Parcheggia il camion nello spazio dietro di te. Usa entrambi gli specchietti per orientarti mentre fai retromarcia.<br><br><font face=/font/big_bold.font>Preparati a partire. </font>"

	key[]: "aca_msg_book1_3_16_backward"
	val[]: "Controlla i dintorni, poi dirigiti verso il parcheggio.<br><br><font face=/font/big_bold.font>Inizia la retromarcia.</font>"

	key[]: "aca_msg_book1_3_16_check1"
	val[]: "Inizia a muovere il rimorchio verso i camion di fianco a te. Quando sei pronto, gira il rimorchio nel parcheggio. Ricordati di considerare l'ingombro posteriore del rimorchio.<br><br><font face=/font/big_bold.font>Gira nel parcheggio. </font>"
#!{
	key[]: "aca_msg_book1_3_16_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_16_end"
	val[]: "@@aca_msg_book1_2_01_end@@"


 #!}


#@}

#+ Book 1 Scenario 3_17
#@{

#### 3_17 common
	key[]: "aca_scenario_book1_3_17_title"
	val[]: "Retromarcia in una Curva"

	key[]: "aca_scenario_book1_3_17_desc"
	val[]: "In questo scenario, faremo retromarcia con un rimorchio in una curva per la prima volta. Esploreremo i principi di base della retromarcia e cosa guardare sterzando in retromarcia."

#### 3_17 goal

	key[]: "aca_goal_book1_3_17_check1"
	val[]: "Girare il Rimorchio"
#!{
	key[]: "aca_goal_book1_3_17_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_17_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_17_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_17_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
 #!}
#### 3_17 msg - intro text

	key[]: "aca_msg_book1_3_17_cutscene01"
	val[]: "In questo scenario dovrai fare retromarcia nel parcheggio dietro di te, dal lato di guida."

	key[]: "aca_msg_book1_3_17_cutscene02"
	val[]: "Ci sono alcuni suggerimenti da ricordare, che ti aiuteranno molto nella retromarcia con i rimorchi. <br>Il primo è che il rimorchio vorrà sempre girare nella direzione opposta rispetto a dove giri il trattore."

	key[]: "aca_msg_book1_3_17_cutscene03"
	val[]: "Il secondo è che si può avere un'idea di dove vada il rimorchio guardando gli assi di camion e rimorchio."

	key[]: "aca_msg_book1_3_17_cutscene04"
	val[]: "Terzo, piccoli movimenti ti porteranno dove devi andare, non c'è bisogno di esagerare."

	key[]: "aca_msg_book1_3_17_cutscene05"
	val[]: "Inizia a dirigere il trattore un po' lontano dal parcheggio, e il rimorchio inizierà a puntare verso di esso."

	key[]: "aca_msg_book1_3_17_cutscene06"
	val[]: "Segui il rimorchio, aggiustandolo in manovra per mantenerlo al posto giusto."

	key[]: "aca_msg_book1_3_17_cutscene07"
	val[]: "Guarda le ruote del rimorchio e le ruote posteriori del trattore. Ti diranno dove il rimorchio sta puntando, e dove il trattore lo sta portando."

	key[]: "aca_msg_book1_3_17_cutscene08"
	val[]: "Un quarto suggerimento è che è sempre più facile girare il rimorchio più marcatamente del dovuto rispetto al cercare di raddrizzarlo da un intraversamento. Punta all'uscita del parcheggio finché non sei più vicino, poi potrai girare un po' di più per allineare il rimorchio."

	key[]: "aca_msg_book1_3_17_cutscene09"
	val[]: "Mentre il rimorchio entra nel parcheggio, porta il trattore davanti al rimorchio. Cerca di evitare troppe correzioni nell'area."

	key[]: "aca_msg_book1_3_17_cutscene10"
	val[]: "Fai retromarcia tra le barriere, controlla entrambi i lati mentre vai."

	key[]: "aca_msg_book1_3_17_cutscene11"
	val[]: "Posteggia il camion e spegni il motore."

#### 3_17 Driving Instructions

	key[]: "aca_msg_book1_3_17_start"
	val[]: "Ricorda questi suggerimenti mentre fai retromarcia in curva con un rimorchio:<br><br>— Il rimorchio gira nella direzione opposta a dove giri il trattore<br><br>— Controlla le ruote del rimorchio per vedere dove punta<br><br>— Controlla le ruote posteriori del trattore per vedere dove porta il rimorchio<br><br>— Lascia che il rimorchio faccia il lavoro, non esagerare con lo sterzo<br><br>— È sempre più facile girare bruscamente il rimorchio che raddrizzarlo<br><br><font face=/font/big_bold.font>Preparati a partire. </font>"

	key[]: "aca_msg_book1_3_17_backward"
	val[]: "Guarda dietro di te per vedere dove devi andare. Controlla sempre i dintorni prima di iniziare la retromarcia.<br><br><font face=/font/big_bold.font>Inizia la retromarcia verso il parcheggio.</font>"

	key[]: "aca_msg_book1_3_17_check1"
	val[]: "<font face=/font/big_bold.font>Inizia a girare il rimorchio verso il parcheggio e seguilo.</font>"

	key[]: "aca_msg_book1_3_17_stop"
	val[]: "<font face=/font/big_bold.font>Fermati nell'area designata. </font>"
#!{
	key[]: "aca_msg_book1_3_17_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_18
#@{

#### 3_18 common
	key[]: "aca_scenario_book1_3_18_title"
	val[]: "Manovra di parcheggio nel vicolo"

	key[]: "aca_scenario_book1_3_18_desc"
	val[]: "In questo scenario ti verrà richiesto di effettuare la retromarcia del rimorchio in un vicolo che si dirama da una strada stretta."

#### 3_18 goal

	key[]: "aca_goal_book1_3_18_check1"
	val[]: "Girare il Rimorchio"
#!{
	key[]: "aca_goal_book1_3_18_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_18_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


	key[]: "aca_goal_book1_3_18_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_18_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

 #!}
#### 3_18 msg - intro text

	key[]: "aca_msg_book1_3_18_cutscene01"
	val[]: "Parcheggiare qui richiede una manovra di parcheggio in retromarcia.<br>Questa è una tipica manovra per i camionisti che la devono affrontare più o meno quotidianamente nella loro carriera, sia per caricare o scaricare un rimorchio che per parcheggiare per la notte in un'area di parcheggio."

	key[]: "aca_msg_book1_3_18_cutscene02"
	val[]: "Questa manovra è simile a quella dello scenario precedente, ma avrai meno spazio per lavorare, per cui dovrai pianificare le tue mosse di conseguenza e fare attenzione a non colpire qualcosa."

	key[]: "aca_msg_book1_3_18_cutscene03"
	val[]: "Essendoci meno spazio, il tempismo è ancora più importante. Sterza il rimorchio al momento giusto, guardando le ruote di trattore e rimorchio per vedere dove stai andando. Tieni a mente l'ingombro posteriore e ricordati di non intraversare - continua a spingere il rimorchio."

	key[]: "aca_msg_book1_3_18_cutscene04"
	val[]: "Cerca di indirizzare il rimorchio verso il vicolo in anticipo piuttosto che in ritardo. Questo ti darà spazio dall'altro lato per girare l'avantreno del rimorchio e portare il trattore davanti a esso."

	key[]: "aca_msg_book1_3_18_cutscene05"
	val[]: "Una volta che il rimorchio è nel vicolo, porta il trattore davanti a esso. È meglio farlo un po' prima di quanto direbbe il tuo istinto. Puoi sempre apportare correzioni mentre fai retromarcia verso la posizione finale."

	key[]: "aca_msg_book1_3_18_cutscene06"
	val[]: "Raddrizza il trattore e il rimorchio, e fermati nell'area designata."

	key[]: "aca_msg_book1_3_18_cutscene07"
	val[]: "Posteggia il camion e spegni il motore."


#### 3_18 Driving Instructions

	key[]: "aca_msg_book1_3_18_start"
	val[]: "Ora proveremo a girare un rimorchio in un'area più piccola con una manovra in retromarcia. <br><br><font face=/font/big_bold.font>Preparati a partire. </font>"

	key[]: "aca_msg_book1_3_18_backward"
	val[]: "Controlla i dintorni e mira al parcheggio dietro di te. <br><br><font face=/font/big_bold.font>Inizia la retromarcia verso il parcheggio. </font>"

	key[]: "aca_msg_book1_3_18_check1"
	val[]: "<font face=/font/big_bold.font>Gira il rimorchio nel parcheggio. </font>"
#!{
	key[]: "aca_msg_book1_3_18_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_18_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}


#@}

#+ Book 1 Scenario 3_19
#@{

#### 3_19 common
	key[]: "aca_scenario_book1_3_19_title"
	val[]: "Esame Finale (Parte 1)"

	key[]: "aca_scenario_book1_3_19_desc"
	val[]: "Ti aspetta l'esame finale, dove tutte le abilità che hai imparato dagli scenari precedenti verranno messe alla prova. Guideremo lungo l'intero centro di addestramento per vedere quanto bene hai imparato le situazioni che hai incontrato finora.<br><br>Una volta completate tutte le sezioni e le manovre, sarai un passo più vicino a considerarti un abile camionista!"

