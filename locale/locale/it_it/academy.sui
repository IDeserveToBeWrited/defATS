	key[]: "aca_goal_book3_double_90_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}

#### double_90 intro

	key[]: "aca_msg_book3_double_90_cutscene01"
	val[]: "Il percorso qui davanti ti aiuterà a familiarizzare con le manovre con rimorchi doppi attraverso curve a 90 gradi di varie difficoltà."

	key[]: "aca_msg_book3_double_90_cutscene02"
	val[]: "Le prime curve sono abbastanza ampie, con molto spazio. Usale per una prima idea di come si comportano i rimorchi in curva."

	key[]: "aca_msg_book3_double_90_cutscene03"
	val[]: "D'ora in avanti, le curve si faranno più strette e tecniche. Affrontale lentamente e assicurati di lasciare abbastanza spazio nelle curve perché i rimorchi possano seguire l'angolo dietro di te."

	key[]: "aca_msg_book3_double_90_cutscene04"
	val[]: "Questa è una delle curve più strette del percorso. Utilizzare il piccolo spazio sulla destra può aiutarti a portare i rimorchi oltre quei fastidiosi coni all'interno."

	key[]: "aca_msg_book3_double_90_cutscene05"
	val[]: "Dovresti sempre tenere in mente la prossima curva - quando esci da una curva, pianifica la preparazione della successiva."

	key[]: "aca_msg_book3_double_90_cutscene06"
	val[]: "Presta sempre attenzione ai rimorchi finché non sono liberi da ogni ostacolo."

#### double_90 driving instructions

#!{
	key[]: "aca_msg_book3_double_90_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_double_90_forward"
	val[]: "Procedi in avanti verso la prima curva."

	key[]: "aca_msg_book3_double_90_check1"
	val[]: "Presta attenzione agli specchietti mentre vai, per capire dove vanno i rimorchi dietro di te."

	key[]: "aca_msg_book3_double_90_check2"
	val[]: "Tieniti largo prima di ogni curva, è cruciale per darti lo spazio necessario per far girare i rimorchi in curva."

	key[]: "aca_msg_book3_double_90_check3"
	val[]: "L'assetto per le prossime curve è cruciale, perché ti aspetta una curva molto stretta. Un errore all'inizio potrebbe costarti anche alla fine.<br><br>Vai lentamente e con cura, e presta attenzione ai dintorni."

	key[]: "aca_msg_book3_double_90_check4"
	val[]: "Questa curva è molto stretta, e porta direttamente a un'altra curva stretta. Non dovrai solo considerare come entri nella curva, ma anche come ci esci e ti prepari per la successiva."

	key[]: "aca_msg_book3_double_90_check5"
	val[]: "Continua a guidare nelle ultime curve verso l'area designata."

#!{
	key[]: "aca_msg_book3_double_90_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_double_90_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


#+ Book 3 Scenario justb
#@{

#### justb common
	key[]: "aca_scenario_book3_justb_title"
	val[]: "Prima Retromarcia"

	key[]: "aca_scenario_book3_justb_desc"
	val[]: "In questo scenario, guideremo una combinazione a rimorchio doppio in retromarcia per la prima volta."

#### justb goal

#!{
	key[]: "aca_goal_book3_justb_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_justb_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
	key[]: "aca_goal_book3_justb_check1"
	val[]: "Tranquillo, Non ti Preoccupare"

#!{
	key[]: "aca_goal_book3_justb_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_justb_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### justb msg - intro text

	key[]: "aca_msg_book3_justb_cutscene1"
	val[]: "La retromarcia con rimorchi doppi richiede un nuovo modo di pensare a ciò che stai facendo. Anziché manovrare semplicemente un rimorchio, ora stai usando il rimorchio di testa per girare quello di coda. <br><br> Usa questo scenario per farti un'idea di come funziona. Non c'è un obiettivo specifico, prenditi tutto il tempo che ti serve e cerca di capire cosa succede."

	key[]: "aca_msg_book3_justb_cutscene2"
	val[]: "Da una posizione diritta, puoi girare il tuo camion nella stessa direzione dove vuoi far andare il rimorchio di coda. <br><br>Non esagerare; devi solo puntare il rimorchio di coda nella direzione dove vuoi andare, poi allineare il trattore con il rimorchio di testa e lasciare che la coda faccia il suo."

	key[]: "aca_msg_book3_justb_cutscene3"
	val[]: "Quando il rimorchio di coda va dove deve andare, puoi sterzare il rimorchio di testa per seguire la stessa direzione. <br><br>Una volta che la testa segue la coda, usa il trattore per correggere l'angolo tra i due rimorchi per fare una curva più stretta o ampia."

	key[]: "aca_msg_book3_justb_cutscene4"
	val[]: "Non c'è una formula esatta per farlo bene, devi solo fare attenzione a quello che succede, imparare dagli errori e continuare a fare pratica. <br><br>Quando sei soddisfatti, puoi andare nell'area designata e posteggiare il veicolo. <br><br>Sentiti libero di passare tutto il tempo che vuoi a sperimentare."

#### justb Driving Instructions

#!{
	key[]: "aca_msg_book3_justb_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_justb_forward"
	val[]: "Inizia la retromarcia con calma. Ricordati di cominciare con piccoli movimenti, non c'è bisogno di intraversare il rimorchio subito.<br><br>Cerca di andare dritto, o di portare i rimorchi verso il lato di guida."

	key[]: "aca_msg_book3_justb_check1"
	val[]: "Prenditi il tuo tempo e non agitarti. <br><br>Ogni maestro è stato un apprendista."

#!{
	key[]: "aca_msg_book3_justb_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_justb_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}

#+ Book 3 Scenario justc
#@{

#### justc common
	key[]: "aca_scenario_book3_justc_title"
	val[]: "Correzione Prima Retromarcia"

	key[]: "aca_scenario_book3_justc_desc"
	val[]: "In questo scenario, dovremmo terminare quello che qualcuno ha già iniziato."

#### justc goal

#!{
	key[]: "aca_goal_book3_justc_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_justc_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
	key[]: "aca_goal_book3_justc_check1"
	val[]: "Retromarcia"

#!{
	key[]: "aca_goal_book3_justc_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_justc_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### justc msg - intro text

	key[]: "aca_msg_book3_justc_cutscene1"
	val[]: "Oh oh! Qualcuno si è stufato durante una retromarcia e ha lasciato il camion in mezzo al parcheggio."

	key[]: "aca_msg_book3_justc_cutscene2"
	val[]: "Ci saranno inevitabilmente dei momenti in cui farai un disastro. Non preoccuparti, vai avanti per disincastrare i rimorchi finché non sei in una situazione risolvibile. <br><br>Se non sei sicuro, cerca di raddrizzare la combinazione per ripartire da capo."

	key[]: "aca_msg_book3_justc_cutscene3"
	val[]: "Questa è una buona posizione da cui partire. Il rimorchio di coda è ancora puntato dove vogliamo farlo andare, e possiamo portare rapidamente il trattore davanti alla testa per iniziare a girare la combinazione dove vogliamo."

	key[]: "aca_msg_book3_justc_cutscene4"
	val[]: "procedi verso l'area designata e assicura il camion. <br><br>Di nuovo, puoi fare pratica con questo scenario finché non sei a tuo agio manovrando i rimorchi."

#### justc Driving Instructions

#!{
	key[]: "aca_msg_book3_justc_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_justc_forward"
	val[]: "Non c'è via d'uscita da questo pasticcio. Vai avanti per avere una situazione gestibile."

	key[]: "aca_msg_book3_justc_check1"
	val[]: "Inizia la retromarcia."

#!{
	key[]: "aca_msg_book3_justc_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_justc_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


#+ Straight Backing
#@{

#### straight_backing common

	key[]: "aca_scenario_book3_straight_backing_title"
	val[]: "Retromarcia Diritta"

	key[]: "aca_scenario_book3_straight_backing_desc"
	val[]: "In questo scenario, dovrai fare retromarcia con un insieme di rimorchi doppi in una linea retta."

#### straight_backing goal

#!{
	key[]: "aca_goal_book3_straight_backing_start"
	val[]: "@@aca_goal_book3_sup_start@@"
#!}
	key[]: "aca_goal_book3_straight_backing_forward"
	val[]: "Retromarcia"

#!{
	key[]: "aca_goal_book3_straight_backing_check1"
	val[]: "@@aca_goal_book3_sup_check1@@"

	key[]: "aca_goal_book3_straight_backing_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_straight_backing_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### straight_backing - intro text

	key[]: "aca_msg_book3_straight_backing_cutscene01"
	val[]: "La retromarcia diritta sembra facile al primo sguardo, ma in realtà è molto più difficile. <br><br>Anziché semplicemente aumentare o diminuire l'angolo tra i rimorchi da un lato, ora devi gestire entrambi i lati per mantenere la combinazione diritta."

	key[]: "aca_msg_book3_straight_backing_cutscene02"
	val[]: "Inizia con correzioni relativamente leggere. Va bene anche se fai zig zag da entrambe le parti, ma tieni in mente che dovrai mantenere l'angolo tra camion e rimorchio di testa un po' più a lungo per cambiare quello tra testa e coda."

	key[]: "aca_msg_book3_straight_backing_cutscene03"
	val[]: "Avrai bisogno di fare manovre abbastanza ampie con il trattore per mantenere il rimorchio di coda puntato dove vuoi farlo andare, cerca solo di non esagerare all'inizio e non ti servirà farlo."

	key[]: "aca_msg_book3_straight_backing_cutscene04"
	val[]: "Puoi tornare in avanti per correggerti tutte le volte che ti serve. Finché finisci in maniera sicura nel parcheggio, il resto non conta."

#### Straight Backing Driving Instructions

#!{
	key[]: "aca_msg_book3_straight_backing_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_straight_backing_forward"
	val[]: "Inizia a indietreggiare dolcemente."

#!{
	key[]: "aca_msg_book3_straight_backing_check1"
	val[]: "@@aca_msg_book3_sup_check1@@"
#!}
	key[]: "aca_msg_book3_straight_backing_stop"
	val[]: "Raddrizzati e fermati nell'area designata."

	key[]: "aca_msg_book3_straight_backing_end"
	val[]: "Posteggia il veicolo e spegni il motore."

#@}


#+ Correcting Straight Backing
#@{

#### correcting_straight_backing common

	key[]: "aca_scenario_book3_correcting_straight_backing_title"
	val[]: "Correzione Retromarcia Diritta"

	key[]: "aca_scenario_book3_correcting_straight_backing_desc"
	val[]: "In questo scenario, prenderai il volante dopo che qualcun altro ha già tentato una retromarcia diritta. Correggi il suo errore e parcheggia il camion nell'area designata."

#### correcting_straight_backing goal

#!{
	key[]: "aca_goal_book3_correcting_straight_backing_start"
	val[]: "@@aca_goal_book3_sup_start@@"
#!}
	key[]: "aca_goal_book3_correcting_straight_backing_forward"
	val[]: "Raddrizzarsi"

	key[]: "aca_goal_book3_correcting_straight_backing_check1"
	val[]: "Retromarcia"

#!{
	key[]: "aca_goal_book3_correcting_straight_backing_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_correcting_straight_backing_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### correcting_straight_backing - intro text

	key[]: "aca_msg_book3_correcting_straight_cutscene01"
	val[]: "Qualcuno ha cercato di parcheggiare questa combinazione con una retromarcia dritta e ha avuto qualche problema. Ora tocca a te rimediare!"

	key[]: "aca_msg_book3_correcting_straight_cutscene02"
	val[]: "Il primo passo è quello di andare avanti e portarci in una situazione gestibile. È cruciale avere il rimorchio di coda puntato dove vuoi farlo andare."

	key[]: "aca_msg_book3_correcting_straight_cutscene03"
	val[]: "In questo caso, abbiamo scelto di andare più verso il lato di guida. Questo ci darà una visuale migliore di ciò che facciamo in retromarcia, lasciandoci concentrare su un lato. <br><br>Ricordati, stai sterzando il rimorchio di coda con la testa, quindi lascia perdere il trattore."

	key[]: "aca_msg_book3_correcting_straight_cutscene04"
	val[]: "La combinazione è più o meno dove vogliamo, ma andiamo di nuovo avanti per centrarla a dovere."

	key[]: "aca_msg_book3_correcting_straight_cutscene05"
	val[]: "Da qui, faremo delicatamente retromarcia verso il posteggio, assicurandoci che il rimorchio di coda rimanga al suo posto."

	key[]: "aca_msg_book3_correcting_straight_cutscene06"
	val[]: "Ora possiamo allineare il rimorchio di testa e il trattore."

#### correcting_Straight_Backing Driving Instructions

#!{
	key[]: "aca_msg_book3_correcting_straight_backing_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_correcting_straight_backing_forward"
	val[]: "Vai avanti e raddrizza tutto. <br><br>Quando sei soddisfatto, fai retromarcia nell'area designata."

	key[]: "aca_msg_book3_correcting_straight_backing_check1"
	val[]: "Fai retromarcia verso l'area designata."

#!{
	key[]: "aca_msg_book3_correcting_straight_backing_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"
#!}
	key[]: "aca_msg_book3_correcting_straight_backing_end"
	val[]: "Posteggia il veicolo e spegni il motore."

#@}


#+ Book 3 Scenario backing_90_tight
#@{

#### backing_90_tight common
	key[]: "aca_scenario_book3_backing_90_tight_title"
	val[]: "Retromarcia a 90 gradi"

	key[]: "aca_scenario_book3_backing_90_tight_desc"
	val[]: "In questo scenario, dovrai effettuare una manovra di retromarcia a 90 gradi per parcheggiare tra una fila di altri camion."

#### backing_90_tight goal

	key[]: "aca_goal_book3_backing_90_tight_check1"
	val[]: "Inversione a U"

	key[]: "aca_goal_book3_backing_90_tight_check2"
	val[]: "Partire"

		key[]: "aca_goal_book3_backing_90_tight_check3"
	val[]: "Reversing"

#!{
		key[]: "aca_goal_book3_backing_90_tight_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_backing_90_tight_end"
	val[]: "@@aca_goal_book3_sup_end@@"

	key[]: "aca_goal_book3_backing_90_tight_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_backing_90_tight_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
#### backing_90_tight msg - intro text

	key[]: "aca_msg_book3_backing_90_tight_cutscene1"
	val[]: "Fare retromarcia di lato è più facile con i rimorchi doppi, poiché fuori dal finestrino avrai un punto di osservazione più chiaro di tutto ciò che accade."

	key[]: "aca_msg_book3_backing_90_tight_cutscene2"
	val[]: "Per iniziare, vai avanti e fai un'inversione a U alla fine della fila. Questo ti permetterà di prepararti dal lato giusto, e di vedere meglio le cose che restano fuori dal finestrino lato guida."

	key[]: "aca_msg_book3_backing_90_tight_cutscene3"
	val[]: "Puoi decidere di impostare i rimorchi come preferisci, possibilmente con il rimorchio di coda che già punta il parcheggio. In questo caso, partiremo da una posizione diritta. <br><br>Ricordati di non complicarti la vita - gira il rimorchio di coda con quello di testa."

	key[]: "aca_msg_book3_backing_90_tight_cutscene4"
	val[]: "Gira il rimorchio di testa leggermente all'opposto del parcheggio, e quello di coda inizierà a puntare nella direzione giusta. Da lì, regola l'angolo tra testa e coda per mantenere un arco bello e liscio fino al parcheggio."

	key[]: "aca_msg_book3_backing_90_tight_cutscene5"
	val[]: "Ricorda: se il rimorchio di coda entra troppo stretto, dovrai in qualche modo raddrizzare l'angolo della combinazione. Se va troppo largo, dovrai stringere l'angolo."

	key[]: "aca_msg_book3_backing_90_tight_cutscene6"
	val[]: "Le correzioni che fai col trattore hanno un effetto dimezzato sul rimorchio di coda rispetto a quello di testa, perciò non avere paura di far lavorare il trattore."

	key[]: "aca_msg_book3_backing_90_tight_cutscene7"
	val[]: "A questo punto, devi iniziare a pianificare. Devi far entrare nel parcheggio anche il rimorchio di testa, perciò escogita un piano per metterlo esattamente di fronte alla coda."

	key[]: "aca_msg_book3_backing_90_tight_cutscene8"
	val[]: "È molto raro riuscire a far entrare i rimorchi al primo tentativo. In questo caso, abbiamo aspettato troppo a raddrizzare la testa, e ora la coda sta scappando fuori. <br><br>Nessun problema, vai avanti e riprova."

	key[]: "aca_msg_book3_backing_90_tight_cutscene9"
	val[]: "Fai lavorare quel volante, e porta quei rimorchi dove devi. Puoi andare avanti per tutte le volte che ti servono, finché non sei soddisfatto."

	key[]: "aca_msg_book3_backing_90_tight_cutscene10"
	val[]: "E proprio così, abbiamo parcheggiato con successo i rimorchi doppi."

#### backing_90_tight Driving Instructions

#!{
	key[]: "aca_msg_book3_backing_90_tight_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_backing_90_tight_forward"
	val[]: "Vai avanti fino alla fine del parcheggio e girati."

	key[]: "aca_msg_book3_backing_90_tight_check1"
	val[]: "Ricordati di fare una curva ampia."

	key[]: "aca_msg_book3_backing_90_tight_check2"
	val[]: "Prosegui finché non credi di avere abbastanza spazio di manovra, poi inizia la retromarcia."

	key[]: "aca_msg_book3_backing_90_tight_check3"
	val[]: "Reverse into the parking spot."

#!{
	key[]: "aca_msg_book3_backing_90_tight_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_backing_90_tight_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


