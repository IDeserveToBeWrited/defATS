#+ Book 1 Scenario 3_04
#@{

#### 3_04 common
	key[]: "aca_scenario_book1_3_04_title"
	val[]: "Corso di guida avanzato - rimorchio"

	key[]: "aca_scenario_book1_3_04_desc"
	val[]: "Nello scenario finale del Capitolo 3, guideremo lungo un percorso addestrativo più lungo con varie curve differenti, per vedere quanto bene hai imparato a manovrare con un rimorchio."

#### 3_04 goal



	key[]: "aca_goal_book1_3_04_check1"
	val[]: "Easy Turns"

	key[]: "aca_goal_book1_3_04_check2"
	val[]: "Curva Semplice a 90 Gradi"

	key[]: "aca_goal_book1_3_04_check3"
	val[]: "Affrontare un doppio tornante"

	key[]: "aca_goal_book1_3_04_check4"
	val[]: "Uscire da un doppio tornante"

	key[]: "aca_goal_book1_3_04_check5"
	val[]: "Sezione stretta"

	key[]: "aca_goal_book1_3_04_check6"
	val[]: "Curva Semplice a 90 Gradi"

	key[]: "aca_goal_book1_3_04_check7"
	val[]: "Tornante stretto"

	key[]: "aca_goal_book1_3_04_check8"
	val[]: "Curva Stretta a 90 gradi"

	key[]: "aca_goal_book1_3_04_check9"
	val[]: "Tornante complesso"

	key[]: "aca_goal_book1_3_04_check10"
	val[]: "Final Turn"

	key[]: "aca_goal_book1_3_04_check11"
	val[]: "Procedere verso l'area designata"
