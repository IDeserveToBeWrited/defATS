#+ Book 1 Scenario 1_02
#@{

#### 1_02 common

	key[]: "aca_scenario_book1_1_02_title"
	val[]: "Controlli della Telecamera"

	key[]: "aca_scenario_book1_1_02_desc"
	val[]: "In questo scenario impareremo i vari tipi di telecamera disponibili, e come ti possono aiutare a controllare e manovrare il camion."

#### 1_02 goal

	key[]: "aca_goal_book1_1_02_seat"
	val[]: "Posizione del Sedile"

	key[]: "aca_goal_book1_1_02_look_back"
	val[]: "Visuale Posteriore"

	key[]: "aca_goal_book1_1_02_mirrors"
	val[]: "Controllo degli Specchietti"

	key[]: "aca_goal_book1_1_02_cam_behind"
	val[]: "Passa alla Telecamera Esterna"

	key[]: "aca_goal_book1_1_02_look_around"
	val[]: "Guarda Intorno al Camion"


#### 1_02 msg - intro text

	key[]: "aca_msg_book1_1_02_cutscene1"
	val[]: "In questo scenario, vedremo le varie telecamere<br>disponibili all'uso."

	key[]: "aca_msg_book1_1_02_cutscene2"
	val[]: "C'è un totale di sette telecamere tra cui scegliere, ora ne vedremo alcune<br> e spiegheremo le loro funzioni previste."

	key[]: "aca_msg_book1_1_02_cutscene3"
	val[]: "Le varie telecamere e le loro differenti angolazioni ti potranno aiutare nelle manovre in spazi ristretti."


#### 1_02 Driving Instructions

	key[]: "aca_msg_book1_1_02_seat"
	val[]: "Guardare dove stai andando è la base per una guida sicura e professionale. Se l'attuale posizione del sedile non ti soddisfa, puoi modificarla in '@@adjust_link_t@@' (Accedi dal menu di pausa).<br><br><font face=/font/big_bold.font>Conferma di essere pronto con @@imv_nrm_activate@@. </font>"

	key[]: "aca_msg_book1_1_02_look_back"
	val[]: "In retromarcia, gli specchietti non offrono sempre una visuale chiara. Potrebbe essere necessario guardare dietro di te, fuori dal finestrino.<br><br><font face=/font/big_bold.font>Gira la visuale verso il lato del guidatore per guardare fuori dal finestrino verso il retro del rimorchio.</font>@@aca_goal_tip@@ Devi essere all'interno del veicolo."

	key[]: "aca_msg_book1_1_02_mirrors"
	val[]: "Usa questa visuale per controllare il rimorchio durante la retromarcia con un rimorchio. È sempre meglio ritornare al lato del guidatore per utilizzare questa visuale. Spostandosi sul lato del passeggero, avrai una vista molto più limitata di quello che succede dietro di te.<br><br><font face=/font/big_bold.font>Guarda verso il lato del passeggero. </font>"

	key[]: "aca_msg_book1_1_02_cam_behind"
	val[]: "Ecco perché non è raccomandato fare retromarcia verso il lato del passeggero; puoi notare come la visuale sia abbastanza limitata. Per fortuna, ci sono anche sette telecamere esterne disponibili per te. <br><br>Puoi utilizzare il pulsante @@imv_nrm_camcycle@@ per passare alla telecamera successiva nella sequenza. Dopo aver ciclato tutte le sette telecamere, ritornerai all'inizio del ciclo. <br><br><font face=/font/big_bold.font>Premi @@imv_nrm_camcycle@@ per passare alla telecamera successiva. </font>"

	key[]: "aca_msg_book1_1_02_look_around"
	val[]: "La visuale esterna fornisce la prospettiva migliore su ciò che succede intorno al camion.<br><br><font face=/font/big_bold.font>Guarda intorno al camion.</font>"

	key[]: "aca_msg_book1_1_02_cam_top"
	val[]: "<font face=/font/big_bold.font>Premendo di nuovo @@imv_nrm_camcycle@@, puoi passare alla telecamera successiva. </font>"

	key[]: "aca_msg_book1_1_02_cam_cabin"
	val[]: "La visuale dall'alto fornisce un'ottima vista della situazione intorno al camion, semplificando in maniera significativa la guida e il parcheggio negli spazi stretti.<br><br><font face=/font/big_bold.font>Premi @@imv_nrm_camcycle@@ per passare alla telecamera successiva.  </font>"

	key[]: "aca_msg_book1_1_02_cam_window"
	val[]: "La visuale dal tetto fornisce una visuale chiara della strada davanti al camion senza troppi ostacoli.<br><br><font face=/font/big_bold.font>Premi @@imv_nrm_camcycle@@ per passare all'ultima telecamera che guarderemo per ora.</font>"

	key[]: "aca_msg_book1_1_02_cam_interior"
	val[]: "La visuale da dietro è una scorciatoia per la visuale che hai ottenuto in precedenza girando la visuale dall'abitacolo. Come già detto, è utile in retromarcia o in parcheggio.<br><br>Nel gioco, abbiamo più telecamere che puoi provare premendo ripetutamente @@imv_nrm_camcycle@@.<br><br><font face=/font/big_bold.font>Premi @@imv_nrm_cam1@@ per ritornare alla visuale dall'abitacolo.</font>"

	key[]: "aca_msg_book1_1_02_end"
	val[]: "For an authentic driving school experience, we recommend staying with the 'Interior Camera' view as you go through each of the scenarios.<br><br><font face=/font/big_bold.font>Press @@imv_nrm_activate@@ to confirm and end the scenario.</font>@@aca_goal_tip@@ You can use the @@o_im_cam_zoom@@ feature for a better view of your surroundings. It's especially helpful when looking through the mirrors. Check the Options Screen - '@@options_bindings_screen@@' - to see and/or change corresponding controls."

#@}

#+ Book 1 Scenario 1_03
#@{

#### 1_03 common
	key[]: "aca_scenario_book1_1_03_title"
	val[]: "Prima Guida"

	key[]: "aca_scenario_book1_1_03_desc"
	val[]: "In questo scenario, impareremo come preparare il camion per essere guidato, e guidarlo in avanti per la prima volta."

#### 1_03 goal

	key[]: "aca_goal_book1_1_03_electrics"
	val[]: "Attivare l'Ignizione"

	key[]: "aca_goal_book1_1_03_start"
	val[]: "Avviare il Motore"

	key[]: "aca_goal_book1_1_03_look_mirror"
	val[]: "Controllare i Dintorni"

	key[]: "aca_goal_book1_1_03_brake"
	val[]: "Applicare il Freno di Servizio"

	key[]: "aca_goal_book1_1_03_gear"
	val[]: "Cambiare la Marcia"

	key[]: "aca_goal_book1_1_03_park_br_off"
	val[]: "Rilasciare il Freno di Stazionamento"

	key[]: "aca_goal_book1_1_03_forward"
	val[]: "Guidare a Marcia Avanti"

	key[]: "aca_goal_book1_1_03_stop"
	val[]: "Arresto"

	key[]: "aca_goal_book1_1_03_park_br_on"
	val[]: "Azionare il freno di stazionamento"

	key[]: "aca_goal_book1_1_03_gear_n"
	val[]: "Inserire la Folle"

	key[]: "aca_goal_book1_1_03_end"
	val[]: "Spegnere il Motore"

#### 1_03 msg - intro text

	key[]: "aca_msg_book1_1_03_cutscene1"
	val[]: "Per le prime guide, utilizzeremo solo il trattore.<br>Un camion viene definito un trattore quando non ha uno spazio di carico interno, e utilizza invece a un rimorchio per trasportare merci e materiali."

	key[]: "aca_msg_book1_1_03_cutscene2"
	val[]: "I trattori sono comuni perché più versatili: possono sganciare un rimorchio vuoto e caricarne un altro pieno senza dover aspettare, oppure passare a un tipo di rimorchio completamente diverso."

	key[]: "aca_msg_book1_1_03_cutscene3"
	val[]: "Per la tua prima guida, il tuo compito sarà di guidare e fermarti dopo la linea tratteggiata.<br>Avvia il motore e segui le istruzioni per avere il camion pronto a partire. Una volta pronto, prosegui dritto."

	key[]: "aca_msg_book1_1_03_cutscene4"
	val[]: "Guida oltre la linea tratteggiata, fermati, spegni il motore e posteggia il camion."

#### 1_03 Driving Instructions

	key[]: "aca_msg_book1_1_03_electrics"
	val[]: "Per il prossimo passo del tuo addestramento, ti muoverai col camion per la prima volta.<br><br>Ovviamente il motore non funzionerà se non è avviato, quindi come prima cosa dovrai attivare l'ignizione.<br><br><font face=/font/big_bold.font>Premi $input engineelect$ per attivare l'ignizione.</font>@@aca_goal_tip@@ Nella Carriera, di default, il motore viene avviato automaticamente. Puoi modificare questo comportamento nella schermata Opzioni - 'Gameplay' - @@auto_engine_start@@."

	key[]: "aca_msg_book1_1_03_start"
	val[]: "L'ignizione attiva l'elettronica del camion. Avrai notato delle spie lampeggiare nel cruscotto - è normale. Se rimangono accese a motore acceso, solitamente c'è un problema nel camion. L'eccezione è la spia del freno di stazionamento, che si spegnerà quando questo verrà rilasciato.<br><br>Fortunatamente, questo camion è in buone condizioni e siamo pronti a partire.<br><br><font face=/font/big_bold.font>Premi @@imv_nrm_engine@@ per accendere il motore. </font>"

	key[]: "aca_msg_book1_1_03_look_mirror"
	val[]: "Ora che il motore è acceso, è indispensabile controllare l'ambiente circostante prima di muoversi.<br><br><font face=/font/big_bold.font>Guarda intorno al camion e negli specchietti laterali per essere certo che l'area circostante al camion sia sgombra.</font>@@aca_goal_tip@@ Devi essere a bordo del veicolo."

	key[]: "aca_msg_book1_1_03_brake"
	val[]: "Potrà sembrare ovvio, ma dovresti sapere come fermarti prima di metterti in movimento.<br><br><font face=/font/big_bold.font>Attiva il freno di servizio usando $input backward$. </font>"

	key[]: "aca_msg_book1_1_03_gear_arcade"
	val[]: "Ora, imparerai come cambiare la direzione di marcia.<br><br>Con un cambio Automatico Semplice non c'è bisogno di cambiare le marce, tutto viene fatto automaticamente.<font face=/font/big_bold.font><br><br>Usa $input forward$ per inserire la marcia avanti. </font>"

	key[]: "aca_msg_book1_1_03_gear_automatic"
	val[]: "Ora, imparerai come cambiare la direzione di marcia.<br><br>Il cambio automatico reale ti permette di passare su Drive, Neutral e Reverse come le vere trasmissioni automatiche.<br><br><font face=/font/big_bold.font>Premi @@imv_nrm_gearup@@ per inserire la marcia avanti. </font>"

	key[]: "aca_msg_book1_1_03_gear_manual"
	val[]: "Ora, imparerai come cambiare la direzione di marcia.<br><br>Il cambio sequenziale ti permette di selezionare le marce come le vere trasmissioni sequenziali.<br><br>Allo stesso modo in cui inserisci una marcia avanti, in accelerazione dovrai passare manualmente a marce superiori.<br><br><font face=/font/big_bold.font>Premi @@imv_nrm_gearup@@ per inserire la prima marcia.</font>"

	key[]: "aca_msg_book1_1_03_gear_direct"
	val[]: "Ora, imparerai come cambiare la direzione di marcia.<br><br>Con la leva del cambio e la frizione, vivrai l'esperienza di cambiare manualmente le marce come con le vere trasmissioni manuali.<br><br>Premi fino in fondo la frizione e il freno di servizio. <font face=/font/big_bold.font>Usa la leva per inserire la prima marcia. <color value=@@clr_txt@@>Mantieni premuti fino in fondo la frizione e il freno di servizio.</font>"

	key[]: "aca_msg_book1_1_03_park_br_off"
	val[]: "Per iniziare a muoverti, dovrai prima rilasciare il freno di stazionamento.<br><br><font face=/font/big_bold.font>Usa @@imv_nrm_parkingbrake@@ per rilasciare il freno di stazionamento.</font> @@aca_goal_tip@@ Nella Carriera, il freno di stazionamento è disabilitato. Puoi modificare questo comportamento nella schermata Opzioni - 'Gameplay' - @@auto_park_brake@@."

	key[]: "aca_msg_book1_1_03_forward_arcade"
	val[]: "Ora il camion è pronto per andare avanti. Inizia a muoverti e supera la linea tratteggiata.<br><br><font face=/font/big_bold.font>Inizia a muoverti premendo sull'acceleratore: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_automatic"
	val[]: "Ora il camion è pronto per andare avanti. Inizia a muoverti e supera la linea tratteggiata.<br><br><font face=/font/big_bold.font>Inizia a muoverti premendo sull'acceleratore: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_manual"
	val[]: "Ora il camion è pronto per andare avanti. Inizia a muoverti e supera la linea tratteggiata.<br><br><font face=/font/big_bold.font>Inizia a muoverti premendo sull'acceleratore: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_direct"
	val[]: "Ora il camion è pronto per andare avanti. Inizia a muoverti e supera la linea tratteggiata.<br><br><font face=/font/big_bold.font>Rilascia il freno di servizio, rilascia gradualmente la frizione per inserirla mentre usi l'acceleratore per mantenere il camion su di giri e non farlo stallare. Quando la frizione è completamente rilasciata, potrai accelerare e cambiare marcia se necessario. </font>"

	key[]: "aca_msg_book1_1_03_stop_arcade"
	val[]: "Usa il freno di servizio per fermarti.<br><br><font face=/font/big_bold.font>Usa $input backward$ per fermare il camion. </font>"

	key[]: "aca_msg_book1_1_03_stop_automatic"
	val[]: "Usa il freno di servizio per fermarti.<br><br><font face=/font/big_bold.font>Usa $input backward$ per fermare il camion. </font>"

	key[]: "aca_msg_book1_1_03_stop_manual"
	val[]: "Usa il freno di servizio per fermarti.<br><br><font face=/font/big_bold.font>Usa $input backward$ per fermare il camion. </font>"

	key[]: "aca_msg_book1_1_03_stop_direct"
	val[]: "Quando è ora di fermarsi, premi a fondo la frizione <font face=/font/big_bold.font>e poi arresta il camion utilizzando il freno di servizio.<color value=@@clr_txt@@> Inserisci la folle con la leva del cambio, poi potrai rilasciare la frizione. </font>"

	key[]: "aca_msg_book1_1_03_park_br_on"
	val[]: "Ora, metti in sicurezza il camion. Il freno di stazionamento assicura che il camion non si muova involontariamente da parcheggiato.<br><br><font face=/font/big_bold.font>Usa @@imv_nrm_parkingbrake@@ per attivare il freno di stazionamento.</font>"

	key[]: "aca_msg_book1_1_03_gear_n_arcade"
	val[]: "Con una trasmissione Automatica Semplice non c'è bisogno di cambiare marcia, tutto viene fatto in automatico.<br><br><font face=/font/big_bold.font>Premi @@imv_nrm_activate@@ per confermare. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>Inserisci la folle premendo @@imv_nrm_geardown@@. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>Inserisci la folle premendo @@imv_nrm_geardown@@. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>Sposta la leva del cambio in folle, poi rilascia la frizione. </font>"

	key[]: "aca_msg_book1_1_03_end"
	val[]: "Ora sai come far muovere il camion e come fermarlo in modo sicuro.<br><br><font face=/font/big_bold.font>Premi $input engineelect$ per spegnere il motore. </font>"
#@}

#+ Book 1 Scenario 1_04
#@{

#### 1_04 common
	key[]: "aca_scenario_book1_1_04_title"
	val[]: "Retromarcia"

	key[]: "aca_scenario_book1_1_04_desc"
	val[]: "In questo scenario, proveremo la retromarcia per la prima volta. Parleremo anche di come usare gli specchietti per vedere dietro di te, cosa tenere d'occhio e come prepararsi alla marcia indietro."

#### 1_04 goal

	key[]: "aca_goal_book1_1_04_start"
	val[]: "Avviare il Motore"

	key[]: "aca_goal_book1_1_04_look_mirror"
	val[]: "Controllare lo Specchietto Lato Passeggero"

	key[]: "aca_goal_book1_1_04_look_back"
	val[]: "Controllare lo Specchietto Lato Guida"

	key[]: "aca_goal_book1_1_04_gear_r"
	val[]: "Cambiare la Marcia"

	key[]: "aca_goal_book1_1_04_park_br_off"
	val[]: "Rilasciare il Freno di Stazionamento"
#!{
	key[]: "aca_goal_book1_1_04_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_1_04_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_1_04_park_br_on"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

#!}
	key[]: "aca_goal_book1_1_04_gear_n"
	val[]: "Inserire la Folle"

	key[]: "aca_goal_book1_1_04_end"
	val[]: "Spegnere il Motore"

#### 1_04 msg - intro text

	key[]: "aca_msg_book1_1_04_cutscene1"
	val[]: "Per questa guida, faremo retromarcia su una linea retta. Dovrai procedere oltre la linea tratteggiarta e fermarti là."

	key[]: "aca_msg_book1_1_04_cutscene2"
	val[]: "Guidando in retromarcia, è essenziale guardarsi costantemente intorno, osservare gli specchietti e assicurarsi che lo spazio intorno e dietro di te sia sgombro."

	key[]: "aca_msg_book1_1_04_cutscene3"
	val[]: "Avvia il motore, inserisci la retromarcia e inizia a muoverti."

	key[]: "aca_msg_book1_1_04_cutscene4"
	val[]: "Guida oltre la linea tratteggiata, fermati, spegni il motore e posteggia il camion."

#### 1_04 Driving Instructions

	key[]: "aca_msg_book1_1_04_start"
	val[]: "Prepara il camion alla guida come hai imparato nello scenario precedente.<br><br><font face=/font/big_bold.font>Quando sei pronto, avvia il motore. </font>"

	key[]: "aca_msg_book1_1_04_look_mirror"
	val[]: "Controlla gli specchietti per assicurarti che l'area circostante sia sgombra. Se non sei soddisfatto dalla loro posizione, puoi regolarli in '@@adjust_link_t@@'.<br><br><font face=/font/big_bold.font>Guarda lo specchietto lato passeggero.</font>@@aca_goal_tip@@ Devi essere a bordo del veicolo."

	key[]: "aca_msg_book1_1_04_look_back"
	val[]: "Devi superare la linea tratteggiata. La corsia ora è libera, ma durante la guida normale è essenziale monitorare costantemente l'ambiente circostante guardandoti intorno e usando gli specchietti.<br><br><font face=/font/big_bold.font>Controlla lo specchietto lato guidatore.</font>"

	key[]: "aca_msg_book1_1_04_gear_r_arcade"
	val[]: "<font face=/font/big_bold.font>Usa $input backward$ per inserire la retromarcia. </font>@@aca_goal_tip@@ In manovra, il cicalino della retromarcia si attiva automaticamente nella maggior parte dei camion. Puoi spegnerlo nella schermata Opzioni - 'Audio' - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_automatic"
	val[]: "<font face=/font/big_bold.font>Premi @@imv_nrm_geardown@@ per inserire la retromarcia. </font>@@aca_goal_tip@@ In manovra, il cicalino della retromarcia si attiva automaticamente nella maggior parte dei camion. Puoi spegnerlo nella schermata Opzioni - 'Audio' - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_manual"
	val[]: "<font face=/font/big_bold.font>Premi @@imv_nrm_geardown@@ per inserire la retromarcia. </font>@@aca_goal_tip@@ In manovra, il cicalino della retromarcia si attiva automaticamente nella maggior parte dei camion. Puoi spegnerlo nella schermata Opzioni - 'Audio' - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_direct"
	val[]: "<font face=/font/big_bold.font>Premi a fondo la frizione e sposta la leva del cambio in retromarcia. </font>@@aca_goal_tip@@ In manovra, il cicalino della retromarcia si attiva automaticamente nella maggior parte dei camion. Puoi spegnerlo nella schermata Opzioni - 'Audio' - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_park_br_off"
	val[]: "Hai inserito la retromarcia.<br><br><font face=/font/big_bold.font>Rilascia il freno di stazionamento usando @@imv_nrm_parkingbrake@@. </font>"

	key[]: "aca_msg_book1_1_04_backward_arcade"
	val[]: "Inizia a muoverti usando $input backward$.<br><br><font face=/font/big_bold.font>Fai marcia indietro oltre la linea tratteggiata. </font>"

	key[]: "aca_msg_book1_1_04_backward_automatic"
	val[]: "Inizia a muoverti usando l'acceleratore: $input forward$.<br><br><font face=/font/big_bold.font>Fai marcia indietro oltre la linea tratteggiata. </font>"

	key[]: "aca_msg_book1_1_04_backward_manual"
	val[]: "Inizia a muoverti usando l'acceleratore: $input forward$.<br><br><font face=/font/big_bold.font>Fai marcia indietro oltre la linea tratteggiata. </font>"

	key[]: "aca_msg_book1_1_04_backward_direct"
	val[]: "Rilascia dolcemente la frizione, mantenendo i giri del motore con l'acceleratore. <br><br><font face=/font/big_bold.font>Fai marcia indietro oltre la linea tratteggiata. </font>"

	key[]: "aca_msg_book1_1_04_stop_arcade"
	val[]: "<font face=/font/big_bold.font>Ferma il camion usando il freno di servizio: $input forward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_automatic"
	val[]: "<font face=/font/big_bold.font>Ferma il camion usando il freno di servizio: $input backward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_manual"
	val[]: "<font face=/font/big_bold.font>Ferma il camion usando il freno di servizio: $input backward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_direct"
	val[]: "<font face=/font/big_bold.font>Premi a fondo la frizione e arresta il camion usando il freno di servizio. </font>"

	key[]: "aca_msg_book1_1_04_park_br_on"
	val[]: "<font face=/font/big_bold.font>Attiva il freno di stazionamento usando @@imv_nrm_parkingbrake@@. </font>"

	key[]: "aca_msg_book1_1_04_gear_n_arcade"
	val[]: "Con una trasmissione Automatica Semplice non c'è bisogno di cambiare marcia, tutto viene fatto in automatico al contrario della realtà.<br><br><font face=/font/big_bold.font>Premi @@imv_nrm_activate@@ per confermare. </font>"

	key[]: "aca_msg_book1_1_04_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>Inserisci la folle premendo @@imv_nrm_gearup@@.</font>@@aca_goal_tip@@ I camion moderni inseriranno automaticamente la folle insieme al freno di stazionamento. Tuttavia, è buona abitudine farlo da soli. Nei prossimi scenari, questo passo non sarà richiesto."

	key[]: "aca_msg_book1_1_04_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>Inserisci la folle premendo @@imv_nrm_gearup@@.</font>@@aca_goal_tip@@ I camion moderni inseriranno automaticamente la folle insieme al freno di stazionamento. Tuttavia, è buona abitudine farlo personalmente. Nei prossimi scenari, questo passo non sarà richiesto."

	key[]: "aca_msg_book1_1_04_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>Sposta la leva del cambio in folle, poi rilascia la frizione.</font>@@aca_goal_tip@@ I camion moderni inseriranno automaticamente la folle insieme al freno di stazionamento. Tuttavia, è buona abitudine farlo da soli. Nei prossimi scenari, questo passo non sarà richiesto."

	key[]: "aca_msg_book1_1_04_end"
	val[]: "Quando fai retromarcia, assicurati sempre di sapere cosa accade intorno a te, specialmente se ti trovi in aree con molto traffico.<br><br><font face=/font/big_bold.font>Spegni il motore premendo $input engineelect$. </font>"
#@}

