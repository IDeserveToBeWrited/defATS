#+ Book 3 Scenario urf
#@{

#### urf common
	key[]: "aca_scenario_book3_urf_title"
	val[]: "Sandbox di supporto"

	key[]: "aca_scenario_book3_urf_desc"
	val[]: "In questo scenario, verrai posizionato in un parcheggio vuoto per esercitarti in retromarcia con i rimorchi doppi."

#### urf goal

	key[]: "aca_goal_book3_urf_start"
	val[]: "Iniziando"

	key[]: "aca_goal_book3_urf_move"
	val[]: "Sperimentando"

	key[]: "aca_goal_book3_urf_stop"
	val[]: "Terminando"

	key[]: "aca_goal_book3_urf_end"
	val[]: "Termine dello Scenario"

	#### urf msg - intro text

	key[]: "aca_msg_book3_urf_cutscene1"
	val[]: "La retromarcia con rimorchi doppi richiede molta più attenzione di un rimorchio singolo. Devi pensare in anticipo a dove vuoi far andare il rimorchio di coda, mentre continui a controllare anche cabina e rimorchio di testa. <br><br>Pensa come se dovessi sterzare il rimorchio di coda con quello di testa, perciò la traiettoria il rimorchio di testa influirà su quella del rimorchio di coda."

	key[]: "aca_msg_book3_urf_cutscene2"
	val[]: "In this case, we want to turn the rear trailer to the driver's side. <br><br>To do this, we steered the lead to the passenger's side."

	key[]: "aca_msg_book3_urf_cutscene3"
	val[]: "Qui è dove molta gente commette il primo errore. Quando il rimorchio di coda inizia a girare, devi raddrizzare il trattore con il rimorchio di testa..."

	key[]: "aca_msg_book3_urf_cutscene4"
	val[]: "...o finirai per intraversarti proprio così."

	key[]: "aca_msg_book3_urf_cutscene5"
	val[]: "L'intraversamento accade quando l'angolo tra due veicoli qualsiasi nella combinazione arriva a circa 90 gradi. Quando succede questo, non c'è scampo - devi andare avanti e fare un altro tentativo. <br><br> Così come in retromarcia con un rimorchio singolo, l'obiettivo è di avere le ruote di tutti i rimorchi sempre in movimento. Se una ruota si ferma e un rimorchio gira su sé stesso, è finita."

	key[]: "aca_msg_book3_urf_cutscene6"
	val[]: "Puoi andare avanti fino all'ultima posizione corretta, o meglio - in una posizione dove puoi continuare la retromarcia senza ripetere lo stesso errore, altrimenti vai avanti finché non sei completamente dritto."

	key[]: "aca_msg_book3_urf_cutscene7"
	val[]: "Di nuovo, quando il rimorchio di coda gira, porta il trattore davanti al rimorchio di testa e lascia che quello di coda giri da solo per un momento."

	key[]: "aca_msg_book3_urf_cutscene8"
	val[]: "Ora che il rimorchio di coda sta girando dolcemente, è ora che quello di testa lo segua. Puoi correggere l'angolo tra testa e coda per controllare la curva e renderlo più stretto o più ampio."

	key[]: "aca_msg_book3_urf_cutscene9"
	val[]: "L'ultima parte della manovra consiste nel raddrizzare la combinazione. Porta il rimorchio di testa davanti a quello di coda."

	key[]: "aca_msg_book3_urf_cutscene10"
	val[]: "È bene tenere a mente il tempo che occorre a muovere il rimorchio di testa, e che dovrai allineare anche il trattore."

	key[]: "aca_msg_book3_urf_cutscene11"
	val[]: "Sentiti libero di metterci tutto il tempo che vuoi e sperimentare con manovre diverse finché non ti sei fatto un'idea di come gestire i rimorchi in retromarcia."

#### urf Driving Instructions

	key[]: "aca_msg_book3_urf_start"
	val[]: "Preparati a partire."

	key[]: "aca_msg_book3_urf_move"
	val[]: "Usa questo parcheggio per farti un'idea di come manovrare i rimorchi in retromarcia. <br><br>@@aca_goal_tip@@ Nuovo del manovrare i rimorchi in generale? Prova i Fondamenti di Guida del Camion."

	key[]: "aca_msg_book3_urf_stop"
	val[]: "Prenditi tutto il tempo che vuoi per fare pratica. <br><br>Quando sei soddisfatto, puoi fermarti e assicurare il camion per terminare lo scenario."

	key[]: "aca_msg_book3_urf_end"
	val[]: "Spegni il motore per terminare lo scenario."
#@}


#+ Book 3 Scenario sup
#@{

#### sup common
	key[]: "aca_scenario_book3_sup_title"
	val[]: "Parcheggiare in uno Spazio Stretto"

	key[]: "aca_scenario_book3_sup_desc"
	val[]: "In questo scenario, ti viene richiesto di parcheggiare la tua combinazione con rimorchio doppio in uno spazio angusto."

#### sup goal

	key[]: "aca_goal_book3_sup_start"
	val[]: "Inizio"

	key[]: "aca_goal_book3_sup_forward"
	val[]: "Partire"

	key[]: "aca_goal_book3_sup_check1"
	val[]: "Continua a guidare"

	key[]: "aca_goal_book3_sup_stop"
	val[]: "Arresto"

	key[]: "aca_goal_book3_sup_end"
	val[]: "Assicurare il Veicolo"

#### sup msg - intro text

	key[]: "aca_msg_book3_sup_cutscene1"
	val[]: "Guidare con rimorchi doppi può sembrare spaventoso, ma non c'è molto da aggiungere rispetto al rimorchio singolo - devi solo considerare anche la traiettoria del rimorchio di coda!"

	key[]: "aca_msg_book3_sup_cutscene2"
	val[]: "Davanti a te c'è un parcheggio stretto. Non avrai abbastanza spazio per essere perfettamente dritto prima di entrare, perciò dovrai considerare molto bene come farcela con entrambi i rimorchi."

	key[]: "aca_msg_book3_sup_cutscene3"
	val[]: "Gira immediatamente verso il lato opposto del parcheggio, e vai molto più avanti di dove gireresti normalmente."

	key[]: "aca_msg_book3_sup_cutscene4"
	val[]: "Ora che il rimorchio di coda è in posizione, puoi avvicinarti al parcheggio; potresti aver bisogno di andare nuovamente verso l'esterno per aiutarti a manovrare il rimorchio di testa."

	key[]: "aca_msg_book3_sup_cutscene5"
	val[]: "Continua nel parcheggio, ed entrambi i rimorchi ti seguiranno e si raddrizzeranno man mano che procedi."

	key[]: "aca_msg_book3_sup_cutscene6"
	val[]: "Parcheggia nell'area designata e assicura il camion."

#### sup Driving Instructions

	key[]: "aca_msg_book3_sup_start"
	val[]: "Preparati a partire."

	key[]: "aca_msg_book3_sup_forward"
	val[]: "Procedi in avanti verso lo spazio stretto."

	key[]: "aca_msg_book3_sup_check1"
	val[]: "Continua a guidare."

	key[]: "aca_msg_book3_sup_stop"
	val[]: "Fermati nell'area designata."

	key[]: "aca_msg_book3_sup_end"
	val[]: "Posteggia il camion e spegni il motore."
#@}


