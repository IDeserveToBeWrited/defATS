	key[]: "aca_msg_book3_3_11_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_3_11_forward"
	val[]: "Sei su un percorso disegnato per farti familiarizzare con le rotatorie. Vai avanti quando sei pronto."

	key[]: "aca_msg_book3_3_11_check1"
	val[]: "Entra bene nella rotatoria prima di puntare i coni all'esterno, per assicurarti che entrambi i rimorchi entrino in sicurezza."

	key[]: "aca_msg_book3_3_11_check2"
	val[]: "Sarà meglio guidare verso il lato esterno dell'uscita per tenere i rimorchi lontani dai coni. <br><br>Girare verso il centro della rotatoria prima di uscire potrebbe essere d'aiuto."

#!{
	key[]: "aca_msg_book3_3_11_check3"
	val[]: "@@aca_msg_book3_sup_check1@@"
#!}
	key[]: "aca_msg_book3_3_11_check4"
	val[]: "Dovresti riuscire a gestirla da solo, prenditi il tuo tempo e usa lo spazio con accortezza."

	key[]: "aca_msg_book3_3_11_check5"
	val[]: "Esci dalla rotatoria con calma."

