	val[]: "Procedi pure quando sei pronto. <br><br>Non dimenticarti di accendere le luci!"

	key[]: "aca_msg_book3_night_slalom_double_check0"
	val[]: "Guida attraverso gli slalom."

	key[]: "aca_msg_book3_night_slalom_double_stop"
	val[]: "Fermati nell'area designata."

	key[]: "aca_msg_book3_night_slalom_double_end"
	val[]: "Posteggia il veicolo e spegni il motore."

#+ Book 3 Scenario Truckstop Angle
#@{

#### trckstp common

	key[]: "aca_scenario_book3_trckstp_title"
	val[]: "Parcheggio in Curva"

	key[]: "aca_scenario_book3_trckstp_desc"
	val[]: "In questo scenario, dovrai farti strada in un parcheggio affollato, pieno zeppo di camion parcheggiati male, per fermarti lungo una curva."

#### trckstp goal

#!{
	key[]: "aca_goal_book3_trckstp_check1"
	val[]: "@@aca_goal_book3_sup_check1@@"

	key[]: "aca_goal_book3_trckstp_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_trckstp_end"
	val[]: "@@aca_goal_book3_sup_end@@"

	key[]: "aca_goal_book3_trckstp_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_trckstp_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
#### trckstp msg - intro text

	key[]: "aca_msg_book3_trckstp_cutscene1"
	val[]: "Non è raro arrivare in un parcheggio quasi completamente pieno di camion, che ti lascia con pochissime opzioni per parcheggiare."

	key[]: "aca_msg_book3_trckstp_cutscene2"
	val[]: "In questo caso, è rimasto solo uno spazio per farci stare il tuo rimorchio Doppio tipo B. <br><br>Guida nel parcheggio e fermati sulla curva vicino all'uscita."

#### trckstp Driving Instructions

#!{
	key[]: "aca_msg_book3_trckstp_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_trckstp_forward"
	val[]: "Fatti strada attraverso il parcheggio e fermati lungo la curva. <br><br>Procedi quando sei pronto."

	key[]: "aca_msg_book3_trckstp_check1"
	val[]: "Non riuscirai a starci qui nella curva, perciò dovrai tornare indietro e cercare un'altra via."

	key[]: "aca_msg_book3_trckstp_check2"
	val[]: "Parcheggia nella curva qui davanti."

	key[]: "aca_msg_book3_trckstp_stop"
	val[]: "Fermati nell'area designata."

	key[]: "aca_msg_book3_trckstp_end"
	val[]: "Posteggia il camion e spegni il motore."

#@}


#+ Book 3 Scenario finex
#@{

#### finex common

	key[]: "aca_scenario_book3_finex_title"
	val[]: "Esame Finale"

	key[]: "aca_scenario_book3_finex_desc"
	val[]: "In questo scenario, metterai le tue nuove abilità alla prova in un percorso disegnato per testare la tua precisione e comprensione della guida con rimorchi doppi."

#### finex goal

	key[]: "aca_goal_book3_finex_check0"
	val[]: "Retromarcia"

	key[]: "aca_goal_book3_finex_check1"
	val[]: "Entrare nel Percorso"

	key[]: "aca_goal_book3_finex_check2"
	val[]: "Prendere Velocità"

	key[]: "aca_goal_book3_finex_check22"
	val[]: "Preparati a Frenare"

	key[]: "aca_goal_book3_finex_speed"
	val[]: "Velocità Insufficiente"

#!{
	key[]: "aca_goal_book3_finex_check4"
	val[]: "@@aca_goal_book3_sup_check1@@"
#!}
	key[]: "aca_goal_book3_finex_check5"
	val[]: "Parcheggio"

#!{
	key[]: "aca_goal_book3_finex_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_finex_end"
	val[]: "@@aca_goal_book3_sup_end@@"

	key[]: "aca_goal_book3_finex_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_finex_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
#### finex msg - intro text

	key[]: "aca_msg_book3_finex_cutscene1"
	val[]: "Benvenuto all'esame finale. Abbiamo allestito alcune situazioni realistiche che potresti trovare sulla strada, per vedere come riesci a gestirle. Come sempre, fai con calma e sii preciso. <br><br>Buona fortuna!"

#### finex Driving Instructions

	key[]: "aca_msg_book3_finex_check0"
	val[]: "La via qui davanti è bloccata, girati nello spazio a disposizione."

	key[]: "aca_msg_book3_finex_check1"
	val[]: "Continua verso il centro cittadino."

	key[]: "aca_msg_book3_finex_check2"
	val[]: "Raggiungi una velocità di almeno 37 mph (60 km/h) procedendo verso il centro cittadino."

	key[]: "aca_msg_book3_finex_check22"
	val[]: "Preparati a frenare."

	key[]: "aca_msg_book3_finex_speed"
	val[]: "Non sei riuscito a raggiungere una velocità di 37 mph (60 km/h)"

	key[]: "aca_msg_book3_finex_check4"
	val[]: "Continua a guidare lungo il percorso."

	key[]: "aca_msg_book3_finex_check5"
	val[]: "C'è un parcheggio per te, nella fila di camion a sinistra. Fai retromarcia lì e fermati."

#!{
	key[]: "aca_msg_book3_finex_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_finex_forward"
	val[]: "Vai avanti quando sei pronto."

#!{
	key[]: "aca_msg_book3_finex_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_finex_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


