#+ Book 1 Scenario 3_09
#@{

#### 3_09 common
	key[]: "aca_scenario_book1_3_09_title"
	val[]: "Parcheggio Diagonale"

	key[]: "aca_scenario_book1_3_09_desc"
	val[]: "In questo scenario, effettuerai un parcheggio diagonale in un lotto affollato. <br><br>Non c'è molto spazio per manovrare, perciò dovrai essere molto accurato e deciso alla guida."

#### 3_09 goal

	key[]: "aca_goal_book1_3_09_check1"
	val[]: "Avvicinarsi al Posto di Parcheggio"
#!{
	key[]: "aca_goal_book1_3_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_09_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_09_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
 #!}
#### 3_09 msg - intro text

	key[]: "aca_msg_book1_3_09_cutscene1"
	val[]: "Parcheggi diagonali come questo sono molto comuni. Li potrai incontrare nelle aree di servizio o nelle aree di sosta sparse per l'America. <br>Di nuovo, dovremo entrare 'di muso' nel parcheggio qui davanti."

	key[]: "aca_msg_book1_3_09_cutscene2"
	val[]: "Guida verso il parcheggio designato vicino al termine della fila."

	key[]: "aca_msg_book1_3_09_cutscene3"
	val[]: "Resta verso il centro della corsia, o leggermente a sinistra. Dovrai lasciarti spazio per manovrare il rimorchio."

	key[]: "aca_msg_book1_3_09_cutscene4"
	val[]: "Supera abbondantemente il parcheggio, poi gira bruscamente e rapidamente verso l'area. Dovrai controllare gli specchietti sul lato destro per vedere che il rimorchio stia entrando nell'area di parcheggio."

	key[]: "aca_msg_book1_3_09_cutscene5"
	val[]: "Fermati nell'area designata, assicura il camion e spegni il motore."


#### 3_09 Driving Instructions

	key[]: "aca_msg_book1_3_09_start"
	val[]: "@@aca_msg_book1_3_09_start_img@@<br>Parcheggiando in diagonale, è importante giudicare accuratamente la tua posizione. Quando sei ad un certo punto della curva, è difficile fare retromarcia e riposizionarsi in modo sicuro, perciò è bene fare in modo di avere abbastanza spazio al primo tentativo.<br><br><font face=/font/big_bold.font>Preparati a partire.</font>"

	key[]: "aca_msg_book1_3_09_forward"
	val[]: "<font face=/font/big_bold.font>Inizia a guidare verso il parcheggio. </font>"

	key[]: "aca_msg_book1_3_09_check1"
	val[]: "Supera il parcheggio per dare al rimorchio lo spazio per ruotare intorno al camion al tuo interno.<br><br><font face=/font/big_bold.font>Gira nel parcheggio. </font>"
#!{
	key[]: "aca_msg_book1_3_09_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}

#@}

#+ Book 1 Scenario 3_10
#@{

#### 3_10 common
	key[]: "aca_scenario_book1_3_10_title"
	val[]: "Retromarcia dal lato cieco"

	key[]: "aca_scenario_book1_3_10_desc"
	val[]: "In questo scenario vedremo come fare retromarcia in uno spazio di parcheggio sul \"lato cieco\". Senza poter guardare fuori dal finestrino per vedere dove stai andando, dovrai fare affidamento sugli specchietti per orientarti in modo appropriato."

#### 3_10 goal
#!{
	key[]: "aca_goal_book1_3_10_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_10_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_10_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_10_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

 #!}
#### 3_10 msg - intro text

	key[]: "aca_msg_book1_3_10_cutscene1"
	val[]: "In questo scenario, imparerai la manovra di retromarcia dal 'lato cieco'. In genere, l'operazione dovrebbe essere evitata a meno di non avere alternative, perché la visibilità è molto limitata. Prenditi il tuo tempo e scegli la strada della prudenza estrema."

	key[]: "aca_msg_book1_3_10_cutscene2"
	val[]: "Supera abbondantemente il parcheggio per darti abbastanza spazio durante la retromarcia."

	key[]: "aca_msg_book1_3_10_cutscene3"
	val[]: "Fermati, controlla i dintorni, poi inizia la retromarcia."

	key[]: "aca_msg_book1_3_10_cutscene4"
	val[]: "Gira il trattore fuori dal parcheggio per spostare in avanti l'avantreno del rimorchio e girare il retro verso il parcheggio di destinazione. Occhio a non esagerare, si rischia di intraversare l'insieme."

	key[]: "aca_msg_book1_3_10_cutscene5"
	val[]: "Mentre il rimorchio entra nel parcheggio, inizia a raddrizzare il camion."

	key[]: "aca_msg_book1_3_10_cutscene6"
	val[]: "Fermati nell'area designata e assicura il camion."

#### 3_10 Driving Instructions

	key[]: "aca_msg_book1_3_10_start"
	val[]: "La retromarcia verso il lato cieco richiede le stesse procedure di quello verso il lato visibile, ma sarai limitato dalla mancanza di visibilità da quel lato. Usa gli specchietti e il tuo giudizio per parcheggiare il camion.<br><br><font face=/font/big_bold.font>Preparati a partire. </font>"

	key[]: "aca_msg_book1_3_10_forward"
	val[]: "C'è un parcheggio di fronte, verso destra. Avrai bisogno di andare molto più avanti, in modo da avere spazio di manovra durante la retromarcia.<br><br><font face=/font/big_bold.font>Vai avanti. </font>"
#!{
	key[]: "aca_msg_book1_3_10_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
	key[]: "aca_msg_book1_3_10_check2"
	val[]: "Ricorda, sterzare il camion distante dal punto farà girare il rimorchio verso di esso. Usa gli specchietti al meglio delle tue abilità per aiutarti nel parcheggio.<br><br><font face=/font/big_bold.font>Inizia la retromarcia. </font>"


#@}

#+ Book 1 Scenario 3_11
#@{

#### 3_11 common
	key[]: "aca_scenario_book1_3_11_title"
	val[]: "Guida in una Rotatoria"

	key[]: "aca_scenario_book1_3_11_desc"
	val[]: "In questo scenario vedremo come affrontare una rotatoria.<br><br>Dovrai prestare particolare attenzione al rimorchio perché la sua traiettoria, dietro di te, sarà diversa in immissione, percorrenza e uscita."

#### 3_11 goal
#!{
	key[]: "aca_goal_book1_3_11_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_11_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


	key[]: "aca_goal_book1_3_11_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_11_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
 #!}

	key[]: "aca_goal_book1_3_11_check1"
	val[]: "Immissione nella Rotatoria"

	key[]: "aca_goal_book1_3_11_check2"
	val[]: "Guida nella Rotatoria"

	key[]: "aca_goal_book1_3_11_check3"
	val[]: "Guida nella Rotatoria"

	key[]: "aca_goal_book1_3_11_check5"
	val[]: "Uscita dalla Rotatoria"

	key[]: "aca_goal_book1_3_11_check6"
	val[]: "Guidare verso l'Area Designata"

#### 3_11 msg - intro text

	key[]: "aca_msg_book1_3_11_cutscene1"
	val[]: "Le rotatorie stanno diventando più comuni in America, perciò è importante sapere come affrontarle."

	key[]: "aca_msg_book1_3_11_cutscene3"
	val[]: "Resta all'esterno della tua corsia mentre percorri la rotatoria. Questo aiuterà il rimorchio a superare l'interno della curva in immissione."

	key[]: "aca_msg_book1_3_11_cutscene4"
	val[]: "Guida verso il centro della rotatoria mentre entri. Una volta immesso, dovrai puntare verso l'uscita. Questo per mantenere il rimorchio distante dal centro della rotatoria."

	key[]: "aca_msg_book1_3_11_cutscene5"
	val[]: "Tieni d'occhio lo specchietto, per assicurarti che il rimorchio non si avvicini troppo alle barriere all'interno."

	key[]: "aca_msg_book1_3_11_cutscene6"
	val[]: "Uscire dalla rotatoria è abbastanza facile, essendo il rimorchio già posizionato distante dall'interno dell'uscita. Mantieniti largo in uscita e il rimorchio dovrebbe seguirti a dovere."

	key[]: "aca_msg_book1_3_11_cutscene7"
	val[]: "Parcheggia nell'area designata e assicura il camion."



#### 3_11 Driving Instructions
#!{
	key[]: "aca_msg_book1_3_11_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

	key[]: "aca_msg_book1_3_11_forward"
	val[]: "Davanti a te c'è una rotatoria pronta per essere affrontata. <br><br><font face=/font/big_bold.font>Avvicinati lentamente alla rotatoria. </font>"

	key[]: "aca_msg_book1_3_11_check1"
	val[]: "Effettua una curva ampia quando ti immetti nella rotatoria, così il rimorchio dietro di te ti seguirà senza problemi. <br><br><font face=/font/big_bold.font>Immettiti nella rotatoria. </font>"

	key[]: "aca_msg_book1_3_11_check2"
	val[]: "Guida verso l'uscita della rotatoria. Dovrai mantenere il camion il più distante possibile dal centro della rotatoria per mantenere il rimorchio lontano dalle barriere centrali. <br><br><font face=/font/big_bold.font>Continua attraverso la rotatoria.</font>"

	key[]: "aca_msg_book1_3_11_check3"
	val[]: "Resta vicino ai coni all'esterno. <br><br><font face=/font/big_bold.font>Continua a guidare.</font>"

	key[]: "aca_msg_book1_3_11_check5"
	val[]: "<font face=/font/big_bold.font>Esci dalla rotatoria.</font>"

	key[]: "aca_msg_book1_3_11_check6"
	val[]: "<font face=/font/big_bold.font>Procedi verso il parcheggio più avanti.</font>"

	key[]: "aca_msg_book1_3_11_stop"
	val[]: "<font face=/font/big_bold.font>Fermati nell'area designata.</font>"

	key[]: "aca_msg_book1_3_11_end"
	val[]: "<font face=/font/big_bold.font>Posteggia il camion e spegni il motore.</font>"
#@}

#+ Book 1 Scenario 3_12
#@{

#### 3_12 common
	key[]: "aca_scenario_book1_3_12_title"
	val[]: "Manovre in uno Spazio Stretto"

	key[]: "aca_scenario_book1_3_12_desc"
	val[]: "In questo scenario il tuo compito sarà di girare il camion in uno spazio ristretto. Richiederà attenzione a ciò che ti circonda e un uso intelligente dello spazio."

#### 3_12 goal



	key[]: "aca_goal_book1_3_12_check1"
	val[]: "Preparazione alla retromarcia"

	key[]: "aca_goal_book1_3_12_check2"
	val[]: "Lasciare l'area"

	key[]: "aca_goal_book1_3_12_check3"
	val[]: "Retromarcia nel Parcheggio"

	key[]: "aca_goal_book1_3_12_check4"
	val[]: "Completare la Manovra dal Lato Cieco"
