	val[]: "@@aca_scenario_book1_1_04_title@@"

#!}
	key[]: "aca_goal_book1_2_06_forward"
	val[]: "Slalom"

	key[]: "aca_goal_book1_2_06_forward2"
	val[]: "Tornante"

	key[]: "aca_goal_book1_2_06_check1"
	val[]: "Apertura stretta"

	key[]: "aca_goal_book1_2_06_check2"
	val[]: "Curva a 90 gradi"

	key[]: "aca_goal_book1_2_06_check3"
	val[]: "Sezione aperta"

	key[]: "aca_goal_book1_2_06_check4"
	val[]: "Avvicinarsi alla sezione di retromarcia"

	key[]: "aca_goal_book1_2_06_check5"
	val[]: "Changing Direction"

	key[]: "aca_goal_book1_2_06_reverse"
	val[]: "Retromarcia in sterzata"

	key[]: "aca_goal_book1_2_06_check6"
	val[]: "Avvicinarsi alle barriere"

	key[]: "aca_goal_book1_2_06_check7"
	val[]: "Cambiare direzione"

	key[]: "aca_goal_book1_2_06_check8"
	val[]: "Curve a S strette"

	key[]: "aca_goal_book1_2_06_check9"
	val[]: "90-degree Turns"

	key[]: "aca_goal_book1_2_06_check10"
	val[]: "Passaggio a livello"

	key[]: "aca_goal_book1_2_06_check11"
	val[]: "Svolta a destra sulla strada di servizio"

	key[]: "aca_goal_book1_2_06_check12"
	val[]: "Svolta a sinistra sulla carreggiata"

	key[]: "aca_goal_book1_2_06_check13"
	val[]: "Straight Section"

	key[]: "aca_goal_book1_2_06_check14"
	val[]: "Svolte a sinistra"

	key[]: "aca_goal_book1_2_06_check15"
	val[]: "Avvicinarsi alle barriere"


	key[]: "aca_goal_book1_2_06_check17"
	val[]: "Parcheggiare nell'area designata"



#### 2_06 msg - intro text

	key[]: "aca_msg_book1_2_06_cutscene01"
	val[]: "Per lo scenario finale di questo capitolo, guideremo sul tracciato di prova con una configurazione complessa."

	key[]: "aca_msg_book1_2_06_cutscene02"
	val[]: "Il primo ostacolo è uno slalom attraverso delle barriere. Percorrilo e ricorda di usare gli specchietti."

	key[]: "aca_msg_book1_2_06_cutscene04"
	val[]: "Il prossimo è un tornante. Mantieniti largo e non dovresti avere problemi."

	key[]: "aca_msg_book1_2_06_cutscene05"
	val[]: "Il percorso qui davanti si stringe in maniera significativa. Procedi con cautela e usa lo specchietto laterale per aiutarti."

	key[]: "aca_msg_book1_2_06_cutscene06"
	val[]: "La prossima è una serie di facili curve a 90 gradi."

	key[]: "aca_msg_book1_2_06_cutscene08"
	val[]: "La prossima sezione deve essere affrontata in retromarcia. Avvicinati alle barriere tenendolo a mente."

	key[]: "aca_msg_book1_2_06_cutscene09"
	val[]: "Segui la segnaletica dietro e intorno alle curve."

	key[]: "aca_msg_book1_2_06_cutscene10"
	val[]: "Fai retromarcia verso le barriere, poi fermati e procedi in avanti verso destra."

	key[]: "aca_msg_book1_2_06_cutscene11"
	val[]: "This passage through the cones is very narrow. Drive slowly and use your mirrors to orient yourself within the passage."

	key[]: "aca_msg_book1_2_06_cutscene13"
	val[]: "Qui davanti c'è una serie di curve a 90 gradi, alternate tra destra e sinistra."

	key[]: "aca_msg_book1_2_06_cutscene15"
	val[]: "Potresti incontrare dei treni in questo passaggio a livello. In quel caso, fermati e aspetta. Successivamente, svolta a destra verso la strada di servizio."

	key[]: "aca_msg_book1_2_06_cutscene16"
	val[]: "Svolta a sinistra sulla carreggiata. Dopo aver completato la manovra, puoi aumentare leggermente la velocità."

	key[]: "aca_msg_book1_2_06_cutscene18"
	val[]: "Qualche altra curva a sinistra in città e sarai arrivato a destinazione!"

	key[]: "aca_msg_book1_2_06_cutscene19"
	val[]: "Avvicinati alle barriere qui davanti e preparati a parcheggiare nel posteggio sulla destra."

	key[]: "aca_msg_book1_2_06_cutscene20"
	val[]: "Fai retromarcia nel parcheggio, poi spegni il motore e metti il camion in sicurezza."

#### 2_06 Driving Instructions



	key[]: "aca_msg_book1_2_06_forward"
	val[]: "Di fronte a te c'è uno slalom tra le barriere.<br><br><font face=/font/big_bold.font>Guida attraverso lo slalom.</font>"

	key[]: "aca_msg_book1_2_06_forward2"
	val[]: "<font face=/font/big_bold.font>Segui il percorso intorno al tornante. </font>"

	key[]: "aca_msg_book1_2_06_check1"
	val[]: "Il percorso qui davanti si stringe in modo significativo. Puoi usare lo specchietto laterale per aiutarti a orientarti.<br><br><font face=/font/big_bold.font>Procedi con cautela. </font>"

	key[]: "aca_msg_book1_2_06_check2"
	val[]: "Dopo questa curva ce n'è una a 90 gradi.<br><br><font face=/font/big_bold.font>Regola la velocità di conseguenza. </font>"

	key[]: "aca_msg_book1_2_06_check3"
	val[]: "Qui davanti ci sono altre curve facili, continua a regolare la velocità se necessario.<br><br><font face=/font/big_bold.font>Continua a guidare. </font>"

	key[]: "aca_msg_book1_2_06_check4"
	val[]: "The following section must be completed in reverse. Stop at the barriers ahead so that you can reverse to the right afterwards.<br><br><font face=/font/big_bold.font>Stop at the barriers.</font>"

	key[]: "aca_msg_book1_2_06_check5"
	val[]: "Fai retromarcia verso l'area dietro di te a destra.<br><br><font face=/font/big_bold.font>Inizia la retromarcia. </font>"

	key[]: "aca_msg_book1_2_06_reverse"
	val[]: "Segui il percorso attraverso le curve.<br><br><font face=/font/big_bold.font>Continua la retromarcia.</font>"

	key[]: "aca_msg_book1_2_06_check6"
	val[]: "Dietro di te, a sinistra, ci sono delle barriere. <br><br><font face=/font/big_bold.font>Sterza verso le barriere e preparati a partire.</font>"

	key[]: "aca_msg_book1_2_06_check7"
	val[]: "Fermati e inserisci una marcia avanti, poi continua a destra. <br><br><font face=/font/big_bold.font>Vai avanti. </font>"

	key[]: "aca_msg_book1_2_06_check8"
	val[]: "In front of you is a narrow winding path through some cones. Drive carefully and use your mirrors if necessary.<br><br><font face=/font/big_bold.font>Drive through the cones. </font>"

	key[]: "aca_msg_book1_2_06_check9"
	val[]: "La prossima è una combinazione di diverse curve a 90 gradi. Assicurati di approcciare ogni curva con un angolo ampio.<br><br><font face=/font/big_bold.font>Continua a guidare. </font>"

	key[]: "aca_msg_book1_2_06_check10"
	val[]: "Tieni sotto controllo il passaggio a livello mentre ti avvicini. I segnali potrebbero attivarsi per indicare un treno in arrivo.<br><br><font face=/font/big_bold.font>Procedi con cautela.</font>"

	key[]: "aca_msg_book1_2_06_check11"
	val[]: "La curva per la strada di servizio è ostruita da un ostacolo, perciò tieni la sinistra avvicinandoti per darti più spazio.<br><br><font face=/font/big_bold.font>Affronta la curva. </font>"

	key[]: "aca_msg_book1_2_06_check12"
	val[]: "Puoi scegliere se osservare o ignorare il segnale di stop. L'area è stata chiusa per il nostro uso.<br><br><font face=/font/big_bold.font>Gira a sinistra.</font>"

	key[]: "aca_msg_book1_2_06_check13"
	val[]: "Qui puoi incrementare un po' la velocità, ma dovrai girare al prossimo incrocio.<br><br><font face=/font/big_bold.font>Continua lungo il percorso. </font>"

	key[]: "aca_msg_book1_2_06_check14"
	val[]: "Procedi in città con una curva a sinistra, seguita da altre due curve a sinistra verso l'area finale.<br><br><font face=/font/big_bold.font>Guida attraverso la città.</font>"

	key[]: "aca_msg_book1_2_06_check15"
	val[]: "All'estremità del lotto ci sono alcune barriere. Guida verso di esse. <br><br><font face=/font/big_bold.font>Fermati vicino alle barriere. </font>"

	key[]: "aca_msg_book1_2_06_check16"
	val[]: "Dietro di te, a destra, c'è un'area di parcheggio.<br><br><font face=/font/big_bold.font>Fai retromarcia verso il parcheggio. </font>"
#!{
	key[]: "aca_msg_book1_2_06_check17"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_06_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_2_06_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

#@}

#+ Book 1 Scenario 2_08
#@{

#### 2_08 common
	key[]: "aca_scenario_book1_2_08_title"
	val[]: "Corso di guida semplice"

	key[]: "aca_scenario_book1_2_08_desc"
	val[]: "In questo scenario, useremo le abilità che hai imparato finora per metterle alla prova in una facile guida lungo un percorso addestrativo semplice."

#### 2_08 goal
#!{
	key[]: "aca_goal_book1_2_08_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_08_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_2_08_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
#!}
	key[]: "aca_goal_book1_2_08_forward"
	val[]: "Entrare nel Percorso"

	key[]: "aca_goal_book1_2_08_check1"
	val[]: "Tornante largo"

	key[]: "aca_goal_book1_2_08_check2"
	val[]: "Guidare nello slalom"

	key[]: "aca_goal_book1_2_08_check3"
	val[]: "Tornante stretto"

	key[]: "aca_goal_book1_2_08_check4"
	val[]: "Curva stretta"

	key[]: "aca_goal_book1_2_08_check6"
	val[]: "Sezione tecnica"

	key[]: "aca_goal_book1_2_08_check7"
	val[]: "Sezione aperta"



#### 2_08 msg - intro text

	key[]: "aca_msg_book1_2_08_cutscene1"
	val[]: "In questo scenario porteremo il trattore per un breve percorso in cui vedremo come te la cavi con le tue nuove abilità.<br>Ci sono vari tipi e combinazioni di curve sul percorso. Non è una gara e non c'entra il cronometro: sii paziente e regola la velocità per le curve e gli ostacoli che incontrerai."

	key[]: "aca_msg_book1_2_08_cutscene2"
	val[]: "Entra nel percorso con un tornante largo."

	key[]: "aca_msg_book1_2_08_cutscene3"
	val[]: "Più avanti troverai una serie di ostacoli che ti guiderà verso uno slalom irregolare."

	key[]: "aca_msg_book1_2_08_cutscene4"
	val[]: "Dopo aver completato un paio di facili curve a 90 gradi, troverai un tornante stretto. È importante prepararti a dovere, sia per completare la curva che per entrare agevolmente nella prossima sezione."

	key[]: "aca_msg_book1_2_08_cutscene5"
	val[]: "Fai attenzione ai coni mentre percorri la curva lunga, perché la visibilità oltre il cofano è limitata."

	key[]: "aca_msg_book1_2_08_cutscene6"
	val[]: "Un'altra serie di barriere ti guiderà verso uno slalom ampio."

	key[]: "aca_msg_book1_2_08_cutscene7"
	val[]: "Il tracciato si allarga un po', ma non accelerare. Ancora qualche curva facile e avrai finito."

	key[]: "aca_msg_book1_2_08_cutscene8"
	val[]: "Stop in the designated area and secure the truck."


#### 2_08 Driving Instructions

	key[]: "aca_msg_book1_2_08_start"
	val[]: "Per completare questo scenario con successo non dovrai sbattere, uscire dal tracciato o colpire dei coni.<br><br><font face=/font/big_bold.font>Preparati a partire. </font>"

	key[]: "aca_msg_book1_2_08_forward"
	val[]:"<font face=/font/big_bold.font>Vai avanti fino al tornante ampio per iniziare il percorso. </font>"

	key[]: "aca_msg_book1_2_08_check1"
	val[]: "<font face=/font/big_bold.font>Completa il tornante. </font>"

	key[]: "aca_msg_book1_2_08_check2"
	val[]: "Ti stai avvicinando ad alcune barriere sistemate quasi a formare uno slalom.<br><br><font face=/font/big_bold.font>Regola la velocità di conseguenza e continua.</font>"

	key[]: "aca_msg_book1_2_08_check3"
	val[]: "Più avanti ci sono due facili curve a 90 gradi seguite da un tornante stretto. Prendila calma.<br><br><font face=/font/big_bold.font>Continua nel tornante stretto.</font>"

	key[]: "aca_msg_book1_2_08_check4"
	val[]: "Uscendo dal tornante, troverai un percorso stretto attraverso una curva. Dovrai stare lontano dalla barriera all'interno, ma fai attenzione a non colpire dei coni davanti a te.<br><br><font face=/font/big_bold.font>Continua lungo la curva. </font>"

	key[]: "aca_msg_book1_2_08_check6"
	val[]: "Il percorso qui davanti presenta alcune curve strette e tecniche. Regola la velocità e percorri la sezione con cautela.<br><br><font face=/font/big_bold.font>Continua a guidare. </font>"

	key[]: "aca_msg_book1_2_08_check7"
	val[]: "La prossima sezione è più aperta, con alcune curve semplici. Non correre.<br><br><font face=/font/big_bold.font>Continua a guidare. </font>"
#!{
	key[]: "aca_msg_book1_2_08_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_08_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

#@}

#+ Book 1 Scenario 2_09
#@{

#### 2_09 common
	key[]: "aca_scenario_book1_2_09_title"
	val[]: "Parcheggio Parallelo"

	key[]: "aca_scenario_book1_2_09_desc"
	val[]: "In questo scenario, daremo un'occhiata al parcheggio parallelo tra altri due camion."

#### 2_09 goal

	key[]: "aca_goal_book1_2_09_stopmid"
	val[]: "Fermarsi Davanti al Posto di Parcheggio"

	key[]: "aca_goal_book1_2_09_checkmirror"
	val[]: "Controlla lo Specchietto Retrovisore"

	key[]: "aca_goal_book1_2_09_backward"
	val[]: "Retromarcia nel Parcheggio"

	key[]: "aca_goal_book1_2_09_stop"
	val[]: "Allineare il Camion nel Posto di Parcheggio"

#!{
	key[]: "aca_goal_book1_2_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_09_check1"
	val[]: "@@aca_goal_book1_1_03_forward@@"


	key[]: "aca_goal_book1_2_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"



 #!}
#### 2_09 msg - intro text

	key[]: "aca_msg_book1_2_09_cutscene1"
	val[]: "Il parcheggio parallelo è un'abilità cruciale che ogni camionista dovrebbe conoscere.<br>Preparati a partire."

	key[]: "aca_msg_book1_2_09_cutscene2"
	val[]: "Guida verso il parcheggio.<br>Presta attenzione ai dintorni."

	key[]: "aca_msg_book1_2_09_cutscene3"
	val[]: "Allineati al camion di fronte al tuo parcheggio. Non stare troppo vicino, mantieni un po' di distanza per avere spazio di manovra."

	key[]: "aca_msg_book1_2_09_cutscene4"
	val[]: "Gira bruscamente verso lo spazio e inizia la retromarcia."

	key[]: "aca_msg_book1_2_09_cutscene5"
	val[]: "Guardando dallo specchietto principale, punta il cordolo di fronte al camion dietro di te."

	key[]: "aca_msg_book1_2_09_cutscene6"
	val[]: "Quando il paraurti anteriore copre il camion davanti a te, puoi iniziare a girare l'avantreno nell'area, allineando il camion al parcheggio."

	key[]: "aca_msg_book1_2_09_cutscene7"
	val[]: "Raddrizza il volante e centra il camion nello spazio di parcheggio.<br>Parcheggia e metti il camion in sicurezza."

#### 2_09 Driving Instructions

	key[]: "aca_msg_book1_2_09_start"
	val[]: "Di fronte a te ci sono alcuni camion fermi. C'è uno spazio libero per lasciarti parcheggiare. <br><br><font face=/font/big_bold.font>Preparati a partire. </font>"

	key[]: "aca_msg_book1_2_09_check1"
	val[]: "Ricordati di controllare i dintorni. Fai buon uso degli specchietti in questa manovra. <br><br><font face=/font/big_bold.font>Vai avanti. </font>"

	key[]: "aca_msg_book1_2_09_stopmid"
	val[]: "<color value=@@clr_white@@>Supera il parcheggio nell'area contrassegnata. Da lì puoi iniziare la manovra di retromarcia.<br><br><font face=/font/big_bold.font>Fermati nel punto contrassegnato. </font>"

	key[]: "aca_msg_book1_2_09_checkmirror"
	val[]: "Controlla i dintorni per eventuali ostacoli e assicurarti di poter fare retromarcia.<br><br><font face=/font/big_bold.font>Guarda lo specchietto sul lato del passeggero. </font>"

	key[]: "aca_msg_book1_2_09_backward"
	val[]: "Gira le ruote e fai retromarcia nel parcheggio.<br><br><font face=/font/big_bold.font>Inizia la retromarcia. </font>"

	key[]: "aca_msg_book1_2_09_stop"
	val[]: "Inizia a raddrizzare il camion quando puoi. Non scavalcare il cordolo!<br><br><font face=/font/big_bold.font>Allinea il camion al parcheggio. </font>"
#!{
	key[]: "aca_msg_book1_2_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

