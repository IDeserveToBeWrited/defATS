#+ Text deviations for American Truck Simulator. Please, use only terms appropriate for USA (i.e. culture specific nuances, not American English).
#@{

#+ Music/radio player
#@{

#+ Hint shown if no music files are found. Also shown as tooltip when hovering over music_player button.

	key[]: "music_player_hint"
	val[]: "Metti la musica in <color value=@@clr_sel@@>American Truck Simulator/music <color value=@@clr_txt@@><br>nella cartella <color value=@@clr_sel@@>Documenti <color value=@@clr_txt@@>e la ritroverai qui."

#+ Tooltip shown when hovering over the radio_stream button.

	key[]: "radio_hint"
	val[]: "Modifica <color value=@@clr_sel@@>live_streams.sii <color value=@@clr_txt@@>di <color value=@@clr_sel@@>American Truck Simulator <color value=@@clr_txt@@>nella cartella <color value=@@clr_sel@@>Documenti <color value=@@clr_txt@@>ed ascolta nel gioco le tue internet radio preferite!"

#+ Hint shown if no online radio streams are defined.

	key[]: "empty_radio_hint"
	val[]: "Prego, fai riferimento al file <color value=@@clr_sel@@>readme.rtf <color value=@@clr_txt@@>di <color value=@@clr_sel@@>American Truck Simulator <color value=@@clr_txt@@>nella cartella <color value=@@clr_sel@@>Documenti <color value=@@clr_txt@@>su come aggiungere la propria musica e gli stream radio."
#@}

