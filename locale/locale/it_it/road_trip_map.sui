#+ Washington TBs and POIs localization.
#@{
	key[]: "tb_wa1"
	val[]: "Penisola Olimpica"

	key[]: "tb_wa1_desc"
	val[]: "La Penisola Olimpica è un luogo in cui oceano, foreste e montagne coesistono in una bellezza in continua evoluzione. La nebbia si diffonde sulle coste rocciose, mentre le cascate precipitano dagli altopiani, dove valli nascoste ospitano piccole cittadine storiche."

	key[]: "poi_wa1_01"
	val[]: "Ufficio storico delle Poste Statunitensi"

	key[]: "poi_wa1_01_desc"
	val[]: "Completato nel 1893 su una scogliera sopra il lungomare di Port Townsend, l'edificio fu progettato per essere una struttura federale con dogana annessa, riflettendo le prime ambizioni della città come polo emergente del commercio internazionale."

	key[]: "poi_wa1_02"
	val[]: "Port Angeles"

	key[]: "poi_wa1_02_desc"
	val[]: "Port Angeles è una città costiera fondata nel XIX secolo come porto e punto di rifornimento. Oggi funge da accesso principale per il Parco Nazionale Olimpico e da porto per i traghetti che collegano gli Stati Uniti e il Canada."

	key[]: "poi_wa1_03"
	val[]: "Lago Crescent"

	key[]: "poi_wa1_03_desc"
	val[]: "Il lago Crescent, il secondo lago più profondo dello stato di Washington, è noto per il blu intenso delle sue acque cristalline, una colorazione dovuta ai bassi livelli di azoto. Situato all'interno di una popolare area turistica, è circondato da sentieri e foreste secolari."
	
	key[]: "poi_wa1_04"
	val[]: "Kalaloch Beach"

	key[]: "poi_wa1_04_desc"
	val[]: "Kalaloch Beach è nota per il suo \"Albero della Vita\", un peculiare abete di Sitka che, spazzato dal vento, risulta meno alto e più tozzo rispetto ai tipici abeti rossi. Famoso per le sue radici che creano un ponte tra le due sponde di un ruscello, è un'attrazione locale da non perdere."

	key[]: "poi_wa1_05"
	val[]: "Parco Nazionale Olimpico"

	key[]: "poi_wa1_05_desc"
	val[]: "Il Parco Nazionale Olimpico protegge diversi ecosistemi, dalla frastagliata costa del Pacifico alle foreste pluviali temperate, fino alle vette alpine. Classificato come National Monument nel 1909, fu ribattezzato Parco Nazionale dal governo federale nel 1938."

	key[]: "poi_wa1_06"
	val[]: "Greenhead Slough"

	key[]: "poi_wa1_06_desc"
	val[]: "Greenhead Slough è un piccolo canale nella zona umida lungo la Highway 101, vicino a Willapa Bay. Si trova all'interno di un habitat estuarino costiero ripristinato per favorire la deposizione delle uova dei salmoni e delle numerose specie di uccelli acquatici."

	key[]: "poi_wa1_07"
	val[]: "Baia di Dabob"

	key[]: "poi_wa1_07_desc"
	val[]: "La baia di Dabob è un fiordo profondo che ospita salmoni, molluschi e fauna selvatica. L'area naturale della baia di Dabob, istituita nel 1984, protegge rare specie vegetali di paludi salmastre e piante costiere all'interno di un sistema altamente funzionale di zone umide tidali."


##########################################################################################

	key[]: "tb_wa2"
	val[]: "Heartland"

	key[]: "tb_wa2_desc"
	val[]: "La zona centrale dello stato di Washington invita i viaggiatori a percorrere le caratteristiche strade costeggiate da foreste sempreverdi e placidi laghi alpini. Il monte Rainier domina l'orizzonte offrendo un panorama indimenticabile e un viaggio sereno nella natura del Pacific Northwest."

	key[]: "poi_wa2_01"
	val[]: "Monte Rainier"

	key[]: "poi_wa2_01_desc"
	val[]: "Il monte Rainier, la vetta più alta dello stato di Washington, è uno stratovulcano attivo di circa 4.300 metri. I suoi ghiacciai alimentano fiumi, modellano valli e approvvigionano ricche foreste e fauna selvatica, rendendolo un punto di riferimento naturale di grande importanza."

	key[]: "poi_wa2_02"
	val[]: "Foresta Nazionale di Wenatchee"

	key[]: "poi_wa2_02_desc"
	val[]: "La Foresta Nazionale di Wenatchee si estende su montagne, fiumi e valli alpine. Nel 1933, i Civilian Conservation Corps costruirono sentieri e punti di osservazione antincendio, lasciando un segno indelebile nella storia turistica e di conservazione della foresta."

	key[]: "poi_wa2_03"
	val[]: "Foresta Nazionale Mount Baker-Snoqualmie"

	key[]: "poi_wa2_03_desc"
	val[]: "La Foresta Nazionale Mount Baker-Snoqualmie ospita alcuni dei più antichi siti di monitoraggio dei ghiacciai d'America, dove si tiene traccia dei flussi di ghiaccio vulcanico e dei cambiamenti climatici nell'area delle Cascades fin dai primi anni del 1900."
	
	key[]: "poi_wa2_04"
	val[]: "Fiume Wenatchee"

	key[]: "poi_wa2_04_desc"
	val[]: "I resti dei canali d'irrigazione e dei mulini, risalenti ai primi del XIX secolo, mostrano come i coloni sfruttavano il fiume Wenatchee. Ancor prima dell'insediamento europeo, le tribù locali facevano affidamento sulle sue acque ricche di salmoni per il cibo e il commercio."

	key[]: "poi_wa2_05"
	val[]: "Klawatti Peak"

	key[]: "poi_wa2_05_desc"
	val[]: "Scalato per la prima volta a metà del XX secolo, il Klawatti Peak è poco battuto a causa dei suoi pendii ripidi e ricoperti di ghiacciai, che lo rendono una sfida ambita per gli alpinisti in cerca di luoghi solitari nelle North Cascades."

	key[]: "poi_wa2_06"
	val[]: "Diga di Dry Falls"

	key[]: "poi_wa2_06_desc"
	val[]: "Costruita per gestire i corsi d'acqua locali, la diga di Dry Falls sorge sopra antichi dirupi basaltici di origine preistorica, controlla i flussi stagionali e mette in mostra terrazze e vasche scavate dalle inondazioni dell'era glaciale."

	key[]: "poi_wa2_07"
	val[]: "White Mountain Fire Overlook"

	key[]: "poi_wa2_07_desc"
	val[]: "Il belvedere presenta pannelli informativi sull'incendio di White Mountain del 1988, uno degli incendi boschivi più grandi della storia recente nello stato di Washington, che rivelano le cicatrici e i modelli di ricrescita nella foresta."

	key[]: "wa_cut_helen_desc"
	val[]: "Per via della sua forma conica, il monte Saint Helens veniva chiamato il Monte Fuji d'America. Ma l'eruzione del 1980 rimosse circa 400 metri della sua sommità formando un cratere a ferro di cavallo, ora parzialmente riempito da una calotta di lava e da un ghiacciaio."


##########################################################################################


	key[]: "tb_wa3"
	val[]: "Wine Country"

	key[]: "tb_wa3_desc"
	val[]: "A est delle Cascades, la Wine Country di Washington si estende attraverso la Columbia Valley AVA. La regione comprende Selah Creek, il Lewis and Clark State Park e territori storicamente abitati da popolazioni indigene, caratterizzati da paesaggi aridi e soleggiati con dolci colline e valli fluviali."

	key[]: "poi_wa3_01"
	val[]: "Cascate di Clear Creek"

	key[]: "poi_wa3_01_desc"
	val[]: "Il punto panoramico sulle cascate di Clear Creek, appena a est di White Pass Summit, è una tappa molto frequentata. Circa un miglio più a est, la deviazione conduce alla Clear Lake Recreation Area, dove è possibile pescare e osservare la fauna locale."

	key[]: "poi_wa3_02"
	val[]: "Ponte di Selah Creek"

	key[]: "poi_wa3_02_desc"
	val[]: "Il ponte Fred G. Redmon, o ponte di Selah Creek, è una struttura a doppio arco nella contea di Yakima. Al suo completamento era il ponte ad arco in calcestruzzo più lungo d'America e il ponte stradale più alto dello stato."

	key[]: "poi_wa3_03"
	val[]: "Vigneti"
	
	key[]: "poi_wa3_03_desc"
	val[]: "Le valli e il terreno fertile dello stato di Washington ospitano numerose varietà, tra cui il Riesling, il Cabernet e il Merlot. I vigneti sono una parte importante dell'agricoltura dello stato, nonché del suo paesaggio."

	key[]: "poi_wa3_04"
	val[]: "Ponte di Ed Hendler"

	key[]: "poi_wa3_04_desc"
	val[]: "Costruito nel 1978, il ponte, a volte chiamato Intercity Bridge, attraversa il fiume Columbia tra Pasco e Kennewick, nel sud-est di Washington. Fin dalla sua inaugurazione è sempre stato considerato un monumento e un simbolo delle Tri-Cities."

	key[]: "poi_wa3_05"
	val[]: "Lewis and Clark State Park"

	key[]: "poi_wa3_05_desc"
	val[]: "Uno dei primi parchi dello stato di Washington, il Lewis and Clark State Park preserva antiche foreste lungo uno storico percorso indigeno. Chiamato così in onore del Corps of Discovery, le foreste del parco riportano alla mente i fitti boschi descritti da Meriwether Lewis nei suoi diari."

	key[]: "poi_wa3_06"
	val[]: "Tribunale della contea di Columbia"

	key[]: "poi_wa3_06_desc"
	val[]: "Il tribunale della contea di Columbia riflette un'epoca in cui il governo della contea era centrale nella vita quotidiana. Durante un periodo di rapida crescita e di contatti limitati con la capitale dello stato, i tribunali fungevano da principale fonte di autorità e rispondevano ai bisogni immediati dei cittadini."

	key[]: "poi_wa3_07"
	val[]: "Tribù native americane"

	key[]: "poi_wa3_07_desc"
	val[]: "La Columbia Valley e le aree circostanti ospitavano popolazioni indigene, tra cui le tribù Yakama, Walla Walla e Umatilla. Oggi queste comunità continuano a vivere nella regione, mantenendo le tradizioni culturali e gestendo le risorse idriche e del territorio."

##########################################################################################

#@}




#+ Oregon TBs and POIs localization.
#@{
	key[]: "tb_or1"
	val[]: "Costa del Pacifico"

	key[]: "tb_or1_desc"
	val[]: "La costa dell'Oregon presenta aspri promontori e punti panoramici. Mentre il faro di Heceta Head domina le onde che si infrangono sotto di lui, le scogliere di basalto di Silver Point, Ophir Wayside, Sisters Rocks e Kissing Rock si ergono contro i flutti del Pacifico."

	key[]: "landmark_or_astoria_b_desc"
	val[]: "Questo ponte lungo quattro miglia, sul fiume Columbia, collega Oregon e Washington, offrendo vedute panoramiche sulla foce del fiume e sull'orizzonte del Pacifico."

	key[]: "poi_or1_01"
	val[]: "Silver Point Interpretive Overlook"

	key[]: "poi_or1_01_desc"
	val[]: "Poco a sud di Cannon Beach, questo punto panoramico offre una vista mozzafiato su Haystack Rock e sulla costa frastagliata, particolarmente suggestiva al tramonto."

	key[]: "or_cut_lighthouse_desc"
	val[]: "Il faro più alto dell'Oregon, costruito nel 1873, che sorge su un promontorio di basalto vicino a Newport."

	key[]: "or_cut_newport_desc"
	val[]: "Lo Yaquina Bay Bridge, completato nel 1936, è una delle strutture costiere più iconiche dell'Oregon. Progettato dal famoso ingegnere Conde McCullough, il suo elegante arco attraversa la baia di Yaquina e si attesta come elemento distintivo della U.S. Route 101."

	key[]: "or_cut_thor_desc"
	val[]: "Una dolina naturale a Cape Perpetua dove le onde impetuose si ritirano, dando l'illusione che l'oceano si stia prosciugando."

	key[]: "poi_or1_02"
	val[]: "Ophir Wayside"

	key[]: "poi_or1_02_desc"
	val[]: "Un tranquillo punto di sosta nei pressi di Gold Beach, dove i visitatori possono fare stretching, osservare le onde o setacciare la spiaggia alla ricerca di legno alla deriva e agate."

	key[]: "poi_or1_03"
	val[]: "Sisters Rock Overlook"

	key[]: "poi_or1_03_desc"
	val[]: "Dalle onde si innalzano spettacolari faraglioni al largo, con sentieri che scendono verso piccole spiagge nascoste tra le scogliere."

	key[]: "poi_or1_04"
	val[]: "Kissing Rock"

	key[]: "poi_or1_04_desc"
	val[]: "Una tappa lungo la strada a sud di Gold Beach, dove due enormi formazioni rocciose si protendono l'una verso l'altra sopra la sabbia, diventando uno dei luoghi preferiti per le foto."


##########################################################################################

	key[]: "tb_or2"
	val[]: "Il selvaggio Est"

	key[]: "tb_or2_desc"
	val[]: "Spesso definita il selvaggio Est dell'Oregon, questa regione presenta paesaggi plasmati da forze geologiche nel corso di centinaia di milioni di anni, molte delle quali ancora attive oggi. In questo vasto arco temporale, la storia umana è breve, ma segnata da momenti drammatici quanto la terra stessa."

	key[]: "landmark_or_deadman_p_desc"
	val[]: "Vicino a Pendleton, questa zona panoramica offre vedute sul Deadman Pass, che prende il nome da un incidente avvenuto nel 1870 durante la guerra di Bannock, quando un conducente di carri fu trovato morto. Decenni prima, innumerevoli carri avevano attraversato queste colline lungo l'Oregon Trail."

	key[]: "or_cut_395_desc"
	val[]: "Già conosciuta come Three Flags Highway, la US-395 si estendeva dal Canada al Messico, collegando deserti, foreste e montagne. Oggi confluisce nella I-15 in California, ma rimangono dei tratti della strada originale vicino a San Diego."

	key[]: "poi_or2_01"
	val[]: "Foresta Nazionale di Malheur"

	key[]: "poi_or2_01_desc"
	val[]: "La Foresta Nazionale di Malheur si trova nelle Blue Mountains. Più di 150 milioni di anni fa, alcune delle rocce più antiche di questa regione facevano parte delle isole vulcaniche del Pacifico, fondendosi successivamente con il continente."
	
	key[]: "poi_or2_02"
	val[]: "Badlands Wilderness"

	key[]: "poi_or2_02_desc"
	val[]: "Badlands Wilderness, appena a Est di Bend, è un'aspra zona vulcanica modellata da antiche colate laviche e cenere portata dal vento. Le sue formazioni laviche contorte, i terreni sabbiosi e il paesaggio brullo creano uno degli ambienti desertici più unici dello stato."

	key[]: "poi_or2_03"
	val[]: "Lago Abert"

	key[]: "poi_or2_03_desc"
	val[]: "Mappato per la prima volta nel 1843, il lago Abert supporta la presenza umana da oltre 10.000 anni. Sebbene sia troppo salato per i pesci, rimane una tappa fondamentale per gli uccelli lungo la Pacific Flyway. Negli ultimi decenni si è ridotto a causa dei cambiamenti climatici."

	key[]: "poi_or2_04"
	val[]: "East Steens Tour Route"

	key[]: "poi_or2_04_desc"
	val[]: "La East Steens Tour Route segue la Highway 78 lungo il monte Steens e il deserto di Alvord. Il punto di maggior interesse è la playa del deserto di Alvord, uno dei più grandi fondali lacustri asciutti dell'Oregon, che in base alla stagione si trasforma da un lago poco profondo e una vasta pianura desertica."

	key[]: "poi_or2_05"
	val[]: "Doherty Slide"

	key[]: "poi_or2_05_desc"
	val[]: "Ci vuole meno di un'ora di macchina per percorrere il Doherty Slide, una formazione rocciosa nata dall'attività vulcanica. Eppure, la natura ha impiegato circa 16 milioni di anni per modellare il paesaggio come appare oggi."


##########################################################################################

	key[]: "tb_or3"
	val[]: "The Ogden State"

	key[]: "tb_or3_desc"
	val[]: "Questo percorso segue il corridoio nord–sud interno dell'Oregon, passando per foreste e deserti. Esplorata per la prima volta dal commerciante di pellicce Peter Skene Ogden negli anni '20 dell'Ottocento, acquisì poi importanza strategica durante la seconda guerra mondiale per il legname e le vie di trasporto."
	
	key[]: "poi_or3_01"
	val[]: "Springfield Flame"

	key[]: "poi_or3_01_desc"
	val[]: "Alta quasi 20 metri, la scultura segna la porta settentrionale di Springfield, progettata come fiamma per fungere da faro per i viaggiatori e punto di riferimento sia per i residenti che per i visitatori."

	key[]: "poi_or3_02"
	val[]: "Santiam Wagon Road"

	key[]: "poi_or3_02_desc"
	val[]: "Il passo a est di qui, un tempo chiamato Wiley Pass in onore di Andrew Wiley, fu esplorato nel 1859 da pionieri in cerca di nuove rotte per i pascoli. Nel 1864 fu progettata una strada militare, che tuttavia restò incompiuta. Una strada a pedaggio, la Santiam Wagon Road, operò dal 1868 al 1914."

	key[]: "poi_or3_03"
	val[]: "Veteran Historic Highway"

	key[]: "poi_or3_03_desc"
	val[]: "All'ingresso nord dell'autostrada, gli ultimi due dei 18 cartelli commemorativi sono stati installati il 9 novembre 2012, a sud di Biggs Junction. Contrassegnano Camp Rufus come il punto di accesso settentrionale alla prima autostrada del Paese dedicata ai veterani della seconda guerra mondiale."

	key[]: "poi_or3_04"
	val[]: "Ogden State Scenic Viewpoint"

	key[]: "poi_or3_04_desc"
	val[]: "Prende il nome da Peter Skene Ogden, esploratore dei primi anni del XIX secolo e capo commerciante della Hudson’s Bay Company, e rende omaggio alle sue spedizioni attraverso la regione del fiume Snake e al suo ruolo tra i primi ad esplorare il bacino del Gran Lago Salato."

	key[]: "landmark_or_fremont_b_desc"
	val[]: "Il ponte e la Fremont Street di Portland prendono il nome da John C. Frémont, uno dei primi esploratori di Las Californias e del territorio dell'Oregon. Il ponte presenta la campata principale più lunga dell'Oregon e si classifica come il secondo ponte ad arco-tirante più lungo del mondo."

	
##########################################################################################

#@}



#+ California TBs and POIs localization.
#@{
	key[]: "tb_ca1"
	val[]: "Orizzonti dorati"

	key[]: "tb_ca1_desc"
	val[]: "Ponti iconici si ergono sopra acque scintillanti, collegando Alcatraz, Santa Cruz, le colline e le altre zone della regione. Dalle strade trafficate alle spiagge soleggiate, dai siti storici alle coste panoramiche, la Bay Area offre un'esperienza californiana senza pari."

	key[]: "ca_cut_golden_gate_bridge_desc"
	val[]: "Il ponte che collega la baia di San Francisco all'Oceano Pacifico è uno dei simboli più rappresentativi di San Francisco e della California. Quando fu inaugurato nel 1937 deteneva i record sia per il ponte sospeso più lungo che per quello più alto del mondo."

	key[]: "poi_ca1_01"
	val[]: "Alcatraz"

	key[]: "poi_ca1_01_desc"
	val[]: "Dal 1934 al 1963 l'isola di Alcatraz ospitò una prigione federale nota per aver detenuto alcuni dei criminali più famigerati del Paese. Oggi è un sito storico e una popolare meta turistica."

	key[]: "ca_cut_richmond_desc"
	val[]: "Il ponte Richmond-San Rafael attraversa la baia di San Francisco, collegando Richmond e San Rafael. Inaugurato nel 1956, convoglia il traffico della parte settentrionale della baia ed è caratterizzato da una struttura a sbalzo e travatura reticolare, fungendo da importante collegamento per il trasporto regionale."
	
	key[]: "poi_ca1_02"
	val[]: "Treasure Island"

	key[]: "poi_ca1_02_desc"
	val[]: "Treasure Island è un'isola artificiale costruita per la Golden Gate International Exposition nel 1939. Dopo aver svolto la funzione di base navale, ora è in fase di riqualificazione per uso residenziale e commerciale."

	key[]: "poi_ca1_03"
	val[]: "Città del surf"

	key[]: "poi_ca1_03_desc"
	val[]: "La statua del surf di Santa Cruz rende omaggio al patrimonio e alla cultura del surf della città. Installata vicino al lungomare, celebra i surfisti locali e lo sport che ha plasmato l'identità e la comunità costiera di Santa Cruz."

	key[]: "poi_ca1_04"
	val[]: "Madonna Inn"

	key[]: "poi_ca1_04_desc"
	val[]: "Un tempo celebre ristorante e punto di riferimento per eventi in cima alla Highway 152. Chiuso dal 2004 a causa di problemi di viabilità, rimane un argomento frequente nei forum di storia locale e di storie di fantasmi."



##########################################################################################

	key[]: "tb_ca2"
	val[]: "Shasta Route"

	key[]: "tb_ca2_desc"
	val[]: "La Shasta Route si snoda attraverso pinete e scintillanti laghi alpini all'ombra del Monte Shasta. Le strade salgono e scendono tra valli nascoste, trasportando i viaggiatori verso sud mentre le montagne svaniscono gradualmente, lasciando il posto alle antiche sequoie della California settentrionale."

	key[]: "poi_ca2_01"
	val[]: "Foresta Nazionale Shasta-Trinity"

	key[]: "poi_ca2_01_desc"
	val[]: "La Foresta Nazionale Shasta-Trinity, la più grande della California, è attraversata dalla Trinity Heritage Scenic Byway, seguendo i percorsi utilizzati dai cercatori d'oro e dai coloni del XIX secolo."

	key[]: "poi_ca2_02"
	val[]: "Big Lagoon"

	key[]: "poi_ca2_02_desc"
	val[]: "La Big Lagoon è la più grande e la più meridionale delle tre lagune dell'Humboldt Lagoons State Park. Questi bacini costieri poco profondi si trovano tra promontori rocciosi, dove le onde dell'oceano hanno creato barriere sabbiose che separano le lagune dall'Oceano Pacifico."

	key[]: "or_cut_sequoia_desc"
	val[]: "Il Parco Nazionale di Redwood protegge alcune delle sequoie costiere più alte e antiche del mondo, che raggiungono oltre 110 metri e vivono fino a 2.000 anni. Insieme ai vicini parchi dello stato, preserva circa il 35% delle foreste di sequoie secolari rimaste sul pianeta."
	
	key[]: "poi_ca2_03"
	val[]: "Fiume Smith"

	key[]: "poi_ca2_03_desc"
	val[]: "All'interno della Foresta Nazionale Six Rivers, nella California nord-occidentale, quest'area protetta è stata istituita nel 1990 dal Congresso per preservare i valori paesaggistici, ecologici e culturali. Il fiume Smith è l'unico grande fiume non sbarrato e a corso libero della California."

	key[]: "poi_ca2_04"
	val[]: "Ponte di Whiskey Creek"

	key[]: "poi_ca2_04_desc"
	val[]: "Completato nel 1961, il ponte di Whiskey Creek è una struttura a travi composte saldate a tre campate. È noto come uno dei primi esempi di progettazione di ponti che impiegava tre diversi gradi di acciaio, una tecnica di saldatura innovativa all'epoca."

	key[]: "poi_ca2_05"
	val[]: "Lago Shasta"

	key[]: "poi_ca2_05_desc"
	val[]: "Il lago Shasta, il bacino idrico più grande della California, è stato formato dalla diga Shasta sul fiume Sacramento. Completato nel 1945, fornisce acqua, energia idroelettrica e un luogo panoramico per attività ricreative."

	key[]: "poi_ca2_06"
	val[]: "Monte Shasta"

	key[]: "poi_ca2_06_desc"
	val[]: "Sin dal 1820 il monte Shasta, la seconda vetta più alta della Cascade Range, guidava i viaggiatori lungo il Siskiyou Trail alla sua base. Successivamente quel percorso si è evoluto nella Interstate 5, che ora permette a migliaia di persone di raggiungere la montagna ogni anno."



##########################################################################################

	key[]: "tb_ca3"
	val[]: "Sierra Crossing"

	key[]: "tb_ca3_desc"
	val[]: "Sotto l'imponente Sierra Nevada, tra valli aperte e dolci colline si trova l'Inn at Benton. Il Sierra Crossing si snoda lungo tranquille strade desertiche, dove cime lontane e creste frastagliate creano un panorama senza tempo, invitando i viaggiatori a esplorare gli ampi paesaggi della regione."

	key[]: "ca_cut_olmsted_point_desc"
	val[]: "Fondato nel 1890, il Parco Nazionale di Yosemite è uno dei parchi più visitati. È noto per le cascate di Yosemite, le più alte del Nord America, per l'estesa rete di sentieri e per le sequoie giganti risalenti a oltre 3.000 anni fa."

	key[]: "poi_ca3_01"
	val[]: "Tioga Road"

	key[]: "poi_ca3_01_desc"
	val[]: "La Tioga Road è un iconico percorso panoramico che attraversa il cuore del Parco Nazionale di Yosemite. È il valico autostradale più alto della California e collega il versante occidentale e quello orientale della Sierra Nevada."

	key[]: "poi_ca3_02"
	val[]: "Lago Mono"

	key[]: "poi_ca3_02_desc"
	val[]: "Il lago Mono ha più di 1 milione di anni, il che lo rende uno dei più antichi del Nord America. Privo di uno sbocco naturale, nel corso di migliaia di anni ha accumulato sali e minerali trasportati dai corsi d'acqua provenienti dalla Sierra Nevada orientale."
	
	key[]: "poi_ca3_03"
	val[]: "Lago Tahoe"

	key[]: "poi_ca3_03_desc"
	val[]: "Il lago Tahoe si è formato circa 2 milioni di anni fa all'interno del bacino del Tahoe e la sua forma attuale è stata scolpita dai ghiacciai dell'era glaciale. È il lago alpino più grande del Nord America e il secondo più profondo degli Stati Uniti."

	key[]: "poi_ca3_04"
	val[]: "Foresta Nazionale di Eldorado"

	key[]: "poi_ca3_04_desc"
	val[]: "La Foresta Nazionale di Eldorado fa parte di un importante bacino idrografico che fornisce acqua a milioni di californiani e sostiene le aziende agricole che producono quasi la metà della frutta e verdura del Paese."

	key[]: "poi_ca3_05"
	val[]: "Inn at Benton Hot Springs"

	key[]: "poi_ca3_05_desc"
	val[]: "Benton, una delle città più antiche della contea di Mono, è stata fondata dal popolo Paiute utilizzando le sue sorgenti termali. Negli anni '60 dell'Ottocento divenne una tappa per coloni e minatori. La locanda (Inn), costruita negli anni '40 con pomice locale, sostituì un hotel del 1904 con 10 camere che condividevano un bagno."



##########################################################################################

	key[]: "tb_ca4"
	val[]: "Sole e sabbia"

	key[]: "tb_ca4_desc"
	val[]: "Il deserto della Valle della Morte si estende sotto cieli infiniti, con dune, cime frastagliate e pianure screpolate. Le lepri saltellano sulla sabbia illuminata dal sole, i teschi segnano passaggi silenziosi e le strade isolate si snodano attraverso un ambiente aspro e spietato che mette alla prova e stupisce chiunque vi si avventuri."

	key[]: "poi_ca4_01"
	val[]: "Lone Pine"

	key[]: "poi_ca4_01_desc"
	val[]: "Lone Pine è una piccola cittadina nella Owens Valley in California, alla base orientale della Sierra. Conosciuta per le vicine Alabama Hills, è servita a lungo come porta d'accesso per escursionisti, alpinisti e registi che esplorano le montagne circostanti e i paesaggi desertici."

	key[]: "poi_ca4_02"
	val[]: "Parco Nazionale della Valle della Morte"

	key[]: "poi_ca4_02_desc"
	val[]: "La Valle della Morte è uno dei luoghi più estremi d'America: in alcuni punti è il più basso, il più caldo, il più secco o perfino il più alto. Molto prima dei pionieri del 1800, le tribù indigene vivevano qui, cacciando e raccogliendo in questa regione tanto aspra quanto ricca di storia."

	key[]: "poi_ca4_03"
	val[]: "Father Crowley Vista Point"

	key[]: "poi_ca4_03_desc"
	val[]: "Questo punto panoramico è una tappa popolare per i viaggiatori. Padre John J. Crowley, il Padre del Deserto, si fermava spesso qui. Vicino al confine occidentale del parco, offre vedute suggestive sul Rainbow Canyon, una formazione modellata dall'antica attività vulcanica."
	
	key[]: "poi_ca4_04"
	val[]: "Pozzi della valle del Mojave"

	key[]: "poi_ca4_04_desc"
	val[]: "Nei pozzi della valle del Mojave, gli antichi depositi di scarico delle acque sotterranee ci parlano di antiche aree umide riconducibili all'era glaciale. Questi pozzi storici rivelano come un tempo le acque sotterranee alimentassero paludi e vegetazione lussureggiante in un deserto altrimenti arido."

	key[]: "poi_ca4_05"
	val[]: "Riserva indiana del fiume Colorado"

	key[]: "poi_ca4_05_desc"
	val[]: "La riserva si estende lungo il fiume Colorado in Arizona e California. Fondato nel 1865 per le tribù del fiume, ospita i popoli Mohave, Chemehuevi, Hopi e Navajo e oggi sostiene l'agricoltura e la vita comunitaria."

##########################################################################################

#@}



#+ Idaho TBs and POIs localization.
#@{

    key[]: "tb_id1"
	val[]: "Treasure Valley"

	key[]: "tb_id1_desc"
	val[]: "La Treasure Valley, nell'Idaho sud-occidentale, vanta una ricca storia plasmata dalle tribù dei nativi americani, dai primi commercianti di pellicce e dai coloni dell'Oregon Trail. Il suo nome riflette le risorse e le opportunità della zona e in seguito crebbe grazie all'agricoltura, alle ferrovie e al commercio regionale incentrato su Boise."

	key[]: "poi_id1_01"
	val[]: "Fiume Salmon"

	key[]: "poi_id1_01_desc"
	val[]: "Il fiume Salmon nell'Idaho si estende per 425 miglia attraverso un canyon profondo e accidentato. Si guadagnò il soprannome di “Fiume del Non Ritorno” perché le prime imbarcazioni non erano in grado di risalire il fiume a causa delle sue correnti forti e insidiose."

	key[]: "poi_id1_02"
	val[]: "Foresta Nazionale di Boise"

	key[]: "poi_id1_02_desc"
	val[]: "Estendendosi lungo l'erodibile batolite dell'Idaho, la Foresta Nazionale di Boise presenta un paesaggio aspro, forgiato dall'attività vulcanica. Questo patrimonio geologico è visibile nei suoi ripidi canyon e nelle numerose sorgenti termali naturali nascoste in tutta l'area."

	key[]: "poi_id1_03"
	val[]: "Horseshoe Bend"

	key[]: "poi_id1_03_desc"
	val[]: "Dopo il ritrovamento dell'oro nel bacino di Boise nel 1862, i minatori che svernavano lungo il fiume fondarono Horseshoe Bend. Originariamente chiamata Warrinersville in onore del proprietario di una segheria locale, la città assunse il suo nome attuale nel 1867, diventando una tappa fondamentale per i cercatori d'oro."
	
	key[]: "poi_id1_04"
	val[]: "Stazione di pedaggio"

	key[]: "poi_id1_04_desc"
	val[]: "Nel 1864, un nuovo percorso del canyon sostituì il ripido sentiero Syrup Creek. Per 20 anni, i pedaggi ne finanziarono la manutenzione, mentre il famoso hotel e caseificio di James A. Porter divenne una tappa fondamentale per i viaggiatori in cerca di rifugio."

	key[]: "poi_id1_05"
	val[]: "Castle Rock"

	key[]: "poi_id1_05_desc"
	val[]: "Verso la Camas Prairie, gli affioramenti granitici di Castle Rock sono diventati punti di riferimento iconici per gli emigranti dell'Oregon Trail che percorrevano il Goodale's Cutoff. Utilizzate dal 1862 fino all'avvento delle automobili, queste rare formazioni offrivano ai viaggiatori uno spettacolo suggestivo lungo il percorso."

    key[]: "poi_id1_06"
	val[]: "Riserva indiana della Duck Valley"

	key[]: "poi_id1_06_desc"
	val[]: "Nel 1886, il presidente Cleveland estese la Duck Valley nell'Idaho tramite la \"Paddy Cap Extension\". Nel 1934, i vari gruppi che si trasferirono nella riserva ottennero il riconoscimento federale ufficiale come tribù Shoshone-Paiute unificate."


##########################################################################################

    key[]: "tb_id2"
	val[]: "Magic Valley"

	key[]: "tb_id2_desc"
	val[]: "Nei primi anni del 1900, I.B. Perrine trasformò il deserto arido dell'Idaho in terreni agricoli costruendo la diga Milner. Completata nel 1905, la diga sfruttava l'acqua del fiume Snake per trasformare \"magicamente\" il paesaggio. Da qui nacque la Magic Valley, che diede vita alle fiorenti città agricole che esistono ancora oggi."

	key[]: "id_cut_perrine_desc"
	val[]: "Con i loro 65 metri, le cascate Shoshone sono più alte delle cascate del Niagara e rappresentano uno splendido punto di riferimento del fiume Snake, situato proprio ai margini delle Twin Falls."

	key[]: "id_cut_galena_desc"
	val[]: "Fondata nel 1879 dopo la scoperta del piombo-argento, questa città mineraria scomparve nel 1890 a causa del calo dei prezzi. Oggi la zona prospera come centro turistico e ospita lo storico Galena Lodge e il vicino e panoramico Galena Summit."

	key[]: "poi_id2_01"
	val[]: "Bison Jump"

	key[]: "poi_id2_01_desc"
	val[]: "Situato a Challis, il Bison Jump era il luogo dove gli indigeni cacciavano i bufali spingendoli a precipitare dalle sulle scogliere. Utilizzato da oltre 2.000 anni, questo sito storico offre uno scorcio sulle antiche tradizioni di caccia comunitarie."
	
	key[]: "poi_id2_02"
	val[]: "Grand View Canyon"

	key[]: "poi_id2_02_desc"
	val[]: "Situato lungo la Peaks to Craters Scenic Byway sulla US-93, il Grand View Canyon offre vedute mozzafiato sulla Lost River Range. Questa catena montuosa ospita nove delle vette più alte dell'Idaho, rendendo il canyon il punto culminante del percorso panoramico."

	key[]: "landmark_id_mackay_rs_desc"
	val[]: "Originariamente chiamato Goddin's River dal nome del cacciatore di pellicce Thyery Goddin, il Big Lost River è famoso per sprofondare nei letti di lava. Quest'acqua \"perduta\" viaggia sottoterra, riemergendo infine nelle spettacolari Thousand Springs vicino al fiume Snake."

    key[]: "poi_id2_03"
	val[]: "Città Fantasma di Mackay"

	key[]: "poi_id2_03_desc"
	val[]: "Situate nella \"Mine Hill\" nel distretto minerario di White Knob, città come White Knob e Cliff Creek alimentarono un boom di rame, oro e argento fino alla metà del XX secolo. Questi siti sono quel che resta della storica industria mineraria dell'Idaho."

	key[]: "id_cut_craters_desc"
	val[]: "Formatisi in seguito a eruzioni vulcaniche 15.000 anni fa, i Crateri della Luna presentano un vasto paesaggio di colate laviche e coni di cenere. Il suo territorio ultraterreno è così unico che un tempo gli astronauti della NASA lo utilizzavano per addestrarsi alle missioni sulla Luna."



##########################################################################################

#@}



#+ Montana TBs and POIs localization.
#@{

    key[]: "tb_mt1"
	val[]: "Glacier Passage"

	key[]: "tb_mt1_desc"
	val[]: "Glacier Country ospita alcuni degli ultimi ghiacciai attivi delle Montagne Rocciose. Nel corso di migliaia di anni, queste antiche masse di ghiaccio hanno scavato profonde valli, picchi aguzzi e laghi incontaminati, plasmando il paesaggio che oggi definisce il Montana occidentale."

	key[]: "poi_mt1_01"
	val[]: "Kootenai Falls"

	key[]: "poi_mt1_01_desc"
	val[]: "Le Kootenai Falls sono le più grandi cascate prive di sbarramenti del Montana e un'importante attrazione regionale. Il fiume Kootenai precipita per circa 90 metri in un breve tratto, creando una cascata potente e panoramica che attira i visitatori per il suo panorama indimenticabile."

	key[]: "poi_mt1_02"
	val[]: "Berne Roadside Park"

	key[]: "poi_mt1_02_desc"
	val[]: "Bad Rock Canyon era una tappa da non perdere per i viaggiatori lungo il fiume Flathead, noto per la pesca, il panorama e una sorgente naturale un tempo utilizzata per raffreddare i radiatori surriscaldati delle auto. Nel 1956 divenne una delle prime aree di sosta del Montana col nome di Berne Roadside Park."

	key[]: "poi_mt1_03"
	val[]: "Heaven's Peak"

	key[]: "poi_mt1_03_desc"
	val[]: "Heaven's Peak, una delle montagne più iconiche del Glacier National Park, fu chiamata così nel 1890 dal cercatore d'oro Louie Meyer. Colpiti dalla sua bellezza e dall'imponente Garden Wall, gli esploratori lo considerarono diverso da qualsiasi cosa avessero incontrato durante il loro viaggio."

	key[]: "mt_cut_glacier_national_park_desc"
	val[]: "Celebrato come la \"Corona del Continente\", il Parco Nazionale dei Ghiacciai fu istituito nel 1910. Modellato da antichi ghiacciai, ottenne un accesso più ampio nel 1932 con il completamento della Going-to-the-Sun Road, ora uno storico punto di riferimento ingegneristico."

	key[]: "poi_mt1_04"
	val[]: "Blackfeet Indian Memorial"

	key[]: "poi_mt1_04_desc"
	val[]: "All'estremità orientale del Parco Nazionale dei Ghiacciai si trova la Blackfeet Nation. Conosciuti come i \"guerrieri delle pianure\", si ritiene che il loro nome derivi dai mocassini scuri di cenere. Oggi diversi siti del parco rimangono sacri per la tribù."

	key[]: "mt_cut_flathead_lake_desc"
	val[]: "Il lago Flathead è il più grande lago naturale d'acqua dolce per superficie di tutti gli Stati Uniti. Alimentato dallo scioglimento delle nevi delle montagne circostanti, le sue acque eccezionalmente limpide si rinnovano completamente nel giro di pochi anni, rendendolo uno dei grandi laghi più puliti al mondo."

	key[]: "mt_cut_thompson_falls_desc"
	val[]: "La città, che prende il nome dal commerciante di pellicce e cartografo canadese David Thompson, crebbe dopo l'arrivo della ferrovia nel 1881. Si espanse ulteriormente durante la corsa all'oro della vicina Coeur d'Alene, diventando una tappa fondamentale per i minatori che percorrevano il Murray Trail."

	key[]: "landmark_mt_missoula_desc"
	val[]: "Il tribunale neoclassico della contea di Missoula, costruito in arenaria e progettato da A. J. Gibson nel 1910, sostituì una precedente struttura più piccola. La contea di Missoula, fondata nel 1860, è una delle regioni politiche più antiche del Montana e si estende dal Bitterroot alle Montagne Rocciose."

    key[]: "poi_mt1_05"
	val[]: "Lolo Creek"

	key[]: "poi_mt1_05_desc"
	val[]: "La strada tra Lolo e Lolo Pass segue un tracciato storico lungo il Lolo Creek. Un tempo percorso dai Nez Perce, dai primi coloni e dalla spedizione di Lewis e Clark, oggi continua a rappresentare un'area di importanza storica e culturale."

##########################################################################################

    key[]: "tb_mt2"
	val[]: "Grandi Pianure"

	key[]: "tb_mt2_desc"
	val[]: "Le Grandi Pianure del Montana si estendono nella parte orientale dello stato e sono caratterizzate da vaste distese erbose, praterie ondulate e grandi orizzonti. La regione ha restituito alcuni dei fossili di dinosauri più importanti del Nord America, offrendo uno sguardo su un paesaggio che esisteva milioni di anni fa."

	key[]: "poi_mt2_01"
	val[]: "Formazione Hell Creek"

	key[]: "poi_mt2_01_desc"
	val[]: "La Formazione Hell Creek, il cui centro si trova lungo l'Hell Creek vicino a Jordan, nel Montana, comprende formazioni di un antico paesaggio subtropicale di fiumi, foreste e paludi. Risalente a 66–67 milioni di anni fa, è famosa in tutto il mondo per la quantità di fossili di dinosauro, tra cui l'iconico Tyrannosaurus rex."

	key[]: "poi_mt2_02"
	val[]: "Fiume Yellowstone"

	key[]: "poi_mt2_02_desc"
	val[]: "Lo Yellowstone è il fiume a corso libero più lungo degli Stati Uniti contigui. Nasce nel Parco Nazionale di Yellowstone e percorre circa 1.100 km attraverso il Wyoming e il Montana prima confluire nel fiume Missouri, scorrendo per tutta la sua lunghezza senza una sola diga."

	key[]: "poi_mt2_03"
	val[]: "Glendisaurus"

	key[]: "poi_mt2_03_desc"
	val[]: "Glendisaurus, una statua di Triceratopo a grandezza naturale situata a Glendive, celebra il ricco patrimonio di dinosauri della regione. Alto circa 3 metri, è una delle attrazioni principali del Dinosaur Trail."
	
	key[]: "poi_mt2_04"
	val[]: "Fiume Missouri"

	key[]: "poi_mt2_04_desc"
	val[]: "Conosciuto come \"Big Muddy\", il fiume Missouri è il più lungo degli Stati Uniti. Scorre per circa 3.700 km dalle Montagne Rocciose del Montana al fiume Mississippi. Nel corso degli anni ha svolto un ruolo fondamentale nell'esplorazione, nel commercio e nell'espansione verso ovest della frontiera americana."

	key[]: "mt_cut_fort_peck_spillway_desc"
	val[]: "La diga di Fort Peck, costruita durante la Grande Depressione, è la più grande diga in terra con riempimento idraulico del mondo e rappresenta uno dei più importanti progetti di opere pubbliche degli Stati Uniti, essendo concepita per creare posti di lavoro, controllare le inondazioni e generare energia idroelettrica."

    key[]: "poi_mt2_05"
	val[]: "Valley County Pioneer Museum"

	key[]: "poi_mt2_05_desc"
	val[]: "Questo museo racconta la storia del Montana nordorientale attraverso mostre sul popolo Assiniboine, sulle ferrovie, sull'agricoltura, sulla diga di Fort Peck e sulla spedizione di Lewis e Clark. Ospita inoltre vasti archivi e una delle più grandi collezioni Assiniboine del Paese."

	key[]: "poi_mt2_06"
	val[]: "Sleeping Buffalo Rock"

	key[]: "poi_mt2_06_desc"
	val[]: "Questi grandi massi, levigati e trasportati da antichi ghiacciai, erano considerati sacri dalle tribù indigene. La roccia più piccola, \"Buffalo Rock\", fu scolpita in modo da assomigliare a un bisonte, mentre quella più grande, \"Medicine Rock\", presenta vari petroglifi."



##########################################################################################

#@}



#+ Wyoming TBs and POIs localization.
#@{

    key[]: "tb_wy1"
	val[]: "Buffalo Trail"

	key[]: "tb_wy1_desc"
	val[]: "Sede di Yellowstone e del Grand Teton, sorge su un sistema vulcanico attivo che alimenta geyser e sorgenti termali, mentre ghiacciai e faglie ne hanno plasmato le vette e le valli. Insieme, queste forze rendono il Wyoming nordoccidentale uno dei paesaggi geologicamente più dinamici e visivamente iconici del West americano."

	key[]: "landmark_wy_yellowsto_desc"
	val[]: "Yellowstone, istituito nel 1872 come primo parco nazionale al mondo, sorge sulla cima di un enorme vulcano dormiente. Ospita circa la metà dei geyser attivi del mondo e protegge anche uno degli ecosistemi temperati più grandi e intatti della Terra."

	key[]: "poi_wy1_01"
	val[]: "Lower Geyser Basin"

	key[]: "poi_wy1_01_desc"
	val[]: "Il Lower Geyser Basin è il più grande bacino di geyser di Yellowstone, caratterizzato da una vasta concentrazione di geyser, sorgenti termali e fumarole. Alimentato dal calore del magma situato in profondità, offre uno dei paesaggi geotermici più attivi del parco."

	key[]: "poi_wy1_02"
	val[]: "Lago Yellowstone"

	key[]: "poi_wy1_02_desc"
	val[]: "Il lago Yellowstone è il lago d'alta quota più grande del Nord America e ospita la più grande popolazione di trote iridee selvatiche del continente. Gli scienziati ritengono che un tempo defluisse verso l'Oceano Pacifico, consentendo ai pesci di attraversare il Continental Divide attraverso il Two Ocean Pass."
	
	key[]: "poi_wy1_03"
	val[]: "Buffalo Bill Dam"

	key[]: "poi_wy1_03_desc"
	val[]: "Completata nel 1910, la diga di Buffalo Bill è stata una delle prime dighe ad arco in calcestruzzo degli Stati Uniti. Alta circa 100 metri, all'epoca era la più alta del mondo, divenne ben presto uno dei simboli delle prime innovazioni ingegneristiche."

	key[]: "poi_wy1_04"
	val[]: "Colter's Hell"

	key[]: "poi_wy1_04_desc"
	val[]: "Colter's Hell è una storica area geotermica lungo il fiume Shoshone, così chiamata dall'esploratore John Colter nel 1807 per via delle sue fumarole e l'intenso odore di zolfo, che riportavano alla mente \"l'inferno\". Oggi rimangono attive solo le sorgenti termali e le fumarole."

	key[]: "wy_cut_grand_teton_desc"
	val[]: "Il Parco Nazionale del Grand Teton è caratterizzato dalle vette scolpite dai ghiacciai che si innalzano impervie sopra Jackson Hole. Facilmente distinguibili dalle pianiure, un tempo queste montagne erano chiamate \"Pilot Knobs\" dai cacciatori di pellicce. Oggi sono tra i simboli naturalistici più iconici del West americano."

	key[]: "poi_wy1_05"
	val[]: "Crowheart Butte"

	key[]: "poi_wy1_05_desc"
	val[]: "Crowheart Butte è un importante luogo di interesse storico che deve il nome a una battaglia tra le tribù Shoshone e Crow avvenuta nel 1866. Secondo la tradizione, il vittorioso capo degli Shoshone, Washakie, depose il cuore di uno dei capitribù Crow in cima alla collina come ammonimento, dando alla formazione il suo nome attuale."

##########################################################################################

    key[]: "tb_wy2"
	val[]: "Deserto Rosso"

	key[]: "tb_wy2_desc"
	val[]: "Il Deserto Rosso del Wyoming è un vasto bacino desertico situato a notevole altitudine e caratterizzato da sabbia spazzata dal vento, distese di artemisia e suggestive formazioni rocciose rosse. Tra le più grandi aree disabitate del Nord America, è modellato da un clima estremo, antichi fondali lacustri e lunghe rotte migratorie."

	key[]: "poi_wy2_01"
	val[]: "Red Canyon"

	key[]: "poi_wy2_01_desc"
	val[]: "Il Red Canyon venne scavato durante il sollevamento della catena del Wind River circa 60 milioni di anni fa. Le sue caratteristiche pareti rosse sono formate dalla roccia di Chugwater, il cui ferro ossidato conferisce al canyon il colore vivido che ha dato origine al suo nome."

	key[]: "poi_wy2_02"
	val[]: "Paesaggi di potere"

	key[]: "poi_wy2_02_desc"
	val[]: "Boar's Tusk, una formazione rocciosa vulcanica che si erge per oltre 120 metri sopra il Deserto Rosso del Wyoming, è il nucleo eroso di un vulcano formatosi milioni di anni fa. Si affaccia sulle vaste Dune di Sabbia di Killpecker, la più grande distesa di dune di sabbia degli Stati Uniti."

	key[]: "poi_wy2_03"
	val[]: "Rock Springs"

	key[]: "poi_wy2_03_desc"
	val[]: "Rock Springs è conosciuta come la \"Città delle 56 nazionalità\" per il variegato afflusso di immigrati che, verso la fine del 1800, arrivarono da tutto il mondo per lavorare nelle miniere di carbone della Union Pacific. La città è anche legata al famoso fuorilegge Butch Cassidy."
	
	key[]: "poi_wy2_04"
	val[]: "Capanna di Butch Cassidy"

	key[]: "poi_wy2_04_desc"
	val[]: "Butch Cassidy era un famoso fuorilegge americano a capo del \"Wild Bunch\", un gruppo organizzato di criminali noto per le rapine ai treni e alle banche nel Vecchio West. Si guadagnò il soprannome \"Butch\" mentre lavorava in una macelleria di Rock Springs. La sua rapina più leggendaria fu quella al treno di Wilcox nel 1899."

	key[]: "wy_cut_evanston_desc"
	val[]: "Fondata nel 1869 dalla Union Pacific Railroad, Evanston prende il nome dall'ingegnere James A. Evans. La città crebbe come snodo ferroviario e in seguito divenne un centro regionale per l'agricoltura, il petrolio e il gas."

    key[]: "poi_wy2_05"
	val[]: "Lander Cutoff"

	key[]: "poi_wy2_05_desc"
	val[]: "Costruita in seguito al Pacific Wagon Road Act del 1857, la Lander Cutoff è stata una delle prime strade carrabili finanziate a livello federale nel West americano. Prende il nome dall'ingegnere Frederick W. Lander e forniva un percorso più breve per i migranti diretti a ovest."

	

##########################################################################################

#@}


#+ South Dakota TBs and POIs localization.
#@{

    key[]: "tb_sd1"
	val[]: "Black Hills"

	key[]: "tb_sd1_desc"
	val[]: "Il South Dakota occidentale è caratterizzato dalle Black Hills e dalle Badlands. Qui, vaste praterie si innalzano in montagne ricoperte di pini, guglie di granito e mandrie di bisonti. Poco oltre, le aspre Badlands rivelano uno straordinario paesaggio scolpito dal vento e dall'acqua nel corso di milioni di anni."

	key[]: "poi_sd1_01"
	val[]: "Foresta Nazionale delle Black Hills"

	key[]: "poi_sd1_01_desc"
	val[]: "Chiamata dai Lakota col nome di Paha Sapa, \"colline nere\", questa regione ricoperta di pini ospita il Black Elk Peak, il punto più alto del South Dakota, con i suoi 2.200 metri di altitudine. Rinominata in onore del famoso guaritore Lakota, è anche la vetta più alta a est delle Montagne Rocciose."

	key[]: "sd_cut_rush_desc"
	val[]: "Il Monte Rushmore, denominato anche \"Santuario della Democrazia\", fu scavato nelle Black Hills tra il 1927 e il 1941. Il monumento presenta sculture alte 18 metri raffiguranti i presidenti Washington, Jefferson, Roosevelt e Lincoln, che rappresentano la nascita, la crescita, lo sviluppo e la conservazione del Paese."

	key[]: "poi_sd1_02"
	val[]: "Ponte di Beaver Creek"

	key[]: "poi_sd1_02_desc"
	val[]: "Costruito nel 1929, questo ponte ad arco in acciaio e calcestruzzo, lungo circa 70 metri, attraversa un canyon vicino al Parco Nazionale di Wind Cave. Con i suoi 35 metri di altezza è l'unico ponte del South Dakota nel suo genere ed è stato progettato per integrarsi perfettamente con la roccia circostante."

	key[]: "sd_cut_sturgis_desc"
	val[]: "Sturgis è nota per il più grande raduno motociclistico del mondo. Organizzato per la prima volta nel 1938 da Pappy Hoel, un concessionario indiano del luogo, questo evento annuale dura 10 giorni e richiama motociclisti da tutto il mondo sulle Black Hills per esibizioni, gare, musica e festeggiamenti."

	key[]: "sd_cut_deadwood_desc"
	val[]: "Deadwood sorse durante la corsa all'oro delle Black Hills del 1876 e divenne una delle città più famose del selvaggio West. Nominata monumento storico nazionale nel 1961, è l'unica città degli Stati Uniti ad avere tale status, preservando gran parte del suo centro storico."

	key[]: "sd_cut_badlands_desc"
	val[]: "Il Parco Nazionale delle Badlands si estende su 244.000 acri di colline, pinnacoli e guglie, lungo la più grande prateria protetta del Paese. Conserva inoltre uno dei giacimenti di fossili più ricchi del mondo, rivelando gli antichi mammiferi che un tempo popolavano le Grandi Pianure."

	key[]: "poi_sd1_03"
	val[]: "Doane Robinson Tunnel"

	key[]: "poi_sd1_03_desc"
	val[]: "Doane Robinson, noto come il \"padre del Monte Rushmore\", immaginò un grande monumento nelle Black Hills per attirare visitatori nel South Dakota. La sua eredità continua ancora oggi, con il Monte Rushmore perfettamente incorniciato attraverso il suggestivo Doane Robinson Tunnel."

	key[]: "sd_cut_hot_springs_desc"
	val[]: "Hot Springs, originariamente chiamata Minnekahta dai Sioux per le sue \"acque calde\", nacque nel 1879 attorno alle sorgenti minerali che si riteneva avessero poteri curativi. Rinominata nel 1882, divenne un centro benessere e rimane noto per lo storico Evans Plunge."

	key[]: "poi_sd1_04"
	val[]: "Mammoth Site"

	key[]: "poi_sd1_04_desc"
	val[]: "Il Mammoth Site è uno scavo fossile dell'era glaciale famoso in tutto il mondo in cui sono stati rinvenuti 61 mammut. Scoperta nel 1974, l'antica dolina conserva la più grande collezione di resti di mammut colombiani del Nord America. Ad oggi, gli scavi sono ancora in corso."

##########################################################################################

    key[]: "tb_sd2"
	val[]: "Great Divide"

	key[]: "tb_sd2_desc"
	val[]: "La regione del fiume Missouri nel South Dakota segna la divisione centrale dello stato, con ampie pianure da un lato e dolci colline dall'altro. Fu un corridoio essenziale per le nazioni dei nativi, i commercianti di pellicce e Lewis e Clark, e in seguito divenne sede di importanti dighe, città di frontiera e ricca storia fluviale."

	key[]: "poi_sd2_01"
	val[]: "I quattro Grandi Laghi"

	key[]: "poi_sd2_01_desc"
	val[]: "Creati dalle dighe sul fiume Missouri alla fine degli anni '40, i laghi Oahe, Sharpe, Francis Case e Lewis & Clark definiscono oggi il South Dakota centrale. Insieme, questi bacini idrici forniscono più di 700 km di costa per la nautica da diporto, la pesca e le attività ricreative."

	key[]: "poi_sd2_02"
	val[]: "Città Fantasma di Bangor"

	key[]: "poi_sd2_02_desc"
	val[]: "Bangor un tempo era il capoluogo della contea di Walworth, ma divenne una città fantasma dopo che i suoi edifici furono trasferiti nella vicina Selby nel 1899. Oggi solo un monumento commemora il luogo in cui un tempo sorgeva la città."

	key[]: "landmark_sd_state_capitol_desc"
	val[]: "Fondata nel 1880, Pierre divenne la capitale del South Dakota quando lo stato aderì all'Unione nel 1889. Scelta per la sua posizione centrale e per l'attraversamento del fiume Missouri, la città prende il nome dal commerciante di pellicce franco-americano Pierre Chouteau Jr."

	key[]: "sd_cut_corn_desc"
	val[]: "Il Corn Palace di Mitchell è l'unico palazzo al mondo decorato interamente con mais. Ogni anno, artisti e agricoltori locali creano nuovi murales utilizzando mais colorato naturalmente, cereali ed erbe, rendendolo uno dei monumenti più originali del South Dakota."

	key[]: "landmark_sd_largest_pheasant_desc"
	val[]: "Huron ospita il fagiano più grande del mondo, una scultura in fibra di vetro e acciaio alta 12 metri costruita nel 1959. Con un peso di 22 tonnellate, celebra la reputazione di lunga data della regione come una delle principali destinazioni americane per la caccia al fagiano."

	key[]: "landmark_sd_dignity_of_earth_and_sky_desc"
	val[]: "Dignity Of Earth & Sky è una scultura in acciaio inossidabile alta 15 metri che, vicino a Chamberlain, domina il fiume Missouri. Creata dall'artista Dale Lamphere, rende omaggio alla tradizione, alla resilienza e alle culture dei popoli Lakota e Dakota."

