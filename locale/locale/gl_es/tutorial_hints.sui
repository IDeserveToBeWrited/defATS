
    key[]: "hint_engine_title"
	val[]: "Arrancar o motor"

    key[]: "hint_engine_text"
	val[]: "Usa $KEY_engine$ para arrancar o motor."


    key[]: "hint_ignition_title"
	val[]: "Activar o contacto"

    key[]: "hint_ignition_text"
	val[]: "Usa $KEY_engineelect|KEY_engine$ para activar o contacto."


    key[]: "hint_driv_arc_title"
	val[]: "Conducir"

    key[]: "hint_driv_arc_text"
	val[]: "Usa $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ e $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ para avanzar ou retroceder.<br><offset vshift=8>Usa $SPECIAL_steering$ para xirar."


    key[]: "hint_driv_auto_title"
	val[]: "Conducir"

    key[]: "hint_driv_auto_text"
	val[]: "Usa $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ e $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ para avanzar ou retroceder.<br><offset vshift=8>Usa $SPECIAL_steering$ para xirar.<br><offset vshift=8>Preme $KEY_gearup$ e $KEY_geardown$ para seleccionar as marchas."


    key[]: "hint_driv_seq_title"
	val[]: "Conducir"

    key[]: "hint_driv_seq_text"
	val[]: "Usa $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ e $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ para avanzar ou retroceder.<br><offset vshift=8>Usa $SPECIAL_steering$ para xirar.<br><offset vshift=8>Preme $KEY_gearup$ e $KEY_geardown$ para controlar o embrague."


    key[]: "hint_driv_hshift_title"
	val[]: "Conducir"

    key[]: "hint_driv_hshift_text"
	val[]: "Usa $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ e $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ para avanzar ou retroceder.<br><offset vshift=8>Usa $SPECIAL_steering$ para xirar.<br><offset vshift=8>Cambia de marchas coa <color value=@@clr_sel@@>panca<color value=@@clr_txt@@>."


    key[]: "hint_depot_deliv_title"
    val[]: "Achegarse ao destino"

    key[]: "hint_depot_deliv_text"
    val[]: "Detente na área marcada para seleccionar a dificultade do aparcamento final e obtén a experiencia correspondente."


    key[]: "hint_fin_deliv_title"
    val[]: "Finalizar a entrega"

    key[]: "hint_fin_deliv_text"
    val[]: "Aparca na praza de aparcamento seleccionada. Podes premer $KEY_activate$ para saltar a manobra cando esteas cerca do punto de entrega."


    key[]: "hint_fin_deliv2_title"
    val[]: "Finalizar a entrega"

    key[]: "hint_fin_deliv2_text"
    val[]: "Aparca na praza de aparcamento seleccionada. Podes activar un widget en @@desktop_menu_category_options@@ para permitirte saltar a manobra de aparcamento."


    key[]: "hint_lights_title"
    val[]: "Acender as luces"

    key[]: "hint_lights_text"
    val[]: "Usa $KEY_light$ para acender as luces. Prémeo varias veces para alternar entre distintos modos."


    key[]: "hint_high_beam_title"
    val[]: "Activar as luces de longo alcance"

    key[]: "hint_high_beam_text"
    val[]: "Usa $KEY_hblight$ para poñer as luces de longo alcance."


    key[]: "hint_wipers_title"
    val[]: "Activar os limpaparabrisas"

    key[]: "hint_wipers_text"
    val[]: "Usa $KEY_wipers$ para activar os limpaparabrisas e para alternar entre as distintas velocidades."


    key[]: "hint_zoom_title"
    val[]: "Mirar de cerca"

    key[]: "hint_zoom_text"
    val[]: "Usa $KEY_camzoom$ para facer zoom na vista interior. Podes configurar o seu modo de funcionamento (manter premido ou pulsación única) en @@desktop_menu_category_options@@."


    key[]: "hint_cam_int_title"
    val[]: "Mirar arredor"

    key[]: "hint_cam_int_text"
    val[]: "Usa $KEY_cam1$ para cambiar a cámara á vista interior."


    key[]: "hint_cam_ext_title"
    val[]: "Mirar arredor"

    key[]: "hint_cam_ext_text"
    val[]: "Podes alternar entre distintas cámaras premendo $KEY_camcycle$.<br><offset vshift=8>Usa $KEY_cam2$ para cambiar á cámara exterior."


    key[]: "hint_indicators_title"
    val[]: "Intermitentes"

    key[]: "hint_indicators_text"
    val[]: "Usa $KEY_lblinker$ e $KEY_rblinker$ para activar os intermitentes."


    key[]: "hint_tow_title"
    val[]: "Servizo de remolque"

    key[]: "hint_tow_text"
    val[]: "Se non podes saír dunha situación complicada, podes usar o servizo de remolque. Para acceder a el, abre o menú de @@quick_info_word@@ usando $KEY_advmouse$."


    key[]: "hint_diff_lock_title"
    val[]: "Bloqueo do diferencial"

    key[]: "hint_diff_lock_text"
    val[]: "Se non podes moverte, pode que te axude bloquear o diferencial. Usa $KEY_diflock$ para bloquealo ou activa o bloqueo automático do diferencial en @@desktop_menu_category_options@@."


    key[]: "hint_diff_unlock_title"
    val[]: "Diferencial bloqueado"

    key[]: "hint_diff_unlock_text"
    val[]: "Deberías desbloquear o diferencial durante a condución normal ou poderías danalo. Usa $KEY_diflock$ para desbloquealo ou activa o seu bloqueo automático en @@desktop_menu_category_options@@."


    key[]: "hint_wipers_off_title"
    val[]: "Desactivar os limpaparabrisas"

    key[]: "hint_wipers_off_text"
    val[]: "Usa $KEY_wipers$ para desactivar os limpaparabrisas e para alternar entre as distintas velocidades."


    key[]: "hint_world_map_title"
    val[]: "Vista do mapa"

    key[]: "hint_world_map_text"
    val[]: "Usa $KEY_navmap$ para abrir o mapa do mundo."


    key[]: "hint_pause_title"
    val[]: "@@quick_info_word@@"

    key[]: "hint_pause_text"
    val[]: "Usa $KEY_advmouse$ para abrir a @@quick_info_word@@, ve un resumo do teu estado con accesos directos prácticos."


    key[]: "hint_pause_border_title"
    val[]: "Normativas locais"

    key[]: "hint_pause_border_text"
    val[]: "Usa $KEY_advmouse$ para abrir a @@quick_info_word@@ e ollar as normativas vixentes na rexión á que acabas de acceder."


    key[]: "hint_photo_trophy_title"
    val[]: "@@landmark_word@@"

    key[]: "hint_photo_trophy_text"
    val[]: "Abre @@quick_info_word@@ usando $KEY_advmouse$ para entrar ao @@photo_mode_word@@ e capturar o @@landmark_word@@ <img src=/material/ui/map/photo_sight_not_captured.mat width=20 height=20>."


    key[]: "hint_viewpoint_title"
    val[]: "@@viewpoint_title@@ nas inmediacións"

    key[]: "hint_viewpoint_text"
    val[]: "@@viewpoint_title@@ <img src=/material/ui/map/viewpoint_unseen.mat width=20 height=20> está preto. Atópao e actívao para ver a escena."


    key[]: "hint_resting_title"
    val[]: "Área de descanso próxima"

    key[]: "hint_resting_text"
    val[]: "As áreas de descanso <img src=/material/ui/map/parking_ico.mat width=20 height=20> axúdante a recuperarte da fatiga e a tomar o descanso obrigatorio para continuar coa túa viaxe con seguridade."


    key[]: "hint_gas_title"
    val[]: "Estación de servizo próxima"

    key[]: "hint_gas_text"
    val[]: "As estacións de servizo <img src=/material/ui/map/gas_ico.mat width=20 height=20> poden usarse para botar combustible no teu vehículo."


    key[]: "hint_car_job_title"
    val[]: "First courier job"

    key[]: "hint_car_job_text"
    val[]: "Completa a entrega — conduce de forma segura, ten coidado coa carga e chega á hora prevista. Ten en conta a prioridade do cliente que afectará á túa valoración e recompensa.<br><offset vshift=8>Preme $KEY_advmouse$ para ver os detalles do traballo."


    key[]: "hint_tour_board_title"
    val[]: "Panel turístico"

    key[]: "hint_tour_board_text"
    val[]: "Estás preto dun panel turístico. Actívao para desbloquear o seu contido no <color value=@@clr_sel@@>@@tourist_atlas_link@@</color> e guiar a túa exploración de lugares emblemáticos próximos e puntos de interese."


    key[]: "hint_tb_first_title"
    val[]: "Primeira localización explorada"

    key[]: "hint_tb_first_text"
    val[]: "Exploraches a primeira localización dun panel turístico local. Podes ver os seus detalles no <color value=@@clr_sel@@>@@tourist_atlas_link@@</color>. Explora todas as localizacións para aprender máis e gañar recompensas."


    key[]: "hint_tb_bef_compl_title"
    val[]: "Unha localización restante"

    key[]: "hint_tb_bef_compl_text"
    val[]: "Só falta unha localización para explorar por completo o teu primeiro panel turístico e conseguir así a túa postal."


    key[]: "hint_tb_done_title"
    val[]: "Panel turístico explorado"

    key[]: "hint_tb_done_text"
    val[]: "Exploraches con éxito todas as localizacións dun panel turístico local. Podes ver os seus detalles no <color value=@@clr_sel@@>@@tourist_atlas_link@@</color>. Como recompensa, agora podes exhibir a postal no teu vehículo."


    key[]: "hint_vehicle_prio_title"
    val[]: "Prioridade do cliente: estado do vehículo"

    key[]: "hint_vehicle_prio_text"
    val[]: "The customer has placed a higher priority on vehicle condition - your bonus reward or penalty will be greatly affected by the state of the vehicle you arrive in. Drive safely and take care of your vehicle.<br><offset vshift=8>Press $KEY_advmouse$ to view job details."


    key[]: "hint_cargo_prio_title"
    val[]: "Prioridade do cliente: manexo da carga"

    key[]: "hint_cargo_prio_text"
    val[]: "The customer has placed a higher priority on cargo handling - your bonus reward or penalty will be greatly affected by the state of the cargo you deliver. Drive safely and take care of your cargo.<br><offset vshift=8>Press $KEY_advmouse$ to view job details."


    key[]: "hint_time_prio_title"
    val[]: "Prioridade do cliente: xestión do tempo"

    key[]: "hint_time_prio_text"
    val[]: "The customer has placed a higher priority on time management - your bonus reward or penalty will be greatly affected by your ability to be punctual. Drive safely and arrive at a time the customer expects you.<br><offset vshift=8>Press $KEY_advmouse$ to view job details."


    key[]: "hint_car_deliv_title"
    val[]: "Approach the destination"

    key[]: "hint_car_deliv_text"
    val[]: "Detente na área designada para rematar a túa entrega.<br>Lembra que o cliente espera a entrega a unha hora concreta."


    key[]: "hint_car_early_title"
	val[]: "Chegada anticipada"

    key[]: "hint_car_early_text"
    val[]: "A entrega está prevista para unha hora en concreto. Chegar antes do previsto provocará que o cliente quede insatisfeito. Planifica a túa viaxe e usa as áreas de descanso dispoñibles se é necesario."


#!{
    key[]: "hint_sm_throttle_title"
	val[]: "@@throttle_double_tap@@"
#!}

    key[]: "hint_sm_throttle_text"
    val[]: "Podes activar o control intelixente do acelerador en @@desktop_menu_category_options@@. Ao activalo, o vehículo mantén un nivel de aceleración reducida por defecto. Despois de premer dúas veces rapidamente o botón do acelerador, o vehículo manterá o acelerador ao máximo ata que o soltes."
