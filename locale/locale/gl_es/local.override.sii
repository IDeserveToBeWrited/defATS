#+ Text deviations for American Truck Simulator. Please, use only terms appropriate for USA (i.e. culture specific nuances, not American English).
#@{

#+ Music/radio player
#@{

#+ Hint shown if no music files are found. Also shown as tooltip when hovering over music_player button.

	key[]: "music_player_hint"
	val[]: "Pon as túas cancións na carpeta <color value=@@clr_sel@@>American Truck Simulator/music <color value=@@clr_txt@@>nos teus <color value=@@clr_sel@@>Documentos <color value=@@clr_txt@@>e poderás velas aquí."

#+ Tooltip shown when hovering over the radio_stream button.

	key[]: "radio_hint"
	val[]: "Edita <color value=@@clr_sel@@>live_streams.sii <color value=@@clr_txt@@>na carpeta <color value=@@clr_sel@@>American Truck Simulator <color value=@@clr_txt@@>nos teus <color value=@@clr_sel@@>Documentos <color value=@@clr_txt@@>e escoita a túa radio de Internet favorita no xogo!"

#+ Hint shown if no online radio streams are defined.

	key[]: "empty_radio_hint"
	val[]: "Por favor, revisa o <color value=@@clr_sel@@>readme.rtf <color value=@@clr_txt@@>na carpeta <color value=@@clr_sel@@>American Truck Simulator <color value=@@clr_txt@@>dentro de <color value=@@clr_sel@@>Documentos <color value=@@clr_txt@@>para engadir a túa propia música e emisoras de radio."
#@}

