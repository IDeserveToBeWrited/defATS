#+ Book 3 Scenario Truckstop Angle
#@{

#### trckstp common

	key[]: "aca_scenario_book3_trckstp_title"
	val[]: "Parking in a Curve"

	key[]: "aca_scenario_book3_trckstp_desc"
	val[]: "In this scenario, you must navigate your way through a busy lot full of inconveniently parked trucks to park around a curve."

#### trckstp goal

#!{
	key[]: "aca_goal_book3_trckstp_check1"
	val[]: "@@aca_goal_book3_sup_check1@@"

	key[]: "aca_goal_book3_trckstp_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_trckstp_end"
	val[]: "@@aca_goal_book3_sup_end@@"

	key[]: "aca_goal_book3_trckstp_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_trckstp_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
#### trckstp msg - intro text

	key[]: "aca_msg_book3_trckstp_cutscene1"
	val[]: "It's not uncommon to arrive to a lot that is almost completely full of trucks, leaving you with very few options for parking yourself."

	key[]: "aca_msg_book3_trckstp_cutscene2"
	val[]: "In this case, there is only one place left where you can fit with your B-double combination. <br><br>Drive through the lot and park in the curve near the exit."

#### trckstp Driving Instructions

#!{
	key[]: "aca_msg_book3_trckstp_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_trckstp_forward"
	val[]: "Make your way through the lot and park along the curve. <br><br>Proceed when you're ready."

	key[]: "aca_msg_book3_trckstp_check1"
	val[]: "You won't be able to fit through the turn here, you'll have to back up and find another way through."

	key[]: "aca_msg_book3_trckstp_check2"
	val[]: "Park in the curve ahead."

	key[]: "aca_msg_book3_trckstp_stop"
	val[]: "Stop in the designated area."

	key[]: "aca_msg_book3_trckstp_end"
	val[]: "Secure the truck and shut down the engine."

#@}


