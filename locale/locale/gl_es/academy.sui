	key[]: "aca_goal_book1_3_03_check1"
	val[]: "Primeiro xiro"

	key[]: "aca_goal_book1_3_03_check2"
	val[]: "Rotonda"

	key[]: "aca_goal_book1_3_03_check3"
	val[]: "90-degree Turn"

	key[]: "aca_goal_book1_3_03_check4"
	val[]: "Xiro en asa"

	key[]: "aca_goal_book1_3_03_check5"
	val[]: "Xiro en gancho"

	key[]: "aca_goal_book1_3_03_check6"
	val[]: "Xiro cerrado"


#### generic phrase

	key[]: "aca_goal_book1_3_03_chk_point"
	val[]: "Sortear as barreiras"

#### 3_03 msg - intro text

	key[]: "aca_msg_book1_3_03_cutscene01"
	val[]: "Adiante hai unha serie de curvas complexas e obstáculos.<br>Toma en consideración todo o que aprendiches ata agora e non debería resultar demasiado complicado."

	key[]: "aca_msg_book1_3_03_cutscene02"
	val[]: "A primeira curva e un sinxelo xiro en gancho. Mantente aberto e non suporá un problema."

	key[]: "aca_msg_book1_3_03_cutscene03"
	val[]: "Continúa cara á rotonda."

	key[]: "aca_msg_book1_3_03_cutscene04"
	val[]: "Mantén o remolque afastado do interior da rotonda abríndote coa cabeza tractora o máximo que podas."

	key[]: "aca_msg_book1_3_03_cutscene05"
	val[]: "The 90-degree turn to the left isn't particularly tight, but be sure not to hit any cones."

	key[]: "aca_msg_book1_3_03_cutscene06"
	val[]: "Este xiro é bastante máis pechado. Usa a manobra de xiro en asa para completalo."

	key[]: "aca_msg_book1_3_03_cutscene07"
	val[]: "Podes usar a manobra de xiro en gancho neste cruzamento, pero hai algún obstáculo extra que tes que evitar."

	key[]: "aca_msg_book1_3_03_cutscene09"
	val[]: "Unha vez máis, o xiro final é moi pechado e vai requirir combinar as manobras de xiro en asa e xiro en gancho para completalo."

	key[]: "aca_msg_book1_3_03_cutscene10"
	val[]: "Aparca na zona designada, inmobiliza o camión e apaga o motor."


#### 3_03 Driving Instructions



	key[]: "aca_msg_book1_3_03_forward"
	val[]: "<font face=/font/big_bold.font>Procede cara ao primeiro xiro. </font>"

	key[]: "aca_msg_book1_3_03_check1"
	val[]: "O primeiro viraxe é un sinxelo xiro en gancho.<br><br><font face=/font/big_bold.font><color value=@@clr_txt@@>Fai o xiro. </font>"

	key[]: "aca_msg_book1_3_03_check2"
	val[]: "Continúa cara á rotonda e lembra abrirte ao circular por ela.<br><br><font face=/font/big_bold.font>Conduce pola rotonda.</font>"

	key[]: "aca_msg_book1_3_03_check3"
	val[]: "This 90-degree turn is a bit tighter, be careful not to hit any cones.<br><br><font face=/font/big_bold.font>Make the turn.</font>"

	key[]: "aca_msg_book1_3_03_check4"
	val[]: "A mellor maneira de afrontar este xiro é facendo unha manobra de xiro en asa. Ábrete antes de entrar no cruzamento.<br><br><font face=/font/big_bold.font>Fai o xiro en asa. </font>"

	key[]: "aca_msg_book1_3_03_check5"
	val[]: "Este xiro está cheo de distintos obstáculos, pero pódese facer cunha manobra de xiro en gancho.<br><br><font face=/font/big_bold.font>Procede con coidado.</font>"

	key[]: "aca_msg_book1_3_03_check6"
	val[]: "Este xiro é o máis pechado. Negóciao da forma que consideres máis adecuada.<br><br><font face=/font/big_bold.font>Xira cara ao aparcamento.</font>"
