	val[]: "Estás no lugar adecuado, pero no sentido incorrecto.<br><br><font face=/font/big_bold.font>Dálle a volta ao camión antes de completar o escenario.</font>"

#@}


#+ Book 1 intro
#@{

	key[]: "aca_scenario_book1_intro_title"
	val[]: "Conceptos básicos da condución de camións"

	key[]: "aca_msg_book1_intro_cutscene01"
	val[]: "Dámoste a benvida á @@driving_academy@@."

	key[]: "aca_msg_book1_intro_cutscene02"
	val[]: "Os seguintes escenarios representan o primeiro paso na túa viaxe cara á condución profesional de camións."

	key[]: "aca_msg_book1_intro_cutscene03"
	val[]: "Aquí aprenderás de todo, dende os sistemas básicos e os controis do camión..."

	key[]: "aca_msg_book1_intro_cutscene04"
	val[]: "... ata manobras complexas, con e sen remolque."

	key[]: "aca_msg_book1_intro_cutscene05"
	val[]: "Axudarémoste a adquirir hábitos que che axudarán a defenderte con seguridade en diversas situacións,"

	key[]: "aca_msg_book1_intro_cutscene06"
	val[]: "e ensinarémoste a facer un uso intelixente do espazo dispoñible para manobrar eficazmente o teu camión."

	key[]: "aca_msg_book1_intro_cutscene07"
	val[]: "Completando todos os escenarios e pasando os exames finais,"

	key[]: "aca_msg_book1_intro_cutscene08"
	val[]: "estarás a punto para botarte ás estradas de América e atopar novos desafíos aos que enfrontarte."

