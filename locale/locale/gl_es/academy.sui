	key[]: "aca_msg_book1_3_15_cutscene02_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/jug_handle.mat bottom=p256 right=p256 color=FFFFFFFF></align><offset vshift=256>"

	key[]: "aca_msg_book1_3_15_cutscene07_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/button_hook.mat bottom=p256 right=p256 color=FFFFFFFF></align><offset vshift=256>"

#!}


#### 3_15 Driving Instructions

	key[]: "aca_msg_book1_3_15_forward"
	val[]: "Lembra usar todo o espazo dispoñible para axudarte a negociar cada xiro.<br><br><font face=/font/big_bold.font>Comeza a avanzar e sigue as marcas na estrada cara á esquerda. </font>"

	key[]: "aca_msg_book1_3_15_check1"
	val[]: "Usa todo o espazo dispoñible para facer un xiro amplo e manter o remolque afastado do bordo interior.<br><br><font face=/font/big_bold.font>Fai un xiro en asa. </font>"

	key[]: "aca_msg_book1_3_15_check2"
	val[]: "Mantente cara ao centro da calzada pola curva e despois sigue cara ao seguinte xiro.<br><br><font face=/font/big_bold.font>Continúa conducindo. </font>"

	key[]: "aca_msg_book1_3_15_check3"
	val[]: "O espazo á esquerda é limitado, polo que deberás adentrarte na intersección para manter o remolque afastado do bordo.<br><br><font face=/font/big_bold.font>Fai un xiro en gancho. </font>"

	key[]: "aca_msg_book1_3_15_check4"
	val[]: "Sigue recto e fai a seguinte curva.<br><br><font face=/font/big_bold.font>Continúa conducindo. </font>"

	key[]: "aca_msg_book1_3_15_check5"
	val[]: "Este xiro é o máis axustado e non será suficiente con facer só unha das manobras, senón que terás que combinalas.<br><br><font face=/font/big_bold.font>Fai o xiro e mantente o máis aberto posible.</font>"

	key[]: "aca_msg_book1_3_15_check6"
	val[]: "<font face=/font/big_bold.font>Diríxete cara á praza de aparcamento adiante á dereita. </font>"
#!{
	key[]: "aca_msg_book1_3_15_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_15_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_15_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}


#@}

#+ Book 1 Scenario 3_16
#@{

#### 3_16 common
	key[]: "aca_scenario_book1_3_16_title"
	val[]: "Aparcamento marcha atrás en diagonal"

	key[]: "aca_scenario_book1_3_16_desc"
	val[]: "Neste escenario imos explorar o aparcamento en diagonal marcha atrás. Esta manobra é habitual en áreas de descanso, paradas de camións ou mesmo nalgunhas empresas. A miúdo hai pouco espazo porque os aparcamentos están cheos de camións, polo que aparcar é aínda máis difícil."

#### 3_16 goal

	key[]: "aca_goal_book1_3_16_check1"
	val[]: "Xirar o remolque"
#!{
	key[]: "aca_goal_book1_3_16_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_16_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_16_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_16_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
 #!}
#### 3_16 msg - intro text

	key[]: "aca_msg_book1_3_16_cutscene1"
	val[]: "Aparcar en diagonal pode parecer máis doado a primeira vista, pero a miúdo é máis esixente cás típicas manobras de aparcamento en canella."

	key[]: "aca_msg_book1_3_16_cutscene2"
	val[]: "Retrocede cara á praza de aparcamento. Mantén a cabeza tractora e o remolque aliñados por agora."

	key[]: "aca_msg_book1_3_16_cutscene3"
	val[]: "A medida que te acercas, deixa que o remolque se achegue aos camións aparcados. Isto axudarache a xirar cara á praza cando chegues a ela."

	key[]: "aca_msg_book1_3_16_cutscene4"
	val[]: "Comeza a xirar o remolque cara ao aparcamento. Mantén o teu remolque preto do camión do lado do condutor, xa que necesitarás o espazo ao outro lado."

	key[]: "aca_msg_book1_3_16_cutscene5"
	val[]: "Unha vez que o remolque se atope na praza de aparcamento, comeza a xirar a tractora para aliñala co remolque."

	key[]: "aca_msg_book1_3_16_cutscene6"
	val[]: "Aparca na zona designada, inmobiliza o camión e apaga o motor."

#### 3_16 Driving Instructions

	key[]: "aca_msg_book1_3_16_start"
	val[]: "Aparca o camión no espazo que hai detrás de ti. Usa ámbolos espellos para guiarte a medida que vas marcha atrás.<br><br><font face=/font/big_bold.font>Prepárate para saír.</font>"

	key[]: "aca_msg_book1_3_16_backward"
	val[]: "Comproba os teus arredores e despois móvete cara á praza de aparcamento.<br><br><font face=/font/big_bold.font>Comeza a retroceder.</font>"

	key[]: "aca_msg_book1_3_16_check1"
	val[]: "Achega o remolque cara aos camións que tes ao lado. Cando consideres oportuno xira o remolque cara á praza de aparcamento. Lembra considerar o desprazamento da parte posterior do remolque.<br><br><font face=/font/big_bold.font>Xira cara á praza de aparcamento.</font>"
#!{
	key[]: "aca_msg_book1_3_16_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_16_end"
	val[]: "@@aca_msg_book1_2_01_end@@"


 #!}


#@}

#+ Book 1 Scenario 3_17
#@{

#### 3_17 common
	key[]: "aca_scenario_book1_3_17_title"
	val[]: "Facer un xiro marcha atrás"

	key[]: "aca_scenario_book1_3_17_desc"
	val[]: "Neste escenario xiraremos marcha atrás cun remolque por primeira vez. Exploraremos os conceptos básicos da marcha atrás e a que debes prestar atención ao xirar marcha atrás."

#### 3_17 goal

	key[]: "aca_goal_book1_3_17_check1"
	val[]: "Xirar o remolque"
#!{
	key[]: "aca_goal_book1_3_17_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_17_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_17_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_17_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
 #!}
#### 3_17 msg - intro text

	key[]: "aca_msg_book1_3_17_cutscene01"
	val[]: "Neste escenario terás que ir marcha atrás ata a praza de aparcamento que se atopa detrás de ti ao polo lado do condutor."

	key[]: "aca_msg_book1_3_17_cutscene02"
	val[]: "Hai varios consellos a recordar que che axudarán moito á hora de dar marcha atrás con remolques.<br>O primeiro é que o remolque sempre xirará na dirección oposta a como xiras a cabeza tractora."

	key[]: "aca_msg_book1_3_17_cutscene03"
	val[]: "O segundo é que podes facerte unha boa idea da dirección cara a onde se dirixe o remolque observando os eixes do camión e o remolque."

	key[]: "aca_msg_book1_3_17_cutscene04"
	val[]: "O terceiro, xiros pequenos axudan a levalo onde necesitas, non fai falta xirar esaxeradamente."

	key[]: "aca_msg_book1_3_17_cutscene05"
	val[]: "Comeza xirando levemente a cabeza tractora ao contrario da praza de aparcamento, e o remolque empezará a xirar cara a ela."

	key[]: "aca_msg_book1_3_17_cutscene06"
	val[]: "Sigue o remolque, facendo axustes mentres retrocedes para mantelo na traxectoria correcta."

	key[]: "aca_msg_book1_3_17_cutscene07"
	val[]: "Observa as rodas do remolque e a roda traseira da tractora. Isto indicarate cara a onde apunta o remolque, e onde o está apuxando o camión."

	key[]: "aca_msg_book1_3_17_cutscene08"
	val[]: "Un cuarto consello é que sempre é máis doado facer que o remolque xire máis aguzadamente que endereitalo despois de facer a tesoira. Apunta cara ao exterior da praza de aparcamento ata que esteas máis preto a ela, entón poderás xirar un pouco máis para aliñar o remolque."

	key[]: "aca_msg_book1_3_17_cutscene09"
	val[]: "A medida que o remolque entra na praza, vai situando a tractora aliñada co remolque. Tenta non facer moitos axustes unha vez esteas dentro da praza."

	key[]: "aca_msg_book1_3_17_cutscene10"
	val[]: "Sigue marcha atrás entre as barreiras e vai prestando atención a ámbolos lados."

	key[]: "aca_msg_book1_3_17_cutscene11"
	val[]: "Inmobiliza o camión e apaga o motor."

#### 3_17 Driving Instructions

	key[]: "aca_msg_book1_3_17_start"
	val[]: "Lembra estes consellos cando fagas un xiro marcha atrás cun remolque:<br><br>— O remolque xira na dirección oposta á da cabeza tractora.<br><br>— Observa as rodas do remolque para ver cara a onde se dirixe.<br><br>— Observa a roda traseira da tractora para ver onde apuxa ao remolque.<br><br>— Deixa ao remolque facer o seu traballo, non fagas xiros bruscos.<br><br>Sempre é máis doado xirar máis o remolque que endereitalo.<br><br><font face=/font/big_bold.font>Prepárate para comezar.</font>"

	key[]: "aca_msg_book1_3_17_backward"
	val[]: "Mira detrás de ti para ver onde te tes que dirixir. Comproba sempre o teu arredor antes de comezar a retroceder.<br><br><font face=/font/big_bold.font>Empeza a retroceder cara á praza de aparcamento. </font>"

	key[]: "aca_msg_book1_3_17_check1"
	val[]: "<font face=/font/big_bold.font>Comeza a xirar o remolque cara á praza de aparcamento e vaino seguindo ata ela.</font>"

	key[]: "aca_msg_book1_3_17_stop"
	val[]: "<font face=/font/big_bold.font>Detente na área designada.</font>"
#!{
	key[]: "aca_msg_book1_3_17_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_18
#@{

#### 3_18 common
	key[]: "aca_scenario_book1_3_18_title"
	val[]: "Manobra de aparcamento en canella"

	key[]: "aca_scenario_book1_3_18_desc"
	val[]: "Neste escenario terás que aparcar o remolque marcha atrás nunha canella."

#### 3_18 goal

	key[]: "aca_goal_book1_3_18_check1"
	val[]: "Xirar o remolque"
#!{
	key[]: "aca_goal_book1_3_18_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_18_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


	key[]: "aca_goal_book1_3_18_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_18_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

 #!}
#### 3_18 msg - intro text

	key[]: "aca_msg_book1_3_18_cutscene01"
	val[]: "Aparcar aquí require unha manobra chamada 'aparcamento en canella'.<br>Esta é unha manobra habitual para os camioneiros. Poden atopar esta situación case a diario, tanto para cargar ou descargar un remolque como para aparcar nunha parada de camións para pasar a noite."

	key[]: "aca_msg_book1_3_18_cutscene02"
	val[]: "Esta manobra é similar á do escenario anterior, pero terás menos espazo para manobrar. Así que terás que planificar mellor os teus movementos e ter coidado de non bater con nada."

	key[]: "aca_msg_book1_3_18_cutscene03"
	val[]: "Ao haber menos espazo, a túa coordinación é máis importante. Xira o remolque no momento adecuado e observa as rodas da tractora e o remolque para ver cara a onde se dirixe. Ten en conta o desprazamento da parte traseira do remolque e lembra non facer a tesoira."

	key[]: "aca_msg_book1_3_18_cutscene04"
	val[]: "Tenta xirar o remolque cara á canella canto máis cedo mellor. Así terás espazo abondo ao outro lado para xirar a parte dianteira do remolque e para poñer a tractora á súa fronte."

	key[]: "aca_msg_book1_3_18_cutscene05"
	val[]: "Unha vez o remolque estea na canella, aliña a tractora diante del. É mellor facer isto un pouco antes do que che faría crer o teu instinto. Sempre poderás corrixilo a medida que das marcha atrás ata a posición final."

	key[]: "aca_msg_book1_3_18_cutscene06"
	val[]: "Aliña a tractora e o remolque e detente na área designada."

	key[]: "aca_msg_book1_3_18_cutscene07"
	val[]: "Inmobiliza o camión e apaga o motor."


#### 3_18 Driving Instructions

	key[]: "aca_msg_book1_3_18_start"
	val[]: "Agora tentaremos xirar o remolque nunha área moito máis pequena cunha manobra de 'aparcamento en canella'.<br><br><font face=/font/big_bold.font>Prepárate para comezar.</font>"

	key[]: "aca_msg_book1_3_18_backward"
	val[]: "Comproba os teus arredores e busca a praza de aparcamento detrás de ti.<br><br><font face=/font/big_bold.font>Comeza a dar marcha atrás cara á praza de aparcamento.</font>"

	key[]: "aca_msg_book1_3_18_check1"
	val[]: "<font face=/font/big_bold.font>Xira o remolque cara á praza de aparcamento.</font>"
#!{
	key[]: "aca_msg_book1_3_18_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_18_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}


#@}

#+ Book 1 Scenario 3_19
#@{

#### 3_19 common
	key[]: "aca_scenario_book1_3_19_title"
	val[]: "Exame final (parte 1)"

	key[]: "aca_scenario_book1_3_19_desc"
	val[]: "O exame final agárdate, onde se poñerán a proba todas as habilidades que aprendiches nos escenarios anteriores. Daremos unha volta por todo o centro de formación para ver que tal aprendiches as situacións que atopaches ata agora.<br><br>Unha vez completes todas as seccións e manobras, estarás un paso máis cerca de poder chamarte camioneiro experto!"

#### 3_19 goal
#!{
	key[]: "aca_goal_book1_3_19_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_19_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_19_check10"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_19_check11"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_19_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

#!}
	key[]: "aca_goal_book1_3_19_coupling"
	val[]: "Dar marcha atrás cara ao remolque"

	key[]: "aca_goal_book1_3_19_park_br_on"
	val[]: "Poñer o freo de estacionamento"

	key[]: "aca_goal_book1_3_19_connect"
	val[]: "Conectar o remolque"

	key[]: "aca_goal_book1_3_19_park_br_off"
	val[]: "Quitar o freo de man"

	key[]: "aca_goal_book1_3_19_b_trailer"
	val[]: "Conducir cara á estrada"

	key[]: "aca_goal_book1_3_19_check01"
	val[]: "Conducir pola estrada"

	key[]: "aca_goal_book1_3_19_check02"
	val[]: "Slálom"

	key[]: "aca_goal_book1_3_19_check02b"
	val[]: "90-degree Turns"

	key[]: "aca_goal_book1_3_19_check03"
	val[]: "Canella estreita"

	key[]: "aca_goal_book1_3_19_check04"
	val[]: "Xiros doados"

	key[]: "aca_goal_book1_3_19_check05"
	val[]: "Conducir recto"

	key[]: "aca_goal_book1_3_19_check06"
	val[]: "Xiros cerrados"

	key[]: "aca_goal_book1_3_19_check07"
	val[]: "Slálom estreito"

	key[]: "aca_goal_book1_3_19_check08"
	val[]: "Aproximación á sección de marcha atrás"

	key[]: "aca_goal_book1_3_19_check09"
	val[]: "Colocarse para retroceder"


	key[]: "aca_goal_book1_3_19_check12"
	val[]: "Saír da sección de marcha atrás"

	key[]: "aca_goal_book1_3_19_check13"
	val[]: "Conducir cara á saída"

	key[]: "aca_goal_book1_3_19_check14"
	val[]: "Saír da zona industrial"

	key[]: "aca_goal_book1_3_19_check15"
	val[]: "Xiro pechado á dereita"

	key[]: "aca_goal_book1_3_19_check16"
	val[]: "Acceder á zona da academia"

	key[]: "aca_goal_book1_3_19_check17"
	val[]: "Conducir cara á zona da academia"

	key[]: "aca_goal_book1_3_19_check18"
	val[]: "Curva suave"

	key[]: "aca_goal_book1_3_19_check19"
	val[]: "Xiro pechado á esquerda cara á zona de aparcamento"

	key[]: "aca_goal_book1_3_19_check20"
	val[]: "Aparcar"

	key[]: "aca_goal_book1_3_19_stop"
	val[]: "Parar na zona designada"


#### 3_19 msg - intro text

	key[]: "aca_msg_book1_3_19_cutscene01"
	val[]: "Dámoste a benvida á primeira parte do exame final. Aquí veremos que tal aprendiches a conducir un camión despois do teu paso pola academia."

	key[]: "aca_msg_book1_3_19_cutscene02"
	val[]: "Primeiro, engancharás o remolque. Unha vez acoplado, conducirás o camión por toda a ruta de probas."

	key[]: "aca_msg_book1_3_19_cutscene03"
	val[]: "O primeiro tramo da proba lévate por unhas vías secundarias ata o centro do pobo."

	key[]: "aca_msg_book1_3_19_cutscene04"
	val[]: "A ruta inclúe varios tipos de curvas e obstáculos."

	key[]: "aca_msg_book1_3_19_cutscene05"
	val[]: "Unha pequena parte da ruta pasa polo centro do pobo."

	key[]: "aca_msg_book1_3_19_cutscene06"
	val[]: "Poñeremos a proba a túa habilidade para manobrar o camión a través de distintos obstáculos e percorridos."

	key[]: "aca_msg_book1_3_19_cutscene07"
	val[]: "Atoparás varias situacións que avaliarán a túa atención aos teus arredores."

	key[]: "aca_msg_book1_3_19_cutscene08"
	val[]: "Farémoste dar marcha atrás por unha instalación industrial."

	key[]: "aca_msg_book1_3_19_cutscene09"
	val[]: "Despois de transitar por estradas, a través do centro da cidade e nas instalacións industriais, agora dirixiraste cara á sede central da @@driving_academy@@."

	key[]: "aca_msg_book1_3_19_cutscene10"
	val[]: "Un curto traxecto por estrada e case terás acabado."

	key[]: "aca_msg_book1_3_19_cutscene11"
	val[]: "Para rematar a proba terás que estacionar correctamente. Podes elixir a manobra que prefiras."

	key[]: "aca_msg_book1_3_19_cutscene12"
	val[]: "Non tes de que preocuparte, xa coñeces todo o que vas necesitar para aprobar.<br><br>Boa sorte!"

#### 3_19 Driving Instructions



	key[]: "aca_msg_book1_3_19_forward"
	val[]: "Primeiro terás que atopar e acoplar o remolque. Está aparcado adiante á dereita.<br><br><font face=/font/big_bold.font>Conduce cara ao remolque.</font>"

	key[]: "aca_msg_book1_3_19_coupling"
	val[]: "Xira cara á esquerda, despois retrocede cara ao remolque e alíñate con el.<br><br><font face=/font/big_bold.font>Dá marcha atrás cara ao remolque.</font>"

	key[]: "aca_msg_book1_3_19_park_br_on"
	val[]: "<font face=/font/big_bold.font>Inmobiliza o camión. </font>"

	key[]: "aca_msg_book1_3_19_connect"
	val[]: "<font face=/font/big_bold.font>Preme @@imv_nrm_attach@@ para conectar o remolque. </font>"

	key[]: "aca_msg_book1_3_19_park_br_off"
	val[]: "O remolque está conectado e o camión está listo para conducir.<br><br><font face=/font/big_bold.font>Quita o freo de estacionamento.</font>"

	key[]: "aca_msg_book1_3_19_b_trailer"
	val[]: "A estrada foi cerrada ao tráfico para a nosa proba. Podes elixir se obedeces ou ignoras os sinais de tráfico segundo o teu criterio.<br><br><font face=/font/big_bold.font>Conduce cara á estrada.</font>"

	key[]: "aca_msg_book1_3_19_check01"
	val[]: "Prosigue a través dos primeiros xiros.<br><br><font face=/font/big_bold.font>Sigue conducindo.</font>"

	key[]: "aca_msg_book1_3_19_check02"
	val[]: "Despois da seguinte curva hai un slálom feito con conos de tráfico.<br><br><font face=/font/big_bold.font>Pasa con coidado entre os conos.</font>"

	#key[]: "aca_msg_book1_3_19_check02a"
	#val[]: "Continue through the roundabout into the town.<br><br><font face=/font/big_bold.font>Negotiate the roundabout.</font>"

	key[]: "aca_msg_book1_3_19_check02b"
	val[]: "A few more 90-degree turns await you. <br><br><font face=/font/big_bold.font>Continue driving. </font>"

	key[]: "aca_msg_book1_3_19_check03"
	val[]: "O seguinte xiro é extremadamente estreito e requirirá de toda a estrada para completalo con éxito.<br><br><font face=/font/big_bold.font>Xira á dereita e conduce a través da canella.</font>"

	key[]: "aca_msg_book1_3_19_check04"
	val[]: "Xira á esquerda ao saír da canella e despois xira á dereita para incorporarte á estrada principal.<br><br><font face=/font/big_bold.font>Sigue conducindo.</font>"

	key[]: "aca_msg_book1_3_19_check05"
	val[]: "Agora podes relaxarte un pouco mentres conduces pola estrada.<br><br><font face=/font/big_bold.font>Continúa recto.</font>"

	key[]: "aca_msg_book1_3_19_check06"
	val[]: "Hai uns xiros pechados para entrar e saír da vía de servizo.<br><br><font face=/font/big_bold.font>Conduce con coidado a través dos xiros.</font>"

	key[]: "aca_msg_book1_3_19_check07"
	val[]: "Estáste adentrando nun slálom máis complexo. Prosigue amodo e usa os espellos.<br><br><font face=/font/big_bold.font>Sigue conducindo e recorre o slálom con coidado.</font>"

	key[]: "aca_msg_book1_3_19_check08"
	val[]: "Xira á esquerda para acceder á zona industrial. Ten coidado co poste do foco.<br><br><font face=/font/big_bold.font>Fai o xiro á esquerda.</font>"

	key[]: "aca_msg_book1_3_19_check09"
	val[]: "Prepárate para ir marcha atrás.<br><br><font face=/font/big_bold.font>Xira á dereita e para na zona delimitada.</font>"

	key[]: "aca_msg_book1_3_19_check10"
	val[]: "Conduce marcha atrás e sigue o percorrido detrás de ti á esquerda.<br><br><font face=/font/big_bold.font>Comeza a retroceder.</font>"

	key[]: "aca_msg_book1_3_19_check11"
	val[]: "Continúa polo percorrido cara á esquerda.<br><br><font face=/font/big_bold.font>Sigue retrocedendo.</font>"

	key[]: "aca_msg_book1_3_19_check12"
	val[]: "<font face=/font/big_bold.font>Conduce cara adiante e xira á dereita.</font>"

	key[]: "aca_msg_book1_3_19_check13"
	val[]: "<font face=/font/big_bold.font>Sigue cara á porta de acceso.</font>"

	key[]: "aca_msg_book1_3_19_check14"
	val[]: "Agarda a que se abra a porta. Despois sigue de novo cara á estrada principal.<br><br><font face=/font/big_bold.font>Sigue conducindo.</font>"

	key[]: "aca_msg_book1_3_19_check15"
	val[]: "Ten coidado de non bater co sinal.<br><br><font face=/font/big_bold.font>Fai o xiro e sigue conducindo.</font>"

	key[]: "aca_msg_book1_3_19_check16"
	val[]: "<font face=/font/big_bold.font>Xira á esquerda cara á academia.</font>"

	key[]: "aca_msg_book1_3_19_check17"
	val[]: "<font face=/font/big_bold.font>Continúa recto. </font>"

	key[]: "aca_msg_book1_3_19_check18"
	val[]: "Mantente polo exterior, xa que hai un xiro pechado despois da curva.<br><br><font face=/font/big_bold.font>Sigue a curva.</font>"

	key[]: "aca_msg_book1_3_19_check19"
	val[]: "<font face=/font/big_bold.font>Xira á esquerda e prepárate para aparcar á esquerda.</font>"

	key[]: "aca_msg_book1_3_19_check20"
	val[]: "<font face=/font/big_bold.font>Dá marcha atrás cara á praza de aparcamento.</font>"
#!{
	key[]: "aca_msg_book1_3_19_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_19_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_19_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
 #!}


#@}


#+ Book 1 Scenario 3_20
#@{

#### 3_20 common
	key[]: "aca_scenario_book1_3_20_title"
	val[]: "Exame final (parte 2)"

	key[]: "aca_scenario_book1_3_20_desc"
	val[]: "Agárdate a derradeira parte do exame final, onde se avaliarán as habilidades para aparcar que aprendiches nos escenarios previos. Aparca con coidado e precisión e estarás a punto para saír ás estradas de América coma un camioneiro cualificado!"

#### 3_20 goal
#!{
	key[]: "aca_goal_book1_3_20_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_20_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_20_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_20_forward"
	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}


	key[]: "aca_goal_book1_3_20_park1"
	val[]: "Manobra desprazada"

	key[]: "aca_goal_book1_3_20_park2"
	val[]: "Aparcar en diagonal"

	key[]: "aca_goal_book1_3_20_park3"
	val[]: "Conducir a través do aparcamento"

	key[]: "aca_goal_book1_3_20_park4"
	val[]: "Aparcar en paralelo"

	key[]: "aca_goal_book1_3_20_park5"
	val[]: "Aparcar por derradeira vez"


#### 3_20 msg - intro text

	key[]: "aca_msg_book1_3_20_cutscene01"
	val[]: "Benvido/a á segunda parte do exame final. Moverémonos ata un aparcamento próximo e poñeremos a proba as túas habilidades dando marcha atrás e manobrando para aparcar."

	key[]: "aca_msg_book1_3_20_cutscene02"
	val[]: "Agárdante varios desafíos de aparcamento consecutivos para avaliar as túas capacidades."

	key[]: "aca_msg_book1_3_20_cutscene03"
	val[]: "O espazo é limitado aquí, así que ten coidado e tómate o teu tempo."

	key[]: "aca_msg_book1_3_20_cutscene04"
	val[]: "Aproveita ben o espazo ao teu arredor e sácalle o mellor partido a todos os teus espellos. Boa sorte!"




#### 3_20 outro text

	key[]: "aca_msg_book1_3_20_outro01"
	val[]: "Parabéns! Completaches con éxito os exames de conceptos básicos da condución de camións, e aprendiches todas as habilidades necesarias para manobrar correctamente o teu camión."

	key[]: "aca_msg_book1_3_20_outro02"
	val[]: "Este é o primeiro paso na túa viaxe cara a facer realidade o teu sono de converterte nun camioneiro profesional."

	key[]: "aca_msg_book1_3_20_outro03"
	val[]: "Agora xa tes todo para poder saír ás estradas de América e facer fronte aos teus primeiros desafíos..."

	key[]: "aca_msg_book1_3_20_outro04"
	val[]: "... pero a aventura só acaba de comezar."


#### 3_20 Driving Instructions

	key[]: "aca_msg_book1_3_20_start"
	val[]: "Lembra ir con coidado e sen présa. Non pasa nada se non o logras no primeiro intento, o importante é non danar o camión ou quen se atope ao teu arredor.<font face=/font/big_bold.font><br><br>Prepárate para saír.</font>"

	key[]: "aca_msg_book1_3_20_forward"
	val[]: "<font face=/font/big_bold.font>Conduce cara adiante ata a primeira parte do exame.</font>"

	key[]: "aca_msg_book1_3_20_park1"
	val[]: "A túa primeira tarefa é demostrar a manobra de aparcamento desprazado. O sitio onde tes que retroceder co teu remolque está á túa esquerda.<br><br><font face=/font/big_bold.font>Executa unha manobra de aparcamento desprazado.</font>"

	key[]: "aca_msg_book1_3_20_park2"
	val[]: "A seguinte tarefa é dar marcha atrás cara a unha fila de camións estacionados. Ten coidado de non colidir con eles!<br><br><font face=/font/big_bold.font>Fai unha manobra de aparcamento en diagonal.</font>"

	key[]: "aca_msg_book1_3_20_park3"
	val[]: "Continúa a través do aparcamento e presta atención a situacións inesperadas.<br><br><font face=/font/big_bold.font>Sigue conducindo.</font>"

	key[]: "aca_msg_book1_3_20_park4"
	val[]: "Agora imos intentar aparcar en paralelo entre os dous camións que están xunto ao bordo diante de ti.<br><br><font face=/font/big_bold.font>Executa unha manobra de aparcamento en paralelo.</font>"

	key[]: "aca_msg_book1_3_20_park5"
	val[]: "Unha derradeira manobra de aparcamento á túa esquerda! Podes elixir abordala como prefiras.<br><br><font face=/font/big_bold.font>Dá marcha atrás cara á zona designada.</font>"

	key[]: "aca_msg_book1_3_20_park6"
	val[]: "Xa case o tes. Abandona a zona de prácticas e aparca o camión.<br><br><font face=/font/big_bold.font>Sae da zona de probas pola túa esquerda.</font>"

	key[]: "aca_msg_book1_3_20_stop"
	val[]: "Podes aparcar o camión á dereita xunto aos demais.<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_20_end"
	val[]: "@@aca_msg_book1_2_01_end@@"


#!}

#@}


#+ Book 1 Scenario 3_22
#@{

#### 3_22 common
	key[]: "aca_scenario_book1_3_22_title"
	val[]: "Aparcar en paralelo con remolque"

	key[]: "aca_scenario_book1_3_22_desc"
	val[]: "Neste escenario aprenderemos a aparcar en paralelo co remolque acoplado."

#### 3_22 goal


	key[]: "aca_goal_book1_3_22_stopmid"
	val[]: "Parar na zona marcada"
#!{
	key[]: "aca_goal_book1_3_22_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_22_check1"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_22_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_22_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_22_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
  #!}
#### 3_22 msg - intro text

	key[]: "aca_msg_book1_3_22_cutscene1"
	val[]: "O aparcamento en paralelo cun remolque é unha habilidade relevante para calquera que conduza un camión.<br>Xa sexa para aparcar nunha gran cidade ou para parar nunha área de descanso nunha zona rural, é algo que tes que saber facer."

	key[]: "aca_msg_book1_3_22_cutscene2"
	val[]: "Ao pasar pola praza de aparcamento, comproba que hai suficiente espazo para a cabeza tractora e o remolque. Aquí xa nos aseguramos de que teñas espazo abondo."

	key[]: "aca_msg_book1_3_22_cutscene3"
	val[]: "Alíñate co camión que se atopa diante da praza de aparcamento. Non te arrimes moito a el, mantén algo de distancia para ter suficiente espazo para manobrar."

	key[]: "aca_msg_book1_3_22_cutscene4"
	val[]: "Xira acentuadamente cara ao lado contrario ao espazo de aparcamento e comeza a dar marcha atrás. A idea é que o remolque xire cara á praza de aparcamento canto antes."

	key[]: "aca_msg_book1_3_22_cutscene5"
	val[]: "Unha vez o remolque está orientado correctamente cara ao espazo, podes comezar a endereitar a tractora para seguilo."

	key[]: "aca_msg_book1_3_22_cutscene6"
	val[]: "Empeza a xirar o remolque para afastalo do bordo antes de que as rodas do remolque no lado do condutor entren na praza de aparcamento."

	key[]: "aca_msg_book1_3_22_cutscene7"
	val[]: "Aliña a tractora co remolque e centra o conxunto na praza de aparcamento.<br><br>Aparca, apaga o motor e inmobiliza o camión."

#### 3_22 Driving Instructions

	key[]: "aca_msg_book1_3_22_start"
	val[]: "Podes ver o espazo para aparcar diante de ti, entre os outros camións. Mentres aparques, asegúrate de comprobar os espellos e manter unha distancia de seguridade entre o camión e os obstáculos ao teu arredor.<br><br><font face=/font/big_bold.font>Prepárate para saír.</font>"

	key[]: "aca_msg_book1_3_22_check1"
	val[]: "Móvete polo aparcamento para atopar a praza de aparcamento.<br><br><font face=/font/big_bold.font>Conduce cara adiante.</font>"

	key[]: "aca_msg_book1_3_22_stopmid"
	val[]: "<color value=@@clr_white@@>Conduce máis aló da praza de aparcamento ata a zona marcada. Dende alí podes comezar a dar marcha atrás.<br><br><font face=/font/big_bold.font>Para na área marcada. </font>"

	key[]: "aca_msg_book1_3_22_backward"
	val[]: "Xira a cabeza tractora cara ao lado contrario á praza para comezar a xirar o remolque cara a ela. Non xires demasiado ou iraste contra o bordo.<br><br><font face=/font/big_bold.font>Comeza a retroceder.</font>"

	key[]: "aca_msg_book1_3_22_stop"
	val[]: "Aliña o remolque coa praza de aparcamento. Se é necesario, móvete cara adiante ou atrás mentres fas as manobras necesarias para axustar a túa posición.<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_22_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
 #!}

#@}

#+ Book 1 Scenario 3_21
#@{
#### 3_21 common
	key[]: "aca_scenario_book1_3_21_title"
	val[]: "Retroceder dende unha posición a 45 graos"

	key[]: "aca_scenario_book1_3_21_desc"
	val[]: "Neste escenario exploraremos a manobra marcha atrás dende unha posición de 45 graos."

#### 3_21 goal
#!{
	key[]: "aca_goal_book1_3_21_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_21_forward"
	val[]: "@@aca_goal_book1_1_03_forward@@"

	key[]: "aca_goal_book1_3_21_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}
	key[]: "aca_goal_book1_3_21_check1"
	val[]: "Punto intermedio"

	key[]: "aca_goal_book1_3_21_check2"
	val[]: "Atopar a distancia correcta para retroceder"

	key[]: "aca_goal_book1_3_21_stop"
	val[]: "Aparcar no espazo designado"



#### 3_21 msg - intro text

	key[]: "aca_msg_book1_3_21_cutscene1"
	val[]: "Nesta lección imos estudar o aparcamento a 45 graos. Este é o método preferido por moitos para aparcar marcha atrás cando a situación o permite. Ao comezar co remolque xa apuntando cara a onde queres retroceder, terás que facer menos manobras para estacionar."

	key[]: "aca_msg_book1_3_21_cutscene2"
	val[]: "Este tipo de manobra tamén permite unha visión máis ampla da praza de aparcamento, proporcionando unha mellor visibilidade da dirección na que te dirixes."

	key[]: "aca_msg_book1_3_21_cutscene3"
	val[]: "Conduce máis alá da praza de aparcamento e colócate nun ángulo duns 45 graos. O teu remolque debe estar apuntando cara ao camión do outro lado da praza na que vas aparcar."

	key[]: "aca_msg_book1_3_21_cutscene4"
	val[]: "Xira o camión como se quixeras afastarte da praza para empuxar a parte dianteira do remolque e así guiar a traseira cara á praza de aparcamento. Ten coidado de non xirar demasiado. Unha vez comezas a xirar, é máis sinxelo facer o xiro máis pechado que abrilo."

	key[]: "aca_msg_book1_3_21_cutscene5"
	val[]: "A medida que o remolque entra na praza de aparcamento, endereita a tractora e aliña o conxunto."

	key[]: "aca_msg_book1_3_21_cutscene6"
	val[]: "Detente na área designada e inmobiliza o camión."

#### 3_21 Driving Instructions
#!{
	key[]: "aca_msg_book1_3_21_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

	key[]: "aca_msg_book1_3_21_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
	key[]: "aca_msg_book1_3_21_forward"
	val[]: "Hai unha praza para aparcar á esquerda. Conduce máis alá dela e colócate nun ángulo de 45 graos.<br><br><font face=/font/big_bold.font>Conduce cara adiante.</font>"

	key[]: "aca_msg_book1_3_21_check1"
	val[]: "Aliña o camión coas marcas do chan.<br><br><font face=/font/big_bold.font>Detente na área marcada.</font>"

	key[]: "aca_msg_book1_3_21_check2"
	val[]: "Usando os coñecementos que adquiriches nos escenarios anteriores, xira o remolque cara á praza de aparcamento.<br><br><font face=/font/big_bold.font>Comeza a dar marcha atrás.</font>"

	key[]: "aca_msg_book1_3_21_stop"
	val[]: "Sigue dirixindo o remolque cara á praza de aparcamento.<br><br>@@aca_msg_book1_2_01_stop@@"


#@}

