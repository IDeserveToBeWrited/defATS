#+ Books general.
#@{
	key[]: "aca_modded_book"
	val[]: "Mod"

	key[]: "aca_book_inaccessible"
	val[]: "Contido novo proximamente. Mantente ao tanto."

	key[]: "aca_book_inaccessible_t"
	val[]: "PROXIMAMENTE"

	key[]: "aca_book_inaccessible_u"
	val[]: "Proximamente!"

	key[]: "aca_book_disclaimer_t"
	val[]: "AVISO LEGAL"

	key[]: "aca_book_disclaimer_topbar"
	val[]: "Este non é un programa de formación certificado."

	key[]: "aca_book_disclaimer"
	val[]: "<color value=@@clr_sel@@><font face=/font/big_bold.font>Esta @@driving_academy@@ non ten a intención de substituír a formación nun vehículo real.</font><br><br> <color value=@@clr_txt@@>Recomendamos encarecidamente procurar formación dunha autoescola de camións acreditada antes de tentar conducir un camión na vida real.<br><br>As autoescolas que estean interesadas en usar a nosa @@driving_academy@@ para suplementar a formación en cabina poden contactarnos en academy@scssoft.com."

	key[]: "aca_book_book1_title"
	val[]: "Conceptos básicos da condución de camións"

	key[]: "aca_book_book1_desc"
	val[]: "Aprende os coñecementos básicos para conducir un camión, dende as funcións e controis básicos ata facer manobras cun remolque."

	key[]: "aca_book_book2_title"
	val[]: "Dominio da condución de camións"

	key[]: "aca_book_book2_desc"
	val[]: "Perfecciona as túas habilidades ao volante dun camión con novos escenarios en condicións máis desafiantes."

	key[]: "aca_book_book3_title"
	val[]: "Condución con dobre remolque"

	key[]: "aca_book_book3_desc"
	val[]: "Take on the curious challenges of driving and reversing with a B-double combination."
#@}

