	key[]: "aca_msg_book1_2_03_mirror_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/front_mirror_possition_1.mat width=336 height=189 color=FFFFFFFF></align><offset vshift=189>"

	key[]: "aca_msg_book1_2_03_mirror_msg_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/front_mirror.mat width=336 height=189 color=FFFFFFFF></align><offset vshift=189>"

	key[]: "aca_msg_book1_2_03_check1_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/where_to_park.mat width=336 height=248 color=FFFFFFFF></align><offset vshift=248>"
#!}

#+ Book 1 Scenario 2_03
#@{

#### 2_03 common
	key[]: "aca_scenario_book1_2_03_title"
	val[]: "Parar preto dun obstáculo"

	key[]: "aca_scenario_book1_2_03_desc"
	val[]: "Neste escenario falaremos do espello frontal, a súa localización e como usalo para parar preto dun obstáculo á fronte."

#### 2_03 goal

	key[]: "aca_goal_book1_2_03_mirror"
	val[]: "Comprobar o espello frontal"

	key[]: "aca_goal_book1_2_03_check1"
	val[]: "Parar preto do obstáculo"

	key[]: "aca_goal_book1_2_03_mirror_msg"
	val[]: "Comprender a súa función"
#!{
	key[]: "aca_goal_book1_2_03_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_03_check1_msg"
	val[]: "@@aca_goal_book1_1_03_forward@@"

	key[]: "aca_goal_book1_2_03_end"
	val[]: "@@aca_goal_book1_2_01_end@@"


 #!}
#### 2_03 msg - intro

	key[]: "aca_msg_book1_2_03_cutscene1"
	val[]: "Os camións teñen un gran punto cego na área frontal da tractora. É fácil perder de vista a un peón ou mesmo un coche nesta zona, polo que os camións veñen equipados cun espello frontal que se pode ver a través do parabrisas."

	key[]: "aca_msg_book1_2_03_cutscene2"
	val[]: "O espello frontal está deseñado para que o condutor poda ver este punto cego.<br>É unha ferramenta esencial para asegurarse de non chocar con ningún obstáculo cando manobras en espazos reducidos."

	key[]: "aca_msg_book1_2_03_cutscene3"
	val[]: "Inicia a marcha, vai cara á barreira que hai diante de ti e despois reduce a velocidade a medida que te achegas a ela.<br>Mantén un ollo no espello frontal."

	key[]: "aca_msg_book1_2_03_cutscene4"
	val[]: "Detente entre a liña e o obstáculo."

#### 2_03 Driving Instructions

	key[]: "aca_msg_book1_2_03_mirror"
	val[]: "@@aca_msg_book1_2_03_mirror_img@@<br> Neste escenario imos aprender a usar o espello frontal que podes ver no diagrama.<br><br><font face=/font/big_bold.font>Mira a través do parabrisas cerca do lado do pasaxeiro. </font>"

	key[]: "aca_msg_book1_2_03_mirror_msg"
	val[]: "@@aca_msg_book1_2_03_mirror_msg_img@@<br>O espello frontal permite ver o punto cego que hai no frontal do camión. Pode axudarte a conducir con máis seguridade e precisión.<br><br>Se non estás conforme co seu axuste, abre '@@adjust_link_t@@' (podes acceder a través do menú de pausa) para axustalo ao teu gusto.<br><br><font face=/font/big_bold.font>Preme @@imv_nrm_activate@@ para continuar. </font>"

	key[]: "aca_msg_book1_2_03_start"
	val[]: "De fronte ao camión hai un espazo sinalizado, e verás que ao outro lado dese espazo hai un obstáculo. Cando esteas preto a el, conduce moi amodo e comproba no espello frontal a distancia ata o obstáculo.<br><br><font face=/font/big_bold.font>Prepárate para partir. </font>"

	key[]: "aca_msg_book1_2_03_start_fail"
	val[]: "O camión aínda non esta listo para moverse, ¿pode ser que esqueceras algo?<br><br>Está arrancado o motor? Quitaches o freo de estacionamento?"

	key[]: "aca_msg_book1_2_03_check1_msg"
	val[]: "<font face=/font/big_bold.font>Conduce cara á praza de aparcamento. </font>"

	key[]: "aca_msg_book1_2_03_check1"
	val[]: "@@aca_msg_book1_2_03_check1_img@@<br><font face=/font/big_bold.font>Detén o frontal do camión entre o obstáculo e a liña marcada no chan. </font>"
#!{
	key[]: "aca_msg_book1_2_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

