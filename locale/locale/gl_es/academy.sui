	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_10_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

 #!}
#### 3_10 msg - intro text

	key[]: "aca_msg_book1_3_10_cutscene1"
	val[]: "Neste escenario imos aprender a manobrar marcha atrás cara ao lado cego, o do pasaxeiro. Este tipo de manobra debe evitarse a non ser que non haxa outra alternativa, xa que a túa visibilidade está moi limitada. Tomate o teu tempo e extrema a precaución."

	key[]: "aca_msg_book1_3_10_cutscene2"
	val[]: "Conduce ata pasar a praza de aparcamento para darte espazo para manobrar unha vez comeces a retroceder."

	key[]: "aca_msg_book1_3_10_cutscene3"
	val[]: "Detente, comproba os teus arredores e comeza a retroceder."

	key[]: "aca_msg_book1_3_10_cutscene4"
	val[]: "Xira a cabeza tractora cara ao lado contrario de onde se atopa a praza de aparcamento. Isto empuxará a parte frontal do remolque, e á vez dirixirá a parte traseira do remolque cara á praza de aparcamento na que queres entrar. Ten coidado de non xirar demasiado para non facer a tesoira."

	key[]: "aca_msg_book1_3_10_cutscene5"
	val[]: "A medida que o remolque entra na praza de aparcamento, comeza a endereitar o camión."

	key[]: "aca_msg_book1_3_10_cutscene6"
	val[]: "Detente na área designada e inmobiliza o camión."

#### 3_10 Driving Instructions

	key[]: "aca_msg_book1_3_10_start"
	val[]: "Manobrar marcha atrás cara ao lado cego require os mesmos métodos que cara ao lado do condutor, pero terás a dificultade engadida da falta de visibilidade nese lado. Usa os espellos e o teu mellor criterio para aparcar o camión.<br><br><font face=/font/big_bold.font>Prepárate para saír.</font>"

	key[]: "aca_msg_book1_3_10_forward"
	val[]: "Hai unha praza de aparcamento máis adiante do lado dereito. Terás que pasala considerablemente para ter suficiente espazo para manobrar ao retroceder.<br><br><font face=/font/big_bold.font>Conduce cara adiante.</font>"
#!{
	key[]: "aca_msg_book1_3_10_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
	key[]: "aca_msg_book1_3_10_check2"
	val[]: "Lembra, xirar a cabeza tractora cara ao lado contrario á praza fará que o remolque xire cara a ela. Usa os espellos para axudarte a meterte na praza de aparcamento.<br><br><font face=/font/big_bold.font>Comeza a retroceder.</font>"


#@}

#+ Book 1 Scenario 3_11
#@{

#### 3_11 common
	key[]: "aca_scenario_book1_3_11_title"
	val[]: "Circular por unha rotonda"

	key[]: "aca_scenario_book1_3_11_desc"
	val[]: "Neste escenario veremos como afrontar unha rotonda.<br><br>Terás que prestar especial atención ao teu remolque, xa que seguirá unha traxectoria diferente ao entrar, conducir pola rotonda e ao saír dela."

#### 3_11 goal
#!{
	key[]: "aca_goal_book1_3_11_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_11_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


	key[]: "aca_goal_book1_3_11_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_11_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
 #!}

	key[]: "aca_goal_book1_3_11_check1"
	val[]: "Entrar na rotonda"

	key[]: "aca_goal_book1_3_11_check2"
	val[]: "Circular pola rotonda"

	key[]: "aca_goal_book1_3_11_check3"
	val[]: "Circular pola rotonda"

	key[]: "aca_goal_book1_3_11_check5"
	val[]: "Saír da rotonda"

	key[]: "aca_goal_book1_3_11_check6"
	val[]: "Conducir cara á zona designada"

#### 3_11 msg - intro text

	key[]: "aca_msg_book1_3_11_cutscene1"
	val[]: "As rotondas son cada vez máis habituais en América, así que é importante saber como afrontalas."

	key[]: "aca_msg_book1_3_11_cutscene3"
	val[]: "Mantente polo exterior do teu carril ao achegarte á rotonda. Isto axudará a que o teu remolque libre o interior do xiro á entrada da rotonda."

	key[]: "aca_msg_book1_3_11_cutscene4"
	val[]: "Conduce cara ao centro da rotonda ao entrar. Unha vez esteas dentro, terás que abrirte cara ao exterior. Isto é para manter o teu remolque afastado do centro da rotonda."

	key[]: "aca_msg_book1_3_11_cutscene5"
	val[]: "Mantén un ollo no espello para asegurarte de que o remolque non se acerca demasiado ás barreiras do interior."

	key[]: "aca_msg_book1_3_11_cutscene6"
	val[]: "Saír da rotonda é relativamente sinxelo porque o remolque xa está afastado do interior da saída. Fai un xiro amplo á saída e o remolque debería seguirte facilmente."

	key[]: "aca_msg_book1_3_11_cutscene7"
	val[]: "Aparca na área designada e inmobiliza o camión."



#### 3_11 Driving Instructions
#!{
	key[]: "aca_msg_book1_3_11_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

	key[]: "aca_msg_book1_3_11_forward"
	val[]: "Á túa fronte hai unha rotonda pola que tes que circular.<br><br><font face=/font/big_bold.font>Vaite achegando á rotonda. </font>"

	key[]: "aca_msg_book1_3_11_check1"
	val[]: "Fai un xiro amplo ao entrar na rotonda, de maneira que o teu remolque entre detrás de ti sen problema. <br><br><font face=/font/big_bold.font>Entra na rotonda. </font>"

	key[]: "aca_msg_book1_3_11_check2"
	val[]: "Conduce cara ao exterior da rotonda. Terás que manter o camión afastado o máximo posible do centro da rotonda para evitar tocar co remolque as barreiras do centro. <br><br><font face=/font/big_bold.font>Continúa pola rotonda.</font>"

	key[]: "aca_msg_book1_3_11_check3"
	val[]: "Mantente preto dos conos do exterior. <br><br><font face=/font/big_bold.font>Sigue conducindo.</font>"

	key[]: "aca_msg_book1_3_11_check5"
	val[]: "<font face=/font/big_bold.font>Sae da rotonda. </font>"

	key[]: "aca_msg_book1_3_11_check6"
	val[]: "<font face=/font/big_bold.font>Diríxete cara á praza de aparcamento. </font>"

	key[]: "aca_msg_book1_3_11_stop"
	val[]: "<font face=/font/big_bold.font>Detente na área designada.</font>"

	key[]: "aca_msg_book1_3_11_end"
	val[]: "<font face=/font/big_bold.font>Inmobiliza o camión e apaga o motor.</font>"
#@}

#+ Book 1 Scenario 3_12
#@{

#### 3_12 common
	key[]: "aca_scenario_book1_3_12_title"
	val[]: "Manobrar en espazos estreitos"

	key[]: "aca_scenario_book1_3_12_desc"
	val[]: "Neste escenario terás que dar a volta co camión nun espazo reducido, o que requirirá poñer atención ao teu arredor e un uso intelixente do espazo dispoñible."

#### 3_12 goal



	key[]: "aca_goal_book1_3_12_check1"
	val[]: "Colocarse para retroceder"

	key[]: "aca_goal_book1_3_12_check2"
	val[]: "Abandonar a zona"

	key[]: "aca_goal_book1_3_12_check3"
	val[]: "Dar marcha atrás cara á praza de aparcamento"

	key[]: "aca_goal_book1_3_12_check4"
	val[]: "Completar a manobra do lado cego"
