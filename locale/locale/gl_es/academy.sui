#### 3_04 common
	key[]: "aca_scenario_book1_3_04_title"
	val[]: "Pista de formación avanzada - Remolque"

	key[]: "aca_scenario_book1_3_04_desc"
	val[]: "No escenario final do capítulo 3 conduciremos nunha pista de formación máis longa, cunha variedade de diversos xiros, para comprobar como de ben aprendiches a manobrar cun remolque."

#### 3_04 goal



	key[]: "aca_goal_book1_3_04_check1"
	val[]: "Xiros doados"

	key[]: "aca_goal_book1_3_04_check2"
