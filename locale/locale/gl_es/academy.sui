	val[]: "@@aca_goal_book3_sup_check1@@"

	key[]: "aca_goal_book3_3_11_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_3_11_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### 3_11 msg - intro text

	key[]: "aca_msg_book3_3_11_cutscene1"
	val[]: "Roundabouts are a little more complicated to negotiate with B-doubles than a single trailer."

	key[]: "aca_msg_book3_3_11_cutscene2"
	val[]: "You must drive in far enough that both trailers will enter successfully, but you must then drive to the outside to keep the trailers away from the centre."

	key[]: "aca_msg_book3_3_11_cutscene3"
	val[]: "It's okay if both trailers won't fit in one lane - in fact, it may even be better to straddle both lanes so that an optimistic motorist doesn't try to pass you."

	key[]: "aca_msg_book3_3_11_cutscene4"
	val[]: "Drive to the far side of your exit lane to again ensure both trailers are clear of any potential collisions."

	key[]: "aca_msg_book3_3_11_cutscene5"
	val[]: "Continue to the second roundabout."

	key[]: "aca_msg_book3_3_11_cutscene6"
	val[]: "This roundabout only has one lane, so take your time and be precise."

	key[]: "aca_msg_book3_3_11_cutscene7"
	val[]: "Use all of the room available to you - cutting corners here will only make things more difficult."

	key[]: "aca_msg_book3_3_11_cutscene8"
	val[]: "Take the exit and proceed towards the parking area."

	key[]: "aca_msg_book3_3_11_cutscene9"
	val[]: "Park and secure the truck."

#### 3_11 infinite Fun Driving Instructions

#!{
	key[]: "aca_msg_book3_3_11_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_3_11_forward"
	val[]: "You're on a course designed to familiarize you with negotiating roundabouts. Proceed forward when you're ready."

	key[]: "aca_msg_book3_3_11_check1"
	val[]: "Drive well into the roundabout before heading towards the outer cones to ensure both trailers enter safely."

	key[]: "aca_msg_book3_3_11_check2"
	val[]: "You'll want to drive to the far side of the exit to keep your trailers off the cones. <br><br>It may help to turn towards the centre of the roundabout just before exiting it."

#!{
	key[]: "aca_msg_book3_3_11_check3"
	val[]: "@@aca_msg_book3_sup_check1@@"
#!}
	key[]: "aca_msg_book3_3_11_check4"
	val[]: "You should be able to negotiate this one on your own, take your time and use your space wisely."

	key[]: "aca_msg_book3_3_11_check5"
	val[]: "Exit the roundabout carefully."

#!{
	key[]: "aca_msg_book3_3_11_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_3_11_end"
	val[]: "@@aca_msg_book3_sup_end@@"
