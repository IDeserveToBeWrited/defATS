#### 2_06 msg - intro text

	key[]: "aca_msg_book1_2_06_cutscene01"
	val[]: "Para o escenario final deste capítulo conduciremos na pista de probas coa configuración complexa."

	key[]: "aca_msg_book1_2_06_cutscene02"
	val[]: "O primeiro obstáculo é un slálom a través dunhas barreiras. Atravésao e lembra usar os espellos."

	key[]: "aca_msg_book1_2_06_cutscene04"
	val[]: "Despois ven unha curva en U. Fai o xiro aberto e non debería supoñerte ningún problema."

	key[]: "aca_msg_book1_2_06_cutscene05"
	val[]: "O traxecto estreita considerablemente adiante. Sigue con coidado e usa o espello lateral para axudarte."

	key[]: "aca_msg_book1_2_06_cutscene06"
	val[]: "Next is a series of easy 90-degree turns."

	key[]: "aca_msg_book1_2_06_cutscene08"
	val[]: "A sección seguinte tes que facela marcha atrás. Aproxímate ás barreiras tendo isto en conta."

	key[]: "aca_msg_book1_2_06_cutscene09"
	val[]: "Sigue as marcas do chan cara atrás e a través das curvas."

	key[]: "aca_msg_book1_2_06_cutscene10"
	val[]: "Sigue marcha atrás ata as barreiras, detente e sigue de fronte cara á dereita."

	key[]: "aca_msg_book1_2_06_cutscene11"
	val[]: "Este paso a través dos conos é moi estreito. Conduce amodo e usa os espellos para guiarte polo paso."

	key[]: "aca_msg_book1_2_06_cutscene13"
	val[]: "Ahead is a series of alternating left and right 90-degree turns."

	key[]: "aca_msg_book1_2_06_cutscene15"
	val[]: "Pode que atopes trens neste paso a nivel. Se é así, para e agarda a que pase. Despois, poderás xirar á dereita cara á vía de servizo."

	key[]: "aca_msg_book1_2_06_cutscene16"
	val[]: "Xira á esquerda na estrada. Poderás acelerar despois de completar o xiro."

	key[]: "aca_msg_book1_2_06_cutscene18"
	val[]: "Unhas poucas curvas á esquerda máis na vila e chegarás ao teu destino!"

	key[]: "aca_msg_book1_2_06_cutscene19"
	val[]: "Achégate ás barreiras e prepárate para aparcar no aparcamento da dereita."

	key[]: "aca_msg_book1_2_06_cutscene20"
	val[]: "Dá marcha atrás ata o lugar de estacionamento, e despois apaga o motor e inmobiliza o camión."

#### 2_06 Driving Instructions



	key[]: "aca_msg_book1_2_06_forward"
	val[]: "En fronte hai un slálom feito con barreiras.<br><br><font face=/font/big_bold.font>Conduce a través do slálom.</font>"

	key[]: "aca_msg_book1_2_06_forward2"
	val[]: "<font face=/font/big_bold.font>Sigue o percorrido pola curva en U. </font>"

	key[]: "aca_msg_book1_2_06_check1"
	val[]: "O traxecto estreita considerablemente adiante. Podes usar o espello lateral para axudarte.<br><br><font face=/font/big_bold.font>Sigue con coidado. </font>"

	key[]: "aca_msg_book1_2_06_check2"
	val[]: "After the curve is a 90-degree turn.<br><br><font face=/font/big_bold.font>Adjust your speed accordingly.</font>"

	key[]: "aca_msg_book1_2_06_check3"
	val[]: "Diante hai uns xiros sinxelos. Continúa adaptando a túa velocidade segundo sexa necesario.<br><br><font face=/font/big_bold.font>Sigue conducindo. </font>"

	key[]: "aca_msg_book1_2_06_check4"
	val[]: "A seguinte sección tes que completala marcha atrás. Detente na barreira de xeito que podas dar marcha atrás cara á dereita despois.<br><br><font face=/font/big_bold.font>Detente nas barreiras.</font>"

	key[]: "aca_msg_book1_2_06_check5"
	val[]: "Vai marcha atrás cara á área detrás de ti e á dereita.<br><br><font face=/font/big_bold.font>Comeza a ir marcha atrás. </font>"

	key[]: "aca_msg_book1_2_06_reverse"
	val[]: "Sigue a traxectoria a través das curvas.<br><br><font face=/font/big_bold.font>Continúa marcha atrás.</font>"

	key[]: "aca_msg_book1_2_06_check6"
	val[]: "Detrás de ti á esquerda hai unhas barreiras. <br><br><font face=/font/big_bold.font>Xira cara ás barreiras e prepárate para deterte.</font>"

	key[]: "aca_msg_book1_2_06_check7"
	val[]: "Detente e cambia a unha marcha de avance, despois continúa pola dereita. <br><br><font face=/font/big_bold.font>Conduce cara adiante. </font>"

	key[]: "aca_msg_book1_2_06_check8"
	val[]: "En fronte hai un treito estreito e sinuoso a través duns conos. Conduce con coidado e usa os teus espellos se o consideras necesario.<br><br><font face=/font/big_bold.font>Conduce entre os conos. </font>"

	key[]: "aca_msg_book1_2_06_check9"
	val[]: "Next are a combination of different 90-degree turns. Be sure to approach each turn with a wide berth.<br><br><font face=/font/big_bold.font>Continue driving. </font>"

	key[]: "aca_msg_book1_2_06_check10"
	val[]: "Observa o paso a nivel a medida que te acercas. Os sinais poden activarse para advertir da aproximación dun tren.<br><br><font face=/font/big_bold.font>Sigue con precaución.</font>"

	key[]: "aca_msg_book1_2_06_check11"
	val[]: "O xiro cara á vía de servizo está bloqueado parcialmente por un obstáculo, así que mantente á esquerda mentres te aproximas para darte máis espazo.<br><br><font face=/font/big_bold.font>Fai o xiro. </font>"

	key[]: "aca_msg_book1_2_06_check12"
	val[]: "Podes elixir se queres respectar o sinal de stop, posto que a ruta está pechada ao tráfico para nós.<br><br><font face=/font/big_bold.font>Xira á esquerda.</font>"

	key[]: "aca_msg_book1_2_06_check13"
	val[]: "Aquí podes coller algo de velocidade, pero terás que xirar no próximo cruzamento.<br><br><font face=/font/big_bold.font>Continúa o percorrido. </font>"

	key[]: "aca_msg_book1_2_06_check14"
	val[]: "Avanza cara ao pobo facendo un xiro á esquerda, e despois fai outros dous xiros á esquerda para ir á área final.<br><br><font face=/font/big_bold.font>Conduce a través do pobo.</font>"

	key[]: "aca_msg_book1_2_06_check15"
	val[]: "Ao outro lado do aparcamento hai unhas barreiras. Conduce ata elas.<br><br><font face=/font/big_bold.font>Detente preto das barreiras. </font>"

	key[]: "aca_msg_book1_2_06_check16"
	val[]: "Detrás de ti á dereita hai un sitio para aparcar.<br><br><font face=/font/big_bold.font>Vai marcha atrás ata esa zona de aparcamento. </font>"
#!{
	key[]: "aca_msg_book1_2_06_check17"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_06_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_2_06_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

#@}

#+ Book 1 Scenario 2_08
#@{

#### 2_08 common
	key[]: "aca_scenario_book1_2_08_title"
	val[]: "Pista de formación simple"

	key[]: "aca_scenario_book1_2_08_desc"
	val[]: "Neste escenario imos poñer a proba as habilidades que aprendiches ata agora nunha condución a través dun circuíto de práctica sinxelo."

#### 2_08 goal
#!{
	key[]: "aca_goal_book1_2_08_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_08_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

