#+ Text deviations for American Truck Simulator. Please, use only terms appropriate for USA (i.e. culture specific nuances, not American English).
#@{

#+ Music/radio player
#@{

#+ Hint shown if no music files are found. Also shown as tooltip when hovering over music_player button.

	key[]: "music_player_hint"
	val[]: "Helyezd kedvenc zeneszámaidat a <color value=@@clr_sel@@>Dokumentumok <color value=@@clr_txt@@>mappa <color value=@@clr_sel@@>American Truck Simulator/music <color value=@@clr_txt@@>könyvtárába, hogy megjelenjenek a zenelejátszóban!"

#+ Tooltip shown when hovering over the radio_stream button.

	key[]: "radio_hint"
	val[]: "Ha szeretnéd hozzáadni kedvenc netrádiódat a rádiólistához, szerkeszd át a <color value=@@clr_sel@@>Dokumentumok <color value=@@clr_txt@@>mappa <color value=@@clr_sel@@>American Truck Simulator <color value=@@clr_txt@@>könyvtárában található <color value=@@clr_sel@@>live_streams.sii <color value=@@clr_txt@@>fájlt!"

#+ Hint shown if no online radio streams are defined.

	key[]: "empty_radio_hint"
	val[]: "Kérlek olvasd el a <color value=@@clr_sel@@>Dokumentumok <color value=@@clr_txt@@>könyvtár <color value=@@clr_sel@@>American Truck Simulator <color value=@@clr_txt@@>mappájában található <color value=@@clr_sel@@>readme.rtf <color value=@@clr_txt@@>fájlt, ha saját zenét és online rádiót akarsz a lejátszóhoz adni!"
#@}

