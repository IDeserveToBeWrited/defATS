	#+ prepare the player for an upcoming check
	key[]: "agri_check_ahead"
	val[]: "Mezőgazdasági ellenőrzés következik. Készülj fel a lelassításra!"

	#+ stop the vehicle
	key[]: "agri_check_stop"
	val[]: "A mezőgazdasági ellenőrzés elkezdéséhez állj meg, és nyomd le a következőt:"

	#+ checking/waiting
	key[]: "agri_check_wait"
	val[]: "Vizsgálat folyamatban..."

	#+ inspection passed
	key[]: "agri_check_pass"
	val[]: "A vizsgálat befejeződött! Folytathatod az utadat!"

	#+ inspection skipped
	key[]: "offence_avoid_inspection"
	val[]: "Nem álltál meg ellenőrzésre!"
#@}

