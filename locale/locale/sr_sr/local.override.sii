#@{

#+ Music/radio player
#@{

#+ Hint shown if no music files are found. Also shown as tooltip when hovering over music_player button.

	key[]: "music_player_hint"
	val[]: "Ставите ваше песме у <color value=@@clr_sel@@>American Truck Simulator/music <color value=@@clr_txt@@>фолдер у вашим <color value=@@clr_sel@@>Documents <color value=@@clr_txt@@>и појавиће се овде."

#+ Tooltip shown when hovering over the radio_stream button.

	key[]: "radio_hint"
	val[]: "Измените <color value=@@clr_sel@@>live_streams.sii <color value=@@clr_txt@@>у <color value=@@clr_sel@@>American Truck Simulator <color value=@@clr_txt@@>фолдеру у вашим <color value=@@clr_sel@@>Documents <color value=@@clr_txt@@>и слушајте ваш омиљени Интернет-радио током игре!"

#+ Hint shown if no online radio streams are defined.

	key[]: "empty_radio_hint"
	val[]: "Молимо, погледајте <color value=@@clr_sel@@>readme.rtf <color value=@@clr_txt@@>у <color value=@@clr_sel@@>American Truck Simulator <color value=@@clr_txt@@>фолдеру у вашим <color value=@@clr_sel@@>Documents <color value=@@clr_txt@@>како да додате своју музику и радио-станице."
#@}

