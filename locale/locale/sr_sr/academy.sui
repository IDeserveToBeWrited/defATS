#+ Book 2 intro
#@{

#### common
	key[]: "aca_scenario_book2_intro_title"
	val[]: "Вештине за вожњу камиона"


#### intro text

	key[]: "aca_scenario_book2_book2_intro_cutscene1"
	val[]: "Добродошли назад у @@driving_academy@@!"

	key[]: "aca_scenario_book2_book2_intro_cutscene2"
	val[]: "Следећи сценарији представљају следећи корак на вашем путу ка професионалној вожњи камиона."

	key[]: "aca_scenario_book2_book2_intro_cutscene3"
	val[]: "Овог пута вас нећемо водити кроз сваки задатак, тако да је на вама да употребите своје вештине и искуство."

	key[]: "aca_scenario_book2_book2_intro_cutscene4"
	val[]: "Можда ћете наићи на неке познате маневре, али овог пута у новим окружењима направљеним да више личе на сценарије из стварног света."

	key[]: "aca_scenario_book2_book2_intro_cutscene5"
	val[]: "Ново за @@driving_academy@@ је додавање услова „Пролаз“ и „Бонус“."

	key[]: "aca_scenario_book2_book2_intro_cutscene6"
	val[]: "Као и пре, и даље морате завршити сваки сценарио без ударања у било шта, тако што ћете успешно паркирати и осигурати камион..."

	key[]: "aca_scenario_book2_book2_intro_cutscene7"
	val[]: "...али сада то морате учинити и у предвиђеном временском ограничењу, и са ограничењем у броју промена смера између вожње напред и назад."

	key[]: "aca_scenario_book2_book2_intro_cutscene8"
	val[]: "Бонус услови се могу испунити завршетком сваког сценарија са још изазовнијим условима..."

	key[]: "aca_scenario_book2_book2_intro_cutscene9"
	val[]: "...као што су строжа временска ограничења, мање промена правца и искључиво коришћење унутрашње камере."

	key[]: "aca_scenario_book2_book2_intro_cutscene10"
	val[]: "Завршетком свих сценарија, можете себе сматрати вештим возачем камиона и спремним за следећи изазов на путу.<br><br>Да бисте себе додатно изазвали, испуните све бонус услове за сваки сценарио; онда ћете заиста бити звезда возача камиона!"


#@}



#+ Book 2 zero
#@{
#### zero common
	key[]: "aca_scenario_book2_zero_title"
	val[]: "Туторијал"

	key[]: "aca_scenario_book2_zero_desc"
	val[]: "У овом туторијалу, помоћи ћемо вам да се упознате са новим функцијама које се налазе у Вичности за вожњу камиона."


#### zero info msg1

	key[]: "aca_msg_book2_scenario_zero1_title"
	val[]: "Вештине за вожњу камиона"

	key[]: "aca_msg_book2_scenario_zero1"
	val[]: "На почетку сваког сценарија, видећете <color value=@@clr_sel@@>„Брифинг сценарија“<color value=@@clr_txt@@> прозор. Ово ће вам дати информације о новим условима за пролаз и бонус за сценарио. <br><br>Услови за пролазак морају бити испуњени да би се сценарио успешно завршио, док су бонус услови опциони додатни изазов за искусне и веште играче. <br><br><font face=/font/big_bold.font>Да бисте наставили, укључите паљење.</font>"

#### zero info msg1b

	key[]: "aca_msg_book2_scenario_zero1b"
	val[]: "Један од бонус услова захтева да завршите сценарио док користите <color value=@@clr_sel@@>унутрашњу камеру<color value=@@clr_txt@@>. И даље можете користити спољашње камере да бисте проверили своју околину, али само док је камион заустављен.<br><br>Сада можете да се осврнете около да бисте се оријентисали, а затим се вратите на унутрашњу камеру.<br><br><font face=/font/big_bold.font>Пребаците се на камеру за праћење да бисте проверили околину</font>"


#### zero info msg1c


	key[]: "aca_msg_book2_scenario_zero1c"
	val[]: "Оријентишите се, а затим се вратите на унутрашњу камеру.<br><br><font face=/font/big_bold.font>Погледајте око камиона</font>"


#### zero info msg1d


	key[]: "aca_msg_book2_scenario_zero1d"
	val[]: "<font face=/font/big_bold.font>Вратите се на унутрашњу камеру</font>"
#### zero info msg2

	key[]: "aca_msg_book2_scenario_zero2_title"
	val[]: "Вештине вожње камиона"

	key[]: "aca_msg_book2_scenario_zero2"
	val[]: "<color value=@@clr_sel@@>Време<color value=@@clr_txt@@> такође ће бити фактор у вештини вожње камиона. Сви сценарији ће имати индивидуално временско ограничење у којем сценарио мора бити завршен као услов за пролаз, а многи ће такође имати додатно, строже ограничење као бонус услов.<br><br>Тајмер се покреће тек након што се камион помери.<br><br><font face=/font/big_bold.font>Упалите мотор и отпустите ручну кочницу да бисте наставили.</font>"


#### zero info msg3

	key[]: "aca_msg_book2_scenario_zero3_title"
	val[]: "Вештине вожње камиона"

	key[]: "aca_msg_book2_scenario_zero3"
	val[]: "Још један нови додатак за вештину вожње камиона су путне тачке. Све путне тачке морају бити достигнуте пре него што се сценарио може завршити. <br><br>Поред тога, путне тачке су осетљиве на то у ком правцу је камион окренут када се стигне до путне тачке, зато обратите пажњу на све ознаке на земљи у близини путне тачке како бисте се правилно оријентисали.<br><br><font face=/font/big_bold.font>Возите напред до путне тачке испред вас.</font>"


#### zero info msg4

	key[]: "aca_msg_book2_scenario_zero4_title"
	val[]: "Вештине вожње камиона"

	key[]: "aca_msg_book2_scenario_zero4"
	val[]: "Стигли сте до циљне тачке и сада можете прећи на следећи корак. <br><br>Иза вас се налази још једна тачка у коју морате да се померите уназад. Обратите пажњу на стрелицу на земљи која показује у ком правцу камион треба да буде окренут када стигнете до тачке. <br><br>Још један услов за пролаз и бонус који се мора узети у обзир је <color value=@@clr_sel@@>Промене правца<color value=@@clr_txt@@>. Бројимо колико пута промените смер између вожње напред и вожње уназад. Останите испод ограничења да бисте испунили услов.<br><br><font face=/font/big_bold.font>Вратите се на путну тачку и зауставите се.</font>"

#### zero info msg5

	key[]: "aca_msg_book2_scenario_zero5_title"
	val[]: "Вештине вожње камиона"

	key[]: "aca_msg_book2_scenario_zero5"
	val[]: "Дакле, до сада сте требали акумулирати једну промену смера. <br><br>Покупите приколицу иза себе да бисте прешли на следећи корак. <br><br><font face=/font/big_bold.font>Крените уназад испод приколице да бисте је спојили.</font>"

#### zero info msg6

	key[]: "aca_msg_book2_scenario_zero6_title"
	val[]: "Вештине вожње камиона"

	key[]: "aca_msg_book2_scenario_zero6"
	val[]: "Последње паркинг место је са ваше десне стране. Неки сценарији могу имати само једно паркинг место, док ће други имати више њих за избор. Правилно паркирање на било ком од места ће вам омогућити да завршите сценарио. <br><br><font face=/font/big_bold.font> Притисните @@imv_nrm_attach@@ да повежете приколицу. </font>"


#### zero info msg7

	key[]: "aca_msg_book2_scenario_zero7_title"
	val[]: "Вештине вожње камиона"

	key[]: "aca_msg_book2_scenario_zero7"
	val[]: "Паркинг места такође показују у ком правцу камион треба да буде оријентисан на том месту. Паркирање у погрешном смеру и нећете моћи да завршите сценарио док се не исправите, што ће вас коштати времена и промене правца.<br><br><font face=/font/big_bold.font>Возите до једног од паркинг места и правилно паркирајте.</font>"



#### zero info msg8

	key[]: "aca_msg_book2_scenario_zero8_title"
	val[]: "Вештине вожње камиона"

	key[]: "aca_msg_book2_scenario_zero8"
	val[]: "Сада би требало да будете упознати са новим параметрима за услове за пролаз и бонус циљеве и да будете спремни да се ухватите у коштац са новим сценаријима у вештини вожње камиона!<br><br><font face=/font/big_bold.font>Обезбедите камион активирањем ручне кочнице и искључивањем мотора да бисте завршили сценарио.</font>"



#@}

