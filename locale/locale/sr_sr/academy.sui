	key[]: "aca_goal_book1_3_02_start"
	val[]: "@@aca_goal_book1_2_01_start@@"
 #!}
#### 3_02 msg - intro text

	key[]: "aca_msg_book1_3_02_cutscene01"
	val[]: "У овом сценарију, одвешћемо камион на кратку вожњу. Моћи ћете да стекнете осећај кочења са приколицом док се спуштамо благим нагибом напред. Припремите камион и крените."

	key[]: "aca_msg_book1_3_02_cutscene06"
	val[]: "Достигните брзину од најмање 60 км/х (37 мпх). Будите спремни за зону кочења испред вас."

	key[]: "aca_msg_book1_3_02_cutscene08"
	val[]: "Почните кочити до заустављања. Пазите да не чекате предуго, иначе бисте могли да ударите у баријере испред себе!"

	key[]: "aca_msg_book1_3_02_cutscene10"
	val[]: "Паркирајте на одређеном месту, затим обезбедите камион и угасите мотор."


#### 3_02 Driving Instructions

	key[]: "aca_msg_book1_3_02_start"
	val[]: "Током ове вожње, стећи ћете осећај да користите радне кочнице док се спуштате благим нагибом. Сврха ове вежбе је да постанете свесни тежине иза вас и како она утиче на пут кочења возила.<br><br><font face=/font/big_bold.font>Припремите се за полазак. </font>"

	key[]: "aca_msg_book1_3_02_forward"
	val[]: "Почните да возите сада и имајте на уму да ћете морати да постигнете брзину од 60 км/х (37 мпх) <font face=/font/big_bold.font>после</font> скретања напред.<br><br><font face=/font/big_bold.font>Возите према скретању испред вас. </font>"

	key[]: "aca_msg_book1_3_02_check1"
	val[]: "Скрените десно, а затим убрзајте до 60 км/х (37 мпх).<br><br><font face=/font/big_bold.font>Наставите вожњу </font>"

	key[]: "aca_msg_book1_3_02_check2"
	val[]: "<font face=/font/big_bold.font>Достигните брзину од најмање 60 км/х (37 мпх). </font>"

	key[]: "aca_msg_book1_3_02_check3"
	val[]: "Достигли сте потребну брзину.<br><br><font face=/font/big_bold.font>Зауставите се на препрекама испред. </font>"
#!{
	key[]: "aca_msg_book1_3_02_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_02_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

