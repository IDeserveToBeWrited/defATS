	key[]: "aca_goal_book1_2_08_forward"
	val[]: "Улазак на полигон"

	key[]: "aca_goal_book1_2_08_check1"
	val[]: "Широко скретање укоснице"

	key[]: "aca_goal_book1_2_08_check2"
	val[]: "Вожња кроз слалом"

	key[]: "aca_goal_book1_2_08_check3"
	val[]: "Тесно скретање укоснице"

	key[]: "aca_goal_book1_2_08_check4"
	val[]: "Уска кривина"

	key[]: "aca_goal_book1_2_08_check6"
	val[]: "Техничка секција"

	key[]: "aca_goal_book1_2_08_check7"
	val[]: "Отвори област"



#### 2_08 msg - intro text

	key[]: "aca_msg_book1_2_08_cutscene1"
	val[]: "У овом сценарију, одвешћемо тегљач на кратку вожњу да видимо како се носите са њим са својим новостеченим вештинама.<br>На стази постоје разне врсте и комбинације скретања. Није трка и није време. Будите стрпљиви и прилагодите брзину вожње скретањима и препрекама на које наилазите."

	key[]: "aca_msg_book1_2_08_cutscene2"
	val[]: "Уђите у стазу са широким скретањем укоснице."

	key[]: "aca_msg_book1_2_08_cutscene3"
	val[]: "Затим ћете наићи на низ препрека које вас воде у неправилан слалом."

	key[]: "aca_msg_book1_2_08_cutscene4"
	val[]: "Након што завршите неколико лаких скретања од 90°, наићи ћете на тесно окретање укоснице. Важно је да се правилно поставите, како да завршите скретање, тако и да глатко уђете у следећи сектор."

	key[]: "aca_msg_book1_2_08_cutscene5"
	val[]: "Водите рачуна о чуњевима док возите кроз дугу кривину јер је видљивост преко хаубе ограничена."

	key[]: "aca_msg_book1_2_08_cutscene6"
	val[]: "Још један сет баријера ће вас одвести у широки слалом."

	key[]: "aca_msg_book1_2_08_cutscene7"
	val[]: "Стаза се мало отвара, али не журите. Још неколико лаких скретања и готови сте."

	key[]: "aca_msg_book1_2_08_cutscene8"
	val[]: "Зауставите се на одређеном месту и обезбедите камион."


#### 2_08 Driving Instructions

	key[]: "aca_msg_book1_2_08_start"
	val[]: "Да бисте успешно завршили овај сценарио, не смете се сударити, слетети са стазе или ударити у саобраћајне чуњеве.<br><br><font face=/font/big_bold.font>Припремите се за полазак. </font>"

	key[]: "aca_msg_book1_2_08_forward"
	val[]:"<font face=/font/big_bold.font>Наставите напред у широко скретање за укосницу да уђете у стазу. </font>"

	key[]: "aca_msg_book1_2_08_check1"
	val[]: "<font face=/font/big_bold.font>Завршите скретање укоснице. </font>"

	key[]: "aca_msg_book1_2_08_check2"
	val[]: "Приближавате се баријерама распоређеним отприлике у слалом.<br><br><font face=/font/big_bold.font>У складу са тим прилагодите брзину и наставите.</font>"

	key[]: "aca_msg_book1_2_08_check3"
	val[]: "Следеће, имате два лака окрета од 90° праћена тесним скретањем укоснице. Полако.<br><br><font face=/font/big_bold.font>Наставите до тесног скретања укоснице.</font>"

	key[]: "aca_msg_book1_2_08_check4"
	val[]: "Излазећи из укоснице, наићи ћете на уску стазу кроз кривину. Морате се клонити унутрашње баријере, али пазите да не ударите чуњеве испред себе.<br><br><font face=/font/big_bold.font>Наставите кроз кривину. </font>"

	key[]: "aca_msg_book1_2_08_check6"
	val[]: "Пут испред нас је тесан, техничка скретања. Подесите брзину и пажљиво се крећете кроз део.<br><br><font face=/font/big_bold.font>Наставите вожњу. </font>"

	key[]: "aca_msg_book1_2_08_check7"
	val[]: "Следећи сектор је отворенији са неким лаким скретањима. Не жури.<br><br><font face=/font/big_bold.font>Наставите вожњу. </font>"
#!{
	key[]: "aca_msg_book1_2_08_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_08_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

#@}

