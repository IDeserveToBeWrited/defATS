	key[]: "aca_scenario_book3_finex_title"
	val[]: "Завршни испит"

	key[]: "aca_scenario_book3_finex_desc"
	val[]: "У овом сценарију, тестираћете своје нове вештине на курсу осмишљеном да тестира вашу прецизност и разумевање вожње са Б-дуплим приколицама."

#### finex goal

	key[]: "aca_goal_book3_finex_check0"
	val[]: "Вожња уназад"

	key[]: "aca_goal_book3_finex_check1"
	val[]: "Улазак на полигон"

	key[]: "aca_goal_book3_finex_check2"
	val[]: "Добити на брзини"

	key[]: "aca_goal_book3_finex_check22"
	val[]: "Припремите се за кочење"

