	key[]: "aca_msg_book1_3_04_cutscene12"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_04_cutscene13"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_04_cutscene14"
	val[]: "Unused"
#!}

#### 3_04 Driving Instructions



	key[]: "aca_msg_book1_3_04_forward"
	val[]: "<font face=/font/big_bold.font>Убрзајте и возите око баријера. </font>"

	key[]: "aca_msg_book1_3_04_check1"
	val[]: "Наставите на стазу и кроз прва два лака скретања.<br><br><font face=/font/big_bold.font>Наставите вожњу. </font>"

	key[]: "aca_msg_book1_3_04_check2"
	val[]: "<font face=/font/big_bold.font>Направите скретање од 90°.</font>"

	key[]: "aca_msg_book1_3_04_check3"
	val[]: "Следећи део курса је дупла укосница. Како ћете маневрисати кроз први део директно ће утицати на ваш пут кроз други део.<br><br><font face=/font/big_bold.font>Наставите са опрезом. </font>"

	key[]: "aca_msg_book1_3_04_check4"
	val[]: "Док излазите из укосница, држите се лево да бисте припремили улазак у уски сектор.<br><br><font face=/font/big_bold.font>Наставите вожњу. </font>"

	key[]: "aca_msg_book1_3_04_check5"
	val[]: "<font face=/font/big_bold.font>Наставите вожњу кроз уски сектор. </font>"

	key[]: "aca_msg_book1_3_04_check6"
	val[]: "Пред вама је неколико лаких скретања од 90°.<br><br><font face=/font/big_bold.font>Направи скретање. </font>"

	key[]: "aca_msg_book1_3_04_check7"
	val[]: "Приближавате се још једној укосници. Пратите своју приколицу у ретровизор док се приближавате. <br><br><font face=/font/big_bold.font>Возите кроз укосницу. </font>"

	key[]: "aca_msg_book1_3_04_check8"
	val[]: "Скретање од 90° напред је много тесније него што изгледа. Користите свој простор мудро.<br><br><font face=/font/big_bold.font>Наставите вожњу. </font>"

	key[]: "aca_msg_book1_3_04_check9"
	val[]: "Коначна укосница је сложена, готово да нема резервног простора. <br><br><font face=/font/big_bold.font>Наставите са опрезом.</font>"

	key[]: "aca_msg_book1_3_04_check10"
	val[]: "Очекује вас још једно скретање од 90°.<br><br><font face=/font/big_bold.font>Наставите вожњу. </font>"

	key[]: "aca_msg_book1_3_04_check11"
	val[]: "Наставите до одређеног подручја."
