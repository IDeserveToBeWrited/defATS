#+ Book 3 Scenario urf
#@{

#### urf common
	key[]: "aca_scenario_book3_urf_title"
	val[]: "Ослонац за кутију"

	key[]: "aca_scenario_book3_urf_desc"
	val[]: "У овом сценарију, бићете смештени на празан паркинг да вежбате вожњу уназад са Б-дуплим приколицама."

#### urf goal

	key[]: "aca_goal_book3_urf_start"
	val[]: "Започните"

	key[]: "aca_goal_book3_urf_move"
	val[]: "Експериментисање"

	key[]: "aca_goal_book3_urf_stop"
	val[]: "Завршава се"

	key[]: "aca_goal_book3_urf_end"
	val[]: "Крај сценарија"

	#### urf msg - intro text

	key[]: "aca_msg_book3_urf_cutscene1"
	val[]: "Вожња уназад са Б-дуплим приколицама захтева много више пажње него са једном приколицом. Морате унапред планирати где желите да се постави задња приколица, а да притом задржите контролу на предњој приколици и кабини. <br><br>Замислите то као да управљате задњом приколицом помоћу водеће приколице. Дакле, где год да усмерите водећу приколицу, путања задњег дела ће се променити."

	key[]: "aca_msg_book3_urf_cutscene2"
	val[]: "In this case, we want to turn the rear trailer to the driver's side. <br><br>To do this, we steered the lead to the passenger's side."

	key[]: "aca_msg_book3_urf_cutscene3"
	val[]: "Овде већина људи прави своју прву грешку. Када задња приколица почне да се окреће, морате исправити тегљач са вођством..."

	key[]: "aca_msg_book3_urf_cutscene4"
	val[]: "...или ћеш завршити попречен овако."

	key[]: "aca_msg_book3_urf_cutscene5"
	val[]: "До савијања возила у комбинацији долази када угао између било која два возила у комбинацији постане око 90°. Када се то деси, нема спаса - морате кренути напред и покушати поново. <br><br> Као и код вожње једне приколице уназад, циљ би увек требало да буде да се сви точкови на приколицама окрећу. Када се један точак заустави и приколица се окреће у месту, готово је."

	key[]: "aca_msg_book3_urf_cutscene6"
	val[]: "Можете се повући напред до места где сте последњи пут били исправни, односно до положаја где можете наставити да радите уназад без поновног понављања исте грешке, или једноставно повући напред док не будете прави."

	key[]: "aca_msg_book3_urf_cutscene7"
	val[]: "Поново, када се задња приколица окреће, поставите тегљач испред водећег дела и пустите да се задња приколица сама окрене на тренутак."

	key[]: "aca_msg_book3_urf_cutscene8"
	val[]: "Сада када се задња приколица лепо окреће, време је да се испред ње покрене и водећа приколица. Можете подесити угао између водеће и задњег дела приколице да бисте контролисали скретање и учинили га оштријим или ширим."

	key[]: "aca_msg_book3_urf_cutscene9"
	val[]: "Последњи део маневра је исправљање свега. Преузмите вођство испред задњег дела."

	key[]: "aca_msg_book3_urf_cutscene10"
	val[]: "Добро је имати на уму време потребно за померање вођства, као и да ћете такође морати да доведете тегљач у ред."

	key[]: "aca_msg_book3_urf_cutscene11"
	val[]: "Слободно проведите овде колико год времена желите, експериментишите са различитим маневрима док не помислите да имате отприлике представу о томе како се рукује приколицама уназад."

#### urf Driving Instructions

	key[]: "aca_msg_book3_urf_start"
	val[]: "Припремите се за полазак."

	key[]: "aca_msg_book3_urf_move"
	val[]: "Користите овај паркинг да бисте стекли осећај за руковање приколицама уназад. <br><br>@@aca_goal_tip@@ Нови сте у праћењу приколица уопште? Размислите о игрању игре Основе вожње камиона."

	key[]: "aca_msg_book3_urf_stop"
	val[]: "Вежбајте колико год желите. <br><br>Када сте задовољни, можете зауставити и обезбедити камион како бисте окончали сценарио."

	key[]: "aca_msg_book3_urf_end"
	val[]: "Угасите мотор да бисте завршили сценарио."
#@}


#+ Book 3 Scenario sup
#@{

#### sup common
	key[]: "aca_scenario_book3_sup_title"
	val[]: "Паркирање у уском простору"

	key[]: "aca_scenario_book3_sup_desc"
	val[]: "У овом сценарију, задатак вам је да паркирате своју Б-дуплу комбинацију у уском простору."

#### sup goal

	key[]: "aca_goal_book3_sup_start"
	val[]: "Започните"

	key[]: "aca_goal_book3_sup_forward"
	val[]: "Крените"

	key[]: "aca_goal_book3_sup_check1"
	val[]: "Наставите вожњу"

	key[]: "aca_goal_book3_sup_stop"
	val[]: "Заустављање"

	key[]: "aca_goal_book3_sup_end"
	val[]: "Обезбедите возило"

#### sup msg - intro text

	key[]: "aca_msg_book3_sup_cutscene1"
	val[]: "Вожња са Б-дуплим приколицама може деловати застрашујуће, али нема много више од вожње са једном приколицом - само морате узети у обзир и путању задње приколице!"

	key[]: "aca_msg_book3_sup_cutscene2"
	val[]: "Испред вас је уско паркинг место. Нећете имати довољно простора да се потпуно исправите пре уласка, па ћете морати пажљиво размислити како ћете се увући са обе приколице."

	key[]: "aca_msg_book3_sup_cutscene3"
	val[]: "Одмах скрените ка супротној страни паркинг места и возите далеко даље од места где бисте обично скренули."

	key[]: "aca_msg_book3_sup_cutscene4"
	val[]: "Сада када је ваша задња приколица на правом путу, можете се упутити ка том месту; можда ћете морати поново да одете на другу страну како бисте помогли да довезете прву приколицу."

	key[]: "aca_msg_book3_sup_cutscene5"
	val[]: "Наставите до места, а обе приколице ће вас пратити и исправљати се док идете."

	key[]: "aca_msg_book3_sup_cutscene6"
	val[]: "Паркирајте на одређеном подручју и обезбедите камион."

