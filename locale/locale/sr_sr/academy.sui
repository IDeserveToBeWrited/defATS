	val[]: "Паркирање камиона"



#### 2_05 msg - intro text

	key[]: "aca_msg_book1_2_05_cutscene1"
	val[]: "У овом сценарију, извршићемо маневар уназад да бисмо се паркирали поред ивичњака."

	key[]: "aca_msg_book1_2_05_cutscene2"
	val[]: "Уназад према ивичњаку.<br>Морате бити свесни свог окружења када возите уназад, па користите своје ретровизоре."

	key[]: "aca_msg_book1_2_05_cutscene3"
	val[]: "Како се приближавате, можете почети да поравнавате камион са паркинг местом. Гледајте обе стране камиона док се крећете уназад."

	key[]: "aca_msg_book1_2_05_cutscene4"
	val[]: "Зауставите се на паркинг месту и осигурајте камион."

#### 2_05 Driving Instructions

	key[]: "aca_msg_book1_2_05_start"
	val[]: "Паркинг место је иза вас према сувозачевој страни. Користите своје ретровизоре да се крећете према месту.<br><br><font face=/font/big_bold.font>Припремите се за полазак. </font>"

	key[]: "aca_msg_book1_2_05_backward"
	val[]: "Не заборавите да користите ретровизоре да бисте проверили околину пре него што померите камион.<br><br><font face=/font/big_bold.font>Започните вожњу уназад према ивичњаку. </font>"

	key[]: "aca_msg_book1_2_05_stop"
	val[]: "Наставите да надгледате своје окружење док скрећете уназад на паркинг место.<br><br><font face=/font/big_bold.font>Зауставите се на означеном месту. </font>"
#!{
	key[]: "aca_msg_book1_2_05_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

