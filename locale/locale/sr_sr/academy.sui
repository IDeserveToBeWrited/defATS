#+ Book 1 Scenario 1_01
#@{

#### 1_01 common
	key[]: "aca_scenario_book1_1_01_title"
	val[]: "Пре вожње"

	key[]: "aca_scenario_book1_1_01_desc"
	val[]: "За ваш први сценарио, проћи ћемо кроз основе возачке кабине. Важно је да правилно подесите седиште, волан и бочне ретровизоре, јер је добра видљивост важна за управљање стресним или несигурним ситуацијама.<br><br>Прегледаћемо контроле за подешавање ових компоненти једну по једну."

#### 1_01 goal

	key[]: "aca_goal_book1_1_01_adjuster"
	val[]: "Подешавање седишта и ретровизоре"

	key[]: "aca_goal_book1_1_01_check_adj"
	val[]: "Провера ретровизора и видљивости"

#### 1_01 msg - intro text

	key[]: "aca_msg_book1_1_01_cutscene1"
	val[]: "Добродошли на своју прву лекцију!<br>Почнимо тако што ћемо научити како да припремимо камион да крене на пут."

	key[]: "aca_msg_book1_1_01_cutscene2"
	val[]: "Kључно је осигурати да ваша вожња буде безбедна, професионална и под контролом у сваком тренутку.<br>Правилно подешавање седишта, волана и ретровизора ће вам помоћи да то постигнете."

	key[]: "aca_msg_book1_1_01_cutscene3"
	val[]: "Са сваке стране камиона су нека возила.<br>Они ће вам помоћи да правилно подесите ретровизоре."

	key[]: "aca_msg_book1_1_01_cutscene4"
	val[]: "Одвојите време да све прилагодите својим жељама као ова подешавања<br>ће имати значајан утицај на вашу способност да контролишете камион."

#### 1_01 Driving Instructions

	key[]: "adj_tut_title_0"
	val[]: "Подешавање седишта и волана"

	key[]: "adj_tut_title_1"
	val[]: "Подешавање главних ретровизора"

	key[]: "adj_tut_title_2"
	val[]: "Подешавање конвексних ретровизора"

	key[]: "adj_tut_title_3_hood"
	val[]: "Подешавање ретровизора на хауби"

	key[]: "adj_tut_title_3"
	val[]: "Провера видљивости и коначно подешавање ретровизора"

	key[]: "adj_tut_open_adj_keyboard"
	val[]: "притисните @@imv_nrm_adjuster@@ или му приступите преко подешавања возила у менију за паузу"

	key[]: "adj_tut_open_adj_gamepad"
	val[]: "приступите му кроз подешавања возила у менију за паузу"

	key[]: "adj_tut_open_adj"
	val[]: "За приказ '@@adjust_link_t@@' током играња, $OPEN_ADJUSTER$."

	key[]: "adj_tut_open_seat"
	val[]: "Прво, подесимо возачево седиште и волан.<br><br><font face=/font/big_bold.font>Отвори '@@adj_seats@@' да се настави.</font>"

	key[]: "adj_tut_open_mirrors"
	val[]: "<font face=/font/big_bold.font>Отвори @@adj_mirrors@@ да конфигуришете поставке ретровизора.</font>"

	key[]: "adj_tut_open_adj_intro"
	val[]: "Kада први пут улазите у камион, важно је да прво подесите седиште, волан и ретровизоре по свом укусу.<br><br>Правилна позиција иза волана је кључна за правилну видљивост. Све команде морају бити на дохват руке, а возач мора да има јасан поглед испред себе, са стране и у ретровизоре.<br><br><font face=/font/big_bold.font>За приказ менија конфигурације, $OPEN_ADJUSTER$. </font>"

	key[]: "adj_tut_set_seat_and_back_adj"
	val[]: "@@adj_tut_set_seat_and_back_adj_img@@<br>Подесите седиште тако да имате јасан поглед на околину, као и на ретровизоре, и тако да можете да досегнете и све команде.<br><br>Подесите волан тако да буде у удобном положају и да вам не блокира поглед на инструменте.<br><br><font face=/font/big_bold.font>Kада сте задовољни својим подешавањима, притисните @@imv_nrm_back@@ да бисте се вратили у конфигурациони мени. </font>"

	key[]: "adj_tut_open_mirrors_intro"
	val[]: "@@adj_tut_open_mirrors_intro_img@@<br>Kамиони имају много великих мртвих углова, тако да су опремљени са више спољашњих ретровизора како би помогли возачу да види што је више могуће. <br><br>Правилно подешавање ових ретровизора омогућиће вам најбољу могућу видљивост околине.<br><br><font face=/font/big_bold.font>Отвори '@@adj_mirrors@@' да се настави.</font>"

	key[]: "adj_tut_set_mirrors_t1_1_adj"
	val[]: "@@adj_tut_set_mirrors_t1_1_adj_img@@<br>Главни ретровизори покривају простор дуж бочне стране камиона и приколице.<br><br>Да бисте подесили исправан положај главних ретровизора, за референцу користите аутомобиле са обе стране возила.<br><br><font face=/font/big_bold.font>Притисните @@imv_nrm_selectfcs@@ да се настави.</font>"

	key[]: "adj_tut_set_mirrors_t1_2_adj"
	val[]: "Главни ретровизори су ваше примарно средство да видите шта се дешава поред и иза вас. Требало би да имате добар поглед на аутомобил поред себе, али свакако држите део приколице у ретровизору како бисте прецизно проценили положај препрека око себе."

	key[]: "adj_tut_set_mirrors_t1_2_adj_big"
	val[]: "Када будете задовољни подешавањем, пребаците се на главни ретровизор са сувозачеве стране."

	key[]: "adj_tut_set_mirrors_t1_2_adj_moved"
	val[]: "Опет, требало би да имате добар поглед на ауто поред себе, а да део приколице буде видљив и у ретровизору."

	key[]: "adj_tut_set_mirrors_t1_2_adj_moved_big"
	val[]: "Када будете задовољни подешавањем ретровизора, пређите на конвексни ретровизор са возачеве стране."

	key[]: "adj_tut_set_mirrors_t1_3_adj"
	val[]: "@@adj_tut_set_mirrors_t1_3_adj_img@@<br>Kонвексни ретровизори пружају шире видно поље, омогућавајући вам да видите више онога што се дешава поред вас.<br><br><font face=/font/big_bold.font>Притисните @@imv_nrm_selectfcs@@ да се настави.</font>"

	key[]: "adj_tut_set_mirrors_t1_4_adj"
	val[]: "Идеално, требало би да видите и аутомобил и камион који су паркирани са стране, док је веома мали део вашег камиона још увек видљив."

	key[]: "adj_tut_set_mirrors_t1_4_adj_big"
	val[]: "Када будете задовољни подешавањем ретровизора, пређите на конвексни ретровизор са сувозачеве стране."

	key[]: "adj_tut_set_mirrors_t1_4_adj_moved"
	val[]: "Опет, требало би да видите и аутомобил и камион који су паркирани са стране, а да је још увек видљив мали део вашег камиона."

	key[]: "adj_tut_set_mirrors_t1_4_adj_moved_big"
	val[]: "Када будете задовољни подешавањем ретровизора, пређите на ретровизор хаубе."

	key[]: "adj_tut_set_mirrors_t1_5_adj"
	val[]: "@@adj_tut_set_mirrors_t1_5_adj_img@@<br>Ретровизори на хауби пружају поглед у мртве тачке са обе стране кабине тегљача, омогућавајући вам да видите мале аутомобиле и препреке које би иначе могле бити сакривене због великих димензија камиона.<br><br><font face=/font/big_bold.font>Притисните @@imv_nrm_selectfcs@@ да наставите.</font>"

	key[]: "adj_tut_set_mirrors_t1_6_adj"
	val[]: "@@adj_tut_set_mirrors_t1_6_adj_img@@<br>Пошто имате друге ретровизоре која пружају поглед иза себе, ови ретровизори су дизајнирана само да виде оно што је поред вас. Хауба и кракови бочних ретровизора пружају добар референтни оквир о томе колико вашег камиона још увек треба да буде видљиво. Подесите ретровизоре на исправан положај као што је приказано на дијаграму.<br><br><font face=/font/big_bold.font>Када будете задовољни подешавањем, пребаците се на ретровизор хаубе са сувозачеве стране. </font>"

	key[]: "adj_tut_set_mirrors_t1_6_adj_moved"
	val[]: "@@adj_tut_set_mirrors_t1_6_adj_moved_img@@<br>На исти начин подесите положај овог ретровизора.<br><br><font face=/font/big_bold.font>Када сте задовољни подешавањем ретровизора, притисните @@imv_nrm_back@@ да затворите подешавања ретровизора. </font>"

	key[]: "adj_tut_back_adj"
	val[]: "<font face=/font/big_bold.font>Притисните @@imv_nrm_back@@ да бисте се вратили у конфигурациони мени. </font>"

	key[]: "adj_tut_close_adj"
	val[]: "Одлично, са вашим седиштем и ретровизорима постављеним по вашој жељи, сада сте корак ближе путу!<br><br><font face=/font/big_bold.font>Затворите мени за конфигурацију користећи @@imv_nrm_back@@. </font>"

	key[]: "adj_tut_open_con"
	val[]: "Још једном погледајте око себе да бисте били сигурни да сте задовољни погледом из кабине и да вам ретровизори пружају добар поглед на оно што се дешава око камиона.<br><br>Ако вам нешто не одговара, можете поново да подесите ретровизоре '@@adjust_link_t@@' конфигурациони мени. <br><br><font face=/font/big_bold.font>Притисните @@imv_nrm_activate@@ да се заврши први сценарио.</font> @@aca_goal_tip@@ Да бисте приказали или сакрили ретровизоре на екрану, можете да одете на '@@adjust_link_t@@' — '@@adj_ui_mirrors@@' у менију за паузу. Ретровизори на екрану олакшавају преглед са стране вашег сувозача."
#@}

