#+ Book 1 Scenario 1_02
#@{

#### 1_02 common

	key[]: "aca_scenario_book1_1_02_title"
	val[]: "Контроле камере"

	key[]: "aca_scenario_book1_1_02_desc"
	val[]: "У овом сценарију ћемо научити о различитим врстама камера које су вам доступне и како вам оне могу помоћи да контролишете и маневрирате камионом."

#### 1_02 goal

	key[]: "aca_goal_book1_1_02_seat"
	val[]: "Положај седења"

	key[]: "aca_goal_book1_1_02_look_back"
	val[]: "Поглед на позадину"

	key[]: "aca_goal_book1_1_02_mirrors"
	val[]: "Провера ретровизора"

	key[]: "aca_goal_book1_1_02_cam_behind"
	val[]: "Пребаците се на спољну камеру"

	key[]: "aca_goal_book1_1_02_look_around"
	val[]: "Погледајте око камиона"


#### 1_02 msg - intro text

	key[]: "aca_msg_book1_1_02_cutscene1"
	val[]: "У овом сценарију, проћи ћемо кроз различите камере<br>које су доступне за употребу."

	key[]: "aca_msg_book1_1_02_cutscene2"
	val[]: "Укупно имате седам камера које можете изабрати, проћи ћемо кроз њих<br> неколико њих сада и објасни њихове предвиђене функције."

	key[]: "aca_msg_book1_1_02_cutscene3"
	val[]: "Различите камере и њихови различити углови могу вам помоћи приликом маневрисања на уским местима."


#### 1_02 Driving Instructions

	key[]: "aca_msg_book1_1_02_seat"
	val[]: "Гледање куда идете је основна основа безбедне и професионалне вожње. Ако вам тренутни положај седења не одговара, можете га променити '@@adjust_link_t@@' (Приступите му преко менија за паузу).<br><br><font face=/font/big_bold.font>Потврдите када сте спремни са @@imv_nrm_activate@@. </font>"

	key[]: "aca_msg_book1_1_02_look_back"
	val[]: "Када возите уназад, ретровизори не нуде увек јасан поглед. Можда ће бити потребно да погледате кроз прозор иза себе да бисте имали бољи поглед.<br><br><font face=/font/big_bold.font>Окрените камеру скроз до возачеве стране да бисте погледали кроз прозор према задњем делу приколице.</font>@@aca_goal_tip@@ Морате бити у возилу."

	key[]: "aca_msg_book1_1_02_mirrors"
	val[]: "Користите овај приказ да проверите приколицу током маневара уназад са приколицом. Увек је боље да се окренете уназад на страну возача да бисте могли да искористите овај поглед. Када се крећете уназад на сувозачеву страну, имате много ограниченији поглед на оно што се дешава иза вас.<br><br><font face=/font/big_bold.font>Погледајте према сувозачевој страни. </font>"

	key[]: "aca_msg_book1_1_02_cam_behind"
	val[]: "Због тога се обично не препоручује кретање уназад према сувозачевој страни; можете видети да је видљивост прилично ограничена. Срећом, на располагању вам је и седам спољашњих камера. <br><br>Dugme @@imv_nrm_camcycle@@ може се користити за прелазак на следећу камеру у низу. Након што прођете кроз свих седам камера, вратићете се на почетак циклуса. <br><br><font face=/font/big_bold.font>Притисните @@imv_nrm_camcycle@@ да бисте прешли на следећу камеру. </font>"

	key[]: "aca_msg_book1_1_02_look_around"
	val[]: "Екстерна камера пружа најбољу перспективу о томе шта се дешава око камиона.<br><br><font face=/font/big_bold.font>Погледај око камиона.</font>"

	key[]: "aca_msg_book1_1_02_cam_top"
	val[]: "<font face=/font/big_bold.font>Притискање @@imv_nrm_camcycle@@ поново можете да пређете на следећу камеру. </font>"

	key[]: "aca_msg_book1_1_02_cam_cabin"
	val[]: "Поглед одозго надоле пружа одличан преглед ситуације око камиона, значајно поједностављујући паркирање и вожњу у скученим просторима.<br><br><font face=/font/big_bold.font>Притисните @@imv_nrm_camcycle@@ да бисте прешли на следећу камеру.  </font>"

	key[]: "aca_msg_book1_1_02_cam_window"
	val[]: "Кровна камера пружа јасан поглед на пут далеко испред камиона без већих препрека.<br><br><font face=/font/big_bold.font>Притисните @@imv_nrm_camcycle@@ да пређемо на последњу камеру коју ћемо за сада погледати.</font>"

	key[]: "aca_msg_book1_1_02_cam_interior"
	val[]: "Поглед позади је пречица за поглед који сте раније добили окретањем унутрашње камере. Као што смо дискутовали, то је од помоћи када се вози уназад или паркира.<br><br>У игри имамо више камера које можете испробати узастопним притиском @@imv_nrm_camcycle@@.<br><br><font face=/font/big_bold.font>Притисните @@imv_nrm_cam1@@ да се врати у унутрашњост.</font>"

	key[]: "aca_msg_book1_1_02_end"
	val[]: "За аутентично искуство у аутошколи, препоручујемо да останете са погледом „Унутрашња камера“ док пролазите кроз сваки од сценарија.<br><br><font face=/font/big_bold.font>Притисните @@imv_nrm_activate@@ за потврду и завршетак сценарија.</font>@@aca_goal_tip@@ Можете користити @@o_im_cam_zoom@@ функције за бољи поглед на околину. Посебно је корисно када гледате путем ретровизора. Проверите екран са опцијама - „Tasteri и дугмад“ - да видите и/или промените одговарајуће контроле."

#@}

#+ Book 1 Scenario 1_03
#@{

#### 1_03 common
	key[]: "aca_scenario_book1_1_03_title"
	val[]: "Прва вожња"

	key[]: "aca_scenario_book1_1_03_desc"
	val[]: "У овом сценарију, научићемо како да припремимо камион за вожњу, а затим да га возимо напред по први пут."

#### 1_03 goal

	key[]: "aca_goal_book1_1_03_electrics"
	val[]: "Укључивање паљења"

	key[]: "aca_goal_book1_1_03_start"
	val[]: "Стартовање мотора"

	key[]: "aca_goal_book1_1_03_look_mirror"
	val[]: "Провера околине"

	key[]: "aca_goal_book1_1_03_brake"
	val[]: "Примена радне кочнице"

	key[]: "aca_goal_book1_1_03_gear"
	val[]: "Пребацивање у брзину"

	key[]: "aca_goal_book1_1_03_park_br_off"
	val[]: "Отпуштање паркирне кочнице"

	key[]: "aca_goal_book1_1_03_forward"
	val[]: "Вожња напред"

	key[]: "aca_goal_book1_1_03_stop"
	val[]: "Заустављање"

	key[]: "aca_goal_book1_1_03_park_br_on"
	val[]: "Примените паркирну кочницу"

	key[]: "aca_goal_book1_1_03_gear_n"
	val[]: "Пребацивање у лер"

	key[]: "aca_goal_book1_1_03_end"
	val[]: "Гашење мотора"

#### 1_03 msg - intro text

	key[]: "aca_msg_book1_1_03_cutscene1"
	val[]: "За ваших првих неколико вожњи користићемо само тегљач.<br>Kамион се назива тегљач када нема сопствену каросерију, већ се ослања на употребу приколице за превоз робе и материјала."

	key[]: "aca_msg_book1_1_03_cutscene2"
	val[]: "Тегљачи су уобичајени јер омогућавају већу свестраност: могу да испусте празну приколицу и покупе натоварену без чекања, или чак да се у потпуности пребаце на другу врсту приколице."

	key[]: "aca_msg_book1_1_03_cutscene3"
	val[]: "За вашу прву вожњу, ваш задатак ће бити да возите напред и зауставите се након испрекидане линије.<br>Покрените мотор, пратите упутства да камион буде спреман за покрет. Када се припремите, возите право."

	key[]: "aca_msg_book1_1_03_cutscene4"
	val[]: "Возите поред испрекидане линије, зауставите се, угасите мотор и осигурајте камион."

#### 1_03 Driving Instructions

	key[]: "aca_msg_book1_1_03_electrics"
	val[]: "За следећи корак у вашој обуци, први пут ћете померити камион.<br><br>Наравно, без рада мотора неће радити, тако да прво морате укључити паљење.<br><br><font face=/font/big_bold.font>Притисните $input engineelect$ да укључите паљење.</font>@@aca_goal_tip@@ У каријери, подразумевано, мотор се аутоматски укључује заједно са струјом. За каријеру, ово понашање можете да прилагодите на екрану са опцијама - „Играње“ - @@auto_engine_start@@."

	key[]: "aca_msg_book1_1_03_start"
	val[]: "Паљење активира електронику камиона. Можда сте приметили да лампице упозорења трепере на инструмент табли - то је нормално. Ако остану укључени када се мотор покрене, то вероватно указује на проблем са камионом. Изузетак је лампица паркирне кочнице, која ће се угасити када отпустимо паркирне кочнице.<br><br>Срећом, овај камион је у добром стању и спремни смо да наставимо.<br><br><font face=/font/big_bold.font>Притисните @@imv_nrm_engine@@ за покретање мотора. </font>"

	key[]: "aca_msg_book1_1_03_look_mirror"
	val[]: "Сада када је мотор покренут, кључно је да проверите околину пре него што започнете било какав покрет.<br><br><font face=/font/big_bold.font>Погледајте око камиона и бочне ретровизоре возачева и сувозачева страна да бисте потврдили да је простор око камиона чист.</font>@@aca_goal_tip@@ Morate da budete u vozilu."

	key[]: "aca_msg_book1_1_03_brake"
	val[]: "Можда изгледа очигледно, али требало би да знате како да се зауставите пре него што започнете било какав покрет.<br><br><font face=/font/big_bold.font>Активирајте радну кочницу користећи $input backward$. </font>"

	key[]: "aca_msg_book1_1_03_gear_arcade"
	val[]: "Затим ћете научити како да промените смер путовања.<br><br>Са поједностављеним аутоматским мењачем, нема потребе за мењањем брзина, све се ради аутоматски уместо вас.<font face=/font/big_bold.font><br><br>Користи $input forward$ да бисте активирали брзину за кретање напред. </font>"

	key[]: "aca_msg_book1_1_03_gear_automatic"
	val[]: "Затим ћете научити како да промените смер путовања.<br><br>Реалистичан аутоматски мењач вам омогућава да мењате између вожње, неутралног и рикверц, баш као прави аутоматски мењачи.<br><br><font face=/font/big_bold.font>Притисните @@imv_nrm_gearup@@ да бисте активирали брзину за кретање напред. </font>"

	key[]: "aca_msg_book1_1_03_gear_manual"
	val[]: "Затим ћете научити како да промените смер путовања.<br><br>Секвенцијални мењач омогућава степенасто пребацивање, баш као и прави секвенцијални мењачи.<br><br>На исти начин као што укључујете брзину за напред, док убрзавате, мораћете да пребаците у вишу брзину.<br><br><font face=/font/big_bold.font>Притисните @@imv_nrm_gearup@@  да укључите прву брзину.</font>"

	key[]: "aca_msg_book1_1_03_gear_direct"
	val[]: "Затим ћете научити како да промените смер путовања.<br><br>Са ручицом мењача и квачилом доживећете исти осећај физичког мењања брзина као код правог мануелног мењача.<br><br>До краја притисните квачило и радну кочницу. <font face=/font/big_bold.font>Користите ручицу мењача да бисте убацили прву брзину. <color value=@@clr_txt@@>Држите квачило и радну кочницу притиснуте до краја.</font>"

	key[]: "aca_msg_book1_1_03_park_br_off"
	val[]: "Да бисте започели кретање, прво морате отпустити паркирну кочницу.<br><br><font face=/font/big_bold.font>Користи @@imv_nrm_parkingbrake@@ да отпусти паркирну кочницу.</font> @@aca_goal_tip@@ У каријери, паркирна кочница је иницијално онемогућена. Ово понашање можете подесити на екрану са опцијама - „Играње“ - @@auto_park_brake@@."

	key[]: "aca_msg_book1_1_03_forward_arcade"
	val[]: "Сада је камион спреман да крене напред. Започните кретање и пређите испрекидану линију.<br><br><font face=/font/big_bold.font>Започните кретање помоћу гаса: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_automatic"
	val[]: "Сада је камион спреман да крене напред. Започните кретање и пређите испрекидану линију.<br><br><font face=/font/big_bold.font>Започните кретање помоћу гаса: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_manual"
	val[]: "Сада је камион спреман да крене напред. Започните кретање и пређите испрекидану линију.<br><br><font face=/font/big_bold.font>Започните кретање помоћу гаса: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_direct"
	val[]: "Сада је камион спреман да крене напред. Започните кретање и пређите испрекидану линију.<br><br><font face=/font/big_bold.font>Отпустите радну кочницу, постепено отпуштајте квачило да бисте га покренули, док истовремено користите папучицу гаса да бисте одржали број обртаја на високом нивоу како камион не би стао. Када се квачило потпуно отпусти, можете убрзати и мењати по потреби. </font>"

	key[]: "aca_msg_book1_1_03_stop_arcade"
	val[]: "Користите радну кочницу да се зауставите.<br><br><font face=/font/big_bold.font>Користи $input backward$ да заустави камион. </font>"

	key[]: "aca_msg_book1_1_03_stop_automatic"
	val[]: "Користите радну кочницу да се зауставите.<br><br><font face=/font/big_bold.font>Користи $input backward$ да заустави камион. </font>"

	key[]: "aca_msg_book1_1_03_stop_manual"
	val[]: "Користите радну кочницу да се зауставите.<br><br><font face=/font/big_bold.font>Користи $input backward$ да заустави камион. </font>"

	key[]: "aca_msg_book1_1_03_stop_direct"
	val[]: "Када дође време да се заустави, притисните квачило до краја <font face=/font/big_bold.font>а затим зауставити камион помоћу радне кочнице.<color value=@@clr_txt@@> Пребаците у неутрални положај користећи ручицу мењача, а затим можете отпустити квачило. </font>"

	key[]: "aca_msg_book1_1_03_park_br_on"
	val[]: "Сада, осигурајте камион. Паркирна кочница обезбеђује да се камион неће ненамерно померити након што сте паркирали.<br><br><font face=/font/big_bold.font>Користи @@imv_nrm_parkingbrake@@ да бисте активирали паркирну кочницу.</font>"

	key[]: "aca_msg_book1_1_03_gear_n_arcade"
	val[]: "Са поједностављеним аутоматским мењачем, нема потребе да мењате брзине, све се ради аутоматски за вас.<br><br><font face=/font/big_bold.font>Притисните @@imv_nrm_activate@@ да потврди. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>Пребаците у неутралан положај притиском @@imv_nrm_geardown@@. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>Пребаците у неутралан положај притиском @@imv_nrm_geardown@@. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>Пребаците ручицу мењача у неутрални положај, затим отпустите квачило. </font>"

	key[]: "aca_msg_book1_1_03_end"
	val[]: "Сада знате како да покренете камион и како да га безбедно зауставите.<br><br><font face=/font/big_bold.font>Притисните $input engineelect$ да угаси мотор. </font>"
#@}

