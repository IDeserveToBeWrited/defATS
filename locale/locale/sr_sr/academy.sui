#### 2_06 msg - intro text

	key[]: "aca_msg_book1_2_06_cutscene01"
	val[]: "За коначни сценарио овог поглавља, возићемо се на пробној стази са сложеном конфигурацијом."

	key[]: "aca_msg_book1_2_06_cutscene02"
	val[]: "Прва препрека је слалом кроз неке баријере. Возите се кроз њих и не заборавите да користите своје ретровизоре."

	key[]: "aca_msg_book1_2_06_cutscene04"
	val[]: "Следеће је окретање укоснице. Држите скретање широким и не би требало да вам представља проблеме."

	key[]: "aca_msg_book1_2_06_cutscene05"
	val[]: "Пут испред се значајно сужава. Наставите опрезно и користите бочни ретровизор да вам помогне."

	key[]: "aca_msg_book1_2_06_cutscene06"
	val[]: "Следи низ лаких скретања од 90°."

	key[]: "aca_msg_book1_2_06_cutscene08"
	val[]: "Следећи одељак мора да се уради обрнуто. Имајући то на уму, приступите баријерама испред вас."

	key[]: "aca_msg_book1_2_06_cutscene09"
	val[]: "Пратите ознаке пута назад и око кривина."

	key[]: "aca_msg_book1_2_06_cutscene10"
	val[]: "Вратите се уназад до баријера, затим се зауставите и наставите напред удесно."

	key[]: "aca_msg_book1_2_06_cutscene11"
	val[]: "Овај пролаз кроз чуњеве је веома узак. Возите полако и користите ретровизоре да бисте се оријентисали у пролазу."

	key[]: "aca_msg_book1_2_06_cutscene13"
	val[]: "Напред је низ наизменичних скретања лево и десно за 90°."

	key[]: "aca_msg_book1_2_06_cutscene15"
	val[]: "Можете наићи на возове на овом пружном прелазу. Ако јесте, зауставите се и сачекајте. Након тога можете скренути десно на сервисни пут."

	key[]: "aca_msg_book1_2_06_cutscene16"
	val[]: "Скрените лево на коловоз. Можете повећати брзину након што завршите скретање."

	key[]: "aca_msg_book1_2_06_cutscene18"
	val[]: "Још неколико лева скретања улево у граду и бићете на свом одредишту!"

	key[]: "aca_msg_book1_2_06_cutscene19"
	val[]: "Приближите се препрекама испред и припремите се да паркирате на паркинг месту са десне стране."

	key[]: "aca_msg_book1_2_06_cutscene20"
	val[]: "Возите уназад до паркинг места, затим угасите мотор и обезбедите камион."

#### 2_06 Driving Instructions



	key[]: "aca_msg_book1_2_06_forward"
	val[]: "Пред вама је слалом направљен од баријера.<br><br><font face=/font/big_bold.font>Возите кроз слалом.</font>"

	key[]: "aca_msg_book1_2_06_forward2"
	val[]: "<font face=/font/big_bold.font>Пратите путању око скретања за укосницу. </font>"

	key[]: "aca_msg_book1_2_06_check1"
	val[]: "Пут испред се значајно сужава. Можете користити бочни ретровизор да бисте се лакше оријентисали.<br><br><font face=/font/big_bold.font>Наставите опрезно. </font>"

	key[]: "aca_msg_book1_2_06_check2"
	val[]: "После кривине је скретање од 90°.<br><br><font face=/font/big_bold.font>Подесите своју брзину у складу са тим.</font>"

	key[]: "aca_msg_book1_2_06_check3"
	val[]: "Пред вама је још неколико лаких скретања, наставите да прилагођавате брзину по потреби.<br><br><font face=/font/big_bold.font>Наставите вожњу. </font>"

	key[]: "aca_msg_book1_2_06_check4"
	val[]: "Следећа област се мора попунити обрнуто. Зауставите се на баријерама испред вас да бисте после тога могли да скренете удесно.<br><br><font face=/font/big_bold.font>Зауставите се код баријера.</font>"

	key[]: "aca_msg_book1_2_06_check5"
	val[]: "Окрените се уназад према подручју иза вас и удесно.<br><br><font face=/font/big_bold.font>Почните да возите уназад. </font>"

	key[]: "aca_msg_book1_2_06_reverse"
	val[]: "Пратите пут око скретања.<br><br><font face=/font/big_bold.font>Задржите вожњу уназад.</font>"

	key[]: "aca_msg_book1_2_06_check6"
	val[]: "Иза вас лево су неке баријере. <br><br><font face=/font/big_bold.font>Окрените се према баријерама и будите спремни да се зауставите.</font>"

	key[]: "aca_msg_book1_2_06_check7"
	val[]: "Зауставите се и промените брзину за напред, а затим наставите десно. <br><br><font face=/font/big_bold.font>Возите напред. </font>"

	key[]: "aca_msg_book1_2_06_check8"
	val[]: "Пред вама је уска вијугава стаза кроз неке чуњеве. Возите пажљиво и користите своје ретровизоре ако је потребно.<br><br><font face=/font/big_bold.font>Возите кроз чуњеве. </font>"

	key[]: "aca_msg_book1_2_06_check9"
	val[]: "Следе комбинације различитих скретања од 90°. Обавезно приступите сваком скретању са широким лежајем.<br><br><font face=/font/big_bold.font>Наставите вожњу. </font>"

	key[]: "aca_msg_book1_2_06_check10"
	val[]: "Посматрајте пружни прелаз док му прилазите. Сигнали се могу активирати како би указали на надолазећи воз.<br><br><font face=/font/big_bold.font>Поступите опрезно.</font>"

	key[]: "aca_msg_book1_2_06_check11"
	val[]: "Скретање на сервисни пут је делимично блокиран препреком, па се држите леве стране док прилазите да бисте себи дали више простора.<br><br><font face=/font/big_bold.font>Направи скретање. </font>"

	key[]: "aca_msg_book1_2_06_check12"
	val[]: "Можете изабрати да послушате или игноришете знак стоп. Подручје је затворено за нашу употребу.<br><br><font face=/font/big_bold.font>Скрените лево.</font>"

	key[]: "aca_msg_book1_2_06_check13"
	val[]: "Овде можете да убрзате, али ћете морати да скренете на следећој раскрсници.<br><br><font face=/font/big_bold.font>Наставите дуж курса. </font>"

	key[]: "aca_msg_book1_2_06_check14"
	val[]: "Наставите у град са скретањем лево, након чега следе још два скретања улево до коначног подручја.<br><br><font face=/font/big_bold.font>Возите кроз град.</font>"

	key[]: "aca_msg_book1_2_06_check15"
	val[]: "На супротној страни парцеле су неке баријере. Возите до њих. <br><br><font face=/font/big_bold.font>Зауставите се близу баријера. </font>"

	key[]: "aca_msg_book1_2_06_check16"
	val[]: "Иза вас и са десне стране налази се паркинг место.<br><br><font face=/font/big_bold.font>Возите уназад на паркинг место. </font>"
#!{
	key[]: "aca_msg_book1_2_06_check17"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_06_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_2_06_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

#@}

