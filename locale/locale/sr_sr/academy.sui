#### 3_12 msg - intro text

	key[]: "aca_msg_book1_3_12_cutscene01"
	val[]: "У овом сценарију, прећи ћемо на то како да се скрене у тесном простору.<br>Нећете увек имати пуно простора за маневрисање камионом и мораћете да се прилагодите не идеалним ситуацијама."

	key[]: "aca_msg_book1_3_12_cutscene02"
	val[]: "Возите се кроз уличицу према отвореном простору."

	key[]: "aca_msg_book1_3_12_cutscene03"
	val[]: "На левој страни је још једна уличица у коју морате скренути. Поставите се како год желите имајући ово на уму.<br>Можда ће бити од помоћи да покушате да приколица буде усмерена ка уличици пре него што кренете уназад."

	key[]: "aca_msg_book1_3_12_cutscene04"
	val[]: "Возите назад према уличици. Пазите да држите на оку све стране тегљача и приколице."

	key[]: "aca_msg_book1_3_12_cutscene05"
	val[]: "У уличици постоје препреке, па се држите према возачевој страни."

	key[]: "aca_msg_book1_3_12_cutscene06"
	val[]: "Када завршите са кретањем уназад, можете наставити напред и вратити се у правцу из којег сте дошли."

	key[]: "aca_msg_book1_3_12_cutscene07"
	val[]: "Можда ћете имати потешкоћа да видите своју приколицу у сувозачевом ретровизору док излазите, па искористите сав расположиви простор у своју корист."

	key[]: "aca_msg_book1_3_12_cutscene08"
	val[]: "Наставите да возите према излазу."

	key[]: "aca_msg_book1_3_12_cutscene09"
	val[]: "Паркирајте на одређеном подручју и осигурајте камион."
#!{
	key[]: "aca_msg_book1_3_12_cutscene10"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_12_cutscene11"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_12_cutscene12"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_12_cutscene13"
	val[]: "Unused"
#!}
#### 3_12 Driving Instructions

	key[]: "aca_msg_book1_3_12_start"
	val[]: "Пред вама је област која представља парцелу бродарске компаније. Ваш задатак је да уђете и окренете камион да се врати. Обавезно добро искористите простор око себе.<br><br><font face=/font/big_bold.font>Припремите се за полазак </font>"

	key[]: "aca_msg_book1_3_12_forward"
	val[]: "<font face=/font/big_bold.font>Наставите кроз уличицу. </font>"

	key[]: "aca_msg_book1_3_12_check1"
	val[]: "Одмах поред зграде са леве стране, налази се још једна уличица у коју морате скренути. Поставите себи ово на уму.<br><br><font face=/font/big_bold.font>Наставите према баријерама. </font>"



	key[]: "aca_msg_book1_3_12_check3"
	val[]: "Возите уназад и скрените приколицу према уличици, пазећи да тегљачем не ударите ништа са десне стране.<br><br><font face=/font/big_bold.font>Започните вожњу уназад и скрените приколицу у уличицу. Зауставите се у означеном подручју. </font>"

	key[]: "aca_msg_book1_3_12_check4"
	val[]: "Сада можете да наставите из области у истом правцу из којег сте дошли. Добро искористите простор који вам је на располагању.<br><br><font face=/font/big_bold.font>Возите напред и скрените десно. </font>"


	key[]: "aca_msg_book1_3_12_check6"
	val[]: "Наставите низ уличицу према означеном подручју."
#!{
	key[]: "aca_msg_book1_3_12_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_12_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_12_check5"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_12_check2"
	val[]: "Unused"
#!}

