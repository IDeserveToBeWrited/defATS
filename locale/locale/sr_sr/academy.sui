#### 3_19 msg - intro text

	key[]: "aca_msg_book1_3_19_cutscene01"
	val[]: "Добродошли на први део завршног испита. Ево, видећемо колико сте добро научили да возите камион након проведеног на Академији."

	key[]: "aca_msg_book1_3_19_cutscene02"
	val[]: "Прво ћете прикачити приколицу. Када се повежете, возићете камион по целој тестној рути."

	key[]: "aca_msg_book1_3_19_cutscene03"
	val[]: "Први део теста води вас на споредне путеве који ће вас одвести према центру града."

	key[]: "aca_msg_book1_3_19_cutscene04"
	val[]: "Тестна рута укључује различите врсте углова и препрека."

	key[]: "aca_msg_book1_3_19_cutscene05"
	val[]: "Мали део руте пролази кроз центар града."

	key[]: "aca_msg_book1_3_19_cutscene06"
	val[]: "Тестираћемо вашу способност маневрисања камионом кроз различите препреке и курсеве."

	key[]: "aca_msg_book1_3_19_cutscene07"
	val[]: "Сусрећете се са разним ситуацијама које ће тестирати вашу пажњу на околину."

	key[]: "aca_msg_book1_3_19_cutscene08"
	val[]: "Ви имате вожњу уназад кроз индустријски објекат."

	key[]: "aca_msg_book1_3_19_cutscene09"
	val[]: "Након вожње путевима, кроз центар града и у индустријском објекту, упутићете се ка @@driving_academy@@ штабу."

	key[]: "aca_msg_book1_3_19_cutscene10"
	val[]: "Кратка вожња путем и скоро сте готови."

	key[]: "aca_msg_book1_3_19_cutscene11"
	val[]: "Да бисте завршили тест, мораћете прецизно да паркирате. Можете одабрати који маневар најбоље одговара за вас."

	key[]: "aca_msg_book1_3_19_cutscene12"
	val[]: "Нема потребе да будете нервозни, већ сте научили све што ће бити потребно за полагање.<br><br>Срећно!"

#### 3_19 Driving Instructions



	key[]: "aca_msg_book1_3_19_forward"
	val[]: "Прво ћете морати да пронађете и закачитете приколицу. Паркиран је напред са десне стране.<br><br><font face=/font/big_bold.font>Возите према приколици.</font>"

	key[]: "aca_msg_book1_3_19_coupling"
	val[]: "Скрените лево, затим возите уназад према приколици и поравнајте се са њом.<br><br><font face=/font/big_bold.font>Возите назад према приколици. </font>"

	key[]: "aca_msg_book1_3_19_park_br_on"
	val[]: "<font face=/font/big_bold.font>Обезбедите камион. </font>"

	key[]: "aca_msg_book1_3_19_connect"
	val[]: "<font face=/font/big_bold.font>Притисните @@imv_nrm_attach@@ да повежете приколицу. </font>"

	key[]: "aca_msg_book1_3_19_park_br_off"
	val[]: "Приколица је повезана, а камион је спреман за вожњу.<br><br><font face=/font/big_bold.font>Отпустите паркирну кочницу. </font>"

	key[]: "aca_msg_book1_3_19_b_trailer"
	val[]: "Пут је затворен ради нашег тестирања. Можете изабрати да поштујете или игноришете саобраћајне знакове како вам одговара.<br><br><font face=/font/big_bold.font>Возите према путу. </font>"

	key[]: "aca_msg_book1_3_19_check01"
	val[]: "Прођите кроз првих неколико скретања. <br><br><font face=/font/big_bold.font>Наставите вожњу. </font>"

	key[]: "aca_msg_book1_3_19_check02"
	val[]: "После следећег скретања следи слалом од саобраћајних чуњева.<br><br><font face=/font/big_bold.font>Пажљиво се крећите између саобраћајних чуњева. </font>"

	#key[]: "aca_msg_book1_3_19_check02a"
	#val[]: "Continue through the roundabout into the town.<br><br><font face=/font/big_bold.font>Negotiate the roundabout.</font>"

	key[]: "aca_msg_book1_3_19_check02b"
	val[]: "Очекује вас још неколико скретања од 90°. <br><br><font face=/font/big_bold.font>Наставите вожњу. </font>"

	key[]: "aca_msg_book1_3_19_check03"
	val[]: "Следеће скретање је изузетно тесно и захтеваће цео пут да бисте га успешно обавили.<br><br><font face=/font/big_bold.font>Скрените десно и возите кроз уличицу.</font>"

	key[]: "aca_msg_book1_3_19_check04"
	val[]: "Скрените лево из уличице, а затим скрените десно на главни пут.<br><br><font face=/font/big_bold.font>Наставите вожњу. </font>"

	key[]: "aca_msg_book1_3_19_check05"
	val[]: "Можете се мало опустити док се возите главним путем. <br><br><font face=/font/big_bold.font>Возите право. </font>"

	key[]: "aca_msg_book1_3_19_check06"
	val[]: "Постоје оштра скретања на и ван сервисног пута.<br><br><font face=/font/big_bold.font>Пажљиво возите кроз скретања. </font>"

	key[]: "aca_msg_book1_3_19_check07"
	val[]: "Улазите у сложенији слалом. Наставите полако и користите своје ретровизоре. <br><br><font face=/font/big_bold.font>Наставите са вожњом и пажљиво се крећите у слалому.</font>"

	key[]: "aca_msg_book1_3_19_check08"
	val[]: "Скрените лево у индустријско подручје, пазите на расветни стуб.<br><br><font face=/font/big_bold.font>Направи лево скретање. </font>"

	key[]: "aca_msg_book1_3_19_check09"
	val[]: "Припремите се за вожњу уназад.<br><br><font face=/font/big_bold.font>Скрените десно и зауставите се у одсечену област. </font>"

	key[]: "aca_msg_book1_3_19_check10"
	val[]: "Возите уназад и пратите курс лево иза вас.<br><br><font face=/font/big_bold.font>Започните вожњу уназад.</font>"

	key[]: "aca_msg_book1_3_19_check11"
	val[]: "Пратите курс лево. <br><br><font face=/font/big_bold.font>Наставите вожњу уназад. </font>"

	key[]: "aca_msg_book1_3_19_check12"
	val[]: "<font face=/font/big_bold.font>Возите напред и скрените десно. </font>"

	key[]: "aca_msg_book1_3_19_check13"
	val[]: "<font face=/font/big_bold.font>Наставите према капији. </font>"

	key[]: "aca_msg_book1_3_19_check14"
	val[]: "Сачекајте да се капија отвори, а затим се вратите на главни пут.<br><br><font face=/font/big_bold.font>Наставите вожњу. </font>"

	key[]: "aca_msg_book1_3_19_check15"
	val[]: "Пазите да не ударите у знак.<br><br><font face=/font/big_bold.font>Направите скретање и наставите вожњу. </font>"

	key[]: "aca_msg_book1_3_19_check16"
	val[]: "<font face=/font/big_bold.font>Скрените лево у Академију. </font>"

	key[]: "aca_msg_book1_3_19_check17"
	val[]: "<font face=/font/big_bold.font>Наставите право. </font>"

	key[]: "aca_msg_book1_3_19_check18"
	val[]: "Држите се споља, јер након кривине постоји нагло скретање.<br><br><font face=/font/big_bold.font>Пратите кривину.</font>"

	key[]: "aca_msg_book1_3_19_check19"
	val[]: "<font face=/font/big_bold.font>Скрените лево и припремите се за паркирање са леве стране.</font>"

	key[]: "aca_msg_book1_3_19_check20"
	val[]: "<font face=/font/big_bold.font>Возите уназад на паркинг место.</font>"
#!{
	key[]: "aca_msg_book1_3_19_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_19_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_19_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
 #!}


#@}


#+ Book 1 Scenario 3_20
#@{

#### 3_20 common
	key[]: "aca_scenario_book1_3_20_title"
	val[]: "Завршни испит (2. део)"

	key[]: "aca_scenario_book1_3_20_desc"
	val[]: "Очекује вас последњи део завршног испита, где ће се проценити вештине паркирања које сте научили у претходним сценаријима. Паркирајте пажљиво и прецизно и бићете спремни да кренете путевима Америке као вешт камионџија!"

#### 3_20 goal
#!{
	key[]: "aca_goal_book1_3_20_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_20_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_20_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_20_forward"
	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}


	key[]: "aca_goal_book1_3_20_park1"
	val[]: "Офсет маневар"

	key[]: "aca_goal_book1_3_20_park2"
	val[]: "Дијагонално паркирање"

	key[]: "aca_goal_book1_3_20_park3"
	val[]: "Вожња кроз паркиралиште"

	key[]: "aca_goal_book1_3_20_park4"
	val[]: "Паралелно паркирање"

	key[]: "aca_goal_book1_3_20_park5"
	val[]: "Финално паркирање"


#### 3_20 msg - intro text

	key[]: "aca_msg_book1_3_20_cutscene01"
	val[]: "Добродошли у други део завршног испита. Прећи ћемо на оближњи паркинг и тестирати ваше вештине у вожњи уназад и маневрисању на паркинг местима."

	key[]: "aca_msg_book1_3_20_cutscene02"
	val[]: "Очекује вас неколико узастопних изазова за паркирање да бисте проценили своје способности."

	key[]: "aca_msg_book1_3_20_cutscene03"
	val[]: "Овде је простор ограничен, зато будите опрезни и одвојите време."

	key[]: "aca_msg_book1_3_20_cutscene04"
	val[]: "Добро искористите простор око себе и искористите све своје ретровизоре у своју пуну корист. Срећно!"




#### 3_20 outro text

	key[]: "aca_msg_book1_3_20_outro01"
	val[]: "Честитамо, успешно сте завршили испите за Основе вожње камиона и научили све вештине неопходне за правилно маневрисање камионом."

	key[]: "aca_msg_book1_3_20_outro02"
	val[]: "Ово је први корак на вашем путу ка остварењу вашег сна да постанете професионални возач камиона."

	key[]: "aca_msg_book1_3_20_outro03"
	val[]: "Сада сте спремни да кренете путевима Америке и суочите се са својим првим изазовима..."

	key[]: "aca_msg_book1_3_20_outro04"
	val[]: "...али авантура је тек почела."


#### 3_20 Driving Instructions

	key[]: "aca_msg_book1_3_20_start"
	val[]: "Не заборавите да будете опрезни и да не журите. У реду је ако не можете да га сместите из првог покушаја, важно је да не оштетите камион или оне око вас. <font face=/font/big_bold.font><br><br>Припремите се да кренете. </font>"

	key[]: "aca_msg_book1_3_20_forward"
	val[]: "<font face=/font/big_bold.font>Возите се напред до првог дела испита.</font>"

	key[]: "aca_msg_book1_3_20_park1"
	val[]: "Ваш први задатак је да демонстрирате маневар офсет паркинга. Место где треба да направите резервну копију са приколицом је на вашој левој страни.<br><br><font face=/font/big_bold.font>Извршите маневар за офсет паркирање.</font>"

	key[]: "aca_msg_book1_3_20_park2"
	val[]: "Следећи задатак је да се вратите у низ непомичних камиона. Пазите да не ударите друге камионе!<br><br><font face=/font/big_bold.font>Извршите дијагонални маневар паркирања.</font>"

	key[]: "aca_msg_book1_3_20_park3"
	val[]: "Наставите кроз паркинг. Пазите на неочекиване ситуације.<br><br><font face=/font/big_bold.font>Наставите вожњу.</font>"

	key[]: "aca_msg_book1_3_20_park4"
	val[]: "Хајде сада да покушамо паралелно паркирање између два камиона поред ивичњака испред вас.<br><br><font face=/font/big_bold.font>Извршите маневар паралелног паркирања.</font>"

	key[]: "aca_msg_book1_3_20_park5"
	val[]: "Један последњи маневар паркирања са ваше леве стране! Можете изабрати да приступите овоме како год желите.<br><br><font face=/font/big_bold.font>Возите уназад у назначено подручје.</font>"

	key[]: "aca_msg_book1_3_20_park6"
	val[]: "Скоро готово. Напустите простор за тестирање и паркирајте камион.<br><br><font face=/font/big_bold.font>Изађите из тестне области са ваше леве стране.</font>"

	key[]: "aca_msg_book1_3_20_stop"
	val[]: "Камион можете паркирати на десној страни са осталима.<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_20_end"
	val[]: "@@aca_msg_book1_2_01_end@@"


#!}

#@}


#+ Book 1 Scenario 3_22
#@{

#### 3_22 common
	key[]: "aca_scenario_book1_3_22_title"
	val[]: "Паралелно паркирање са приколицом"

	key[]: "aca_scenario_book1_3_22_desc"
	val[]: "У овом сценарију, погледаћемо паралелно паркирање са повезаном приколицом."

#### 3_22 goal


	key[]: "aca_goal_book1_3_22_stopmid"
	val[]: "Заустављање у означеном подручју"
#!{
	key[]: "aca_goal_book1_3_22_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_22_check1"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_22_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_22_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_22_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
  #!}
#### 3_22 msg - intro text

	key[]: "aca_msg_book1_3_22_cutscene1"
	val[]: "Паралелно паркирање са приколицом је релевантна вештина за све камионџије.<br>Било да се паркирате на улици у великом граду или да се зауставите на одморишту на селу, то је нешто што сваки камионџија треба да зна како да уради."

	key[]: "aca_msg_book1_3_22_cutscene2"
	val[]: "Док пролазите поред паркинг места, пажљиво погледајте да бисте били сигурни да има довољно простора за тегљач и приколицу да стану. Овде смо обезбедили да имате довољно простора."

	key[]: "aca_msg_book1_3_22_cutscene3"
	val[]: "Поравнајте се с камионом испред паркинг места. Немојте му бити превише близу, држите се на малом одстојању од њега да бисте имали простора за рад."

	key[]: "aca_msg_book1_3_22_cutscene4"
	val[]: "Скрените нагло са паркинг места и почните да возите уназад. Идеја је да се приколица одмах окрене на паркинг место."

	key[]: "aca_msg_book1_3_22_cutscene5"
	val[]: "Када приколица буде добро усмерена на место, можете почети да је пратите."

	key[]: "aca_msg_book1_3_22_cutscene6"
	val[]: "Почните да управљате приколицом даље од ивичњака пре него што точкови приколице на страни возача уђу на место."

	key[]: "aca_msg_book1_3_22_cutscene7"
	val[]: "Исправите тегљач са приколицом, а затим се центрирајте унутар паркинг места.<br><br>Паркирајте, угасите мотор и обезбедите камион."

#### 3_22 Driving Instructions

	key[]: "aca_msg_book1_3_22_start"
	val[]: "Видите паркинг испред вас, између осталих камиона. Док паркирате, обавезно проверите ретровизоре и држите безбедну удаљеност између камиона и препрека око вас.<br><br><font face=/font/big_bold.font>Припремите се да кренете. </font>"

	key[]: "aca_msg_book1_3_22_check1"
	val[]: "Крећите се кроз парцелу да пронађете своје паркинг место.<br><br><font face=/font/big_bold.font>Возите напред. </font>"

	key[]: "aca_msg_book1_3_22_stopmid"
	val[]: "<color value=@@clr_white@@>Прођите поред жељеног паркинг места до означеног подручја. Одавде можете започети свој маневар вожње уназад.<br><br><font face=/font/big_bold.font>Станите на означеном месту. </font>"

	key[]: "aca_msg_book1_3_22_backward"
	val[]: "Окрените тегљач даље од места да бисте почели да окрећете приколицу у њега. Немојте скретати превише оштро, иначе ћете кренути ка ивичњаку. <br><br><font face=/font/big_bold.font>Почните вожњу уназад. </font>"

	key[]: "aca_msg_book1_3_22_stop"
	val[]: "Поравнајте приколицу са местом. Ако је потребно, померите се напред или назад док вршите неопходне уносе управљача да бисте подесили свој положај.<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_22_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
 #!}

#@}

#+ Book 1 Scenario 3_21
#@{
#### 3_21 common
	key[]: "aca_scenario_book1_3_21_title"
	val[]: "Померање уназад подешавањем од 45°"

	key[]: "aca_scenario_book1_3_21_desc"
	val[]: "У овом сценарију ћемо истражити подешавања од 45° за вожњу уназад."

#### 3_21 goal
#!{
	key[]: "aca_goal_book1_3_21_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_21_forward"
	val[]: "@@aca_goal_book1_1_03_forward@@"

	key[]: "aca_goal_book1_3_21_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}
	key[]: "aca_goal_book1_3_21_check1"
	val[]: "Контролна тачка"

	key[]: "aca_goal_book1_3_21_check2"
	val[]: "Постизање правог растојања за вожњу уназад"

	key[]: "aca_goal_book1_3_21_stop"
	val[]: "Паркинг у предвиђеном простору"



#### 3_21 msg - intro text

	key[]: "aca_msg_book1_3_21_cutscene1"
	val[]: "У овој лекцији ћемо погледати паркирање под углом од 45°. Када ситуација дозвољава, многи преферирају ову методу за вожњу уназад на паркинг места. Ако почнете са приколицом која је већ усмерена где желите да идете, морате мање да маневрирате да бисте се паркирали."

	key[]: "aca_msg_book1_3_21_cutscene2"
	val[]: "Ова врста подешавања вам такође омогућава да видите даље у паркинг место, омогућавајући већу видљивост куда идете."

	key[]: "aca_msg_book1_3_21_cutscene3"
	val[]: "Возите поред паркинг места и поставите се под углом од отприлике 45°. Желите да ваша приколица буде усмерена ка камиону на супротној страни паркинг места на које намеравате да уђете уназад."

	key[]: "aca_msg_book1_3_21_cutscene4"
	val[]: "Скрените са камионом даље од места да бисте гурнули предњи део приколице около, водећи задњи део према месту за паркирање. Пазите да не претерујете. Једном када почнете да скрећете, лакше је направити заокрет оштријим него проширеним."

	key[]: "aca_msg_book1_3_21_cutscene5"
	val[]: "Док приколица улази у паркинг, ставите тегљач испред ње и поравнајте комбинацију."

	key[]: "aca_msg_book1_3_21_cutscene6"
	val[]: "Зауставите се на одређеном месту и обезбедите камион."

#### 3_21 Driving Instructions
#!{
	key[]: "aca_msg_book1_3_21_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

	key[]: "aca_msg_book1_3_21_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
	key[]: "aca_msg_book1_3_21_forward"
	val[]: "Са леве стране је паркинг простор. Возите поред њега и поставите га под углом од 45°.<br><br><font face=/font/big_bold.font>Возите напред. </font>"

	key[]: "aca_msg_book1_3_21_check1"
	val[]: "Поравнајте камион са ознакама.<br><br><font face=/font/big_bold.font>Зауставите се на обележеном подручју. </font>"

	key[]: "aca_msg_book1_3_21_check2"
	val[]: "Користећи знање које сте стекли из претходних сценарија, усмерите приколицу на паркинг место.<br><br><font face=/font/big_bold.font>Почните да возите уназад. </font>"

	key[]: "aca_msg_book1_3_21_stop"
	val[]: "Наставите да управљате приколицом на паркинг место.<br><br>@@aca_msg_book1_2_01_stop@@"


#@}

