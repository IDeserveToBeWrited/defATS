#+ Book 1 intro
#@{

	key[]: "aca_scenario_book1_intro_title"
	val[]: "Основе вожње камиона"

	key[]: "aca_msg_book1_intro_cutscene01"
	val[]: "Добродошли у @@driving_academy@@."

	key[]: "aca_msg_book1_intro_cutscene02"
	val[]: "Следећи сценарији представљају први корак на вашем путу ка професионалној вожњи камиона."

	key[]: "aca_msg_book1_intro_cutscene03"
	val[]: "Овде ћете научити све из основних система и контрола камиона..."

	key[]: "aca_msg_book1_intro_cutscene04"
	val[]: "...за сложене маневре са и без приколице."

	key[]: "aca_msg_book1_intro_cutscene05"
	val[]: "Помоћи ћемо вам да стекнете навике које ће вам помоћи да се безбедно крећете у разним ситуацијама,"

	key[]: "aca_msg_book1_intro_cutscene06"
	val[]: "и научи вас да мудро користите расположиви простор за ефикасно маневрисање вашим камионом."

	key[]: "aca_msg_book1_intro_cutscene07"
	val[]: "Завршавањем свих сценарија и полагањем завршних испита,"

	key[]: "aca_msg_book1_intro_cutscene08"
	val[]: "бићете спремни да кренете путевима Америке и нађете нове изазове са којима ћете се суочити."

#@}

