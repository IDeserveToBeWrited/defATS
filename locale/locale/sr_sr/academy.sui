	key[]: "aca_scenario_book1_2_09_title"
	val[]: "Паралелно паркирање"

	key[]: "aca_scenario_book1_2_09_desc"
	val[]: "У овом сценарију, погледаћемо паралелно паркирање између два друга камиона."

#### 2_09 goal

	key[]: "aca_goal_book1_2_09_stopmid"
	val[]: "Заустављање испред паркинг места"

	key[]: "aca_goal_book1_2_09_checkmirror"
	val[]: "Провера позади поглед на ретровизор"

	key[]: "aca_goal_book1_2_09_backward"
	val[]: "Вожњом уназад на паркинг место"

	key[]: "aca_goal_book1_2_09_stop"
	val[]: "Поравнавање камиона унутар паркинг места"

#!{
	key[]: "aca_goal_book1_2_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_09_check1"
	val[]: "@@aca_goal_book1_1_03_forward@@"


	key[]: "aca_goal_book1_2_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"



 #!}
#### 2_09 msg - intro text

	key[]: "aca_msg_book1_2_09_cutscene1"
	val[]: "Паралелно паркирање је кључна вештина коју треба да зна сваки камионџија.<br>Припремите се за полазак."

	key[]: "aca_msg_book1_2_09_cutscene2"
	val[]: "Возите ка паркинг месту.<br>Обратите пажњу на околину."

	key[]: "aca_msg_book1_2_09_cutscene3"
	val[]: "Поравнајте се с камионом испред вашег паркинг места. Немојте му бити превише близу, држите се на малом одстојању од њега да бисте имали простора за рад."

	key[]: "aca_msg_book1_2_09_cutscene4"
	val[]: "Окрените оштро према простору и почните да возите уназад."

	key[]: "aca_msg_book1_2_09_cutscene5"
	val[]: "Када гледате у ретровизор са стране возача, циљајте на ивичњак одмах испред камиона иза вас."

	key[]: "aca_msg_book1_2_09_cutscene6"
	val[]: "Када ваш предњи браник ослободи камион испред вас, можете почети да управљате предњим крајем камиона на место, поравнавајући камион са паркинг местом."

	key[]: "aca_msg_book1_2_09_cutscene7"
	val[]: "Исправите точак и центрирајте камион у оквиру паркинг места.<br>Паркирајте и обезбедите камион."

#### 2_09 Driving Instructions

	key[]: "aca_msg_book1_2_09_start"
	val[]: "Испред вас, су паркирани камиони. Остало вам је једно отворено место на коме можете да паркирате. <br><br><font face=/font/big_bold.font>Припремите се за полазак. </font>"

	key[]: "aca_msg_book1_2_09_check1"
	val[]: "Запамтите да будете свесни свог окружења. Искористите добро ретровизоре током овог маневра. <br><br><font face=/font/big_bold.font>Возите напред. </font>"

	key[]: "aca_msg_book1_2_09_stopmid"
	val[]: "<color value=@@clr_white@@>Возите поред паркинг места и уђите у обележено подручје. Одатле можете започети свој маневар вожњом уназад.<br><br><font face=/font/big_bold.font>Станите на означеном месту. </font>"

	key[]: "aca_msg_book1_2_09_checkmirror"
	val[]: "Проверите да ли се у вашем окружењу налазе препреке и да се уверите да сте слободни за вожњу уназад.<br><br><font face=/font/big_bold.font>Погледајте кроз сувозачев ретровизор. </font>"

	key[]: "aca_msg_book1_2_09_backward"
	val[]: "Окрените точкове и крените уназад до паркинг места.<br><br><font face=/font/big_bold.font>Почните да возите уназад. </font>"

	key[]: "aca_msg_book1_2_09_stop"
	val[]: "Почните да исправљате камион када је то потребно. Не возите преко ивичњака!<br><br><font face=/font/big_bold.font>Поравнајте камион са местом. </font>"
#!{
	key[]: "aca_msg_book1_2_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_01
