	val[]: "Улазак у кружни ток"

	key[]: "aca_goal_book1_3_11_check2"
	val[]: "Вожња у кружном току"

	key[]: "aca_goal_book1_3_11_check3"
	val[]: "Вожња у кружном току"

	key[]: "aca_goal_book1_3_11_check5"
	val[]: "Излазак из кружног тока"

	key[]: "aca_goal_book1_3_11_check6"
	val[]: "Вожња до означеног подручја"

#### 3_11 msg - intro text

	key[]: "aca_msg_book1_3_11_cutscene1"
	val[]: "Кружни токови су све чешћи у Америци, па је важно знати како преговарати о њима."

	key[]: "aca_msg_book1_3_11_cutscene3"
	val[]: "Држите се ван своје траке док се приближавате кружном току. Ово ће помоћи вашој приколици да очисти унутрашњост од почетног скретања."

	key[]: "aca_msg_book1_3_11_cutscene4"
	val[]: "Возите ка центру кружног тока док улазите. Када уђете, мораћете да се упутите према споља. Ово је да ваша приколица буде удаљена од центра кружног тока."

	key[]: "aca_msg_book1_3_11_cutscene5"
	val[]: "Задржите своје очи на ретровизоре како бисте били сигурни да се приколица не приближава унутрашњим препрекама."

	key[]: "aca_msg_book1_3_11_cutscene6"
	val[]: "Напуштање кружног тока је прилично лако јер је ваша приколица већ постављена даље од унутрашњег дела излаза. Широко заокрените на излазу и приколица треба да иде лепо."

	key[]: "aca_msg_book1_3_11_cutscene7"
	val[]: "Паркирајте на одређеном подручју и осигурајте камион."



#### 3_11 Driving Instructions
#!{
	key[]: "aca_msg_book1_3_11_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

	key[]: "aca_msg_book1_3_11_forward"
	val[]: "Испред вас је постављен кружни ток на којем можете да возите. <br><br><font face=/font/big_bold.font>Полако се приближавајте кружном току. </font>"

	key[]: "aca_msg_book1_3_11_check1"
	val[]: "Скрените широко када улазите у кружни ток тако да ће ваша приколица ући иза вас без проблема. <br><br><font face=/font/big_bold.font>Уђите у кружни ток. </font>"

	key[]: "aca_msg_book1_3_11_check2"
	val[]: "Возите према спољашњој страни кружног тока. Камион ћете морати да држите што даље од центра кружног тока како бисте држали приколицу даље од средишњих баријера. <br><br><font face=/font/big_bold.font>Наставите кроз кружни ток.</font>"

	key[]: "aca_msg_book1_3_11_check3"
	val[]: "Останите близу спољних чуњева. <br><br><font face=/font/big_bold.font>Задржите вожњу.</font>"

	key[]: "aca_msg_book1_3_11_check5"
	val[]: "<font face=/font/big_bold.font>Изађите из кружног тока.</font>"

	key[]: "aca_msg_book1_3_11_check6"
	val[]: "<font face=/font/big_bold.font>Наставите до паркинг места испред.</font>"

	key[]: "aca_msg_book1_3_11_stop"
	val[]: "<font face=/font/big_bold.font>Зауставите се на одређеном подручју. </font>"

	key[]: "aca_msg_book1_3_11_end"
	val[]: "<font face=/font/big_bold.font>Обезбедите камион и угасите мотор.</font>"
#@}

#+ Book 1 Scenario 3_12
#@{

#### 3_12 common
	key[]: "aca_scenario_book1_3_12_title"
	val[]: "Маневрисање у уском простору"

	key[]: "aca_scenario_book1_3_12_desc"
	val[]: "У овом сценарију, имаћете задатак да окренете камион у тесном простору, што ће захтевати пажњу на ваше окружење и паметно коришћење простора."

