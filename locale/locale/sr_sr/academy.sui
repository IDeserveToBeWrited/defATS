	key[]: "aca_goal_book1_3_16_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_16_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
 #!}
#### 3_16 msg - intro text

	key[]: "aca_msg_book1_3_16_cutscene1"
	val[]: "Дијагонално паркирање на први поглед изгледа лакше, али често може бити изазовније од типичних маневара за „паркирање у уличици“."

	key[]: "aca_msg_book1_3_16_cutscene2"
	val[]: "Возите уназад према паркинг месту. За сада држите тегљач и приколицу равно."

	key[]: "aca_msg_book1_3_16_cutscene3"
	val[]: "Док се приближавате, пустите приколицу да се приближи паркираним камионима. Ово ће вам помоћи скренете у место када стигнете до њега."

	key[]: "aca_msg_book1_3_16_cutscene4"
	val[]: "Почните да окрећете приколицу у паркинг месту. Држите приколицу близу камиона на страни возача, јер ће вам требати простор на другој страни."

	key[]: "aca_msg_book1_3_16_cutscene5"
	val[]: "Када је приколица добро на месту за паркирање, почните да окрећете тегљач како бисте пратили приколицу."

	key[]: "aca_msg_book1_3_16_cutscene6"
	val[]: "Паркирајте на за то предвиђеном месту, обезбедите камион и угасите мотор."

#### 3_16 Driving Instructions

	key[]: "aca_msg_book1_3_16_start"
	val[]: "Паркирајте камион у простор иза вас. Користите оба ваша ретровизора за навигацију у вашој вожњи уназад.<br><br><font face=/font/big_bold.font>Припремите се да кренете. </font>"

	key[]: "aca_msg_book1_3_16_backward"
	val[]: "Проверите своје окружење, а затим идите ка паркинг месту.<br><br><font face=/font/big_bold.font>Почните вожњу уназад.</font>"

	key[]: "aca_msg_book1_3_16_check1"
	val[]: "Почните да померате приколицу према камионима поред вас. Када будете спремни, окрените приколицу на паркинг место. Не заборавите да узмете у обзир замах репа приколице.<br><br><font face=/font/big_bold.font>Скрените на паркинг место. </font>"
#!{
	key[]: "aca_msg_book1_3_16_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_16_end"
	val[]: "@@aca_msg_book1_2_01_end@@"


 #!}


#@}

#+ Book 1 Scenario 3_17
#@{

#### 3_17 common
	key[]: "aca_scenario_book1_3_17_title"
	val[]: "Возите уназад у скретању"

	key[]: "aca_scenario_book1_3_17_desc"
	val[]: "У овом сценарију, први пут ћемо се кретати уназад са приколицом у скретање. Истражићемо основне принципе вожње уназад и на шта треба обратити пажњу када се скреће уназад."

#### 3_17 goal

	key[]: "aca_goal_book1_3_17_check1"
	val[]: "Окретање приколице"
#!{
	key[]: "aca_goal_book1_3_17_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_17_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_17_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_17_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
 #!}
#### 3_17 msg - intro text

	key[]: "aca_msg_book1_3_17_cutscene01"
	val[]: "У овом сценарију, мораћете да се вратите уназад до паркинг места које је иза вас на страни вашег возача."

	key[]: "aca_msg_book1_3_17_cutscene02"
	val[]: "Треба запамтити неколико савета који ће вам много помоћи вожњом са приколицама уназад. <br>Први је тај што ће приколица увек желети да се окрене у супротном смеру од начина на који управљате тегљачем."

	key[]: "aca_msg_book1_3_17_cutscene03"
	val[]: "Други је да можете добити добар осећај куда се приколица креће посматрајући осовине камиона и приколице."

	key[]: "aca_msg_book1_3_17_cutscene04"
	val[]: "Треће, мали уноси ће вас одвести тамо где треба да идете, без потребе да се превише оптерећујете."

	key[]: "aca_msg_book1_3_17_cutscene05"
	val[]: "Почните лагано да окрећете тегљач од паркинг места, а приколица ће почети да показује ка њему."

	key[]: "aca_msg_book1_3_17_cutscene06"
	val[]: "Пратите приколицу, прилагођавајући се док идете да бисте је држали на правом путу."

	key[]: "aca_msg_book1_3_17_cutscene07"
	val[]: "Гледајте своје точкове приколице и задњи точак тегљача. Они ће вам рећи где је приколица усмерена, а где тегљач гура."

	key[]: "aca_msg_book1_3_17_cutscene08"
	val[]: "Четврти савет је да је увек лакше окренути приколицу оштрије него покушати да је исправите ножем. Циљајте ка спољашњој страни места док јој се не приближите, а затим можете да скренете мало оштрије да поравнате своју приколицу."

	key[]: "aca_msg_book1_3_17_cutscene09"
	val[]: "Док приколица улази на паркинг место, ставите тегљач испред приколице. Покушајте да избегнете превише подешавања унутар места."

	key[]: "aca_msg_book1_3_17_cutscene10"
	val[]: "Возите између баријера уназад, проверите обе стране док идете."

	key[]: "aca_msg_book1_3_17_cutscene11"
	val[]: "Обезбедите камион и угасите мотор."

#### 3_17 Driving Instructions

	key[]: "aca_msg_book1_3_17_start"
	val[]: "Запамтите ове савете када прелазите у вожњу уназад са приколицом:<br><br>— Приколица се окреће супротно од начина на који управљате тегљачем<br><br>— Гледајте точкове приколице да видите куда циља<br><br>— Гледајте задњи точак тегљача да видите где гура приколицу<br><br>— Пустите приколицу да одради посао, немојте је преуправљати<br><br>— Увек је лакше окренути приколицу оштрије него је исправити<br><br><font face=/font/big_bold.font>Припремите се да кренете. </font>"

	key[]: "aca_msg_book1_3_17_backward"
	val[]: "Погледајте иза себе да бисте пронашли где треба да идете. Увек проверите своје окружење пре него што почнете да возите уназад.<br><br><font face=/font/big_bold.font>Почните да возите уназад ка паркинг месту.</font>"

	key[]: "aca_msg_book1_3_17_check1"
	val[]: "<font face=/font/big_bold.font>Почните да окрећете приколицу ка паркинг месту и пратите је.</font>"

	key[]: "aca_msg_book1_3_17_stop"
	val[]: "<font face=/font/big_bold.font>Зауставите се у означено место. </font>"
#!{
	key[]: "aca_msg_book1_3_17_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_18
#@{

#### 3_18 common
	key[]: "aca_scenario_book1_3_18_title"
	val[]: "Маневар паркирања у уличици"

	key[]: "aca_scenario_book1_3_18_desc"
	val[]: "У овом сценарију, имаћете задатак да возите уназад приколицу у уличицу са малог пута."

#### 3_18 goal

	key[]: "aca_goal_book1_3_18_check1"
	val[]: "Окретање приколице"
#!{
	key[]: "aca_goal_book1_3_18_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_18_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


	key[]: "aca_goal_book1_3_18_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_18_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

 #!}
#### 3_18 msg - intro text

	key[]: "aca_msg_book1_3_18_cutscene01"
	val[]: "Паркирање овде захтева маневар „паркирање у уличици“.<br>Ово је типичан маневар паркирања за камионџије, јер ће се са оваквом ситуацијом паркирања сусрести скоро свакодневно у својој каријери, било да се ради о утовару или истовару приколице или паркирању преко ноћи на стајалишту за камионе."

	key[]: "aca_msg_book1_3_18_cutscene02"
	val[]: "Ово је сличан маневар претходном сценарију, али ћете имати мање простора за рад, тако да ћете морати да планирате своје потезе у складу са тим и пазите да ништа не ударите."

	key[]: "aca_msg_book1_3_18_cutscene03"
	val[]: "Пошто има мање простора, ваш тајминг је важнији. Окрените приколицу у право време и посматрајте тегљач и точкове приколице да видите куда ће ићи. Имајте на уму замах репа и запамтите да не ударате ножем - наставите да гурате приколицу."

	key[]: "aca_msg_book1_3_18_cutscene04"
	val[]: "Покушајте да усмерите приколицу према уличици раније него касније. Ово ће вам дати простор на другој страни да окренете предњи део приколице и да ставите тегљач испред њега."

	key[]: "aca_msg_book1_3_18_cutscene05"
	val[]: "Када је ваша приколица у уличици, ставите тегљач испред ње. Боље је то учинити мало раније него што би вас инстинкт у почетку могао навести. Увек га можете исправити као наличје на своју коначну позицију."

	key[]: "aca_msg_book1_3_18_cutscene06"
	val[]: "Исправите тегљач и приколицу и зауставите се на предвиђеном месту."

	key[]: "aca_msg_book1_3_18_cutscene07"
	val[]: "Обезбедите камион и угасите мотор."


#### 3_18 Driving Instructions

	key[]: "aca_msg_book1_3_18_start"
	val[]: "Сада ћемо покушати да окренемо приколицу на много мањој површини са маневром „паркирање у улици“. <br><br><font face=/font/big_bold.font>Припремите се за полазак. </font>"

	key[]: "aca_msg_book1_3_18_backward"
	val[]: "Проверите своју околину и потражите место за паркирање иза себе. <br><br><font face=/font/big_bold.font>Почните да возите уназад ка паркинг месту. </font>"

	key[]: "aca_msg_book1_3_18_check1"
	val[]: "<font face=/font/big_bold.font>Окрените приколицу на паркинг место. </font>"
#!{
	key[]: "aca_msg_book1_3_18_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_18_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}


#@}

#+ Book 1 Scenario 3_19
#@{

#### 3_19 common
	key[]: "aca_scenario_book1_3_19_title"
	val[]: "Завршни испит (1. део)"

	key[]: "aca_scenario_book1_3_19_desc"
	val[]: "Очекује вас завршни испит, где ће све вештине које сте научили из претходних сценарија бити стављене на пробу. Провозаћемо се по целом центру за обуку да видимо колико сте добро научили ситуације са којима сте се до сада сусретали.<br><br>Када завршите све деонице и маневре, бићете корак ближе томе да себе назовете вештим камионџијем!"

