	val[]: "Прво скретање"

	key[]: "aca_goal_book1_3_03_check2"
	val[]: "Кружни ток"

	key[]: "aca_goal_book1_3_03_check3"
	val[]: "Скретање од 90°"

	key[]: "aca_goal_book1_3_03_check4"
	val[]: "Југ хандле скретање"

	key[]: "aca_goal_book1_3_03_check5"
	val[]: "Бутон хок скретање"

	key[]: "aca_goal_book1_3_03_check6"
	val[]: "Уско окретање"


#### generic phrase

	key[]: "aca_goal_book1_3_03_chk_point"
	val[]: "Вожња око баријера"

#### 3_03 msg - intro text

	key[]: "aca_msg_book1_3_03_cutscene01"
	val[]: "Испред су разни сложени углови и препреке.<br>Узмите у обзир све што сте до сада научили и то не би требало да буде тешко."

	key[]: "aca_msg_book1_3_03_cutscene02"
	val[]: "Први угао је лако скретање бутон хок. Држите се широко и то не би требало да представља проблем."

	key[]: "aca_msg_book1_3_03_cutscene03"
	val[]: "Наставите према кружном току."

	key[]: "aca_msg_book1_3_03_cutscene04"
	val[]: "Држите приколицу даље од унутрашњости кружног тока тако што ћете тегљач возити што је могуће шире око ње."

	key[]: "aca_msg_book1_3_03_cutscene05"
	val[]: "Скретање од 90° улево није посебно тесан, али пазите да не ударите ни у један чуњ."

	key[]: "aca_msg_book1_3_03_cutscene06"
	val[]: "Ово скретање је знатно тесније. Користите маневар југ хандле да бисте га довршили."

	key[]: "aca_msg_book1_3_03_cutscene07"
	val[]: "У овом скретању можете користити маневар бутон хок, али постоје неке додатне препреке које треба избегавати."

	key[]: "aca_msg_book1_3_03_cutscene09"
	val[]: "Још једном, последњи заокрет је веома тесан и биће потребна комбинација маневара југ хандле и бутон хок да завршите."

	key[]: "aca_msg_book1_3_03_cutscene10"
	val[]: "Паркирајте на за то предвиђеном месту, обезбедите камион и угасите мотор."


#### 3_03 Driving Instructions



	key[]: "aca_msg_book1_3_03_forward"
	val[]: "<font face=/font/big_bold.font>Наставите до првог скретања. </font>"

	key[]: "aca_msg_book1_3_03_check1"
	val[]: "Прво цкретање је једноставно скретање бутон хок.<br><br><font face=/font/big_bold.font><color value=@@clr_txt@@>Наставите кроз скретање.</font>"

	key[]: "aca_msg_book1_3_03_check2"
	val[]: "Наставите до кружног тока. Не заборавите да га обиђете широким путем.<br><br><font face=/font/big_bold.font>Возите до и око кружног тока.</font>"

	key[]: "aca_msg_book1_3_03_check3"
	val[]: "Ово скретање од 90° је мало тесније, пазите да не ударите у чуњеве.<br><br><font face=/font/big_bold.font>Направи скретање.</font>"

	key[]: "aca_msg_book1_3_03_check4"
	val[]: "Овом скретању је најбоље приступити поступком југ хандле. Замахните широко пре него што уђете на раскрсницу.<br><br><font face=/font/big_bold.font>Направите југ хандле скретање. </font>"

	key[]: "aca_msg_book1_3_03_check5"
	val[]: "Ово скретање је препуно неколико различитих препрека, али то се може урадити маневром бутон хок.<br><br><font face=/font/big_bold.font>Наставите пажљиво. </font>"

	key[]: "aca_msg_book1_3_03_check6"
	val[]: "Ово скретање је најтеже до сада, преговарајте о њему како вам одговара.<br><br><font face=/font/big_bold.font>Скрените на паркинг.</font>"
#!{
	key[]: "aca_msg_book1_3_03_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_03_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

