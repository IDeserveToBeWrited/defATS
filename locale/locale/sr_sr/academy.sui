#+ Book 1 Scenario 3_16
#@{

#### 3_16 common
	key[]: "aca_scenario_book1_3_16_title"
	val[]: "Дијагонално паркирање у вожњи уназад"

	key[]: "aca_scenario_book1_3_16_desc"
	val[]: "У овом сценарију, истражићемо паркирање дијагонално при кретању уназад. Ово се може десити на одмориштима, стајалиштима камиона, па чак и код пошиљалаца. Често је мало простора јер су парцеле крцате камионима, па је паркирање утолико теже због недостатка простора."

#### 3_16 goal

	key[]: "aca_goal_book1_3_16_check1"
	val[]: "Окретање приколице"
#!{
	key[]: "aca_goal_book1_3_16_start"
