#+ Washington TBs and POIs localization.
#@{
	key[]: "tb_wa1"
	val[]: "올림픽 반도"

	key[]: "tb_wa1_desc"
	val[]: "올림픽 반도는 바다와 숲, 산이 끊임없이 변하는 아름다움 속에서 공존하는 곳을 보여줍니다. 안개가 바위투성이 해안을 따라 흘러가고, 폭포는 고지대에서 쏟아져 내리며, 그곳의 숨겨진 계곡들은 작은 역사 마을들을 품고 있다."

	key[]: "poi_wa1_01"
	val[]: "미국의 역사적인 우체국"

	key[]: "poi_wa1_01_desc"
	val[]: "1893년에 포트 타운센드 해안가 위의 절벽에 완공된 이 건물은 세관을 갖춘 연방 시설로 설계되었으며, 이는 국제 무역의 신흥 중심지로서 도시가 지닌 초기 야망을 반영합니다."

	key[]: "poi_wa1_02"
	val[]: "포트앤젤레스"

	key[]: "poi_wa1_02_desc"
	val[]: "포트앤젤레스는 19세기에 항구이자 보급 기지로 세워진 해안 도시입니다. 오늘날 이곳은 올림픽 국립공원으로 가는 주요 관문이자 미국과 캐나다를 잇는 페리 항구 역할을 하고 있습니다."

	key[]: "poi_wa1_03"
	val[]: "크레센트 레이크"

	key[]: "poi_wa1_03_desc"
	val[]: "워싱턴 주에서 두 번째로 깊은 호수인 레이크 크레센트는 낮은 질소 농도 덕분에 선명한 푸른빛과 맑고 투명한 물로 유명합니다. 인기 있는 휴양 지역 안에 자리 잡고 있으며, 산책로와 원시림으로 둘러싸여 있습니다."
	
	key[]: "poi_wa1_04"
	val[]: "칼랄로치 해변"

	key[]: "poi_wa1_04_desc"
	val[]: "칼랄로치 해변은 작은 개울에서 해안까지 뿌리가 드러난 시트카 가문비나무인 '생명의 나무'로 유명합니다. 일반적인 키 큰 가문비나무와 달리, 이 나무는 더 낮고 굵으며 바람에 휘날려 독특하고 지역에서 인기 있는 랜드마크가 되었습니다."

	key[]: "poi_wa1_05"
	val[]: "올림픽 국립공원"

	key[]: "poi_wa1_05_desc"
	val[]: "올림픽 국립공원은 거친 태평양 해안선과 온대 우림, 그리고 고산 봉우리에 이르기까지 다양한 생태계를 보호합니다. 1909년에 처음으로 국립기념물로 지정되었으며, 1938년에 연방 정부에 의해 국립공원으로 이름이 바뀌었습니다."

	key[]: "poi_wa1_06"
	val[]: "그린헤드 슬로"

	key[]: "poi_wa1_06_desc"
	val[]: "그린헤드 슬로는 윌라파 베이 근처 101번 고속도로를 따라 위치한 작은 만과 습지 수로입니다. 이곳은 연어 산란과 풍부한 물새 관찰을 지원하기 위해 복원된 해안 하구 서식지 내에 위치해 있습니다."

	key[]: "poi_wa1_07"
	val[]: "다봅 만"

	key[]: "poi_wa1_07_desc"
	val[]: "다봅 만은 연어, 조개류, 그리고 야생동물을 품고 있는 깊은 피오르드입니다. 1984년에 설립된 다봅 베이 자연 지역은 기능이 뛰어난 조간대 습지 시스템 내에서 희귀한 염습지와 모래톱 식물 군락을 보호합니다."


##########################################################################################

	key[]: "tb_wa2"
	val[]: "중서부 지역"

	key[]: "tb_wa2_desc"
	val[]: "워싱턴의 중심부는 상록수 숲과 고요한 고산 호수를 따라 그림 같은 길을 걷는 여행자들을 초대합니다. 레이니어 산은 지평선 위로 우뚝 솟아 상징적인 경관을 선사하며, 태평양 북서부의 자연 풍경 속으로 평화로운 여행을 안내합니다."

	key[]: "poi_wa2_01"
	val[]: "레이니어 산"

	key[]: "poi_wa2_01_desc"
	val[]: "워싱턴 주에서 가장 높은 봉우리인 레이니어 산(14,411피트)은 활화산인 성층화산입니다. 그곳의 빙하는 강물을 공급하고 계곡을 형성하며 풍부한 숲과 야생동물을 유지해, 중요한 자연 명소로 자리 잡고 있습니다."

	key[]: "poi_wa2_02"
	val[]: "와나치 국유림"

	key[]: "poi_wa2_02_desc"
	val[]: "웨나치 국유림은 산맥과 강, 그리고 고산 계곡에 걸쳐 있습니다. 1933년에는 민간보존단이 이곳에 등산로와 산불 감시초소를 세워 숲의 레크리에이션과 보존 역사에 오래도록 남을 흔적을 남겼습니다."

	key[]: "poi_wa2_03"
	val[]: "마운트 베이커–스노퀄미 국유림"

	key[]: "poi_wa2_03_desc"
	val[]: "마운트 베이커-스노퀄미 국유림에는 미국에서 가장 오래된 빙하 관측 지점들이 있으며, 1900년대 초부터 캐스케이드 산맥 전역의 화산성 빙하 흐름과 기후 변화를 추적해 왔습니다."
	
	key[]: "poi_wa2_04"
	val[]: "와나치 강"

	key[]: "poi_wa2_04_desc"
	val[]: "웨나치 강을 따라 19세기 초 관개 수로와 방앗간의 흔적이 남아 있어 정착민들이 강물을 어떻게 이용했는지 보여줍니다. 원주민 부족들은 유럽인들이 정착하기 훨씬 이전부터 연어가 풍부한 이 강의 물을 식량과 교역에 의존해 왔습니다."

	key[]: "poi_wa2_05"
	val[]: "클라와티 봉우리"

	key[]: "poi_wa2_05_desc"
	val[]: "20세기 중반에 처음 등정된 클라와티 봉우리는 가파르고 빙하로 덮인 경사 때문에 여전히 거의 등반되지 않으며, 북부 캐스케이드에서 고립된 환경을 원하는 등반가들에게 인기 있는 도전 과제입니다."

	key[]: "poi_wa2_06"
	val[]: "드라이 폴스 댐"

	key[]: "poi_wa2_06_desc"
	val[]: "지역 수로를 관리하기 위해 건설된 드라이 폴스 댐은 선사 시대 현무암 절벽 위에 자리 잡고 있으며, 계절별 유량을 조절하는 동시에 빙하기 홍수에 의해 형성된 계단식 지형과 물웅덩이를 드러냅니다."

	key[]: "poi_wa2_07"
	val[]: "화이트 마운틴 화재 감시탑"

	key[]: "poi_wa2_07_desc"
	val[]: "전망대에는 워싱턴 주 역사상 가장 큰 산불 중 하나였던 1988년 화이트 마운틴 산불에 대한 안내판이 설치되어 있어 숲의 상처와 재성장 양상을 보여줍니다."

	key[]: "wa_cut_helen_desc"
	val[]: "1980년 이전의 세인트헬렌스 산은 원뿔 모양이었으며 '미국의 후지산'으로 불렸습니다. 1980년 분화로 정상의 406미터(1,300피트)가 깎여나가 말굽 모양의 분화구가 형성되었고, 현재는 용암 돔과 빙하로 부분적으로 채워져 있습니다."


##########################################################################################


	key[]: "tb_wa3"
	val[]: "와인 산지"

	key[]: "tb_wa3_desc"
	val[]: "워싱턴 주의 와인 산지는 캐스케이드 산맥 동쪽에 위치한 컬럼비아 밸리 AVA를 아우릅니다. 이 지역에는 셀라 크릭, 루이스 앤 클라크 주립공원, 그리고 역사적으로 원주민들이 거주했던 땅이 포함되어 있으며, 건조하고 햇볕이 잘 드는 구릉과 강 계곡이 어우러진 풍경이 특징입니다."

	key[]: "poi_wa3_01"
	val[]: "클리어 크릭 폭포"

	key[]: "poi_wa3_01_desc"
	val[]: "클리어 크릭 폭포 전망대는 화이트 패스 정상 바로 동쪽에 있는 인기 명소입니다. 거기서 동쪽으로 약 1마일 정도 더 가면 낚시와 야생 동물 관찰을 즐길 수 있는 클리어 레이크 휴양지로 가는 길이 나옵니다."

	key[]: "poi_wa3_02"
	val[]: "셀라 크릭 다리"

	key[]: "poi_wa3_02_desc"
	val[]: "프레드 G. 레드먼 다리(또는 셀라 크릭 다리)는 야키마 카운티에 있는 쌍아치 구조물입니다. 완공 당시 미국에서 가장 긴 콘크리트 아치교이자 워싱턴 주에서 가장 높은 자동차 전용 다리였습니다."

	key[]: "poi_wa3_03"
	val[]: "포도밭"
	
	key[]: "poi_wa3_03_desc"
	val[]: "워싱턴의 계곡과 비옥한 토양은 리슬링, 카베르네, 메를로를 포함한 많은 포도 품종을 재배하는 데 적합합니다. 포도밭은 주의 농업과 지역 경관에서 중요한 부분을 차지합니다."

	key[]: "poi_wa3_04"
	val[]: "에드 헨들러 다리"

	key[]: "poi_wa3_04_desc"
	val[]: "1978년에 건설된 이 다리는 때때로 인터시티 브리지라고도 불리며, 워싱턴주 남동부의 파스코와 케너윅 사이에서 컬럼비아 강을 가로지릅니다. 개장 이래로 이곳은 트라이시티 지역의 랜드마크이자 상징으로 여겨져 왔습니다."

	key[]: "poi_wa3_05"
	val[]: "루이스 앤 클라크 주립공원"

	key[]: "poi_wa3_05_desc"
	val[]: "워싱턴 주 최초의 주립공원 중 하나인 루이스 앤 클라크 주립공원은 역사적인 원주민 이동 경로를 따라 펼쳐진 고대 숲을 보존하고 있습니다. 탐험대를 기리기 위해 이름 붙여진 이 공원의 숲은 메리웨더 루이스가 그의 일지에 묘사한 울창한 삼림 지대를 떠올리게 합니다."

	key[]: "poi_wa3_06"
	val[]: "콜럼비아 카운티 법원"

	key[]: "poi_wa3_06_desc"
	val[]: "컬럼비아 카운티 법원 건물은 카운티 정부가 일상생활의 중심이었던 시대를 반영합니다. 급속한 성장과 주도와의 단절이 심했던 이 시기에, 법원은 주요 권한의 원천으로서 시민들의 당면한 요구를 해결해 주었습니다."

	key[]: "poi_wa3_07"
	val[]: "아메리카 원주민 부족"

	key[]: "poi_wa3_07_desc"
	val[]: "컬럼비아 밸리와 주변 지역은 야카마족, 왈라왈라족, 우마틸라족을 비롯한 원주민들의 삶의 터전이었습니다. 오늘날에도 이들 공동체는 이 지역에 거주하며 문화적 전통을 유지하고 토지와 수자원을 관리하고 있습니다."

##########################################################################################

#@}




#+ Oregon TBs and POIs localization.
#@{
	key[]: "tb_or1"
	val[]: "태평양 연안"

	key[]: "tb_or1_desc"
	val[]: "오리건 주의 태평양 연안은 험준한 곶과 아름다운 경관을 자랑하는 곳들로 펼쳐집니다. 헤세타 헤드 등대에서 부서지는 파도를 내려다보는 풍경을 비롯하여 실버 포인트, 오피르 웨이사이드, 시스터즈 록스, 키싱 록은 현무암 절벽이 솟아 태평양의 파도와 맞닿아 있는 모습을 보여줍니다."

	key[]: "landmark_or_astoria_b_desc"
	val[]: "컬럼비아 강을 가로지르는 4마일 길이의 이 다리는 오리건 주와 워싱턴 주를 연결하며, 강의 하구와 태평양 수평선을 조망할 수 있게 해줍니다."

	key[]: "poi_or1_01"
	val[]: "실버 포인트 전망대"

	key[]: "poi_or1_01_desc"
	val[]: "캐논 비치 바로 남쪽에 위치한 이 전망대에서는 헤이스택 록과 험준한 해안선의 탁 트인 경치를 감상할 수 있으며, 특히 일몰 시간에는 더욱 아름답습니다."

	key[]: "or_cut_lighthouse_desc"
	val[]: "1873년에 건설된 오리건 주에서 가장 높은 등대는 뉴포트 근처의 현무암 곶 위에 서 있습니다."

	key[]: "or_cut_newport_desc"
	val[]: "1936년에 완공된 야퀴나 베이 다리는 오리건 주에서 가장 상징적인 해안 건축물 중 하나입니다. 저명한 엔지니어 콘데 맥컬로가 설계한 이 우아한 아치는 야퀴나 만을 가로지르며 미국 국도 101호선의 대표적인 특징으로 남아 있습니다."

	key[]: "or_cut_thor_desc"
	val[]: "케이프 퍼페투아에 있는 자연적인 싱크홀로, 밀려드는 파도가 무너지면서 마치 바닷물이 빠져나가는 듯한 착시 현상을 일으킵니다."

	key[]: "poi_or1_02"
	val[]: "오피르 웨이사이드"

	key[]: "poi_or1_02_desc"
	val[]: "골드 비치 근처의 한적한 갓길로, 방문객들은 이곳에서 휴식을 취하거나, 파도를 구경하거나, 해변을 따라 떠내려온 나무 조각과 마노를 주울 수 있습니다."

	key[]: "poi_or1_03"
	val[]: "시스터즈 록 전망대"

	key[]: "poi_or1_03_desc"
	val[]: "파도를 등지고 솟아오른 웅장한 해식 기둥들과, 절벽 사이에 숨겨진 작은 해변으로 이어지는 오솔길들이 있습니다."

	key[]: "poi_or1_04"
	val[]: "키싱 록"

	key[]: "poi_or1_04_desc"
	val[]: "골드 비치 남쪽의 길가에 있는 휴게소로, 두 개의 거대한 바위가 모래사장 위로 기대어 서 있어 사진 명소로 인기가 높습니다."


##########################################################################################

	key[]: "tb_or2"
	val[]: "와일드 이스트"

	key[]: "tb_or2_desc"
	val[]: "흔히 오리건의 야생 동부라고 불리는 이 지역은 수억 년에 걸친 지질학적 힘에 의해 형성된 풍경을 보여주며, 그중 많은 부분이 오늘날에도 여전히 활발하게 작용하고 있습니다. 그 광대한 시간 규모에 비하면 인류의 역사는 짧지만, 땅 자체만큼이나 극적인 순간들로 점철되어 있습니다."

	key[]: "landmark_or_deadman_p_desc"
	val[]: "펜들턴 근처에 있는 이 전망대에서는 데드맨 패스의 경치를 감상할 수 있습니다. 데드맨 패스는 1870년대 배넉 전쟁 당시 마차 운전사가 사망한 채 발견된 사건에서 이름을 따왔습니다. 그보다 수십 년 전에는 수많은 마차가 오리건 트레일을 따라 이 언덕들을 넘었습니다."

	key[]: "or_cut_395_desc"
	val[]: "한때 쓰리 플래그 하이웨이로 알려졌던 미국 395번 도로는 캐나다에서 멕시코까지 뻗어 사막, 숲, 산맥을 연결했습니다. 오늘날 이 도로는 캘리포니아의 미국 15번 도로와 만나지만, 원래 노선의 흔적이 샌디에이고 근처에 남아 있습니다."

	key[]: "poi_or2_01"
	val[]: "말헤르 국유림"

	key[]: "poi_or2_01_desc"
	val[]: "말휴어 국유림은 블루 마운틴에 위치해 있습니다. 1억 5천만 년도 더 전에 이 지역의 가장 오래된 암석 중 일부는 태평양의 화산섬을 형성했으며, 이후 대륙과 합쳐졌습니다."
	
	key[]: "poi_or2_02"
	val[]: "배드랜드 야생보호구역"

	key[]: "poi_or2_02_desc"
	val[]: "벤드 바로 동쪽에 위치한 배드랜드 야생보호구역은 고대 용암류와 바람에 날린 화산재로 형성된 험준한 화산 지형입니다. 뒤틀린 용암 지형, 모래 토양, 황량한 지형은 주에서 가장 독특한 고산 사막 환경 중 하나를 만들어냅니다."

	key[]: "poi_or2_03"
	val[]: "아버트 호수"

	key[]: "poi_or2_03_desc"
	val[]: "1843년에 처음 지도에 표시된 아버트 호수는 1만 년 넘게 인간의 거주지를 제공해 왔습니다. 염도가 너무 높아 물고기가 살 수는 없지만, 태평양 철새 이동 경로를 따라 이동하는 새들에게 중요한 기착지 역할을 하고 있으며, 최근 수십 년 동안 기후 변화로 인해 수위가 낮아지고 있습니다."

	key[]: "poi_or2_04"
	val[]: "이스트 스틴스 투어 루트"

	key[]: "poi_or2_04_desc"
	val[]: "이스트 스틴스 투어 루트는 스틴스 산과 알보드 사막을 따라 78번 고속도로를 따라 이어집니다. 이 루트의 하이라이트는 오리건에서 가장 큰 건호수 중 하나인 알보드 사막 플라야로, 계절에 따라 얕은 호수와 광활한 사막 평원 사이를 오갑니다."

	key[]: "poi_or2_05"
	val[]: "도허티 슬라이드"

	key[]: "poi_or2_05_desc"
	val[]: "화산 활동으로 형성된 암석 지형인 도허티 슬라이드를 따라 차로 이동하는 데는 한 시간도 채 걸리지 않습니다. 하지만 자연이 오늘날과 같은 풍경을 만들어내는 데는 약 1600만 년이라는 시간이 걸렸습니다."


##########################################################################################

	key[]: "tb_or3"
	val[]: "오그덴 주"

	key[]: "tb_or3_desc"
	val[]: "이 경로는 오리건 주의 내륙 남북 회랑을 따라 숲과 고원 사막을 지나갑니다. 1820년대 모피 무역상 피터 스킨 오그던이 처음 탐험한 이 경로는 이후 제2차 세계 대전 동안 목재 및 수송로로서 전략적 중요성을 갖게 되었습니다."
	
	key[]: "poi_or3_01"
	val[]: "스프링필드 플레임"

	key[]: "poi_or3_01_desc"
	val[]: "높이가 거의 65피트에 달하는 이 조형물은 스프링필드의 북쪽 관문 역할을 하며, 여행자들을 위한 등대이자 주민과 방문객 모두를 위한 랜드마크가 되도록 불꽃 모양으로 설계되었습니다."

	key[]: "poi_or3_02"
	val[]: "산티암 왜건 로드"

	key[]: "poi_or3_02_desc"
	val[]: "이곳 동쪽의 고갯길은 앤드류 와일리의 이름을 따서 와일리 고개라고 불렸으며, 1859년 목초지를 찾던 개척자들이 탐험했습니다. 1864년에 군용 도로 건설이 계획되었지만 대부분 실현되지 못했습니다. 1868년부터 1914년까지는 유료 도로인 산티암 마차 도로가 운영되었습니다."

	key[]: "poi_or3_03"
	val[]: "베테랑 역사 고속도로"

	key[]: "poi_or3_03_desc"
	val[]: "고속도로 북쪽 입구, 빅스 정션 남쪽에 18개의 기념 표지판 중 마지막 두 개가 2012년 11월 9일에 설치되었습니다. 이 표지판들은 캠프 루퍼스가 제2차 세계 대전 참전 용사들을 기리기 위해 헌정된 영국 최초의 고속도로의 북쪽 진입 지점임을 나타냅니다."

	key[]: "poi_or3_04"
	val[]: "오그덴 주립 경관 전망대"

	key[]: "poi_or3_04_desc"
	val[]: "19세기 초 탐험가이자 허드슨 베이 회사의 수석 무역상이었던 피터 스케네 오그던의 이름을 딴 이 길가 표지판은 그가 스네이크 강 유역을 탐험하고 그레이트 솔트 레이크 분지를 최초로 탐험한 인물 중 한 명이었던 것을 기리는 의미를 담고 있습니다."

	key[]: "landmark_or_fremont_b_desc"
	val[]: "이 다리와 포틀랜드의 프레몬트 거리는 라스 캘리포니아와 오리건 지역을 초기 탐험했던 존 C. 프레몬트의 이름을 따서 명명되었습니다. 이 다리는 오리건 주에서 가장 긴 주경간을 자랑하며, 세계에서 두 번째로 긴 타이아치교입니다."

	
##########################################################################################

#@}



#+ California TBs and POIs localization.
#@{
	key[]: "tb_ca1"
	val[]: "황금빛 지평선"

	key[]: "tb_ca1_desc"
	val[]: "반짝이는 수면 위로 솟아오른 상징적인 다리들은 알카트라즈 섬과 산타크루즈, 그리고 이 지역의 언덕과 동네들을 연결합니다. 활기 넘치는 거리와 유적지부터 햇살 가득한 해변과 아름다운 해안선까지, 샌프란시스코 만 지역은 다른 곳에서는 경험할 수 없는 특별한 캘리포니아의 매력을 선사합니다."

	key[]: "ca_cut_golden_gate_bridge_desc"
	val[]: "샌프란시스코 만과 태평양을 연결하는 이 다리는 샌프란시스코와 캘리포니아의 상징적인 건축물입니다. 1937년 개통 당시에는 세계에서 가장 길고 가장 높은 현수교라는 기록을 보유했습니다."

	key[]: "poi_ca1_01"
	val[]: "알카트라즈"

	key[]: "poi_ca1_01_desc"
	val[]: "알카트라즈 섬은 1934년부터 1963년까지 연방 교도소가 있던 곳입니다. 미국에서 가장 악명 높은 범죄자들이 수감되었던 곳으로 유명하며, 현재는 역사 유적지이자 인기 있는 관광 명소입니다."

	key[]: "ca_cut_richmond_desc"
	val[]: "리치먼드-샌라파엘 다리는 샌프란시스코 만을 가로질러 리치먼드와 샌라파엘을 연결합니다. 1956년에 개통된 이 다리는 북쪽 만을 가로지르는 교통로 역할을 하며, 캔틸레버와 트러스 구조로 설계되어 지역의 주요 교통 연결망으로 기능합니다."
	
	key[]: "poi_ca1_02"
	val[]: "보물섬"

	key[]: "poi_ca1_02_desc"
	val[]: "보물섬은 1939년 골든게이트 국제 박람회를 위해 만들어진 인공섬이다. 해군 기지로 사용된 후, 현재는 주거 및 상업 용도로 재개발되고 있습니다."

	key[]: "poi_ca1_03"
	val[]: "서핑 도시"

	key[]: "poi_ca1_03_desc"
	val[]: "산타크루즈의 서핑 동상은 도시의 서핑 유산과 문화를 기립니다. 해변가 근처에 설치된 이 조형물은 지역 서퍼들과 산타크루즈의 정체성과 해안 공동체를 형성해 온 서핑을 기념합니다."

	key[]: "poi_ca1_04"
	val[]: "마돈나 인"

	key[]: "poi_ca1_04_desc"
	val[]: "152번 고속도로 정상에 있던 한때 인기 있던 식당이자 행사 명소입니다. 2004년부터 고속도로 문제로 폐쇄되었지만, 지역 역사와 유령 이야기 포럼에서 여전히 자주 언급되는 주제입니다."



##########################################################################################

	key[]: "tb_ca2"
	val[]: "샤스타 루트"

	key[]: "tb_ca2_desc"
	val[]: "샤스타 루트는 샤스타 산 아래 소나무 숲과 반짝이는 고산 호수를 따라 구불구불 이어집니다. 도로들은 숨겨진 계곡을 오르내리며, 산들이 점차 사라지고 북부 캘리포니아의 고대 레드우드 숲으로 이어질 때 여행자들을 남쪽으로 실어 나릅니다."

	key[]: "poi_ca2_01"
	val[]: "샤스타-트리니티 국유림"

	key[]: "poi_ca2_01_desc"
	val[]: "캘리포니아에서 가장 큰 샤스타-트리니티 국유림은 트리니티 헤리티지 경치 좋은 도로가 가로지릅니다. 19세기 금광 노동자들과 정착민들이 사용했던 경로를 따릅니다."

	key[]: "poi_ca2_02"
	val[]: "빅 라군"

	key[]: "poi_ca2_02_desc"
	val[]: "빅 라군은 험볼트 라군 주립공원에 있는 세 개의 석호 중 가장 크고 남쪽에 위치해 있습니다. 이 얕은 해안 분지는 바위투성이의 곶 사이에 자리 잡고 있으며, 파도가 모래 장벽을 쌓아 석호와 태평양을 분리하고 있습니다."

	key[]: "or_cut_sequoia_desc"
	val[]: "빅 라군은 어색볼트 라군으로서 공원에 있는 세세한 석호 중 가장 큰 규모에 있습니다. 이 해안 해안은 바위투성이의 곶 사이에 자리 잡고 있으며, 여행자가 모래 서버를 석호와 바다를 분리하고 있습니다."
	
	key[]: "poi_ca2_03"
	val[]: "스미스 리버"

	key[]: "poi_ca2_03_desc"
	val[]: "캘리포니아 북서부의 식스 리버스 국유림 내에 위치한 이 보호구역은 경관, 생태 및 문화적 가치를 보존하기 위해 1990년 의회에서 지정되었습니다. 스미스 강은 캘리포니아에서 유일하게 댐이 없는 자연 그대로 흐르는 주요 강입니다."

	key[]: "poi_ca2_04"
	val[]: "위스키 크릭 다리"

	key[]: "poi_ca2_04_desc"
	val[]: "1961년에 완공된 위스키 크릭 다리는 3경간 용접 강판 거더 구조물입니다. 이 다리는 당시 혁신적인 용접 기술이었던 세 가지 등급의 강재를 사용한 초기 교량 설계 사례로 주목할 만합니다."

	key[]: "poi_ca2_05"
	val[]: "샤스타 호수"

	key[]: "poi_ca2_05_desc"
	val[]: "캘리포니아 최대의 저수지인 샤스타 호수는 새크라멘토 강에 건설된 샤스타 댐으로 형성되었습니다. 1945년에 완공된 이 호수는 용수 공급, 수력 발전, 그리고 아름다운 경관을 자랑하는 휴양지로서의 역할을 합니다."

	key[]: "poi_ca2_06"
	val[]: "샤스타 산"

	key[]: "poi_ca2_06_desc"
	val[]: "1820년대부터 캐스케이드 산맥에서 두 번째로 높은 봉우리인 샤스타 산은 산기슭을 따라 조성된 시스키유 트레일을 따라 여행객들을 안내했습니다. 이 길은 훗날 5번 주간 고속도로로 발전했으며, 현재는 매년 수천 명의 사람들이 이 길을 따라 샤스타 산으로 향하고 있습니다."



##########################################################################################

	key[]: "tb_ca3"
	val[]: "시에라 크로싱"

	key[]: "tb_ca3_desc"
	val[]: "웅장한 시에라 네바다 산맥 아래, 벤튼 인은 탁 트인 계곡과 완만한 구릉 사이에 자리 잡고 있습니다. 시에라 크로싱은 고요한 고지대 사막 도로를 따라 구불구불 이어지며, 멀리 보이는 봉우리와 험준한 산등성이가 만들어내는 시대를 초월한 파노라마는 여행객들을 이 지역의 광활한 풍경 속으로 이끌어갑니다."

	key[]: "ca_cut_olmsted_point_desc"
	val[]: "1890년에 설립된 요세미티 국립공원은 가장 많은 관광객이 찾는 공원 중 하나입니다. 북미에서 가장 높은 폭포인 요세미티 폭포, 광범위한 트레일 시스템, 그리고 3,000년이 넘는 거대한 세쿼이아 나무로 유명합니다."

	key[]: "poi_ca3_01"
	val[]: "티오가 로드"

	key[]: "poi_ca3_01_desc"
	val[]: "티오가 로드는 요세미티 국립공원의 중심부를 가로지르는 상징적인 경관 도로입니다. 캘리포니아에서 가장 높은 고속도로 고갯길인 이 길은 시에라 네바다 산맥의 서쪽과 동쪽을 연결합니다."

	key[]: "poi_ca3_02"
	val[]: "모노 호수"

	key[]: "poi_ca3_02_desc"
	val[]: "모노 호수는 100만 년이 넘는 역사를 자랑하며, 북미에서 가장 오래된 호수 중 하나입니다. 자연적인 유출구가 없어 수천 년에 걸쳐 시에라 네바다 산맥 동부에서 흘러내려오는 하천에 의해 염분과 미네랄이 축적되었습니다."
	
	key[]: "poi_ca3_03"
	val[]: "타호 호수"

	key[]: "poi_ca3_03_desc"
	val[]: "타호 호수는 약 200만 년 전 타호 분지에서 형성되었으며, 현재의 모습은 빙하기의 빙하 작용으로 만들어졌습니다. 북아메리카에서 가장 큰 고산 호수이자 미국에서 두 번째로 깊은 호수입니다."

	key[]: "poi_ca3_04"
	val[]: "엘도라도 국유림"

	key[]: "poi_ca3_04_desc"
	val[]: "엘도라도 국유림은 수백만 명의 캘리포니아 주민들에게 물을 공급하는 주요 유역의 일부를 형성하며, 미국 전체 과일과 채소 생산량의 거의 절반을 차지하는 농장들을 지원합니다."

	key[]: "poi_ca3_05"
	val[]: "벤튼 온천에 묵기"

	key[]: "poi_ca3_05_desc"
	val[]: "모노 카운티에서 가장 오래된 마을 중 하나인 벤튼은 파이우트족이 온천을 이용하여 세운 곳입니다. 1860년대에는 정착민과 광부들의 휴식처가 되었습니다. 1940년대에 지역에서 채취한 부석으로 지어진 이 여관은 1904년에 지어진, 욕실 하나를 공유하는 10개의 객실을 갖춘 호텔을 대체했습니다."



##########################################################################################

	key[]: "tb_ca4"
	val[]: "태양과 모래"

	key[]: "tb_ca4_desc"
	val[]: "데스 밸리의 사막은 끝없이 펼쳐진 하늘 아래 모래 언덕, 험준한 봉우리, 갈라진 평원으로 이루어져 있다. 햇빛이 비치는 모래밭에는 토끼들이 뛰어다니고, 해골들은 고요한 길을 표시하며, 외딴 길들은 척박하고 험준한 풍경 속을 구불구불 이어져 이곳을 찾는 모든 이들에게 시험과 경외감을 안겨준다."

	key[]: "poi_ca4_01"
	val[]: "론 파인"

	key[]: "poi_ca4_01_desc"
	val[]: "론 파인은 캘리포니아 오언스 밸리에 있는 작은 마을로, 시에라 산맥의 동쪽 기슭에 위치해 있다. 근처에 있는 앨라배마 힐스로 유명한 이곳은 오랫동안 주변 산과 사막 지형을 탐험하는 등산객, 암벽 등반가, 영화 제작자들의 관문 역할을 해왔습니다."

	key[]: "poi_ca4_02"
	val[]: "데스밸리 국립공원"

	key[]: "poi_ca4_02_desc"
	val[]: "데스밸리는 미국에서 가장 극한적인 지형 중 하나로, 어떤 곳에서는 가장 낮고, 가장 덥고, 가장 건조하며, 가장 높습니다. 1800년대 개척자들보다 훨씬 이전부터, 이곳에는 원주민 부족들이 살며 이 거칠지만 역사적으로 풍부한 지역에서 사냥과 채집을 했습니다."

	key[]: "poi_ca4_03"
	val[]: "파더 크롤리 비스타 포인트"

	key[]: "poi_ca4_03_desc"
	val[]: "이 전망대는 여행객들에게 인기 있는 휴식처입니다. 사막의 신부로 알려진 존 J. 크롤리 신부도 종종 이곳에 들렀습니다. 공원 서쪽 경계 부근에 위치한 이곳에서는 고대 화산 활동으로 형성된 다채로운 색상의 레인보우 캐니언의 멋진 경관을 감상할 수 있습니다."
	
	key[]: "poi_ca4_04"
	val[]: "모하비 밸리 웰스"

	key[]: "poi_ca4_04_desc"
	val[]: "모하비 사막의 밸리 웰스에서는 고대 지하수 유출 퇴적물이 빙하기 시대의 습지 환경을 기록하고 있습니다. 이 역사적인 우물들은 지하수가 어떻게 건조한 사막 지역에 습지와 무성한 초목을 유지시켜 주었는지 보여줍니다."

	key[]: "poi_ca4_05"
	val[]: "콜로라도 강 인디언 보호구역"

	key[]: "poi_ca4_05_desc"
	val[]: "콜로라도 보호구역은 애리조나와 캘리포니아의 콜로라도 강을 따라 펼쳐져 있습니다. 1865년 강 유역 부족들을 위해 설립된 이곳은 모하비족, 체메후에비족, 호피족, 나바호족의 고향이며 오늘날에도 농업과 공동체 생활을 유지하고 있습니다."

##########################################################################################

#@}



#+ Idaho TBs and POIs localization.
#@{

    key[]: "tb_id1"
	val[]: "보물 계곡"

	key[]: "tb_id1_desc"
	val[]: "아이다호주 남서부에 위치한 트레저 밸리는 아메리카 원주민 부족, 초기 모피 상인, 그리고 오리건 트레일 정착민들에 의해 형성된 풍부한 역사를 지니고 있습니다. 그 이름은 이 지역의 풍부한 자원과 기회를 반영하며, 이후 농업, 철도, 그리고 보이시를 중심으로 한 지역 무역의 발달로 더욱 성장했습니다."

	key[]: "poi_id1_01"
	val[]: "연어 강"

	key[]: "poi_id1_01_desc"
	val[]: "아이다호 주의 새먼 강은 깊고 험준한 협곡을 따라 425마일(약 688km)에 걸쳐 뻗어 있습니다. 이 강은 초기 선박들이 강하고 험난한 물살을 거슬러 올라갈 수 없었기 때문에 \"돌아올 수 없는 강\"이라는 별명을 얻었습니다."

	key[]: "poi_id1_02"
	val[]: "보이시 국유림"

	key[]: "poi_id1_02_desc"
	val[]: "침식되기 쉬운 아이다호 화강암체를 가로지르는 보이시 국유림은 화산 활동으로 형성된 험준한 지형을 자랑합니다. 이러한 지질학적 유산은 가파른 협곡과 지형 곳곳에 자리한 수많은 천연 온천에서 가장 잘 드러납니다."

	key[]: "poi_id1_03"
	val[]: "호스슈 벤드"

	key[]: "poi_id1_03_desc"
	val[]: "1862년 보이시 분지에서 금이 발견된 후, 겨울을 강가에서 보내던 광부들이 호스슈 벤드를 세웠습니다. 원래는 지역 제재소 주인의 이름을 따서 워리너스빌이라고 불렸던 이 마을은 1867년 금광 탐사자들의 주요 경유지가 되면서 현재의 이름으로 바뀌었습니다."
	
	key[]: "poi_id1_04"
	val[]: "톨게이트"

	key[]: "poi_id1_04_desc"
	val[]: "1864년, 가파른 시럽 크릭 트레일을 대체하는 새로운 협곡 길이 개설되었습니다. 20년 동안 통행료로 유지 보수 비용이 충당되었고, 제임스 A. 포터의 유명한 호텔과 유제품 공장은 휴식을 찾는 여행객들에게 최고의 숙박 장소가 되었습니다."

	key[]: "poi_id1_05"
	val[]: "캐슬 록"

	key[]: "poi_id1_05_desc"
	val[]: "카마스 프레리를 향해, 캐슬 록의 화강암 노출지는 구데일 컷오프를 따라 이동하던 오리건 트레일 이주민들에게 상징적인 이정표 역할을 했다. 1862년부터 자동차 시대가 도래할 때까지 사용된 이 희귀한 편대 비행은 여행자들에게 경로를 따라 인상적인 광경을 선사했습니다."

    key[]: "poi_id1_06"
	val[]: "덕 밸리 인디언 보호구역"

	key[]: "poi_id1_06_desc"
	val[]: "1886년, 클리블랜드 대통령은 '패디 캡 확장'을 통해 덕 밸리를 아이다호 주로 확장했습니다 1934년까지 보호구역으로 이주한 여러 부족들은 연합 쇼쇼니-파이유트 부족으로서 연방 정부의 공식 인정을 받았습니다."


##########################################################################################

    key[]: "tb_id2"
	val[]: "마법의 계곡"

	key[]: "tb_id2_desc"
	val[]: "1900년대 초, I.B. 페린은 밀너 댐을 건설하여 아이다호의 건조한 사막을 농지로 바꾸었습니다. 1905년에 완공된 이 댐은 스네이크 강의 물을 이용해 경관을 '마법처럼' 변화시켰습니다. 이로 인해 매직 밸리가 형성되었고, 오늘날까지도 번성하는 농촌 마을들이 자리 잡게 되었습니다."

	key[]: "id_cut_perrine_desc"
	val[]: "나이아가라 폭포보다 높이 212피트에 달하는 쇼쇼니 폭포는 트윈 폭포 바로 가장자리에 위치한 아름다운 스네이크 강의 명소입니다."

	key[]: "id_cut_galena_desc"
	val[]: "1879년 납과 은이 발견된 후 세워진 이 광산 마을은 1890년대에 가격이 하락하면서 쇠퇴했습니다. 오늘날 이 지역은 역사적인 갈레나 롯지와 인근의 아름다운 갈레나 서밋이 자리한 휴양 중심지로 번성하고 있습니다."

	key[]: "poi_id2_01"
	val[]: "바이슨 점프"

	key[]: "poi_id2_01_desc"
	val[]: "챌리스에 위치한 바이슨 점프는 원주민들이 버팔로 떼를 절벽 아래로 몰아 사냥했던 유적지입니다. 2,000년 넘게 사용되어 온 이 전략적인 지형은 고대 공동 사냥 전통을 엿볼 수 있게 해줍니다."
	
	key[]: "poi_id2_02"
	val[]: "그랜드 뷰 캐니언"

	key[]: "poi_id2_02_desc"
	val[]: "미국 93번 국도의 피크스 투 크레이터스 경관 도로를 따라 자리한 그랜드뷰 캐니언은 로스트 리버 산맥의 아름다운 절경을 선사합니다. 이 산맥에는 아이다호에서 가장 높은 봉우리 9개가 있으며, 그랜드뷰 캐니언은 이 경관 도로의 하이라이트입니다."

	key[]: "landmark_id_mackay_rs_desc"
	val[]: "원래 모피 사냥꾼 티에리 고딘의 이름을 따서 고딘 강이라고 불렸던 빅 로스트 강은 용암 지대로 스며드는 것으로 유명합니다. 이렇게 \"사라진\" 물은 지하를 흐르다가 결국 스네이크 강 근처의 장엄한 사우전드 스프링스에서 다시 솟아납니다."

    key[]: "poi_id2_03"
	val[]: "맥케이의 유령 마을"

	key[]: "poi_id2_03_desc"
	val[]: "화이트놉 광산 지구의 \"마인 힐\"을 기반으로, 화이트놉과 클리프 크릭 같은 마을들은 20세기 중반까지 구리, 금, 은의 호황을 이끌었습니다. 이 지역들은 아이다호의 역사적인 광산업을 보여주는 중요한 유적지로 남아 있습니다."

	key[]: "id_cut_craters_desc"
	val[]: "약 15,000년 전 화산 폭발로 형성된 크레이터스 오브 더 문은 용암류와 화산재 언덕으로 이루어진 광활한 지형을 자랑합니다. 이국적이고 독특한 지형 덕분에 NASA 우주비행사들은 한때 이곳을 달 탐사 훈련 장소로 활용하기도 했습니다."



##########################################################################################

#@}



#+ Montana TBs and POIs localization.
#@{

    key[]: "tb_mt1"
	val[]: "빙하 통로"

	key[]: "tb_mt1_desc"
	val[]: "글레이셔 컨트리는 로키 산맥에서 마지막으로 남은 활성 빙하들의 고향입니다. 수천 년에 걸쳐 이 고대 빙하들은 깊은 계곡, 뾰족한 봉우리, 그리고 깨끗한 호수를 깎아내어 오늘날 서부 몬태나의 풍경을 만들어냈습니다."

	key[]: "poi_mt1_01"
	val[]: "쿠테나이 폭포"

	key[]: "poi_mt1_01_desc"
	val[]: "쿠트나이 폭포는 몬태나 주에서 댐이 없는 가장 큰 폭포이자 지역의 주요 관광 명소입니다. 쿠트나이 강은 짧은 구간에 걸쳐 약 300피트(90미터) 높이에서 떨어지며, 장엄하고 아름다운 폭포를 만들어내어 잊을 수 없는 경관을 선사하며 많은 방문객을 끌어들입니다."

	key[]: "poi_mt1_02"
	val[]: "베른 로드사이드 파크"

	key[]: "poi_mt1_02_desc"
	val[]: "배드 록 캐니언은 플랫헤드 강을 따라 여행하는 사람들에게 인기 있는 휴식처였으며, 낚시, 아름다운 경관, 그리고 한때 과열된 자동차 라디에이터를 식히는 데 사용되었던 천연 샘으로 유명했습니다. 1956년, 이곳은 몬태나 최초의 휴게소 중 하나인 베른 로드사이드 파크로 개장했습니다."

	key[]: "poi_mt1_03"
	val[]: "헤븐스 피크"

	key[]: "poi_mt1_03_desc"
	val[]: "글레이셔 국립공원의 가장 상징적인 산 중 하나인 헤븐스 피크는 1890년대에 탐사자 루이 마이어가 이름을 붙였습니다. 그 아름다움과 우뚝 솟은 정원 벽에 매료된 탐험가들은 그곳이 자신들이 여행 중에 마주했던 그 어떤 것과도 비교할 수 없는 특별한 풍경으로 여겼습니다."

	key[]: "mt_cut_glacier_national_park_desc"
	val[]: "‘대륙의 왕관’으로 불리는 글레이셔 국립공원은 1910년에 설립되었습니다. 고대 빙하에 의해 형성된 이곳은 1932년 ‘고잉 투 더 선 로드’가 완공되면서 더 넓게 개방되었으며, 이 도로는 현재 역사적인 공학 유적으로 남아 있습니다."

	key[]: "poi_mt1_04"
	val[]: "블랙피트 인디언 기념비"

	key[]: "poi_mt1_04_desc"
	val[]: "글레이셔 국립공원의 동쪽 끝자락에는 블랙피트 부족의 땅이 있습니다. \"평원의 전사들\"로 알려진 그들의 이름은 재로 검게 물든 모카신에서 유래했다고 여겨집니다. 오늘날에도 공원 내 여러 곳은 블랙피트 부족에게 신성한 장소로 남아 있습니다."

	key[]: "mt_cut_flathead_lake_desc"
	val[]: "플랫헤드 호수는 미국 본토에서 표면적이 가장 큰 자연 담수호입니다. 주변 산에서 녹는 물로 채워지는 이 호수는 매우 맑은 물을 자랑하며, 몇 년에 한 번씩 완전히 새로 채워지기 때문에 세계에서 가장 깨끗한 대형 호수 중 하나입니다."

	key[]: "mt_cut_thompson_falls_desc"
	val[]: "영국계 캐나다인 모피 상인이자 지도 제작자인 데이비드 톰슨의 이름을 따서 지어진 이 마을은 1881년 철도가 개통된 후 성장했습니다. 인근 코어달렌 금광 붐이 일면서 머레이 트레일을 따라 향하는 광부들의 주요 경유지가 되었고, 마을은 더욱 확장되었습니다."

	key[]: "landmark_mt_missoula_desc"
	val[]: "1910년 A. J. 깁슨이 설계하고 사암으로 지어진 신고전주의 양식의 미줄라 카운티 법원 건물은 이전에 있던 더 작은 건물을 대체했습니다. 1860년에 설립된 미줄라 카운티는 몬태나 주에서 가장 오래된 행정 구역 중 하나로, 비터루트 산맥에서 로키 산맥까지 펼쳐져 있습니다."

    key[]: "poi_mt1_05"
	val[]: "롤로 크릭"

	key[]: "poi_mt1_05_desc"
	val[]: "롤로와 롤로 패스 사이의 회랑은 롤로 크릭을 따라 이어지는 역사적인 길을 따라갑니다. 네즈 퍼스족, 초기 정착민, 그리고 루이스와 클라크 탐험대가 지나다녔던 이 길은 여러 해설 시설이 있는 중요한 문화적, 역사적 경관으로 남아 있습니다."

##########################################################################################

    key[]: "tb_mt2"
	val[]: "대평원"

	key[]: "tb_mt2_desc"
	val[]: "몬태나 주의 대평원은 주 동부를 가로지르며 광활한 초원과 완만한 구릉지대, 드넓은 하늘이 특징입니다. 이 지역은 북미에서 가장 중요한 공룡 화석들을 발굴해냈으며, 수백만 년 전의 풍경을 엿볼 수 있게 해줍니다."

	key[]: "poi_mt2_01"
	val[]: "헬 크릭 지층"

	key[]: "poi_mt2_01_desc"
	val[]: "몬태나주 조던 인근 헬 크릭을 따라 형성된 헬 크릭 지층은 고대 아열대 강, 숲, 늪지대의 경관을 고스란히 간직하고 있습니다. 약 6700만 년에서 6600만 년 전으로 거슬러 올라가는 이 지층은 상징적인 티라노사우루스 렉스를 비롯한 풍부한 공룡 화석으로 세계적으로 유명합니다."

	key[]: "poi_mt2_02"
	val[]: "옐로스톤 강"

	key[]: "poi_mt2_02_desc"
	val[]: "옐로스톤 강은 미국 본토에서 가장 긴 자연 그대로 흐르는 강입니다. 옐로스톤 국립공원에서 발원하여 와이오밍과 몬태나를 거쳐 미주리 강과 합류하기까지 676마일을 흐르며, 전체 구간에 걸쳐 댐이 하나도 없습니다."

	key[]: "poi_mt2_03"
	val[]: "글렌디사우루스"

	key[]: "poi_mt2_03_desc"
	val[]: "글렌다이브에 있는 실물 크기의 트리케라톱스 조형물인 글렌디사우루스는 이 지역의 풍부한 공룡 유산을 기념합니다. 약 3미터 높이의 이 조형물은 공룡 트레일의 인기 있는 랜드마크 역할을 합니다."
	
	key[]: "poi_mt2_04"
	val[]: "미주리 강"

	key[]: "poi_mt2_04_desc"
	val[]: "'거대한 진흙탕'으로 알려진 미주리 강은 미국에서 가장 긴 강입니다. 몬태나 주의 로키 산맥에서 발원하여 미시시피 강까지 2,341마일(약 3,760km)을 흐르는 이 강은 탐험, 무역, 그리고 미국 서부 개척 시대에 중요한 역할을 했습니다."

	key[]: "mt_cut_fort_peck_spillway_desc"
	val[]: "대공황 시기에 건설된 포트펙 댐은 세계 최대 규모의 수압식 흙댐입니다. 미국의 최대 공공사업 중 하나로 완공된 이 댐은 일자리 창출, 홍수 조절, 수력 발전 등의 목적으로 설계되었습니다."

    key[]: "poi_mt2_05"
	val[]: "밸리 카운티 개척자 박물관"

	key[]: "poi_mt2_05_desc"
	val[]: "이 박물관은 아시니보인족, 철도, 농업, 포트펙 댐, 루이스와 클라크 탐험대 등 북동부 몬태나 지역의 역사를 보여주는 전시물을 소장하고 있습니다. 또한 방대한 기록 보관소와 미국 최대 규모의 아시니보인 유물 컬렉션 중 하나를 보유하고 있습니다."

	key[]: "poi_mt2_06"
	val[]: "잠자는 버팔로 바위"

	key[]: "poi_mt2_06_desc"
	val[]: "이 거대한 빙하 바위들은 원주민 부족들에게 신성한 랜드마크였습니다. 고대 빙하가 이 바위들을 깎고 운반해 왔습니다. 작은 바위인 \"버팔로 바위\"는 물소를 닮도록 조각되었고, 더 큰 바위인 \"메디신 바위\"에는 다양한 암각화가 새겨져 있습니다."



##########################################################################################

#@}



#+ Wyoming TBs and POIs localization.
#@{

    key[]: "tb_wy1"
	val[]: "버팔로 트레일"

	key[]: "tb_wy1_desc"
	val[]: "옐로스톤 국립공원과 그랜드 티턴 국립공원이 있는 이곳은 활발한 화산 활동으로 인해 간헐천과 온천이 솟아나는 곳이며, 빙하와 단층은 산봉우리와 계곡을 형성해 왔습니다. 이러한 자연의 힘이 어우러져 와이오밍 북서부는 미국 서부에서 가장 지질학적으로 역동적이고 시각적으로 상징적인 경관을 자랑하는 지역 중 하나가 되었습니다."

	key[]: "landmark_wy_yellowsto_desc"
	val[]: "1872년 세계 최초의 국립공원으로 지정된 옐로스톤은 거대한 휴화산 꼭대기에 자리 잡고 있습니다. 전 세계 활화산의 절반가량이 위치한 이곳은 지구상에서 가장 크고 온전하게 보존된 온대 생태계 중 하나를 보호하고 있기도 합니다."

	key[]: "poi_wy1_01"
	val[]: "하부 간헐천 분지"

	key[]: "poi_wy1_01_desc"
	val[]: "로어 가이저 분지는 옐로스톤에서 가장 큰 간헐천 분지로, 수많은 간헐천, 온천, 증기 분출구가 밀집되어 있습니다. 지하 깊은 곳의 마그마에서 솟아나는 열에 힘입어 활발한 활동을 보이는 이곳은 공원에서 가장 활발한 지열 지대 중 하나입니다."

	key[]: "poi_wy1_02"
	val[]: "옐로스톤 호수"

	key[]: "poi_wy1_02_desc"
	val[]: "옐로스톤 호수는 북아메리카에서 가장 큰 고지대 호수이며, 대륙에서 가장 많은 야생 커트스로트 송어 개체군을 유지하고 있습니다. 과학자들은 이 강이 한때 태평양 쪽으로 물이 흘러들어 대륙 분수령을 통과하는 투 오션 패스를 통해 물고기들이 건널 수 있었다고 믿고 있습니다."
	
	key[]: "poi_wy1_03"
	val[]: "버팔로 빌 댐"

	key[]: "poi_wy1_03_desc"
	val[]: "1910년에 완공된 버팔로 빌 댐은 미국에서 처음으로 건설된 콘크리트 아치형 댐 중 하나였습니다. 높이 325피트에 달하는 이 댐은 당시 세계에서 가장 높은 댐이었으며, 초기 공학 혁신의 상징이 되었습니다."

	key[]: "poi_wy1_04"
	val[]: "콜터스 헬"

	key[]: "poi_wy1_04_desc"
	val[]: "콜터스 헬은 쇼쇼니 강을 따라 위치한 유서 깊은 지열 지대로, 1807년 탐험가 존 콜터가 이름을 붙였습니다. 초기 산악인들은 이곳의 김이 솟구치는 분출구와 유황 냄새를 \"지옥\"에 비유했습니다. 오늘날에는 온천과 증기 분출구만이 활동을 이어가고 있습니다."

	key[]: "wy_cut_grand_teton_desc"
	val[]: "그랜드 티턴 국립공원은 잭슨 홀 위로 솟아오른 빙하 침식 봉우리들이 특징입니다. 한때 모피 사냥꾼들이 평원 너머로 잘 보이는 봉우리들을 가리켜 \"파일럿 노브\"라고 불렀던 이 산들은 오늘날까지 미국 서부의 가장 상징적인 랜드마크 중 하나로 남아 있습니다."

	key[]: "poi_wy1_05"
	val[]: "크로하트 뷰트"

	key[]: "poi_wy1_05_desc"
	val[]: "크로하트 뷰트는 1866년 쇼쇼니족과 크로우족 간의 전투에서 이름을 따온 유명한 지형지물입니다. 전승에 따르면, 쇼쇼니족이 승리한 후 워샤키 추장이 크로우족 추장의 심장을 경고의 의미로 뷰트 꼭대기에 올려놓았고, 이로 인해 이 지형이 오늘날까지 전해 내려오는 이름이 되었다고 합니다."

##########################################################################################

    key[]: "tb_wy2"
	val[]: "붉은 사막"

	key[]: "tb_wy2_desc"
	val[]: "와이오밍 주의 붉은 사막은 바람에 의해 조각된 모래, 쑥이 무성한 평원, 그리고 눈에 띄는 붉은 암석 지형으로 이루어진 광활한 고원 사막 분지입니다. 북미에서 가장 넓은 무인 지역 중 하나인 이곳은 극한의 기후, 고대 호수 바닥, 그리고 긴 이동 경로에 의해 형성되었습니다."

	key[]: "poi_wy2_01"
	val[]: "레드 캐니언"

	key[]: "poi_wy2_01_desc"
	val[]: "레드 캐니언은 약 6천만 년 전 윈드 리버 산맥의 융기 과정에서 형성되었습니다. 이곳의 독특한 붉은 절벽은 산화철이 함유된 추그워터 암석으로 이루어져 있으며, 이 암석에서 추출한 선명한 붉은색이 캐니언의 이름이 유래되었습니다."

	key[]: "poi_wy2_02"
	val[]: "풍경의 힘"

	key[]: "poi_wy2_02_desc"
	val[]: "와이오밍의 붉은 사막 위로 400피트 이상 솟아오른 화산암 지형인 보어스 터스크는 수백만 년 전에 형성된 화산의 침식된 핵심 부분입니다. 이곳은 북미에서 가장 큰 활동 중인 사구 지대의 일부인 광활한 킬피커 사구를 내려다보고 있습니다."

	key[]: "poi_wy2_03"
	val[]: "록 스프링스"

	key[]: "poi_wy2_03_desc"
	val[]: "록 스프링스는 다양한 이민자 유산으로 인해 '56개 민족의 도시'로 알려져 있습니다. 1800년대 후반에 전 세계에서 사람들이 유니언 퍼시픽 석탄 광산에서 일하기 위해 도착했습니다. 이 도시는 또한 유명한 무법자 버치 캐시디와도 관련이 있습니다."
	
	key[]: "poi_wy2_04"
	val[]: "부치 캐시디 캐빈"

	key[]: "poi_wy2_04_desc"
	val[]: "부치 캐시디는 미국 서부 개척 시대에 열차와 은행 강도로 악명 높았던 '와일드 번치' 갱단을 이끈 유명한 무법자였습니다. 그는 록 스프링스의 정육점에서 일하면서 '부치'라는 별명을 얻었습니다. 그의 가장 전설적이고 영향력 있는 강도 행각은 1899년에 발생한 윌콕스 열차 강도 사건입니다."

	key[]: "wy_cut_evanston_desc"
	val[]: "1869년 유니언 퍼시픽 철도 회사에 의해 설립된 에번스턴은 측량사 제임스 A. 에반스의 이름을 따서 명명되었습니다. 이 도시는 철도 중심지로 성장했으며, 이후 농업, 석유 및 가스 산업의 지역 중심지가 되었습니다."

    key[]: "poi_wy2_05"
	val[]: "랜더 컷오프"

	key[]: "poi_wy2_05_desc"
	val[]: "1857년 태평양 마차길법 제정 이후 건설된 랜더 지름길은 미국 서부에서 연방 정부의 자금 지원으로 건설된 최초의 마차길 중 하나였습니다. 엔지니어 프레더릭 W. 랜더의 이름을 딴 이 길은 서쪽으로 향하는 이주민들에게 더 짧은 경로를 제공했습니다."

	

##########################################################################################

#@}


#+ South Dakota TBs and POIs localization.
#@{

    key[]: "tb_sd1"
	val[]: "블랙힐스"

	key[]: "tb_sd1_desc"
	val[]: "사우스다코타주 서부는 블랙힐스와 배드랜드로 대표됩니다. 광활한 초원이 소나무 숲으로 뒤덮인 산과 화강암 봉우리, 그리고 들소 떼의 서식지로 펼쳐집니다. 그 너머에는 수백만 년 동안 바람과 물에 의해 조각된, 경이로운 배드랜드의 풍경이 자리하고 있습니다."

	key[]: "poi_sd1_01"
	val[]: "블랙힐스 국유림"

	key[]: "poi_sd1_01_desc"
	val[]: "라코타족에게는 \"검은 언덕들\"이라는 뜻의 파하 사파로 알려진 이 소나무 숲 지역에는 사우스다코타주에서 가장 높은 봉우리인 블랙 엘크 피크 해발 7,244피트가 있습니다. 유명한 라코타족 치유사를 기리기 위해 이름이 바뀐 이 봉우리는 로키산맥 동쪽에서 가장 높은 산봉우리이기도 합니다."

	key[]: "sd_cut_rush_desc"
	val[]: "미국의 \"민주주의 성지\"로 알려진 러시모어 산은 1927년부터 1941년까지 블랙힐스 산맥에 조각되었습니다. 이 기념비는 워싱턴, 제퍼슨, 루즈벨트, 링컨 대통령의 60피트 높이 조각상으로 이루어져 있으며, 미국의 탄생, 성장, 발전 및 보존을 상징합니다."

	key[]: "poi_sd1_02"
	val[]: "비버 크릭 다리"

	key[]: "poi_sd1_02_desc"
	val[]: "1929년에 건설된 이 길이 225피트(70미터)의 철골 및 콘크리트 아치형 다리는 윈드 케이브 국립공원 근처의 협곡을 가로지릅니다. 협곡 바닥에서 115피트(35미터) 높이로 솟아 있는 이 다리는 사우스다코타 주에서 유일한 아치형 다리이며 주변 암석과 완벽하게 조화를 이루도록 설계되었습니다."

	key[]: "sd_cut_sturgis_desc"
	val[]: "스터지스는 세계 최대 규모의 오토바이 축제를 개최하는 곳으로 유명합니다. 1938년 지역 인디언 모터사이클 딜러인 파피 호엘이 시작한 이 연례 10일 행사는 전 세계의 라이더들을 블랙힐스로 불러모아 모터사이클 쇼, 경주, 음악, 축제를 즐깁니다."

	key[]: "sd_cut_deadwood_desc"
	val[]: "데드우드는 1876년 블랙힐스 금광 열풍 당시 형성되어 서부 개척 시대에서 가장 악명 높은 도시 중 하나가 되었습니다. 1961년 국립 사적지로 지정된 이곳은 미국에서 유일하게 이러한 지위를 가진 도시로, 역사적인 도심의 모습을 상당 부분 보존하고 있습니다."

	key[]: "sd_cut_badlands_desc"
	val[]: "배드랜드 국립공원은 244,000에이커에 달하는 광활한 지역에 솟아오른 뾰족한 봉우리와 뾰족한 암석들이 펼쳐져 있으며, 미국에서 가장 넓은 면적의 보호된 혼합 초원 지대를 품고 있습니다. 또한 세계에서 가장 풍부한 화석층 중 하나를 보존하고 있어 한때 대평원을 누비던 고대 포유류의 화석을 찾아볼 수 있습니다."

	key[]: "poi_sd1_03"
	val[]: "도안 로빈슨 터널"

	key[]: "poi_sd1_03_desc"
	val[]: "'러시모어 산의 아버지'로 알려진 도안 로빈슨은 사우스다코타를 찾는 관광객을 유치하기 위해 블랙힐스에 웅장한 기념비를 세우는 것을 구상했습니다. 오늘날 그의 유산은 아름다운 도안 로빈슨 터널을 통해 완벽하게 드러나는 러시모어 산의 모습으로 이어지고 있습니다."

	key[]: "sd_cut_hot_springs_desc"
	val[]: "원래 수족이 \"뜨거운 물\"을 뜻하는 미네카타라고 불렀던 핫스프링스는 치유력이 있다고 믿어지는 광천수 주변에 1879년 정착촌이 형성되었습니다. 1882년에 현재의 이름으로 개명된 이곳은 건강 휴양지로 발전했으며, 유서 깊은 에반스 플런지로 유명합니다."

	key[]: "poi_sd1_04"
	val[]: "매머드 유적지"

	key[]: "poi_sd1_04_desc"
	val[]: "매머드 유적지는 세계적으로 유명한 빙하기 화석 발굴지로, 이곳에서는 61마리의 매머드 화석이 발굴되었습니다. 1974년에 발견된 이 고대 싱크홀은 북미에서 가장 많은 콜럼비아 매머드 화석을 보존하고 있으며, 현재까지도 발굴 작업이 진행 중입니다."

##########################################################################################

    key[]: "tb_sd2"
	val[]: "더 그레이트 디바이드"

	key[]: "tb_sd2_desc"
	val[]: "사우스다코타주의 미주리 강 유역은 주의 중앙을 가르는 경계선으로, 한쪽에는 광활한 평야가, 다른 한쪽에는 완만한 구릉이 펼쳐져 있습니다. 이곳은 원주민 부족, 모피 상인, 그리고 루이스와 클라크 탐험대에게 중요한 통로였으며, 이후에는 주요 댐, 개척 도시, 그리고 풍부한 강 역사를 간직한 지역이 되었습니다."

	key[]: "poi_sd2_01"
	val[]: "오대호"

	key[]: "poi_sd2_01_desc"
	val[]: "1940년대 후반 미주리 강에 댐을 건설하여 만들어진 오아헤 호수, 샤프 호수, 프랜시스 케이스 호수, 루이스 앤 클라크 호수는 현재 사우스다코타 주 중부를 규정짓는 호수들입니다. 이 저수지들은 모두 합쳐 440마일이 넘는 해안선을 제공하여 보트 타기, 낚시, 레크리에이션 활동을 즐길 수 있게 해줍니다."

	key[]: "poi_sd2_02"
	val[]: "뱅고어의 유령 도시"

	key[]: "poi_sd2_02_desc"
	val[]: "뱅고어는 한때 월워스 카운티의 군청 소재지였지만, 1899년 건물들이 인근 셀비로 이전된 후 유령 도시가 되었습니다. 오늘날에는 마을이 있던 자리에 기념비 하나만이 남아 있습니다."

	key[]: "landmark_sd_state_capitol_desc"
	val[]: "1880년에 설립된 피에르는 1889년 사우스다코타주가 미연방에 가입하면서 주도가 되었습니다. 지리적으로 중심부에 위치하고 미주리 강을 건너는 지점이라는 장점 때문에 선정된 이 도시는 프랑스계 미국인 모피 상인 피에르 슈토 주니어의 이름을 따서 명명되었습니다."

	key[]: "sd_cut_corn_desc"
	val[]: "미첼에 있는 콘 팰리스는 세계에서 유일하게 전체가 옥수수로 장식된 궁전입니다. 매년 지역 예술가와 농부들이 천연색의 옥수수, 곡물, 풀을 사용하여 새로운 벽화를 만들어 사우스다코타에서 가장 독특한 랜드마크 중 하나로 자리매김하고 있습니다."

	key[]: "landmark_sd_largest_pheasant_desc"
	val[]: "휴런에는 세계에서 가장 큰 꿩 조형물이 있습니다. 1959년에 제작된 이 조형물은 높이 40피트(약 12미터)의 유리섬유와 강철로 만들어졌으며, 무게는 22톤에 달합니다. 이 조형물은 미국 최고의 꿩 사냥 명소 중 하나로 오랫동안 명성을 떨쳐온 이 지역의 위상을 보여줍니다."

	key[]: "landmark_sd_dignity_of_earth_and_sky_desc"
	val[]: "'대지와 하늘의 존엄성'은 체임벌린 인근 미주리 강변에 세워진 높이 50피트의 스테인리스 스틸 조각 작품입니다. 데일 램피어 작가가 제작한 이 작품은 라코타족과 다코타족의 유산, 회복력, 그리고 문화를 기리는 의미를 담고 있습니다."

##########################################################################################

#@}
