#+ Text deviations for American Truck Simulator. Please, use only terms appropriate for USA (i.e. culture specific nuances, not American English).
#@{

#+ Music/radio player
#@{

#+ Hint shown if no music files are found. Also shown as tooltip when hovering over music_player button.

	key[]: "music_player_hint"
	val[]: "<color value=@@clr_sel@@>내 문서<color value=@@clr_txt@@>의 <color value=@@clr_sel@@>American Truck Simulator/music <color value=@@clr_txt@@>폴더에 음악 파일을 넣으면 이곳에 표시됩니다."

#+ Tooltip shown when hovering over the radio_stream button.

	key[]: "radio_hint"
	val[]: "<color value=@@clr_sel@@>내 문서<color value=@@clr_txt@@>의 <color value=@@clr_sel@@>American Truck Simulator <color value=@@clr_txt@@>폴더에 있는 <color value=@@clr_sel@@>live_streams.sii <color value=@@clr_txt@@>파일을 수정하면 게임 안에서 당신이 좋아하는 인터넷 라디오 방송을 들을 수 있습니다!"

#+ Hint shown if no online radio streams are defined.

	key[]: "empty_radio_hint"
	val[]: "<color value=@@clr_sel@@>내 문서<color value=@@clr_txt@@>의 <color value=@@clr_sel@@>American Truck Simulator <color value=@@clr_txt@@>폴더에 있는 <color value=@@clr_sel@@>readme.rtf <color value=@@clr_txt@@>문서 파일에 음악과 라디오를 추가하는 방법이 설명되어있습니다."
#@}

#+ Messages shown as part of the tutorial.
