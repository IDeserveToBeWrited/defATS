    key[]: "hint_world_map_text"
    val[]: "월드 맵을 열려면 $KEY_navmap$을(를) 사용하십시오."


    key[]: "hint_pause_title"
    val[]: "@@quick_info_word@@"

    key[]: "hint_pause_text"
    val[]: "$KEY_advmouse$ 키를 눌러 @@quick_info_word@@를 열면 편리한 단축키로 현재 상태를 한눈에 볼 수 있습니다."


    key[]: "hint_pause_border_title"
    val[]: "현지 규정"

    key[]: "hint_pause_border_text"
    val[]: "$KEY_advmouse$을(를) 사용하여 @@quick_info_word@@를 열고 접속한 지역에 대한 현지 규정을 확인하십시오."


    key[]: "hint_photo_trophy_title"
    val[]: "@@landmark_word@@"

    key[]: "hint_photo_trophy_text"
    val[]: "$KEY_advmouse$를 사용하여 @@quick_info_word@@를 열고 @@photo_mode_word@@로 들어가 근처의 @@landmark_word@@를 캡처하십시오. <img src=/material/ui/map/photo_sight_not_captured.mat width=20 height=20>."


    key[]: "hint_viewpoint_title"
    val[]: "@@viewpoint_title@@ 근처"

    key[]: "hint_viewpoint_text"
    val[]: "@@viewpoint_title@@ <img src=/material/ui/map/viewpoint_unseen.mat width=20 height=20> 근처에 있으니 찾아서 활성화하면 컷신을 볼 수 있습니다."


    key[]: "hint_resting_title"
    val[]: "근처 휴식 공간"

    key[]: "hint_resting_text"
    val[]: "휴식 공간 <img src=/material/ui/map/parking_ico.mat width=20 height=20>은 피로를 회복하고 의무 휴식을 취하여 안전하게 여정을 계속할 수 있도록 도와줍니다."


    key[]: "hint_gas_title"
    val[]: "근처 주유소"

    key[]: "hint_gas_text"
    val[]: "주유소 <img src=/material/ui/map/gas_ico.mat width=20 height=20> 차량에 주유하는 데 사용할 수 있습니다."


    key[]: "hint_car_job_title"
    val[]: "첫 번째 커리어 작업"

    key[]: "hint_car_job_text"
    val[]: "배송을 완료하세요 - 안전 운전하고, 화물을 잘 관리하고, 약속된 시간에 도착하세요. 고객 우선순위는 평점과 보상에 영향을 미치므로 유의하세요.<br><offset vshift=8>$KEY_advmouse$를 눌러 작업 세부 정보를 확인하세요."


    key[]: "hint_tour_board_title"
    val[]: "관광 안내판"

    key[]: "hint_tour_board_text"
    val[]: "관광 안내판이 근처에 있습니다. 활성화하면 <color value=@@clr_sel@@>@@tourist_atlas_link@@</color>의 콘텐츠를 잠금 해제하여 인근 명소와 관심 지점을 탐색할 수 있습니다."


    key[]: "hint_tb_first_title"
    val[]: "첫 번째 탐험 장소"

    key[]: "hint_tb_first_text"
    val[]: "지역 관광 안내판의 첫 번째 위치를 둘러보셨습니다. 자세한 내용은 <color value=@@clr_sel@@>@@tourist_atlas_link@@</color>에서 확인하실 수 있습니다. 모든 위치를 둘러보고 더 많은 정보를 얻고 보상을 받으세요."


    key[]: "hint_tb_bef_compl_title"
    val[]: "한 곳 남았습니다"

    key[]: "hint_tb_bef_compl_text"
    val[]: "첫 번째 지역 관광 안내판을 완전히 탐험하고 엽서를 받기 전에 단 한 곳만 남습니다."


    key[]: "hint_tb_done_title"
    val[]: "관광 안내판 탐색됨"

    key[]: "hint_tb_done_text"
    val[]: "지역 관광 안내판의 모든 지점을 성공적으로 둘러보셨습니다. 자세한 정보는 <color value=@@clr_sel@@>@@tourist_atlas_link@@</color>에서 확인하실 수 있습니다. 보상으로, 이제 차량에 엽서를 전시할 수 있습니다."


    key[]: "hint_vehicle_prio_title"
    val[]: "고객 우선 - 차량 상태"

    key[]: "hint_vehicle_prio_text"
    val[]: "고객님께서는 차량 상태를 매우 중요하게 생각하십니다. 도착하시는 차량의 상태에 따라 보너스 보상 또는 벌점이 크게 달라질 수 있습니다. 안전 운전하시고 차량을 잘 관리해 주십시오.<br><offset vshift=8>$KEY_advmouse$를 눌러 작업 세부 정보를 확인하세요."


    key[]: "hint_cargo_prio_title"
    val[]: "고객 우선 - 화물 처리"

    key[]: "hint_cargo_prio_text"
    val[]: "고객은 화물 취급에 높은 우선순위를 두고 있습니다. 배송하는 화물의 상태에 따라 보너스 보상 또는 벌점이 크게 영향을 받을 수 있습니다. 안전 운전하시고 화물을 잘 관리해 주십시오.<br><offset vshift=8>작업 세부 정보를 보려면 $KEY_advmouse$를 누르십시오."


    key[]: "hint_time_prio_title"
    val[]: "고객 우선 - 시간 관리"

    key[]: "hint_time_prio_text"
    val[]: "고객은 시간 관리를 매우 중요하게 생각합니다. 시간 엄수 여부에 따라 보너스 또는 벌점이 크게 달라질 수 있습니다. 안전 운전하시고 고객이 기대하는 시간에 도착하십시오.<br><offset vshift=8>작업 세부 정보를 보려면 $KEY_advmouse$를 누르십시오."


    key[]: "hint_car_deliv_title"
    val[]: "목적지에 접근하기"

    key[]: "hint_car_deliv_text"
    val[]: "표시된 구역에 정차하여 배송을 완료하십시오."


    key[]: "hint_car_early_title"
	val[]: "조기 도착"

    key[]: "hint_car_early_text"
    val[]: "배송은 특정 시간에 도착할 것으로 예상되며, 일찍 도착하면 고객 불만으로 이어질 것입니다. 이동 경로를 계획하고 필요하면 이용 가능한 휴식 장소를 이용하세요."


#!{
    key[]: "hint_sm_throttle_title"
	val[]: "@@throttle_double_tap@@"
#!}

    key[]: "hint_sm_throttle_text"
    val[]: "@@desktop_menu_category_options@@에서 스마트 가속 페달 제어를 활성화할 수 있습니다. 이 기능을 활성화하면 차량은 기본적으로 가속 페달을 더 낮게 유지합니다. 가속 페달 버튼을 빠르게 두 번 누른 후, 버튼에서 손을 뗄 때까지 차량은 전속력으로 유지됩니다."
