#+ Text deviations for American Truck Simulator. Please, use only terms appropriate for USA (i.e. culture specific nuances, not American English).
#@{

#+ Music/radio player
#@{

#+ Hint shown if no music files are found. Also shown as tooltip when hovering over music_player button.

	key[]: "music_player_hint"
	val[]: "Copiaţi fişierele audio în directorul <color value=@@clr_sel@@>American Truck Simulator/music <color value=@@clr_txt@@>din <color value=@@clr_sel@@>My Documents <color value=@@clr_txt@@>pentru a le putea accesa aici."

#+ Tooltip shown when hovering over the radio_stream button.

	key[]: "radio_hint"
	val[]: "Editaţi <color value=@@clr_sel@@>live_streams.sii <color value=@@clr_txt@@>în directorul <color value=@@clr_sel@@>American Truck Simulator <color value=@@clr_txt@@>din <color value=@@clr_sel@@>My Documents <color value=@@clr_txt@@>pentru a asculta stream-urile radio preferate, în timp ce jucaţi!"

#+ Hint shown if no online radio streams are defined.

	key[]: "empty_radio_hint"
	val[]: "Vă rugăm să studiaţi fişierul <color value=@@clr_sel@@>readme.rtf <color value=@@clr_txt@@>în directorul <color value=@@clr_sel@@>American Truck Simulator <color value=@@clr_txt@@>din directorul <color value=@@clr_sel@@>My Documents <color value=@@clr_txt@@>, pentru mai multe detalii legate de adăugarea propriilor melodii sau stream-uri radio."
#@}

