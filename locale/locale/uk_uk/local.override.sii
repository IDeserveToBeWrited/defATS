#+ Text deviations for American Truck Simulator. Please, use only terms appropriate for USA (i.e. culture specific nuances, not American English).
#@{

#+ Music/radio player
#@{

#+ Hint shown if no music files are found. Also shown as tooltip when hovering over music_player button.

	key[]: "music_player_hint"
	val[]: "Скопіюйте Вашу музику у папку <color value=@@clr_sel@@>American Truck Simulator/music <color value=@@clr_txt@@>у Ваших <color value=@@clr_sel@@>Документах, <color value=@@clr_txt@@>і Ви побачите їх тут."

#+ Tooltip shown when hovering over the radio_stream button.

	key[]: "radio_hint"
	val[]: "Відредагуйте <color value=@@clr_sel@@>live_streams.sii <color value=@@clr_txt@@>у папці <color value=@@clr_sel@@>American Truck Simulator <color value=@@clr_txt@@>у Ваших <color value=@@clr_sel@@>Документах <color value=@@clr_txt@@>і слухайте улюблені онлайн-радіостанції за кермом!"

#+ Hint shown if no online radio streams are defined.

	key[]: "empty_radio_hint"
	val[]: "Будь ласка, зверніться до <color value=@@clr_sel@@>readme.rtf <color value=@@clr_txt@@>у папці<color value=@@clr_sel@@>American Truck Simulator <color value=@@clr_txt@@>у Ваших <color value=@@clr_sel@@>Документах <color value=@@clr_txt@@>за інформацією про те, як додати Вашу власну музику та онлайн-радіо."
#@}

