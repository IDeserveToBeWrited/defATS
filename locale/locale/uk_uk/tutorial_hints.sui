
    key[]: "hint_engine_title"
	val[]: "Запуск двигуна"

    key[]: "hint_engine_text"
	val[]: "Щоб запустити двигун, використовуйте $KEY_engine$."


    key[]: "hint_ignition_title"
	val[]: "Увімкнення запалювання"

    key[]: "hint_ignition_text"
	val[]: "Щоб увімкнути запалювання, використовуйте $KEY_engineelect|KEY_engine$."


    key[]: "hint_driv_arc_title"
	val[]: "Рух"

    key[]: "hint_driv_arc_text"
	val[]: "Використовуйте $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ та $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ для руху вперед та назад.<br><offset vshift=8>Для кермування, використовуйте $SPECIAL_steering$."


    key[]: "hint_driv_auto_title"
	val[]: "Рух"

    key[]: "hint_driv_auto_text"
	val[]: "Використовуйте $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ та $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ для руху вперед та назад.<br><offset vshift=8>Для кермування, використовуйте $SPECIAL_steering$.<br><offset vshift=8>Натискайте $KEY_gearup$ та $KEY_geardown$ для вибору передачі."


    key[]: "hint_driv_seq_title"
	val[]: "Рух"

    key[]: "hint_driv_seq_text"
	val[]: "Використовуйте $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ та $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ для руху вперед та назад.<br><offset vshift=8>Для кермування, використовуйте $SPECIAL_steering$.<br><offset vshift=8>Натискайте $KEY_gearup$ та $KEY_geardown$ для керування зчепленням."


    key[]: "hint_driv_hshift_title"
	val[]: "Рух"

    key[]: "hint_driv_hshift_text"
	val[]: "Використовуйте $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ та $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ для руху вперед та назад.<br><offset vshift=8>Для кермування, використовуйте $SPECIAL_steering$.<br><offset vshift=8>Перемикайте передачі за допомогою <color value=@@clr_sel@@>важеля<color value=@@clr_txt@@>."


    key[]: "hint_depot_deliv_title"
    val[]: "Наближення до точки призначення"

    key[]: "hint_depot_deliv_text"
    val[]: "Зупиніться в позначеній зоні, щоб обрати складність паркування та відповідно очки досвіду."


    key[]: "hint_fin_deliv_title"
    val[]: "Закінчення перевезення"

    key[]: "hint_fin_deliv_text"
    val[]: "Зупиніться на обраному місці. Пропустити паркування можна натисканням $KEY_activate$ поблизу пункту призначення."


    key[]: "hint_fin_deliv2_title"
    val[]: "Закінчення перевезення"

    key[]: "hint_fin_deliv2_text"
    val[]: "Зупиніться на обраному місці. В меню @@desktop_menu_category_options@@ можна ввімкнути віджет, який дозволяє пропускати паркування."


    key[]: "hint_lights_title"
    val[]: "Увімкніть ліхтарі"

    key[]: "hint_lights_text"
    val[]: "Натисніть $KEY_light$, щоб увімкнути ліхтарі. Натискайте повторно, щоб перемикати режим."


    key[]: "hint_high_beam_title"
    val[]: "Увімкніть дальнє світло"

    key[]: "hint_high_beam_text"
    val[]: "Щоб увімкнути дальнє світло фар, натисніть $KEY_hblight$."


    key[]: "hint_wipers_title"
    val[]: "Увімкніть склоочисники"

    key[]: "hint_wipers_text"
    val[]: "Натисніть $KEY_wipers$, щоб увімкнути склоочисники. Регулюйте швидкість повторними натисканнями."


    key[]: "hint_zoom_title"
    val[]: "Зближення"

    key[]: "hint_zoom_text"
    val[]: "Використовуйте $KEY_camzoom$ для зближення всередині автомобіля. Режим роботи кнопки можна налаштувати в @@desktop_menu_category_options@@."


    key[]: "hint_cam_int_title"
    val[]: "Огляд довкола"

    key[]: "hint_cam_int_text"
    val[]: "Використовуйте $KEY_cam1$, щоб перемикатися на вид зсередини."


    key[]: "hint_cam_ext_title"
    val[]: "Огляд довкола"

    key[]: "hint_cam_ext_text"
    val[]: "Щоб перемикатися між кутами огляду, натискайте $KEY_camcycle$.<br><offset vshift=8>Щоб увімкнути вид ззовні, натисніть $KEY_cam2$."


    key[]: "hint_indicators_title"
    val[]: "Покажчики поворотів"

    key[]: "hint_indicators_text"
    val[]: "Щоб вмикати покажчики поворотів, використовуйте $KEY_lblinker$ та $KEY_rblinker$."


    key[]: "hint_tow_title"
    val[]: "Евакуатор"

    key[]: "hint_tow_text"
    val[]: "Якщо ви не можете знайти вихід зі складної ситуації, варто викликати евакуатор. Для цього відкрийте меню @@quick_info_word@@ за допомогою $KEY_advmouse$."


    key[]: "hint_diff_lock_title"
    val[]: "Блокування диференціалу"

    key[]: "hint_diff_lock_text"
    val[]: "Якщо ви застрягли, блокування диференціалу може допомогти виїхати. Скористайтеся $KEY_diflock$, щоб активувати блокування, або увімкніть автоматичне блокування в меню @@desktop_menu_category_options@@."


    key[]: "hint_diff_unlock_title"
    val[]: "Ввімкнено блокування диференціалу"

    key[]: "hint_diff_unlock_text"
    val[]: "Диференціал слід розблокувати під час руху, інакше існує ризик його пошкодити. Щоб розблокувати, використовуйте $KEY_diflock$; або ввімкніть автоматичне блокування в меню @@desktop_menu_category_options@@."


    key[]: "hint_wipers_off_title"
    val[]: "Вимкніть склоочисники"

    key[]: "hint_wipers_off_text"
    val[]: "Користуйтеся $KEY_wipers$, щоб вимикати склоочисники або змінювати режим їх роботи."


    key[]: "hint_world_map_title"
    val[]: "Карта"

    key[]: "hint_world_map_text"
    val[]: "Щоб відкрити карту, натисніть $KEY_navmap$."


    key[]: "hint_pause_title"
    val[]: "@@quick_info_word@@"

    key[]: "hint_pause_text"
    val[]: "Використовуйте $KEY_advmouse$, щоб відкрити @@quick_info_word@@ – огляд ситуації та швидкий доступ."


    key[]: "hint_pause_border_title"
    val[]: "Місцеві правила"

    key[]: "hint_pause_border_text"
    val[]: "Використовуйте $KEY_advmouse$, щоб відкрити @@quick_info_word@@ та ознайомитися з правилами в даній юрисдикції."


    key[]: "hint_photo_trophy_title"
    val[]: "@@landmark_word@@"

    key[]: "hint_photo_trophy_text"
    val[]: "Відкрийте @@quick_info_word@@ за допомогою $KEY_advmouse$, щоб увійти у @@photo_mode_word@@ та зафіксувати @@landmark_word@@ <img src=/material/ui/map/photo_sight_not_captured.mat width=20 height=20>."


    key[]: "hint_viewpoint_title"
    val[]: "@@viewpoint_title@@ поблизу"

    key[]: "hint_viewpoint_text"
    val[]: "@@viewpoint_title@@ <img src=/material/ui/map/viewpoint_unseen.mat width=20 height=20> поблизу – знайдіть та активуйте, щоб переглянути катсцену."


    key[]: "hint_resting_title"
    val[]: "Місце для відпочинку поблизу"

    key[]: "hint_resting_text"
    val[]: "Resting places <img src=/material/ui/map/parking_ico.mat width=20 height=20> help you recover from fatigue and take your mandatory break to safely continue your journey."


    key[]: "hint_gas_title"
    val[]: "Автозаправна станція поблизу"

    key[]: "hint_gas_text"
    val[]: "На автозаправних станціях <img src=/material/ui/map/gas_ico.mat width=20 height=20> можна поповнити запаси пального в баку."


    key[]: "hint_car_job_title"
    val[]: "First courier job"

    key[]: "hint_car_job_text"
    val[]: "Complete the delivery - drive safely, take care of the cargo, and arrive at the expected time. Be aware of the customer priority that affects your rating and reward.<br><offset vshift=8>Press $KEY_advmouse$ to view job details."


    key[]: "hint_tour_board_title"
    val[]: "Tourist Board"

    key[]: "hint_tour_board_text"
    val[]: "A Tourist Board is nearby. Activate it to unlock its content in <color value=@@clr_sel@@>@@tourist_atlas_link@@</color> to guide your exploration of nearby landmarks and points of interest."


    key[]: "hint_tb_first_title"
    val[]: "First location explored"

    key[]: "hint_tb_first_text"
    val[]: "You have explored the first location of a local Tourist Board. You can view its details in <color value=@@clr_sel@@>@@tourist_atlas_link@@</color>. Explore all locations to learn more and earn rewards."


    key[]: "hint_tb_bef_compl_title"
    val[]: "One location remaining"

    key[]: "hint_tb_bef_compl_text"
    val[]: "Only one location remains before you fully explore your first local Tourist Board and earn your postcard."


    key[]: "hint_tb_done_title"
    val[]: "Tourist Board Explored"

    key[]: "hint_tb_done_text"
    val[]: "You have successfully explored all locations of a local Tourist Board. You can view their details in <color value=@@clr_sel@@>@@tourist_atlas_link@@</color>. As a reward, you can now display the postcard in your vehicle."


    key[]: "hint_vehicle_prio_title"
    val[]: "Customer priority - vehicle condition"

    key[]: "hint_vehicle_prio_text"
    val[]: "The customer has placed a higher priority on vehicle condition - your bonus reward or penalty will be greatly affected by the state of the vehicle you arrive in. Drive safely and take care of your vehicle.<br><offset vshift=8>Press $KEY_advmouse$ to view job details."


    key[]: "hint_cargo_prio_title"
    val[]: "Customer priority - cargo handling"

    key[]: "hint_cargo_prio_text"
    val[]: "The customer has placed a higher priority on cargo handling - your bonus reward or penalty will be greatly affected by the state of the cargo you deliver. Drive safely and take care of your cargo.<br><offset vshift=8>Press $KEY_advmouse$ to view job details."


    key[]: "hint_time_prio_title"
    val[]: "Customer priority - time management"

    key[]: "hint_time_prio_text"
    val[]: "The customer has placed a higher priority on time management - your bonus reward or penalty will be greatly affected by your ability to be punctual. Drive safely and arrive at a time the customer expects you.<br><offset vshift=8>Press $KEY_advmouse$ to view job details."


    key[]: "hint_car_deliv_title"
    val[]: "Approach the destination"

    key[]: "hint_car_deliv_text"
    val[]: "Stop in the marked area to finish the delivery.<br>Remember that the customer expects delivery at a specific time."


    key[]: "hint_car_early_title"
	val[]: "Early arrival"

    key[]: "hint_car_early_text"
    val[]: "The delivery is expected at a specific time, and arriving early will result in customer dissatisfaction. Plan your journey and use available resting places if needed."


#!{
    key[]: "hint_sm_throttle_title"
	val[]: "@@throttle_double_tap@@"
#!}

    key[]: "hint_sm_throttle_text"
    val[]: "You can enable smart throttle control in @@desktop_menu_category_options@@. By enabling it, the vehicle will hold lower throttle by default. After quickly pressing the throttle button twice, the vehicle will hold full throttle until the button is released."
