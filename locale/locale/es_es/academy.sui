	key[]: "aca_goal_book1_2_06_forward2"
	val[]: "Cruzar la horquilla"

	key[]: "aca_goal_book1_2_06_check1"
	val[]: "Abrirse en el giro"

	key[]: "aca_goal_book1_2_06_check2"
	val[]: "Hacer el giro de 90 grados"

	key[]: "aca_goal_book1_2_06_check3"
	val[]: "Tomar las curvas abiertas"

	key[]: "aca_goal_book1_2_06_check4"
	val[]: "Cambiar el sentido de la marcha"

	key[]: "aca_goal_book1_2_06_check5"
	val[]: "Changing Direction"

	key[]: "aca_goal_book1_2_06_reverse"
	val[]: "Girar al dar marcha atrás"

	key[]: "aca_goal_book1_2_06_check6"
