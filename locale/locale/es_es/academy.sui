	key[]: "aca_msg_parking_orientation"
	val[]: "Te encuentras en el lugar designado, pero no en el sentido correcto.<br><br><font face=/font/big_bold.font>Coloca el camión en la posición adecuada antes de completar la práctica.</font>"

#@}


#+ Book 1 intro
#@{

	key[]: "aca_scenario_book1_intro_title"
	val[]: "Nociones básicas"

	key[]: "aca_msg_book1_intro_cutscene01"
	val[]: "Te damos la bienvenida a @@driving_academy@@."

	key[]: "aca_msg_book1_intro_cutscene02"
	val[]: "Las siguientes prácticas representan los primeros pasos en tu viaje hacia la conducción profesional de camiones."

	key[]: "aca_msg_book1_intro_cutscene03"
	val[]: "Aquí aprenderás todo acerca de los sistemas y controles básicos del camión."

	key[]: "aca_msg_book1_intro_cutscene04"
	val[]: "Además de maniobras complejas con o sin un remolque."

	key[]: "aca_msg_book1_intro_cutscene05"
	val[]: "Te inculcaremos hábitos que te ayudarán a desenvolverte con seguridad en diversas situaciones."

	key[]: "aca_msg_book1_intro_cutscene06"
	val[]: "Te enseñaremos a usar sabiamente el espacio disponible para maniobrar con eficacia."

	key[]: "aca_msg_book1_intro_cutscene07"
	val[]: "Debes completar todas las prácticas y pasar el examen final."

	key[]: "aca_msg_book1_intro_cutscene08"
	val[]: "Solo así podrás adentrarte en las carreteras americanas para buscar nuevos retos a los que enfrentarte."

#@}

