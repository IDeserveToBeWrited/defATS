	key[]: "aca_goal_book1_2_06_check8"
	val[]: "Tomar la curva en zigzag"

	key[]: "aca_goal_book1_2_06_check9"
	val[]: "90-degree Turns"

	key[]: "aca_goal_book1_2_06_check10"
	val[]: "Cruzar el paso a nivel"

	key[]: "aca_goal_book1_2_06_check11"
	val[]: "Girar a la derecha"

	key[]: "aca_goal_book1_2_06_check12"
	val[]: "Girar a la izquierda"

	key[]: "aca_goal_book1_2_06_check13"
	val[]: "Straight Section"

	key[]: "aca_goal_book1_2_06_check14"
	val[]: "Hacer los giros a la izquierda"

	key[]: "aca_goal_book1_2_06_check15"
	val[]: "Detenerse junto a las barreras"


	key[]: "aca_goal_book1_2_06_check17"
	val[]: "Aparcar en el lugar designado"



#### 2_06 msg - intro text

	key[]: "aca_msg_book1_2_06_cutscene01"
	val[]: "Finalizaremos este capítulo conduciendo por un trayecto de práctica con un diseño algo más complicado."

	key[]: "aca_msg_book1_2_06_cutscene02"
	val[]: "El primer tramo consiste en atravesar un eslalon hecho con barreras. Recuerda que puedes ayudarte con los retrovisores."

	key[]: "aca_msg_book1_2_06_cutscene04"
	val[]: "Seguidamente te encontrarás con una horquilla. Realizarás un giro abierto para no tener problemas en superarla."

	key[]: "aca_msg_book1_2_06_cutscene05"
	val[]: "El trayecto se estrecha considerablemente. Deberás proceder con precaución y ayudarte con el espejo lateral."

	key[]: "aca_msg_book1_2_06_cutscene06"
	val[]: "El siguiente tramo está compuesto por unos sencillos giros de 90 grados."

	key[]: "aca_msg_book1_2_06_cutscene08"
	val[]: "El siguiente tramo debe hacerse marcha atrás. Acércate a las barreras de delante teniendo eso en cuenta."

	key[]: "aca_msg_book1_2_06_cutscene09"
	val[]: "Seguirás las marcas viales hacia atrás y a través de las curvas."

	key[]: "aca_msg_book1_2_06_cutscene10"
	val[]: "Continuarás hasta llegar a las barreras y te detendrás. Seguidamente avanzarás hacia la derecha."

	key[]: "aca_msg_book1_2_06_cutscene11"
	val[]: "This passage through the cones is very narrow. Drive slowly and use your mirrors to orient yourself within the passage."

	key[]: "aca_msg_book1_2_06_cutscene13"
	val[]: "Delante te encontrarás unos giros de 90 grados que alternan de izquierda a derecha."

	key[]: "aca_msg_book1_2_06_cutscene15"
	val[]: "Puede que te encuentres con un tren en el paso a nivel. Si es así, aguarda a que pase. Después, girarás a la derecha hacia la vía de servicio."

	key[]: "aca_msg_book1_2_06_cutscene16"
	val[]: "Girarás a la izquierda en la carretera. Podrás darte el gusto de acelerar tras completar el giro."

	key[]: "aca_msg_book1_2_06_cutscene18"
	val[]: "Unas cuantos giros más hacia la izquierda y llegarás al destino."

	key[]: "aca_msg_book1_2_06_cutscene19"
	val[]: "Te acercarás a las barreras al frente y te prepararás para estacionar a la derecha."

	key[]: "aca_msg_book1_2_06_cutscene20"
	val[]: "Darás marcha atrás hasta la plaza de aparcamiento, pararás el motor y asegurarás el camión."

#### 2_06 Driving Instructions



	key[]: "aca_msg_book1_2_06_forward"
	val[]: "Al frente tienes un eslalon hecho con barreras.<br><br><font face=/font/big_bold.font>Conduce a través del eslalon.</font>"

	key[]: "aca_msg_book1_2_06_forward2"
	val[]: "<font face=/font/big_bold.font>Sigue la ruta a la vuelta de la horquilla.</font>"

	key[]: "aca_msg_book1_2_06_check1"
	val[]: "El tramo se estrecha considerablemente, así que usa el espejo lateral para orientarte.<br><br><font face=/font/big_bold.font>Procede con precaución.</font>"

	key[]: "aca_msg_book1_2_06_check2"
	val[]: "Más adelante tienes un giro de 90 grados.<br><br><font face=/font/big_bold.font>Ajusta la velocidad en consecuencia.</font>"

	key[]: "aca_msg_book1_2_06_check3"
	val[]: "Delante tienes unos giros algo más sencillos. Ajusta la velocidad según sea necesario.<br><br><font face=/font/big_bold.font>Sigue conduciendo.</font>"

	key[]: "aca_msg_book1_2_06_check4"
	val[]: "The following section must be completed in reverse. Stop at the barriers ahead so that you can reverse to the right afterwards.<br><br><font face=/font/big_bold.font>Stop at the barriers.</font>"

	key[]: "aca_msg_book1_2_06_check5"
	val[]: "Conduce marcha atrás hasta la zona que tienes detrás de ti y a la derecha.<br><br><font face=/font/big_bold.font>Comienza a desplazarte marcha atrás.</font>"

	key[]: "aca_msg_book1_2_06_reverse"
	val[]: "Sigue por el recorrido de los giros.<br><br><font face=/font/big_bold.font>Continúa marcha atrás.</font>"

	key[]: "aca_msg_book1_2_06_check6"
	val[]: "Detrás de ti, a la izquierda, tienes unas barreras.<br><br><font face=/font/big_bold.font>Gira hacia las barreras y prepárate para detenerte.</font>"

	key[]: "aca_msg_book1_2_06_check7"
	val[]: "Detente y luego cambia el sentido de la marcha para continuar hacia la derecha.<br><br><font face=/font/big_bold.font>Conduce hacia delante.</font>"

	key[]: "aca_msg_book1_2_06_check8"
	val[]: "In front of you is a narrow winding path through some cones. Drive carefully and use your mirrors if necessary.<br><br><font face=/font/big_bold.font>Drive through the cones. </font>"

	key[]: "aca_msg_book1_2_06_check9"
	val[]: "A continuación tienes un conjunto de diferentes giros de 90 grados. Asegúrate de acercarte a cada uno con margen suficiente.<br><br><font face=/font/big_bold.font>Sigue conduciendo.</font>"

	key[]: "aca_msg_book1_2_06_check10"
	val[]: "Presta atención al paso a nivel. Las señales pueden activarse para indicar que se aproxima un tren.<br><br><font face=/font/big_bold.font>Procede con precaución.</font>"

	key[]: "aca_msg_book1_2_06_check11"
	val[]: "El giro hacia la vía de servicio está parcialmente bloqueado por un obstáculo, así que mantente a la izquierda para disponer de más espacio.<br><br><font face=/font/big_bold.font>Gira a la derecha.</font>"

	key[]: "aca_msg_book1_2_06_check12"
	val[]: "Puedes ignorar la señal si quieres. La ruta se encuentra cerrada al tráfico.<br><br><font face=/font/big_bold.font>Gira a la izquierda.</font>"

	key[]: "aca_msg_book1_2_06_check13"
	val[]: "Te puedes permitir acelerar un poco por aquí, pero ten en cuenta que tendrás que girar en la siguiente intersección.<br><br><font face=/font/big_bold.font>Avanza por el recorrido.</font>"

	key[]: "aca_msg_book1_2_06_check14"
	val[]: "Avanza hasta la población realizando unos cuantos giros a la izquierda hasta el destino.<br><br><font face=/font/big_bold.font>Conduce por el área urbana.</font>"

	key[]: "aca_msg_book1_2_06_check15"
	val[]: "En el extremo opuesto hay unas barreras. Conduce hasta ellas.<br><br><font face=/font/big_bold.font>Detente junto a las barreras.</font>"

	key[]: "aca_msg_book1_2_06_check16"
	val[]: "Detrás de ti, a la derecha, tienes una plaza de aparcamiento.<br><br><font face=/font/big_bold.font>Circula marcha atrás para estacionar.</font>"
#!{
	key[]: "aca_msg_book1_2_06_check17"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_06_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_2_06_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

#@}

#+ Book 1 Scenario 2_08
#@{

#### 2_08 common
	key[]: "aca_scenario_book1_2_08_title"
	val[]: "Conducción por ruta sencilla"

	key[]: "aca_scenario_book1_2_08_desc"
	val[]: "En esta práctica pondremos a prueba los conocimientos que has aprendido hasta ahora por un sencillo recorrido de práctica."

#### 2_08 goal
#!{
	key[]: "aca_goal_book1_2_08_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_08_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_2_08_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
#!}
	key[]: "aca_goal_book1_2_08_forward"
	val[]: "Acceder al recorrido"

	key[]: "aca_goal_book1_2_08_check1"
	val[]: "Tomar la horquilla amplia"

	key[]: "aca_goal_book1_2_08_check2"
	val[]: "Circular por el eslalon"

	key[]: "aca_goal_book1_2_08_check3"
	val[]: "Tomar la horquilla estrecha"

	key[]: "aca_goal_book1_2_08_check4"
	val[]: "Tomar la curva estrecha"

	key[]: "aca_goal_book1_2_08_check6"
	val[]: "Hacer los giros complejos"

	key[]: "aca_goal_book1_2_08_check7"
	val[]: "Superar el tramo abierto"



#### 2_08 msg - intro text

	key[]: "aca_msg_book1_2_08_cutscene1"
	val[]: "Es hora de ver cómo te las apañas por un corto trayecto, ahora que has obtenido experiencia, en el que te encontrarás diferentes tipos de giros. Ten en cuenta que esto no es una carrera y no hay límite de tiempo. Conduce con precaución y adapta la velocidad para sortear los obstáculos."

	key[]: "aca_msg_book1_2_08_cutscene2"
	val[]: "Accederás al recorrido por una amplia horquilla."

	key[]: "aca_msg_book1_2_08_cutscene3"
	val[]: "A continuación, te toparás con un conjunto de obstáculos que te guiarás hacia un eslalon irregular."

	key[]: "aca_msg_book1_2_08_cutscene4"
	val[]: "Una vez completes los giros, te encontrarás con una horquilla. Es muy importante anticiparse, tanto para transitarla como para no encontrarse problemas al acceder al siguiente tramo."

	key[]: "aca_msg_book1_2_08_cutscene5"
	val[]: "Ten cuidado con los conos de tráfico al atravesar la curva larga, ya que la visibilidad será limitada."

	key[]: "aca_msg_book1_2_08_cutscene6"
	val[]: "Otro conjunto de barreras te guiará hacia un amplio eslalon."

	key[]: "aca_msg_book1_2_08_cutscene7"
	val[]: "Aunque el trayecto se abra un poco, no te apresures. Unas cuantos giros sencillos más y estará hecho."

	key[]: "aca_msg_book1_2_08_cutscene8"
	val[]: "Stop in the designated area and secure the truck."


#### 2_08 Driving Instructions

	key[]: "aca_msg_book1_2_08_start"
	val[]: "Para completar esta práctica con éxito, tendrás que evitar colisionar, salirte del trayecto o golpear los conos de tráfico.<br><br><font face=/font/big_bold.font>Prepárate para partir.</font>"

	key[]: "aca_msg_book1_2_08_forward"
	val[]:"<font face=/font/big_bold.font>Sigue hasta la horquilla para acceder al recorrido.</font>"

	key[]: "aca_msg_book1_2_08_check1"
	val[]: "<font face=/font/big_bold.font>Sortea la horquilla.</font>"

	key[]: "aca_msg_book1_2_08_check2"
	val[]: "Te acercas a unas barreras dispuestas en forma de eslalon.<br><br><font face=/font/big_bold.font>Adapta la velocidad en consecuencia y continúa.</font>"

	key[]: "aca_msg_book1_2_08_check3"
	val[]: "Ahora tienes un par de sencillos giros de 90 grados seguidos por una horquilla. Ve despacio.<br><br><font face=/font/big_bold.font>Continúa hasta la horquilla.</font>"

	key[]: "aca_msg_book1_2_08_check4"
	val[]: "Al salir de la horquilla, te encontrarás un tramo estrecho a través de una curva. Debes mantenerte alejado de las barreras del interior, pero procura no golpear ningún cono de tráfico que veas.<br><br><font face=/font/big_bold.font>Toma la curva.</font>"

	key[]: "aca_msg_book1_2_08_check6"
	val[]: "El siguiente tramo cuenta con unos giros cerrados algo más complicados. Adapta la velocidad y atraviésalo con cuidado.<br><br><font face=/font/big_bold.font>Sigue conduciendo.</font>"

	key[]: "aca_msg_book1_2_08_check7"
	val[]: "El siguiente tramo es más abierto y cuenta con unos sencillos giros. Procede con calma y no te precipites.<br><br><font face=/font/big_bold.font>Sigue conduciendo.</font>"
#!{
	key[]: "aca_msg_book1_2_08_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_08_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

#@}

#+ Book 1 Scenario 2_09
#@{

#### 2_09 common
	key[]: "aca_scenario_book1_2_09_title"
	val[]: "Estacionamiento en paralelo"

	key[]: "aca_scenario_book1_2_09_desc"
	val[]: "En esta práctica veremos como aparcar en paralelo entre otros dos camiones."

#### 2_09 goal

	key[]: "aca_goal_book1_2_09_stopmid"
	val[]: "Detenerse por delante de la plaza"

	key[]: "aca_goal_book1_2_09_checkmirror"
	val[]: "Comprobar los alrededores"

	key[]: "aca_goal_book1_2_09_backward"
	val[]: "Acceder marcha atrás a la plaza"

	key[]: "aca_goal_book1_2_09_stop"
	val[]: "Alinear el camión en el interior"

#!{
	key[]: "aca_goal_book1_2_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_09_check1"
	val[]: "@@aca_goal_book1_1_03_forward@@"


	key[]: "aca_goal_book1_2_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"



 #!}
#### 2_09 msg - intro text

	key[]: "aca_msg_book1_2_09_cutscene1"
	val[]: "Aparcar en paralelo es algo esencial que todo camionero debe conocer. Primero iniciarás la marcha."

	key[]: "aca_msg_book1_2_09_cutscene2"
	val[]: "Avanzarás hacia la plaza de aparcamiento prestando atención a tu alrededor."

	key[]: "aca_msg_book1_2_09_cutscene3"
	val[]: "Te alinearás con el camión que se encuentra estacionado delante. Procura no acercarte demasiado para tener espacio en el que maniobrar."

	key[]: "aca_msg_book1_2_09_cutscene4"
	val[]: "Harás un giro cerrado hacia la plaza de aparcamiento y darás marcha atrás."

	key[]: "aca_msg_book1_2_09_cutscene5"
	val[]: "Mira por el retrovisor del conductor y orienta el camión hacia la parte del bordillo que tienes delante del camión estacionado detrás."

	key[]: "aca_msg_book1_2_09_cutscene6"
	val[]: "Una vez el parachoques delantero supere el camión estacionado delante, avanzarás mientras enderezas el volante para alinear el camión con la plaza de aparcamiento."

	key[]: "aca_msg_book1_2_09_cutscene7"
	val[]: "Asegurarás el camión una vez terminada la maniobra."

#### 2_09 Driving Instructions

	key[]: "aca_msg_book1_2_09_start"
	val[]: "Más adelante verás unos camiones estacionados. Entre ellos tienes un espacio disponible para aparcar.<br><br><font face=/font/big_bold.font>Prepárate para partir.</font>"

	key[]: "aca_msg_book1_2_09_check1"
	val[]: "Recuerda prestar atención a lo que te rodea. Haz un buen uso de los retrovisores durante la maniobra.<br><br><font face=/font/big_bold.font>Sigue avanzando.</font>"

	key[]: "aca_msg_book1_2_09_stopmid"
	val[]: "<color value=@@clr_white@@>Conduce más allá de la plaza de aparcamiento hasta la zona marcada. Desde ahí podrás iniciar la maniobra marchas atrás.<br><br><font face=/font/big_bold.font>Detente en la ubicación marcada.</font>"

	key[]: "aca_msg_book1_2_09_checkmirror"
	val[]: "Revisa que no tengas obstáculos a tu alrededor para no colisionar al dar marcha atrás.<br><br><font face=/font/big_bold.font>Mira por el retrovisor del acompañante.</font>"

	key[]: "aca_msg_book1_2_09_backward"
	val[]: "Gira las ruedas y da marcha atrás hasta la plaza de aparcamiento.<br><br><font face=/font/big_bold.font>Comienza a desplazarte marcha atrás.</font>"

	key[]: "aca_msg_book1_2_09_stop"
	val[]: "Comienza a enderezar el camión cuando consideres oportuno. Procura no subirte al bordillo.<br><br><font face=/font/big_bold.font>Orienta el camión con la plaza de aparcamiento.</font>"
#!{
	key[]: "aca_msg_book1_2_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

