	key[]: "aca_book_disclaimer"
	val[]: "<color value=@@clr_sel@@><font face=/font/big_bold.font>La @@driving_academy@@ no pretende remplazar ningún centro de formación acreditado.</font><br><br><color value=@@clr_txt@@>Debes acudir a uno para poder conducir un camión en la vida real.<br><br>Aquellos centros que estén interesados en usar la @@driving_academy@@ para complementar su formación pueden ponerse en contacto con nosotros a través de academy@scssoft.com."

	key[]: "aca_book_book1_title"
	val[]: "Nociones básicas"

	key[]: "aca_book_book1_desc"
	val[]: "Aprende los fundamentos para conducir un camión, que van desde funciones y controles esenciales hasta maniobras con un remolque."

	key[]: "aca_book_book2_title"
	val[]: "Destreza al volante"

	key[]: "aca_book_book2_desc"
	val[]: "Perfecciona tus habilidades de conducción con nuevas prácticas en entornos más desafiantes."

	key[]: "aca_book_book3_title"
	val[]: "Maniobras con doble remolque"

	key[]: "aca_book_book3_desc"
	val[]: "Asume los peculiares desafíos de conducir y dar marcha atrás con un conjunto B-double."
#@}

