	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}


	key[]: "aca_goal_book1_3_20_park1"
	val[]: "Maniobrar desde la posición"

	key[]: "aca_goal_book1_3_20_park2"
	val[]: "Estacionar en diagonal"

	key[]: "aca_goal_book1_3_20_park3"
	val[]: "Acceder a la plaza de aparcamiento"

	key[]: "aca_goal_book1_3_20_park4"
	val[]: "Estacionar en paralelo"

	key[]: "aca_goal_book1_3_20_park5"
	val[]: "Aparcar por última vez"


#### 3_20 msg - intro text

	key[]: "aca_msg_book1_3_20_cutscene01"
	val[]: "Es hora de terminar el examen final. Nos moveremos hasta un estacionamiento cercano y pondremos a prueba tus habilidades para dar marcha atrás y maniobrar para aparcar."

	key[]: "aca_msg_book1_3_20_cutscene02"
	val[]: "Evaluaremos tus aptitudes con varias maniobras de aparcamiento consecutivas."

	key[]: "aca_msg_book1_3_20_cutscene03"
	val[]: "Tu espacio será limitado, así que ve con cuidado y tómatelo con calma."

	key[]: "aca_msg_book1_3_20_cutscene04"
	val[]: "Deberás aprovechar bien el espacio que tienes a tu alrededor y sacar el máximo partido a los retrovisores y espejos. Buena suerte."




#### 3_20 outro text

	key[]: "aca_msg_book1_3_20_outro01"
	val[]: "Congratulations, you've successfully completed the exams for Truck Driving Basics, and learned all the skills necessary to properly manoeuvre your truck."

	key[]: "aca_msg_book1_3_20_outro02"
	val[]: "This is the first step in your journey towards realizing your dream of becoming a professional truck driver."

	key[]: "aca_msg_book1_3_20_outro03"
	val[]: "Ahora ya puedes salir a las carreteras americanas y enfrentarte a tus primeros desafíos."

	key[]: "aca_msg_book1_3_20_outro04"
	val[]: "...but the adventure has just begun."


#### 3_20 Driving Instructions

	key[]: "aca_msg_book1_3_20_start"
	val[]: "Procura ir con cuidado y sin precipitarte. No pasa nada si no consigues aparcar a la primera; lo importante es no dañar el vehículo ni los que te rodean.<br><br><font face=/font/big_bold.font>Prepárate para partir.</font>"

	key[]: "aca_msg_book1_3_20_forward"
	val[]: "<font face=/font/big_bold.font>Avanza hasta la primera parte del examen.</font>"

	key[]: "aca_msg_book1_3_20_park1"
	val[]: "Tu primera tarea consiste en demostrar que eres capaz de aparcar desde una posición no alineada. La ubicación a la que tienes que desplazarte con el remolque está a tu izquierda.<br><br><font face=/font/big_bold.font>Aparca maniobrando desde la ubicación en la que te encuentras.</font>"

	key[]: "aca_msg_book1_3_20_park2"
	val[]: "Lo siguiente es dar marcha atrás hacia una hilera de camiones estacionados. Ten cuidado de no colisionar con ellos.<br><br><font face=/font/big_bold.font>Aparca en diagonal.</font>"

	key[]: "aca_msg_book1_3_20_park3"
	val[]: "Procede hasta la plaza de aparcamiento y vigila no encontrarte con nada inesperado.<br><br><font face=/font/big_bold.font>Sigue conduciendo.</font>"

	key[]: "aca_msg_book1_3_20_park4"
	val[]: "Ahora vamos a aparcar en paralelo entre dos camiones junto al bordillo que hay delante.<br><br><font face=/font/big_bold.font>Realiza la maniobra para estacionar.</font>"

	key[]: "aca_msg_book1_3_20_park5"
	val[]: "La última maniobra de estacionamiento se encuentra a tu izquierda. Puedes aproximarte como consideres apropiado.<br><br><font face=/font/big_bold.font>Da marcha atrás hasta la ubicación designada.</font>"

	key[]: "aca_msg_book1_3_20_park6"
	val[]: "Hemos acabado. Sal de la zona de prácticas.<br><br><font face=/font/big_bold.font>Abandona el lugar por la izquierda.</font>"

	key[]: "aca_msg_book1_3_20_stop"
	val[]: "Puedes estacionar el camión a la derecha de los demás.<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_20_end"
	val[]: "@@aca_msg_book1_2_01_end@@"


#!}

#@}


#+ Book 1 Scenario 3_22
#@{

#### 3_22 common
	key[]: "aca_scenario_book1_3_22_title"
	val[]: "Estacionamiento en paralelo con remolque"

	key[]: "aca_scenario_book1_3_22_desc"
	val[]: "En esta práctica veremos como aparcar en paralelo con un remolque acoplado."

#### 3_22 goal


	key[]: "aca_goal_book1_3_22_stopmid"
	val[]: "Detenerse en la zona marcada"
#!{
	key[]: "aca_goal_book1_3_22_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_22_check1"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_22_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_22_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_22_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
  #!}
#### 3_22 msg - intro text

	key[]: "aca_msg_book1_3_22_cutscene1"
	val[]: "Aparcar con un remolque en paralelo es todo un reto de habilidad para cualquier camionero. Ya sea para estacionar en una calle urbana o parar en un área de descanso, es algo que se debe saber poner en práctica."

	key[]: "aca_msg_book1_3_22_cutscene2"
	val[]: "Antes de acceder a una plaza de aparcamiento, debes asegurarte de que tanto la cabeza tractora como el remolque caben en ella. Para esta ocasión nos hemos asegurado de que cuentes con espacio de sobra."

	key[]: "aca_msg_book1_3_22_cutscene3"
	val[]: "Te alinearás con el camión que se encuentra estacionado delante. Procura no acercarte demasiado para tener espacio en el que maniobrar."

	key[]: "aca_msg_book1_3_22_cutscene4"
	val[]: "Harás un giro cerrado distanciándote de la plaza de aparcamiento y comenzarás a dar marcha atrás. La idea es que el remolque se oriente hacia ella cuanto antes."

	key[]: "aca_msg_book1_3_22_cutscene5"
	val[]: "Una vez que el remolque apunte correctamente podrás continuar la maniobra."

	key[]: "aca_msg_book1_3_22_cutscene6"
	val[]: "Empezarás a girar el remolque alejándolo del bordillo antes de que las ruedas del lado del conductor entren en la ubicación."

	key[]: "aca_msg_book1_3_22_cutscene7"
	val[]: "Enderezarás la cabeza tractora con el remolque y te ubicarás en la plaza de aparcamiento. Finalizarás apagando el motor y asegurando el camión."

#### 3_22 Driving Instructions

	key[]: "aca_msg_book1_3_22_start"
	val[]: "La plaza de aparcamiento se encuentra entre los otros camiones que tienes delante de ti. Asegúrate de revisar los retrovisores y mantener una distancia de seguridad con los obstáculos que te rodean mientras realizas la maniobra.<br><br><font face=/font/big_bold.font>Prepárate para partir.</font>"

	key[]: "aca_msg_book1_3_22_check1"
	val[]: "Muévete por la zona para encontrar la plaza de aparcamiento.<br><br><font face=/font/big_bold.font>Sigue avanzando.</font>"

	key[]: "aca_msg_book1_3_22_stopmid"
	val[]: "<color value=@@clr_white@@>Conduce más allá de la plaza de aparcamiento hasta la zona marcada. Desde ahí podrás iniciar la maniobra marchas atrás.<br><br><font face=/font/big_bold.font>Detente en la ubicación marcada.</font>"

	key[]: "aca_msg_book1_3_22_backward"
	val[]: "Gira la cabeza tractora alejándote de la plaza de aparcamiento para comenzar a mover el remolque hacia ella. Procura no hacerlo muy cerrado o acabarás llevándolo hacia el bordillo.<br><br><font face=/font/big_bold.font>Comienza a desplazarte marcha atrás.</font>"

	key[]: "aca_msg_book1_3_22_stop"
	val[]: "Alinea el remolque con la plaza de aparcamiento. Si es necesario, desplázate hacia delante o hacia atrás mientras realizas las maniobras necesarias para ajustar tu posición.<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_22_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
 #!}

#@}

#+ Book 1 Scenario 3_21
#@{
#### 3_21 common
	key[]: "aca_scenario_book1_3_21_title"
	val[]: "Conducción marcha atrás desde 45 grados"

	key[]: "aca_scenario_book1_3_21_desc"
	val[]: "Es esta práctica veremos nos moveremos marcha atrás desde unos 45 grados."

#### 3_21 goal
#!{
	key[]: "aca_goal_book1_3_21_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_21_forward"
	val[]: "@@aca_goal_book1_1_03_forward@@"

	key[]: "aca_goal_book1_3_21_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}
	key[]: "aca_goal_book1_3_21_check1"
	val[]: "Detenerse en la zona marcada"

	key[]: "aca_goal_book1_3_21_check2"
	val[]: "Distanciarse para dar marcha atrás"

	key[]: "aca_goal_book1_3_21_stop"
	val[]: "Aparcar en el lugar designado"



#### 3_21 msg - intro text

	key[]: "aca_msg_book1_3_21_cutscene1"
	val[]: "Vamos a ver cómo realizar un estacionamiento a 45 grados. Se trata de un método preferido por muchos camioneros, siempre y cuando la situación lo permite, debido a que se orienta el remolque lo antes posible y evitando así tener que maniobrarlo demasiado para estacionarlo"

	key[]: "aca_msg_book1_3_21_cutscene2"
	val[]: "Estacionar de esta forma también te permite ver con claridad el lugar en el que aparcar, lo cual es ideal para ir maniobrando."

	key[]: "aca_msg_book1_3_21_cutscene3"
	val[]: "Comenzarás lejos de la plaza de aparcamiento, colocarás el camión a unos 45 grados respecto a la misma, y orientarás el remolque hacia el camión que se encuentra en el lado opuesto de lugar en el que vas a estacionar marcha atrás."

	key[]: "aca_msg_book1_3_21_cutscene4"
	val[]: "Girarás el camión como si quisieras alejarte. Esto tirará de la parte delantera del remolque al mismo tiempo que orientará la parte trasera hacia la plaza de aparcamiento. Procura no pasarte y acabar haciendo una tijera; recuerda que es más fácil hacer un giro cerrado que uno más amplio."

	key[]: "aca_msg_book1_3_21_cutscene5"
	val[]: "Alinearás la cabeza tractora con el remolque una vez te encuentres en el interior de la plaza de aparcamiento."

	key[]: "aca_msg_book1_3_21_cutscene6"
	val[]: "Te detendrás y asegurarás el camión."

#### 3_21 Driving Instructions
#!{
	key[]: "aca_msg_book1_3_21_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

	key[]: "aca_msg_book1_3_21_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
	key[]: "aca_msg_book1_3_21_forward"
	val[]: "Cuentas con una plaza de aparcamiento a la izquierda. Aléjate un poco y colócate a unos 45 grados de la misma.<br><br><font face=/font/big_bold.font>Continúa y prepárate para estacionar.</font>"

	key[]: "aca_msg_book1_3_21_check1"
	val[]: "Alinea el camión con las marcas viales.<br><br><font face=/font/big_bold.font>Deténte en la ubicación marcada.</font>"

	key[]: "aca_msg_book1_3_21_check2"
	val[]: "Dirige el remolque hacia la plaza de aparcamiento valiéndote de los conocimientos que has obtenido en las prácticas anteriores.<br><br><font face=/font/big_bold.font>Comienza a desplazarte marcha atrás.</font>"

	key[]: "aca_msg_book1_3_21_stop"
	val[]: "Sigue maniobrando el remolque hacia el interior.<br><br>@@aca_msg_book1_2_01_stop@@"


#@}

