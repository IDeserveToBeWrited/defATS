	key[]: "aca_goal_book1_3_12_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_12_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"
 #!}

#### 3_12 msg - intro text

	key[]: "aca_msg_book1_3_12_cutscene01"
	val[]: "Vamos a repasar cómo dar la vuelta en espacios reducidos. No siempre contarás con el suficiente para maniobrar, por lo que tendrás que aprender a adaptarte a situaciones menos favorables."

	key[]: "aca_msg_book1_3_12_cutscene02"
	val[]: "Atravesarás el pasadizo hacia la zona abierta."

	key[]: "aca_msg_book1_3_12_cutscene03"
	val[]: "A la izquierda te encontrarás otro por el que tendrás que circular marcha atrás. Prepárate como consideres oportuno teniendo esto en mente. Te podría ser útil orientar el remolque hacia él antes de iniciar la maniobra."

	key[]: "aca_msg_book1_3_12_cutscene04"
	val[]: "Darás marcha atrás hacia el pasadizo. Presta atención a ambos los lados de la cabeza tractora y el remolque."

	key[]: "aca_msg_book1_3_12_cutscene05"
	val[]: "Te encontrarás obstáculos, así que procura desplazarte por el lado del conductor."

	key[]: "aca_msg_book1_3_12_cutscene06"
	val[]: "Una vez que termines de dar marcha atrás, podrás avanzar y volver por donde viniste."

	key[]: "aca_msg_book1_3_12_cutscene07"
	val[]: "Es posible que tengas dificultades para ver el remolque por el retrovisor del acompañante al salir. Tendrás que aprovechar todo el espacio disponible."

	key[]: "aca_msg_book1_3_12_cutscene08"
	val[]: "Continuarás conduciendo hacia la salida."

	key[]: "aca_msg_book1_3_12_cutscene09"
	val[]: "Park in the designated area and secure the truck."
#!{
	key[]: "aca_msg_book1_3_12_cutscene10"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_12_cutscene11"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_12_cutscene12"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_12_cutscene13"
	val[]: "Unused"
#!}
#### 3_12 Driving Instructions

	key[]: "aca_msg_book1_3_12_start"
	val[]: "Delante de ti hay una zona que representa el aparcamiento de una empresa de transportes. Tu tarea consiste en entrar allí y dar la vuelta al camión para volver a salir. Asegúrate de aprovechar bien el espacio a tu alrededor.<br><br><font face=/font/big_bold.font>Prepárate para partir.</font>"

	key[]: "aca_msg_book1_3_12_forward"
	val[]: "<font face=/font/big_bold.font>Procede por el pasadizo.</font>"

	key[]: "aca_msg_book1_3_12_check1"
	val[]: "Justo después del edificio a la izquierda hay otro pasadizo por el que debes dar marcha atrás. Prepárate teniendo eso en mente.<br><br><font face=/font/big_bold.font>Continúa a través de las barreras.</font>"



	key[]: "aca_msg_book1_3_12_check3"
	val[]: "Da marcha atrás y gira el remolque hacia el pasadizo, procurando no colisionar contra nada por el lado derecho de la cabeza tractora.<br><br><font face=/font/big_bold.font>Comienza a desplazarte marcha atrás y gira el remolque hacia el pasadizo hasta la ubicación marcada.</font>"

	key[]: "aca_msg_book1_3_12_check4"
	val[]: "Ahora puedes salir de la zona en la misma dirección por la que has venido. Aprovecha el espacio disponible.<br><br><font face=/font/big_bold.font>Avanza y gira a la derecha.</font>"


	key[]: "aca_msg_book1_3_12_check6"
	val[]: "Sigue por el pasadizo hasta la zona designada."
#!{
	key[]: "aca_msg_book1_3_12_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_12_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_12_check5"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_12_check2"
	val[]: "Unused"
#!}

#@}

#+ Book 1 Scenario 3_13
#@{

#### 3_13 common
	key[]: "aca_scenario_book1_3_13_title"
	val[]: "Estacionamiento marcha atrás desplazado"

	key[]: "aca_scenario_book1_3_13_desc"
	val[]: "En esa práctica tendrás que dar marcha atrás hasta una plaza de aparcamiento que no se encuentra precisamente detrás de ti. Contarás con poco espacio para maniobrar, por lo que tendrás que usarlo con cabeza."

#### 3_13 goal

#!{
	key[]: "aca_goal_book1_3_13_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_13_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_13_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_13_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

#!}

#### 3_13 msg - intro text

	key[]: "aca_msg_book1_3_13_cutscene01"
	val[]: "En esta ocasión tendrás que estacionar en el espacio que tienes a continuación. Verás que no tienes mucho espacio, así que tendrás que ir poco a poco para colocar el remolque en posición."

	key[]: "aca_msg_book1_3_13_cutscene02"
	val[]: "Avanzarás recto hasta las barreras."

	key[]: "aca_msg_book1_3_13_cutscene03"
	val[]: "Inmediatamente te detendrás junto a ellas."

	key[]: "aca_msg_book1_3_13_cutscene04"
	val[]: "Girarás considerablemente el volante hacia el lado del conductor antes de moverte. De esta forma, el remolque comenzará a girar hacia la plaza de aparcamiento nada más iniciar la marcha, ahorrándote así un valioso espacio."

	key[]: "aca_msg_book1_3_13_cutscene05"
	val[]: "Una vez el remolque esté orientado hacia donde quieres, alinearás la cabeza tractora y te moverás hacia la plaza de aparcamiento."

	key[]: "aca_msg_book1_3_13_cutscene06"
	val[]: "A partir de aquí el procedimiento no dista mucho de cualquier otra maniobra de estacionamiento."

	key[]: "aca_msg_book1_3_13_cutscene07"
	val[]: "Seguirás marcha atrás mirando a ambos lados, manteniendo la cabeza tractora y el remolque alineados con la plaza de aparcamiento."

	key[]: "aca_msg_book1_3_13_cutscene08"
	val[]: "Estacionarás en la zona designada, asegurarás el camión y apagarás el motor."


#### 3_13 Driving Instructions

	key[]: "aca_msg_book1_3_13_start"
	val[]: "Te encuentras en una plaza de aparcamiento, pero debes circular hasta otra que tienes a la derecha.<br><br><font face=/font/big_bold.font>Prepárate para partir.</font>"

	key[]: "aca_msg_book1_3_13_forward"
	val[]: "Verás una ubicación marcada al frente.<br><br><font face=/font/big_bold.font>Conduce hacia delante.</font>"
#!{
	key[]: "aca_msg_book1_3_13_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

	key[]: "aca_msg_book1_3_13_check2"
	val[]: "Recuerda que deberás iniciar la maniobra cuanto antes, ya que apenas cuentas con espacio.<br><br><font face=/font/big_bold.font>Da marcha atrás hasta la zona marcada.</font>"


#@}

#+ Book 1 Scenario 3_15
#@{

#### 3_15 common
	key[]: "aca_scenario_book1_3_15_title"
	val[]: "Giro en asa y giro en gancho"

	key[]: "aca_scenario_book1_3_15_desc"
	val[]: "En esta práctica realizarás un breve recorrido por una ruta que te enseñará a maniobrar el remolque a través de cruces cerrados con la ayuda de dos procedimientos de viraje diferentes."

#### 3_15 goal
#!{
	key[]: "aca_goal_book1_3_15_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_15_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_15_check6"
	val[]: "@@aca_goal_book1_3_11_check6@@"

	key[]: "aca_goal_book1_3_15_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_15_end"
	val[]: "@@aca_goal_book1_2_01_end@@"


 #!}
	key[]: "aca_goal_book1_3_15_check1"
	val[]: "Realizar un giro en asa"

	key[]: "aca_goal_book1_3_15_check2"
	val[]: "Tomar la curva y continuar recto"

	key[]: "aca_goal_book1_3_15_check3"
	val[]: "Realizar un giro en gancho"

	key[]: "aca_goal_book1_3_15_check4"
	val[]: "Continuar recto y tomar la curva"

	key[]: "aca_goal_book1_3_15_check5"
	val[]: "Maniobrar con ambos giros"



#### 3_15 msg - intro text

	key[]: "aca_msg_book1_3_15_cutscene01"
	val[]: "Más adelante te toparás con unos giros bastantes cerrados y con poco espacio. Te serán de utilidad para conocer como maniobrar un remolque de forma eficaz por ellos."

	key[]: "aca_msg_book1_3_15_cutscene02"
	val[]: "@@aca_msg_book1_3_15_cutscene02_img@@<br>El primer giro requerirá una maniobra de giro en asa. Esto ocurre cuando un giro cuenta con poco espacio por el que maniobrar con normalidad y es necesario obtenerlo en el resto de la vía."

	key[]: "aca_msg_book1_3_15_cutscene03"
	val[]: "Tendrás que seguir las marcas del carril para mantener la cabeza tractora lejos del bordillo interior. Esto alejará también el remolque para que tengas suficiente espacio para maniobrar."

	key[]: "aca_msg_book1_3_15_cutscene04"
	val[]: "Deberás mantenerte cerca del obstáculo al salir del giro para que el remolque siga un arco lo más amplio posible."

	key[]: "aca_msg_book1_3_15_cutscene05"
	val[]: "Deberás mantener la cabeza tractora en el centro de la calzada para que las ruedas del remolque no toquen el bordillo al entrar en la curva larga."

	key[]: "aca_msg_book1_3_15_cutscene06"
	val[]: "Continuarás por la carretera."

	key[]: "aca_msg_book1_3_15_cutscene07"
	val[]: "@@aca_msg_book1_3_15_cutscene07_img@@<br>El siguiente giro requiere una maniobra de giro en gancho. Esta técnica cierra el carril por detrás, evitando así que un posible conductor distraído se cuele por la derecha. Úsala siempre que dispongas de espacio suficiente en la vía por la que tengas que girar."

	key[]: "aca_msg_book1_3_15_cutscene08"
	val[]: "Te adentrarás en la intersección y harás un giro cerrado a la derecha."

	key[]: "aca_msg_book1_3_15_cutscene09"
	val[]: "Una vez llegues al obstáculo, enderezarás y te mantendrás por el lado izquierdo del carril. Ello te permitirá mantener las ruedas del remolque lejos del bordillo."

	key[]: "aca_msg_book1_3_15_cutscene10"
	val[]: "Seguirás avanzando hasta la siguiente curva."

	key[]: "aca_msg_book1_3_15_cutscene11"
	val[]: "Una vez más, deberás mantenerte en el centro de la calzada para alejar las ruedas del remolque del bordillo."

	key[]: "aca_msg_book1_3_15_cutscene12"
	val[]: "El cruce que sigue es especialmente problemático. En casos como este, no dispones de las condiciones ideales ni para un giro en asa ni para un giro en gancho, por lo que deberás combinar ambas maniobras para llegar hacia donde tienes que ir."

	key[]: "aca_msg_book1_3_15_cutscene13"
	val[]: "Harás un giro amplio, entrarás en la intersección y girarás bruscamente. Recuerda que lo ideal será mantenerse lo más cerca posible del obstáculo para que el giro sea lo más amplio posible."

	key[]: "aca_msg_book1_3_15_cutscene14"
	val[]: "Park in the designated area, secure the truck and shut down the engine."

	# Book 1 Scenario 3_15 formatting
#!{
	key[]: "aca_msg_book1_3_15_cutscene02_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/jug_handle.mat bottom=p256 right=p256 color=FFFFFFFF></align><offset vshift=256>"

	key[]: "aca_msg_book1_3_15_cutscene07_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/button_hook.mat bottom=p256 right=p256 color=FFFFFFFF></align><offset vshift=256>"

#!}


#### 3_15 Driving Instructions

	key[]: "aca_msg_book1_3_15_forward"
	val[]: "Recuerda usar todo el espacio disponible para poder atravesar cada giro.<br><br><font face=/font/big_bold.font>Prepárate para partir y sigue las marcas viales hacia la izquierda.</font>"

	key[]: "aca_msg_book1_3_15_check1"
	val[]: "Aprovecha todo el espacio para realizar un giro abierto y mantener así el remolque lejos del bordillo interior.<br><br><font face=/font/big_bold.font>Realiza un giro en asa.</font>"

	key[]: "aca_msg_book1_3_15_check2"
	val[]: "Toma la curva por el centro de la calzada y continúa recto hacia el siguiente giro.<br><br><font face=/font/big_bold.font>Sigue conduciendo.</font>"

	key[]: "aca_msg_book1_3_15_check3"
	val[]: "El espacio a la izquierda es limitado, por lo que debes adentrarte en la intersección para mantener el remolque alejado del bordillo.<br><br><font face=/font/big_bold.font>Realiza un giro en gancho.</font>"

	key[]: "aca_msg_book1_3_15_check4"
	val[]: "Continúa avanzado y toma la siguiente curva.<br><br><font face=/font/big_bold.font>Sigue conduciendo.</font>"

	key[]: "aca_msg_book1_3_15_check5"
	val[]: "El siguiente giro es el más cerrado de todos, y valerse de una sola maniobra para superarlo no será suficiente.<br><br><font face=/font/big_bold.font>Realiza el giro lo más abierto posible.</font>"

	key[]: "aca_msg_book1_3_15_check6"
	val[]: "<font face=/font/big_bold.font>Dirígete a la plaza de aparcamiento que tienes delante y a la derecha.</font>"
#!{
	key[]: "aca_msg_book1_3_15_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_15_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_15_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}


#@}

#+ Book 1 Scenario 3_16
#@{

#### 3_16 common
	key[]: "aca_scenario_book1_3_16_title"
	val[]: "Estacionamiento marcha atrás en diagonal"

	key[]: "aca_scenario_book1_3_16_desc"
	val[]: "En esta práctica estacionaremos en diagonal marcha atrás, algo común en áreas de descanso, paradas de camiones e incluso empresas de transporte. A menudo te encontrarás con poco espacio debido a que estos lugares pueden estar llenos de vehículos, así que estacionar puede ser una tarea tediosa."

#### 3_16 goal

	key[]: "aca_goal_book1_3_16_check1"
	val[]: "Girar el remolque"
#!{
	key[]: "aca_goal_book1_3_16_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_16_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_16_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_16_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
 #!}
#### 3_16 msg - intro text

	key[]: "aca_msg_book1_3_16_cutscene1"
	val[]: "Aparcar en diagonal parece fácil a primera vista, pero puede resultar más complicado que las típicas maniobras de estacionamiento en callejón."

	key[]: "aca_msg_book1_3_16_cutscene2"
	val[]: "Te desplazarás marcha atrás hacia la plaza de aparcamiento manteniendo la cabeza tractora y el remolque alineados por ahora."

	key[]: "aca_msg_book1_3_16_cutscene3"
	val[]: "A medida que te aproximes, dejarás que el remolque se acerque a los camiones estacionados. Esto te ayudará a maniobrarlo después."

	key[]: "aca_msg_book1_3_16_cutscene4"
	val[]: "Empezarás girando el remolque hacia el estacionamiento. Deberás mantenerlo junto al camión del lado del conductor, ya que necesitarás el espacio disponible al otro lado."

	key[]: "aca_msg_book1_3_16_cutscene5"
	val[]: "Una vez el remolque se encuentre en el interior de la plaza de aparcamiento, girarás la cabeza tractora para alinearla."

	key[]: "aca_msg_book1_3_16_cutscene6"
	val[]: "Aparcarás en la zona designada, asegurarás el camión y apagarás el motor."

#### 3_16 Driving Instructions

	key[]: "aca_msg_book1_3_16_start"
	val[]: "Debes estacionar en el espacio que tienes detrás de ti. Usa ambos retrovisores para guiarte marcha atrás.<br><br><font face=/font/big_bold.font>Prepárate para partir.</font>"

	key[]: "aca_msg_book1_3_16_backward"
	val[]: "Echa un vistazo a tu alrededor y muévete hasta la plaza de aparcamiento.<br><br><font face=/font/big_bold.font>Comienza a desplazarte marcha atrás.</font>"

	key[]: "aca_msg_book1_3_16_check1"
	val[]: "Mueve el remolque hacia los camiones que tienes al lado y gíralo rumbo a la plaza de aparcamiento. Recuerda prestar atención al desplazamiento de la parte posterior del remolque.<br><br><font face=/font/big_bold.font>Gira hacia la plaza de aparcamiento.</font>"
#!{
	key[]: "aca_msg_book1_3_16_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_16_end"
	val[]: "@@aca_msg_book1_2_01_end@@"


 #!}


#@}

#+ Book 1 Scenario 3_17
#@{

#### 3_17 common
	key[]: "aca_scenario_book1_3_17_title"
	val[]: "Conducción marcha atrás por giros"

	key[]: "aca_scenario_book1_3_17_desc"
	val[]: "En esta práctica giraremos marcha atrás con un remolque por primera vez. Exploraremos los conceptos básicos para hacerlo mientras no perdemos de vista lo que debemos tener en cuenta."

#### 3_17 goal

	key[]: "aca_goal_book1_3_17_check1"
	val[]: "Girar el remolque"
#!{
	key[]: "aca_goal_book1_3_17_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_17_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_17_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_17_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
 #!}
#### 3_17 msg - intro text

	key[]: "aca_msg_book1_3_17_cutscene01"
	val[]: "En esta ocasión, vamos a dar marcha atrás hasta una plaza de aparcamiento ubicada detrás de ti por el lado del conductor."

	key[]: "aca_msg_book1_3_17_cutscene02"
	val[]: "Pero antes, te daremos algunos consejos que te ayudarán a hacerlo. Primero: es importante señalar que el remolque siempre girará en dirección opuesta a la de la cabeza tractora."

	key[]: "aca_msg_book1_3_17_cutscene03"
	val[]: "Segundo: podrás hacerte una idea de hacia donde se dirige mientras observas los ejes tanto del camión como del remolque."

	key[]: "aca_msg_book1_3_17_cutscene04"
	val[]: "Tercero: no hace falta precipitarse para llevarlo hacia donde quieres, basta con ir poco a poco."

	key[]: "aca_msg_book1_3_17_cutscene05"
	val[]: "Comenzarás girando el camión lejos de la plaza de aparcamiento para que el remolque vaya situándose en posición."

	key[]: "aca_msg_book1_3_17_cutscene06"
	val[]: "Seguirás guiando el remolque a medida que maniobras para ir manteniendo el rumbo."

	key[]: "aca_msg_book1_3_17_cutscene07"
	val[]: "Tendrás que prestar atención a las ruedas del remolque y a la rueda trasera del camión. Estas te indicarán hacia donde se mueve el remolque y hacia dónde lo empuja la cabeza tractora."

	key[]: "aca_msg_book1_3_17_cutscene08"
	val[]: "Ten en cuenta que es mucho más fácil hacer girar rápidamente el remolque que enderezarlo tras una maniobra de tijera. Apunta hacia el exterior de la plaza de aparcamiento y, una vez te encuentres cerca de la misma, podrás hacer un giro más cerrado para alinearlo."

	key[]: "aca_msg_book1_3_17_cutscene09"
	val[]: "Cuando el remolque entre en la plaza de aparcamiento, sitúa la cabeza tractora mirando hacia el frente. Procura no hacer demasiadas maniobras en el interior."

	key[]: "aca_msg_book1_3_17_cutscene10"
	val[]: "Continuarás marcha atrás entre las barreras observando a ambos lados mientras procedes."

	key[]: "aca_msg_book1_3_17_cutscene11"
	val[]: "Te detendrás en la plaza de aparcamiento y asegurarás el camión."

#### 3_17 Driving Instructions

	key[]: "aca_msg_book1_3_17_start"
	val[]: "Sigue estos consejos cuando vayas a maniobrar un remolque:<br><br>El remolque gira siempre en dirección opuesta a la del camión.<br><br>Observa las ruedas del remolque para ver hacia dónde apunta.<br><br>Observa la rueda trasera del camión para ver hacia dónde empuja el remolque.<br><br>Deja que el remolque haga el trabajo sin llegar a sobrevirarlo.<br><br>Recuerda que es más fácil hacer girar rápidamente el remolque que enderezarlo posteriormente.<br><br><font face=/font/big_bold.font>Prepárate para partir.</font>"

	key[]: "aca_msg_book1_3_17_backward"
	val[]: "Mira detrás de ti para ver dónde se encuentra la plaza de aparcamiento, y comprueba siempre los alrededores antes de iniciar la marcha.<br><br><font face=/font/big_bold.font>Conduce hacia atrás.</font>"

	key[]: "aca_msg_book1_3_17_check1"
	val[]: "Comienza a girar el remolque para alinearlo con la plaza de aparcamiento y continúa.<font face=/font/big_bold.font>Guía el remolque.</font>"

	key[]: "aca_msg_book1_3_17_stop"
	val[]: "<font face=/font/big_bold.font>Detente en la zona designada.</font>"
#!{
	key[]: "aca_msg_book1_3_17_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_18
#@{

#### 3_18 common
	key[]: "aca_scenario_book1_3_18_title"
	val[]: "Estacionamiento en callejón"

	key[]: "aca_scenario_book1_3_18_desc"
	val[]: "En esta práctica llevarás el remolque marcha atrás hacia una calleja al final de la carretera."

#### 3_18 goal

	key[]: "aca_goal_book1_3_18_check1"
	val[]: "Girar el remolque"
#!{
	key[]: "aca_goal_book1_3_18_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_18_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


	key[]: "aca_goal_book1_3_18_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_18_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

 #!}
#### 3_18 msg - intro text

	key[]: "aca_msg_book1_3_18_cutscene01"
	val[]: "Aparcar en sitios así se conoce como estacionamiento en callejón. Este tipo de maniobra suele ser habitual en el día a día de los camioneros, ya sea para cargar o descargar un remolque o echarse un sueño en un área de descanso."

	key[]: "aca_msg_book1_3_18_cutscene02"
	val[]: "Esta maniobra es similar a la de la práctica anterior, pero dispones de menos espacio para maniobrar, por lo que tendrás que planificar tus movimientos en consecuencia y tener cuidado de no colisionar con nada."

	key[]: "aca_msg_book1_3_18_cutscene03"
	val[]: "Como hay poco espacio, la sincronización será vital. Girarás el remolque en el momento adecuado mientras observas la dirección de las ruedas de la cabeza tractora y del remolque. Vigila el desplazamiento de la parte posterior del remolque mientras tienes en mente no acabar haciendo una tijera."

	key[]: "aca_msg_book1_3_18_cutscene04"
	val[]: "Lo mejor es dirigir el remolque hacia la calleja antes que después. Así contarás con espacio al otro lado para girar la parte delantera del remolque y poner la cabeza tractora al frente."

	key[]: "aca_msg_book1_3_18_cutscene05"
	val[]: "Una vez que el remolque entre en la calleja, alinearás la cabeza tractora. Y aunque hacerlo antes de que te lo diga tu instinto es lo mejor, siempre puedes corregir la maniobra mientras vas marcha atrás hacia el lugar deseado."

	key[]: "aca_msg_book1_3_18_cutscene06"
	val[]: "Orientarás la cabeza tractora y el remolque, y te detendrás en la zona designada."

	key[]: "aca_msg_book1_3_18_cutscene07"
	val[]: "Asegurarás el camión y apagarás el motor."


#### 3_18 Driving Instructions

	key[]: "aca_msg_book1_3_18_start"
	val[]: "Ahora intentaremos girar el remolque en una zona mucho más pequeña con una maniobra de estacionamiento en callejón.<br><br><font face=/font/big_bold.font>Prepárate para partir.</font>"

	key[]: "aca_msg_book1_3_18_backward"
	val[]: "Mira a tu alrededor para localizar el lugar en el que estacionar detrás de ti.<br><br><font face=/font/big_bold.font>Desplázate marcha atrás para acercarte a la plaza de aparcamiento.</font>"

	key[]: "aca_msg_book1_3_18_check1"
	val[]: "<font face=/font/big_bold.font>Gira el remolque hasta la plaza de aparcamiento.</font>"
#!{
	key[]: "aca_msg_book1_3_18_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_18_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}


#@}

#+ Book 1 Scenario 3_19
#@{

#### 3_19 common
	key[]: "aca_scenario_book1_3_19_title"
	val[]: "Primera parte del examen final"

	key[]: "aca_scenario_book1_3_19_desc"
	val[]: "Te aguarda un examen final, donde pondremos a prueba todo lo que has aprendido hasta ahora. Nos moveremos por todo el centro de práctica para ver cómo te desenvuelves por las diferentes situaciones que te has encontrado. Una vez completes todos los tramos y maniobras, estarás más cerca de llevar un camión con profesionalidad."

