	key[]: "aca_scenario_book1_3_01_title"
	val[]: "Acoplamiento de remolque"

	key[]: "aca_scenario_book1_3_01_desc"
	val[]: "En esta práctica explicaremos los fundamentos para acoplar y desacoplar el remolque a la cabeza tractora."

