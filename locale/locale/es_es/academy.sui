#+ Book 3 Scenario justc
#@{

#### justc common
	key[]: "aca_scenario_book3_justc_title"
	val[]: "Primera corrección marcha atrás"

	key[]: "aca_scenario_book3_justc_desc"
	val[]: "En esta práctica deberemos continuar la maniobra justo en el punto donde la dejó otra persona."

#### justc goal

#!{
	key[]: "aca_goal_book3_justc_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_justc_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
	key[]: "aca_goal_book3_justc_check1"
	val[]: "Conducir marcha atrás"

#!{
	key[]: "aca_goal_book3_justc_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_justc_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### justc msg - intro text

	key[]: "aca_msg_book3_justc_cutscene1"
	val[]: "Vaya. Parece que alguien se ha frustrado un poco dando marcha atrás y ha dejado el camión en mitad del estacionamiento."

	key[]: "aca_msg_book3_justc_cutscene2"
	val[]: "Pueden darse situaciones en las que todo se vaya al traste. Pero no pasa nada, pues avanzarás para deshacer la tijera y regresarás a una posición manejable.<br><br>Si tienes dudas, solo tienes que enderezar todo y empezar desde cero."

	key[]: "aca_msg_book3_justc_cutscene3"
	val[]: "Esta es una buena posición para empezar. El remolque trasero sigue orientado hacia el punto deseado, por lo que podremos situar la cabeza tractora delante del delantero con rapidez para dirigir el conjunto hacia el destino."

	key[]: "aca_msg_book3_justc_cutscene4"
	val[]: "Procederás hasta la zona designada y asegurarás el camión.<br><br>Recuerda que puedes repetir esta práctica todas las veces que quieras hasta dominar la maniobra con los remolques."

#### justc Driving Instructions

#!{
	key[]: "aca_msg_book3_justc_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_justc_forward"
	val[]: "No hay forma de salir de este lío. Avanza un poco para recuperar una posición manejable."

	key[]: "aca_msg_book3_justc_check1"
	val[]: "Comienza a dar marcha atrás."

#!{
	key[]: "aca_msg_book3_justc_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_justc_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


#+ Straight Backing
#@{

#### straight_backing common

	key[]: "aca_scenario_book3_straight_backing_title"
	val[]: "Marcha atrás en línea recta"

	key[]: "aca_scenario_book3_straight_backing_desc"
	val[]: "En esta práctica tendrás que retroceder en línea recta con un conjunto B-double."

#### straight_backing goal

#!{
	key[]: "aca_goal_book3_straight_backing_start"
	val[]: "@@aca_goal_book3_sup_start@@"
#!}
	key[]: "aca_goal_book3_straight_backing_forward"
	val[]: "Conducir marcha atrás"

#!{
	key[]: "aca_goal_book3_straight_backing_check1"
	val[]: "@@aca_goal_book3_sup_check1@@"

	key[]: "aca_goal_book3_straight_backing_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_straight_backing_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### straight_backing - intro text

	key[]: "aca_msg_book3_straight_backing_cutscene01"
	val[]: "Dar atrás en línea recta puede parecer fácil a primera vista, pero en realidad es bastante más complejo.<br><br>En lugar de limitarte a aumentar o reducir el ángulo entre los remolques por un solo lado, ahora deberás controlar ambos para que el conjunto se mantenga recto."

	key[]: "aca_msg_book3_straight_backing_cutscene02"
	val[]: "Comenzarás haciendo pequeñas correcciones. Es normal que el conjunto oscile hacia ambos lados; recuerda que para ajustar el ángulo entre el remolque delantero y el trasero tendrás que mantener más tiempo el ángulo entre el la cabeza tractora y el remolque delantero."

	key[]: "aca_msg_book3_straight_backing_cutscene03"
	val[]: "Puede que tengas que mover bastante la cabeza tractora para mantener orientado el remolque trasero, pero si evitas excederte desde el principio, no hará falta llegar a ese punto."

	key[]: "aca_msg_book3_straight_backing_cutscene04"
	val[]: "Podrás avanzar cuantas veces necesites para corregir la maniobra. Lo importante es acabar en la plaza de aparcamiento de forma segura; el resto no tiene mayor importancia."

#### Straight Backing Driving Instructions

#!{
	key[]: "aca_msg_book3_straight_backing_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_straight_backing_forward"
	val[]: "Comienza a dar marcha atrás lentamente."

#!{
	key[]: "aca_msg_book3_straight_backing_check1"
	val[]: "@@aca_msg_book3_sup_check1@@"
#!}
	key[]: "aca_msg_book3_straight_backing_stop"
	val[]: "Alinea el conjunto y detente en la zona designada."

	key[]: "aca_msg_book3_straight_backing_end"
	val[]: "Para el motor y asegura el camión."

#@}


#+ Correcting Straight Backing
#@{

#### correcting_straight_backing common

	key[]: "aca_scenario_book3_correcting_straight_backing_title"
	val[]: "Corrigiendo marcha atrás en línea recta"

	key[]: "aca_scenario_book3_correcting_straight_backing_desc"
	val[]: "En esta práctica te pondrás al volante tras el intento de otro conductor de dar marcha atrás en línea recta. Corregirás su error y aparcarás el camión en el lugar indicado."

#### correcting_straight_backing goal

#!{
	key[]: "aca_goal_book3_correcting_straight_backing_start"
	val[]: "@@aca_goal_book3_sup_start@@"
#!}
	key[]: "aca_goal_book3_correcting_straight_backing_forward"
	val[]: "Enderezar"

	key[]: "aca_goal_book3_correcting_straight_backing_check1"
	val[]: "Conducir marcha atrás"

#!{
	key[]: "aca_goal_book3_correcting_straight_backing_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_correcting_straight_backing_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### correcting_straight_backing - intro text

	key[]: "aca_msg_book3_correcting_straight_cutscene01"
	val[]: "Parece que alguien ha intentado dar marcha atrás con este conjunto para aparcar y ha tenido un pequeño contratiempo. Ahora te toca coger el volante y solucionarlo."

	key[]: "aca_msg_book3_correcting_straight_cutscene02"
	val[]: "El primer paso será avanzar y alinear el conjunto hasta obtener una posición manejable. Es crucial que el remolque trasero quede orientado hacia la dirección deseada."

	key[]: "aca_msg_book3_correcting_straight_cutscene03"
	val[]: "En este caso optaremos por llevar la maniobra hacia el lado del conductor. Esto nos dará una mejor visión de lo que hacemos y nos permitirá maniobrar desde un solo lado.<br><br>Ten presente que controlarás el remolque trasero mediante el delantero, así que no centres tu atención en la cabeza tractora."

	key[]: "aca_msg_book3_correcting_straight_cutscene04"
	val[]: "Una vez el conjunto esté más o menos en posición, avanzaremos de nuevo para alinearlo correctamente."

	key[]: "aca_msg_book3_correcting_straight_cutscene05"
	val[]: "Desde aquí retrocederemos con mucho cuidado hasta colocarnos en la plaza de aparcamiento, asegurándonos de que el remolque trasero no se desvíe de su trayectoria."

	key[]: "aca_msg_book3_correcting_straight_cutscene06"
	val[]: "Ahora podremos alinear el remolque delantero y la cabeza tractora."

#### correcting_Straight_Backing Driving Instructions

#!{
	key[]: "aca_msg_book3_correcting_straight_backing_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_correcting_straight_backing_forward"
	val[]: "Avanza y endereza todo.<br><br>Cuando lo creas oportuno, da marcha atrás hasta la zona indicada."

	key[]: "aca_msg_book3_correcting_straight_backing_check1"
	val[]: "Ve marcha atrás hasta la zona designada."

#!{
	key[]: "aca_msg_book3_correcting_straight_backing_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"
#!}
	key[]: "aca_msg_book3_correcting_straight_backing_end"
	val[]: "Para el motor y asegura el camión."

#@}


#+ Book 3 Scenario backing_90_tight
#@{

#### backing_90_tight common
	key[]: "aca_scenario_book3_backing_90_tight_title"
	val[]: "90 grados marcha atrás"

	key[]: "aca_scenario_book3_backing_90_tight_desc"
	val[]: "En esta práctica realizarás una maniobra de marcha atrás a 90 grados para aparcar junto a otros camiones en hilera."

#### backing_90_tight goal

	key[]: "aca_goal_book3_backing_90_tight_check1"
	val[]: "Girar por completo"

	key[]: "aca_goal_book3_backing_90_tight_check2"
	val[]: "Continuar la marcha"

		key[]: "aca_goal_book3_backing_90_tight_check3"
	val[]: "Reversing"

#!{
		key[]: "aca_goal_book3_backing_90_tight_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_backing_90_tight_end"
	val[]: "@@aca_goal_book3_sup_end@@"

	key[]: "aca_goal_book3_backing_90_tight_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_backing_90_tight_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
#### backing_90_tight msg - intro text

	key[]: "aca_msg_book3_backing_90_tight_cutscene1"
	val[]: "Es más fácil retroceder con B-doubles hacia un lado, ya que tendrás una mejor vista de la maniobra desde la ventanilla."

	key[]: "aca_msg_book3_backing_90_tight_cutscene2"
	val[]: "Primero avanzarás y harás cambio de sentido al final de la hilera. De este modo podrás posicionarte por el lado que te ofrecerá una mejor visión de la maniobra a través de la ventanilla del conductor."

	key[]: "aca_msg_book3_backing_90_tight_cutscene3"
	val[]: "Podrás colocar los remolques como mejor te convenga, quizá con el trasero ya apuntando al la plaza de aparcamiento. En este caso empezaremos desde una posición recta.<br><br>Recuerda no complicarte y guía el remolque trasero a través del delantero."

	key[]: "aca_msg_book3_backing_90_tight_cutscene4"
	val[]: "Girarás ligeramente el remolque delantero alejándolo de la plaza de aparcamiento, y verás como el remolque trasero empezará a orientarse hacia ella. A partir de ahí, ajustarás el ángulo entre ambos remolques para mantener una trayectoria controlada hacia el espacio de estacionamiento."

	key[]: "aca_msg_book3_backing_90_tight_cutscene5"
	val[]: "Ten presente que, si el remolque trasero entra muy cerrado, tendrás que reducir el ángulo del conjunto. Si por el contrario va muy abierto, deberás aumentarlo para corregirlo."

	key[]: "aca_msg_book3_backing_90_tight_cutscene6"
	val[]: "Los ajustes que hagas con la cabeza tractora tienen solo la mitad de efecto en el remolque trasero que en el delantero, así que no tengas miedo de moverla con decisión."

	key[]: "aca_msg_book3_backing_90_tight_cutscene7"
	val[]: "A estas alturas deberías anticiparte a lo que viene. Además de colocar el remolque trasero, tendrás que introducir el delantero en la plaza de aparcamiento, así que empezarás a preparar la maniobra para alinearlo justo delante del trasero."

	key[]: "aca_msg_book3_backing_90_tight_cutscene8"
	val[]: "Suele ser raro acertar a la primera. En este caso nos hemos demorado en enderezar el delantero y ahora el trasero se está desviando de la trayectoria.<br><br>No pasa nada, solo tendrás que avanzar un poco y probar de nuevo."

	key[]: "aca_msg_book3_backing_90_tight_cutscene9"
	val[]: "Mueve el volante con firmeza para colocar los remolques en la posición deseada. Podrás avanzar las veces que haga falta hasta que la maniobra te convenza."

	key[]: "aca_msg_book3_backing_90_tight_cutscene10"
	val[]: "Y con eso, conseguiremos estacionar el conjunto B-double sin problemas."

#### backing_90_tight Driving Instructions

#!{
	key[]: "aca_msg_book3_backing_90_tight_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_backing_90_tight_forward"
	val[]: "Avanza hasta el final del aparcamiento y da la vuelta."

	key[]: "aca_msg_book3_backing_90_tight_check1"
	val[]: "No olvides abrirte bien en el giro."

	key[]: "aca_msg_book3_backing_90_tight_check2"
	val[]: "Sigue avanzando hasta que tengas el espacio que necesitas para maniobrar, y después comienza a dar marcha atrás."

	key[]: "aca_msg_book3_backing_90_tight_check3"
	val[]: "Reverse into the parking spot."

#!{
	key[]: "aca_msg_book3_backing_90_tight_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_backing_90_tight_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


#+ Book 3 Scenario correcting_90
#@{

#### correcting_90 common
	key[]: "aca_scenario_book3_correcting_90_title"
	val[]: "Corrigiendo marcha atrás a 90 grados"

	key[]: "aca_scenario_book3_correcting_90_desc"
	val[]: "En esta práctica tu tarea será completar una maniobra marcha atrás a 90 grados que otra persona ha dejado a medias."

