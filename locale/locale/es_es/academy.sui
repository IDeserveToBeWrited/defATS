	key[]: "aca_goal_book1_3_03_check1"
	val[]: "Realizar el giro"

	key[]: "aca_goal_book1_3_03_check2"
	val[]: "Roundabout"

	key[]: "aca_goal_book1_3_03_check3"
	val[]: "Hacer el giro de 90 grados"

	key[]: "aca_goal_book1_3_03_check4"
	val[]: "Realizar un giro en asa"

	key[]: "aca_goal_book1_3_03_check5"
	val[]: "Realizar un giro en gancho"

	key[]: "aca_goal_book1_3_03_check6"
	val[]: "Tight Turn"


#### generic phrase

	key[]: "aca_goal_book1_3_03_chk_point"
	val[]: "Sortear las barreras"

#### 3_03 msg - intro text

	key[]: "aca_msg_book1_3_03_cutscene01"
	val[]: "Al frente te encontrarás una serie de obstáculos y cruces desafiantes. Pon en práctica todo lo que has aprendido hasta ahora y no te será complicado avanzar."

	key[]: "aca_msg_book1_3_03_cutscene02"
	val[]: "El primer cruce será un sencillo giro en gancho fácil. No debería suponer un problema si te abres."

	key[]: "aca_msg_book1_3_03_cutscene03"
	val[]: "Lo siguiente será atravesar una rotonda."

	key[]: "aca_msg_book1_3_03_cutscene04"
	val[]: "Tendrás que mantener el remolque alejado del interior de la rotonda abriéndote con la cabeza tractora mientras la rodeas."

	key[]: "aca_msg_book1_3_03_cutscene05"
	val[]: "El giro de 90 grados a la izquierda no es especialmente cerrado, pero deberás asegurarte de no golpear ningún cono de tráfico."

	key[]: "aca_msg_book1_3_03_cutscene06"
	val[]: "Este giro es bastante más cerrado. Deberás usar la maniobra de giro en asa para superarlo."

	key[]: "aca_msg_book1_3_03_cutscene07"
	val[]: "Podrás usar un giro en gancho para atravesar el siguiente, pero presta atención a los obstáculos que debes evitar."

	key[]: "aca_msg_book1_3_03_cutscene09"
	val[]: "El giro final también es muy cerrado, por lo que tendrás que combinar un giro en asa y un giro en gancho para atravesarlo."

	key[]: "aca_msg_book1_3_03_cutscene10"
	val[]: "Park in the designated area, secure the truck and shut down the engine."


#### 3_03 Driving Instructions



	key[]: "aca_msg_book1_3_03_forward"
	val[]: "<font face=/font/big_bold.font>Procede hasta el primer giro.</font>"

	key[]: "aca_msg_book1_3_03_check1"
	val[]: "El primero se trata de un giro en gancho sencillo.<br><br><font face=/font/big_bold.font>Realiza el giro.</font>"

	key[]: "aca_msg_book1_3_03_check2"
	val[]: "Continúa por la rotonda. Recuerda abrirte al circular por ella.<br><br><font face=/font/big_bold.font>Atraviesa la rotonda.</font>"

	key[]: "aca_msg_book1_3_03_check3"
	val[]: "Este giro de 90 grados es un poco más cerrado. Cuidado con los conos de tráfico.<br><br><font face=/font/big_bold.font>Haz el giro.</font>"

	key[]: "aca_msg_book1_3_03_check4"
	val[]: "Abordarás mejor este tramo con un giro en asa. Ábrete antes de acceder a la intersección.<br><br><font face=/font/big_bold.font>Realiza el giro indicado.</font>"

	key[]: "aca_msg_book1_3_03_check5"
	val[]: "Este giro está plagado de obstáculos, pero puede superarse con un giro en gancho.<br><br><font face=/font/big_bold.font>Procede con precaución.</font>"

	key[]: "aca_msg_book1_3_03_check6"
	val[]: "El siguiente es el giro más cerrado de todos. Tómalo como consideres oportuno.<br><br><font face=/font/big_bold.font>Gira hasta la plaza de aparcamiento.</font>"
