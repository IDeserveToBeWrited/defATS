	key[]: "aca_msg_book3_correcting_90_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_correcting_90_forward"
	val[]: "Desplázate hacia delante para salir del embrollo y poder así maniobrar los remolques hasta el lugar indicado."

	key[]: "aca_msg_book3_correcting_90_check1"
	val[]: "Circula marcha atrás hasta la plaza de aparcamiento."

