#### night_slalom_double into text

	key[]: "aca_msg_book3_night_slalom_cutscene01"
	val[]: "El recorrido que sigue incluye un par de eslalones con dificultad variable a lo largo del tramo."

	key[]: "aca_msg_book3_night_slalom_cutscene02"
	val[]: "Deberás proceder con calma y anticiparte mientras avanzas por el recorrido."

	key[]: "aca_msg_book3_night_slalom_cutscene03"
	val[]: "Habrá zonas en las que tendrás que reducir casi hasta detenerte y afinar al máximo la maniobra.<br><br>No te precipites."


#### night_slalom_double driving instructions

#!{
	key[]: "aca_msg_book3_night_slalom_double_check1"
	val[]: "@@aca_goal_book3_sup_check1@@"

	key[]: "aca_msg_book3_night_slalom_double_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
#!}
	key[]: "aca_msg_book3_night_slalom_double_forward"
	val[]: "Avanza cuando desees, y recuerda usar el alumbrado."

	key[]: "aca_msg_book3_night_slalom_double_check0"
	val[]: "Circula a través de los eslalones."

	key[]: "aca_msg_book3_night_slalom_double_stop"
	val[]: "Detente en la zona designada."

	key[]: "aca_msg_book3_night_slalom_double_end"
	val[]: "Para el motor y asegura el camión."

#+ Book 3 Scenario Truckstop Angle
#@{

#### trckstp common

	key[]: "aca_scenario_book3_trckstp_title"
	val[]: "Aparcando en una curva"

	key[]: "aca_scenario_book3_trckstp_desc"
	val[]: "En esta práctica tendrás que abrirte paso por un estacionamiento abarrotado de camiones mal aparcados y hacerlo en una curva."

#### trckstp goal

#!{
	key[]: "aca_goal_book3_trckstp_check1"
	val[]: "@@aca_goal_book3_sup_check1@@"

	key[]: "aca_goal_book3_trckstp_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_trckstp_end"
	val[]: "@@aca_goal_book3_sup_end@@"

	key[]: "aca_goal_book3_trckstp_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_trckstp_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
#### trckstp msg - intro text

	key[]: "aca_msg_book3_trckstp_cutscene1"
	val[]: "No es raro encontrarse un aparcamiento abarrotado de camiones, lo que limita mucho tus posibilidades de encontrar un lugar donde estacionar."

	key[]: "aca_msg_book3_trckstp_cutscene2"
	val[]: "En esta ocasión solo queda un hueco donde tu conjunto B-double puede entrar.<br><br>Recorre el aparcamiento y aparca en la curva cercana a la salida."

#### trckstp Driving Instructions

#!{
	key[]: "aca_msg_book3_trckstp_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_trckstp_forward"
	val[]: "Avanza por el aparcamiento y aparca junto a la curva."

	key[]: "aca_msg_book3_trckstp_check1"
	val[]: "No podrás completar el giro en este punto, así que deberás retroceder y buscar una alternativa para avanzar."

	key[]: "aca_msg_book3_trckstp_check2"
	val[]: "Aparca en la curva que tienes delante."

	key[]: "aca_msg_book3_trckstp_stop"
	val[]: "Detente en la zona designada."

	key[]: "aca_msg_book3_trckstp_end"
	val[]: "Asegura el camión y detén el motor."

#@}


#+ Book 3 Scenario finex
#@{

#### finex common

	key[]: "aca_scenario_book3_finex_title"
	val[]: "Examen final"

	key[]: "aca_scenario_book3_finex_desc"
	val[]: "Es esta práctica pondrás a prueba tus nuevas habilidades en un recorrido diseñado para evaluar tu precisión y comprensión conduciendo B-doubles."

#### finex goal

	key[]: "aca_goal_book3_finex_check0"
	val[]: "Conducir marcha atrás"

	key[]: "aca_goal_book3_finex_check1"
	val[]: "Acceder al recorrido"

	key[]: "aca_goal_book3_finex_check2"
	val[]: "Coger velocidad"

	key[]: "aca_goal_book3_finex_check22"
	val[]: "Preparar la frenada"

	key[]: "aca_goal_book3_finex_speed"
	val[]: "No alcanzar la velocidad"

#!{
	key[]: "aca_goal_book3_finex_check4"
	val[]: "@@aca_goal_book3_sup_check1@@"
#!}
	key[]: "aca_goal_book3_finex_check5"
	val[]: "Estacionar en el lugar indicado"

#!{
	key[]: "aca_goal_book3_finex_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_finex_end"
	val[]: "@@aca_goal_book3_sup_end@@"

	key[]: "aca_goal_book3_finex_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_finex_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
#### finex msg - intro text

	key[]: "aca_msg_book3_finex_cutscene1"
	val[]: "Te damos la bienvenida al examen final. Hemos preparado varias situaciones realistas que podrías encontrarte en carretera para ver cómo te las apañas. Tómate tu tiempo y ve con cuidado."

#### finex Driving Instructions

	key[]: "aca_msg_book3_finex_check0"
	val[]: "El camino está bloqueado; da la vuelta usando el espacio disponible."

	key[]: "aca_msg_book3_finex_check1"
	val[]: "Seguirás avanzando hasta el centro urbano."

	key[]: "aca_msg_book3_finex_check2"
	val[]: "Alcanza los 37 km/h, o 60 mph, mientras procedes por el centro urbano."

	key[]: "aca_msg_book3_finex_check22"
	val[]: "Prepárate para frenar."

	key[]: "aca_msg_book3_finex_speed"
	val[]: "No has logrado alcanzar los 37 km/h, o 60 mph."

	key[]: "aca_msg_book3_finex_check4"
	val[]: "Continúa avanzando por el recorrido."

	key[]: "aca_msg_book3_finex_check5"
	val[]: "Tienes una plaza de aparcamiento disponible en la hilera de camiones de la izquierda. Da marcha atrás y aparca."

#!{
	key[]: "aca_msg_book3_finex_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_finex_forward"
	val[]: "Procede hacia delante cuando desees."

#!{
	key[]: "aca_msg_book3_finex_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_finex_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


