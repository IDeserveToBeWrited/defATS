	#### diag common

	key[]: "aca_scenario_book3_diag_title"
	val[]: "Aparcamiento en diagonal con B-doubles"

	key[]: "aca_scenario_book3_diag_desc"
	val[]: "En esta práctica estacionarás un conjunto B-double en una plaza de aparcamiento diagonal dentro de una zona concurrida."

#### diag msg - intro text

	key[]: "aca_msg_book3_diag_cutscene1"
	val[]: "Aparcar de esta manera es algo muy común, ya que habitualmente se encuentran en muchas de las áreas de descanso de las carreteras americanas."

	key[]: "aca_msg_book3_diag_cutscene2"
	val[]: "Avanzarás hasta la plaza de aparcamiento designada al final de la hilera."

	key[]: "aca_msg_book3_diag_cutscene3"
	val[]: "Te mantendrás en la parte exterior del carril, pero sin aproximarte demasiado a las barreras, ya que la parte trasera del remolque podría golpearlas durante el giro."

	key[]: "aca_msg_book3_diag_cutscene4"
	val[]: "Sobrepasarás la plaza de aparcamiento para dejar hueco a ambos remolques, y después te desplazarás hacia el extremo exterior para posicionar el remolque delantero."

	key[]: "aca_msg_book3_diag_cutscene5"
	val[]: "Te detendrás en la plaza de aparcamiento y asegurarás el camión."

#### diag Driving Instructions

#!{
	key[]: "aca_msg_book3_diag_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_diag_forward"
	val[]: "Avanza hacia el final de la hilera y localiza la plaza de aparcamiento."

	key[]: "aca_msg_book3_diag_check1"
	val[]: "Rebasa la plaza de aparcamiento para garantizar que el remolque trasero trace correctamente la trayectoria. Después inicia el giro con un ángulo pronunciado, asegurando que la parte frontal del remolque delantero no roce el camión que tienes al lado."

	key[]: "aca_msg_book3_diag_stop"
	val[]: "Avanza lentamente mientras vas enderezando los remolques y, cuando estén alineados, detente en la zona indicada."

#!{
	key[]: "aca_msg_book3_diag_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


