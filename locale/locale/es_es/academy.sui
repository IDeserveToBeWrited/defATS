#### parallel common
	key[]: "aca_scenario_book3_parallel_title"
	val[]: "Estacionar en paralelo"

	key[]: "aca_scenario_book3_parallel_desc"
	val[]: "En esta práctica aparcaremos un conjunto B-double en paralelo en la vía."

#### parallel goal

	key[]: "aca_goal_book3_parallel_check1"
	val[]: "Conducir marcha atrás"

#!{
	key[]: "aca_goal_book3_parallel_stop"
