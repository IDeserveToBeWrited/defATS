	key[]: "aca_msg_book2_advanced_alley_check1_title"
	val[]: "Recordatorio"


#@}

#+ Book 2 tight_long_backing
#@{
#### common
	key[]: "aca_scenario_book2_tight_long_backing_title"
	val[]: "Aparcamiento hasta los topes"

	key[]: "aca_scenario_book2_tight_long_backing_desc"
	val[]: "En esta práctica tendrás que moverte desde la zona de carga hasta una plaza de aparcamiento llena de obstáculos. Te valdrás de una maniobra de estacionamiento marcha atrás desplazado para aparcar en ella."

#### intro text

	key[]: "aca_scenario_book2_tight_long_backing_cutscene1"
	val[]: "La situación que hemos escogido para esta práctica pretende representar una zona de estacionamiento concurrida de una empresa de logística. La plaza de aparcamiento en la que tendrás que parar se encuentra justo a la derecha."

	key[]: "aca_scenario_book2_tight_long_backing_cutscene2"
	val[]: "Avanzarás hasta la parte vacía del solar y retrocederás hasta la plaza de aparcamiento. Como verás, el espacio es limitado y deberás tener en cuenta algunos obstáculos."

#@}


#+ Book 2 reverse_slalom_nt
#@{
#### common
	key[]: "aca_scenario_book2_reverse_slalom_nt_title"
