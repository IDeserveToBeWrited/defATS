	key[]: "aca_msg_book3_parallel_check1"
	val[]: "Da marcha atrás hacia la ubicación."

	key[]: "aca_msg_book3_parallel_stop"
	val[]: "Detente en la zona designada."

	key[]: "aca_msg_book3_parallel_end"
	val[]: "Asegura el camión y detén el motor."
#@}




