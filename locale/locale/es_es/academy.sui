#### 3_19 msg - intro text

	key[]: "aca_msg_book1_3_19_cutscene01"
	val[]: "Te damos la bienvenida a la primera parte del examen final. A llegado el momento de demostrar cómo te desenvuelves gracias a los conocimientos que has adquirido."

	key[]: "aca_msg_book1_3_19_cutscene02"
	val[]: "Lo primero será acoplar el remolque para circular con él por una ruta de práctica."

	key[]: "aca_msg_book1_3_19_cutscene03"
	val[]: "El primer tramo te llevará por carreteras secundarias hasta el centro urbano."

	key[]: "aca_msg_book1_3_19_cutscene04"
	val[]: "Esta ruta cuenta con diferentes cruces y obstáculos."

	key[]: "aca_msg_book1_3_19_cutscene05"
	val[]: "Una pequeña parte atraviesa el centro urbano."

	key[]: "aca_msg_book1_3_19_cutscene06"
	val[]: "Pondremos a prueba tu habilidad para maniobrar el camión por medio de varios retos y recorridos."

	key[]: "aca_msg_book1_3_19_cutscene07"
	val[]: "Te toparás con situaciones que evaluarán tu concentración sobre todo lo que rodea."

	key[]: "aca_msg_book1_3_19_cutscene08"
	val[]: "Te haremos dar marcha atrás en una instalación industrial."

	key[]: "aca_msg_book1_3_19_cutscene09"
	val[]: "Tras realizar todo lo anterior, te llevaremos de vuelta a @@driving_academy@@."

	key[]: "aca_msg_book1_3_19_cutscene10"
	val[]: "Un corto trayecto por carretera y casi habremos terminado."

	key[]: "aca_msg_book1_3_19_cutscene11"
	val[]: "Para finalizar la prueba tendrás que estacionar adecuadamente. Podrás elegir la maniobra que más te convenga."

	key[]: "aca_msg_book1_3_19_cutscene12"
	val[]: "No temas, ya conoces todo lo que hay que saber para pasar la prueba. Mucha suerte."

#### 3_19 Driving Instructions



	key[]: "aca_msg_book1_3_19_forward"
	val[]: "Empezaremos recogiendo el remolque. Lo encontrarás delante y a la derecha.<br><br><font face=/font/big_bold.font>Conduce hasta el remolque.</font>"

	key[]: "aca_msg_book1_3_19_coupling"
	val[]: "Gira hacia la izquierda y retrocede para acercarte al remolque.<br><br><font face=/font/big_bold.font>Apróximate marcha atrás mientras te alineas.</font>"

	key[]: "aca_msg_book1_3_19_park_br_on"
	val[]: "<font face=/font/big_bold.font>Asegura el camión.</font>"

	key[]: "aca_msg_book1_3_19_connect"
	val[]: "<font face=/font/big_bold.font>Pulsa @@imv_nrm_attach@@ para acoplar el remolque.</font>"

	key[]: "aca_msg_book1_3_19_park_br_off"
	val[]: "Ahora ya puedes ponerte en marcha.<br><br><font face=/font/big_bold.font>Quita el freno de estacionamiento.</font>"

	key[]: "aca_msg_book1_3_19_b_trailer"
	val[]: "Avanza hasta la carretera. No te preocupes, la hemos cerrado al tráfico, así que puedes respetar o ignorar la señalización como consideres oportuno.<br><br><font face=/font/big_bold.font>Sigue conduciendo.</font>"

	key[]: "aca_msg_book1_3_19_check01"
	val[]: "Toma los primeros giros.<br><br><font face=/font/big_bold.font>Sigue conduciendo.</font>"

	key[]: "aca_msg_book1_3_19_check02"
	val[]: "Tras el siguiente giro te encontrarás un eslalon hecho con conos de tráfico.<br><br><font face=/font/big_bold.font>Sortea con cuidado el eslalon.</font>"

	#key[]: "aca_msg_book1_3_19_check02a"
	#val[]: "Continue through the roundabout into the town.<br><br><font face=/font/big_bold.font>Negotiate the roundabout.</font>"

	key[]: "aca_msg_book1_3_19_check02b"
	val[]: "Unos cuantos giros de 90 grados te aguardan más adelante.<br><br><font face=/font/big_bold.font>Sigue conduciendo.</font>"

	key[]: "aca_msg_book1_3_19_check03"
	val[]: "La siguiente curva es extremadamente cerrada y requiere invadir toda la calzada para tomarla correctamente.<br><br><font face=/font/big_bold.font>Gira a la derecha y avanza por la calleja.</font>"

	key[]: "aca_msg_book1_3_19_check04"
	val[]: "Sal de la calleja por la izquierda e incorpórate a la vía principal girando a la derecha.<br><br><font face=/font/big_bold.font>Sigue conduciendo.</font>"

	key[]: "aca_msg_book1_3_19_check05"
	val[]: "Disfruta del trayecto mientras avanzas por la carretera.<br><br><font face=/font/big_bold.font>Continúa recto.</font>"

	key[]: "aca_msg_book1_3_19_check06"
	val[]: "La vía de servicio cuenta con unos giros cerrados de entrada y salida.<br><br><font face=/font/big_bold.font>Realiza los giros con cuidado.</font>"

	key[]: "aca_msg_book1_3_19_check07"
	val[]: "Vas a adentrarte en un eslalon algo más complejo. Avanza despacio y usa los retrovisores.<br><br><font face=/font/big_bold.font>Sigue hacia el eslalon y crúzalo con cuidado.</font>"

	key[]: "aca_msg_book1_3_19_check08"
	val[]: "Ahora accede al polígono industrial. Presta especial atención a la farola.<br><br><font face=/font/big_bold.font>Gira hacia la izquierda.</font>"

	key[]: "aca_msg_book1_3_19_check09"
	val[]: "Prepárate para dar marcha atrás.<br><br><font face=/font/big_bold.font>Gira a la derecha y detente en la zona delimitada.</font>"

	key[]: "aca_msg_book1_3_19_check10"
	val[]: "Inicia la maniobra hacia el recorrido que verás a la izquierda detrás de ti.<br><br><font face=/font/big_bold.font>Conduce hacia atrás.</font>"

	key[]: "aca_msg_book1_3_19_check11"
	val[]: "Sigue por el recorrido.<br><br><font face=/font/big_bold.font>Continúa marcha atrás.</font>"

	key[]: "aca_msg_book1_3_19_check12"
	val[]: "<font face=/font/big_bold.font>Avanza y gira a la derecha.</font>"

	key[]: "aca_msg_book1_3_19_check13"
	val[]: "<font face=/font/big_bold.font>Continúa hasta la puerta de acceso.</font>"

	key[]: "aca_msg_book1_3_19_check14"
	val[]: "Aguarda a que la puerta se abra e incorpórate a la vía principal.<br><br><font face=/font/big_bold.font>Sigue conduciendo.</font>"

	key[]: "aca_msg_book1_3_19_check15"
	val[]: "Mucho cuidado con no golpear la señal.<br><br><font face=/font/big_bold.font>Haz el giro y sigue conduciendo.</font>"

	key[]: "aca_msg_book1_3_19_check16"
	val[]: "<font face=/font/big_bold.font>Gira a la izquierda hacia la autoescuela.</font>"

	key[]: "aca_msg_book1_3_19_check17"
	val[]: "<font face=/font/big_bold.font>Continúa recto.</font>"

	key[]: "aca_msg_book1_3_19_check18"
	val[]: "Mantente en el exterior, ya que te encontrarás un giro cerrado tras la curva.<br><br><font face=/font/big_bold.font>Realiza el giro.</font>"

	key[]: "aca_msg_book1_3_19_check19"
	val[]: "<font face=/font/big_bold.font>Gira a la izquierda y prepárate para estacionar a la izquierda.</font>"

	key[]: "aca_msg_book1_3_19_check20"
	val[]: "<font face=/font/big_bold.font>Circula marcha atrás hasta la plaza de aparcamiento.</font>"
#!{
	key[]: "aca_msg_book1_3_19_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_19_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_19_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
 #!}


#@}


#+ Book 1 Scenario 3_20
#@{

#### 3_20 common
	key[]: "aca_scenario_book1_3_20_title"
	val[]: "Última parte del examen final"

	key[]: "aca_scenario_book1_3_20_desc"
	val[]: "En la última parte del examen se evaluarán los conocimientos que has obtenido para estacionar en las prácticas anteriores. Hazlo con cautela y precisión, y en nada estarás recorriendo las carreteras americanas como conductor acreditado."

