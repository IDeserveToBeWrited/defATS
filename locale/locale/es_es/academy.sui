#+ Book 1 Scenario 3_09
#@{

#### 3_09 common
	key[]: "aca_scenario_book1_3_09_title"
	val[]: "Estacionamiento en diagonal"

	key[]: "aca_scenario_book1_3_09_desc"
	val[]: "Es esta práctica estacionaremos en diagonal en una zona de aparcamiento concurrida. No tendrás mucho espacio por el que maniobrar, así que deberás actuar con precisión y prudencia."

#### 3_09 goal

	key[]: "aca_goal_book1_3_09_check1"
	val[]: "Aproximarse a la plaza de aparcamiento"
#!{
	key[]: "aca_goal_book1_3_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_09_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_09_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
 #!}
#### 3_09 msg - intro text

	key[]: "aca_msg_book1_3_09_cutscene1"
	val[]: "Las plazas de aparcamiento en diagonal son muy comunes. De hecho, es fácil encontrarlas en las áreas de descanso y paradas para camiones de muchas carreteras americanas. Una vez más, tendremos que meter la cabeza tractora en una."

	key[]: "aca_msg_book1_3_09_cutscene2"
	val[]: "Avanzarás hasta la plaza de aparcamiento designada al final de la hilera."

	key[]: "aca_msg_book1_3_09_cutscene3"
	val[]: "Te mantendrás por el centro del carril, o ligeramente hacia la izquierda, para conseguir espacio con el que maniobrar el remolque."

	key[]: "aca_msg_book1_3_09_cutscene4"
	val[]: "Conducirás hasta alejarte un poco de la plaza de aparcamiento para girar con rapidez hacia ella. Necesitarás servirte del retrovisor derecho para comprobar que el remolque accede al interior."

	key[]: "aca_msg_book1_3_09_cutscene5"
	val[]: "Aparcarás en la zona designada, asegurarás el camión y apagarás el motor."


#### 3_09 Driving Instructions

	key[]: "aca_msg_book1_3_09_start"
	val[]: "@@aca_msg_book1_3_09_start_img@@Es importante calcular la posición con precisión al aparcar en diagonal. Una vez que tenemos el giro parcialmente hecho, es difícil dar marcha atrás y corregir la maniobra, por lo que lo ideal es asegurarse de disponer espacio suficiente desde el inicio.<br><br><font face=/font/big_bold.font>Prepárate para partir.</font>"

	key[]: "aca_msg_book1_3_09_forward"
	val[]: "<font face=/font/big_bold.font>Inicia la marcha y avanza hacia la plaza de aparcamiento.</font>"

	key[]: "aca_msg_book1_3_09_check1"
	val[]: "Rebasa la zona de estacionamiento para que el remolque tenga suficiente espacio para moverse.<br><br><font face=/font/big_bold.font>Gira hacia la plaza de aparcamiento.</font>"
#!{
	key[]: "aca_msg_book1_3_09_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}

#@}

#+ Book 1 Scenario 3_10
#@{

#### 3_10 common
	key[]: "aca_scenario_book1_3_10_title"
	val[]: "Marcha atrás sin visibilidad"

	key[]: "aca_scenario_book1_3_10_desc"
	val[]: "En esta práctica veremos cómo dar marcha atrás por el lado del acompañante hacia una plaza de aparcamiento. Al no tener la posibilidad de asomarte por la ventanilla, tendrás que confiar en los retrovisores para llegar al destino."

#### 3_10 goal
#!{
	key[]: "aca_goal_book1_3_10_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_10_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_10_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_10_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

 #!}
#### 3_10 msg - intro text

	key[]: "aca_msg_book1_3_10_cutscene1"
	val[]: "Vamos a ver cómo maniobrar marcha atrás por uno de los puntos ciegos del camión. Por norma general, debe evitarse hacerlo a no ser que no haya alternativa ya que el campo visual es limitado. Tómate tu tiempo y extrema la precaución."

	key[]: "aca_msg_book1_3_10_cutscene2"
	val[]: "Te alejarás de la plaza de aparcamiento para tener espacio en el que poder dar marcha atrás."

	key[]: "aca_msg_book1_3_10_cutscene3"
	val[]: "Te detendrás para echar un vistazo a tu alrededor e iniciarás la maniobra."

	key[]: "aca_msg_book1_3_10_cutscene4"
	val[]: "Girarás la cabeza tractora como si quisieras alejarte. Esto tirará de la parte frontal del remolque al mismo tiempo que orientará la parte posterior hacia la plaza de aparcamiento. Procura no pasarte y acabar haciendo una tijera."

	key[]: "aca_msg_book1_3_10_cutscene5"
	val[]: "Cuando el remolque acceda a la plaza de aparcamiento, enderezarás la cabeza tractora."

	key[]: "aca_msg_book1_3_10_cutscene6"
	val[]: "Te detendrás en la plaza de aparcamiento y asegurarás el camión."

#### 3_10 Driving Instructions

	key[]: "aca_msg_book1_3_10_start"
	val[]: "El procedimiento para desplazarse marcha atrás hacia el lado del acompañante es igual que hacia el del conductor, salvo porque te verás perjudicado por la falta de visibilidad. Sírvete de los retrovisores y de tu buen juicio para estacionar el camión.<br><br><font face=/font/big_bold.font>Prepárate para partir.</font>"

	key[]: "aca_msg_book1_3_10_forward"
	val[]: "Tienes una plaza de aparcamiento delante y a la derecha. Tendrás que rebasarla para poder maniobrar marcha atrás.<br><br><font face=/font/big_bold.font>Sigue avanzando.</font>"
#!{
	key[]: "aca_msg_book1_3_10_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
	key[]: "aca_msg_book1_3_10_check2"
	val[]: "Recuerda que al girar el camión mientras te alejas de la plaza de aparcamiento harás que el remolque apunte hacia ella. Ayúdate de los retrovisores para meterlo.<br><br><font face=/font/big_bold.font>Comienza a dar marcha atrás.</font>"


#@}

#+ Book 1 Scenario 3_11
#@{

#### 3_11 common
	key[]: "aca_scenario_book1_3_11_title"
	val[]: "Conducción por rotondas"

	key[]: "aca_scenario_book1_3_11_desc"
	val[]: "En esta práctica veremos como cruzar una rotonda. Deberás prestar atención al remolque, ya que no seguirá el recorrido de la cabeza tractora de igual forma al entrar, atravesarla o salir."

#### 3_11 goal
#!{
	key[]: "aca_goal_book1_3_11_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_11_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


	key[]: "aca_goal_book1_3_11_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_11_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
 #!}

	key[]: "aca_goal_book1_3_11_check1"
	val[]: "Acceder a la rotonda"

	key[]: "aca_goal_book1_3_11_check2"
	val[]: "Circular por la rotonda"

	key[]: "aca_goal_book1_3_11_check3"
	val[]: "Seguir la marcha"

	key[]: "aca_goal_book1_3_11_check5"
	val[]: "Salir de la rotonda"

	key[]: "aca_goal_book1_3_11_check6"
	val[]: "Conducir hasta la zona designada"

#### 3_11 msg - intro text

	key[]: "aca_msg_book1_3_11_cutscene1"
	val[]: "Las rotondas son cada vez más comunes en las carreteras americanas, así que es importante saber cómo tomarlas."

	key[]: "aca_msg_book1_3_11_cutscene3"
	val[]: "Deberás pegarte al exterior del carril al aproximarte para que el remolque pase al inicio el giro."

	key[]: "aca_msg_book1_3_11_cutscene4"
	val[]: "Te moverás posteriormente hacia el centro de la misma al acceder. Una vez estés dentro, tendrás que abrirte hacia el exterior para mantener el remolque alejado del centro de la rotonda."

	key[]: "aca_msg_book1_3_11_cutscene5"
	val[]: "Mantendrás un ojo en el retrovisor para vigilar que el remolque no se acerca en exceso a las barreras de la parte interior."

	key[]: "aca_msg_book1_3_11_cutscene6"
	val[]: "Salir de la rotonda debería ser sencillo, ya que hemos mantenido el remolque alejado del centro. Harás un giro amplio al salir y todo debería ir bien."

	key[]: "aca_msg_book1_3_11_cutscene7"
	val[]: "Te detendrás en la plaza de aparcamiento y asegurarás el camión."



#### 3_11 Driving Instructions
#!{
	key[]: "aca_msg_book1_3_11_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

	key[]: "aca_msg_book1_3_11_forward"
	val[]: "De frente tienes una rotonda por la que deberás transitar.<br><br><font face=/font/big_bold.font>Aproxímate lentamente a la rotonda.</font>"

	key[]: "aca_msg_book1_3_11_check1"
	val[]: "Haz un giro amplio cuando accedas para que el remolque te siga sin inconvenientes.<br><br><font face=/font/big_bold.font>Entra en la rotonda.</font>"

	key[]: "aca_msg_book1_3_11_check2"
	val[]: "Conduce hasta el exterior de la rotonda. Debes mantener el remolque lo más alejado posible de su centro para evitar las barreras.<br><br><font face=/font/big_bold.font>Sigue por la rotonda.</font>"

	key[]: "aca_msg_book1_3_11_check3"
	val[]: "Mantente cerca de los conos de tráfico del exterior.<br><br><font face=/font/big_bold.font>Sige conduciendo.</font>"

	key[]: "aca_msg_book1_3_11_check5"
	val[]: "<font face=/font/big_bold.font>Abandona la rotonda.</font>"

	key[]: "aca_msg_book1_3_11_check6"
	val[]: "<font face=/font/big_bold.font>Dirígete a la plaza de aparcamiento.</font>"

	key[]: "aca_msg_book1_3_11_stop"
	val[]: "<font face=/font/big_bold.font>Detente en la zona designada.</font>"

	key[]: "aca_msg_book1_3_11_end"
	val[]: "<font face=/font/big_bold.font>Para el motor y asegura el camión.</font>"
#@}

#+ Book 1 Scenario 3_12
#@{

#### 3_12 common
	key[]: "aca_scenario_book1_3_12_title"
	val[]: "Maniobras en espacios estrechos"

	key[]: "aca_scenario_book1_3_12_desc"
	val[]: "En esta práctica tendrás que girar el camión en un espacio reducido. Esto requiere que prestes atención a tu alrededor y uses astutamente el disponible."

#### 3_12 goal



	key[]: "aca_goal_book1_3_12_check1"
	val[]: "Prepararse para dar marcha atrás"

	key[]: "aca_goal_book1_3_12_check2"
	val[]: "Abandonar la zona"

	key[]: "aca_goal_book1_3_12_check3"
	val[]: "Acceder marcha atrás a la ubicación"

	key[]: "aca_goal_book1_3_12_check4"
	val[]: "Maniobrar por el lado ciego"
#!{
	key[]: "aca_goal_book1_3_12_check5"
	val[]: "Unused"

	key[]: "aca_goal_book1_3_12_check6"
	val[]: "@@aca_goal_book1_3_11_check6@@"

