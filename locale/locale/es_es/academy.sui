	key[]: "aca_msg_book1_1_05_high_beam_off_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/high_beam.mat width=336 height=76 color=FFFFFFFF></align><offset vshift=76>"

	key[]: "aca_msg_book1_1_05_lblinker_off_img"
