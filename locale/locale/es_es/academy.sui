#+ Book 1 Scenario 3_05
#@{

#### 3_05 common
	key[]: "aca_scenario_book1_3_05_title"
	val[]: "Marcha atrás con remolque"

	key[]: "aca_scenario_book1_3_05_desc"
	val[]: "En esta práctica probarás a dar marcha atrás con un remolque por primera vez. No es una maniobra demasiado complicada, pero tendrás que ir corrigiéndolo hacia la posición adecuada."

	#### 3_05 goal



	key[]: "aca_goal_book1_3_05_check_con"
	val[]: "Dar marcha atrás con el remolque"

	key[]: "aca_goal_book1_3_05_connect"
	val[]: "Conectar el remolque"

	key[]: "aca_goal_book1_3_05_park_br_off"
	val[]: "Quitar el freno de estacionamiento"

	key[]: "aca_goal_book1_3_05_b_trailer"
	val[]: "Alinearse para comenzar a aparcar"

	key[]: "aca_goal_book1_3_05_check1"
	val[]: "Acceder a la plaza de aparcamiento"

	key[]: "aca_goal_book1_3_05_check2"
	val[]: "Alinearse con la plaza de aparcamiento"
