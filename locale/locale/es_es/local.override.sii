#+ Text deviations for American Truck Simulator. Please, use only terms appropriate for USA (i.e. culture specific nuances, not American English).
#@{

#+ Music/radio player
#@{

#+ Hint shown if no music files are found. Also shown as tooltip when hovering over music_player button.

	key[]: "music_player_hint"
	val[]: "Coloca tus canciones en la carpeta <color value=@@clr_sel@@>Documentos/American Truck Simulator/Music<color value=@@clr_txt@@> y podrás verlas aquí."

#+ Tooltip shown when hovering over the radio_stream button.

	key[]: "radio_hint"
	val[]: "Edita el archivo <color value=@@clr_sel@@>live_streams.sii<color value=@@clr_txt@@> en la carpeta <color value=@@clr_sel@@>Documentos/American Truck Simulator<color value=@@clr_txt@@> y escucha tus emisoras de radio en línea favoritas."

#+ Hint shown if no online radio streams are defined.

	key[]: "empty_radio_hint"
	val[]: "Consulta el archivo <color value=@@clr_sel@@>Readme.rtf<color value=@@clr_txt@@> en la carpeta <color value=@@clr_sel@@>Documentos/American Truck Simulator<color value=@@clr_txt@@> para añadir tu propia música y tus emisoras de radio en línea."
#@}

#+ Messages shown as part of the tutorial.
#+
#+ The $KEY$ texts are placeholders for various keys and should be left intact.
#@{

	key[]: "intro_1"
	val[]: "¡Te damos la bienvenida a American Truck Simulator!"
#@}

#+ Input wizard
#@{
	key[]: "wiz_cfg_steam"
	val[]: "Puedes verificar y configurar la asignación de ejes y botones de este controlador usando Steam. La configuración del controlador de Steam para el juego está disponible en Steam > Biblioteca > American Truck Simulator > Configuración del mando."
#@}

#+ Messages shown in the route adviser.
#@{
	key[]: "weigh_illegal_trailer"
	val[]: "La combinación de camión y remolque se encuentra fuera de los parámetros legales del estado." #+ Adviser text
#@}

