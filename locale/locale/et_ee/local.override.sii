#+ Text deviations for American Truck Simulator. Please, use only terms appropriate for USA (i.e. culture specific nuances, not American English).
#@{

#+ Music/radio player
#@{

#+ Hint shown if no music files are found. Also shown as tooltip when hovering over music_player button.

	key[]: "music_player_hint"
	val[]: "Paiguta enda muusika kausta <color value=@@clr_sel@@>American Truck Simulator/music <color value=@@clr_txt@@>, mis asub <color value=@@clr_sel@@>Minu Dokumendid <color value=@@clr_txt@@>kausta all."

#+ Tooltip shown when hovering over the radio_stream button.

	key[]: "radio_hint"
	val[]: "Muuda faili <color value=@@clr_sel@@>live_streams.sii <color value=@@clr_txt@@>, mis asub <color value=@@clr_sel@@>American Truck Simulator <color value=@@clr_txt@@>kaustas, <color value=@@clr_sel@@>Minu Dokumentide all, <color value=@@clr_txt@@>ja kuula oma lemmikraadiot üle interneti läbi mängu!"

#+ Hint shown if no online radio streams are defined.

	key[]: "empty_radio_hint"
	val[]: "Palun lugege faili <color value=@@clr_sel@@>readme.rtf <color value=@@clr_txt@@>, mis asub <color value=@@clr_sel@@>American Truck Simulator <color value=@@clr_txt@@>kaustas, mis omakorda asub <color value=@@clr_sel@@>My Documents <color value=@@clr_txt@@> kaustas, et teada saada kuidas mängu lisada oma muusikat ja internetiraadioid."
#@}

