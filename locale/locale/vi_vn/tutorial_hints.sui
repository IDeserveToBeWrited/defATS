    val[]: "@@viewpoint_title@@ gần đó"

    key[]: "hint_viewpoint_text"
    val[]: "@@viewpoint_title@@ <img src=/material/ui/map/viewpoint_unseen.mat width=20 height=20> đang ở gần đó - hãy tìm và kích hoạt nó để xem đoạn phim cắt cảnh."


    key[]: "hint_resting_title"
    val[]: "Điểm nghỉ ngơi gần đây"

    key[]: "hint_resting_text"
    val[]: "Các điểm dừng chân <img src=/material/ui/map/parking_ico.mat width=20 height=20> giúp bạn hồi phục sức khỏe sau mệt mỏi và có thời gian nghỉ ngơi cần thiết để tiếp tục hành trình một cách an toàn."


    key[]: "hint_gas_title"
    val[]: "Trạm nhiên liệu gần đây"

    key[]: "hint_gas_text"
    val[]: "Bạn có thể sử dụng các trạm nhiên liệu <img src=/material/ui/map/gas_ico.mat width=20 height=20> để tiếp nhiên liệu cho xe của bạn."


    key[]: "hint_car_job_title"
    val[]: "Chuyến hàng đầu tiên"

    key[]: "hint_car_job_text"
    val[]: "Hoàn thành chuyến giao hàng - lái xe an toàn, bảo quản hàng hóa cẩn thận và đến nơi đúng thời gian dự kiến. Hãy lưu ý mức độ ưu tiên của khách hàng, yếu tố này ảnh hưởng đến đánh giá và phần thưởng của bạn.<br><offset vshift=8>Nhấn $KEY_advmouse$ để xem chi tiết công việc."


    key[]: "hint_tour_board_title"
    val[]: "Bảng du lịch"

    key[]: "hint_tour_board_text"
    val[]: "Có một Bảng Thông tin Du lịch ở gần đây. Hãy kích hoạt nó để mở khóa nội dung trong <color value=@@clr_sel@@>@@tourist_atlas_link@@</color>, giúp bạn khám phá các địa danh và điểm tham quan lân cận."


    key[]: "hint_tb_first_title"
    val[]: "Địa điểm đầu tiên đã thám hiểm"

    key[]: "hint_tb_first_text"
    val[]: "Bạn đã khám phá địa điểm đầu tiên của Ban Du lịch địa phương. Bạn có thể xem thông tin chi tiết tại <color value=@@clr_sel@@>@@tourist_atlas_link@@</color>. Hãy khám phá tất cả các địa điểm để tìm hiểu thêm và nhận phần thưởng."


    key[]: "hint_tb_bef_compl_title"
    val[]: "Còn đúng 1 điểm nữa thôi"

    key[]: "hint_tb_bef_compl_text"
    val[]: "Chỉ còn lại một địa điểm nữa trước khi bạn khám phá trọn vẹn Văn phòng Du lịch địa phương đầu tiên và nhận được tấm bưu thiếp của mình."


    key[]: "hint_tb_done_title"
    val[]: "Bảng du lịch đã thám hiểm"

    key[]: "hint_tb_done_text"
    val[]: "Bạn đã khám phá thành công tất cả các địa điểm của một bảng du lịch địa phương. Bạn có thể xem chi tiết tại <color value=@@clr_sel@@>@@tourist_atlas_link@@</color>. Để làm phần thưởng, giờ đây bạn có thể trưng bày tấm bưu thiếp trên xe của mình."


    key[]: "hint_vehicle_prio_title"
    val[]: "Ưu tiên của khách - tình trạng xe"

    key[]: "hint_vehicle_prio_text"
    val[]: "Khách hàng đặc biệt chú trọng đến tình trạng xe – khoản tiền thưởng thêm hoặc mức phạt của bạn sẽ chịu ảnh hưởng lớn bởi tình trạng chiếc xe mà bạn sử dụng. Hãy lái xe an toàn và giữ gìn xe cẩn thận.<br><offset vshift=8>Nhấn $KEY_advmouse$ để xem chi tiết công việc."


    key[]: "hint_cargo_prio_title"
    val[]: "Ưu tiên của khách - bảo quản hàng hóa"

    key[]: "hint_cargo_prio_text"
    val[]: "Khách hàng đặc biệt chú trọng đến khâu xử lý hàng hóa – khoản tiền thưởng hoặc mức phạt của bạn sẽ phụ thuộc rất nhiều vào tình trạng của lô hàng khi giao. Hãy lái xe an toàn và bảo quản hàng hóa cẩn thận.<br><offset vshift=8>Nhấn $KEY_advmouse$ để xem chi tiết công việc."


    key[]: "hint_time_prio_title"
    val[]: "Ưu tiên của khách - quản lý thời gian"

    key[]: "hint_time_prio_text"
    val[]: "Khách hàng đặt mức ưu tiên cao hơn cho việc quản lý thời gian - tiền thưởng hoặc khoản phạt của bạn sẽ bị ảnh hưởng đáng kể bởi khả năng đúng giờ. Hãy lái xe an toàn và đến nơi vào thời gian mà khách hàng mong đợi.<br><offset vshift=8>Nhấn $KEY_advmouse$ để xem chi tiết công việc."


    key[]: "hint_car_deliv_title"
    val[]: "Tiến đến điểm đích"

    key[]: "hint_car_deliv_text"
    val[]: "Hãy dừng xe tại khu vực được đánh dấu để hoàn tất việc giao hàng.<br>Hãy nhớ rằng khách hàng mong đợi được nhận hàng vào một thời điểm cụ thể."


    key[]: "hint_car_early_title"
	val[]: "Đến sớm"

    key[]: "hint_car_early_text"
    val[]: "Việc giao hàng được ấn định vào một thời điểm cụ thể, và việc đến nơi quá sớm sẽ khiến khách hàng không hài lòng. Hãy lên kế hoạch cho hành trình và tận dụng các điểm dừng nghỉ nếu cần thiết."


#!{
    key[]: "hint_sm_throttle_title"
	val[]: "@@throttle_double_tap@@"
#!}

    key[]: "hint_sm_throttle_text"
    val[]: "Bạn có thể bật tính năng kiểm soát ga thông minh trong mục @@desktop_menu_category_options@@. Khi được kích hoạt, xe sẽ mặc định duy trì mức ga thấp. Sau khi nhấn nhanh nút ga hai lần, xe sẽ duy trì mức ga tối đa cho đến khi bạn thả nút."
