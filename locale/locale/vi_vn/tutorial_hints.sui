	val[]: "Sử dụng $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ và $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ để tiến hoặc lùi.<br><offset vshift=8>Sử dụng $SPECIAL_steering$ để lái.<br><offset vshift=8>Thay đổi số bằng <color value=@@clr_sel@@>cần số<color value=@@clr_txt@@>."


    key[]: "hint_depot_deliv_title"
