	val[]: "Sử dụng $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ và $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ để tiến hoặc lùi.<br><offset vshift=8>Sử dụng $SPECIAL_steering$ để lái.<br><offset vshift=8>Nhấn $KEY_gearup$ và $KEY_geardown$ để điều khiển ly hợp."


    key[]: "hint_driv_hshift_title"
