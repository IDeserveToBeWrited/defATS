#+ Text deviations for American Truck Simulator. Please, use only terms appropriate for USA (i.e. culture specific nuances, not American English).
#@{

#+ Music/radio player
#@{

#+ Hint shown if no music files are found. Also shown as tooltip when hovering over music_player button.

	key[]: "music_player_hint"
	val[]: "Hãy sao chép các bài hát của bạn vào thư mục <color value=@@clr_sel@@>American Truck Simulator/music <color value=@@clr_txt@@>trong thư mục <color value=@@clr_sel@@>Documents <color value=@@clr_txt@@>của bạn và bạn sẽ thấy chúng ở đây."

#+ Tooltip shown when hovering over the radio_stream button.

	key[]: "radio_hint"
	val[]: "Chỉnh sửa <color value=@@clr_sel@@>live_streams.sii <color value=@@clr_txt@@>trong thư mục <color value=@@clr_sel@@>American Truck Simulator <color value=@@clr_txt@@>ở <color value=@@clr_sel@@>Documents <color value=@@clr_txt@@>của bạn để có thể nghe các kênh radio ưa thích trên Internet ngay ở trong trò chơi!"

#+ Hint shown if no online radio streams are defined.

	key[]: "empty_radio_hint"
	val[]: "Vui lòng tham khảo tệp <color value=@@clr_sel@@>readme.rtf <color value=@@clr_txt@@>trong thư mục <color value=@@clr_sel@@>American Truck Simulator <color value=@@clr_txt@@>trong thư mục <color value=@@clr_sel@@>Documents <color value=@@clr_txt@@>của bạn để biết cách thêm nhạc và luồng radio của riêng bạn."
#@}

