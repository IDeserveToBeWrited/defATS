#+ Washington TBs and POIs localization.
#@{
	key[]: "tb_wa1"
	val[]: "奧林匹克半島"

	key[]: "tb_wa1_desc"
	val[]: "在奧林匹克半島，海洋、森林與群山共處一地，景致隨時變換。薄霧漫過嶙峋的海岸、瀑布自高地傾瀉而下，而隱密的山谷間則藏著一座座歷史悠久的小鎮。"

	key[]: "poi_wa1_01"
	val[]: "美國歷史郵局"

	key[]: "poi_wa1_01_desc"
	val[]: "這棟建築於 1893 年落成，坐落在湯森港濱水區上方的崖地，當初是以聯邦設施的規格興建，內設海關，反映出這座城市早年立志成為國際貿易新樞紐的企圖心。"

	key[]: "poi_wa1_02"
	val[]: "安吉利斯港"

	key[]: "poi_wa1_02_desc"
	val[]: "安吉利斯港是一座濱海城市，19 世紀作為港口與補給站建立。如今它是通往奧林匹克國家公園的重要門戶，也是連接美加兩國的渡輪港。"

	key[]: "poi_wa1_03"
	val[]: "新月湖"

	key[]: "poi_wa1_03_desc"
	val[]: "新月湖是華盛頓州第二深的湖泊，以湛藍澄澈的湖水聞名，這得歸功於水中極低的氮含量。湖泊位在熱門的遊憩區內，四周環繞著步道與原始林。"
	
	key[]: "poi_wa1_04"
	val[]: "卡拉洛奇海灘"

	key[]: "poi_wa1_04_desc"
	val[]: "卡拉洛奇海灘因「生命之樹」而聞名，那是一棵西特卡雲杉，裸露的樹根橫跨一道通往岸邊的小溪。它不像一般雲杉那樣高聳，而是較矮、較粗，被海風吹得歪斜，成了當地獨一無二的人氣地標。"

	key[]: "poi_wa1_05"
	val[]: "奧林匹克國家公園"

	key[]: "poi_wa1_05_desc"
	val[]: "奧林匹克國家公園保護著多樣的生態系，從崎嶇的太平洋海岸線、溫帶雨林，一路延伸到高山峰頂。它在 1909 年首度被劃為國家紀念地，1938 年由聯邦政府改制為國家公園。"

	key[]: "poi_wa1_06"
	val[]: "格林黑德潮溝"

	key[]: "poi_wa1_06_desc"
	val[]: "格林黑德潮溝是威拉帕灣附近 101 號公路旁的一處小海灣與濕地水道，位在一片濱海河口棲地內。這片棲地經過復育，如今能支持鮭魚產卵，也是觀賞水鳥的好去處。"

	key[]: "poi_wa1_07"
	val[]: "達博灣"

	key[]: "poi_wa1_07_desc"
	val[]: "達博灣是一道深邃的峽灣，孕育著鮭魚、貝類與各種野生動物。1984 年劃設的達博灣自然保護區，在這套運作良好的潮汐濕地系統中守護著罕見的鹽沼與沙嘴植物群落。"


##########################################################################################

	key[]: "tb_wa2"
	val[]: "心臟地帶"

	key[]: "tb_wa2_desc"
	val[]: "華盛頓州的心臟地帶邀你沿著風景公路前行，穿過常綠森林與寧靜的高山湖泊。瑞尼爾山盤踞天際，既獻上經典的山景，也帶你靜靜走進太平洋西北地區的自然風光。"

	key[]: "poi_wa2_01"
	val[]: "瑞尼爾山"

	key[]: "poi_wa2_01_desc"
	val[]: "瑞尼爾山海拔 14,411 英尺，是華盛頓州最高峰，也是一座活躍的層狀火山。山上的冰河餵養河流、雕鑿山谷，也孕育出豐饒的森林與野生動物，是不可或缺的自然地標。"

	key[]: "poi_wa2_02"
	val[]: "韋納奇國家森林"

	key[]: "poi_wa2_02_desc"
	val[]: "韋納奇國家森林橫跨群山、河流與高山谷地。1933 年，平民保育團在此闢建步道與火災瞭望台，為這片森林的遊憩與保育史留下了長遠的印記。"

	key[]: "poi_wa2_03"
	val[]: "貝克山－斯諾夸爾米國家森林"

	key[]: "poi_wa2_03_desc"
	val[]: "貝克山－斯諾夸爾米國家森林擁有全美最早的幾處冰河監測站，自 1900 年代初期起，便持續追蹤喀斯喀特山脈的火山冰流變化與氣候變遷。"
	
	key[]: "poi_wa2_04"
	val[]: "韋納奇河"

	key[]: "poi_wa2_04_desc"
	val[]: "韋納奇河沿岸留有 19 世紀初的灌溉渠道與磨坊遺跡，見證早年移民如何馴服這條河的水力。而早在歐洲人定居之前，原住民部落就仰賴這條盛產鮭魚的河流維生與貿易。"

	key[]: "poi_wa2_05"
	val[]: "克拉瓦提峰"

	key[]: "poi_wa2_05_desc"
	val[]: "克拉瓦提峰在 20 世紀中葉首度被人登頂，但因坡度陡峭、終年覆冰，至今攀登者仍寥寥可數，成了登山客在北喀斯喀特山區尋求孤絕挑戰的夢幻目標。"

	key[]: "poi_wa2_06"
	val[]: "乾瀑布水壩"

	key[]: "poi_wa2_06_desc"
	val[]: "乾瀑布水壩為調節當地水系而建，壩體坐落在史前玄武岩崖頂，一面控制著季節性水流，一面也讓冰河時期洪水刻鑿出的階地與深潭得以重見天日。"

	key[]: "poi_wa2_07"
	val[]: "白山大火觀景台"

	key[]: "poi_wa2_07_desc"
	val[]: "觀景台設有解說牌，介紹 1988 年的白山大火，那是華盛頓州近代規模最大的森林野火之一，至今仍能從林間看出焦痕與植被再生的痕跡。"

	key[]: "wa_cut_helen_desc"
	val[]: "1980 年以前，聖海倫斯火山還是一座圓錐形山峰，有「美國富士山」之稱。那年的噴發削去了山頂 1,300 英尺，留下一個馬蹄形火山口，如今已被熔岩穹丘與冰河部分填滿。"


##########################################################################################


	key[]: "tb_wa3"
	val[]: "葡萄酒鄉"

	key[]: "tb_wa3_desc"
	val[]: "在喀斯喀特山脈以東，華盛頓州的葡萄酒鄉橫跨哥倫比亞谷法定產區，涵蓋席拉溪、路易斯與克拉克州立公園，以及原住民世代生活的土地。這裡日照充足、氣候乾燥，是一片起伏丘陵與河谷交織的風景。"

	key[]: "poi_wa3_01"
	val[]: "清溪瀑布"

	key[]: "poi_wa3_01_desc"
	val[]: "清溪瀑布觀景台就在白隘口峰以東，是熱門的停靠點。再往東約一英哩處有條岔路，通往以垂釣聞名的清湖遊憩區，那裡也是觀察當地野生動物的絕佳去處。"

	key[]: "poi_wa3_02"
	val[]: "席拉溪大橋"

	key[]: "poi_wa3_02_desc"
	val[]: "弗瑞德‧G‧瑞德蒙大橋，又稱席拉溪大橋，是亞基馬郡境內的一座雙拱橋。它落成時是全美最長的混凝土拱橋，也是華盛頓州最高的公路橋。"

	key[]: "poi_wa3_03"
	val[]: "葡萄園"
	
	key[]: "poi_wa3_03_desc"
	val[]: "華盛頓州的谷地與肥沃土壤孕育出大片葡萄藤，品種包括麗絲玲、卡本內與梅洛。這些葡萄園是本州農業的重要一環，也構成了當地的獨特風景。"

	key[]: "poi_wa3_04"
	val[]: "艾德‧漢德勒大橋"

	key[]: "poi_wa3_04_desc"
	val[]: "這座橋建於 1978 年，有時也被稱為城際大橋，橫跨華盛頓州東南部的哥倫比亞河，連接帕斯科與肯納威克兩地。自通車以來，它一直被視為三聯市的地標與象徵。"

	key[]: "poi_wa3_05"
	val[]: "路易斯與克拉克州立公園"

	key[]: "poi_wa3_05_desc"
	val[]: "路易斯與克拉克州立公園是華盛頓州最早的州立公園之一，沿著一條古老的原住民路徑，保存了大片原始林。公園以探索軍團為名，林間景象至今仍呼應著梅里韋瑟‧路易斯當年在日誌裡描述的那片濃密森林。"

	key[]: "poi_wa3_06"
	val[]: "哥倫比亞郡法院"

	key[]: "poi_wa3_06_desc"
	val[]: "哥倫比亞郡法院見證了郡政府主導日常生活的年代。當時地方發展迅速，與州政府所在地往來卻不易，法院便成了最主要的權力中心，直接回應居民的各種需求。"

	key[]: "poi_wa3_07"
	val[]: "美洲原住民部落"

	key[]: "poi_wa3_07_desc"
	val[]: "哥倫比亞谷及周邊一帶，是亞卡瑪、瓦拉瓦拉與尤馬蒂拉等原住民族的家園。時至今日，這些族群仍生活在這片土地上，延續文化傳統，並管理著當地的土地與水資源。"

##########################################################################################

#@}




#+ Oregon TBs and POIs localization.
#@{
	key[]: "tb_or1"
	val[]: "太平洋海岸"

	key[]: "tb_or1_desc"
	val[]: "奧勒岡州的太平洋海岸在一處處崎嶇海岬間展開，沿途景觀點不斷。赫塞塔角燈塔俯瞰著拍岸巨浪，銀點、俄斐休息區、姊妹岩與接吻岩則以玄武岩峭壁之姿，一路迎向太平洋的浪濤。"

	key[]: "landmark_or_astoria_b_desc"
	val[]: "這座橫跨哥倫比亞河的大橋全長四英哩，串起奧勒岡與華盛頓兩州，橋上可以望見河口與太平洋的天際線。"

	key[]: "poi_or1_01"
	val[]: "銀點解說觀景台"

	key[]: "poi_or1_01_desc"
	val[]: "這座觀景台就在坎農海灘南邊，可以一覽乾草堆岩與崎嶇海岸線的遼闊景致，黃昏時分尤其動人。"

	key[]: "or_cut_lighthouse_desc"
	val[]: "奧勒岡州最高的燈塔，建於 1873 年，矗立在紐波特附近的玄武岩海岬上。"

	key[]: "or_cut_newport_desc"
	val[]: "雅奎娜灣大橋於 1936 年完工，是奧勒岡州最具代表性的海岸地標之一。它出自名工程師康德‧麥卡洛之手，優雅的拱形橫跨雅奎娜灣，至今仍是美國 101 號公路上最鮮明的一景。"

	key[]: "or_cut_thor_desc"
	val[]: "佩珀圖阿角上的一處天然海蝕洞，湧浪撲入後隨即塌落，看起來就像整片海洋正被排空一樣。"

	key[]: "poi_or1_02"
	val[]: "俄斐路邊休息區"

	key[]: "poi_or1_02_desc"
	val[]: "金灘附近一處僻靜的路邊停靠點，遊客可以在這裡伸展筋骨、看看浪，或是沿著海灘尋找漂流木與瑪瑙。"

	key[]: "poi_or1_03"
	val[]: "姊妹岩觀景台"

	key[]: "poi_or1_03_desc"
	val[]: "一根根海蝕柱從浪花中拔地而起，氣勢驚人，步道則往下通往藏在峭壁之間的小海灣。"

	key[]: "poi_or1_04"
	val[]: "接吻岩"

	key[]: "poi_or1_04_desc"
	val[]: "金灘以南的一處路邊景點，兩塊巨岩在沙灘上方相互依偎，是遊客最愛的拍照地點。"


##########################################################################################

	key[]: "tb_or2"
	val[]: "狂野東部"

	key[]: "tb_or2_desc"
	val[]: "這一帶常被稱作奧勒岡的狂野東部，地貌歷經數億年的地質作用雕琢而成，其中不少作用至今仍在進行。相較於這樣的時間尺度，人類歷史顯得短暫，卻同樣留下了與這片土地一樣戲劇性的篇章。"

	key[]: "landmark_or_deadman_p_desc"
	val[]: "這處瞭望區位在潘德爾頓附近，可以望見死人關。名稱源自 1870 年代班諾克戰爭期間的一起事件，當時有名馬車伕被發現陳屍於此。而在更早幾十年前，無數輛篷車就曾沿著奧勒岡小徑翻越這些丘陵。"

	key[]: "or_cut_395_desc"
	val[]: "美國 395 號公路，舊稱三旗公路，曾一路從加拿大延伸到墨西哥，串起沙漠、森林與群山。如今它止於加州的 15 號公路，但聖地牙哥一帶仍留有原路線的痕跡。"

	key[]: "poi_or2_01"
	val[]: "馬盧爾國家森林"

	key[]: "poi_or2_01_desc"
	val[]: "馬盧爾國家森林坐落於藍山山脈。一億五千多萬年前，這一帶最古老的岩石曾是太平洋上火山島嶼的一部分，後來才與大陸相接。"
	
	key[]: "poi_or2_02"
	val[]: "惡地荒野"

	key[]: "poi_or2_02_desc"
	val[]: "惡地荒野就在本德東邊，是一片由遠古熔岩流與風積火山灰塑造出的崎嶇火山地景。扭曲的熔岩地形、沙質土壤與荒涼地貌，構成了本州最獨特的高地沙漠環境之一。"

	key[]: "poi_or2_03"
	val[]: "阿伯特湖"

	key[]: "poi_or2_03_desc"
	val[]: "阿伯特湖在 1843 年首度被繪入地圖，但人類在此活動的歷史已超過一萬年。湖水鹽度過高、無法養魚，卻是太平洋遷徙路線上候鳥的重要中繼站。近幾十年來，湖面因氣候變遷而不斷縮小。"

	key[]: "poi_or2_04"
	val[]: "東斯廷斯觀光路線"

	key[]: "poi_or2_04_desc"
	val[]: "東斯廷斯觀光路線沿著 78 號公路，行經斯廷斯山與阿爾沃德沙漠。最精彩的一段是阿爾沃德沙漠的乾湖床，那是奧勒岡州最大的乾涸湖盆之一，會隨著季節在淺湖與遼闊沙原之間變換樣貌。"

	key[]: "poi_or2_05"
	val[]: "多爾蒂坡"

	key[]: "poi_or2_05_desc"
	val[]: "開車走完多爾蒂坡不用一小時，這片岩層源自火山活動；然而大自然要把它雕成今天的模樣，卻花了大約一千六百萬年。"


##########################################################################################

	key[]: "tb_or3"
	val[]: "奧格登之地"

	key[]: "tb_or3_desc"
	val[]: "這條路線沿著奧勒岡內陸的南北向廊道前行，穿越森林與高地沙漠。1820 年代，皮草商人彼得‧斯基恩‧奧格登率先探勘此地；到了第二次世界大戰期間，這裡又因木材與運輸路線而具備了戰略地位。"
	
	key[]: "poi_or3_01"
	val[]: "春田火焰"

	key[]: "poi_or3_01_desc"
	val[]: "這座雕塑高近 65 英尺，矗立在春田市的北側門戶，造型設計成一團火焰，既是旅人的明燈，也是居民與遊客共同的地標。"

	key[]: "poi_or3_02"
	val[]: "桑蒂亞姆馬車道"

	key[]: "poi_or3_02_desc"
	val[]: "此處以東的隘口曾以安德魯‧威利之名稱作威利隘口，1859 年由尋找放牧路線的拓荒者探出。1864 年雖規劃過一條軍用道路，最終大多未能動工。收費的桑蒂亞姆馬車道則從 1868 年營運至 1914 年。"

	key[]: "poi_or3_03"
	val[]: "退伍軍人歷史公路"

	key[]: "poi_or3_03_desc"
	val[]: "在這條公路的北側門戶，18 面紀念標誌中的最後兩面於 2012 年 11 月 9 日設立於比格斯交會處以南。它們標示出魯弗斯營是這條公路的北端入口，而這條公路正是全美第一條獻給二戰退伍軍人的公路。"

	key[]: "poi_or3_04"
	val[]: "奧格登之地景觀點"

	key[]: "poi_or3_04_desc"
	val[]: "這處路邊景點以彼得‧斯基恩‧奧格登為名，他是 19 世紀初的探險家，也是哈德遜灣公司的首席貿易員。景點紀念他在蛇河流域的多次遠征，以及他名列最早探索大鹽湖盆地的先驅之一。"

	key[]: "landmark_or_fremont_b_desc"
	val[]: "這座橋與波特蘭的弗雷蒙街，都以約翰‧C‧弗雷蒙為名，他是加利福尼亞與奧勒岡地區的早期探險家。此橋擁有奧勒岡州最長的主跨距，也是全球第二長的繫拱橋。"

	
##########################################################################################

#@}



#+ California TBs and POIs localization.
#@{
	key[]: "tb_ca1"
	val[]: "金色天際"

	key[]: "tb_ca1_desc"
	val[]: "一座座經典大橋高懸於粼粼水面之上，串起惡魔島、聖塔克魯茲，以及灣區的丘陵與街區。從熙攘的街道與歷史景點，到陽光普照的海灘與海岸線，灣區帶來的加州風情，別處再也找不到。"

	key[]: "ca_cut_golden_gate_bridge_desc"
	val[]: "這座連接舊金山灣與太平洋的大橋，是舊金山乃至整個加州的經典象徵。1937 年通車時，它同時保有全球最長與最高吊橋兩項紀錄。"

	key[]: "poi_ca1_01"
	val[]: "惡魔島"

	key[]: "poi_ca1_01_desc"
	val[]: "惡魔島從 1934 年到 1963 年設有一座聯邦監獄，因關押過全美最惡名昭彰的一批罪犯而聞名，如今已成為歷史景點與熱門觀光勝地。"

	key[]: "ca_cut_richmond_desc"
	val[]: "里奇蒙－聖拉斐爾大橋橫跨舊金山灣，連接里奇蒙與聖拉斐爾兩地。此橋於 1956 年通車，承載著北灣的交通，採懸臂與桁架設計，是區域交通的重要環節。"
	
	key[]: "poi_ca1_02"
	val[]: "金銀島"

	key[]: "poi_ca1_02_desc"
	val[]: "金銀島是為 1939 年金門國際博覽會而填築的人工島。在結束海軍基地的任務後，如今正朝住宅與商業用途重新開發。"

	key[]: "poi_ca1_03"
	val[]: "衝浪之城"

	key[]: "poi_ca1_03_desc"
	val[]: "聖塔克魯茲的衝浪者雕像，向這座城市的衝浪傳統與文化致敬。雕像設於海濱附近，紀念在地的衝浪好手，也紀念這項形塑了聖塔克魯茲身分與海岸社群的運動。"

	key[]: "poi_ca1_04"
	val[]: "瑪丹娜旅店"

	key[]: "poi_ca1_04_desc"
	val[]: "這裡曾是 152 號公路頂端一處人氣鼎盛的餐廳與活動地標，2004 年因公路問題歇業至今，仍是當地歷史與鬼故事論壇上的熱門話題。"



##########################################################################################

	key[]: "tb_ca2"
	val[]: "沙斯塔路線"

	key[]: "tb_ca2_desc"
	val[]: "沙斯塔路線在沙斯塔山下蜿蜒穿行，途經松林與波光閃爍的高山湖泊。道路在隱密的谷地間起伏，載著旅人一路向南，群山逐漸退去，取而代之的是北加州那片古老的紅木林。"

	key[]: "poi_ca2_01"
	val[]: "沙斯塔－三一國家森林"

	key[]: "poi_ca2_01_desc"
	val[]: "沙斯塔－三一國家森林是加州面積最大的國家森林，三一遺產景觀道路貫穿其間，沿著 19 世紀淘金者與拓荒者走過的路線前行。"

	key[]: "poi_ca2_02"
	val[]: "大潟湖"

	key[]: "poi_ca2_02_desc"
	val[]: "大潟湖是洪堡潟湖州立公園三座潟湖中最大、也最南邊的一座。這些淺淺的濱海水盆夾在岩岬之間，海浪堆起的沙洲將潟湖與太平洋隔了開來。"

	key[]: "or_cut_sequoia_desc"
	val[]: "紅木國家公園保護著全世界最高、最古老的一批海岸紅杉，樹高超過 370 英尺，壽命可達 2,000 年。連同鄰近的州立公園在內，它保存了全球僅存原始紅杉林的約 35%。"
	
	key[]: "poi_ca2_03"
	val[]: "史密斯河"

	key[]: "poi_ca2_03_desc"
	val[]: "這片保護區位於加州西北部的六河國家森林內，1990 年經國會劃設，以保存其景觀、生態與文化價值。史密斯河是加州唯一一條未築壩、全程自由流動的大河。"

	key[]: "poi_ca2_04"
	val[]: "威士忌溪大橋"

	key[]: "poi_ca2_04_desc"
	val[]: "威士忌溪大橋落成於 1961 年，是一座三跨徑的焊接鋼板梁橋。它的特別之處在於同時採用三種不同等級的鋼材，在當年是相當創新的焊接工法，堪稱橋梁設計的早期範例。"

	key[]: "poi_ca2_05"
	val[]: "沙斯塔湖"

	key[]: "poi_ca2_05_desc"
	val[]: "沙斯塔湖是加州最大的水庫，由沙加緬度河上的沙斯塔水壩蓄水而成。水壩於 1945 年完工，除了供水與水力發電，也是風景秀麗的休閒去處。"

	key[]: "poi_ca2_06"
	val[]: "沙斯塔山"

	key[]: "poi_ca2_06_desc"
	val[]: "沙斯塔山是喀斯喀特山脈第二高峰，自 1820 年代起，就為西斯基尤小徑上的旅人指引方向。這條路線後來演變成 5 號州際公路，如今每年載著成千上萬的人前來造訪這座山。"



##########################################################################################

	key[]: "tb_ca3"
	val[]: "內華達山之路"

	key[]: "tb_ca3_desc"
	val[]: "在高聳的內華達山脈腳下，本頓旅店坐落於開闊的谷地與綿延丘陵之間。這條路線沿著寧靜的高地沙漠公路蜿蜒前行，遠方的峰頂與嶙峋山脊構成一幅亙古不變的全景，召喚旅人前來探索這片遼闊天地。"

	key[]: "ca_cut_olmsted_point_desc"
	val[]: "優勝美地國家公園成立於 1890 年，是全美最多人造訪的國家公園之一。它以北美最高的優勝美地瀑布、綿密的步道系統，以及樹齡超過 3,000 年的巨杉聞名。"

	key[]: "poi_ca3_01"
	val[]: "蒂奧加公路"

	key[]: "poi_ca3_01_desc"
	val[]: "蒂奧加公路是一條穿越優勝美地國家公園核心地帶的經典景觀道路，也是全加州海拔最高的公路隘口，串連起內華達山脈的東西兩側。"

	key[]: "poi_ca3_02"
	val[]: "莫諾湖"

	key[]: "poi_ca3_02_desc"
	val[]: "莫諾湖已有超過一百萬年的歷史，是北美最古老的湖泊之一。由於沒有天然出水口，數千年來由內華達山脈東側溪流帶進的鹽分與礦物質，全都在此累積下來。"
	
	key[]: "poi_ca3_03"
	val[]: "太浩湖"

	key[]: "poi_ca3_03_desc"
	val[]: "太浩湖約在兩百萬年前於太浩盆地形成，現今的輪廓則由冰河時期的冰川刻鑿而成。它是北美面積最大的高山湖泊，也是全美第二深的湖泊。"

	key[]: "poi_ca3_04"
	val[]: "艾多拉多國家森林"

	key[]: "poi_ca3_04_desc"
	val[]: "艾多拉多國家森林是一處重要集水區的一部分，不僅供水給數百萬加州居民，也支撐著全美近半數蔬果的農業生產。"

	key[]: "poi_ca3_05"
	val[]: "本頓溫泉旅店"

	key[]: "poi_ca3_05_desc"
	val[]: "本頓是莫諾郡最古老的城鎮之一，最早由派尤特族人依溫泉而居。到了 1860 年代，這裡成為移民與礦工的中繼站。旅店在 1940 年代以當地浮石建成，取代了 1904 年那間十個房間共用一套衛浴的舊旅館。"



##########################################################################################

	key[]: "tb_ca4"
	val[]: "烈日與黃沙"

	key[]: "tb_ca4_desc"
	val[]: "死亡谷的沙漠在無垠天空下延展，沙丘、嶙峋山峰與龜裂的平原交錯其間。長耳大野兔跳過烈日曝曬的沙地，散落的獸骨標示著寂靜的通道，孤絕的道路則蜿蜒穿過這片荒涼而不留情面的土地，考驗每一位到訪者，也讓人心生敬畏。"

	key[]: "poi_ca4_01"
	val[]: "孤松鎮"

	key[]: "poi_ca4_01_desc"
	val[]: "孤松鎮是加州歐文斯谷裡的一座小鎮，位在內華達山脈東麓。它以鄰近的阿拉巴馬丘陵聞名，長久以來一直是登山客、攀岩者與電影工作者前往周邊群山與沙漠的門戶。"

	key[]: "poi_ca4_02"
	val[]: "死亡谷國家公園"

	key[]: "poi_ca4_02_desc"
	val[]: "死亡谷是全美最極端的地景之一：最低、最熱、最乾，某些地方卻又最高。早在 1800 年代拓荒者到來之前，原住民部落就已在此生活，在這片嚴酷卻富含歷史的土地上狩獵採集。"

	key[]: "poi_ca4_03"
	val[]: "克勞利神父景觀點"

	key[]: "poi_ca4_03_desc"
	val[]: "這處景觀點是旅人熱門的停靠站。人稱「沙漠神父」的約翰‧J‧克勞利神父，生前經常在此駐足。景觀點靠近國家公園西界，可以望見彩虹峽谷的壯麗景致，那片繽紛地層是遠古火山活動的傑作。"
	
	key[]: "poi_ca4_04"
	val[]: "莫哈維谷地水井"

	key[]: "poi_ca4_04_desc"
	val[]: "在莫哈維沙漠的谷地水井一帶，遠古地下水湧出所留下的沉積物，記錄著冰河時期的濕地環境。這些歷史悠久的水井，揭示了地下水曾如何在這片乾旱沙漠中，孕育出沼澤與茂盛的植被。"

	key[]: "poi_ca4_05"
	val[]: "科羅拉多河印第安保留區"

	key[]: "poi_ca4_05_desc"
	val[]: "這片保留區沿著科羅拉多河，橫跨亞利桑那與加州。它於 1865 年為河域各部落而設，如今是莫哈維、切梅韋維、霍皮與納瓦荷等族的家園，至今仍支撐著當地的農業與社群生活。"

##########################################################################################

#@}



#+ Idaho TBs and POIs localization.
#@{

    key[]: "tb_id1"
	val[]: "寶藏谷"

	key[]: "tb_id1_desc"
	val[]: "愛達荷州西南部的寶藏谷，歷史由美洲原住民部落、早期皮草商人與奧勒岡小徑的移民共同寫成。它的名字反映出這片土地的豐饒物產與機會，後來則隨著農業、鐵路，以及以波夕為中心的區域貿易而蓬勃發展。"

	key[]: "poi_id1_01"
	val[]: "鮭魚河"

	key[]: "poi_id1_01_desc"
	val[]: "愛達荷州的鮭魚河全長 425 英哩，穿行於深邃險峻的峽谷之間。由於水流強勁難行，早年的船隻一旦順流而下就再也逆行不回，因而得到「不歸河」的外號。"

	key[]: "poi_id1_02"
	val[]: "波夕國家森林"

	key[]: "poi_id1_02_desc"
	val[]: "波夕國家森林橫跨易受侵蝕的愛達荷岩基，地貌因火山活動而顯得崎嶇。這樣的地質身世，在陡峭的峽谷與四處散布的天然溫泉裡看得最清楚。"

	key[]: "poi_id1_03"
	val[]: "馬蹄灣"

	key[]: "poi_id1_03_desc"
	val[]: "1862 年波夕盆地發現金礦後，在河邊過冬的礦工建立了馬蹄灣鎮。這裡原本以當地鋸木廠老闆之名叫作沃里納斯維爾，1867 年成為淘金客的重要中繼站後，才改用現在的名字。"
	
	key[]: "poi_id1_04"
	val[]: "收費站"

	key[]: "poi_id1_04_desc"
	val[]: "1864 年，一條新的峽谷路線取代了陡峭的糖漿溪小徑。此後二十年間，通行費支應著道路的維護，而詹姆斯‧A‧波特那間著名的旅館與乳品場，也成了旅人歇腳的首選。"

	key[]: "poi_id1_05"
	val[]: "城堡岩"

	key[]: "poi_id1_05_desc"
	val[]: "在通往卡馬斯草原的路上，城堡岩的花崗岩露頭曾是奧勒岡小徑移民行經古德爾捷徑時的重要地標。從 1862 年一直到汽車時代，這些罕見的岩層始終是旅人沿途最醒目的一景。"

    key[]: "poi_id1_06"
	val[]: "鴨谷印第安保留區"

	key[]: "poi_id1_06_desc"
	val[]: "1886 年，克里夫蘭總統透過「帕迪凱普擴充案」，將鴨谷保留區延伸進愛達荷州。到了 1934 年，先後遷入保留區的各支族群，終於以統一的修修尼－派尤特部落身分獲得聯邦正式承認。"


##########################################################################################

    key[]: "tb_id2"
	val[]: "魔法谷"

	key[]: "tb_id2_desc"
	val[]: "1900 年代初，I.B. 佩林興建米爾納水壩，把愛達荷州乾旱的沙漠變成了農田。水壩於 1905 年完工，引蛇河之水「變魔法」般地改造了這片土地，造就了魔法谷，也催生出至今依然興盛的農業市鎮。"

	key[]: "id_cut_perrine_desc"
	val[]: "修修尼瀑布落差達 212 英尺，比尼加拉瀑布還高，是蛇河上一處秀麗的地標，就座落在特溫福爾斯的邊緣。"

	key[]: "id_cut_galena_desc"
	val[]: "這座礦業小鎮於 1879 年因發現鉛銀礦而興起，但到了 1890 年代便隨金屬價格下跌而沒落。如今這一帶轉型為熱門的遊憩據點，擁有歷史悠久的加利納山莊與風景優美的加利納峰。"

	key[]: "poi_id2_01"
	val[]: "野牛跳崖處"

	key[]: "poi_id2_01_desc"
	val[]: "位於查利斯的野牛跳崖處是一處歷史遺址，原住民曾在此驅趕野牛群衝下懸崖，藉此獵捕食物。這套做法沿用了兩千多年，這片經過精心挑選的地形，也讓人得以一窺古代集體狩獵的傳統。"
	
	key[]: "poi_id2_02"
	val[]: "大景峽谷"

	key[]: "poi_id2_02_desc"
	val[]: "大景峽谷位於 93 號公路上的「峰嶺到火山口」景觀道路旁，可以飽覽失落河山脈的壯麗景色。這道山脈擁有愛達荷州九座最高峰，也讓這處峽谷成為整條景觀公路的亮點。"

	key[]: "landmark_id_mackay_rs_desc"
	val[]: "大失落河原本以皮草獵人提耶里‧戈丁之名，被稱作戈丁河，如今則以河水沒入熔岩層而聞名。這些「失落」的水在地下潛行，最終在蛇河畔壯觀的千泉一帶重新湧出。"

    key[]: "poi_id2_03"
	val[]: "麥凱的鬼城"

	key[]: "poi_id2_03_desc"
	val[]: "以白丘礦區的「礦山」為核心，白丘、崖溪等聚落曾撐起一波延續到 20 世紀中葉的銅、金、銀礦榮景。這些遺址至今仍是愛達荷州礦業史最重要的見證。"

	key[]: "id_cut_craters_desc"
	val[]: "月球隕石坑地區成形於一萬五千年前的火山噴發，境內遍布熔岩流與火山渣錐。這片地貌宛如異星世界，獨特到 NASA 太空人當年還曾在此進行登月任務的訓練。"



##########################################################################################

#@}



#+ Montana TBs and POIs localization.
#@{

    key[]: "tb_mt1"
	val[]: "冰河之路"

	key[]: "tb_mt1_desc"
	val[]: "冰河之鄉擁有落磯山脈少數仍在活動的冰河。數千年來，這些古老的冰體刻鑿出深邃的谷地、銳利的峰頂與清澈的湖泊，也塑造出今日蒙大拿州西部的樣貌。"

	key[]: "poi_mt1_01"
	val[]: "庫特奈瀑布"

	key[]: "poi_mt1_01_desc"
	val[]: "庫特奈瀑布是蒙大拿州最大的未築壩瀑布，也是本區重要的觀光景點。庫特奈河在短短一段距離內驟降約 300 英尺，形成氣勢磅礴的秀麗瀑布，那份震撼的景致總能吸引遊客前來。"

	key[]: "poi_mt1_02"
	val[]: "伯恩路邊公園"

	key[]: "poi_mt1_02_desc"
	val[]: "惡岩峽谷曾是弗拉特黑德河沿線旅人熱門的停靠點，以垂釣、風景與一處天然湧泉聞名，當年還曾用來為過熱的汽車水箱降溫。1956 年，它成為蒙大拿州最早的休息區之一，並命名為伯恩路邊公園。"

	key[]: "poi_mt1_03"
	val[]: "天堂峰"

	key[]: "poi_mt1_03_desc"
	val[]: "天堂峰是冰河國家公園最具代表性的山峰之一，1890 年代由探礦者路易‧梅耶命名。探險家們驚豔於它的秀美與高聳的花園牆，認為這是他們一路走來從未見過的景象。"

	key[]: "mt_cut_glacier_national_park_desc"
	val[]: "素有「大陸之冠」美譽的冰河國家公園成立於 1910 年，地貌由遠古冰河雕琢而成。1932 年，向陽之路完工後，園區交通大為便利，這條公路如今也已是歷史級的工程地標。"

	key[]: "poi_mt1_04"
	val[]: "黑腳族紀念地"

	key[]: "poi_mt1_04_desc"
	val[]: "冰河國家公園東緣是黑腳族的家園。他們有「平原戰士」之稱，族名一般認為源自被灰燼染黑的鹿皮鞋。時至今日，園區內仍有數處地點是該族的聖地。"

	key[]: "mt_cut_flathead_lake_desc"
	val[]: "弗拉特黑德湖是美國本土面積最大的天然淡水湖。湖水由周邊群山的融雪匯注而成，格外清澈，每隔幾年就會完全更新一次，是全球最乾淨的大型湖泊之一。"

	key[]: "mt_cut_thompson_falls_desc"
	val[]: "這座小鎮以英裔加拿大皮草商兼製圖師大衛‧湯普森為名，1881 年鐵路通車後開始興盛。後來又因鄰近的科達倫淘金熱而進一步擴張，成為礦工沿莫瑞小徑北上的重要據點。"

	key[]: "landmark_mt_missoula_desc"
	val[]: "新古典主義風格的密蘇拉郡法院以砂岩建成，由 A‧J‧吉布森於 1910 年設計，取代了原本較小的舊建築。密蘇拉郡成立於 1860 年，是蒙大拿州最古老的行政區之一，範圍從苦根山一路延伸到落磯山脈。"

    key[]: "poi_mt1_05"
	val[]: "洛洛溪"

	key[]: "poi_mt1_05_desc"
	val[]: "洛洛鎮與洛洛隘口之間的廊道，沿著洛洛溪的一條歷史路徑而行。內茲珀斯族人、早期移民與路易斯與克拉克遠征隊都曾走過這裡，如今它仍是一片重要的文化歷史地景，沿途設有解說站。"

##########################################################################################

    key[]: "tb_mt2"
	val[]: "大平原"

	key[]: "tb_mt2_desc"
	val[]: "蒙大拿州的大平原橫亙該州東部，以遼闊草原、起伏草地與開闊天空為特色。這一帶出土過北美最重要的一批恐龍化石，讓人得以窺見數百萬年前的地貌樣貌。"

	key[]: "poi_mt2_01"
	val[]: "地獄溪層"

	key[]: "poi_mt2_01_desc"
	val[]: "地獄溪層以蒙大拿州喬丹鎮附近的地獄溪為核心，保存了一片由河流、森林與沼澤構成的遠古亞熱帶地景。其年代可追溯至六千七百萬至六千六百萬年前，以蘊藏豐富的恐龍化石聞名全球，其中就包括經典的暴龍。"

	key[]: "poi_mt2_02"
	val[]: "黃石河"

	key[]: "poi_mt2_02_desc"
	val[]: "黃石河是美國本土最長的自由流動河川。它發源於黃石國家公園，流經懷俄明與蒙大拿兩州共 676 英哩後匯入密蘇里河，全程沒有任何一座水壩阻隔。"

	key[]: "poi_mt2_03"
	val[]: "格倫龍"

	key[]: "poi_mt2_03_desc"
	val[]: "格倫代夫鎮上的格倫龍是一座等身大的三角龍雕像，彰顯本地豐富的恐龍資產。它高約 10 英尺，是恐龍之路沿線的人氣地標。"
	
	key[]: "poi_mt2_04"
	val[]: "密蘇里河"

	key[]: "poi_mt2_04_desc"
	val[]: "人稱「大泥河」的密蘇里河是全美最長的河流。它自蒙大拿州的落磯山脈一路奔流 2,341 英哩注入密西西比河，在探險、貿易與美國西部拓荒史上都扮演了關鍵角色。"

	key[]: "mt_cut_fort_peck_spillway_desc"
	val[]: "佩克堡水壩興建於經濟大蕭條時期，是全球規模最大的水力沖填式土壩。身為美國最大的公共工程之一，它當初的設計目標就是創造就業、防洪，並發展水力發電。"

    key[]: "poi_mt2_05"
	val[]: "谷郡拓荒者博物館"

	key[]: "poi_mt2_05_desc"
	val[]: "這座博物館透過阿西尼博因族、鐵路、農業、佩克堡水壩與路易斯及克拉克遠征隊等主題展覽，呈現蒙大拿州東北部的歷史。館內也收藏大量檔案，以及全美規模數一數二的阿西尼博因族文物。"

	key[]: "poi_mt2_06"
	val[]: "臥牛石"

	key[]: "poi_mt2_06_desc"
	val[]: "這幾塊巨大的冰河漂礫，是原住民部落心中的神聖地標。它們由遠古冰河刻鑿並搬運至此。較小的那塊「野牛石」被雕成野牛的模樣，較大的「藥石」上則刻有各式各樣的岩畫。"



##########################################################################################

#@}



#+ Wyoming TBs and POIs localization.
#@{

    key[]: "tb_wy1"
	val[]: "野牛之路"

	key[]: "tb_wy1_desc"
	val[]: "這裡是黃石與大提頓的所在地，底下坐落著一套活躍的火山系統，為間歇泉與溫泉提供能量，冰河與斷層則雕塑出峰頂與谷地。這些力量共同造就了懷俄明西北部，讓它成為美國西部地質最活躍、景觀最具代表性的地區之一。"

	key[]: "landmark_wy_yellowsto_desc"
	val[]: "黃石國家公園成立於 1872 年，是全世界第一座國家公園，底下正是一座龐大的休眠火山。全球約半數的活躍間歇泉都在這裡，它同時也守護著地球上面積最大、最完整的溫帶生態系之一。"

	key[]: "poi_wy1_01"
	val[]: "下間歇泉盆地"

	key[]: "poi_wy1_01_desc"
	val[]: "下間歇泉盆地是黃石公園最大的間歇泉盆地，密集分布著間歇泉、溫泉與噴氣孔。它的能量來自地底深處的岩漿，展現出園區內最活躍的地熱地景之一。"

	key[]: "poi_wy1_02"
	val[]: "黃石湖"

	key[]: "poi_wy1_02_desc"
	val[]: "黃石湖是北美面積最大的高海拔湖泊，也孕育著全洲數量最多的野生割喉鱒族群。科學家相信它曾一度往太平洋方向排水，讓魚類得以經由兩洋隘口越過大陸分水嶺。"
	
	key[]: "poi_wy1_03"
	val[]: "水牛比爾水壩"

	key[]: "poi_wy1_03_desc"
	val[]: "水牛比爾水壩於 1910 年完工，是全美最早的混凝土拱壩之一。壩體高 325 英尺，在當時是世界第一高壩，也成了早期工程創新的代表作。"

	key[]: "poi_wy1_04"
	val[]: "科爾特地獄"

	key[]: "poi_wy1_04_desc"
	val[]: "科爾特地獄是修修尼河畔一處歷史悠久的地熱區，1807 年由探險家約翰‧科爾特命名。早年的山地獵人把這裡蒸騰的噴氣孔與硫磺氣味比作「地獄」。如今仍在活動的，只剩溫泉與噴氣孔。"

	key[]: "wy_cut_grand_teton_desc"
	val[]: "大提頓國家公園最鮮明的特色，就是那些冰河刻鑿而成、從傑克森洞平原上陡然拔起的山峰。皮草獵人當年因為老遠就能望見它們，而稱之為「領航丘」；時至今日，這些山峰仍是美國西部最具代表性的地標之一。"

	key[]: "poi_wy1_05"
	val[]: "克羅心台地"

	key[]: "poi_wy1_05_desc"
	val[]: "克羅心台地是一處醒目的地標，名稱源自 1866 年修修尼族與克羅族之間的一場戰役。相傳修修尼族獲勝後，瓦沙基酋長將一名克羅族首領的心臟置於台地頂端以示警告，這個名字便流傳至今。"

##########################################################################################

    key[]: "tb_wy2"
	val[]: "紅色沙漠"

	key[]: "tb_wy2_desc"
	val[]: "懷俄明州的紅色沙漠是一片遼闊的高地沙漠盆地，以風蝕沙丘、山艾樹平原與醒目的紅岩地層著稱。這裡是北美最大的無人居住地區之一，由極端氣候、遠古湖床與漫長的動物遷徙路線共同形塑而成。"

	key[]: "poi_wy2_01"
	val[]: "紅峽谷"

	key[]: "poi_wy2_01_desc"
	val[]: "紅峽谷成形於約六千萬年前風河山脈的隆起過程。它那標誌性的紅色崖壁由查格沃特岩層構成，岩層中氧化的鐵質為峽谷染上了鮮明的色澤，峽谷之名也由此而來。"

	key[]: "poi_wy2_02"
	val[]: "力量的地景"

	key[]: "poi_wy2_02_desc"
	val[]: "野豬獠牙是一座火山岩層，高出懷俄明紅色沙漠 400 多英尺，是一座數百萬年前形成的火山，歷經侵蝕後僅存的核心。它俯瞰著遼闊的基爾佩克沙丘，那是北美最大的活動沙丘群的一部分。"

	key[]: "poi_wy2_03"
	val[]: "石泉城"

	key[]: "poi_wy2_03_desc"
	val[]: "石泉城因移民族群多元，而有「56 個民族之城」的稱號。1800 年代末，來自世界各地的人們湧入此地，在聯合太平洋鐵路的煤礦工作。這座城市也與著名的西部大盜布屈‧卡西迪有所淵源。"
	
	key[]: "poi_wy2_04"
	val[]: "布屈‧卡西迪小屋"

	key[]: "poi_wy2_04_desc"
	val[]: "布屈‧卡西迪是美國著名的西部大盜，率領一群名為「狂野幫」的匪徒，以搶劫火車與銀行聞名於西部拓荒時代。他在石泉城一家肉舖打工時得到了「Butch（屠夫）」這個綽號。他最傳奇、影響也最深遠的一票，是 1899 年的威爾科克斯火車搶案。"

	key[]: "wy_cut_evanston_desc"
	val[]: "埃文斯頓由聯合太平洋鐵路公司於 1869 年建立，以測量員詹姆斯‧A‧埃文斯為名。這座城市以鐵路樞紐的身分發展起來，後來成為農業、石油與天然氣的區域中心。"

    key[]: "poi_wy2_05"
	val[]: "蘭德捷徑"

	key[]: "poi_wy2_05_desc"
	val[]: "蘭德捷徑依 1857 年《太平洋馬車道法案》而建，是美國西部最早由聯邦出資興建的馬車道之一。它以工程師弗雷德里克‧W‧蘭德為名，為西行的移民提供了一條更短的路線。"

	

##########################################################################################

#@}


#+ South Dakota TBs and POIs localization.
#@{

    key[]: "tb_sd1"
	val[]: "黑丘"

	key[]: "tb_sd1_desc"
	val[]: "黑丘與惡地形塑了南達科他州西部的樣貌。在這裡，遼闊的草原隆起成松林覆蓋的山巒、花崗岩尖峰，還有成群漫遊的野牛。再往外走一點，崎嶇的荒地便展現出一片由風與水花費數百萬年刻鑿而成的驚人地景。"

	key[]: "poi_sd1_01"
	val[]: "黑丘國家森林"

	key[]: "poi_sd1_01_desc"
	val[]: "拉科塔族稱這裡為「帕哈薩帕」，意思是「黑色的山丘」。這片松林覆蓋的區域坐擁南達科他州最高點黑麋峰，海拔 7,244 英尺。此峰後來為紀念著名的拉科塔族療者而改名，同時也是落磯山脈以東的最高峰。"

	key[]: "sd_cut_rush_desc"
	val[]: "素有美國「民主聖殿」之稱的拉什莫爾山，於 1927 年至 1941 年間在黑丘的岩壁上雕成。紀念碑上是華盛頓、傑佛遜、羅斯福與林肯四位總統高達 60 英尺的頭像，分別象徵這個國家的誕生、成長、發展與存續。"

	key[]: "poi_sd1_02"
	val[]: "海狸溪大橋"

	key[]: "poi_sd1_02_desc"
	val[]: "這座鋼筋混凝土拱橋建於 1929 年，長 225 英尺，橫跨風洞國家公園附近的一道峽谷。橋面高出谷底 115 英尺，是南達科他州唯一一座同類型的橋，設計上刻意與周圍的岩壁融為一體。"

	key[]: "sd_cut_sturgis_desc"
	val[]: "斯特吉斯以主辦全球規模最大的機車聚會聞名。這項活動由當地印第安機車經銷商帕比‧霍爾於 1938 年發起，每年為期十天，吸引世界各地的騎士齊聚黑丘，參與機車展、賽事、音樂演出與各種慶祝活動。"

	key[]: "sd_cut_deadwood_desc"
	val[]: "戴德伍德因 1876 年黑丘的淘金熱而興起，成為西部拓荒時代最惡名昭彰的城鎮之一。它在 1961 年被指定為國家歷史地標，是全美唯一擁有此地位的城市，市中心大部分的歷史風貌都保存了下來。"

	key[]: "sd_cut_badlands_desc"
	val[]: "惡地國家公園佔地 24 萬 4 千英畝，遍布方山、尖峰與石柱，並與全美面積最大的受保護混合草原相鄰。這裡同時保存著世界上最豐富的化石層之一，揭露了曾在大平原上漫步的遠古哺乳動物。"

	key[]: "poi_sd1_03"
	val[]: "多恩‧羅賓森隧道"

	key[]: "poi_sd1_03_desc"
	val[]: "人稱「拉什莫爾山之父」的多恩‧羅賓森，當年構想在黑丘打造一座宏偉紀念碑，好吸引遊客前來南達科他州。如今他的心願仍在延續：從風景優美的多恩‧羅賓森隧道望出去，拉什莫爾山正好完美地框在其中。"

	key[]: "sd_cut_hot_springs_desc"
	val[]: "溫泉城原本被蘇族稱作「米尼卡塔」，意為「熱水」。1879 年，人們因相信這裡的礦泉具有療效而在此定居，1882 年改為現名後，逐漸發展成療養勝地，至今仍以歷史悠久的埃文斯浴場聞名。"

	key[]: "poi_sd1_04"
	val[]: "猛獁象遺址"

	key[]: "poi_sd1_04_desc"
	val[]: "猛獁象遺址是舉世聞名的冰河時期化石挖掘場，已出土 61 頭猛獁象。這處遠古落水洞於 1974 年被發現，保存著北美規模最大的哥倫比亞猛獁象遺骸，挖掘工作至今仍在進行。"

##########################################################################################

    key[]: "tb_sd2"
	val[]: "大分水嶺"

	key[]: "tb_sd2_desc"
	val[]: "南達科他州的密蘇里河一帶，正是全州的中央分界：一側是遼闊平原，另一側則是綿延丘陵。這裡曾是原住民族、皮草商人以及路易斯與克拉克遠征隊的重要通道，後來則成為大型水壩、拓荒市鎮與豐富河運歷史的所在地。"

	key[]: "poi_sd2_01"
	val[]: "四大湖"

	key[]: "poi_sd2_01_desc"
	val[]: "1940 年代末，密蘇里河上的水壩造就了歐阿希湖、夏普湖、法蘭西斯凱斯湖與路易斯克拉克湖，如今這四座湖勾勒出南達科他州中部的樣貌。它們合計提供超過 440 英哩的湖岸線，供人划船、垂釣與休閒遊憩。"

	key[]: "poi_sd2_02"
	val[]: "班戈鬼城"

	key[]: "poi_sd2_02_desc"
	val[]: "班戈曾是沃爾沃斯郡的郡治所在，但在 1899 年鎮上建築被遷往鄰近的塞爾比後，便逐漸淪為鬼城。如今原址上只剩一座紀念碑，標示著小鎮曾經存在的位置。"

	key[]: "landmark_sd_state_capitol_desc"
	val[]: "皮爾市建於 1880 年，1889 年南達科他州加入聯邦時成為州首府。這裡因位置居中、又是密蘇里河的渡口而雀屏中選，市名則取自法裔美籍皮草商小皮埃爾‧舒托。"

	key[]: "sd_cut_corn_desc"
	val[]: "米契爾鎮的玉米宮，是全世界唯一一座完全以玉米裝飾的宮殿。每年當地藝術家與農民都會用天然色澤的玉米、穀物與草料創作全新的壁畫，讓它成為南達科他州最獨特的地標之一。"

	key[]: "landmark_sd_largest_pheasant_desc"
	val[]: "休倫鎮是「世界最大雉雞」的所在地，這座玻璃纖維與鋼材打造的雕塑高達 40 英尺，建於 1959 年，重達 22 噸，彰顯本區長久以來作為全美頂尖雉雞狩獵勝地的美名。"

	key[]: "landmark_sd_dignity_of_earth_and_sky_desc"
	val[]: "《大地與天空的尊嚴》是一座高 50 英尺的不鏽鋼雕塑，矗立在錢柏倫附近俯瞰密蘇里河的位置。作品出自藝術家戴爾‧蘭菲爾之手，向拉科塔族與達科他族的傳統、韌性與文化致敬。"

##########################################################################################

#@}
