    key[]: "hint_driv_auto_title"
	val[]: "駕駛"

    key[]: "hint_driv_auto_text"
	val[]: "用 $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ 前進，用 $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ 倒車。<br><offset vshift=8>用 $SPECIAL_steering$ 轉向。<br><offset vshift=8>按下 $KEY_gearup$ 和 $KEY_geardown$ 升降檔位。"


    key[]: "hint_driv_seq_title"
	val[]: "駕駛"

    key[]: "hint_driv_seq_text"
	val[]: "用 $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ 前進，用 $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ 倒車。<br><offset vshift=8>用 $SPECIAL_steering$ 轉向。<br><offset vshift=8>按下 $KEY_gearup$ 和 $KEY_geardown$ 控制離合器。"


    key[]: "hint_driv_hshift_title"
	val[]: "駕駛"

    key[]: "hint_driv_hshift_text"
	val[]: "用 $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ 前進，用 $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ 倒車。<br><offset vshift=8>用 $SPECIAL_steering$ 轉向。<br><offset vshift=8>用 <color value=@@clr_sel@@>排檔器<color value=@@clr_txt@@> 換檔。"


    key[]: "hint_depot_deliv_title"
