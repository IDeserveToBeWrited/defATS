    key[]: "hint_tb_done_title"
    val[]: "旅遊看板已探索完畢"

    key[]: "hint_tb_done_text"
    val[]: "你已成功探索當地旅遊看板的所有地點，可以在 <color value=@@clr_sel@@>@@tourist_atlas_link@@</color> 中查看詳細資訊。作為獎勵，你現在可以把明信片擺在車上展示了。"


    key[]: "hint_vehicle_prio_title"
    val[]: "客戶最重視：車輛狀況"

    key[]: "hint_vehicle_prio_text"
    val[]: "這位客戶特別重視車輛狀況，你抵達時的車輛狀況會大幅影響獎金或罰款。請安全駕駛，照顧好你的車。<br><offset vshift=8>按下 $KEY_advmouse$ 以查看工作詳細資訊。"


    key[]: "hint_cargo_prio_title"
    val[]: "客戶最重視：貨物搬運"

    key[]: "hint_cargo_prio_text"
    val[]: "這位客戶特別重視貨物搬運，你送達時的貨物狀態會大幅影響獎金或罰款。請安全駕駛，照顧好你的貨物。<br><offset vshift=8>按下 $KEY_advmouse$ 以查看工作詳細資訊。"


    key[]: "hint_time_prio_title"
    val[]: "客戶最重視：時間掌握"

    key[]: "hint_time_prio_text"
    val[]: "這位客戶特別重視時間掌握，你是否準時會大幅影響獎金或罰款。請安全駕駛，並在客戶期待的時間抵達。<br><offset vshift=8>按下 $KEY_advmouse$ 以查看工作詳細資訊。"


    key[]: "hint_car_deliv_title"
    val[]: "接近目的地"

    key[]: "hint_car_deliv_text"
