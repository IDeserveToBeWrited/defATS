#+ Text deviations for American Truck Simulator. Please, use only terms appropriate for USA (i.e. culture specific nuances, not American English).
#@{

#+ Music/radio player
#@{

#+ Hint shown if no music files are found. Also shown as tooltip when hovering over music_player button.

	key[]: "music_player_hint"
	val[]: "將你的音樂檔案放到 <color value=@@clr_sel@@>文件<color value=@@clr_txt@@> 裡的 <color value=@@clr_sel@@>American Truck Simulator/music <color value=@@clr_txt@@> 資料夾中，然後你就可以在下面看到歌曲了 ｡ "

#+ Tooltip shown when hovering over the radio_stream button.

	key[]: "radio_hint"
	val[]: "編輯 <color value=@@clr_sel@@>文件<color value=@@clr_txt@@> 裡的 <color value=@@clr_sel@@>American Truck Simulator <color value=@@clr_txt@@> 裡的 <color value=@@clr_sel@@>live_streams.sii <color value=@@clr_txt@@> 檔案來新增你喜愛的音樂電台！"

#+ Hint shown if no online radio streams are defined.

	key[]: "empty_radio_hint"
	val[]: "請參考 <color value=@@clr_sel@@>文件<color value=@@clr_txt@@> 裡的 <color value=@@clr_sel@@>American Truck Simulator<color value=@@clr_txt@@> 資料夾中的 <color value=@@clr_sel@@>readme.rtf<color value=@@clr_txt@@> 檔案中的教學，來新增你自己的音樂及電台 ｡ "
#@}

