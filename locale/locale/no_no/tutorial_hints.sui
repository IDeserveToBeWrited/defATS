
    key[]: "hint_engine_title"
	val[]: "Start motoren"

    key[]: "hint_engine_text"
	val[]: "Bruk $KEY_engine$ for å starte motoren."


    key[]: "hint_ignition_title"
	val[]: "Start tenningen"

    key[]: "hint_ignition_text"
	val[]: "Bruk $KEY_engineelect|KEY_engine$ for å starte tenningen."


    key[]: "hint_driv_arc_title"
	val[]: "Kjøring"

    key[]: "hint_driv_arc_text"
	val[]: "Bruk $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ og $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ for å flytte seg framover eller bakover.<br><offset vshift=8>Bruk $SPECIAL_steering$ til å styre."


    key[]: "hint_driv_auto_title"
	val[]: "Kjøring"

    key[]: "hint_driv_auto_text"
	val[]: "Bruk $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ og $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ for å flytte seg framover eller bakover.<br><offset vshift=8>Bruk $SPECIAL_steering$ til å styre.<br><offset vshift=8>Trykk $KEY_gearup$ og $KEY_geardown$ for girvalg."


    key[]: "hint_driv_seq_title"
	val[]: "Kjøring"

    key[]: "hint_driv_seq_text"
	val[]: "Bruk $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ og $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ for å flytte seg framover eller bakover.<br><offset vshift=8>Bruk $SPECIAL_steering$ til å styre.<br><offset vshift=8>Trykk $KEY_gearup$ og $KEY_geardown$ for kløtsjkontroll."


    key[]: "hint_driv_hshift_title"
	val[]: "Kjøring"

    key[]: "hint_driv_hshift_text"
	val[]: "Bruk $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ og $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ for å flytte seg framover eller bakover.<br><offset vshift=8>Bruk $SPECIAL_steering$ til å styre.<br><offset vshift=8>Bytt gir med <color value=@@clr_sel@@>girspak<color value=@@clr_txt@@>."


    key[]: "hint_depot_deliv_title"
    val[]: "Nærme seg destinasjonen"

    key[]: "hint_depot_deliv_text"
    val[]: "Stopp i det merkede området for å velge vanskelighetsgraden på den siste parkeringsplassen og få tilsvarende erfaring."


    key[]: "hint_fin_deliv_title"
    val[]: "Fullføre leveransen"

    key[]: "hint_fin_deliv_text"
    val[]: "Parkere på den valgte parkeringsplassen. Du kan trykke på $KEY_activate$ for å hoppe over den når du er i nærheten av leveringspunktet."


    key[]: "hint_fin_deliv2_title"
    val[]: "Fullføre leveransen"

    key[]: "hint_fin_deliv2_text"
    val[]: "Parkere på den valgte parkeringsplassen. Du kan aktivere en widget i @@desktop_menu_category_options@@ for å la deg hoppe over parkering."


    key[]: "hint_lights_title"
    val[]: "Skru på lysene"

    key[]: "hint_lights_text"
    val[]: "Bruk $KEY_light$ for å aktivere lysene. Bla gjennom forskjellige moduser ved å trykke gjentatte ganger."


    key[]: "hint_high_beam_title"
    val[]: "Aktivere fjernlys"

    key[]: "hint_high_beam_text"
    val[]: "Bruk $KEY_hblight$ for å skru på fjernlys."


    key[]: "hint_wipers_title"
    val[]: "Aktivere vindusviskerne"

    key[]: "hint_wipers_text"
    val[]: "Bruk $KEY_wipers$ for å aktivere vindusviskerne og veksle mellom forskjellige hastighetsinnstillinger."


    key[]: "hint_zoom_title"
    val[]: "Ser nærmere på"

    key[]: "hint_zoom_text"
    val[]: "Bruk $KEY_camzoom$ for å zoome i interiøret. Du kan sette zoommodusen til å holde eller veksle i @@desktop_menu_category_options@@."


    key[]: "hint_cam_int_title"
    val[]: "Se omkring"

    key[]: "hint_cam_int_text"
    val[]: "Bruk $KEY_cam1$ for å endre kameraet til interiørvisning."


    key[]: "hint_cam_ext_title"
    val[]: "Se omkring"

    key[]: "hint_cam_ext_text"
    val[]: "Du kan bla gjennom forskjellige kameravinkler ved å trykke på $KEY_camcycle$.<br><offset vshift=8>Bruk $KEY_cam2$ for å bytte kameraet til eksteriørvisning."


    key[]: "hint_indicators_title"
    val[]: "Indikatorer"

    key[]: "hint_indicators_text"
    val[]: "Bruk $KEY_lblinker$ og $KEY_rblinker$ for å skru på indikatorer."


    key[]: "hint_tow_title"
    val[]: "Bergingstjenesten"

    key[]: "hint_tow_text"
    val[]: "Hvis du ikke kommer deg ut av en vanskelig situasjon, kan du bruke bergingstjenesten. For å få tilgang til den, åpne @@quick_info_word@@-menyen ved å bruke $KEY_advmouse$."


    key[]: "hint_diff_lock_title"
    val[]: "Differensialsperre"

    key[]: "hint_diff_lock_text"
    val[]: "Hvis du ikke kan begynne å bevege deg, kan kanskje differensialsperren hjelpe deg. Bruk $KEY_diflock$ for å aktivere den, eller skru på automatisk differensialsperre i @@desktop_menu_category_options@@."


    key[]: "hint_diff_unlock_title"
    val[]: "Differensialsperre aktivert"

    key[]: "hint_diff_unlock_text"
    val[]: "Du bør låse opp differensialsperren under vanlig kjøring, ellers risikerer du at den blir skadet. Bruk $KEY_diflock$ for å deaktivere den, eller skru på automatisk differensialsperre i @@desktop_menu_category_options@@."


    key[]: "hint_wipers_off_title"
    val[]: "Deaktivere vindusviskerne"

    key[]: "hint_wipers_off_text"
    val[]: "Bruk $KEY_wipers$ for å deaktivere vindusviskerne og veksle mellom forskjellige hastighetsinnstillinger."


    key[]: "hint_world_map_title"
    val[]: "Kartvisning"

    key[]: "hint_world_map_text"
    val[]: "Bruk $KEY_navmap$ for å åpne verdenskartet."


    key[]: "hint_pause_title"
    val[]: "@@quick_info_word@@"

    key[]: "hint_pause_text"
    val[]: "Bruk $KEY_advmouse$ for å åpne @@quick_info_word@@ – en oversikt over din status med praktiske snarveier."


    key[]: "hint_pause_border_title"
    val[]: "Lokale forskrifter"

    key[]: "hint_pause_border_text"
    val[]: "Bruk $KEY_advmouse$ for å åpne @@quick_info_word@@ og se gjeldende regler for regionen du er i."


    key[]: "hint_photo_trophy_title"
    val[]: "@@landmark_word@@"

    key[]: "hint_photo_trophy_text"
    val[]: "Åpne @@quick_info_word@@ med $KEY_advmouse$ for å gå inn i @@photo_mode_word@@ og ta et bilde av et @@landmark_word@@ i nærheten <img src=/material/ui/map/photo_sight_not_captured.mat width=20 height=20>."


    key[]: "hint_viewpoint_title"
    val[]: "@@viewpoint_title@@ i nærheten"

    key[]: "hint_viewpoint_text"
    val[]: "@@viewpoint_title@@ <img src=/material/ui/map/viewpoint_unseen.mat width=20 height=20> er i nærheten – finn den og aktivere den for å se filmsekvensen."


    key[]: "hint_resting_title"
    val[]: "Hvileplass i nærheten"

    key[]: "hint_resting_text"
    val[]: "Hvileplasser <img src=/material/ui/map/parking_ico.mat width=20 height=20> hjelper deg med å komme deg etter tretthet og ta din obligatoriske pause for å fortsette din reise på en trygg måte."


    key[]: "hint_gas_title"
    val[]: "Drivstoffstasjon i nærheten"

    key[]: "hint_gas_text"
    val[]: "Drivstoffstasjoner <img src=/material/ui/map/gas_ico.mat width=20 height=20> kan brukes til å fylle drivstoff på ditt kjøretøy."


    key[]: "hint_car_job_title"
    val[]: "Første budsjåføroppdrag"

    key[]: "hint_car_job_text"
    val[]: "Fullfør leveransen – kjør trygt, ta vare på lasten og ankom til forventet tid. Vær oppmerksom på kundens prioritet som påvirker din rangering og belønning.<br><offset vshift=8>Trykk på $KEY_advmouse$ for å se oppdragsdetaljer."


    key[]: "hint_tour_board_title"
    val[]: "Turisttavle"

    key[]: "hint_tour_board_text"
    val[]: "Et turisttavle ligger i nærheten. Aktivere det for å låse opp innholdet i <color value=@@clr_sel@@>@@tourist_atlas_link@@</color> for å veilede deg i utforskningen av landemerker og intressepunkter i nærheten."


    key[]: "hint_tb_first_title"
    val[]: "Første lokasjon utforsket"

    key[]: "hint_tb_first_text"
    val[]: "Du har utforsket den første lokasjonen til et lokalt turisttavle. Du kan se detaljene i <color value=@@clr_sel@@>@@tourist_atlas_link@@</color>. Utforsk alle lokasjonene for å lære mer og tjene belønninger."


    key[]: "hint_tb_bef_compl_title"
    val[]: "Én lokasjon igjen"

    key[]: "hint_tb_bef_compl_text"
    val[]: "Bare en lokasjon gjenstår før du utforsker ditt første lokale turisttavle fullt ut og vinner ditt postkort."


    key[]: "hint_tb_done_title"
    val[]: "Turisttavle utforsket"

    key[]: "hint_tb_done_text"
    val[]: "Du har vellykket utforsket alle lokasjoner til et lokalt turisttavle. Du kan se detaljene deres i <color value=@@clr_sel@@>@@tourist_atlas_link@@</color>. Som belønning kan du nå vise frem postkortet i ditt kjøretøy."


    key[]: "hint_vehicle_prio_title"
    val[]: "Kundeprioritet – kjøretøystilstand"

    key[]: "hint_vehicle_prio_text"
    val[]: "Kunden har gitt en høyere prioritet til kjøretøystilstand – bonusen eller din straff vil bli sterkt påvirket av tilstanden til kjøretøyet du ankommer i. Kjør trygt og ta vare på ditt kjøretøy.<br><offset vshift=8>Trykk på $KEY_advmouse$ for å se oppdragsdetaljer."


    key[]: "hint_cargo_prio_title"
    val[]: "Kundeprioritet - lasthåndtering"

    key[]: "hint_cargo_prio_text"
    val[]: "Kunden har gitt en høyere prioritet til lasthåndtering – bonusen eller din straff vil i stor grad bli påvirket av tilstanden til lasten du leverer. Kjør trygt og ta vare på din last.<br><offset vshift=8>Trykk på $KEY_advmouse$ for å se oppdragsdetaljer."


    key[]: "hint_time_prio_title"
    val[]: "Kundeprioritet - tidsstyring"

    key[]: "hint_time_prio_text"
    val[]: "Kunden har gitt en høyere prioritering til tidsstyring – bonusen eller din straff vil i stor grad bli påvirket av din evne til å være punktlig. Kjør trygt og kom til en tid kunden forventer at du kommer.<br><offset vshift=8>Trykk på $KEY_advmouse$ for å se oppdragsdetaljer."


    key[]: "hint_car_deliv_title"
    val[]: "Nærme seg destinasjonen"

    key[]: "hint_car_deliv_text"
    val[]: "Stopp i det merkede området for å fullføre leveransen."


    key[]: "hint_car_early_title"
	val[]: "Tidlig ankomst"

    key[]: "hint_car_early_text"
    val[]: "Leveransen forventes til et bestemt tidspunkt, og tidlig ankomst vil føre til misfornøyde kunder. Planlegg din reise og bruk tilgjengelige hvileplasser om nødvendig."


#!{
    key[]: "hint_sm_throttle_title"
	val[]: "@@throttle_double_tap@@"
#!}

    key[]: "hint_sm_throttle_text"
    val[]: "Du kan aktivere smart gasskontroll i @@desktop_menu_category_options@@. Når den er aktivert, vil kjøretøyet holde lav gass som standard. Etter å ha trykket raskt på gassknappen to ganger, vil kjøretøyet holde full gass til knappen slippes."
