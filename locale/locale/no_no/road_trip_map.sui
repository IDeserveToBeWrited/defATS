#+ Washington TBs and POIs localization.
#@{
	key[]: "tb_wa1"
	val[]: "Den olympiske halvøy"

	key[]: "tb_wa1_desc"
	val[]: "Den olympiske halvøya avslører et sted hvor hav, skog og fjell sameksisterer i stadig skiftende skjønnhet. Tåke driver over steinete kyster, mens fossefall faller fra høylandet, der skjulte daler gir ly til små historiske byer."

	key[]: "poi_wa1_01"
	val[]: "Historisk postkontor i USA"

	key[]: "poi_wa1_01_desc"
	val[]: "Bygningen ble fullført i 1893 på en bløff over havnen i Port Townsend, og ble designet som et føderalt anlegg med et tollhus, noe som gjenspeiler byens tidlige ambisjoner som et fremvoksende knutepunkt for internasjonal handel."

	key[]: "poi_wa1_02"
	val[]: "Port Angeles"

	key[]: "poi_wa1_02_desc"
	val[]: "Port Angeles er en kystby grunnlagt på 1800-tallet som en havn og forsyningspunkt. I dag fungerer den som en nøkkelport til Olympic National Park og en fergehavn som forbinder USA og Canada."

	key[]: "poi_wa1_03"
	val[]: "Lake Crescent"

	key[]: "poi_wa1_03_desc"
	val[]: "Lake Crescent, Washingtons nest dypeste innsjø, er kjent for sitt levende blå, krystallklare vann, et resultat av lave nitrogennivåer. Det ligger i et populært rekreasjonsområde, og er omgitt av stier og gammel skog."
	
	key[]: "poi_wa1_04"
	val[]: "Kalaloch-stranden"

	key[]: "poi_wa1_04_desc"
	val[]: "Kalaloch Beach er kjent for «Livets tre», en Sitka-gran med synlige røtter som strekker seg over en liten bekk til kysten. I motsetning til typiske høye graner, er den kortere, tykkere og forblåst, noe som gjør den til et unikt og populært lokalt landemerke."

	key[]: "poi_wa1_05"
	val[]: "Olympic nasjonalpark"

	key[]: "poi_wa1_05_desc"
	val[]: "Olympic nasjonalspark beskytter ulike økosystemer, fra en robust stillehavskystlinje og tempererte regnskoger til alpine topper. Først klassifisert som et nasjonalt monument i 1909, ble det omdøpt til en nasjonalpark av føderale myndigheter i 1938."

	key[]: "poi_wa1_06"
	val[]: "Greenhead Slough"

	key[]: "poi_wa1_06_desc"
	val[]: "Greenhead Slough er en liten innløp og våtmarkskanal langs riksvei 101 nær Willapa Bay. Det ligger innenfor et habitat ved elvemunningen ved kysten som har blitt restaurert for å støtte laksgyting og rikelig visning av vannfugler."

	key[]: "poi_wa1_07"
	val[]: "Dabob Bay"

	key[]: "poi_wa1_07_desc"
	val[]: "Dabob Bay er en dyp fjord som lever av laks, skalldyr og dyreliv. Dabob Bay Natural Area, etablert i 1984, beskytter sjeldne saltmyr og sandspytt plantesamfunn innenfor et svært funksjonelt tidevanns våtmarkssystem."


##########################################################################################

	key[]: "tb_wa2"
	val[]: "Hjertelandet"

	key[]: "tb_wa2_desc"
	val[]: "Washingtons hjerteland inviterer reisende langs pittoreske veier gjennom eviggrønne skoger og rolige alpine innsjøer. Mount Rainier dominerer horisonten, og tilbyr ikonisk utsikt og en fredelig reise inn i det naturlige landskapet i Pacific Northwest."

	key[]: "poi_wa2_01"
	val[]: "Mount Rainier"

	key[]: "poi_wa2_01_desc"
	val[]: "Mount Rainier, Washingtons høyeste topp på 14 411 fot (4392 m), er en aktiv stratovulkan. Isbreene mater elver, former daler og opprettholder rike skoger og dyreliv, noe som gjør det til et viktig naturlig landemerke."

	key[]: "poi_wa2_02"
	val[]: "Wenatchee nasjonalskog"

	key[]: "poi_wa2_02_desc"
	val[]: "Wenatchee nasjonalskog spenner over fjell, elver og alpine daler. I 1933 bygde Civilian Conservation Corps stier og brannutkikksposter her, og satte et varig preg på skogens rekreasjons- og bevaringshistorie."

	key[]: "poi_wa2_03"
	val[]: "Mt. Baker Snoqualmie nasjonalskog"

	key[]: "poi_wa2_03_desc"
	val[]: "Mount Baker – Snoqualmie nasjonalskog er vert for noen av de eldste isbreovervåkingsstedene i Amerika, og sporer vulkanske isstrømmer og klimaendringer over Cascades siden tidlig på 1900-tallet."
	
	key[]: "poi_wa2_04"
	val[]: "Wenatchee-elven"

	key[]: "poi_wa2_04_desc"
	val[]: "Langs Wenatchee-elven viser rester av vanningskanaler og møller fra begynnelsen av 1800-tallet hvordan nybyggere utnyttet vannet. Innfødte stammer også var avhengig på det lakserike vannet for mat og handel lenge før europeisk bosetting."

	key[]: "poi_wa2_05"
	val[]: "Klawatti Peak"

	key[]: "poi_wa2_05_desc"
	val[]: "Klawatti Peak ble først besteget på midten av 1900-tallet, og fortsatt sjelden klatret på grunn av sine bratte, isbredekkede skråninger, noe som gjør det til en ettertraktet utfordring for fjellklatrere som søker isolasjon i North Cascades."

	key[]: "poi_wa2_06"
	val[]: "Dry Falls-demningen"

	key[]: "poi_wa2_06_desc"
	val[]: "Dry Falls-demingen er konstruert for å håndtere lokale vannveier, og ligger på toppen av forhistoriske basaltklipper, og kontrollerer sesongens strømninger mens den avslører terrasser og stupebassenger skåret ut av istidsflommer."

	key[]: "poi_wa2_07"
	val[]: "White Fire Mountain Overlook"

	key[]: "poi_wa2_07_desc"
	val[]: "Utsikten har tolkende tegn om White Mountain Fire fra 1988, en av Washingtons største skogbranner i nyere historie, som avslører arr og gjenvekstmønstre i skogen."

	key[]: "wa_cut_helen_desc"
	val[]: "Før 1980 hadde Mount St. Helens en konisk form og ble referert til som Mount Fuji of America. Utbruddet i 1980 fjernet 1300 fot (400 m) av toppen, og dannet et hesteskokrater nå delvis fylt av en lavakuppel og isbre."


##########################################################################################


	key[]: "tb_wa3"
	val[]: "Vinland"

	key[]: "tb_wa3_desc"
	val[]: "Øst for Cascades spenner Washingtons vinland over Columbia Valley AVA. Regionen inkluderer Selah Creek, Lewis og Clark State Park, og landområder som er historisk bebodd av urfolk, med tørre, solrike landskap med bølgende åser og elvedaler."

	key[]: "poi_wa3_01"
	val[]: "Clear Creek Falls"

	key[]: "poi_wa3_01_desc"
	val[]: "Clear Creek Falls Overlook er et populært stopp like øst for White Pass Summit. Omtrent en kilometer lenger øst fører avkjøringen til Clear Lake Recreation Area, kjent for fiske og utmerkede muligheter til å observere lokalt dyreliv."

	key[]: "poi_wa3_02"
	val[]: "Selah Creek-broen"

	key[]: "poi_wa3_02_desc"
	val[]: "Fred G. Redmon-broen, eller Selah Creek-broen, er en tvillingbuestruktur i Yakima County. Da den var ferdig, var den den lengste betongbuebroen i Amerika og den høyeste bilbroen i delstaten."

	key[]: "poi_wa3_03"
	val[]: "Druefelt"
	
	key[]: "poi_wa3_03_desc"
	val[]: "Washingtons daler og fruktbar jord støtter mange vinranker, inkludert Riesling, Cabernet og Merlot. Vinmarkene er en viktig del av statens landbruk og lokale landskap."

	key[]: "poi_wa3_04"
	val[]: "Ed Hendler-broen"

	key[]: "poi_wa3_04_desc"
	val[]: "Bygget i 1978, krysser broen, noen ganger kalt Intercity-broen, Columbia River mellom Pasco og Kennewick i det sørøstlige Washington. Siden åpningen har den blitt sett på som et landemerke og symbol på Tri-Cities."

	key[]: "poi_wa3_05"
	val[]: "Lewis and Clark State Park"

	key[]: "poi_wa3_05_desc"
	val[]: "En av Washingtons første delstatsparker, Lewis og Clark State Park, bevarer eldgamle skoger langs en historisk urfolksrute. Skogene er oppkalt for å hedre Corps of Discovery, og minner om de tette skogene Meriwether Lewis beskrevet i journalene sine."

	key[]: "poi_wa3_06"
	val[]: "Columbia County tinghus"

	key[]: "poi_wa3_06_desc"
	val[]: "Columbia County tinghus gjenspeiler en tid da fylkeadministrasjonen var sentral i dagliglivet. I en periode med rask vekst og begrenset kontakt med delstatshovedstaden, fungerte tinghus som hovedkilden til autoritet og dekket innbyggernes umiddelbare behov."

	key[]: "poi_wa3_07"
	val[]: "Indianske stammer"

	key[]: "poi_wa3_07_desc"
	val[]: "Columbia-dalen og områdene rundt var hjemsted for urfolk, inkludert stammene Yakama, Walla Walla og Umatilla. I dag fortsetter disse samfunnene å leve i regionen, opprettholde kulturelle tradisjoner og forvalte land- og vannressurser."

##########################################################################################

#@}




#+ Oregon TBs and POIs localization.
#@{
	key[]: "tb_or1"
	val[]: "Stillehavskysten"

	key[]: "tb_or1_desc"
	val[]: "Oregons stillehavskyst utfolder seg gjennom robuste nes med naturskjønne utsiktspunkter. Mens Heceta Head fyrtårn har utsikt over bølgeskvulp, reiser Silver Point, Ophir Wayside, Sisters Rocks og Kissing Rock seg med basaltklipper for å møte bølgene i Stillehavet underveis."

	key[]: "landmark_or_astoria_b_desc"
	val[]: "Denne broen, en spennvidde på fire mil over Columbia River, forbinder Oregon og Washington, og tilbyr utsikt over elvens munning og Stillehavshorisonten."

	key[]: "poi_or1_01"
	val[]: "Silver Point Interpretive Overlook"

	key[]: "poi_or1_01_desc"
	val[]: "Rett sør for Cannon Beach gir denne utsikten vidstrakt utsikt over Haystack Rock og den robuste kystlinjen, spesielt fantastisk ved solnedgang."

	key[]: "or_cut_lighthouse_desc"
	val[]: "Oregons høyeste fyrtårn, bygget i 1873, står på en basaltodde nær Newport."

	key[]: "or_cut_newport_desc"
	val[]: "Yaquina Bay-broen, ferdigstilt i 1936, er et av Oregons mest ikoniske kystlandmerker. Designet av den anerkjente ingeniøren Conde McCullough, dens elegante bue spenner over Yaquina Bay og er fortsatt et definerende trekk ved US Route 101."

	key[]: "or_cut_thor_desc"
	val[]: "Et naturlig synkehull på Cape Perpetua, der bølgende bølger kollapser og gir en illusjon om at havet renner bort."

	key[]: "poi_or1_02"
	val[]: "Ophir Wayside"

	key[]: "poi_or1_02_desc"
	val[]: "Et rolig avbrekk nær Gold Beach, hvor besøkende kan strekke seg, se på brenningene eller finkjemme stranden etter drivved og agater."

	key[]: "poi_or1_03"
	val[]: "Sisters Rock Overlook"

	key[]: "poi_or1_03_desc"
	val[]: "Dramatiske havstabler til havs stiger fra bølgene, med stier som fører ned til lommestrender gjemt mellom klipper."

	key[]: "poi_or1_04"
	val[]: "Kissing Rock"

	key[]: "poi_or1_04_desc"
	val[]: "Et veistopp sør for Gold Beach, hvor to massive fjellformasjoner lener seg sammen over sanden, noe som gjør det til et favorittfotosted."


##########################################################################################

	key[]: "tb_or2"
	val[]: "Det ville østen"

	key[]: "tb_or2_desc"
	val[]: "Ofte kalt Oregons ville østen, avslører denne regionen landskap formet av geologiske krefter over hundrevis av millioner år, mange fortsatt aktive i dag. Mot den enorme tidsskalaen er menneskets historie kort, men preget av øyeblikk som er like dramatiske som selve landet."

	key[]: "landmark_or_deadman_p_desc"
	val[]: "Nær Pendleton tilbyr dette utkikksområdet utsikt over Deadman Pass, oppkalt etter en hendelse fra 1870-tallet under Bannock-krigen da en vognfører ble funnet død. Tiår tidligere krysset utallige vogner de åsene på Oregon Trail."

	key[]: "or_cut_395_desc"
	val[]: "En gang kjent som Three Flags Highway, strakte US-395 seg fra Canada til Mexico, og koblet sammen ørkener, skoger og fjell. I dag ender den ved US-15 i California, selv om rester av den opprinnelige ruten forblir i nærheten av San Diego."

	key[]: "poi_or2_01"
	val[]: "Malheur nasjonalskog"

	key[]: "poi_or2_01_desc"
	val[]: "Malheur nasjonalskog ligger i Blue Mountains. For mer enn 150 millioner år siden utgjorde noen av de eldste bergartene i denne regionen en del av vulkanske øyer i Stillehavet, og slo senere sammen med kontinentet."
	
	key[]: "poi_or2_02"
	val[]: "Badlands villmark"

	key[]: "poi_or2_02_desc"
	val[]: "Badlands villmark, like øst for Bend, er et robust vulkansk landskap formet av eldgamle lavastrømmer og vindblåst aske. Dens vridde lavaformasjoner, sandjord og sterk terreng skaper et av statens mest unike høye ørkenmiljøer."

	key[]: "poi_or2_03"
	val[]: "Abertsjøen"

	key[]: "poi_or2_03_desc"
	val[]: "Først kartlagt i 1843, har Abertsjøen støttet menneskelig tilstedeværelse i over 10 000 år. Selv om det er for saltholdig for fisk, er det fortsatt et viktig stopp for fugler langs Pacific Flyway og har krympet de siste tiårene på grunn av klimaendringer."

	key[]: "poi_or2_04"
	val[]: "East Steens turrute"

	key[]: "poi_or2_04_desc"
	val[]: "East Steens turrute følger Highway 78 langs Steens Mountain og Alvord-ørkenen. Høydepunktet er Alvord Desert playa, en av Oregons største tørre innsjøbunner, som skifter sesongmessig mellom en grunn innsjø og en stor ørkenslette."

	key[]: "poi_or2_05"
	val[]: "Doherty Slide"

	key[]: "poi_or2_05_desc"
	val[]: "Det tar mindre enn en time å kjøre langs Doherty Slide, en fjellformasjon født av vulkansk aktivitet. Likevel tok det naturen rundt 16 millioner år å forme landskapet slik det ser ut i dag."


##########################################################################################

	key[]: "tb_or3"
	val[]: "Ogden-staten"

	key[]: "tb_or3_desc"
	val[]: "Denne ruten følger Oregons indre nord-sør-korridor, forbi skoger og høy ørken. Først utforsket av pelshandler Peter Skene Ogden på 1820-tallet, fikk den senere strategisk betydning under andre verdenskrig for sine tømmer- og transportveier."
	
	key[]: "poi_or3_01"
	val[]: "Springfield-flammen"

	key[]: "poi_or3_01_desc"
	val[]: "Skulpturen er nesten 65 fot høy, og markerer Springfields nordlige port, designet som en flamme for å tjene som et fyrtårn for reisende og et landemerke for både innbyggere og besøkende."

	key[]: "poi_or3_02"
	val[]: "Santiam Wagon-vei"

	key[]: "poi_or3_02_desc"
	val[]: "Passet øst for her, en gang kalt Wiley Pass etter Andrew Wiley, ble utforsket i 1859 av pionerer som søkte beiteruter. En militærvei ble planlagt i 1864, men for det meste ubygd. En bomvei, Santiam Wagon-vei, opererte fra 1868 til 1914."

	key[]: "poi_or3_03"
	val[]: "Veteran Historic Highway"

	key[]: "poi_or3_03_desc"
	val[]: "Ved motorveiens nordlige port ble de to siste av 18 hyllestskilt installert 9 november 2012, sør for Biggs Junction. De markerer Camp Rufus som det nordlige inngangspunktet til landets første motorvei dedikert til andre verdenskrigsveteraner."

	key[]: "poi_or3_04"
	val[]: "Ogden-staten naturskjønn utsiktspunkt"

	key[]: "poi_or3_04_desc"
	val[]: "Veikanten er oppkalt etter Peter Skene Ogden, en oppdagelsesreisende fra det tidlige 1800-tallet og Hudson's Bay Company-sjefshandler. Veikanten hedrer hans ekspedisjoner over Snake River-landet og hans rolle blant de første som utforsket Great Salt Lake Basin."

	key[]: "landmark_or_fremont_b_desc"
	val[]: "Broen og Portlands Fremont Street er oppkalt etter John C. Frémont, en tidlig oppdagelsesreisende av Las Californias og Oregon Country. Den har Oregons lengste hovedspenn og rangerer som verdens nest lengste buebro."

	
##########################################################################################

#@}



#+ California TBs and POIs localization.
#@{
	key[]: "tb_ca1"
	val[]: "Den gyldne horisont"

	key[]: "tb_ca1_desc"
	val[]: "Ikoniske broer reiser seg over glitrende vann, og forbinder Alcatraz, Santa Cruz og regionens åser og nabolag. Fra travle gater og historiske steder til solbelyste strender og naturskjønne kystlinjer, Bay Area tilbyr en California-opplevelse uten like."

	key[]: "ca_cut_golden_gate_bridge_desc"
	val[]: "Broen som forbinder San Francisco Bay med Stillehavet er et ikonisk symbol på San Francisco og California. Da den åpnet i 1937, hadde den rekordene for både verdens lengste og høyeste hengebro."

	key[]: "poi_ca1_01"
	val[]: "Alcatraz"

	key[]: "poi_ca1_01_desc"
	val[]: "Alcatraz Island var hjemsted for et føderalt fengsel fra 1934 til 1963. Den er kjent for å huse noen av landets mest beryktede kriminelle, og er nå et historisk sted og et populært turistmål."

	key[]: "ca_cut_richmond_desc"
	val[]: "Richmond – San Rafael-broen spenner over San Francisco Bay, og forbinder Richmond og San Rafael. Åpnet i 1956, fører den trafikk over den nordlige bukten og har en utkrager og fagverksdesign, og fungerer som en viktig regional transportforbindelse."
	
	key[]: "poi_ca1_02"
	val[]: "Skatteøya"

	key[]: "poi_ca1_02_desc"
	val[]: "Skatteøya er en menneskeskapt øy bygget for Golden Gate International Exposition i 1939. Etter å ha fungert som marinebase, blir den nå ombygd for bolig- og kommersiell bruk."

	key[]: "poi_ca1_03"
	val[]: "Surfeby"

	key[]: "poi_ca1_03_desc"
	val[]: "Surfing-statuen i Santa Cruz hedrer byens surfearv og kultur. Den er installert nær stranden og feirer lokale surfere og sporten som har formet Santa Cruz sin identitet og kystsamfunn."

	key[]: "poi_ca1_04"
	val[]: "Madonna Inn"

	key[]: "poi_ca1_04_desc"
	val[]: "En tidligere populær restaurant og begivenhetslandemerke på toppen av Highway 152. Stengt siden 2004 på grunn av motorveiproblemer, er det fortsatt et hyppig tema i lokalhistorie og spøkelseshistoriefora."



##########################################################################################

	key[]: "tb_ca2"
	val[]: "Shasta-ruten"

	key[]: "tb_ca2_desc"
	val[]: "Shasta-ruten snor seg gjennom furuskoger og glitrende alpine innsjøer under Mount Shasta. Veier stiger og faller gjennom skjulte daler, og frakter reisende sørover mens fjellene gradvis blekner, og gir plass til de eldgamle redwoodskogene i Nord-California."

	key[]: "poi_ca2_01"
	val[]: "Shasta - Trinity nasjonalskog"

	key[]: "poi_ca2_01_desc"
	val[]: "Shasta–Trinity nasjonalskog, Californias største, krysses av Trinity Heritage Scenic Byway. Følger ruter brukt av gullgravere og nybyggere fra 1800-tallet."

	key[]: "poi_ca2_02"
	val[]: "Stor lagune"

	key[]: "poi_ca2_02_desc"
	val[]: "Stor lagune er den største og sørligste av de tre lagunene i Humboldt Lagoons State Park. De grunne kystbassengene ligger mellom steinete nes, der havbølger har bygget sandbarrierer som skiller lagunene fra Stillehavet."

	key[]: "or_cut_sequoia_desc"
	val[]: "Redwood nasjonalpark beskytter noen av verdens høyeste og eldste redwoodskog ved kysten, og når over 370 fot (120 m) og lever opptil 2000 år. Sammen med nærliggende statlige parker bevarer den omtrent 35 % av planetens gjenværende eldgamle redwoodskoger."
	
	key[]: "poi_ca2_03"
	val[]: "Smith-elven"

	key[]: "poi_ca2_03_desc"
	val[]: "Innenfor Six Rivers nasjonalskog i det nordvestlige California, ble dette beskyttede området utpekt av kongressen i 1990 for å bevare naturskjønne, økologiske og kulturelle verdier. Smith-elven er Californias eneste store udemmede, frittflytende elv."

	key[]: "poi_ca2_04"
	val[]: "Whiskey Creek-broen"

	key[]: "poi_ca2_04_desc"
	val[]: "Fullført i 1961, Whisky Creek-broen er en tre-spanns sveiset platebjelkestruktur. Det er kjent som et tidlig eksempel på brodesign som bruker tre forskjellige stålkvaliteter, en innovativ sveiseteknikk på den tiden."

	key[]: "poi_ca2_05"
	val[]: "Shasta-sjøen"

	key[]: "poi_ca2_05_desc"
	val[]: "Shasta-sjøen, Californias største reservoar, ble dannet av Shasta-demningen ved Sacramento-elven. Fullført i 1945, gir det vann, vannkraft og et naturskjønn sted for rekreasjon."

	key[]: "poi_ca2_06"
	val[]: "Mount Shasta"

	key[]: "poi_ca2_06_desc"
	val[]: "Fra 1820-tallet og fremover guidet Mount Shasta, den nest høyeste toppen i Cascade Range, reisende langs Siskiyou-stien ved basen. Den ruten utviklet seg senere til Interstate 5, som nå frakter tusenvis til fjellet hvert år."



##########################################################################################

	key[]: "tb_ca3"
	val[]: "Sierra-krysset"

	key[]: "tb_ca3_desc"
	val[]: "Under den ruvende Sierra Nevada ligger Inn at Benton blant åpne daler og bølgende åser. Sierra-krysset slynger seg langs stille høye ørkenveier, der fjerne topper og forrevne rygger skaper et tidløst panorama, som inviterer reisende til å utforske regionens vidåpne landskap."

	key[]: "ca_cut_olmsted_point_desc"
	val[]: "Yosemite nasjonalpark ble etablert i 1890 og er en av de mest besøkte parkene. Det er kjent for Yosemite Falls, den høyeste fossen i Nord-Amerika, omfattende stisystemer og gigantiske sequoiaer over 3000 år gamle."

	key[]: "poi_ca3_01"
	val[]: "Tioga-vei"

	key[]: "poi_ca3_01_desc"
	val[]: "Tioga-vei er en ikonisk naturskjønn rute som går gjennom hjertet av Yosemite nasjonalpark. Det er det høyeste motorveipasset i California, som forbinder den vestlige og østlige siden av Sierra Nevada."

	key[]: "poi_ca3_02"
	val[]: "Mono-sjøen"

	key[]: "poi_ca3_02_desc"
	val[]: "Mono-sjøen er mer enn 1 million år gammel, noe som gjør den til en av de eldste innsjøene i Nord-Amerika. Uten naturlig utløp har den samlet salter og mineraler båret av bekker som strømmer fra det østlige Sierra Nevada over tusenvis av år."
	
	key[]: "poi_ca3_03"
	val[]: "Tahoe-sjøen"

	key[]: "poi_ca3_03_desc"
	val[]: "Tahoe-sjøen ble dannet for omtrent 2 millioner år siden i Tahoe-bassenget, med sin nåværende form skåret ut av istidens isbreer. Det er den største alpine innsjøen i Nord-Amerika og den nest dypeste i USA."

	key[]: "poi_ca3_04"
	val[]: "Eldorado nasjonalskog"

	key[]: "poi_ca3_04_desc"
	val[]: "Eldorado nasjonalskog utgjør en del av et stort vannskille som gir vann til millioner av californiere og støtter gårder som produserer nesten halvparten av landets frukt og grønnsaker."

	key[]: "poi_ca3_05"
	val[]: "Inn at Benton Hot Springs"

	key[]: "poi_ca3_05_desc"
	val[]: "Benton, en av Mono Countys eldste byer, ble grunnlagt av Paiute-folk som brukte sine varme kilder. På 1860-tallet ble det et stoppested for nybyggere og gruvearbeidere. Vertshuset, bygget på 1940-tallet av lokal pimpstein, erstattet et hotell fra 1904 med 10 rom som deler ett bad."



##########################################################################################

	key[]: "tb_ca4"
	val[]: "Solen og sanden"

	key[]: "tb_ca4_desc"
	val[]: "Death Valleys ørken strekker seg under endeløse himmelstrøk, med sanddyner, taggete topper og sprukne sletter. Jackkaniner hopper over solbelyst sand, hodeskaller markerer stille passasjer, og isolerte veier slynger seg gjennom et sterkt, ubøyelig landskap som tester og beundrer alle som våger seg her."

	key[]: "poi_ca4_01"
	val[]: "Lone Pine"

	key[]: "poi_ca4_01_desc"
	val[]: "Lone Pine er en liten by i Californias Owens Valley, ved den østlige basen av Sierra. Den er kjent for sine nærliggende Alabama Hills, og har lenge fungert som en inngangsport for turgåere, klatrere og filmskapere som utforsker de omkringliggende fjellene og ørkenlandskapet."

	key[]: "poi_ca4_02"
	val[]: "Death Valley nasjonalpark"

	key[]: "poi_ca4_02_desc"
	val[]: "Death Valley er et av USAs mest ekstreme landskap - lavest, varmeste, tørreste og høyeste steder. Lenge før 1800-tallets pionerer bodde urfolksstammer her, som jaktet og samlet seg over denne harde, men også historisk rike regionen."

	key[]: "poi_ca4_03"
	val[]: "Far Crowley Vista Point"

	key[]: "poi_ca4_03_desc"
	val[]: "Dette Vista Point er et populært stoppested for reisende. Far John J. Crowley, The Desert Padre, stoppet ofte her. Nær parkens vestlige grense, tilbyr den slående utsikt over Rainbow Canyon, en fargerik formasjon formet av eldgammel vulkansk aktivitet."
	
	key[]: "poi_ca4_04"
	val[]: "Mojave Valley Wells"

	key[]: "poi_ca4_04_desc"
	val[]: "Ved Valley Wells i Mojave registrerer eldgamle grunnvannsutslipp tidligere våtmarksmiljøer fra istiden. De historiske brønnene avslører hvordan grunnvann en gang støttet myrer og frodig vegetasjon i en ellers tørr ørken."

	key[]: "poi_ca4_05"
	val[]: "Colorado River indianerreservat"

	key[]: "poi_ca4_05_desc"
	val[]: "Reservatet strekker seg langs Colorado River i Arizona og California. Etablert i 1865 for stammene i elven, er det hjemmet til Mohave, Chemehuevi, Hopi og Navajo-folk og støtter jordbruk og samfunnsliv i dag."

##########################################################################################

#@}



#+ Idaho TBs and POIs localization.
#@{

    key[]: "tb_id1"
	val[]: "Skattedalen"

	key[]: "tb_id1_desc"
	val[]: "Skattedalen i det sørvestlige Idaho har en rik historie formet av indianerstammer, tidlige pelshandlere og nybyggere i Oregon Trail. Navnet gjenspeiler områdets ressurser og muligheter, og det vokste senere med landbruk, jernbaner og regional handel sentrert rundt Boise."

	key[]: "poi_id1_01"
	val[]: "Lakseelv"

	key[]: "poi_id1_01_desc"
	val[]: "Lakseelven i Idaho strekker seg 425 miles (685 km) gjennom en dyp, robust canyon. Den fikk kallenavnet \"River of No Return\" fordi tidlige båter ikke var i stand til å reise tilbake oppstrøms mot dens sterke, utfordrende strømmer."

	key[]: "poi_id1_02"
	val[]: "Boise nasjonalskog"

	key[]: "poi_id1_02_desc"
	val[]: "Boise nasjonalskog strekker seg over den eroderbare Idaho Batholith, og har et robust landskap smidd av vulkansk aktivitet. Denne geologiske arven sees best i sine bratte kløfter og de mange naturlige varme kildene som er gjemt i terrenget."

	key[]: "poi_id1_03"
	val[]: "Horseshoe Bend"

	key[]: "poi_id1_03_desc"
	val[]: "Etter at gull ble funnet i Boise-bassenget i 1862, grunnla gruvearbeidere som overvintret ved elven Horseshoe Bend. Byen ble opprinnelig kalt Warrinersville for en lokal sagbrukseier, og tok sitt nåværende navn i 1867 da den ble et nøkkelstopp for prospektører."
	
	key[]: "poi_id1_04"
	val[]: "Bompengeport"

	key[]: "poi_id1_04_desc"
	val[]: "I 1864 erstattet en ny canyon-rute den bratte Syrup Creek-stien. I 20 år finansierte bompenger vedlikeholdet, mens James A. Porters berømte hotell og meieri ble et førsteklasses stoppested for reisende som søkte tilflukt."

	key[]: "poi_id1_05"
	val[]: "Castle Rock"

	key[]: "poi_id1_05_desc"
	val[]: "Mot Camas Prairie fungerte Castle Rocks granitt som ikoniske landemerker for Oregon Trail-emigranter på Goodale's Cutoff. De sjeldne formasjonene ble brukt fra 1862 og frem til bilenes tid, og ga reisende et slående syn langs ruten."

    key[]: "poi_id1_06"
	val[]: "Duck Valley indianerreservat"

	key[]: "poi_id1_06_desc"
	val[]: "I 1886 utvidet president Cleveland Duck Valley til Idaho via «Paddy Cap Extension». I 1934 fikk de forskjellige bandene som flyttet til reservatet offisiell føderal anerkjennelse som de forente Shoshone-Paiute-stammene."


##########################################################################################

    key[]: "tb_id2"
	val[]: "Den magiske dalen"

	key[]: "tb_id2_desc"
	val[]: "På begynnelsen av 1900-tallet ble I.B. Perrine gjorde Idahos tørre ørken til jordbruksland ved å bygge Milner Dam. Fullført i 1905 brukte demningen Snake River-vann til å \"magisk\" transformere landskapet. Dette skapte Den magiske dalen, som førte til de blomstrende gårdsbyene som fortsatt eksisterer i dag."

	key[]: "id_cut_perrine_desc"
	val[]: "Høyere enn Niagara Falls på 212 fot (62 m), er Shoshone Falls et vakkert Snake River-landemerke som ligger rett på kanten av Twin Falls."

	key[]: "id_cut_galena_desc"
	val[]: "Denne gruvebyen ble grunnlagt i 1879 etter et bly-sølvfunn, og bleknet på 1890-tallet da prisene falt. I dag trives området som et rekreasjonssenter, hjem til den historiske Galena Lodge og det nærliggende, naturskjønne Galena Summit."

	key[]: "poi_id2_01"
	val[]: "Bison Jump"

	key[]: "poi_id2_01_desc"
	val[]: "Bison Jump ligger ved Challis, og er et historisk sted hvor urbefolkningen trampet bøfler over klippene for å høste. Brukt i over 2000 år, gir dette strategiske landskapet et innblikk i eldgamle felles jakttradisjoner."
	
	key[]: "poi_id2_02"
	val[]: "Grand View Canyon"

	key[]: "poi_id2_02_desc"
	val[]: "Grandview Canyon ligger langs Peaks to Craters Scenic Byway på US-93, og tilbyr fantastisk utsikt over Lost River Range. Denne fjellkjeden er hjemsted for ni av Idahos høyeste topper, noe som gjør canyonen til et høydepunkt på den naturskjønne ruten."

	key[]: "landmark_id_mackay_rs_desc"
	val[]: "Opprinnelig kalt Goddin's River for pelsfangeren Thyery Goddin, Big Lost River er kjent for å synke ned i lavasengene. Dette \"tapte\" vannet går under jorden, og dukker til slutt opp igjen ved de spektakulære Thousand Springs nær Snake River."

    key[]: "poi_id2_03"
	val[]: "Spøkelsesbyene i Mackay"

	key[]: "poi_id2_03_desc"
	val[]: "Basert på \"Mine Hill\" i White Knob gruvedistrikt, drev byer som White Knob og Cliff Creek en kobber-, gull- og sølvboom til midten av 1900-tallet. De stedene er fortsatt viktige rester av Idahos historiske gruveindustri."

	key[]: "id_cut_craters_desc"
	val[]: "Craters of the Moon ble dannet av vulkanutbrudd for 15 000 år siden, og har et stort landskap av lavastrømmer og slaggkjegler. Det overjordiske terrenget er så unikt at NASA-astronauter en gang brukte det til å trene for måneoppdrag."



##########################################################################################

#@}



#+ Montana TBs and POIs localization.
#@{

    key[]: "tb_mt1"
	val[]: "Brepassasjen"

	key[]: "tb_mt1_desc"
	val[]: "Glacier Country er hjemmet til noen av de siste aktive isbreene i Rocky Mountains. I løpet av tusenvis av år har de eldgamle ismassene skåret dype daler, skarpe topper og uberørte innsjøer, og formet landskapet som definerer vestlige Montana i dag."

	key[]: "poi_mt1_01"
	val[]: "Kootenai Falls"

	key[]: "poi_mt1_01_desc"
	val[]: "Kootenai Falls er den største udempte fossen i Montana og en stor regional attraksjon. Kootenai-elven faller omtrent 300 fot (100 m) over en kort avstand, og skaper en kraftig, naturskjønn kaskade som trekker besøkende for sin uforglemmelige utsikt."

	key[]: "poi_mt1_02"
	val[]: "Berne Roadside Park"

	key[]: "poi_mt1_02_desc"
	val[]: "Bad Rock Canyon var et populært stopp for reisende langs Flathead-elven, kjent for fiske, naturskjønn utsikt og en naturlig kilde som en gang ble brukt til å kjøle ned overopphetede bilradiatorer. I 1956 ble det en av Montanas første rasteplasser, kalt Berne Roadside Park."

	key[]: "poi_mt1_03"
	val[]: "Heavens Peak"

	key[]: "poi_mt1_03_desc"
	val[]: "Heaven's Peak, et av Glacier nasjonalparks mest ikoniske fjell, ble navngitt på 1890-tallet av prospektør Louie Meyer. Truffet av dens skjønnhet og den ruvende hagemuren, så oppdagelsesreisende på det som ulikt noe de hadde møtt på reisen."

	key[]: "mt_cut_glacier_national_park_desc"
	val[]: "Glacier nasjonalpark ble feiret som \"kontinentets krone\", og ble etablert i 1910. Formet av eldgamle isbreer, fikk den bredere tilgang i 1932 med fullføringen av Going-to-the-Sun-vei, nå et historisk ingeniørmessig landemerke."

	key[]: "poi_mt1_04"
	val[]: "Blackfeet Indian Memorial"

	key[]: "poi_mt1_04_desc"
	val[]: "På den østlige kanten av Glacier nasjonalpark ligger Blackfeet Nation. Kjent som \"krigerne på slettene\", antas navnet deres å komme fra mokkasiner som er mørklagt med aske. I dag er flere steder i parken fortsatt hellige for stammen."

	key[]: "mt_cut_flathead_lake_desc"
	val[]: "Flathead-sjøen er den største naturlige ferskvannsinnsjøen etter overflateareal i det sammenhengende USA. Matet av snøsmelting fra omkringliggende fjell, fornyes det eksepsjonelt klare vannet fullt ut med noen års mellomrom, noe som gjør det til en av de reneste store innsjøene i verden."

	key[]: "mt_cut_thompson_falls_desc"
	val[]: "Byen ble oppkalt etter den britisk-kanadiske pelshandleren og kartografen David Thompson, og vokste etter at jernbanen ankom i 1881. Den utvidet seg ytterligere under det nærliggende gullrushet Coeur d'Alene, ettersom den ble et nøkkelstopp for gruvearbeidere på vei langs Murray Trail."

	key[]: "landmark_mt_missoula_desc"
	val[]: "Det nyklassiske Missoula County tinghus, bygget av sandstein og designet av AJ Gibson i 1910, erstattet en tidligere, mindre struktur. Missoula County, dannet i 1860, er en av Montanas eldste politiske regioner, som strekker seg fra Bitterroot til Rocky Mountains."

    key[]: "poi_mt1_05"
	val[]: "Lolo Creek"

	key[]: "poi_mt1_05_desc"
	val[]: "Korridoren mellom Lolo og Lolo Pass følger en historisk rute langs Lolo Creek. En gang reist av Nez Perce, tidlige nybyggere og Lewis og Clark-ekspedisjonen, er det fortsatt et viktig kulturelt og historisk landskap preget av tolkningssteder."

##########################################################################################

    key[]: "tb_mt2"
	val[]: "De store slettene"

	key[]: "tb_mt2_desc"
	val[]: "Montanas store slettene strekker seg over den østlige delen av staten, preget av store gressletter, bølgende prærier og stor åpen himmel. Regionen har gitt noen av Nord-Amerikas viktigste dinosaurfossiler, og gir et innblikk i et landskap som eksisterte for millioner av år siden."

	key[]: "poi_mt2_01"
	val[]: "Hell Creek-formasjonen"

	key[]: "poi_mt2_01_desc"
	val[]: "Hell Creek-formasjonen, sentrert langs Hell Creek nær Jordan, Montana, bevarer et gammelt subtropisk landskap av elver, skoger og sumper. Den dateres til 67–66 millioner år siden, og er verdenskjent for sine rike dinosaurfossiler, inkludert den ikoniske Tyrannosaurus rex."

	key[]: "poi_mt2_02"
	val[]: "Yellowstone-elven"

	key[]: "poi_mt2_02_desc"
	val[]: "Yellowstone-elven er den lengste frittflytende elven i det sammenhengende USA. Den stiger opp i Yellowstone nasjonalpark og reiser 676 miles (1090 km) gjennom Wyoming og Montana før den slutter seg til Missouri-elven, og renner hele sin lengde uten en eneste demning."

	key[]: "poi_mt2_03"
	val[]: "Glendisaurus"

	key[]: "poi_mt2_03_desc"
	val[]: "Glendisaurus, en triceratops-statue i naturlig størrelse i Glendive, feirer regionens rike dinosaurarv. Den er omtrent 10 fot (3 m) høy og fungerer som et populært landemerke langs Dinosaurstien."
	
	key[]: "poi_mt2_04"
	val[]: "Missouri-elven"

	key[]: "poi_mt2_04_desc"
	val[]: "Missouri-elven, kjent som \"Big Muddy\", er den lengste elven i USA. Den flyter 2341 miles (3767 km) fra Montanas Rocky Mountains til Mississippi-elven, og spilte en viktig rolle i utforskning, handel og vestover utvidelsen av den amerikanske grensen."

	key[]: "mt_cut_fort_peck_spillway_desc"
	val[]: "Fort Peck-demningen, bygget under den store depresjonen, er verdens største hydraulisk fylte jorddemning. Fullført som et av USAs største offentlige byggeprosjekter, ble det designet for å skaffe arbeidsplasser, kontrollere flom og generere vannkraft."

    key[]: "poi_mt2_05"
	val[]: "Valley County Pioneer-museumet"

	key[]: "poi_mt2_05_desc"
	val[]: "Dette museet viser historien til det nordøstlige Montana gjennom utstillinger om Assiniboine-folket, jernbaner, landbruk, Fort Peck-demningen og Lewis and Clark-ekspedisjonen. Det rommer også omfattende arkiver og en av de største Assiniboine-samlingene i landet."

	key[]: "poi_mt2_06"
	val[]: "Sleeping Buffalo Rock"

	key[]: "poi_mt2_06_desc"
	val[]: "De store bresteinene var hellige landemerker for urfolksstammer. Gamle isbreer skåret ut og fraktet dem. Den mindre steinen, \"Buffalo Rock,\" ble skåret ut for å ligne en bøffel, mens den større, \"Medicine Rock,\" har forskjellige helleristninger."



##########################################################################################

#@}



#+ Wyoming TBs and POIs localization.
#@{

    key[]: "tb_wy1"
	val[]: "Bøffelstien"

	key[]: "tb_wy1_desc"
	val[]: "Hjem til Yellowstone og Grand Teton, ligger den på et aktivt vulkansystem som driver geysirer og varme kilder, mens isbreer og forkastninger formet toppene, daler. Sammen gjør disse kreftene Northwest Wyoming til et av de mest geologisk dynamiske og visuelt ikoniske landskapene i det amerikanske vesten."

	key[]: "landmark_wy_yellowsto_desc"
	val[]: "Yellowstone, etablert i 1872 som verdens første nasjonalpark, ligger på toppen av en massiv sovende vulkan. Hjemmet til omtrent halvparten av verdens aktive geysirer, beskytter den også et av de største og mest intakte tempererte økosystemene på jorden."

	key[]: "poi_wy1_01"
	val[]: "Nedre geysirbasseng"

	key[]: "poi_wy1_01_desc"
	val[]: "Nedre geysirbasseng er Yellowstones største geysirbasseng, med en enorm konsentrasjon av geysirer, varme kilder og dampventiler. Drevet av varme fra dyp underjordisk magma, viser den et av parkens mest aktive geotermiske landskap."

	key[]: "poi_wy1_02"
	val[]: "Yellowstone-sjøen"

	key[]: "poi_wy1_02_desc"
	val[]: "Yellowstone-sjøen er Nord-Amerikas største høye innsjø og støtter kontinentets største bestand av vill ørret. Forskere tror det en gang drenerte mot Stillehavet, slik at fisk kunne krysse Continental Divide gjennom Two Ocean-passasjen."
	
	key[]: "poi_wy1_03"
	val[]: "Buffalo Bill-demningen"

	key[]: "poi_wy1_03_desc"
	val[]: "Buffalo Bill-demningen ble fullført i 1910 og var en av de første betongbuedammene i USA. Stående 325 fot (99 m) høy, var det den høyeste demningen i verden på den tiden og ble et landemerke for tidlig ingeniørinnovasjon."

	key[]: "poi_wy1_04"
	val[]: "Colters Hell"

	key[]: "poi_wy1_04_desc"
	val[]: "Colter’s Hell er et historisk geotermisk område langs Shoshone-elven, navngitt av oppdagelsesreisende John Colter i 1807. Tidlige fjellmenn sammenlignet dens dampende ventiler og svovellukt med «helvete». I dag er det bare varme kilder og dampventiler som er aktive."

	key[]: "wy_cut_grand_teton_desc"
	val[]: "Grand Teton nasjonalpark er definert av sine isbreutskårne topper som stiger skarpt over Jackson Hole. En gang kalt \"Pilot Knobs\" av pelsfangere for deres synlighet over slettene, er fjellene fortsatt blant de mest ikoniske landemerkene i det amerikanske vesten."

	key[]: "poi_wy1_05"
	val[]: "Crowheart Butte"

	key[]: "poi_wy1_05_desc"
	val[]: "Crowheart Butte er et fremtredende landemerke oppkalt etter en kamp i 1866 mellom Shoshone- og Crow-stammene. Ifølge tradisjonen plasserte høvding Washakie en kråkehøvdingshjerte på toppen etter Shoshone-seieren som en advarsel, og ga formasjonen sitt varige navn."

##########################################################################################

    key[]: "tb_wy2"
	val[]: "Den røde ørkenen"

	key[]: "tb_wy2_desc"
	val[]: "Wyomings røde ørken er et stort høyt ørkenbasseng definert av vindskulpturert sand, sagebrush-sletter og slående røde fjellformasjoner. Et av de største ubebodde områdene i Nord-Amerika, det er formet av ekstremt klima, eldgamle innsjøsenger og lange migrasjonsruter."

	key[]: "poi_wy2_01"
	val[]: "Red Canyon"

	key[]: "poi_wy2_01_desc"
	val[]: "Red Canyon ble skåret ut under hevingen av Wind River Range for rundt 60 millioner år siden. Dens karakteristiske røde klipper er dannet av Chugwater-bergarten, hvilket oksiderte jern gir canyon den livlige fargen som inspirerte navnet."

	key[]: "poi_wy2_02"
	val[]: "Maktens landskap"

	key[]: "poi_wy2_02_desc"
	val[]: "Boar's Tusk, en vulkansk fjellformasjon som reiser seg over 400 fot (130 m) over Wyomings røde ørken, er den eroderte kjernen av en vulkan som ble dannet for millioner av år siden. Det har utsikt over de enorme Killpecker-sanddynene, en del av Nord-Amerikas største aktive sanddynefelt."

	key[]: "poi_wy2_03"
	val[]: "Rock Springs"

	key[]: "poi_wy2_03_desc"
	val[]: "Rock Springs er kjent som \"City of 56 Nationalities\" for sin mangfoldige innvandrerarv. På slutten av 1800-tallet kom folk fra hele verden for å jobbe i Union Pacific kullgruver. Byen er også knyttet til den berømte fredløs Butch Cassidy."
	
	key[]: "poi_wy2_04"
	val[]: "Butch Cassidy hytte"

	key[]: "poi_wy2_04_desc"
	val[]: "Butch Cassidy var en berømt amerikansk lovløs som ledet \"Wild Bunch\", en gjeng kjent for tog- og bankran i det gamle vesten. Han fikk kallenavnet \"Butch\" mens han jobbet i en slakterbutikk i Rock Springs. Det mest legendariske og innflytelsesrike ranet var Wilcox Train Robbery i 1899."

	key[]: "wy_cut_evanston_desc"
	val[]: "Evanston ble grunnlagt i 1869 av Union Pacific Railroad, og ble oppkalt etter landmåler James A. Evans. Byen vokste som et jernbaneknutepunkt og ble senere et regionalt senter for landbruk, olje og gass."

    key[]: "poi_wy2_05"
	val[]: "Lander Cutoff"

	key[]: "poi_wy2_05_desc"
	val[]: "Lander Cutoff ble bygget etter Pacific Wagon Road Act fra 1857, og var en av de første føderalt finansierte vognveiene i det amerikanske vesten. Oppkalt etter ingeniør Frederick W. Lander, ga den en kortere rute for emigranter som reiste vestover."

	

##########################################################################################

#@}


#+ South Dakota TBs and POIs localization.
#@{

    key[]: "tb_sd1"
	val[]: "The Black Hills"

	key[]: "tb_sd1_desc"
	val[]: "Western South Dakota er definert av Black Hills og Badlands. Her stiger enorme prærier opp til furutrukne fjell, granittspir og streifende bisonflokker. Like bortenfor avslører de robuste Badlands et slående landskap skåret ut av vind og vann gjennom millioner av år."

	key[]: "poi_sd1_01"
	val[]: "Black Hills nasjonalskog"

	key[]: "poi_sd1_01_desc"
	val[]: "Kjent for Lakota som Paha Sapa som betyr \"Hills That Are Black\", denne furutrukne regionen er hjemmet til Black Elk Peak, South Dakotas høyeste punkt på 7244 fot (2207 m). Omdøpt til ære for den berømte Lakota-healeren, er det også den høyeste toppen øst for Rockies."

	key[]: "sd_cut_rush_desc"
	val[]: "Mount Rushmore, kjent som USAs \"Shrine of Democracy\", ble skåret inn i Black Hills mellom 1927 og 1941. Monumentet har 60 fot (20 m) store skulpturer av presidentene Washington, Jefferson, Roosevelt og Lincoln, som representerer landets fødsel, vekst, utvikling og bevaring."

	key[]: "poi_sd1_02"
	val[]: "Beaver Creek-broen"

	key[]: "poi_sd1_02_desc"
	val[]: "Bygget i 1929, spenner denne 225 fots stål- og betongbuebroen over en canyon nær Wind Cave nasjonalpark. Den rager 115 fot (35 m) over canyongulvet, og er South Dakotas eneste bro i sitt slag og ble designet for å blande seg sømløst med den omkringliggende steinen."

	key[]: "sd_cut_sturgis_desc"
	val[]: "Sturgis er kjent for å være vertskap for verdens største motorsykkelrally. Det årlige 10-dagers arrangementet ble startet i 1938 av den lokale indiske forhandleren Pappy Hoel, og bringer ryttere fra hele verden til Black Hills for motorsykkelshow, løp, musikk og feiringer."

	key[]: "sd_cut_deadwood_desc"
	val[]: "Deadwood steg opp under gullrushet i Black Hills i 1876 og ble en av det ville vestens mest beryktede byer. Utpekt som et nasjonalt historisk landemerke i 1961, er det den eneste byen i USA med den statusen, og har bevart mye av det historiske sentrum."

	key[]: "sd_cut_badlands_desc"
	val[]: "Badlands nasjonalpark spenner over 244 000 dekar med røtter, tinder og spir langs nasjonens største beskyttede prærie med blandet gress. Den bevarer også en av verdens rikeste fossile senger, og avslører eldgamle pattedyr som en gang streifet rundt på Great Plains."

	key[]: "poi_sd1_03"
	val[]: "Doane Robinson-tunnelen"

	key[]: "poi_sd1_03_desc"
	val[]: "Doane Robinson, kjent som \"Father of Mount Rushmore,\" så for seg et storslått monument i Black Hills for å tiltrekke besøkende til South Dakota. I dag fortsetter arven hans, med Mount Rushmore perfekt innrammet gjennom den naturskjønne Doane Robinson-tunnelen."

	key[]: "sd_cut_hot_springs_desc"
	val[]: "Hot Springs, opprinnelig kalt Minnekahta av Sioux for sine \"varme vann\", ble avgjort i 1879 rundt mineralkilder som antas å ha helbredende krefter. Omdøpt i 1882, ble det et kursted og er fortsatt kjent for det historiske Evans Plunge."

	key[]: "poi_sd1_04"
	val[]: "Mammoth-stedet"

	key[]: "poi_sd1_04_desc"
	val[]: "Mammoth-stedet er en verdensberømt fossilgrav fra istiden hvor 61 mammuter er blitt avdekket. Det eldgamle synkehullet ble oppdaget i 1974 og bevarer den største samlingen av colombianske mammutrester i Nord-Amerika, med utgravninger som fortsatt pågår i dag."

##########################################################################################

    key[]: "tb_sd2"
	val[]: "Det store skillet"

	key[]: "tb_sd2_desc"
	val[]: "Sør-Dakotas Missouri-elven-regionen markerer delstatens sentrale skille, med brede sletter på den ene siden og bølgende åser på den andre. Det var en nøkkelkorridor for innfødte nasjoner, pelshandlere og Lewis og Clark, og ble senere hjemsted for store demninger, grensebyer og rik elvehistorie."

	key[]: "poi_sd2_01"
	val[]: "Fire store innsjøer"

	key[]: "poi_sd2_01_desc"
	val[]: "Laget av demninger ved Missouri-elven på slutten av 1940-tallet, definerer Lakes Oahe, Sharpe, Francis Case og Lewis & Clark nå sentrale South Dakota. Til sammen gir disse reservoarene mer enn 440 miles (710 km) med kystlinje for båtliv, fiske og rekreasjon."

	key[]: "poi_sd2_02"
	val[]: "Spøkelsesbyen Bangor"

	key[]: "poi_sd2_02_desc"
	val[]: "Bangor var en gang fylkesetet i Walworth County, men ble en spøkelsesby etter at bygningene ble flyttet til nærliggende Selby i 1899. I dag er det bare et monument som markerer stedet der byen en gang lå."

	key[]: "landmark_sd_state_capitol_desc"
	val[]: "Pierre ble grunnlagt i 1880, og ble Sør-Dakotas hovedstad da delstaten ble medlem av Unionen i 1889. Byen ble valgt på grunn av sin sentrale beliggenhet og Missouri-elven, og ble oppkalt etter den fransk-amerikanske pelshandleren Pierre Chouteau Jr."

	key[]: "sd_cut_corn_desc"
	val[]: "Kornpalasset i Mitchell er verdens eneste palass som er dekorert helt med mais. Hvert år lager lokale kunstnere og bønder nye veggmalerier med naturlig farget mais, korn og gress, noe som gjør det til et av South Dakotas mest unike landemerker."

	key[]: "landmark_sd_largest_pheasant_desc"
	val[]: "Huron er hjemmet til verdens største fasan, en 40 fot (13 m) høy glassfiber- og stålskulptur bygget i 1959. Den veier 22 tonn og feirer regionens langvarige rykte som en av USAs fremste fasanjaktdestinasjoner."

	key[]: "landmark_sd_dignity_of_earth_and_sky_desc"
	val[]: "Dignity Of Earth & Sky er en 50 fot (17 m) skulptur i rustfritt stål med utsikt over Missouri-elven nær Chamberlain. Laget av kunstneren Dale Lamphere, og hedrer arven, motstandskraften og kulturene til Lakota- og Dakota-folket."

##########################################################################################

