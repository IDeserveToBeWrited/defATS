#### 2_09 msg - intro text

	key[]: "aca_msg_book1_2_09_cutscene1"
	val[]: "Parallellparkering er en avgjørende ferdighet som alle lastebilsjåfører bør kjenne til.<br>Forberede deg på å sette i gang."

	key[]: "aca_msg_book1_2_09_cutscene2"
	val[]: "Kjør mot parkeringsplassen.<br>Vær oppmerksom på omgivelsene dine."

	key[]: "aca_msg_book1_2_09_cutscene3"
	val[]: "Still deg på linje med lastebilen foran din parkeringsplass. Ikke vær for nærme den, hold litt avstand fra den slik at du har plass til å jobbe."

	key[]: "aca_msg_book1_2_09_cutscene4"
	val[]: "Snu skarpt mot plassen og begynn å rygge."

	key[]: "aca_msg_book1_2_09_cutscene5"
	val[]: "Når du ser ut fra førersidespeilet, sikt deg mot fortauskanten rett foran lastebilen bak deg."

	key[]: "aca_msg_book1_2_09_cutscene6"
	val[]: "Når den fremre støtfangeren din klarerer lastebilen foran deg, kan du begynne å styre frontenden av lastebilen inn på stedet, og justere lastebilen med parkeringsplassen."

	key[]: "aca_msg_book1_2_09_cutscene7"
	val[]: "Rett ut hjulet og sentrer lastebilen innenfor parkeringsplassen.<br>Parkere og sikre lastebilen."

#### 2_09 Driving Instructions

	key[]: "aca_msg_book1_2_09_start"
	val[]: "Foran deg er det noen parkerte lastebiler. Det er én åpen plass igjen for deg å parkere på. <br><br><font face=/font/big_bold.font>Forberede deg på å sette av gårde. </font>"

	key[]: "aca_msg_book1_2_09_check1"
	val[]: "Husk å være oppmerksom på omgivelsene dine. Gjør god bruk av speilene dine gjennom hele denne manøveren. <br><br><font face=/font/big_bold.font>Kjør framover. </font>"

	key[]: "aca_msg_book1_2_09_stopmid"
	val[]: "<color value=@@clr_white@@>Kjør forbi parkeringsplassen og inn i det merkede området. Derfra kan du begynne med din ryggemanøvrering.<br><br><font face=/font/big_bold.font>Stopp på det merkede stedet. </font>"

	key[]: "aca_msg_book1_2_09_checkmirror"
	val[]: "Sjekk omgivelsene dine for hindringer og for å sikre at du er klar til å rygge.<br><br><font face=/font/big_bold.font>Se gjennom passasjerens sidespeil. </font>"

	key[]: "aca_msg_book1_2_09_backward"
	val[]: "Snu hjulene og rygge inn på parkeringsplassen.<br><br><font face=/font/big_bold.font>Begynn å rygge. </font>"

	key[]: "aca_msg_book1_2_09_stop"
	val[]: "Begynn å rette opp lastebilen når det passer. Ikke kjør over fortauskanten!<br><br><font face=/font/big_bold.font>Sett lastebilen på linje med stedet. </font>"
#!{
	key[]: "aca_msg_book1_2_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_01
#@{

#### 3_01 common
	key[]: "aca_scenario_book1_3_01_title"
	val[]: "Koble til en henger"

	key[]: "aca_scenario_book1_3_01_desc"
	val[]: "I dette scenarioet vil vi forklare det grunnleggende om å koble til og fra traktorenheten til en henger."

#### 3_01 goal

	key[]: "aca_goal_book1_3_01_check_con"
	val[]: "Rygge til hengeren"

	key[]: "aca_goal_book1_3_01_connect"
	val[]: "Koble til hengeren"

	key[]: "aca_goal_book1_3_01_park_br_off"
	val[]: "Løsne parkeringsbremsen"


	key[]: "aca_goal_book1_3_01_disc5"
	val[]: "Koble fra hengeren"

	key[]: "aca_goal_book1_3_01_park_br_off2"
	val[]: "Koble fra hengeren"

	key[]: "aca_goal_book1_3_01_disconnect"
	val[]: "Koble fra hengeren"

	key[]: "aca_goal_book1_3_01_stop"
	val[]: "Stopper i det angitte området"
#!{
	key[]: "aca_goal_book1_3_01_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

