	key[]: "aca_book_disclaimer_t"
	val[]: "ANSVARSFRASKRIVELSE"

	key[]: "aca_book_disclaimer_topbar"
	val[]: "Dette er ikke et sertifisert opplæringsprogram."

	key[]: "aca_book_disclaimer"
	val[]: "<color value=@@clr_sel@@><font face=/font/big_bold.font>@@driving_academy@@ er ikke ment å erstatte i førerhusopplæring.</font><br><br> <color value=@@clr_txt@@>Vi anbefaler på det sterkeste at du oppsøker instruksjon fra en akkreditert lastebilopplæringsinstitusjon før du forsøker å kjøre en lastebil i det virkelige livet.<br><br>Opplæringsinstitusjoner som er interessert i å bruke @@driving_academy@@ som supplement til drosjesjåføropplæring kan kontakte oss på academy@scssoft.com."

	key[]: "aca_book_book1_title"
	val[]: "Grunnleggende lastebilkjøring"

	key[]: "aca_book_book1_desc"
	val[]: "Lær de grunnleggende delene ved lastebilkjøring, fra grunnleggende funksjoner og kontroller til manøvrering med en henger."

	key[]: "aca_book_book2_title"
	val[]: "Lastebilkjøringsferdigheter"

	key[]: "aca_book_book2_desc"
	val[]: "Finslip lastebilkjøringsferdighetene dine med nye scenarioer under mer utfordrende forhold."

	key[]: "aca_book_book3_title"
	val[]: "Dobbel hengerhåndtering"

	key[]: "aca_book_book3_desc"
	val[]: "Ta fatt på de kuriøse utfordringene med å kjøre og rygge med en B-dobbel kombinasjon."
#@}

