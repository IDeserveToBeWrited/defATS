#+ Book 1 Scenario 3_03
#@{

#### 3_03 common
	key[]: "aca_scenario_book1_3_03_title"
	val[]: "Kjøring på veibanen"

	key[]: "aca_scenario_book1_3_03_desc"
	val[]: "I dette scenarioet vil vi utforske å manøvrere hengeren gjennom en kort, men kompleks hinderbane."

#### 3_03 goal
#!{
	key[]: "aca_goal_book1_3_03_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_03_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_03_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_03_end"
	val[]: "@@aca_goal_book1_2_01_end@@"


 #!}
	key[]: "aca_goal_book1_3_03_check1"
	val[]: "Første sving"

	key[]: "aca_goal_book1_3_03_check2"
	val[]: "Rundkjøring"

	key[]: "aca_goal_book1_3_03_check3"
	val[]: "90 graders sving"

	key[]: "aca_goal_book1_3_03_check4"
	val[]: "Kannehåndtakssving"

	key[]: "aca_goal_book1_3_03_check5"
	val[]: "Knappkrokssving"

	key[]: "aca_goal_book1_3_03_check6"
	val[]: "Trang sving"


#### generic phrase

	key[]: "aca_goal_book1_3_03_chk_point"
	val[]: "Kjøring rundt barrierene"

#### 3_03 msg - intro text

	key[]: "aca_msg_book1_3_03_cutscene01"
	val[]: "Forut er en rekke komplekse hjørner og hindringer.<br>Ta i betraktning alt du har lært så langt, så burde det ikke være for vanskelig."

	key[]: "aca_msg_book1_3_03_cutscene02"
	val[]: "Det første hjørnet er en enkel krokssving. Hold bredt, så burde det ikke være noe problem."

	key[]: "aca_msg_book1_3_03_cutscene03"
	val[]: "Fortsett videre mot rundkjøringen."

	key[]: "aca_msg_book1_3_03_cutscene04"
	val[]: "Hold hengeren unna innsiden av rundkjøringen ved å kjøre traktoren så bredt som mulig rundt den."

	key[]: "aca_msg_book1_3_03_cutscene05"
	val[]: "90 graders svingen til venstre er ikke spesielt stram, men pass på at du ikke treffer noen kjegler."

	key[]: "aca_msg_book1_3_03_cutscene06"
	val[]: "Denne svingen er betydelig strammere. Bruk en kannehåndtaksmanøvre for å fullføre den."

	key[]: "aca_msg_book1_3_03_cutscene07"
	val[]: "Du kan bruke en knappkrok-manøvre i denne svingen, men det er noen ekstra hindringer å unngå."

	key[]: "aca_msg_book1_3_03_cutscene09"
	val[]: "Nok en gang er den siste svingen veldig trang og vil kreve en kombinasjon av både kannehåndtak og knappekroksmanøvre for å fullføre."

	key[]: "aca_msg_book1_3_03_cutscene10"
	val[]: "Parkere på det angitte området, sikre lastebilen og skru av motoren."


#### 3_03 Driving Instructions



	key[]: "aca_msg_book1_3_03_forward"
	val[]: "<font face=/font/big_bold.font>Fortsett til den første svingen. </font>"

	key[]: "aca_msg_book1_3_03_check1"
	val[]: "Den første svingen er en enkel krokssving.<br><br><font face=/font/big_bold.font><color value=@@clr_txt@@>Fortsett gjennom svingen. </font>"

	key[]: "aca_msg_book1_3_03_check2"
	val[]: "Fortsett til rundkjøringen. Husk å ta en bred sti rundt den.<br><br><font face=/font/big_bold.font>Kjør til og rundt rundkjøringen.</font>"

	key[]: "aca_msg_book1_3_03_check3"
	val[]: "Denne 90 graders svingen er litt strammere, pass på at du ikke treffer noen kjegler.<br><br><font face=/font/big_bold.font>Gjør svingen.</font>"

	key[]: "aca_msg_book1_3_03_check4"
	val[]: "Denne svingen tilnærmes best med en kannehåndtaksprosedyre. Sving bredt før du går inn i krysset.<br><br><font face=/font/big_bold.font>Gjør en kannehåndtakssving. </font>"

	key[]: "aca_msg_book1_3_03_check5"
	val[]: "Denne svingen er strødd med flere forskjellige hindringer, men det kan gjøres med en knappekroksmanøvre.<br><br><font face=/font/big_bold.font>Fortsett forsiktig. </font>"

	key[]: "aca_msg_book1_3_03_check6"
	val[]: "Denne svingen er den trangeste til nå, håndtere den som det passer.<br><br><font face=/font/big_bold.font>Sving inn på parkeringsplassen.</font>"
#!{
	key[]: "aca_msg_book1_3_03_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_03_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

#@}

#+ Book 1 Scenario 3_04
#@{

#### 3_04 common
	key[]: "aca_scenario_book1_3_04_title"
	val[]: "Avansert opplæringsbane - Henger"

	key[]: "aca_scenario_book1_3_04_desc"
	val[]: "I det siste scenarioet i kapittel 3 tar vi en kjøretur på et lengre treningsbane med en rekke forskjellige svinger for å se hvor godt du har lært å manøvrere med en henger."

#### 3_04 goal



	key[]: "aca_goal_book1_3_04_check1"
	val[]: "Enkle svinger"

	key[]: "aca_goal_book1_3_04_check2"
	val[]: "Enkel 90 graders sving"

	key[]: "aca_goal_book1_3_04_check3"
	val[]: "Kommer inn på dobbel hårnålssving"

	key[]: "aca_goal_book1_3_04_check4"
	val[]: "Kommer ut av dobbel hårnålssving"

	key[]: "aca_goal_book1_3_04_check5"
	val[]: "Small seksjon"

	key[]: "aca_goal_book1_3_04_check6"
	val[]: "Enkel 90 graders sving"

	key[]: "aca_goal_book1_3_04_check7"
	val[]: "Trang hårnål"

	key[]: "aca_goal_book1_3_04_check8"
	val[]: "Trang 90 graders sving"

	key[]: "aca_goal_book1_3_04_check9"
	val[]: "Kompleks hårnålssving"

	key[]: "aca_goal_book1_3_04_check10"
	val[]: "Siste sving"

	key[]: "aca_goal_book1_3_04_check11"
	val[]: "Fortsett til det angitte området"
#!{
	key[]: "aca_goal_book1_3_04_stop"
