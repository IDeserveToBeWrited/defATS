	key[]: "aca_scenario_book2_night_parallel_title"
	val[]: "Parallellparkering om natten"

	key[]: "aca_scenario_book2_night_parallel_desc"
	val[]: "I dette tilfellet må du parkere parallelt ved siden av en fortauskant. Det er natt, så sikten vil være begrenset."

#### intro text

	key[]: "aca_scenario_book2_night_parallel_cutscene1"
	val[]: "Tid og vær er ikke alltid ideelt når du endelig trenger å parkere for natten, så du må være ekstra oppmerksom på dine omgivelser.<br><br>Ikke glem å skru på lysene!"

#@}


#+ Book 2 blindside_parking_options
#@{
#### common
	key[]: "aca_scenario_book2_blindside_parking_options_title"
	val[]: "Blinde avgjørelser"

	key[]: "aca_scenario_book2_blindside_parking_options_desc"
	val[]: "I dette scenarioet vil du ha tre forskjellige parkeringsplasser å rygge inn i fra blindsiden; hver av dem vil by på sin egen unike utfordring."

#### intro text

	key[]: "aca_scenario_book2_blindside_parking_options_cutscene1"
	val[]: "Det er tre ledige parkeringsplasser å velge mellom. Hver av dem har en fordel til en annen kostnad, så velg den som passer best til din ryggestil."

#@}


#+ Book 2 driving_course
#@{
#### common
	key[]: "aca_scenario_book2_driving_course_title"
	val[]: "Vridd"

	key[]: "aca_scenario_book2_driving_course_desc"
	val[]: "I dette scenarioet har du i oppgave å kjøre gjennom et svært komplekst treningsbane. Underveis må du finne og koble til en henger, og deretter ta den med deg til slutten."

#### intro text

	key[]: "aca_scenario_book2_driving_course_cutscene1"
	val[]: "Dette scenarioet vil sette din romlige og situasjonsmessige forståelse på prøve. Banen framover er full av hindringer som du ikke alltid lett vil kunne få øye på."

	key[]: "aca_scenario_book2_driving_course_cutscene2"
	val[]: "Ta deg gjennom banen til hengeren. Når du har funnet den, koble til den og dra den til den endelige parkeringsplassen."

#@}

#+ Book 2 saturday_night
#@{
#### common
	key[]: "aca_scenario_book2_saturday_night_title"
	val[]: "Røm fra lastebilstoppet"

	key[]: "aca_scenario_book2_saturday_night_desc"
	val[]: "I dette scenarioet må du forsiktig finne din vei ut av en fullpakket parkeringsplass midt på natten."

#### intro text

	key[]: "aca_scenario_book2_saturday_night_cutscene1"
	val[]: "Desperate og slitne sjåfører vil parkere hvor som helst de kan finne en plass, selv om det kan være upraktisk for deres medsjåførene. <br><br>Arbeid deg gjennom tomten mot utgangen, men vær forsiktig med å ikke treffe noen andre lastebiler!"

#@}


#+ Book 2 Streets
#@{
#### common
	key[]: "aca_scenario_book2_streets_title"
	val[]: "Kjøring i regnet"

	key[]: "aca_scenario_book2_streets_desc"
	val[]: "I dette scenarioet vil du øve på å kjøre gjennom byen på vått underlag med redusert sikt."

#### intro text

	key[]: "aca_scenario_book2_streets_cutscene1"
	val[]: "Din oppgave er å kjøre langs den angitte ruten. Svingene er hovedsakelig 90-graders hjørner, så det burde ikke være mye som overrasker deg her."

#@}


#+ Book 2 threading_needle
#@{
#### common
	key[]: "aca_scenario_book2_threading_needle_title"
	val[]: "Spredt hjerne"

	key[]: "aca_scenario_book2_threading_needle_desc"
	val[]: "I dette scenariet må du kreativt finne en måte å komme deg til alle veipunktene og til den endelige parkeringsplassen."

#### intro text

	key[]: "aca_scenario_book2_threading_needle_cutscene2"
	val[]: "Noen av dem kan være umulige å nå med tilkoblet henger..."


#@}


