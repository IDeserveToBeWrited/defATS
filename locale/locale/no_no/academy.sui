	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_04_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


 #!}
#### 3_04 msg - intro text

	key[]: "aca_msg_book1_3_04_cutscene01"
	val[]: "Husk å planlegge på forhånd for hver sving og bruk plassen rundt deg godt. Kjør rundt det første settet med barrierer og inn på banen."

	key[]: "aca_msg_book1_3_04_cutscene02"
	val[]: "De første svingene blir gradvis skarpere etter hvert."

	key[]: "aca_msg_book1_3_04_cutscene03"
	val[]: "Husk at hvordan du kommer ut av en sving kan påvirke hvordan du kommer inn i den neste."

	key[]: "aca_msg_book1_3_04_cutscene04"
	val[]: "Det første av de mer utfordrende hjørnene kombinerer to hårnålssvinger til én. Du må være veldig forsiktig og bevisst når du kjører og bruke speilene til din fordel."

	key[]: "aca_msg_book1_3_04_cutscene05"
	val[]: "Fortsett gjennom den smale delen."

	key[]: "aca_msg_book1_3_04_cutscene06"
	val[]: "Neste er et par enkle hjørner på din vei mot en trang hårnål."

	key[]: "aca_msg_book1_3_04_cutscene07"
	val[]: "Hold hodet på en svivel for å sikre at du ikke treffer noen av barrierene. Gå så sakte du trenger."

	key[]: "aca_msg_book1_3_04_cutscene08"
	val[]: "Selv når det ser ut til å være stort manøvreringsrom, kan du likevel havne i en trang situasjon."

	key[]: "aca_msg_book1_3_04_cutscene09"
	val[]: "Den mest komplekse svingen er like foran. Inngangen din til svingen avgjør om du kommer deg gjennom vellykket eller ikke."

	key[]: "aca_msg_book1_3_04_cutscene10"
	val[]: "Fortsett gjennom den siste svingen."

	key[]: "aca_msg_book1_3_04_cutscene11"
	val[]: "Stopp på det angitte området, sikre lastebilen og skru av motoren."
#!{
	key[]: "aca_msg_book1_3_04_cutscene12"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_04_cutscene13"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_04_cutscene14"
	val[]: "Unused"
#!}

#### 3_04 Driving Instructions



	key[]: "aca_msg_book1_3_04_forward"
	val[]: "<font face=/font/big_bold.font>Akselerer og kjør rundt barrierene. </font>"

	key[]: "aca_msg_book1_3_04_check1"
	val[]: "Fortsett inn på banen og gjennom de to første enkle svingene.<br><br><font face=/font/big_bold.font>Fortsett å kjøre. </font>"

	key[]: "aca_msg_book1_3_04_check2"
	val[]: "<font face=/font/big_bold.font>Gjør 90 graders svingen.</font>"

	key[]: "aca_msg_book1_3_04_check3"
	val[]: "Neste del av banen er en dobbel hårnål. Hvordan du manøvrerer deg gjennom den første delen vil direkte påvirke veien gjennom den andre delen.<br><br><font face=/font/big_bold.font>Fortsett med forsiktighet. </font>"

	key[]: "aca_msg_book1_3_04_check4"
	val[]: "Når du kommer ut av hårnålene, hold til venstre for å forberede innkjøringen til den smale seksjonen.<br><br><font face=/font/big_bold.font>Fortsett å kjøre. </font>"

	key[]: "aca_msg_book1_3_04_check5"
	val[]: "<font face=/font/big_bold.font>Fortsett å kjøre gjennom den smale delen. </font>"

	key[]: "aca_msg_book1_3_04_check6"
	val[]: "Foran er et par enkle 90 graders svinger.<br><br><font face=/font/big_bold.font>Gjør svingene. </font>"

	key[]: "aca_msg_book1_3_04_check7"
	val[]: "Du nærmer deg en annen hårnål. Overvåk din henger i speilet når du nærmer deg. <br><br><font face=/font/big_bold.font>Kjør gjennom hårnålen. </font>"

	key[]: "aca_msg_book1_3_04_check8"
	val[]: "90 graders svingen framover er mye strammere enn den ser ut til. Bruk plassen din med omhu.<br><br><font face=/font/big_bold.font>Fortsett å kjøre. </font>"

	key[]: "aca_msg_book1_3_04_check9"
	val[]: "Den siste hårnålen er kompleks, med nesten ingen plass til overs. <br><br><font face=/font/big_bold.font>Fortsett med forsiktighet.</font>"

	key[]: "aca_msg_book1_3_04_check10"
	val[]: "En siste 90 graders sving venter på deg.<br><br><font face=/font/big_bold.font>Fortsett å kjøre. </font>"

	key[]: "aca_msg_book1_3_04_check11"
	val[]: "Fortsett til det angitte området."
