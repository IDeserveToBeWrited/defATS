	#### diag common

	key[]: "aca_scenario_book3_diag_title"
	val[]: "Diagonal parkering med B-doble hengere"

	key[]: "aca_scenario_book3_diag_desc"
	val[]: "I dette scenarioet parkerer du din B-dobbelkombinasjon på en diagonal parkeringsplass på en travel parkeringsplass. "

#### diag msg - intro text

	key[]: "aca_msg_book3_diag_cutscene1"
	val[]: "Diagonale parkeringsplasser som denne er svært vanlige. De er spesielt vanlige på eldre lastebilrasteplass, så vel som på de mange rasteplassene langs Amerikas motorveier."

	key[]: "aca_msg_book3_diag_cutscene2"
	val[]: "Kjør mot den angitte parkeringsplassen nær enden av raden."

	key[]: "aca_msg_book3_diag_cutscene3"
	val[]: "Hold deg mot utsiden av kjørefeltet, men ikke tett inntil sperringene, da bakenden av hengeren kan treffe dem under innsvinging."

	key[]: "aca_msg_book3_diag_cutscene4"
	val[]: "Kjør forbi parkeringsplassen for å gi plass til begge hengerne kan følge etter deg inn. Dykk deretter mot den andre siden av plassen for å bringe den første hengeren i posisjon."

	key[]: "aca_msg_book3_diag_cutscene5"
	val[]: "Rett deg ut, stopp deretter i det angitte området og sikre lastebilen."

