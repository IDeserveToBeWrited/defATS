#+ Book 1 Scenario 1_01
#@{

#### 1_01 common
	key[]: "aca_scenario_book1_1_01_title"
	val[]: "Før du kjører"

	key[]: "aca_scenario_book1_1_01_desc"
	val[]: "For ditt første scenario går vi gjennom det grunnleggende om førerhuset. Det er viktig å justere setet, rattet og sidespeilene riktig fordi det er viktig å ha god utsikt for å håndtere stressende eller usikre situasjoner.<br><br>Vi går gjennom kontrollene for å justere disse komponentene én om gangen."

#### 1_01 goal

	key[]: "aca_goal_book1_1_01_adjuster"
	val[]: "Justering av sete og speil"

	key[]: "aca_goal_book1_1_01_check_adj"
	val[]: "Speil- og utsiktssjekk"

#### 1_01 msg - intro text

	key[]: "aca_msg_book1_1_01_cutscene1"
	val[]: "Velkommen til din første leksjon!<br>La oss begynne med å lære hvordan du forbereder lastebilen til å kjøre på veien."

	key[]: "aca_msg_book1_1_01_cutscene2"
	val[]: "Det er avgjørende å sørge for at din kjøring er trygg, profesjonell og under kontroll til enhver tid.<br>Riktig justering av setet, rattet og speilene vil hjelpe deg med å oppnå dette."

	key[]: "aca_msg_book1_1_01_cutscene3"
	val[]: "På hver side av lastebilen er det noen kjøretøy.<br>De vil hjelpe deg med å justere speilene riktig."

	key[]: "aca_msg_book1_1_01_cutscene4"
	val[]: "Ta deg tid til å justere alt etter eget ønske, da disse innstillingene<br>vil ha en betydelig innvirkning på din evne til å kontrollere lastebilen."

#### 1_01 Driving Instructions

	key[]: "adj_tut_title_0"
	val[]: "Justering av sete og ratt"

	key[]: "adj_tut_title_1"
	val[]: "Justering av hovedspeilene"

	key[]: "adj_tut_title_2"
	val[]: "Justering av konvekse speil"

	key[]: "adj_tut_title_3_hood"
	val[]: "Justering av panserspeilene"

	key[]: "adj_tut_title_3"
	val[]: "Utsiktssjekk og siste speiljustering"

	key[]: "adj_tut_open_adj_keyboard"
	val[]: "trykk på @@imv_nrm_adjuster@@ eller få tilgang til den gjennom kjøretøysjusteringer i pausemenyen"

	key[]: "adj_tut_open_adj_gamepad"
	val[]: "få tilgang til den gjennom kjøretøysjusteringer i pausemenyen"

	key[]: "adj_tut_open_adj"
	val[]: "For å vise '@@adjust_link_t@@' under spilling, $OPEN_ADJUSTER$."

	key[]: "adj_tut_open_seat"
	val[]: "La oss først justere førersetet og styringsrattet.<br><br><font face=/font/big_bold.font>Åpne '@@adj_seats@@' for å fortsette.</font>"

	key[]: "adj_tut_open_mirrors"
	val[]: "<font face=/font/big_bold.font>Åpne @@adj_mirrors@@ for å konfigurere speilinnstillingene.</font>"

	key[]: "adj_tut_open_adj_intro"
	val[]: "Når du setter deg inn i en lastebil for første gang, er det viktig å først justere setet, rattet og speilene slik du vil.<br><br>Riktig posisjon bak rattet er avgjørende for riktig utsikt. Alle kontroller må være innen rekkevidde, og sjåføren må ha fri sikt fremover, til sidene og i speilene.<br><br><font face=/font/big_bold.font>For å vise konfigurasjonsmenyen, $OPEN_ADJUSTER$.</font>"

	key[]: "adj_tut_set_seat_and_back_adj"
	val[]: "@@adj_tut_set_seat_and_back_adj_img@@<br>Justere setet slik at du har fri sikt til omgivelsene til og med speilene, og slik at du kan nå alle kontroller.<br><br>Justere rattet slik at det er i en komfortabel stilling og blokkerer ikke sikten til noen instrumenter.<br><br><font face=/font/big_bold.font>Når du er fornøyd med dine justeringer, trykk på @@imv_nrm_back@@ for å gå tilbake til konfigurasjonsmenyen. </font>"

	key[]: "adj_tut_open_mirrors_intro"
	val[]: "@@adj_tut_open_mirrors_intro_img@@<br>Lastbiler har mange store blindsoner, så de er utstyrt med flere utvendige speil for å hjelpe sjåføren med å se så mye som mulig. <br><br>Riktig justering av disse speilene vil tillate deg å ha best mulig synlighet av omgivelsene dine.<br><br><font face=/font/big_bold.font>Åpne '@@adj_mirrors@@' for å fortsette.</font>"

	key[]: "adj_tut_set_mirrors_t1_1_adj"
	val[]: "@@adj_tut_set_mirrors_t1_1_adj_img@@<br>Hovedspeilene dekker rommet langs siden av lastebilen og hengeren.<br><br>For å justere riktig posisjon til hovedspeilene, bruk bilene på begge sider av kjøretøyet som referanse.<br><br><font face=/font/big_bold.font>Trykk på @@imv_nrm_selectfcs@@ for å fortsette.</font>"

	key[]: "adj_tut_set_mirrors_t1_2_adj"
	val[]: "Hovedspeilene er ditt primære verktøy for å se hva som skjer ved siden av og bak deg. Du bør ha god oversikt over bilen ved siden av deg, men sørg for å ha noe av hengeren i speilet også for å hjelpe deg med å bedømme plasseringen av hindringer rundt deg nøyaktig."

	key[]: "adj_tut_set_mirrors_t1_2_adj_big"
	val[]: "Når du er fornøyd med justeringen, bytt til passasjersidens hovedspeil."

	key[]: "adj_tut_set_mirrors_t1_2_adj_moved"
	val[]: "Igjen, du bør ha god oversikt over bilen ved siden av deg mens du også holder noe av hengeren synlig i speilet."

	key[]: "adj_tut_set_mirrors_t1_2_adj_moved_big"
	val[]: "Når du er fornøyd med speiljusteringen, bytt til førersidens konvekse speil."

	key[]: "adj_tut_set_mirrors_t1_3_adj"
	val[]: "@@adj_tut_set_mirrors_t1_3_adj_img@@<br>Konvekse speil gir et bredere synsfelt, slik at du kan se mer av hva som skjer ved siden av deg.<br><br><font face=/font/big_bold.font>Trykk på @@ imv_nrm_selectfcs@@ for å fortsette.</font>"

	key[]: "adj_tut_set_mirrors_t1_4_adj"
	val[]: "Ideelt sett bør du se både bilen og lastebilen parkert til siden mens du fortsatt har en veldig liten del av din egen lastebil synlig."

	key[]: "adj_tut_set_mirrors_t1_4_adj_big"
	val[]: "Når du er fornøyd med speiljusteringen, bytt til passasjersidens konvekse speil."

	key[]: "adj_tut_set_mirrors_t1_4_adj_moved"
	val[]: "Igjen bør du se både bilen og lastebilen parkert til siden mens du fortsatt har en liten del av din egen lastebil synlig."

	key[]: "adj_tut_set_mirrors_t1_4_adj_moved_big"
	val[]: "Når du er fornøyd med speiljusteringen, bytt til panserspeilet."

	key[]: "adj_tut_set_mirrors_t1_5_adj"
	val[]: "@@adj_tut_set_mirrors_t1_5_adj_img@@<br>Panserspeilene gir utsikt til blindsonene på hver side av traktorens førerhus, slik at du kan se små biler og hindringer som ellers kan være skjult på grunn av lastebilens store dimensjoner.<br><br><font face=/font/big_bold.font>Trykk på @@imv_nrm_selectfcs@@ for å fortsette.</font>"

	key[]: "adj_tut_set_mirrors_t1_6_adj"
	val[]: "@@adj_tut_set_mirrors_t1_6_adj_img@@<br>Siden du har andre speil for å gi utsikten bak deg, er disse speilene designet kun for å se det som er ved siden av deg. Panseret og sidespeilarmene gir en god referanseramme for hvor mye av din egen lastebil som fortsatt skal være synlig. Justere speilene til riktig posisjon som vist i diagrammet.<br><br><font face=/font/big_bold.font>Når du er fornøyd med justeringen, bytt til panserspeilet på passasjersiden. </font>"

	key[]: "adj_tut_set_mirrors_t1_6_adj_moved"
	val[]: "@@adj_tut_set_mirrors_t1_6_adj_moved_img@@<br>På samme måte justerer du posisjonen til dette speilet.<br><br><font face=/font/big_bold.font>Når du er fornøyd med justeringen av speilet, trykk på @@imv_nrm_back @@ for å lukke speilinnstillingene. </font>"

	key[]: "adj_tut_back_adj"
	val[]: "<font face=/font/big_bold.font>Trykk på @@imv_nrm_back@@ for å gå tilbake til konfigurasjonsmenyen. </font>"

	key[]: "adj_tut_close_adj"
	val[]: "Utmerket, med sete og speil innstilt etter din smak, er du nå ett skritt nærmere å komme deg ut på veien!<br><br><font face=/font/big_bold.font>Lukk konfigurasjonsmenyen ved å bruke @@imv_nrm_back@@. </font>"

	key[]: "adj_tut_open_con"
	val[]: "Ta en ekstra titt rundt for å sikre at du er fornøyd med utsikten fra førerhuset og at speilene gir deg god oversikt over hva som skjer rundt lastebilen.<br><br>Hvis noe ikke passer deg, kan du justere speilene igjen i '@@adjust_link_t@@' konfigurasjonsmenyen. <br><br><font face=/font/big_bold.font>Trykk på @@imv_nrm_activate@@ for å avslutte det første scenarioet.</font> @@aca_goal_tip@@ For å vise eller skjule skjermen speil, kan du gå til '@@adjust_link_t@@' — '@@adj_ui_mirrors@@' i pausemenyen. Speil på skjermen gjør det lettere å se din passasjerside."
#@}

