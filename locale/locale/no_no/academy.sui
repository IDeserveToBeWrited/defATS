	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_diag_forward"
	val[]: "Fortsett mot slutten av raden og finn din parkeringsplass."

	key[]: "aca_msg_book3_diag_check1"
	val[]: "Kjør forbi parkeringsplassen for å forsikre deg om at den bakre hengeren sporer riktig inn i plassen, og sving deretter inn mens du sørger skarpt for at fronten på den fremre hengeren ikke berører lastebilen ved siden av deg."

	key[]: "aca_msg_book3_diag_stop"
	val[]: "Fortsett sakte mens du retter opp kombinasjonen, og stopp deretter i det angitte området."

