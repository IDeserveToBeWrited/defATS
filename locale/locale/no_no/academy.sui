	key[]: "aca_goal_book1_2_08_forward"
	val[]: "Kommer inn på banen"

	key[]: "aca_goal_book1_2_08_check1"
	val[]: "Bred hårnålssving"

	key[]: "aca_goal_book1_2_08_check2"
	val[]: "Kjøring gjennom slålåmen"

	key[]: "aca_goal_book1_2_08_check3"
	val[]: "Trang hårnålssving"

	key[]: "aca_goal_book1_2_08_check4"
	val[]: "Smal kurve"

	key[]: "aca_goal_book1_2_08_check6"
	val[]: "Teknisk del"

	key[]: "aca_goal_book1_2_08_check7"
	val[]: "Åpen seksjon"



#### 2_08 msg - intro text

	key[]: "aca_msg_book1_2_08_cutscene1"
	val[]: "I dette scenarioet tar vi trekkvognen en kort kjøretur for å se hvordan du håndterer den med dine nyervervede ferdigheter.<br>Det finnes ulike typer og kombinasjoner av svinger på banen. Det er ikke et løp, og det er ikke på tid. Vær tålmodig og justere kjørehastigheten til svingene og hindringene du møter."

	key[]: "aca_msg_book1_2_08_cutscene2"
	val[]: "Kjør inn på banen med en bred hårnålssving."

	key[]: "aca_msg_book1_2_08_cutscene3"
	val[]: "Neste, du vil møte en rekke hindringer som leder deg inn i en uregelmessig slalåm."

	key[]: "aca_msg_book1_2_08_cutscene4"
	val[]: "Etter å ha fullført et par enkle 90 graders svinger, du vil møte på en trang hårnålssving. Det er viktig å sette seg opp riktig både for å fullføre svingen, og til å komme jevnt inn i neste seksjon."

	key[]: "aca_msg_book1_2_08_cutscene5"
	val[]: "Vær oppmerksom på kjeglene når du kjører gjennom den lange kurven, da sikten over panseret er begrenset."

	key[]: "aca_msg_book1_2_08_cutscene6"
	val[]: "Et annet sett med barrierer vil lede deg inn i en bred slalåm."

	key[]: "aca_msg_book1_2_08_cutscene7"
	val[]: "Banen åpner seg litt, men ikke forhast deg. Noen flere enkle svinger og du er ferdig."

	key[]: "aca_msg_book1_2_08_cutscene8"
	val[]: "Stopp på det angitte området og sikre lastebilen."


#### 2_08 Driving Instructions

	key[]: "aca_msg_book1_2_08_start"
	val[]: "For å fullføre dette scenarioet må du ikke krasje, kjøre av banen eller treffe noen trafikkkjegler.<br><br><font face=/font/big_bold.font>Forberede deg på å sette av gårde. </font>"

	key[]: "aca_msg_book1_2_08_forward"
	val[]:"<font face=/font/big_bold.font>Fortsett framover inn i den brede hårnålssvingen for å komme inn på banen. </font>"

	key[]: "aca_msg_book1_2_08_check1"
	val[]: "<font face=/font/big_bold.font>Fullfør hårnålssvingen. </font>"

	key[]: "aca_msg_book1_2_08_check2"
	val[]: "Du nærmer deg noen barrierer som er arrangert omtrent i en slalåm.<br><br><font face=/font/big_bold.font>Justere hastigheten deretter og fortsett.</font>"

	key[]: "aca_msg_book1_2_08_check3"
	val[]: "Neste, du har to enkle 90 graders svinger etterfulgt av en tett hårnålssving. Ta det sakte.<br><br><font face=/font/big_bold.font>Fortsett inn i den stramme hårnålssvingen.</font>"

	key[]: "aca_msg_book1_2_08_check4"
	val[]: "Når du kommer ut av hårnålen, møter du på en smal sti gjennom en kurve. Du må holde deg unna den indre barrieren, men vær oppmerksom på at du ikke treffer noen kjegler foran deg.<br><br><font face=/font/big_bold.font>Fortsett gjennom kurven. </font>"

	key[]: "aca_msg_book1_2_08_check6"
	val[]: "Stien videre har noen trange, tekniske svinger. Justere hastigheten og navigere forsiktig gjennom delen.<br><br><font face=/font/big_bold.font>Fortsette å kjøre. </font>"

	key[]: "aca_msg_book1_2_08_check7"
	val[]: "Den neste seksjonen er mer åpen med noen enkle svinger. Ikke forhast deg.<br><br><font face=/font/big_bold.font>Fortsett å kjøre. </font>"
#!{
	key[]: "aca_msg_book1_2_08_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_08_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

#@}

#+ Book 1 Scenario 2_09
#@{

#### 2_09 common
	key[]: "aca_scenario_book1_2_09_title"
	val[]: "Parallell parkering"

	key[]: "aca_scenario_book1_2_09_desc"
	val[]: "I dette scenarioet skal vi ta en titt på parallellparkering mellom to andre lastebiler."

#### 2_09 goal

	key[]: "aca_goal_book1_2_09_stopmid"
	val[]: "Stopper foran parkeringsplassen"

	key[]: "aca_goal_book1_2_09_checkmirror"
	val[]: "Sjekke bakspeilet"

	key[]: "aca_goal_book1_2_09_backward"
	val[]: "Rygge til parkeringsplassen"

	key[]: "aca_goal_book1_2_09_stop"
	val[]: "Justere lastebilen på innsiden av parkeringsplassen"

#!{
