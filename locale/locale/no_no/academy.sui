	key[]: "aca_msg_book3_finex_cutscene1"
	val[]: "Velkommen til den avsluttende eksamenen. Vi har skissert noen realistiske situasjoner du kan støte på på veien for å se hvordan du klarer å håndtere dem. Som alltid, ta deg god tid og vær presis. <br><br>Lykke til!"

#### finex Driving Instructions

	key[]: "aca_msg_book3_finex_check0"
	val[]: "Veien videre er blokkert, snu deg på den angitte plassen."

	key[]: "aca_msg_book3_finex_check1"
	val[]: "Fortsett mot bysentrum."

	key[]: "aca_msg_book3_finex_check2"
	val[]: "Oppnå en fart på minst 37 mph (60 km/t) mens du fortsetter mot bysentrum."

	key[]: "aca_msg_book3_finex_check22"
	val[]: "Forberede deg på å bremse."

	key[]: "aca_msg_book3_finex_speed"
	val[]: "Du klarte ikke å oppnå en fart på 37 mph (60 km/t)"

	key[]: "aca_msg_book3_finex_check4"
	val[]: "Fortsett å kjøre gjennom denne banen."

	key[]: "aca_msg_book3_finex_check5"
	val[]: "Det er en parkeringsplass til deg i rekken med lastebiler til venstre. Rygg inn og parkere."

