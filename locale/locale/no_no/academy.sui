#+ Book 3 Scenario urf
#@{

#### urf common
	key[]: "aca_scenario_book3_urf_title"
	val[]: "Bakkingssandkasse"

	key[]: "aca_scenario_book3_urf_desc"
	val[]: "I dette scenarioet blir du satt inn på en tom parkeringsplass for å øve på å rygge med B-doble henger."

#### urf goal

	key[]: "aca_goal_book3_urf_start"
	val[]: "Komme i gang"

	key[]: "aca_goal_book3_urf_move"
	val[]: "Eksperimentering"

	key[]: "aca_goal_book3_urf_stop"
	val[]: "Fullfører"

	key[]: "aca_goal_book3_urf_end"
	val[]: "Avslutning av scenarioet"

	#### urf msg - intro text

	key[]: "aca_msg_book3_urf_cutscene1"
	val[]: "Rygging med B-doble henger krever mye mer oppmerksomhet enn med en enkel henger. Du må planlegge på forhånd hvor du vil at den bakre hengeren skal, samtidig som du har kontroll på den fremre hengeren og førerhuset. <br><br>Tenk på det som om du styrer den bakre hengeren med den fremre hengeren. Så uansett hvilken vei du peker den fremre hengeren, vil det endre den bakre hengerens bane."

	key[]: "aca_msg_book3_urf_cutscene2"
	val[]: "I dette tilfellet ønsker vi å snu den bakre hengeren over til førersiden. <br><br>For å gjøre dette styrte vi ledende over til passasjerens side."

	key[]: "aca_msg_book3_urf_cutscene3"
	val[]: "Det er her de fleste gjør sin første feil. Når den bakre hengeren begynner å svinge, må du rette opp traktoren med ledende..."

	key[]: "aca_msg_book3_urf_cutscene4"
	val[]: "...ellers ender du opp med en jack-knife slik."

	key[]: "aca_msg_book3_urf_cutscene5"
	val[]: "Jack-knifing skjer når vinkelen mellom to kjøretøy i kombinasjonen blir rundt 90 grader. Når dette skjer, er det ikke mulig å redde det – du må kjøre fremover og gjøre et nytt forsøk. <br><br> Som med å rygge en henger, bør målet alltid sørge for at alle hjulene på hengerne beveger seg. Når ett hjul stopper, og hengeren snur på plass, er det gjort."

	key[]: "aca_msg_book3_urf_cutscene6"
	val[]: "Du kan trekke framover til der du sist var riktig, eller rettere sagt, en posisjon der du kan fortsette å jobbe i revers uten å gjøre den samme feilen igjen, eller bare trekke fremover til du er rett."

	key[]: "aca_msg_book3_urf_cutscene7"
	val[]: "Igjen, når den bakre hengeren snur, plasser traktoren foran ledende og la den bakre hengeren snu av seg selv et øyeblikk."

	key[]: "aca_msg_book3_urf_cutscene8"
	val[]: "Nå som den bakre hengeren svinger fint, er det på tide å få ledede etter den. Du kan justere vinkelen mellom ledende og bakenden for å kontrollere svingen og gjøre den skarpere eller bredere."

	key[]: "aca_msg_book3_urf_cutscene9"
	val[]: "Den siste delen av manøveren er å rette alt ut. Få ledende foran bakenden."

	key[]: "aca_msg_book3_urf_cutscene10"
	val[]: "Det er lurt å huske på tiden det tar å flytte ledende, og at du også må få traktoren på linje."

	key[]: "aca_msg_book3_urf_cutscene11"
	val[]: "Du kan gjerne bruke så mye tid her du vil, og eksperimentere med forskjellige manøvre til atdu tror du har en viss idé om hvordan du skal håndtere hengerne i rygging."

#### urf Driving Instructions

	key[]: "aca_msg_book3_urf_start"
	val[]: "Forberede deg på å sette i gang."

	key[]: "aca_msg_book3_urf_move"
	val[]: "Bruk denne parkeringsplassen for å få en følelse av hvordan man skal håndtere hengerne i revers. <br><br>@@aca_goal_tip@@ Er du nybegynner med å rygge hengere generelt? Vurdere å spille Grunnleggende lastebilkjøring."

	key[]: "aca_msg_book3_urf_stop"
	val[]: "Ta så lang tid du trenger til å øve. <br><br>Når du er fornøyd, kan du stoppe og sikre lastebilen for å avslutte dette scenarioet."

	key[]: "aca_msg_book3_urf_end"
	val[]: "Skru av motoren for å avslutte dette scenarioet."
#@}


#+ Book 3 Scenario sup
#@{

#### sup common
	key[]: "aca_scenario_book3_sup_title"
	val[]: "Parkering på en smal plass"

	key[]: "aca_scenario_book3_sup_desc"
	val[]: "I dette scenarioet har du i oppgave å parkere din B-dobbelkombinasjon på et smalt sted."

#### sup goal

	key[]: "aca_goal_book3_sup_start"
	val[]: "Komme i gang"

	key[]: "aca_goal_book3_sup_forward"
	val[]: "Sette av gårde"

	key[]: "aca_goal_book3_sup_check1"
	val[]: "Fortsett å kjøre"

	key[]: "aca_goal_book3_sup_stop"
	val[]: "Stopper"

	key[]: "aca_goal_book3_sup_end"
	val[]: "Sikring av kjøretøyet"

#### sup msg - intro text

	key[]: "aca_msg_book3_sup_cutscene1"
	val[]: "Å kjøre med B-doble hengere kan virke skremmende, men det er ikke mye mer enn å kjøre med en enkel henger – du må også bare vurdere banen til den bakre hengeren!"

	key[]: "aca_msg_book3_sup_cutscene2"
	val[]: "Foran deg er det en smal parkeringsplass. Du vil ikke ha nok plass til å komme helt rett frem før du kjører inn, så du må nøye vurdere hvordan du skal komme deg inn med begge hengerne."

	key[]: "aca_msg_book3_sup_cutscene3"
	val[]: "Sving umiddelbart mot den andre siden av parkeringsplassen, og kjør godt forbi der du vanligvis svinger inn."

	key[]: "aca_msg_book3_sup_cutscene4"
	val[]: "Nå som den bakre hengeren er på rett spor, kan du kjøre mot stedet. Du må kanskje gå mot den andre siden igjen for å hjelpe med å få den første hengeren rundt."

	key[]: "aca_msg_book3_sup_cutscene5"
	val[]: "Fortsett inn på stedet, og begge hengerne vil følge deg inn og rette seg opp mens du kjører."

	key[]: "aca_msg_book3_sup_cutscene6"
	val[]: "Parkere på det angitte området og sikre lastebilen."

#### sup Driving Instructions

	key[]: "aca_msg_book3_sup_start"
	val[]: "Forberede deg på å sette i gang."

	key[]: "aca_msg_book3_sup_forward"
	val[]: "Fortsett framover og inn i det trange området."

	key[]: "aca_msg_book3_sup_check1"
	val[]: "Fortsett å kjøre."

	key[]: "aca_msg_book3_sup_stop"
	val[]: "Stopp i det angitte området."

	key[]: "aca_msg_book3_sup_end"
	val[]: "Sikre lastebilen og skru av motoren."
#@}


