#### 3_19 msg - intro text

	key[]: "aca_msg_book1_3_19_cutscene01"
	val[]: "Velkommen til første del av avsluttende eksamen. Her får vi se hvor godt du har lært å kjøre lastebil etter tiden på Kjøreskolen."

	key[]: "aca_msg_book1_3_19_cutscene02"
	val[]: "Først skal du feste hengeren. Når den er koblet til, kjører du lastebilen rundt hele prøveruten."

	key[]: "aca_msg_book1_3_19_cutscene03"
	val[]: "Den første delen av prøven fører deg inn på noen sideveier som tar deg mot sentrum."

	key[]: "aca_msg_book1_3_19_cutscene04"
	val[]: "Prøveruten inkluderer ulike typer hjørner og hindringer."

	key[]: "aca_msg_book1_3_19_cutscene05"
	val[]: "En liten del av ruten går gjennom sentrum."

	key[]: "aca_msg_book1_3_19_cutscene06"
	val[]: "Vi tester din evne til å manøvrere lastebilen gjennom ulike hindringer og baner."

	key[]: "aca_msg_book1_3_19_cutscene07"
	val[]: "Du vil møte ulike situasjoner som vil teste oppmerksomheten din til omgivelsene dine."

	key[]: "aca_msg_book1_3_19_cutscene08"
	val[]: "Vi vil ha deg til å rygge gjennom et industrianlegg."

	key[]: "aca_msg_book1_3_19_cutscene09"
	val[]: "Etter å ha kjørt på veier, gjennom sentrum og i industrianlegget, kjører du mot hovedkvarteret til @@driving_academy@@."

	key[]: "aca_msg_book1_3_19_cutscene10"
	val[]: "En kort kjøretur på veien, og du er nesten ferdig."

	key[]: "aca_msg_book1_3_19_cutscene11"
	val[]: "For å fullføre prøven er du nødt til å parkere nøyaktig. Du kan velge hvilken manøvre som passer best for deg."

	key[]: "aca_msg_book1_3_19_cutscene12"
	val[]: "Det er ingen grunn til å være nervøs, du har allerede lært alt som kreves for å bestå.<br><br>Lykke til!"

#### 3_19 Driving Instructions



	key[]: "aca_msg_book1_3_19_forward"
	val[]: "Først må du finne og feste hengeren. Den er parkert foran på høyre side.<br><br><font face=/font/big_bold.font>Kjør mot hengeren. </font>"

	key[]: "aca_msg_book1_3_19_coupling"
	val[]: "Sving til venstre, deretter rygge mot hengeren og innrett deg etter den.<br><br><font face=/font/big_bold.font>Rygge mot hengeren. </font>"

	key[]: "aca_msg_book1_3_19_park_br_on"
	val[]: "<font face=/font/big_bold.font>Sikre lastebilen. </font>"

	key[]: "aca_msg_book1_3_19_connect"
	val[]: "<font face=/font/big_bold.font>Trykk på @@imv_nrm_attach@@ for å koble til hengeren. </font>"

	key[]: "aca_msg_book1_3_19_park_br_off"
	val[]: "Hengeren er koblet til, og lastebilen er klar til å kjøre.<br><br><font face=/font/big_bold.font>Løsne parkeringsbremsen. </font>"

	key[]: "aca_msg_book1_3_19_b_trailer"
	val[]: "Veien er stengt for våre testformål. Du kan velge å adlyde eller ignorere trafikkskilt som du ønsker.<br><br><font face=/font/big_bold.font>Kjør mot veien. </font>"

	key[]: "aca_msg_book1_3_19_check01"
	val[]: "Fortsett gjennom de første svingene. <br><br><font face=/font/big_bold.font>Fortsett å kjøre. </font>"

	key[]: "aca_msg_book1_3_19_check02"
	val[]: "Etter neste sving er det en slalåm laget av trafikkkjegler.<br><br><font face=/font/big_bold.font>Navigere forsiktig mellom trafikkkjeglene. </font>"

	#key[]: "aca_msg_book1_3_19_check02a"
	#val[]: "Continue through the roundabout into the town.<br><br><font face=/font/big_bold.font>Negotiate the roundabout.</font>"

	key[]: "aca_msg_book1_3_19_check02b"
	val[]: "Noen flere 90 graders svinger venter på deg. <br><br><font face=/font/big_bold.font>Fortsett å kjøre. </font>"

	key[]: "aca_msg_book1_3_19_check03"
	val[]: "Den neste svingen er ekstremt trang, og vil kreve hele veien for å lykkes.<br><br><font face=/font/big_bold.font>Sving til høyre og kjør gjennom bakgaten.</font>"

	key[]: "aca_msg_book1_3_19_check04"
	val[]: "Sving til venstre ut av bakgaten, og deretter sving til høyre inn på hovedveien.<br><br><font face=/font/big_bold.font>Fortsett å kjøre. </font>"

	key[]: "aca_msg_book1_3_19_check05"
	val[]: "Du kan slappe av litt mens du kjører nedover hovedveien. <br><br><font face=/font/big_bold.font>Kjør rett på. </font>"

	key[]: "aca_msg_book1_3_19_check06"
	val[]: "Det er noen skarpe svinger inn og ut av tjenesteveien.<br><br><font face=/font/big_bold.font>Kjør forsiktig gjennom svingene. </font>"

	key[]: "aca_msg_book1_3_19_check07"
	val[]: "Du kommer inn i en mer kompleks slalåm. Fortsett sakte og bruk speilene dine. <br><br><font face=/font/big_bold.font>Fortsett å kjøre og navigere forsiktig i slalåmen.</font>"

	key[]: "aca_msg_book1_3_19_check08"
	val[]: "Svinge til venstre inn i industriområdet, se opp for lysstolpen.<br><br><font face=/font/big_bold.font>Gjør venstre svingen. </font>"

	key[]: "aca_msg_book1_3_19_check09"
	val[]: "Forberede deg på å rygge.<br><br><font face=/font/big_bold.font>Sving til høyre og stopp i det avskårne området. </font>"

	key[]: "aca_msg_book1_3_19_check10"
	val[]: "Kjør i revers og følg banen til venstre bak deg.<br><br><font face=/font/big_bold.font>Begynn å rygge.</font>"

	key[]: "aca_msg_book1_3_19_check11"
	val[]: "Følg banen til venstre. <br><br><font face=/font/big_bold.font>Fortsett å rygge. </font>"

	key[]: "aca_msg_book1_3_19_check12"
	val[]: "<font face=/font/big_bold.font>Kjør framover og sving til høyre. </font>"

	key[]: "aca_msg_book1_3_19_check13"
	val[]: "<font face=/font/big_bold.font>Fortsett mot porten. </font>"

	key[]: "aca_msg_book1_3_19_check14"
	val[]: "Vent til porten åpnes, og fortsett deretter tilbake til hovedveien.<br><br><font face=/font/big_bold.font>Fortsett å kjøre. </font>"

	key[]: "aca_msg_book1_3_19_check15"
	val[]: "Vær forsiktig så du ikke treffer skiltet.<br><br><font face=/font/big_bold.font>Gjør svingen og fortsett å kjøre. </font>"

	key[]: "aca_msg_book1_3_19_check16"
	val[]: "<font face=/font/big_bold.font>Sving til venstre inn til kjøreskolen. </font>"

	key[]: "aca_msg_book1_3_19_check17"
	val[]: "<font face=/font/big_bold.font>Fortsett rett fram. </font>"

	key[]: "aca_msg_book1_3_19_check18"
	val[]: "Hold deg til utsiden, siden det er en skarp sving etter kurven.<br><br><font face=/font/big_bold.font>Følg kurven.</font>"

	key[]: "aca_msg_book1_3_19_check19"
	val[]: "<font face=/font/big_bold.font>Sving til venstre og forberede deg på å parkere på venstre side.</font>"

	key[]: "aca_msg_book1_3_19_check20"
	val[]: "<font face=/font/big_bold.font>Rygge inn på parkeringsplassen.</font>"
#!{
	key[]: "aca_msg_book1_3_19_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_19_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_19_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
 #!}


#@}


#+ Book 1 Scenario 3_20
#@{

#### 3_20 common
	key[]: "aca_scenario_book1_3_20_title"
	val[]: "Avsluttende eksamen (Del 2)"

	key[]: "aca_scenario_book1_3_20_desc"
	val[]: "Den siste delen av den avsluttende eksamenen venter på deg, hvor parkeringsferdighetene du har lært i tidligere scenarier vil bli evaluert. Parkere forsiktig og nøyaktig, og du vil være klar til å kjøre på veiene i Amerika som en dyktig lastebilsjåfør!"

#### 3_20 goal
#!{
	key[]: "aca_goal_book1_3_20_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_20_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_20_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_20_forward"
	val[]: "@@aca_goal_book1_1_03_forward@@"

#!}


	key[]: "aca_goal_book1_3_20_park1"
	val[]: "Forskyningsmanøvre"

	key[]: "aca_goal_book1_3_20_park2"
	val[]: "Diagonalparkering"

	key[]: "aca_goal_book1_3_20_park3"
	val[]: "Kjøring gjennom parkeringsplassen"

	key[]: "aca_goal_book1_3_20_park4"
	val[]: "Parallell parkering"

	key[]: "aca_goal_book1_3_20_park5"
	val[]: "Siste parkering"


#### 3_20 msg - intro text

	key[]: "aca_msg_book1_3_20_cutscene01"
	val[]: "Velkommen til andre del av den avsluttende eksamen. Vi flytter til en nærliggende parkeringsplass og tester ferdighetene dine i å rygge og manøvrere inn på parkeringsplasser."

	key[]: "aca_msg_book1_3_20_cutscene02"
	val[]: "Flere påfølgende parkeringsutfordringer venter på deg for å vurdere dine evner."

	key[]: "aca_msg_book1_3_20_cutscene03"
	val[]: "Plassen er begrenset her, så vær forsiktig og ta deg god tid."

	key[]: "aca_msg_book1_3_20_cutscene04"
	val[]: "Utnytt plassen rundt deg godt og bruk alle speilene dine til din fulle fordel. Lykke til!"




#### 3_20 outro text

	key[]: "aca_msg_book1_3_20_outro01"
	val[]: "Gratulerer, du har fullført eksamenene for Grunnleggende lastebilkjøring, og lært deg alle ferdighetene som er nødvendige for å manøvrere lastebilen på riktig måte."

	key[]: "aca_msg_book1_3_20_outro02"
	val[]: "Dette er det første steget i reisen din mot å realisere drømmen din om å bli en profesjonell lastebilsjåfør."

	key[]: "aca_msg_book1_3_20_outro03"
	val[]: "Du er nå klar til å dra ut på veiene i Amerika og møte dine første utfordringer..."

	key[]: "aca_msg_book1_3_20_outro04"
	val[]: "...men eventyret har akkurat begynt."


#### 3_20 Driving Instructions

	key[]: "aca_msg_book1_3_20_start"
	val[]: "Husk å være forsiktig og ikke forhaste deg. Det er greit hvis du ikke får den inn på første forsøk, det viktigste er å ikke skade lastebilen eller de rundt deg. <font face=/font/big_bold.font><br><br>Forberede deg på å sette i gang. </font>"

	key[]: "aca_msg_book1_3_20_forward"
	val[]: "<font face=/font/big_bold.font>Kjør videre til den første delen av eksamen.</font>"

	key[]: "aca_msg_book1_3_20_park1"
	val[]: "Din første oppgave er å demonstrere forskyningsparkeringsmanøvre. Stedet der du må rygge med hengeren er på venstre side.<br><br><font face=/font/big_bold.font>Utfør en forskyningsparkeringsmanøvre.</font>"

	key[]: "aca_msg_book1_3_20_park2"
	val[]: "Den neste oppgaven er å rygge inn i en rad med stasjonære lastebiler. Vær forsiktig så du ikke treffer de andre lastebilene!<br><br><font face=/font/big_bold.font>Utfør en diagonal parkeringsmanøvre.</font>"

	key[]: "aca_msg_book1_3_20_park3"
	val[]: "Fortsett gjennom parkeringsplassen. Se opp for uventede situasjoner.<br><br><font face=/font/big_bold.font>Fortsett å kjøre.</font>"

	key[]: "aca_msg_book1_3_20_park4"
	val[]: "La oss nå prøve parallellparkering mellom de to lastebilene ved fortauskanten foran deg.<br><br><font face=/font/big_bold.font>Utfør en parallellparkeringsmanøvre.</font>"

	key[]: "aca_msg_book1_3_20_park5"
	val[]: "En siste parkeringsmanøvre til venstre! Du kan velge å nærme deg dette slik du vil.<br><br><font face=/font/big_bold.font>Rygge inn i det angitte området.</font>"

	key[]: "aca_msg_book1_3_20_park6"
	val[]: "Nesten ferdig. Forlat testområdet og parkere lastebilen.<br><br><font face=/font/big_bold.font>Gå ut av testområdet til venstre.</font>"

	key[]: "aca_msg_book1_3_20_stop"
	val[]: "Du kan parkere lastebilen til høyre sammen med de andre.<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_20_end"
	val[]: "@@aca_msg_book1_2_01_end@@"


#!}

#@}


#+ Book 1 Scenario 3_22
#@{

#### 3_22 common
	key[]: "aca_scenario_book1_3_22_title"
	val[]: "Parallellparkering med en henger"

	key[]: "aca_scenario_book1_3_22_desc"
	val[]: "I dette scenarioet skal vi ta en titt på parallellparkering med hengeren tilkoblet."

#### 3_22 goal


	key[]: "aca_goal_book1_3_22_stopmid"
	val[]: "Stopper i det merkede området"
#!{
	key[]: "aca_goal_book1_3_22_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_22_check1"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_22_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_22_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_22_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
  #!}
#### 3_22 msg - intro text

	key[]: "aca_msg_book1_3_22_cutscene1"
	val[]: "Parallellparkering med en henger er en relevant ferdighet for alle lastebilførere.<br>Enten det er gateparkering i en storby, eller stopper ved en rasteplass på landet, er det noe enhver lastebilsjåfør bør vite hvordan de skal gjøre."

	key[]: "aca_msg_book1_3_22_cutscene2"
	val[]: "Når du passerer parkeringsplassen, se nøye for å sikre at det er nok plass til at traktoren og hengeren får plass. Her har vi sørget for at du har god plass."

	key[]: "aca_msg_book1_3_22_cutscene3"
	val[]: "Still deg på linje med lastebilen foran parkeringsplassen. Ikke vær for nærme den, hold litt avstand fra den slik at du har plass til å jobbe."

	key[]: "aca_msg_book1_3_22_cutscene4"
	val[]: "Sving skarpt bort fra parkeringsplassen og begynn å rygge. Tanken er å få hengeren til å svinge inn på parkeringsplassen med en gang."

	key[]: "aca_msg_book1_3_22_cutscene5"
	val[]: "Når hengeren er pekt godt inn i stedet, kan du begynne å følge den inn."

	key[]: "aca_msg_book1_3_22_cutscene6"
	val[]: "Begynn å styre hengeren vekk fra fortauskanten før hengerhjulene på førersiden har kommet inn på stedet."

	key[]: "aca_msg_book1_3_22_cutscene7"
	val[]: "Rett ut traktoren med hengeren og sentrer deg selv innenfor parkeringsplassen.<br><br>Parkere, skru av motoren og sikre lastebilen."

#### 3_22 Driving Instructions

	key[]: "aca_msg_book1_3_22_start"
	val[]: "Du kan se parkeringsplassen foran deg, mellom de andre lastebilene. Når du parkerer, sørg for å sjekke speilene dine og holde trygg avstand mellom lastebilen og hindringene rundt deg.<br><br><font face=/font/big_bold.font>Forberede deg på å sette av gårde. </font>"

	key[]: "aca_msg_book1_3_22_check1"
	val[]: "Beveg deg gjennom tomten for å finne din parkeringsplass.<br><br><font face=/font/big_bold.font>Kjør framover. </font>"

	key[]: "aca_msg_book1_3_22_stopmid"
	val[]: "<color value=@@clr_white@@>Kjør forbi din ønsket parkeringsplass inn i det merkede området. Herfra kan du begynne med din ryggemanøvre.<br><br><font face=/font/big_bold.font>Stopp på det merkede stedet. </font>"

	key[]: "aca_msg_book1_3_22_backward"
	val[]: "Vri traktoren bort fra stedet for å begynne å snu hengeren inn i den. Ikke sving for skarpt, ellers går du mot fortauskanten. <br><br><font face=/font/big_bold.font>Begynn å rygge. </font>"

	key[]: "aca_msg_book1_3_22_stop"
	val[]: "Justere hengeren med stedet. Om nødvendig, flytt forover eller bakover mens du gjør de nødvendige styreinngangene for å justere posisjonen din.<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_22_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
 #!}

#@}

#+ Book 1 Scenario 3_21
#@{
#### 3_21 common
	key[]: "aca_scenario_book1_3_21_title"
	val[]: "Rygge fra et 45 graders oppsett"

	key[]: "aca_scenario_book1_3_21_desc"
	val[]: "I dette scenarioet vil vi utforske 45 graders oppsett for rygging."

#### 3_21 goal
#!{
	key[]: "aca_goal_book1_3_21_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_21_forward"
	val[]: "@@aca_goal_book1_1_03_forward@@"

	key[]: "aca_goal_book1_3_21_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}
	key[]: "aca_goal_book1_3_21_check1"
	val[]: "Sjekkpunkt"

	key[]: "aca_goal_book1_3_21_check2"
	val[]: "Få riktig avstand for å rygge"

	key[]: "aca_goal_book1_3_21_stop"
	val[]: "Parkering i det angitte området"



#### 3_21 msg - intro text

	key[]: "aca_msg_book1_3_21_cutscene1"
	val[]: "I denne leksjonen skal vi ta en titt på 45 graders parkering. Når situasjonen tillater det, er dette den foretrukne metoden av mange for å rygge inn på parkeringsplasser. Ved å starte med at hengeren allerede peker dit du vil, må du gjøre mindre manøvrering for å få parkert."

	key[]: "aca_msg_book1_3_21_cutscene2"
	val[]: "Denne typen oppsett lar deg også se lenger inn på parkeringsplassen, noe som gir økt synlighet over hvor du skal."

	key[]: "aca_msg_book1_3_21_cutscene3"
	val[]: "Kjør godt forbi parkeringsplassen og still deg opp i en omtrent 45 graders vinkel. Du vil at din henger skal peke mot lastebilen på den andre siden av parkeringsplassen du har tenkt å rygge inn på."

	key[]: "aca_msg_book1_3_21_cutscene4"
	val[]: "Snu lastebilen bort fra stedet for å skyve fronten av hengeren rundt, og styr den bakre mot parkeringsplassen. Vær forsiktig med å ikke overdrive det. Når du først begynner å svinge, er det lettere å gjøre svingen skarpere enn å utvide den."

	key[]: "aca_msg_book1_3_21_cutscene5"
	val[]: "Når hengeren kommer inn på parkeringsplassen, sett traktoren foran den og justere kombinasjonen."

	key[]: "aca_msg_book1_3_21_cutscene6"
	val[]: "Stopp på det angitte stedet og sikre lastebilen."

#### 3_21 Driving Instructions
#!{
	key[]: "aca_msg_book1_3_21_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

	key[]: "aca_msg_book1_3_21_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
	key[]: "aca_msg_book1_3_21_forward"
	val[]: "Det er en parkeringsplass til venstre. Kjør et godt stykke forbi den og sett opp i en 45 graders vinkel.<br><br><font face=/font/big_bold.font>Kjør framover. </font>"

	key[]: "aca_msg_book1_3_21_check1"
	val[]: "Justere lastebilen med markeringene.<br><br><font face=/font/big_bold.font>Stopp i det merkede området. </font>"

	key[]: "aca_msg_book1_3_21_check2"
	val[]: "Bruk kunnskapen du har fått fra tidligere scenarioer, styr hengeren inn på parkeringsplassen.<br><br><font face=/font/big_bold.font>Begynn å rygge. </font>"

	key[]: "aca_msg_book1_3_21_stop"
	val[]: "Fortsett å styre hengeren inn på parkeringsplassen.<br><br>@@aca_msg_book1_2_01_stop@@"


#@}

