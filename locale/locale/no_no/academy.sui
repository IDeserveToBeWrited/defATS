#### 2_06 msg - intro text

	key[]: "aca_msg_book1_2_06_cutscene01"
	val[]: "For det siste scenarioet i dette kapittelet, kjører vi på testbanen med en kompleks konfigurasjon."

	key[]: "aca_msg_book1_2_06_cutscene02"
	val[]: "Det første hinderet er slalåm gjennom noen barrierer. Kjør gjennom den og husk å bruke speilene dine."

	key[]: "aca_msg_book1_2_06_cutscene04"
	val[]: "Neste er en hårnålssving. Hold svingen bred slik at det ikke bør by på noen problemer."

	key[]: "aca_msg_book1_2_06_cutscene05"
	val[]: "Stien videre smalner betydelig. Fortsett forsiktig frem og bruk sidespeilet for å hjelpe deg."

	key[]: "aca_msg_book1_2_06_cutscene06"
	val[]: "Neste er en serie av enkle 90 graders svinger."

	key[]: "aca_msg_book1_2_06_cutscene08"
	val[]: "Neste seksjon må gjøres med rygging. Nærme deg barrierene framover med det i tankene."

	key[]: "aca_msg_book1_2_06_cutscene09"
	val[]: "Følg veimerkingen tilbake og rundt kurvene."

	key[]: "aca_msg_book1_2_06_cutscene10"
	val[]: "Rygge til bommene, deretter stopp og fortsett framover til høyre."

	key[]: "aca_msg_book1_2_06_cutscene11"
	val[]: "Denne passasjen gjennom kjeglene er veldig smal. Kjør sakte og bruk speilene for å orientere deg i passasjen."

	key[]: "aca_msg_book1_2_06_cutscene13"
	val[]: "Foran er en serie av vekslende venstre og høyre 90 graders svinger."

	key[]: "aca_msg_book1_2_06_cutscene15"
	val[]: "Du kan møte tog på denne planovergangen. I så fall, stopp og vent. Etterpå kan du ta til høyre inn på serviceveien."

	key[]: "aca_msg_book1_2_06_cutscene16"
	val[]: "Sving til venstre inn på veibanen. Du kan få litt mer fart etter å ha fullført svingen."

	key[]: "aca_msg_book1_2_06_cutscene18"
	val[]: "Noen få venstresvinger til i byen, så er du på din destinasjon!"

	key[]: "aca_msg_book1_2_06_cutscene19"
	val[]: "Nærmer deg barrierene foran og forberede deg på å parkere på parkeringsplassen til høyre."

	key[]: "aca_msg_book1_2_06_cutscene20"
	val[]: "Rygge inn til parkeringplassen, deretter skru av motoren og sikre lastebilen."

#### 2_06 Driving Instructions



	key[]: "aca_msg_book1_2_06_forward"
	val[]: "Foran deg er en slalåm laget av barrierer.<br><br><font face=/font/big_bold.font>Kjør gjennom slalåmen.</font>"

	key[]: "aca_msg_book1_2_06_forward2"
	val[]: "<font face=/font/big_bold.font>Følg stien rundt hårnålssvingen. </font>"

	key[]: "aca_msg_book1_2_06_check1"
	val[]: "Stien videre smalner betydelig. Du kan bruke sidespeilet til å hjelpe deg med å orientere deg.<br><br><font face=/font/big_bold.font>Fortsett forsiktig. </font>"

	key[]: "aca_msg_book1_2_06_check2"
	val[]: "Etter kurven er det en 90 graders sving.<br><br><font face=/font/big_bold.font>Justere hastigheten deretter.</font>"

	key[]: "aca_msg_book1_2_06_check3"
	val[]: "Foran er noen flere enkle svinger, fortsett å justere hastigheten etter behov.<br><br><font face=/font/big_bold.font>Fortsett å kjøre. </font>"

	key[]: "aca_msg_book1_2_06_check4"
	val[]: "Den følgende seksjonen må bli fullført med rygging. Stopp ved barrierene foran slik at du vil kunne rygge mot høyre etterpå.<br><br><font face=/font/big_bold.font>Stopp ved barrierene.</font>"

	key[]: "aca_msg_book1_2_06_check5"
	val[]: "Rygge mot området bak deg og til høyre.<br><br><font face=/font/big_bold.font>Begynn å rygge. </font>"

	key[]: "aca_msg_book1_2_06_reverse"
	val[]: "Følg stien rundt svingene.<br><br><font face=/font/big_bold.font>Fortsett å rygge.</font>"

	key[]: "aca_msg_book1_2_06_check6"
	val[]: "Bak deg til venstre er det noen barrierer. <br><br><font face=/font/big_bold.font>Snu mot barrierene og vær forberedt på å stoppe.</font>"

	key[]: "aca_msg_book1_2_06_check7"
	val[]: "Stopp og bytt til et framovergir, fortsett deretter til høyre. <br><br><font face=/font/big_bold.font>Kjør framover. </font>"

	key[]: "aca_msg_book1_2_06_check8"
	val[]: "Foran deg er en smal svingete sti gjennom noen kjegler. Kjør forsiktig og bruk speilene om nødvendig.<br><br><font face=/font/big_bold.font>Kjør gjennom kjeglene. </font>"

	key[]: "aca_msg_book1_2_06_check9"
	val[]: "Neste er en kombinasjon av forskjellige 90 graders svinger. Sørg for å nærme deg hver sving med en bred køye.<br><br><font face=/font/big_bold.font>Fortsett å kjøre. </font>"

	key[]: "aca_msg_book1_2_06_check10"
	val[]: "Observere planovergangen når du nærmer deg den. Signalene kan aktivere for å indikere et møtende tog.<br><br><font face=/font/big_bold.font>Fortsett med forsiktighet.</font>"

	key[]: "aca_msg_book1_2_06_check11"
	val[]: "Svingen inn på tjenesteveien er delvis blokkert av en hindring, så hold til venstre når du nærmer deg for å gi deg selv mer plass.<br><br><font face=/font/big_bold.font>Gjør svingen. </font>"

	key[]: "aca_msg_book1_2_06_check12"
	val[]: "Du kan velge å adlyde eller ignorere stoppskiltet. Området har blitt stengt for vår bruk.<br><br><font face=/font/big_bold.font>Sving til venstre.</font>"

	key[]: "aca_msg_book1_2_06_check13"
	val[]: "Du kan øke hastigheten mer her, men du må svinge ved neste veikryss.<br><br><font face=/font/big_bold.font>Fortsett langs banen. </font>"

	key[]: "aca_msg_book1_2_06_check14"
	val[]: "Fortsett inn i byen med en venstresving, etterfulgt av ytterligere to venstresvinger inn i det siste området.<br><br><font face=/font/big_bold.font>Kjør gjennom byen.</font>"

	key[]: "aca_msg_book1_2_06_check15"
	val[]: "På den andre siden av tomten er det noen barrierer. Kjør opp til dem. <br><br><font face=/font/big_bold.font>Stopp i nærheten av barrierene. </font>"

	key[]: "aca_msg_book1_2_06_check16"
	val[]: "Bak deg og til høyre er det en parkeringsplass.<br><br><font face=/font/big_bold.font>Rygge inn på parkeringsplassen. </font>"
#!{
	key[]: "aca_msg_book1_2_06_check17"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_06_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_2_06_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

#@}

#+ Book 1 Scenario 2_08
#@{

#### 2_08 common
	key[]: "aca_scenario_book1_2_08_title"
	val[]: "Enkel opplæringsbane"

	key[]: "aca_scenario_book1_2_08_desc"
	val[]: "I dette scenarioet tar vi ferdighetene du har lært så langt og prøver dem ut på en enkel kjøretur gjennom et enkelt opplæringsbane."

#### 2_08 goal
#!{
	key[]: "aca_goal_book1_2_08_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_08_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

