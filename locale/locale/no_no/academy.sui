#+ Book 1 Scenario 3_09
#@{

#### 3_09 common
	key[]: "aca_scenario_book1_3_09_title"
	val[]: "Diagonalparkering"

	key[]: "aca_scenario_book1_3_09_desc"
	val[]: "I dette scenarioet vil du parkere på en diagonal parkeringsplass i en travel plass. <br><br>Det er ikke mye rom å manøvrere, så du må være veldig nøyaktig og bevisst når du kjører."

#### 3_09 goal

	key[]: "aca_goal_book1_3_09_check1"
	val[]: "Nærmer seg parkeringsplassen"
#!{
	key[]: "aca_goal_book1_3_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_09_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_09_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
 #!}
#### 3_09 msg - intro text

	key[]: "aca_msg_book1_3_09_cutscene1"
	val[]: "Diagonale parkeringsplasser som dette er veldig vanlig. Du kan komme borti de på rasteplassene eller på lastebilstoppene alt over Amerika. <br>Nok en gang må vi \"nese inn\" til parkeringsplassen foran."

	key[]: "aca_msg_book1_3_09_cutscene2"
	val[]: "Kjør mot den angitte parkeringsplassen nær enden av raden."

	key[]: "aca_msg_book1_3_09_cutscene3"
	val[]: "Hold deg mot midten av kjørefeltet, eller litt til venstre. Du vil gi deg selv rom til å manøvrere hengeren inn."

	key[]: "aca_msg_book1_3_09_cutscene4"
	val[]: "Kjør en god del forbi parkeringsplassen, og sving deretter hardt og raskt mot stedet. Du må se på speilet på høyre side for å se at din henger kommer trygt inn på parkeringsplassen."

	key[]: "aca_msg_book1_3_09_cutscene5"
	val[]: "Stopp på det angitte området, sikre lastebilen og skru av motoren."


#### 3_09 Driving Instructions

	key[]: "aca_msg_book1_3_09_start"
	val[]: "@@aca_msg_book1_3_09_start_img@@<br>Når du parkerer diagonalt, er det viktig å bedømme posisjonen din nøyaktig. Når du først er halvveis inn i svingen, er det vanskelig å rygge og omplassere trygt, så det er ideelt å sørge for at du har nok plass på første forsøk.<br><br><font face=/font/big_bold.font>Forberede deg på å sette i gang. </font>"

	key[]: "aca_msg_book1_3_09_forward"
	val[]: "<font face=/font/big_bold.font>Begynn å kjøre mot parkeringsplassen. </font>"

	key[]: "aca_msg_book1_3_09_check1"
	val[]: "Kjør forbi parkeringsplassen slik at din henger har plass til å svinge rundt lastebilen på innsiden.<br><br><font face=/font/big_bold.font>Sving inn på parkeringsplassen. </font>"
#!{
	key[]: "aca_msg_book1_3_09_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}

#@}

#+ Book 1 Scenario 3_10
#@{

#### 3_10 common
	key[]: "aca_scenario_book1_3_10_title"
	val[]: "Blindsiderygging"

	key[]: "aca_scenario_book1_3_10_desc"
	val[]: "I dette scenarioet vil vi se på \"blindsiden\" som rygger lastebilen til en parkeringsplass. Uten muligheten til å se ut av vinduet for å se hvor du skal, må du stole på speilene dine alene for å komme deg dit du skal."

#### 3_10 goal
#!{
	key[]: "aca_goal_book1_3_10_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_10_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_10_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_10_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

 #!}
#### 3_10 msg - intro text

	key[]: "aca_msg_book1_3_10_cutscene1"
	val[]: "I dette scenarioet lærer du ryggemanøveren på blindsiden. Blindsporing bør generelt unngås med mindre det ikke er noe alternativ, da sikten din er sterkt begrenset. Ta deg god tid og ta feil på siden av ekstrem forsiktighet."

	key[]: "aca_msg_book1_3_10_cutscene2"
	val[]: "Kjør godt forbi parkeringsplassen for å gi deg selv plass til å jobbe når du begynner å rygge."

	key[]: "aca_msg_book1_3_10_cutscene3"
	val[]: "Komme til et stopp, sjekk omgivelsene dine, deretter begynn å rygge."

	key[]: "aca_msg_book1_3_10_cutscene4"
	val[]: "Snu traktoren bort fra stedet. Dette vil skyve fronten av hengeren rundt, og i sin tur peke den bakre delen av hengeren mot parkeringsplassen du vil inn på. Pass på å ikke overdrive det, ellers kan du risikere å \"jekke\" kombinasjonen."

	key[]: "aca_msg_book1_3_10_cutscene5"
	val[]: "Når hengeren kommer inn på parkeringsplassen, begynn å rette opp lastebilen."

	key[]: "aca_msg_book1_3_10_cutscene6"
	val[]: "Stopp på det angitte området og sikre lastebilen."

#### 3_10 Driving Instructions

	key[]: "aca_msg_book1_3_10_start"
	val[]: "Blindsiderygging krever samme prosedyrer som rygging på siktsiden, men du vil bli handikappet av mangelen på sikt på den siden. Bruk speilene og din beste dømmekraft til å parkere lastebilen.<br><br><font face=/font/big_bold.font>Forberede deg på å sette av gårde. </font>"

	key[]: "aca_msg_book1_3_10_forward"
	val[]: "Det er en parkeringsplass foran og på høyre side. Du må dra langt forbi den slik at du har plass til å manøvrere når du rygger.<br><br><font face=/font/big_bold.font>Kjør framover. </font>"
#!{
	key[]: "aca_msg_book1_3_10_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
	key[]: "aca_msg_book1_3_10_check2"
	val[]: "Husk at å snu lastebilen bort fra stedet vil snu hengeren mot den. Bruk speilene dine etter beste evne for å hjelpe deg med å komme inn på parkeringsplassen.<br><br><font face=/font/big_bold.font>Begynn å rygge. </font>"


#@}

#+ Book 1 Scenario 3_11
#@{

#### 3_11 common
	key[]: "aca_scenario_book1_3_11_title"
	val[]: "Kjøring i en rundkjøring"

	key[]: "aca_scenario_book1_3_11_desc"
	val[]: "I dette scenarioet skal vi se på hvordan du skal kjøre i en rundkjøring.<br><br>Du må være spesielt oppmerksom på din henger, siden den vil spore bak deg på en annen måte når du kommer inn, kjører gjennom rundkjøringen og når du kommer ut."

#### 3_11 goal
#!{
	key[]: "aca_goal_book1_3_11_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_11_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


	key[]: "aca_goal_book1_3_11_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_11_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
 #!}

	key[]: "aca_goal_book1_3_11_check1"
	val[]: "Kjører inn i rundkjøringen"

	key[]: "aca_goal_book1_3_11_check2"
	val[]: "Kjøring i rundkjøringen"

	key[]: "aca_goal_book1_3_11_check3"
	val[]: "Kjøring i rundkjøringen"

	key[]: "aca_goal_book1_3_11_check5"
	val[]: "Kjører ut av rundkjøringen"

	key[]: "aca_goal_book1_3_11_check6"
	val[]: "Kjøring til den angitte området"

#### 3_11 msg - intro text

	key[]: "aca_msg_book1_3_11_cutscene1"
	val[]: "Rundkjøringer blir mer vanlig i Amerika, så det er viktig å vite hvordan man skal håndtere dem."

	key[]: "aca_msg_book1_3_11_cutscene3"
	val[]: "Hold deg på utsiden av kjørefeltet når du nærmer deg rundkjøringen. Dette vil hjelpe din henger med å rydde innsiden av den første innkjøringen."

	key[]: "aca_msg_book1_3_11_cutscene4"
	val[]: "Kjør mot midten av rundkjøringen når du kommer inn. Når du først er inne, må du gå mot utsiden. Dette er for å holde hengeren unna midten av rundkjøringen."

	key[]: "aca_msg_book1_3_11_cutscene5"
	val[]: "Hold øye med speilet ditt for å sikre at hengeren ikke kommer for nær de innvendige barrierene."

	key[]: "aca_msg_book1_3_11_cutscene6"
	val[]: "Det er ganske enkelt å forlate rundkjøringen siden din henger allerede er plassert vekk fra innsiden av avkjørselen. Sving bredt ved utgang og hengeren skal følge fint med."

	key[]: "aca_msg_book1_3_11_cutscene7"
	val[]: "Parkere på det angitte området og sikre lastebilen."



#### 3_11 Driving Instructions
#!{
	key[]: "aca_msg_book1_3_11_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

	key[]: "aca_msg_book1_3_11_forward"
	val[]: "Foran deg er det satt opp en rundkjøring du kan kjøre videre. <br><br><font face=/font/big_bold.font>Nærme deg sakte til rundkjøringen. </font>"

	key[]: "aca_msg_book1_3_11_check1"
	val[]: "Gjør en bred sving når du kjører inn i rundkjøringen slik at din henger kommer inn bak deg uten problemer. <br><br><font face=/font/big_bold.font>Kjør inn i rundkjøringen. </font>"

	key[]: "aca_msg_book1_3_11_check2"
	val[]: "Kjør mot utsiden av rundkjøringen. Du må holde lastebilen så langt unna midten av rundkjøringen som mulig for å holde hengeren unna senterbarrierene. <br><br><font face=/font/big_bold.font>Fortsett gjennom rundkjøringen.</font>"

	key[]: "aca_msg_book1_3_11_check3"
	val[]: "Hold deg nær de ytre kjeglene. <br><br><font face=/font/big_bold.font>Fortsett å kjøre.</font>"

	key[]: "aca_msg_book1_3_11_check5"
	val[]: "<font face=/font/big_bold.font>Kjør ut av rundkjøringen.</font>"

	key[]: "aca_msg_book1_3_11_check6"
	val[]: "<font face=/font/big_bold.font>Fortsett til parkeringsplassen foran.</font>"

	key[]: "aca_msg_book1_3_11_stop"
	val[]: "<font face=/font/big_bold.font>Stopp i det angitte området.</font>"

	key[]: "aca_msg_book1_3_11_end"
	val[]: "<font face=/font/big_bold.font>Sikre lastebilen og skru av motoren.</font>"
#@}

#+ Book 1 Scenario 3_12
#@{

#### 3_12 common
	key[]: "aca_scenario_book1_3_12_title"
	val[]: "Manøvrering i et trangt rom"

	key[]: "aca_scenario_book1_3_12_desc"
	val[]: "I dette scenarioet får du i oppgave å snu lastebilen rundt på et trangt sted, noe som vil kreve oppmerksomhet til omgivelsene og smart bruk av plass."

#### 3_12 goal



	key[]: "aca_goal_book1_3_12_check1"
	val[]: "Setter opp til å rygge"

	key[]: "aca_goal_book1_3_12_check2"
	val[]: "Forlater området"

	key[]: "aca_goal_book1_3_12_check3"
	val[]: "Rygge inn i stedet"

	key[]: "aca_goal_book1_3_12_check4"
	val[]: "Fullføre blindsiden"
#!{
	key[]: "aca_goal_book1_3_12_check5"
	val[]: "Unused"

	key[]: "aca_goal_book1_3_12_check6"
	val[]: "@@aca_goal_book1_3_11_check6@@"

	key[]: "aca_goal_book1_3_12_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_12_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_12_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_12_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"
 #!}

#### 3_12 msg - intro text

	key[]: "aca_msg_book1_3_12_cutscene01"
	val[]: "I dette scenarioet skal vi gå gjennom hvordan du snur rundt på trange steder.<br>Du vil ikke alltid ha mye rom for å manøvrere lastebilen, og du må tilpasse deg mindre enn ideelle situasjoner."

	key[]: "aca_msg_book1_3_12_cutscene02"
	val[]: "Kjøring gjennom bakgaten mot den åpne området."

	key[]: "aca_msg_book1_3_12_cutscene03"
	val[]: "Til venstre er en annen bakgate du må rygge inn. Sett deg opp slik du ønsker med dette i tankene.<br>Det kan være nyttig å prøve å ha hengeren pekt mot bakgaten før du begynner å rygge."

	key[]: "aca_msg_book1_3_12_cutscene04"
	val[]: "Rygge mot bakgaten. Vær nøye med å holde øye med alle sider av traktoren og hengeren."

	key[]: "aca_msg_book1_3_12_cutscene05"
	val[]: "Det er hindringer i bakgaten, så pass på å holde mot førersiden."

	key[]: "aca_msg_book1_3_12_cutscene06"
	val[]: "Når du er ferdig med å rygge, kan du fortsette framover og kjøre tilbake i retningen du kom fra."

	key[]: "aca_msg_book1_3_12_cutscene07"
	val[]: "Du kan ha problemer med å se hengeren i passasjerens sidespeil når du kjører ut, så bruk all den tilgjengelige plassen til din fordel."

	key[]: "aca_msg_book1_3_12_cutscene08"
	val[]: "Fortsett kjøring mot utgangen."

	key[]: "aca_msg_book1_3_12_cutscene09"
	val[]: "Parkere på det angitte området og sikre lastebilen."
#!{
	key[]: "aca_msg_book1_3_12_cutscene10"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_12_cutscene11"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_12_cutscene12"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_12_cutscene13"
	val[]: "Unused"
#!}
#### 3_12 Driving Instructions

	key[]: "aca_msg_book1_3_12_start"
	val[]: "Foran deg er det et område som representerer et rederi sin tomt. Din oppgave er å kjøre inn og snu lastebilen rundt for å komme ut igjen. Sørg for å gjøre god bruk av plassen rundt deg.<br><br><font face=/font/big_bold.font>Forberede deg på å sette av gårde </font>"

	key[]: "aca_msg_book1_3_12_forward"
	val[]: "<font face=/font/big_bold.font>Fortsett gjennom bakgaten. </font>"

	key[]: "aca_msg_book1_3_12_check1"
	val[]: "Rett forbi bygningen til venstre er det en annen bakgate som du må rygge inn. Sett deg opp med dette i tankene.<br><br><font face=/font/big_bold.font>Fortsett mot barrierene. </font>"



	key[]: "aca_msg_book1_3_12_check3"
	val[]: "Rygge og snu hengeren mot bakgaten, du må passe på at du ikke treffer noe på høyre side med traktoren.<br><br><font face=/font/big_bold.font>Begynn å rygge og snu hengeren inn i bakgaten. Stopp i det merkede området. </font>"

	key[]: "aca_msg_book1_3_12_check4"
	val[]: "Du kan nå fortsette ut av området i samme retning som du kom fra. Utnytt plassen som er tilgjengelig for deg.<br><br><font face=/font/big_bold.font>Kjør framover og ta til høyre. </font>"


	key[]: "aca_msg_book1_3_12_check6"
	val[]: "Fortsett ned bakgaten mot det angitte området."
#!{
	key[]: "aca_msg_book1_3_12_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_12_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_12_check5"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_12_check2"
	val[]: "Unused"
#!}

#@}

#+ Book 1 Scenario 3_13
#@{

#### 3_13 common
	key[]: "aca_scenario_book1_3_13_title"
	val[]: "Forskyningsryggemanøvre"

	key[]: "aca_scenario_book1_3_13_desc"
	val[]: "I dette scenarioet får du i oppgave å rygge inn på en parkeringsplass som ikke er rett bak deg. Det er begrenset manøvreringsrom, så du må bruke plassen din klokt."

#### 3_13 goal

#!{
	key[]: "aca_goal_book1_3_13_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_13_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_13_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_13_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

#!}

#### 3_13 msg - intro text

	key[]: "aca_msg_book1_3_13_cutscene01"
	val[]: "I dette scenarioet vil oppgaven din være å parkere på plassen ved siden av deg. Det er ikke mye rom å manøvrere, så du må gjøre litt ekstra arbeid for å få hengeren dit du vil ha den."

	key[]: "aca_msg_book1_3_13_cutscene02"
	val[]: "Kjør rett opp til barrieren."

	key[]: "aca_msg_book1_3_13_cutscene03"
	val[]: "Stopp før barrieren."

	key[]: "aca_msg_book1_3_13_cutscene04"
	val[]: "Vri rattet skarpt til førersiden før du beveger deg. På denne måten begynner du å snu hengeren mot parkeringsplassen så snart du begynner å rygge, og sparer verdifull plass."

	key[]: "aca_msg_book1_3_13_cutscene05"
	val[]: "Når du har pekt hengeren dit du vil ha den, setter du traktoren foran hengeren og begynner å styre den inn på parkeringsplassen."

	key[]: "aca_msg_book1_3_13_cutscene06"
	val[]: "Fra dette punktet er det ikke så forskjellig fra en vanlig parkeringsmanøver."

	key[]: "aca_msg_book1_3_13_cutscene07"
	val[]: "Fortsett å rygge og se på begge sider. Hold traktoren og hengeren på linje med parkeringsplassen."

	key[]: "aca_msg_book1_3_13_cutscene08"
	val[]: "Stopp på det angitte området, sikre lastebilen, og skru av motoren."


#### 3_13 Driving Instructions

	key[]: "aca_msg_book1_3_13_start"
	val[]: "Du er på en parkeringsplass, men det er en andre parkeringsplass til høyre som du må bevege seg til.<br><br><font face=/font/big_bold.font>Forberede deg på å sette av gårde. </font>"

	key[]: "aca_msg_book1_3_13_forward"
	val[]: "Det er et markert område foran deg.<br><br><font face=/font/big_bold.font>Kjør framover. </font>"
#!{
	key[]: "aca_msg_book1_3_13_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

	key[]: "aca_msg_book1_3_13_check2"
	val[]: "Husk å begynne å styre umiddelbart, siden det ikke er mye plass.<br><br><font face=/font/big_bold.font>Rygge til det merkede stedet bak deg. </font>"


#@}

#+ Book 1 Scenario 3_15
#@{

#### 3_15 common
	key[]: "aca_scenario_book1_3_15_title"
	val[]: "Kannehåndtaks- og knappkrokssvinger"

	key[]: "aca_scenario_book1_3_15_desc"
	val[]: "I dette scenarioet tar du en kort kjøretur gjennom et opplæringsbane som vil hjelpe deg å lære å manøvrere hengeren rundt trange svinger ved hjelp av to forskjellige hjørneprosedyrer."

#### 3_15 goal
#!{
	key[]: "aca_goal_book1_3_15_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_15_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_15_check6"
	val[]: "@@aca_goal_book1_3_11_check6@@"

	key[]: "aca_goal_book1_3_15_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_15_end"
	val[]: "@@aca_goal_book1_2_01_end@@"


 #!}
	key[]: "aca_goal_book1_3_15_check1"
	val[]: "Kannehåndtakssving"

	key[]: "aca_goal_book1_3_15_check2"
	val[]: "Kurve og rett seksjon"

	key[]: "aca_goal_book1_3_15_check3"
	val[]: "Knappkrokssving"

	key[]: "aca_goal_book1_3_15_check4"
	val[]: "Rett seksjon og kurve"

	key[]: "aca_goal_book1_3_15_check5"
	val[]: "Kombinasjonssving"



#### 3_15 msg - intro text

	key[]: "aca_msg_book1_3_15_cutscene01"
	val[]: "Foran deg er det noen trange svinger med lite plass til overs.<br>Disse vil hjelpe deg å lære å manøvrere hengeren effektivt."

	key[]: "aca_msg_book1_3_15_cutscene02"
	val[]: "@@aca_msg_book1_3_15_cutscene02_img@@<br>Den første svingen krever en \"kannehåndtak\"-manøvre. Dette begrepet gjelder svinger der du har begrenset plass på veien du svinger inn i, og i stedet må bruke ekstra plass på veien du er på for øyeblikket."

	key[]: "aca_msg_book1_3_15_cutscene03"
	val[]: "Følg kjørefeltmarkeringene for å svinge traktoren langt og bredt fra den innvendige fortauskanten.<br>Dette vil bringe din henger vekk fra fortauskanten slik at du har tilstrekkelig plass til å manøvrere."

	key[]: "aca_msg_book1_3_15_cutscene04"
	val[]: "Hold deg nær hindringen når du kommer ut av svingen slik at hengeren fortsetter å følge en bredest mulig bue."

	key[]: "aca_msg_book1_3_15_cutscene05"
	val[]: "Når du kommer inn i den lange kurven, må du holde traktoren mot midten av veien for å holde hengerhjulene unna fortauskanten."

	key[]: "aca_msg_book1_3_15_cutscene06"
	val[]: "Fortsett langs veien."

	key[]: "aca_msg_book1_3_15_cutscene07"
	val[]: "@@aca_msg_book1_3_15_cutscene07_img@@<br>Den neste svingen krever bruk av en \"knappkrok\"-manøvre. Dette er den foretrukne teknikken siden den ikke åpner opp kjørefeltet bak deg for en uoppmerksom bilist å snike seg inn på høyre side. Bruk den alltid når du har nok plass på veien du skal svinge inn på."

	key[]: "aca_msg_book1_3_15_cutscene08"
	val[]: "Kjør dypt inn i krysset og ta raskt en skarp sving til høyre."

	key[]: "aca_msg_book1_3_15_cutscene09"
	val[]: "Når du kommer ved siden av hindringen, kan du rette deg ut og igjen holde deg mot venstre side av kjørefeltet.<br>Alt dette tjener til å holde hengerhjulene unna fortauskanten."

	key[]: "aca_msg_book1_3_15_cutscene10"
	val[]: "Fortsett mot den neste kurven."

	key[]: "aca_msg_book1_3_15_cutscene11"
	val[]: "Igjen holder du mot midten av veien for å holde hengerhjulene unna fortauskanten."

	key[]: "aca_msg_book1_3_15_cutscene12"
	val[]: "Hjørnet foran er spesielt problematisk. I tilfeller som dette vil du ikke ha ideelle forhold for verken en kannehåndtakssving eller en knappkrokssving og må kombinere begge manøvrene for å komme dit du skal."

	key[]: "aca_msg_book1_3_15_cutscene13"
	val[]: "Sving bredt før svingen, kjør dypt inn i krysset og sving raskt inn. Igjen er det ideelt å holde seg så nærme hindringen som mulig for å holde svingen så bred som mulig."

	key[]: "aca_msg_book1_3_15_cutscene14"
	val[]: "Parkere på det angitte området, sikre lastebilen og skru av motoren."

	# Book 1 Scenario 3_15 formatting
#!{
	key[]: "aca_msg_book1_3_15_cutscene02_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/jug_handle.mat bottom=p256 right=p256 color=FFFFFFFF></align><offset vshift=256>"

	key[]: "aca_msg_book1_3_15_cutscene07_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/button_hook.mat bottom=p256 right=p256 color=FFFFFFFF></align><offset vshift=256>"

#!}


#### 3_15 Driving Instructions

	key[]: "aca_msg_book1_3_15_forward"
	val[]: "Husk å bruke alt rommet som er tilgjengelig for deg for å hjelpe deg med hver sving.<br><br><font face=/font/big_bold.font>Sett av og følg veimerkingene til venstre. </font>"

	key[]: "aca_msg_book1_3_15_check1"
	val[]: "Bruk alt det tilgjengelige rommet til å svinge bredt og hold hengeren unna den innvendige fortauskanten.<br><br><font face=/font/big_bold.font>Gjør en kannehåndtakssving. </font>"

	key[]: "aca_msg_book1_3_15_check2"
	val[]: "Hold mot midten av veien rundt kurven, fortsett deretter rett mot neste sving.<br><br><font face=/font/big_bold.font>Fortsett å kjøre. </font>"

	key[]: "aca_msg_book1_3_15_check3"
	val[]: "Det er begrenset plass til venstre, så du må kjøre langt inn i krysset for å holde hengeren utenfor fortauskanten.<br><br><font face=/font/big_bold.font>Gjør en knappkrokssving. </font>"

	key[]: "aca_msg_book1_3_15_check4"
	val[]: "Kjør videre til og rundt neste kurve.<br><br><font face=/font/big_bold.font>Fortsett å kjøre. </font>"

	key[]: "aca_msg_book1_3_15_check5"
	val[]: "Denne svingen er den trangeste til nå, og ingen av manøvrene alene vil være tilstrekkelig.<br><br><font face=/font/big_bold.font>Gjør svingen, hold deg så bred som mulig.</font>"

	key[]: "aca_msg_book1_3_15_check6"
	val[]: "<font face=/font/big_bold.font>Fortsett til parkeringsplassen foran og til høyre. </font>"
#!{
	key[]: "aca_msg_book1_3_15_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_15_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_15_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}


#@}

#+ Book 1 Scenario 3_16
#@{

#### 3_16 common
	key[]: "aca_scenario_book1_3_16_title"
	val[]: "Diagonal parkering i revers"

	key[]: "aca_scenario_book1_3_16_desc"
	val[]: "I dette scenarioet vil vi utforske parkering diagonalt mens du rygger. Dette kan skje på rasteplasser, lastebilstopp og til og med hos utskipere. Ofte er det lite plass fordi tomtene er overfylte med lastebiler, så parkering er desto vanskeligere på grunn av plassmangel."

#### 3_16 goal

	key[]: "aca_goal_book1_3_16_check1"
	val[]: "Snu hengeren"
#!{
	key[]: "aca_goal_book1_3_16_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_16_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_16_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_16_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
 #!}
#### 3_16 msg - intro text

	key[]: "aca_msg_book1_3_16_cutscene1"
	val[]: "Diagonal parkering ser ut til å være enklere ved et øyekast, men det kan ofte være mer utfordrende enn typiske \"bakgateparkering\"-manøvrer."

	key[]: "aca_msg_book1_3_16_cutscene2"
	val[]: "Rygge mot parkeringsplassen. Hold traktoren og hengeren rett for nå."

	key[]: "aca_msg_book1_3_16_cutscene3"
	val[]: "Når du kommer nærmere, la din henger gå nærmere til de parkerte lastebilene. Dette vil hjelpe deg å snu inn til stedet når du når det."

	key[]: "aca_msg_book1_3_16_cutscene4"
	val[]: "Begynn å snu hengeren inn på parkeringsplassen. Hold din henger nær lastebilen på førersiden din, siden du trenger plassen på den andre siden."

	key[]: "aca_msg_book1_3_16_cutscene5"
	val[]: "Når hengeren er godt inne på parkeringsplassen, begynn å snu traktoren for å følge hengeren inn."

	key[]: "aca_msg_book1_3_16_cutscene6"
	val[]: "Parkere på det angitte området, sikre lastebilen og skru av motoren."

#### 3_16 Driving Instructions

	key[]: "aca_msg_book1_3_16_start"
	val[]: "Parkere lastebilen på plassen bak deg. Bruk begge speilene dine for å navigere som du rygger.<br><br><font face=/font/big_bold.font>Forberede deg på å sette i gang. </font>"

	key[]: "aca_msg_book1_3_16_backward"
	val[]: "Sjekk omgivelsene dine, deretter kjør mot parkeringsplassen.<br><br><font face=/font/big_bold.font>Begynn å rygge.</font>"

	key[]: "aca_msg_book1_3_16_check1"
	val[]: "Begynn å flytte hengeren mot lastebilene ved siden av deg. Når du er klar, snu hengeren inn på parkeringsplassen. Husk å vurdere halesvingen til hengeren.<br><br><font face=/font/big_bold.font>Sving inn på parkeringsplassen. </font>"
#!{
	key[]: "aca_msg_book1_3_16_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_16_end"
	val[]: "@@aca_msg_book1_2_01_end@@"


 #!}


#@}

#+ Book 1 Scenario 3_17
#@{

#### 3_17 common
	key[]: "aca_scenario_book1_3_17_title"
	val[]: "Rygge inn en sving"

	key[]: "aca_scenario_book1_3_17_desc"
	val[]: "I dette scenarioet vil vi rygge med en henger inn i en sving for første gang. Vi skal utforske de grunnleggende prinsippene for rygging og hva du bør se etter når du snur i revers."

#### 3_17 goal

	key[]: "aca_goal_book1_3_17_check1"
	val[]: "Snu hengeren"
#!{
	key[]: "aca_goal_book1_3_17_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_17_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_17_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_17_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
 #!}
#### 3_17 msg - intro text

	key[]: "aca_msg_book1_3_17_cutscene01"
	val[]: "I dette scenarioet må du rygge til parkeringsplassen som er bak deg til førersiden."

	key[]: "aca_msg_book1_3_17_cutscene02"
	val[]: "Det er noen få tips å huske som vil hjelpe deg mye med å rygge hengere. <br>Den første er at hengeren alltid vil svinge i motsatt retning av hvordan du styrer traktoren."

	key[]: "aca_msg_book1_3_17_cutscene03"
	val[]: "Den andre er at du kan få en god følelse av hvor hengeren er på vei ved å se på akslene til lastebilen og hengeren."

	key[]: "aca_msg_book1_3_17_cutscene04"
	val[]: "For det tredje vil små innganger få deg dit du trenger å gå, ingen grunn til å overarbeide det."

	key[]: "aca_msg_book1_3_17_cutscene05"
	val[]: "Begynn å svinge traktoren litt vekk fra parkeringsplassen, og hengeren vil begynne å peke mot den."

	key[]: "aca_msg_book1_3_17_cutscene06"
	val[]: "Følg hengeren, gjør justeringer mens du går for å holde den på rett vei."

	key[]: "aca_msg_book1_3_17_cutscene07"
	val[]: "Se på hengerhjulene og bakhjulet på traktoren. De vil fortelle deg hvor hengeren peker, og hvor traktoren skyver den."

	key[]: "aca_msg_book1_3_17_cutscene08"
	val[]: "Et fjerde tips er at det alltid er lettere å snu hengeren skarpere enn det er å prøve å rette den ut fra en jekkkniv. Sikt mot utsiden av stedet fram til du er nærmere til den, deretter kan du svinge litt skarpere for å justere din henger."

	key[]: "aca_msg_book1_3_17_cutscene09"
	val[]: "Når hengeren kommer inn på parkeringsplassen, sett traktoren foran hengeren. Prøv å unngå for mange justeringer inne i selve stedet."

	key[]: "aca_msg_book1_3_17_cutscene10"
	val[]: "Rygge mellom barrierene, sjekk begge sider mens du kjører."

	key[]: "aca_msg_book1_3_17_cutscene11"
	val[]: "Sikre lastebilen og skru av motoren."

#### 3_17 Driving Instructions

	key[]: "aca_msg_book1_3_17_start"
	val[]: "Husk disse tipsene når du rygger inn i en sving med henger:<br><br>— Hengeren svinger motsatt av hvordan du styrer traktoren<br><br>— Se på hengerens hjul for å se hvor den sikter<br><br> — Se på traktorens bakhjul for å se hvor den skyver hengeren<br><br>— La hengeren gjøre jobben, ikke overstyr den<br><br>— Det er alltid lettere å snu hengeren skarpere enn den er for å rette det ut<br><br><font face=/font/big_bold.font>Forberede deg på å sette i gang. </font>"

	key[]: "aca_msg_book1_3_17_backward"
	val[]: "Se bak deg for å finne hvor du må gå. Sjekk alltid omgivelsene dine før du begynner å rygge.<br><br><font face=/font/big_bold.font>Begynn å rygge mot parkeringsplassen.</font>"

	key[]: "aca_msg_book1_3_17_check1"
	val[]: "<font face=/font/big_bold.font>Begynn å snu hengeren mot parkeringsplassen og følg den inn.</font>"

	key[]: "aca_msg_book1_3_17_stop"
	val[]: "<font face=/font/big_bold.font>Stopp i det angitte stedet. </font>"
#!{
	key[]: "aca_msg_book1_3_17_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_18
#@{

#### 3_18 common
	key[]: "aca_scenario_book1_3_18_title"
	val[]: "Bakgateparkeringsmanøvre"

	key[]: "aca_scenario_book1_3_18_desc"
	val[]: "I dette scenarioet får du i oppgave å rygge hengeren inn i en bakgate utenfor en liten veibane."

#### 3_18 goal

	key[]: "aca_goal_book1_3_18_check1"
	val[]: "Snu hengeren"
#!{
	key[]: "aca_goal_book1_3_18_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_18_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


	key[]: "aca_goal_book1_3_18_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_18_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

 #!}
#### 3_18 msg - intro text

	key[]: "aca_msg_book1_3_18_cutscene01"
	val[]: "Parkering her krever en 'bakgateparkering'-manøvre.<br>Dette er en typisk parkeringsmanøvre for lastebilsjåfører, siden de vil møte denne typen parkeringssituasjon nesten daglig i karrieren, enten det er for å laste eller losse en henger eller å parkere for natt i en lastebilstopp."

	key[]: "aca_msg_book1_3_18_cutscene02"
	val[]: "Dette er en lignende manøver som det forrige scenarioet, men du vil ha mindre plass til å jobbe, så du må planlegge bevegelsene dine deretter og være forsiktig så du ikke treffer noe."

	key[]: "aca_msg_book1_3_18_cutscene03"
	val[]: "Siden det er mindre plass, er timingen din viktigere. Snu hengeren til rett tid og se på traktor- og hengerhjulene for å se hvor den vil gå. Ha halesving i bakhodet og husk å ikke jekkknive - fortsett å skyve hengeren."

	key[]: "aca_msg_book1_3_18_cutscene04"
	val[]: "Prøv å styre hengeren mot bakgaten tidligere i stedet for senere. Dette vil gi deg plass på den andre siden til å svinge fronten av hengeren rundt og for å få traktoren foran den."

	key[]: "aca_msg_book1_3_18_cutscene05"
	val[]: "Når hengeren din er i bakgaten, sett traktoren foran den. Det er bedre å gjøre dette litt tidligere enn instinktet ditt i utgangspunktet kan få deg til å tro. Du kan alltid korrigere det som din rygging til din endelige posisjon."

	key[]: "aca_msg_book1_3_18_cutscene06"
	val[]: "Få traktoren og hengeren rett og stopp på det angitte området."

	key[]: "aca_msg_book1_3_18_cutscene07"
	val[]: "Sikre lastebilen og skru av motoren."


#### 3_18 Driving Instructions

	key[]: "aca_msg_book1_3_18_start"
	val[]: "Nå skal vi prøve å snu en henger på et mye mindre område med en 'bakgateparkering'-manøvre. <br><br><font face=/font/big_bold.font>Forberede deg på å sette i gang. </font>"

	key[]: "aca_msg_book1_3_18_backward"
	val[]: "Sjekk omgivelsene dine og se etter parkeringsplassen bak deg. <br><br><font face=/font/big_bold.font>Begynn å rygge mot parkeringsplassen. </font>"

	key[]: "aca_msg_book1_3_18_check1"
	val[]: "<font face=/font/big_bold.font>Snu hengeren inn på parkeringsplassen. </font>"
#!{
	key[]: "aca_msg_book1_3_18_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_18_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}


#@}

#+ Book 1 Scenario 3_19
#@{

#### 3_19 common
	key[]: "aca_scenario_book1_3_19_title"
	val[]: "Avsluttende eksamen (Del 1)"

	key[]: "aca_scenario_book1_3_19_desc"
	val[]: "Den avsluttende eksamenen venter på deg, hvor alle ferdighetene du har lært fra de tidligere scenarioene vil bli satt på en prøve. Vi tar en kjøretur rundt i hele opplæringssenteret for å se hvor godt du har lært situasjonene du har vært borti så langt.<br><br>Når du har fullført alle seksjonene og manøvrene, er du ett steg nærmere å kalle deg selv en dyktig lastebilsjåfør!"

