	val[]: "@@aca_goal_book1_1_03_forward@@"

	key[]: "aca_goal_book1_3_01_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_01_park_br_off3"
	val[]: "@@aca_goal_book1_1_03_forward@@"
	key[]: "aca_goal_book1_3_01_parking_brake5"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

	key[]: "aca_goal_book1_3_01_park_br_on"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

	key[]: "aca_goal_book1_3_01_stop5"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_01_disc6"
	val[]: "@@aca_goal_book1_1_03_stop@@"

#!}
#### 3_01 msg - intro text

	key[]: "aca_msg_book1_3_01_cutscene1"
	val[]: "I dette scenarioet prøver vi å koble til og fra en henger for første gang. Gjør lastebilen klar til å gå, og rygg deretter under hengeren bak deg."

	key[]: "aca_msg_book1_3_01_cutscene2"
	val[]: "Koble til hengeren, og trekk deretter framover."

	key[]: "aca_msg_book1_3_01_cutscene3"
	val[]: "Stopp på det merkede området."

	key[]: "aca_msg_book1_3_01_cutscene4"
	val[]: "Koble fra hengeren, trekk framover."

	key[]: "aca_msg_book1_3_01_cutscene5"
	val[]: "Parkere på parkeringsplassen og sikre lastebilen."


#### 3_01 Driving Instructions

	key[]: "aca_msg_book1_3_01_start"
	val[]: "I dette scenarioet vil vi diskutere prosedyrene for å koble til og fra traktoren og hengeren. Dette er en forenklet prosedyre sammenlignet med hva en lastebilfører vil møte i det virkelige liv. <br><br><font face=/font/big_bold.font>Forberede deg på å sette i gang. </font>"

	key[]: "aca_msg_book1_3_01_check_con"
	val[]: "Det er en henger plassert bak trekkvognen. Rygge sakte under hengeren til det femte hjulet treffer kongenålen. For øyeblikket er lastebilen riktig justert, så det er ikke nødvendig å styre, bare rygge rett.<br><br><font face=/font/big_bold.font>Rygge sakte til du kjenner en tilkobling. </font>"

	key[]: "aca_msg_book1_3_01_park_br_on"
	val[]: "Det femte hjulet er koblet til kongenålen.<br><br><font face=/font/big_bold.font>Sikre lastebilen ved å sette på parkeringsbremsen. </font>"

	key[]: "aca_msg_book1_3_01_connect"
	val[]: "I det virkelige liv låser det femte hjulet automatisk kongenålen, så må lastebilføreren gå ut av kjøretøyet for å trekke inn landingsutstyret og koble sammen luft- og elektriske ledninger. <br><br><font face=/font/big_bold.font>For oss er det bare å trykke på @@imv_nrm_attach@@ for å koble til hengeren. </font>"

	key[]: "aca_msg_book1_3_01_park_br_off"
	val[]: "Nå som traktoren er trygt koblet til hengeren, er du klar til å kjøre framover. Husk at kjøretøyet ditt nå er betydelig lengre og tyngre og vil kreve et nytt sett med ferdigheter for å betjene. <br><br><font face=/font/big_bold.font>Løsne parkeringsbremsen og forberede deg på å kjøre framover. </font>"

	key[]: "aca_msg_book1_3_01_check_discon"
	val[]: "Kjør framover.<br><br><font face=/font/big_bold.font>Stopp i det merkede området foran. </font>"

	key[]: "aca_msg_book1_3_01_parking_brake5"
	val[]: "<font face=/font/big_bold.font>Sett på parkeringsbremsen. </font>"

	key[]: "aca_msg_book1_3_01_stop5"
	val[]: "<font face=/font/big_bold.font>Aktivere parkeringsbremsen. </font>"

	key[]: "aca_msg_book1_3_01_disc5"
	val[]: "Nok en gang, i det virkelige liv, måtte lastebilføreren gå ut av kjøretøyet, senke landingsutstyret, koble fra luft- og elektriske ledninger og frigjøre femte hjuls låsemekanismen. <br><br><font face=/font/big_bold.font>Vi forenkler denne prosessen for deg, så å trykke på @@imv_nrm_attach@@ for å koble fra hengeren. </font>"

	key[]: "aca_msg_book1_3_01_park_br_off2"
	val[]: "<font face=/font/big_bold.font>Løsne parkeringsbremsen. </font>"

	key[]: "aca_msg_book1_3_01_park_br_off3"
	val[]: "Trekk traktoren ut fra under hengeren og beveg framover.<br><br><font face=/font/big_bold.font>Stopp i det merkede området. </font>"

	key[]: "aca_msg_book1_3_01_stop"
	val[]: "<font face=/font/big_bold.font>Stopp i det merkede området. </font>"
#!{
	key[]: "aca_msg_book1_3_01_end"
	val[]: "@@aca_msg_book1_2_01_end@@"


#!}

#@}

#+ Book 1 Scenario 3_02
#@{

#### 3_02 common
	key[]: "aca_scenario_book1_3_02_title"
	val[]: "Bremsing med en henger"

	key[]: "aca_scenario_book1_3_02_desc"
	val[]: "I dette scenarioet vil du få en følelse av kjøring og bremsing med en henger tilkoblet."

#### 3_02 goal



	key[]: "aca_goal_book1_3_02_forward"
	val[]: "Sette av gårde"

	key[]: "aca_goal_book1_3_02_check1"
	val[]: "Kjører ned graden"

	key[]: "aca_goal_book1_3_02_check2"
	val[]: "Når en hastighet på 60 km/t (37 mph)"

	key[]: "aca_goal_book1_3_02_check3"
	val[]: "Setter på bremsene"
#!{
	key[]: "aca_goal_book1_3_02_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_02_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_02_start"
	val[]: "@@aca_goal_book1_2_01_start@@"
 #!}
#### 3_02 msg - intro text

	key[]: "aca_msg_book1_3_02_cutscene01"
	val[]: "I dette scenarioet tar vi lastebilen en kort kjøretur. Du vil kunne få en følelse av bremsing med en henger når vi kommer nedover den milde graden fremover. Klargjør lastebilen og sett av sted."

	key[]: "aca_msg_book1_3_02_cutscene06"
	val[]: "Nå en hastighet på minst 60 km/t (37 mph). Vær klar for bremsesonen fremover."

	key[]: "aca_msg_book1_3_02_cutscene08"
	val[]: "Begynn å bremse til et stopp. Pass på at du ikke venter for lenge, ellers kan du treffe barrierene foran deg!"

	key[]: "aca_msg_book1_3_02_cutscene10"
	val[]: "Parkere på det angitte området, deretter sikre lastebilen og skru av motoren."


#### 3_02 Driving Instructions

	key[]: "aca_msg_book1_3_02_start"
	val[]: "Under denne kjøreturen vil du få en følelse av å bruke driftsbremsene mens du kjører ned i en mild grad. Hensikten med denne øvelsen er å bli klar over vekten bak deg og hvordan den påvirker bremselengden til kjøretøyet.<br><br><font face=/font/big_bold.font>Forberede deg på å sette i gang. </font>"

	key[]: "aca_msg_book1_3_02_forward"
	val[]: "Begynn å kjøre nå, og husk at du må nå en hastighet på 60 km/t (37 mph) <font face=/font/big_bold.font>etter</font> svingen foran.<br><br> <font face=/font/big_bold.font>Kjør mot svingen foran. </font>"

	key[]: "aca_msg_book1_3_02_check1"
	val[]: "Sving til høyre, og akselerer deretter til 60 km/t (37 mph).<br><br><font face=/font/big_bold.font>Fortsett å kjøre. </font>"

	key[]: "aca_msg_book1_3_02_check2"
	val[]: "<font face=/font/big_bold.font>Nå en hastighet på minst 60 km/t (37 mph). </font>"

	key[]: "aca_msg_book1_3_02_check3"
	val[]: "Du har nådd den nødvendige hastigheten.<br><br><font face=/font/big_bold.font>Stopp ved barrierene foran. </font>"
#!{
	key[]: "aca_msg_book1_3_02_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_02_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

