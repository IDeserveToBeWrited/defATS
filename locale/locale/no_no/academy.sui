	val[]: "@@aca_goal_book3_sup_check1@@"

	key[]: "aca_goal_book3_double_90_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_double_90_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}

#### double_90 intro

	key[]: "aca_msg_book3_double_90_cutscene01"
	val[]: "Banen som kommer vil hjelpe deg å bli kjent med å snu B-doble hengere gjennom 90-graders svinger med varierende vanskelighetsgrad."

	key[]: "aca_msg_book3_double_90_cutscene02"
	val[]: "De første hjørnene er ganske brede, med god plass. Bruk disse til å få en følelse av hengerne bak deg når det er din tur."

	key[]: "aca_msg_book3_double_90_cutscene03"
	val[]: "Herfra og ut blir svingene smalere og mer tekniske. Kjør sakte, og sørg for at du kjører dypt inn i svingene slik at dine hengerne har plass til å spore rundt hjørnet bak deg."

	key[]: "aca_msg_book3_double_90_cutscene04"
	val[]: "Dette er en av de skarpeste svingene på banen. Det kan være lurt å utnytte den lille plassen til høyre for å få hengerne rundt de plagsomme innvendige kjeglene."

	key[]: "aca_msg_book3_double_90_cutscene05"
	val[]: "Neste sving bør alltid være i bakhodet – når du forlater en sving, lag en plan for hvordan du skal forberede deg til den neste."

	key[]: "aca_msg_book3_double_90_cutscene06"
	val[]: "Vær alltid oppmerksom på dine hengerne helt til de er fri for hindringer."

#### double_90 driving instructions

#!{
	key[]: "aca_msg_book3_double_90_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_double_90_forward"
	val[]: "Fortsett fremover mot første sving."

	key[]: "aca_msg_book3_double_90_check1"
	val[]: "Vær oppmerksom på dine speil mens du kjører for å forstå hvordan hengerne sporer bak deg."

	key[]: "aca_msg_book3_double_90_check2"
	val[]: "Hold bredde før hver sving. Dette er avgjørende for å gi deg selv den plassen du trenger til å få hengerne rundt hjørnet."

	key[]: "aca_msg_book3_double_90_check3"
	val[]: "Oppsettet for de neste svingene er avgjørende, ettersom det er en veldig skarp sving etter. En feil i begynnelsen kan koste deg enda mer senere. <br><br>Vær langsom og nøyaktig, og vær oppmerksom på dine omgivelser."

	key[]: "aca_msg_book3_double_90_check4"
	val[]: "Denne svingen er ekstremt krapp, og fører rett inn i en annen krapp sving. Du må ikke bare tenke på hvordan du går inn i svingen, men også hvordan du går ut av den og forbereder deg til den neste."

	key[]: "aca_msg_book3_double_90_check5"
	val[]: "Fortsett å kjøre gjennom de siste svingene mot det angitte området."

#!{
	key[]: "aca_msg_book3_double_90_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_double_90_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


#+ Book 3 Scenario justb
#@{

#### justb common
	key[]: "aca_scenario_book3_justb_title"
	val[]: "Første rygging"

	key[]: "aca_scenario_book3_justb_desc"
	val[]: "I dette scenarioet rygger vi en kombinasjon av B-doble hengere for aller første gang."

#### justb goal

#!{
	key[]: "aca_goal_book3_justb_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_justb_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
	key[]: "aca_goal_book3_justb_check1"
	val[]: "Slapp av, ikke bekymre deg"

#!{
	key[]: "aca_goal_book3_justb_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_justb_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### justb msg - intro text

	key[]: "aca_msg_book3_justb_cutscene1"
	val[]: "Å rygge med B-doble hengere krever en helt ny måte å tenke på hva du gjør. I stedet for bare å styre en henger, bruker du nå den fremre hengeren til å styre en bak den. <br><br> Bruk dette scenarioet for å få en følelse av hvordan det hele fungerer. Det er ikke noe spesifikt mål, bare ta deg god tid og prøv å forstå hva som skjer."

	key[]: "aca_msg_book3_justb_cutscene2"
	val[]: "Fra en rett posisjon kan du svinge lastebilen i samme retning som du vil at den bakre hengeren skal kjøre. <br><br>Ikke overdriv; du trenger bare å få denn bakre hengeren i den retningen du vil at den skal kjøre, og deretter kan du justere traktoren med den fremre hengeren og la den bakre hengeren gjøre jobben sin."

	key[]: "aca_msg_book3_justb_cutscene3"
	val[]: "Når den bakre hengeren er på vei dit du vil, kan du styre den ledende hengeren i samme retning. <br><br>Når den ledende hengeren følger den bakre hengeren, bruk traktoren til å justere vinkelen mellom de to hengerne for enten å svinge skarpere eller bredere."

	key[]: "aca_msg_book3_justb_cutscene4"
	val[]: "Det finnes ingen eksakt formel for å få dette riktig, du må bare følge med på hva som skjer, lære av feilene dine og fortsette å øve. <br><br>Når du er fornøyd, kan du dra til det angitte området og sikre kjøretøyet. <br><br>Bruk gjerne så mye tid her på å eksperimentere som du føler du trenger."

#### justb Driving Instructions

#!{
	key[]: "aca_msg_book3_justb_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_justb_forward"
	val[]: "Begynn å rygge sakte. Husk å bare starte med små innsatser, det er ikke nødvendig å jack-knife alt med en gang.<br><br>Prøv å kjøre rett bakover, eller bring hengerne til førersiden."

	key[]: "aca_msg_book3_justb_check1"
	val[]: "Ta deg god tid og ikke bli frustrert. <br><br>Enhver mester var en gang en nybegynner."

#!{
	key[]: "aca_msg_book3_justb_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_justb_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}

#+ Book 3 Scenario justc
#@{

#### justc common
	key[]: "aca_scenario_book3_justc_title"
	val[]: "Første ryggingskorreksjon"

	key[]: "aca_scenario_book3_justc_desc"
	val[]: "I dette scenearioet må vi fortsette der noen andre slapp."

#### justc goal

#!{
	key[]: "aca_goal_book3_justc_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_justc_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
	key[]: "aca_goal_book3_justc_check1"
	val[]: "Rygging"

#!{
	key[]: "aca_goal_book3_justc_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_justc_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### justc msg - intro text

	key[]: "aca_msg_book3_justc_cutscene1"
	val[]: "Å nei! Noen andre ble litt frustrert mens de rygget og satte fra seg sin lastebil midt på parkeringsplassen."

	key[]: "aca_msg_book3_justc_cutscene2"
	val[]: "Det vil uunngåelig være tider der du blir fullstendig rotet til. Ikke bekymre deg, bare dra fremover og ut av jack-knife til at du har noe du kan jobbe med. <br><br>Hvis du er usikker, prøv å få alt på plass slik at du har blanke ark."

	key[]: "aca_msg_book3_justc_cutscene3"
	val[]: "Dette er en grei posisjon å starte fra. Den bakre hengeren er fortsatt pekt dit vi vil at den skal, og vi kan raskt få traktoren foran ledende for å begynne å styre hele kombinasjonen dit vi vil."

	key[]: "aca_msg_book3_justc_cutscene4"
	val[]: "fortsett til det angitte området og sikre lastebilen. <br><br>Nok en gang kan du øve på dette scenarioet til du er komfortabel med å manøvrere hengerne."

#### justc Driving Instructions

#!{
	key[]: "aca_msg_book3_justc_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_justc_forward"
	val[]: "Det er ingen vei ut av dette rotet. Trekk deg framover så du har noe å jobbe med."

	key[]: "aca_msg_book3_justc_check1"
	val[]: "Begynn å rygge."

#!{
	key[]: "aca_msg_book3_justc_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_justc_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


#+ Straight Backing
#@{

#### straight_backing common

	key[]: "aca_scenario_book3_straight_backing_title"
	val[]: "Rett bakside"

	key[]: "aca_scenario_book3_straight_backing_desc"
	val[]: "I dette scenarioet må du rygge et sett med B-doble hengere i en rett linje."

#### straight_backing goal

#!{
	key[]: "aca_goal_book3_straight_backing_start"
	val[]: "@@aca_goal_book3_sup_start@@"
#!}
	key[]: "aca_goal_book3_straight_backing_forward"
	val[]: "Rygging"

#!{
	key[]: "aca_goal_book3_straight_backing_check1"
	val[]: "@@aca_goal_book3_sup_check1@@"

	key[]: "aca_goal_book3_straight_backing_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_straight_backing_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### straight_backing - intro text

	key[]: "aca_msg_book3_straight_backing_cutscene01"
	val[]: "Rett rygging kan virke enklere ved første øyekast, men det er faktisk mye vanskeligere. <br><br>I stedet for bare å øke eller redusere vinkelen mellom hengerne på den ene siden, må du nå jobbe på begge sider for å holde kombinasjonen rett."

	key[]: "aca_msg_book3_straight_backing_cutscene02"
	val[]: "Start med relativt små korrigeringer. Det er greit om du ender opp med å vrikke og vippe til hver side, bare husk at du må holde vinkelen mellom lastebilen og den fremre hengeren litt lenger for å endre vinkelen mellom den fremre og bakre hengeren."

	key[]: "aca_msg_book3_straight_backing_cutscene03"
	val[]: "Du må kanskje gjøre noen ganske store manøvrer med traktoren for å holde den bakre hengeren pekende dit du vil, men prøv å ikke overdrive det i utgangspunktet slik at du slipper det."

	key[]: "aca_msg_book3_straight_backing_cutscene04"
	val[]: "Du kan trekke deg framover for å korrigere deg selv så mange ganger som nødvendig. Så lenge du ender opp trygt på parkeringsplassen, er resten trivielt."

#### Straight Backing Driving Instructions

#!{
	key[]: "aca_msg_book3_straight_backing_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_straight_backing_forward"
	val[]: "Begynn å rygge sakte."

#!{
	key[]: "aca_msg_book3_straight_backing_check1"
	val[]: "@@aca_msg_book3_sup_check1@@"
#!}
	key[]: "aca_msg_book3_straight_backing_stop"
	val[]: "Rett deg opp og stopp i det angitte området."

	key[]: "aca_msg_book3_straight_backing_end"
	val[]: "Sikre kjøretøyet og skru av motoren."

#@}


#+ Correcting Straight Backing
#@{

#### correcting_straight_backing common

	key[]: "aca_scenario_book3_correcting_straight_backing_title"
	val[]: "Rett baksidekorrigering"

	key[]: "aca_scenario_book3_correcting_straight_backing_desc"
	val[]: "I dette scenarioet tar du over rattet etter at noen andre allerede har forsøkt å rygge rett frem. Rett opp feilen deres og parker lastebilen på det angitte stedet."

#### correcting_straight_backing goal

#!{
	key[]: "aca_goal_book3_correcting_straight_backing_start"
	val[]: "@@aca_goal_book3_sup_start@@"
#!}
	key[]: "aca_goal_book3_correcting_straight_backing_forward"
	val[]: "Retter seg opp"

	key[]: "aca_goal_book3_correcting_straight_backing_check1"
	val[]: "Rygging"

#!{
	key[]: "aca_goal_book3_correcting_straight_backing_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_correcting_straight_backing_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### correcting_straight_backing - intro text

	key[]: "aca_msg_book3_correcting_straight_cutscene01"
	val[]: "Noen har forsøkt å rygge denne kombinasjonen inn på parkeringsplassen og har hatt litt problemer. Nå er det opp til deg å fikse det!"

	key[]: "aca_msg_book3_correcting_straight_cutscene02"
	val[]: "Det første steget er å kjøre framover og få alt på plass til noe vi kan jobbe med. Det er avgjørende at den bakre hengeren peker dit du vil at den skal."

	key[]: "aca_msg_book3_correcting_straight_cutscene03"
	val[]: "I dette tilfellet har vi valgt å gå mer mot førersiden. Dette vil gi oss bedre oversikt over hva vi gjør når vi rygger, og lar oss jobbe fra én side. <br><br>Husk at du styrer den bakre hengeren med ledende, så ikke fokusere så mye på traktoren."

	key[]: "aca_msg_book3_correcting_straight_cutscene04"
	val[]: "Kombinasjonen er mer eller mindre der vi trenger den, men la oss trekke framover igjen for å sentrere den ordentlig."

	key[]: "aca_msg_book3_correcting_straight_cutscene05"
	val[]: "Herfra rygger vi forsiktig på plass, og sørger for at den bakre hengeren holder seg perfekt på sporet."

	key[]: "aca_msg_book3_correcting_straight_cutscene06"
	val[]: "Nå kan vi stille opp den ledende hengeren og selve traktoren."

#### correcting_Straight_Backing Driving Instructions

#!{
	key[]: "aca_msg_book3_correcting_straight_backing_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_correcting_straight_backing_forward"
	val[]: "Trekk framover og rett opp alt. <br><br>Når du er fornøyd, rygg inn i det angitte området."

	key[]: "aca_msg_book3_correcting_straight_backing_check1"
	val[]: "Rygge mot det angitte området."

#!{
	key[]: "aca_msg_book3_correcting_straight_backing_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"
#!}
	key[]: "aca_msg_book3_correcting_straight_backing_end"
	val[]: "Sikre kjøretøyet og skru av motoren."

#@}


#+ Book 3 Scenario backing_90_tight
#@{

#### backing_90_tight common
	key[]: "aca_scenario_book3_backing_90_tight_title"
	val[]: "90-graders bakside"

	key[]: "aca_scenario_book3_backing_90_tight_desc"
	val[]: "I dette scenariet bruker du en 90-graders bakeside manøvre for å parkere i en rekke med andre lastebiler."

#### backing_90_tight goal

	key[]: "aca_goal_book3_backing_90_tight_check1"
	val[]: "U-sving"

	key[]: "aca_goal_book3_backing_90_tight_check2"
	val[]: "Sette av gårde"

		key[]: "aca_goal_book3_backing_90_tight_check3"
	val[]: "Rygging"

#!{
		key[]: "aca_goal_book3_backing_90_tight_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_backing_90_tight_end"
	val[]: "@@aca_goal_book3_sup_end@@"

	key[]: "aca_goal_book3_backing_90_tight_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_backing_90_tight_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
#### backing_90_tight msg - intro text

	key[]: "aca_msg_book3_backing_90_tight_cutscene1"
	val[]: "Det er enklere å rygge til siden med B-doble hengere, da du vil ha et klarere utsiktspunkt ut av sidevinduet over alt som skjer."

	key[]: "aca_msg_book3_backing_90_tight_cutscene2"
	val[]: "Kjør først fremover og gjør en U-sving på slutten av raden. Dette vil tillate deg å sette opp fra siktsiden, slik at du også ser ting bedre ut av førersidevinduet."

	key[]: "aca_msg_book3_backing_90_tight_cutscene3"
	val[]: "Du kan velge å sette opp hengerne slik at du synes det passer, kanskje med den bakre hengeren allerede pekende mot stedet. I dette tilfellet starter vi fra en rett posisjon. <br><br>Husk å holde det enkelt – styr den bakre hengeren med ledende."

	key[]: "aca_msg_book3_backing_90_tight_cutscene4"
	val[]: "Styr den ledende hengeren litt bort fra parkeringsplassen, og den bakre hengeren vil begynne å peke mot plassen. Derfra justerer du vinkelen mellom den fremre og den bakre hengeren for å opprettholde en fin, jevn bue inn i parkeringsplassen."

	key[]: "aca_msg_book3_backing_90_tight_cutscene5"
	val[]: "Husk at hvis den bakre hengeren kommer for stramt inn, må du rette ut vinkelen på kombinasjonen litt. Hvis den kommer for bredt inn, må du gjøre vinkelen skarpere."

	key[]: "aca_msg_book3_backing_90_tight_cutscene6"
	val[]: "Justeringer du gjør med traktoren har halvparten så mye effekt på den bakre hengeren som de har på ledende, så ikke vær redd for å jobbe traktoren skikkelig."

	key[]: "aca_msg_book3_backing_90_tight_cutscene7"
	val[]: "På dette tidspunktet må du begynne å planlegge framover. Du må også få den ledende hengeren på plass, så start en plan for å få den rett foran bakenden."

	key[]: "aca_msg_book3_backing_90_tight_cutscene8"
	val[]: "Det er svært sjeldent at man får hengerne inn på første forsøk. I dette tilfellet ventet vi for lenge med å rette opp ledende, og nå driver bakenden ut av banen. <br><br>Ingen problem, kjør fremover og prøv igjen."

	key[]: "aca_msg_book3_backing_90_tight_cutscene9"
	val[]: "Kjør den rattet skikkelig, og få hengerne dit du vil ha dem. Du kan kjøre fremover så mange ganger du trenger til du er fornøyd."

	key[]: "aca_msg_book3_backing_90_tight_cutscene10"
	val[]: "Og akkurat slik har vi vellykket parkert B-doble hengere."

#### backing_90_tight Driving Instructions

#!{
	key[]: "aca_msg_book3_backing_90_tight_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_backing_90_tight_forward"
	val[]: "Kjør frem til enden av parkeringsplassen og snu."

	key[]: "aca_msg_book3_backing_90_tight_check1"
	val[]: "Husk å gjøre en bred sving."

	key[]: "aca_msg_book3_backing_90_tight_check2"
	val[]: "Fortsett fremover til at du føler at du har tilstrekkelig med manøvreringsplass, og begynn deretter å rygge."

	key[]: "aca_msg_book3_backing_90_tight_check3"
	val[]: "Rygge inn på parkeringsplassen."

#!{
	key[]: "aca_msg_book3_backing_90_tight_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_backing_90_tight_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


