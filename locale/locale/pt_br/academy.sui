#### 3_12 msg - intro text

	key[]: "aca_msg_book1_3_12_cutscene01"
	val[]: "Neste cenário, veremos como dar a volta em um espaço apertado.<br>Nem sempre você terá muito espaço para manobrar o caminhão e precisará se adaptar a situações menos ideais."

	key[]: "aca_msg_book1_3_12_cutscene02"
	val[]: "Dirija pelo beco em direção à área aberta."

	key[]: "aca_msg_book1_3_12_cutscene03"
	val[]: "À esquerda, há outro beco em que você deve dar marcha à ré. Posicione-se como quiser com isso em mente.<br>Pode ser útil tentar apontar o reboque para o beco antes de começar a dar marcha à ré."

	key[]: "aca_msg_book1_3_12_cutscene04"
	val[]: "Dê marcha à ré em direção ao beco. Tenha cuidado para ficar de olho em todos os lados do cavalo mecânico e do reboque."

	key[]: "aca_msg_book1_3_12_cutscene05"
	val[]: "Há obstáculos no beco, então certifique-se de manter-se no lado do motorista."

	key[]: "aca_msg_book1_3_12_cutscene06"
	val[]: "Após terminar de dar marcha à ré, você pode prosseguir para a frente e retornar na direção de onde veio."

	key[]: "aca_msg_book1_3_12_cutscene07"
	val[]: "Você pode ter dificuldade em ver seu reboque no espelho do lado do passageiro ao sair, então use todo o espaço disponível a seu favor."

	key[]: "aca_msg_book1_3_12_cutscene08"
	val[]: "Continue dirigindo em direção à saída."

	key[]: "aca_msg_book1_3_12_cutscene09"
	val[]: "Estacione na área indicada e acione o freio de estacionamento."
#!{
	key[]: "aca_msg_book1_3_12_cutscene10"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_12_cutscene11"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_12_cutscene12"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_12_cutscene13"
	val[]: "Unused"
#!}
#### 3_12 Driving Instructions

	key[]: "aca_msg_book1_3_12_start"
	val[]: "À sua frente há uma área representando o lote de uma empresa de transporte. Sua tarefa é entrar e virar o caminhão para voltar a sair. Certifique-se de fazer bom uso do espaço ao seu redor.<br><br><font face=/font/big_bold.font>Prepare-se para partir</font>"

	key[]: "aca_msg_book1_3_12_forward"
	val[]: "<font face=/font/big_bold.font>Siga pelo beco.</font>"

	key[]: "aca_msg_book1_3_12_check1"
	val[]: "Logo depois do prédio à esquerda, há outro beco onde você deve dar marcha à ré. Prepare-se com isso em mente.<br><br><font face=/font/big_bold.font>Continue em direção às barreiras. </font>"



	key[]: "aca_msg_book1_3_12_check3"
	val[]: "Dê ré e vire o reboque em direção ao beco, cuidando que o cavalo mecânico não atinja nada do lado direito. <br><br><font face=/font/big_bold.font>Comece a dar ré e entre com o reboque no beco. Pare na área indicada.</font>"

	key[]: "aca_msg_book1_3_12_check4"
	val[]: "Agora você pode prosseguir para fora da área na mesma direção de onde veio. Faça bom uso do espaço disponível.<br><br><font face=/font/big_bold.font>Siga adiante e vire à direita.</font>"


	key[]: "aca_msg_book1_3_12_check6"
	val[]: "Continue pelo beco em direção à área indicada."
#!{
	key[]: "aca_msg_book1_3_12_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_12_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_12_check5"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_12_check2"
	val[]: "Unused"
#!}

#@}

#+ Book 1 Scenario 3_13
