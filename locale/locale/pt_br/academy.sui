#### 3_13 msg - intro text

	key[]: "aca_msg_book1_3_13_cutscene01"
	val[]: "Neste cenário, sua tarefa será estacionar na vaga ao seu lado. Não há muito espaço para manobrar, então você terá trabalho extra para posicionar o reboque onde quer."

	key[]: "aca_msg_book1_3_13_cutscene02"
	val[]: "Dirija em direção à barreira."

	key[]: "aca_msg_book1_3_13_cutscene03"
	val[]: "Pare antes da barreira."

	key[]: "aca_msg_book1_3_13_cutscene04"
	val[]: "Gire o volante energicamente para o lado do motorista antes de se mover. Dessa forma, você começará a virar o reboque em direção ao local de estacionamento assim que começar a dar ré, economizando espaço valioso."

	key[]: "aca_msg_book1_3_13_cutscene05"
	val[]: "Após apontar o reboque para onde você quer, alinhe o cavalo mecânico na frente do reboque e comece a entrar na vaga."

	key[]: "aca_msg_book1_3_13_cutscene06"
	val[]: "Deste ponto em diante, não é muito diferente de uma manobra de estacionamento normal."

	key[]: "aca_msg_book1_3_13_cutscene07"
	val[]: "Continue dando marcha à ré e observe ambos os lados. Mantenha o cavalo mecânico e o reboque alinhados com a vaga de estacionamento."

	key[]: "aca_msg_book1_3_13_cutscene08"
	val[]: "Pare na área indicada, acione o freio de estacionamento e desligue o motor."


#### 3_13 Driving Instructions

	key[]: "aca_msg_book1_3_13_start"
	val[]: "Você está em uma vaga de estacionamento, mas há uma segunda vaga à sua direita para a qual você deve se deslocar.<br><br><font face=/font/big_bold.font>Prepare-se para partir.</font>"

	key[]: "aca_msg_book1_3_13_forward"
	val[]: "Há uma área marcada à sua frente.<br><br><font face=/font/big_bold.font>Avance.</font>"
#!{
	key[]: "aca_msg_book1_3_13_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

	key[]: "aca_msg_book1_3_13_check2"
	val[]: "Não se esqueça de virar o volante imediatamente, pois o espaço é limitado.<br><br><font face=/font/big_bold.font>Dê marcha à ré no local indicado atrás de você. </font>"


#@}

#+ Book 1 Scenario 3_15
#@{

#### 3_15 common
	key[]: "aca_scenario_book1_3_15_title"
	val[]: "Manobras de alça de jarro e curva de ângulo fechada"

	key[]: "aca_scenario_book1_3_15_desc"
	val[]: "Neste cenário, você fará um breve passeio em um curso de treinamento que o ajudará a aprender a manobrar o reboque em curvas fechadas com a ajuda de dois procedimentos diferentes de curvas."

#### 3_15 goal
#!{
	key[]: "aca_goal_book1_3_15_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_15_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_15_check6"
	val[]: "@@aca_goal_book1_3_11_check6@@"

	key[]: "aca_goal_book1_3_15_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_15_end"
