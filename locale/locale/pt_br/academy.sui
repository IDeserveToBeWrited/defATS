#+ Book 3 Scenario Truckstop Angle
#@{

#### trckstp common

	key[]: "aca_scenario_book3_trckstp_title"
	val[]: "Estacionando em uma curva"

	key[]: "aca_scenario_book3_trckstp_desc"
	val[]: "Neste cenário, você deve navegar por um pátio cheio de caminhões mal posicionados para estacionar em uma curva."

#### trckstp goal

#!{
	key[]: "aca_goal_book3_trckstp_check1"
	val[]: "@@aca_goal_book3_sup_check1@@"

	key[]: "aca_goal_book3_trckstp_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_trckstp_end"
	val[]: "@@aca_goal_book3_sup_end@@"

	key[]: "aca_goal_book3_trckstp_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_trckstp_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
#### trckstp msg - intro text

	key[]: "aca_msg_book3_trckstp_cutscene1"
	val[]: "Não é incomum chegar a um estacionamento quase totalmente cheio de caminhões, deixando você com poucas opções de estacionamento."

	key[]: "aca_msg_book3_trckstp_cutscene2"
	val[]: "Neste caso, resta apenas um lugar onde seu conjunto de reboques duplos cabe. <br><br>Siga pelo estacionamento e estacione na curva próxima à saída."

#### trckstp Driving Instructions

#!{
	key[]: "aca_msg_book3_trckstp_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_trckstp_forward"
	val[]: "Siga pelo estacionamento e estacione ao longo da curva. <br><br>Continue quando puder."

	key[]: "aca_msg_book3_trckstp_check1"
	val[]: "Você não vai caber na curva aqui. Vai ter que dar marcha à ré e achar outro caminho."

	key[]: "aca_msg_book3_trckstp_check2"
	val[]: "Estacione na curva à frente."

	key[]: "aca_msg_book3_trckstp_stop"
	val[]: "Pare na área indicada."

	key[]: "aca_msg_book3_trckstp_end"
	val[]: "Estacione o caminhão de forma segura e desligue o motor."

#@}


#+ Book 3 Scenario finex
#@{

#### finex common

	key[]: "aca_scenario_book3_finex_title"
	val[]: "Teste final"

	key[]: "aca_scenario_book3_finex_desc"
	val[]: "Neste cenário, você colocará suas novas habilidades à prova em um percurso projetado para testar sua precisão e compreensão de como dirigir com reboques duplos."

#### finex goal

	key[]: "aca_goal_book3_finex_check0"
	val[]: "Dando marcha à ré"

	key[]: "aca_goal_book3_finex_check1"
	val[]: "Entrando no circuito"

	key[]: "aca_goal_book3_finex_check2"
	val[]: "Acelerando"

	key[]: "aca_goal_book3_finex_check22"
	val[]: "Prepare-se para frear"

	key[]: "aca_goal_book3_finex_speed"
	val[]: "Velocidade insuficiente"

#!{
	key[]: "aca_goal_book3_finex_check4"
	val[]: "@@aca_goal_book3_sup_check1@@"
#!}
	key[]: "aca_goal_book3_finex_check5"
	val[]: "Estacionando"

#!{
	key[]: "aca_goal_book3_finex_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_finex_end"
	val[]: "@@aca_goal_book3_sup_end@@"

	key[]: "aca_goal_book3_finex_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_finex_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
#### finex msg - intro text

	key[]: "aca_msg_book3_finex_cutscene1"
	val[]: "Nossas boas-vindas ao exame final. Preparamos algumas situações realistas que você pode encontrar na estrada para avaliar como você as encara. Como sempre, vá com calma e dirija com precisão. <br><br>Boa sorte!"

#### finex Driving Instructions

	key[]: "aca_msg_book3_finex_check0"
	val[]: "O caminho à frente está bloqueado, faça um retorno no espaço disponível."

	key[]: "aca_msg_book3_finex_check1"
	val[]: "Continue em direção ao centro da cidade."

	key[]: "aca_msg_book3_finex_check2"
	val[]: "Alcance uma velocidade de pelo menos 37 mph (60 km/h) enquanto se desloca para o centro da cidade."

	key[]: "aca_msg_book3_finex_check22"
	val[]: "Prepare-se para frear."

	key[]: "aca_msg_book3_finex_speed"
	val[]: "Você não conseguiu atingir a velocidade de 37 mph (60 km/h)"

	key[]: "aca_msg_book3_finex_check4"
	val[]: "Continue dirigindo através do circuito."

	key[]: "aca_msg_book3_finex_check5"
	val[]: "Há uma vaga de estacionamento para você na fileira de caminhões à esquerda. Dê marcha à ré e estacione."

#!{
	key[]: "aca_msg_book3_finex_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_finex_forward"
	val[]: "Siga adiante quando puder."

#!{
	key[]: "aca_msg_book3_finex_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_finex_end"
	val[]: "@@aca_msg_book3_sup_end@@"
