#+ Book 1 Scenario 3_10
#@{

#### 3_10 common
	key[]: "aca_scenario_book1_3_10_title"
	val[]: "Ré pelo lado cego"

	key[]: "aca_scenario_book1_3_10_desc"
	val[]: "Neste cenário, vamos entrar de ré em uma vaga olhando pelo \"lado cego\". Sem a capacidade de olhar pela janela para ver para onde está indo, você terá que confiar apenas nos espelhos retrovisores."

#### 3_10 goal
#!{
	key[]: "aca_goal_book1_3_10_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_10_forward"
