	key[]: "aca_goal_book1_3_11_check1"
	val[]: "Entrando na rotatória"

	key[]: "aca_goal_book1_3_11_check2"
	val[]: "Dirigindo pela rotatória"

	key[]: "aca_goal_book1_3_11_check3"
	val[]: "Dirigindo pela rotatória"

	key[]: "aca_goal_book1_3_11_check5"
	val[]: "Saindo da rotatória"

	key[]: "aca_goal_book1_3_11_check6"
	val[]: "Dirigindo para a área indicada"

#### 3_11 msg - intro text

	key[]: "aca_msg_book1_3_11_cutscene1"
	val[]: "As rotatórias estão se tornando mais comuns nos Estados Unidos, por isso é importante saber como contorná-las."

	key[]: "aca_msg_book1_3_11_cutscene3"
	val[]: "Fique na parte de fora da sua faixa ao se aproximar da rotatória. Isso vai ajudar o reboque a passar pelo lado de dentro da curva inicial."

	key[]: "aca_msg_book1_3_11_cutscene4"
	val[]: "Dirija em direção a rotatória. Uma vez lá dentro, você terá de ir em direção à parte de fora. Isso é para manter seu reboque a uma distância segura do centro da rotatória."

	key[]: "aca_msg_book1_3_11_cutscene5"
	val[]: "Fique de olho no retrovisor para garantir que o reboque não esteja chegando muito perto das guias internas."

	key[]: "aca_msg_book1_3_11_cutscene6"
	val[]: "Sair da rotatória é bem fácil, já que seu reboque está numa boa posição. Dirija até a saída e o reboque deve seguir sem percalços."

	key[]: "aca_msg_book1_3_11_cutscene7"
	val[]: "Estacione o caminhão na área indicada e acione o freio de estacionamento."



#### 3_11 Driving Instructions
#!{
	key[]: "aca_msg_book1_3_11_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

	key[]: "aca_msg_book1_3_11_forward"
	val[]: "À sua frente, há uma rotatória preparada para você dirigir.<br><br><font face=/font/big_bold.font> Aproxime-se lentamente da rotatória. </font>"

	key[]: "aca_msg_book1_3_11_check1"
	val[]: "Faça uma curva aberta ao entrar na rotatória para que seu reboque entre atrás de você sem problemas.<br><br><font face=/font/big_bold.font> Entre na rotatória. </font>"

	key[]: "aca_msg_book1_3_11_check2"
	val[]: "Dirija em direção à parte de fora da rotatória. Você vai precisar manter o caminhão o mais longe possível do centro da rotatória para que o reboque não atinja as barreiras centrais. <br><br><font face=/font/big_bold.font>Continue pela rotatória.</font>"

	key[]: "aca_msg_book1_3_11_check3"
	val[]: "Fique perto dos cones externos. <br><br><font face=/font/big_bold.font>Continue dirigindo.</font>"

	key[]: "aca_msg_book1_3_11_check5"
	val[]: "<font face=/font/big_bold.font>Saia da rotatória.</font>"

	key[]: "aca_msg_book1_3_11_check6"
	val[]: "<font face=/font/big_bold.font>Siga para a vaga à frente.</font>"

	key[]: "aca_msg_book1_3_11_stop"
	val[]: "<font face=/font/big_bold.font>Pare na área indicada.</font>"

	key[]: "aca_msg_book1_3_11_end"
	val[]: "<font face=/font/big_bold.font>Acione o freio de estacionamento e desligue o motor.</font>"
#@}

