#### 3_05 common
	key[]: "aca_scenario_book1_3_05_title"
	val[]: "Ré com um reboque"

	key[]: "aca_scenario_book1_3_05_desc"
	val[]: "Neste cenário, você vai dar ré com um reboque pela primeira vez. É uma manobra bem simples, mas você ainda vai precisar virar o volante com precisão para colocar o reboque na posição correta."

	#### 3_05 goal



	key[]: "aca_goal_book1_3_05_check_con"
	val[]: "Dando ré em direção ao reboque"

	key[]: "aca_goal_book1_3_05_connect"
	val[]: "Engatando o reboque"

	key[]: "aca_goal_book1_3_05_park_br_off"
	val[]: "Liberando o freio de estacionamento"

	key[]: "aca_goal_book1_3_05_b_trailer"
	val[]: "Alinhando com a área de estacionamento"

	key[]: "aca_goal_book1_3_05_check1"
	val[]: "Marcha ré em direção a área de estacionamento"

	key[]: "aca_goal_book1_3_05_check2"
	val[]: "Alinhando com a área de estacionamento"
