	key[]: "aca_msg_book1_3_15_cutscene02_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/jug_handle.mat bottom=p256 right=p256 color=FFFFFFFF></align><offset vshift=256>"

	key[]: "aca_msg_book1_3_15_cutscene07_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/button_hook.mat bottom=p256 right=p256 color=FFFFFFFF></align><offset vshift=256>"

#!}


#### 3_15 Driving Instructions

	key[]: "aca_msg_book1_3_15_forward"
	val[]: "Lembre-se de usar todo o espaço disponível para ajudá-lo a contornar cada curva.<br><br><font face=/font/big_bold.font>Saia e siga as marcações da estrada à esquerda.</font>"

	key[]: "aca_msg_book1_3_15_check1"
	val[]: "Use todo o espaço disponível para girar amplamente e manter o reboque longe do meio-fio.<br><br><font face=/font/big_bold.font>Faça uma manobra de alça de jarro.</font>"

	key[]: "aca_msg_book1_3_15_check2"
	val[]: "Mantenha-se em direção ao centro da estrada ao redor da curva e depois siga em frente em direção à próxima curva.<br><br><font face=/font/big_bold.font>Continue dirigindo.</font>"

	key[]: "aca_msg_book1_3_15_check3"
	val[]: "Há espaço limitado à esquerda, então você deve dirigir bem para dentro do cruzamento para que o reboque não suba na guia.<br><br><font face=/font/big_bold.font>Faça uma de ângulo fechado.</font>"

	key[]: "aca_msg_book1_3_15_check4"
	val[]: "Siga até a próxima curva e contorne-a.<br><br><font face=/font/big_bold.font>Continue dirigindo.</font>"

	key[]: "aca_msg_book1_3_15_check5"
	val[]: "Esta curva é a mais fechada até agora, e nenhuma manobra por si só será suficiente.<br><br><font face=/font/big_bold.font>Faça a curva, mantendo-se o mais aberta possível.</font>"

	key[]: "aca_msg_book1_3_15_check6"
	val[]: "<font face=/font/big_bold.font>Siga para o local de estacionamento à frente e à direita.</font>"
#!{
	key[]: "aca_msg_book1_3_15_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_15_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_15_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}


#@}

#+ Book 1 Scenario 3_16
#@{

#### 3_16 common
	key[]: "aca_scenario_book1_3_16_title"
	val[]: "Estacionando na diagonal de ré"

	key[]: "aca_scenario_book1_3_16_desc"
	val[]: "Neste cenário, vamos explorar o estacionamento na diagonal de ré. Isso pode ocorrer em áreas de descanso, paradas de caminhões e até mesmo em locais de embarque. Muitas vezes, há pouco espaço porque os estacionamentos estão lotados de caminhões, dificultando ainda mais as coisas devido à falta de espaço."

#### 3_16 goal

	key[]: "aca_goal_book1_3_16_check1"
	val[]: "Manobrando o reboque"
#!{
	key[]: "aca_goal_book1_3_16_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_16_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_16_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_16_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
 #!}
#### 3_16 msg - intro text

	key[]: "aca_msg_book1_3_16_cutscene1"
	val[]: "Estacionar na diagonal parece mais fácil à primeira vista, mas muitas vezes pode ser mais desafiador do que as típicas manobras na doca."

	key[]: "aca_msg_book1_3_16_cutscene2"
	val[]: "Dê marcha à ré em direção à vaga. Mantenha o cavalo mecânico e o reboque alinhados por enquanto."

	key[]: "aca_msg_book1_3_16_cutscene3"
	val[]: "Conforme você se aproxima, deixe seu reboque mais perto dos caminhões estacionados. Isso vai ajudar a virá-lo para a vaga."

	key[]: "aca_msg_book1_3_16_cutscene4"
	val[]: "Comece a virar o reboque em direção à vaga de estacionamento. Mantenha o reboque próximo ao caminhão do lado do motorista, pois você precisará de espaço do outro lado."

	key[]: "aca_msg_book1_3_16_cutscene5"
	val[]: "Quando o reboque estiver na vaga de estacionamento, comece a alinhar o cavalo mecânico com ele."

	key[]: "aca_msg_book1_3_16_cutscene6"
	val[]: "Estacione na área indicada, acione o freio de estacionamento e desligue o motor."

#### 3_16 Driving Instructions

	key[]: "aca_msg_book1_3_16_start"
	val[]: "Estacione o caminhão no espaço atrás de você. Use ambos os retrovisores para manobrar enquanto dá ré.<br><br><font face=/font/big_bold.font>Prepare-se para partir. </font>"

	key[]: "aca_msg_book1_3_16_backward"
	val[]: "Verifique o ambiente ao seu redor e siga em direção ao local de estacionamento.<br><br><font face=/font/big_bold.font>Comece a dar marcha à ré.</font>"

	key[]: "aca_msg_book1_3_16_check1"
	val[]: "Comece a mover o reboque em direção aos caminhões ao seu lado. Quando puder, vire o reboque em direção à vaga de estacionamento. Lembre-se de considerar o espaço necessário para a traseira do reboque.<br><br><font face=/font/big_bold.font>Vire para a vaga de estacionamento.</font>"
#!{
	key[]: "aca_msg_book1_3_16_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_16_end"
	val[]: "@@aca_msg_book1_2_01_end@@"


 #!}


#@}

#+ Book 1 Scenario 3_17
#@{

#### 3_17 common
	key[]: "aca_scenario_book1_3_17_title"
	val[]: "Dirigindo em marcha à ré com curva"

	key[]: "aca_scenario_book1_3_17_desc"
	val[]: "Neste cenário, daremos ré com um reboque em uma curva pela primeira vez. Vamos explorar os princípios básicos da manobra em ré e o que observar ao fazer uma curva dando ré."

#### 3_17 goal

	key[]: "aca_goal_book1_3_17_check1"
	val[]: "Manobrando o reboque"
#!{
	key[]: "aca_goal_book1_3_17_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_17_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_17_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_17_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
 #!}
#### 3_17 msg - intro text

	key[]: "aca_msg_book1_3_17_cutscene01"
	val[]: "Neste cenário, você vai dar ré até a vaga atrás de você, no lado do motorista."

	key[]: "aca_msg_book1_3_17_cutscene02"
	val[]: "Há algumas dicas importantes para lembrar que vão ajudar bastante ao dar ré com reboques. <br>A primeira é que o reboque sempre vira para o lado oposto ao que você gira o volante."

	key[]: "aca_msg_book1_3_17_cutscene03"
	val[]: "A segunda é que você pode ter uma boa noção de para onde o reboque está indo observando os eixos do caminhão e do reboque."

	key[]: "aca_msg_book1_3_17_cutscene04"
	val[]: "Terceiro, pequenos ajustes levarão você aonde precisa, sem necessidade de exagerar nos movimentos."

	key[]: "aca_msg_book1_3_17_cutscene05"
	val[]: "Comece a virar o cavalo mecânico levemente para longe da vaga, e o reboque começará a se alinhar com ele."

	key[]: "aca_msg_book1_3_17_cutscene06"
	val[]: "Alinhe-se com o reboque, fazendo ajustes para manter o conjunto no caminho certo."

	key[]: "aca_msg_book1_3_17_cutscene07"
	val[]: "Observe as rodas do seu reboque e a roda traseira do cavalo mecânico. Elas mostram para onde o reboque está apontado e para onde o caminhão o está levando."

	key[]: "aca_msg_book1_3_17_cutscene08"
	val[]: "Quarta dica, sempre é mais fácil virar o reboque de forma mais fechada do que tentar endireitá-lo após um entesouramento. Primeiro, aponte para a parte externa da vaga e, conforme se aproximar, ajuste a curva para alinhar melhor o reboque."

	key[]: "aca_msg_book1_3_17_cutscene09"
	val[]: "Conforme o reboque entra no local de estacionamento, coloque o cavalo mecânico alinhado com o reboque. Tente evitar muitos ajustes dentro do local."

	key[]: "aca_msg_book1_3_17_cutscene10"
	val[]: "Dê marcha à ré entre as barreiras e verifique ambos os lados conforme faz isso."

	key[]: "aca_msg_book1_3_17_cutscene11"
	val[]: "Acione o freio de estacionamento e desligue o motor."

#### 3_17 Driving Instructions

	key[]: "aca_msg_book1_3_17_start"
	val[]: "Lembre-se destas dicas ao dar ré em uma curva com um reboque:<br><br>— O reboque vira na direção oposta à que você dirige o cavalo mecânico<br><br>— Observe as rodas do reboque para ver para onde ele está apontando<br><br>— Observe a roda traseira do cavalo mecânico para ver para onde ele está empurrando o reboque<br><br>— Deixe o reboque fazer o trabalho, não o vire demais<br><br>— É sempre mais fácil fazer uma curva mais fechada do que endireitá-lo<br><br><font face=/font/big_bold.font>Prepare-se para partir. </font>"

	key[]: "aca_msg_book1_3_17_backward"
	val[]: "Olhe para trás para encontrar onde precisa ir. Sempre verifique o ambiente ao redor antes de começar a dar marcha à ré.<br><br><font face=/font/big_bold.font>Comece a dar marcha à ré em direção à vaga de estacionamento.</font>"

	key[]: "aca_msg_book1_3_17_check1"
	val[]: "<font face=/font/big_bold.font>Comece a manobrar o reboque em direção à vaga e o siga.</font>"

	key[]: "aca_msg_book1_3_17_stop"
	val[]: "<font face=/font/big_bold.font>Pare na área indicada.</font>"
#!{
	key[]: "aca_msg_book1_3_17_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_18
#@{

#### 3_18 common
	key[]: "aca_scenario_book1_3_18_title"
	val[]: "Manobra de estacionamento em beco"

	key[]: "aca_scenario_book1_3_18_desc"
	val[]: "Neste cenário, você terá a tarefa de dar ré com o reboque em um beco próximo a uma pequena estrada."

#### 3_18 goal

	key[]: "aca_goal_book1_3_18_check1"
	val[]: "Manobrando o reboque"
#!{
	key[]: "aca_goal_book1_3_18_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_18_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


	key[]: "aca_goal_book1_3_18_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_18_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

 #!}
#### 3_18 msg - intro text

	key[]: "aca_msg_book1_3_18_cutscene01"
	val[]: "Estacionar aqui requer uma \"manobra na doca\".<br>Esta é uma manobra típica para caminhoneiros, já que eles enfrentarão esse tipo de situação de estacionamento quase diariamente em suas carreiras, seja para carregar ou descarregar um reboque, ou para estacionar à noite em um ponto de parada."

	key[]: "aca_msg_book1_3_18_cutscene02"
	val[]: "Esta é uma manobra semelhante ao cenário anterior, mas você terá menos espaço para trabalhar, então precisará planejar seus movimentos adequadamente e tomar cuidado para não bater em nada."

	key[]: "aca_msg_book1_3_18_cutscene03"
	val[]: "Como há menos espaço, você deverá redobrar a atenção. Manobre o reboque no momento certo e observe as rodas do cavalo mecânico e do reboque para ver para onde ele vai. Cuidado com o deslocamento da traseira do reboque e evite o entesouramento - continue manobrando o reboque."

	key[]: "aca_msg_book1_3_18_cutscene04"
	val[]: "Tente avançar o reboque mais para dentro do beco. Isso lhe dará espaço do outro lado para girar a frente do reboque e colocar o cavalo mecânico alinhado com ele."

	key[]: "aca_msg_book1_3_18_cutscene05"
	val[]: "Assim que seu reboque estiver no beco, alinhe o cavalo mecânico com ele. É melhor fazer isso um pouco antes de seguir até ao final. Você sempre pode corrigir isso como sua ré até sua posição final."

	key[]: "aca_msg_book1_3_18_cutscene06"
	val[]: "Coloque o cavalo mecânico e o reboque em linha reta e pare na área indicada."

	key[]: "aca_msg_book1_3_18_cutscene07"
	val[]: "Acione o freio de estacionamento e desligue o motor."


#### 3_18 Driving Instructions

	key[]: "aca_msg_book1_3_18_start"
	val[]: "Agora vamos tentar fazer uma \"manobra na doca\" em uma área muito menor. <br><br><font face=/font/big_bold.font>Prepare-se para começar. </font>"

	key[]: "aca_msg_book1_3_18_backward"
	val[]: "Verifique os arredores e procure a vaga de estacionamento atrás de você. <br><br><font face=/font/big_bold.font>Comece a dar marcha à ré em direção à vaga. </font>"

	key[]: "aca_msg_book1_3_18_check1"
	val[]: "<font face=/font/big_bold.font>Coloque o reboque na vaga.</font>"
#!{
	key[]: "aca_msg_book1_3_18_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_18_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}


#@}

#+ Book 1 Scenario 3_19
#@{

#### 3_19 common
	key[]: "aca_scenario_book1_3_19_title"
	val[]: "Exame final (parte 1)"

	key[]: "aca_scenario_book1_3_19_desc"
	val[]: "O exame final está à sua espera, onde todas as habilidades que você aprendeu nos cenários anteriores serão colocadas à prova. Vamos dirigir por todo o centro de treinamento para ver se você aprendeu a lidar com as situações que encontrou até agora.<br><br>Após ter completado todas as seções e manobras, você estará mais perto de se considerar um caminhoneiro habilidoso!"

