#### 2_06 msg - intro text

	key[]: "aca_msg_book1_2_06_cutscene01"
	val[]: "Para o cenário final deste capítulo, vamos dirigir na configuração complexa da pista de testes."

	key[]: "aca_msg_book1_2_06_cutscene02"
	val[]: "O primeiro desafio é um slalom através de algumas barreiras. Não se esqueça de usar os retrovisores."

	key[]: "aca_msg_book1_2_06_cutscene04"
	val[]: "A seguir, um grampo. Abra bem a curva e você não terá problema."

	key[]: "aca_msg_book1_2_06_cutscene05"
	val[]: "O caminho à frente estreita-se significativamente. Prossiga com cautela e use o espelho retrovisor lateral para auxiliar."

	key[]: "aca_msg_book1_2_06_cutscene06"
	val[]: "A seguir há uma série de curvas fáceis de 90 graus."

	key[]: "aca_msg_book1_2_06_cutscene08"
	val[]: "O próximo desafio é em marcha à ré. Aproxime-se das barreiras à sua frente com isso em mente."

	key[]: "aca_msg_book1_2_06_cutscene09"
	val[]: "Siga as marcações na estrada para voltar e contornar as curvas."

	key[]: "aca_msg_book1_2_06_cutscene10"
	val[]: "Dê marcha à ré em direção às barreiras, pare e siga em frente para a direita."

	key[]: "aca_msg_book1_2_06_cutscene11"
	val[]: "Esta passagem pelos cones é muito estreita. Dirija devagar e use os retrovisores para se orientar."

	key[]: "aca_msg_book1_2_06_cutscene13"
	val[]: "À frente, há uma série de curvas alternadas de 90 graus para a esquerda e para a direita."

	key[]: "aca_msg_book1_2_06_cutscene15"
	val[]: "Você pode cruzar com trens nesta passagem de nível. Se sim, pare e aguarde. Depois, você pode virar à direita na estrada paralela."

	key[]: "aca_msg_book1_2_06_cutscene16"
	val[]: "Vire à esquerda na estrada principal. Você pode ganhar velocidade após completar sua curva."

	key[]: "aca_msg_book1_2_06_cutscene18"
	val[]: "Há mais algumas curvas à esquerda na cidade e você chegará ao seu destino!"

	key[]: "aca_msg_book1_2_06_cutscene19"
	val[]: "Aproxime-se das barreiras à frente e prepare-se para estacionar na vaga à direita."

	key[]: "aca_msg_book1_2_06_cutscene20"
	val[]: "Dê ré na vaga de estacionamento, depois estacione o caminhão com segurança e desligue o motor."

#### 2_06 Driving Instructions



	key[]: "aca_msg_book1_2_06_forward"
	val[]: "À sua frente, há um slalom feito de barreiras.<br><br><font face=/font/big_bold.font>Passe pelo slalom.</font>"

	key[]: "aca_msg_book1_2_06_forward2"
	val[]: "<font face=/font/big_bold.font>Siga o caminho contornando a curva fechada.</font>"

	key[]: "aca_msg_book1_2_06_check1"
	val[]: "O caminho à frente estreita significativamente. Você pode usar seu espelho retrovisor lateral para ajudar a se orientar.<br><br><font face=/font/big_bold.font>Prossiga com cautela.</font>"

	key[]: "aca_msg_book1_2_06_check2"
	val[]: "Depois da curva, haverá outra de 90 graus.<br><br><font face=/font/big_bold.font>Ajuste sua velocidade adequadamente.</font>"

	key[]: "aca_msg_book1_2_06_check3"
	val[]: "À frente, há mais algumas curvas fáceis. Continue ajustando sua velocidade conforme necessário.<br><br><font face=/font/big_bold.font>Continue dirigindo.</font>"

	key[]: "aca_msg_book1_2_06_check4"
	val[]: "O desafio a seguir deve ser realizado em marcha à ré. Pare nas barreiras à frente para poder entrar de ré à direita.<br><br><font face=/font/big_bold.font>Pare nas barreiras.</font>"

	key[]: "aca_msg_book1_2_06_check5"
	val[]: "Dê marcha à ré em direção à área atrás e à direita de sua posição.<br><br><font face=/font/big_bold.font>Comece a dar marcha à ré. </font>"

	key[]: "aca_msg_book1_2_06_reverse"
	val[]: "Siga o caminho contornando as curvas.<br><br><font face=/font/big_bold.font>Continue dando marcha à ré.</font>"

	key[]: "aca_msg_book1_2_06_check6"
	val[]: "Atrás de você, à esquerda, há algumas barreiras. <br><br><font face=/font/big_bold.font>Vire em direção às barreiras e prepare-se para parar.</font>"

	key[]: "aca_msg_book1_2_06_check7"
	val[]: "Pare e mude de marcha para continuar a frente e depois para a direita.<br><br><font face=/font/big_bold.font>Dirija para a frente.</font>"

	key[]: "aca_msg_book1_2_06_check8"
	val[]: "À sua frente, há uma passagem estreita e sinuosa através de alguns cones. Dirija com cuidado e use os retrovisores se necessário.<br><br><font face=/font/big_bold.font>Passe pelos cones. </font>"

	key[]: "aca_msg_book1_2_06_check9"
	val[]: "A seguir, há uma combinação de diferentes curvas de 90 graus. Certifique-se de abordar cada curva com uma distância segura.<br><br><font face=/font/big_bold.font>Continue dirigindo.</font>"

	key[]: "aca_msg_book1_2_06_check10"
	val[]: "Observe a passagem de nível conforme você se aproxima dela. Os sinais podem ser acionados para indicar um trem se aproximando.<br><br><font face=/font/big_bold.font>Prossiga com cautela.</font>"

	key[]: "aca_msg_book1_2_06_check11"
	val[]: "A curva para a estrada paralela está parcialmente bloqueada por um obstáculo, então mantenha-se à esquerda ao se aproximar para ter mais espaço.<br><br><font face=/font/big_bold.font>Faça a curva. </font>"

	key[]: "aca_msg_book1_2_06_check12"
	val[]: "Você pode obedecer ou ignorar a placa de parada. A área foi fechada para nosso uso.<br><br><font face=/font/big_bold.font>Vire à esquerda.</font>"

	key[]: "aca_msg_book1_2_06_check13"
	val[]: "Você pode ganhar velocidade aqui, mas precisará virar no próximo cruzamento.<br><br><font face=/font/big_bold.font>Continue pelo percurso. </font>"

	key[]: "aca_msg_book1_2_06_check14"
	val[]: "Entre na cidade com uma curva à esquerda, seguida por mais duas curvas à esquerda até a área final.<br><br><font face=/font/big_bold.font>Dirija pela cidade.</font>"

	key[]: "aca_msg_book1_2_06_check15"
	val[]: "Do outro lado do estacionamento, há algumas barreiras. Dirija até elas. <br><br><font face=/font/big_bold.font>Pare perto das barreiras. </font>"

	key[]: "aca_msg_book1_2_06_check16"
	val[]: "Atrás de você e à direita, há uma vaga de estacionamento.<br><br><font face=/font/big_bold.font>Entre de ré na vaga de estacionamento.</font>"
#!{
	key[]: "aca_msg_book1_2_06_check17"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_06_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_2_06_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

#@}

#+ Book 1 Scenario 2_08
#@{

#### 2_08 common
	key[]: "aca_scenario_book1_2_08_title"
	val[]: "Curso de formação simples"

	key[]: "aca_scenario_book1_2_08_desc"
	val[]: "Neste cenário, vamos colocar em prática as habilidades que você aprendeu até agora em uma viagem fácil por um curso de treinamento simples."

#### 2_08 goal
#!{
	key[]: "aca_goal_book1_2_08_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_08_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

