	key[]: "aca_goal_book1_3_03_check1"
	val[]: "Primeira curva"

	key[]: "aca_goal_book1_3_03_check2"
	val[]: "Rotatória"

	key[]: "aca_goal_book1_3_03_check3"
	val[]: "Curva de 90 graus"

	key[]: "aca_goal_book1_3_03_check4"
	val[]: "Manobra em alça"

	key[]: "aca_goal_book1_3_03_check5"
	val[]: "Curva em gancho"

	key[]: "aca_goal_book1_3_03_check6"
	val[]: "Curva fechada"


#### generic phrase

	key[]: "aca_goal_book1_3_03_chk_point"
	val[]: "Contornando as barreiras"

#### 3_03 msg - intro text

	key[]: "aca_msg_book1_3_03_cutscene01"
	val[]: "À frente, há uma variedade de curvas e obstáculos complexos.<br>Considere tudo o que você aprendeu até agora e não deverá ser muito difícil."

	key[]: "aca_msg_book1_3_03_cutscene02"
	val[]: "A primeira conversão é uma simples curva de ângulo fechado. Fique tranquilo, isso não deve ser um problema."

	key[]: "aca_msg_book1_3_03_cutscene03"
	val[]: "Continue em direção à rotatória."

	key[]: "aca_msg_book1_3_03_cutscene04"
	val[]: "Mantenha o reboque longe do interior da rotatória, dirigindo o cavalo mecânico o mais longe possível dela."

	key[]: "aca_msg_book1_3_03_cutscene05"
	val[]: "A curva de 90 graus para a esquerda não é particularmente fechada, mas tome cuidado para não bater em nenhum cone."

	key[]: "aca_msg_book1_3_03_cutscene06"
	val[]: "Esta curva é significativamente mais fechada. Use uma manobra de alça de jarro para completá-la."

	key[]: "aca_msg_book1_3_03_cutscene07"
	val[]: "Você pode usar uma manobra de curva de ângulo fechado nesta conversão, mas há alguns obstáculos extras a serem evitados."

	key[]: "aca_msg_book1_3_03_cutscene09"
	val[]: "Mais uma vez, a curva final é muito fechada e exigirá uma combinação de manobras com alça de jarro e de ângulo fechado para ser concluída."

	key[]: "aca_msg_book1_3_03_cutscene10"
	val[]: "Estacione na área indicada, acione o freio de estacionamento e desligue o motor."


#### 3_03 Driving Instructions



	key[]: "aca_msg_book1_3_03_forward"
	val[]: "<font face=/font/big_bold.font>Prossiga para a primeira curva.</font>"

	key[]: "aca_msg_book1_3_03_check1"
	val[]: "A primeira conversão é uma curva de ângulo fechado fácil.<br><br><font face=/font/big_bold.font><color value=@@clr_txt@@>Prossiga com a curva. </font>"

	key[]: "aca_msg_book1_3_03_check2"
	val[]: "Continue até a rotatória. Lembre-se de pegar um caminho largo ao redor dela.<br><br><font face=/font/big_bold.font>Dirija até e ao redor da rotatória.</font>"

	key[]: "aca_msg_book1_3_03_check3"
	val[]: "Esta curva de 90 graus é um pouco mais fechada, tome cuidado para não bater em nenhum cone.<br><br><font face=/font/big_bold.font>Faça a curva.</font>"

	key[]: "aca_msg_book1_3_03_check4"
	val[]: "Esta curva é melhor abordada com um procedimento de alça de jarro. Faça uma curva aberta antes de entrar no cruzamento.<br><br><font face=/font/big_bold.font>Faça uma curva de alça de jarro.</font>"

	key[]: "aca_msg_book1_3_03_check5"
	val[]: "Esta curva está repleta de vários obstáculos diferentes, mas pode ser feita com uma manobra de ângulo fechado.<br><br><font face=/font/big_bold.font>Prossiga com cuidado. </font>"

	key[]: "aca_msg_book1_3_03_check6"
	val[]: "Esta curva é a mais fechada até agora, faça-a como achar melhor.<br><br><font face=/font/big_bold.font>Faça a conversão no estacionamento.</font>"
