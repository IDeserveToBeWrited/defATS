	key[]: "aca_scenario_book1_3_03_title"
	val[]: "Dirigindo pelo percurso da cidade"

	key[]: "aca_scenario_book1_3_03_desc"
	val[]: "Neste cenário, exploraremos a manobra do reboque em uma pista curta com obstáculos, mas complexa."

