	key[]: "aca_scenario_book3_lucky_title"
	val[]: "Fuga da parada de caminhões: dobrar a aposta"

	key[]: "aca_scenario_book3_lucky_desc"
	val[]: "Neste cenário, você deve escapar não apenas de uma parada de caminhões lotada, mas também atravessar cruzamentos congestionados."

