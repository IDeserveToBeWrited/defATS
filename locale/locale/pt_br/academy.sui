	key[]: "aca_goal_book1_2_08_forward"
	val[]: "Entrando no circuito"

	key[]: "aca_goal_book1_2_08_check1"
	val[]: "Curva fechada de raio longo"

	key[]: "aca_goal_book1_2_08_check2"
	val[]: "Dirigindo pelo zigue-zague"

	key[]: "aca_goal_book1_2_08_check3"
	val[]: "Curva Fechada em \"Z\""

	key[]: "aca_goal_book1_2_08_check4"
	val[]: "Curva estreita"

	key[]: "aca_goal_book1_2_08_check6"
	val[]: "Seção técnica"

	key[]: "aca_goal_book1_2_08_check7"
	val[]: "Trecho aberto"



#### 2_08 msg - intro text

	key[]: "aca_msg_book1_2_08_cutscene1"
	val[]: "Neste cenário, faremos uma curta viagem com o cavalo mecânico para ver como você a manobra com suas novas habilidades adquiridas.<br>Existem vários tipos e combinações de curvas na pista. Não é uma corrida e não se trata de tempo. Seja paciente e ajuste sua velocidade de condução às curvas e obstáculos que você encontrar."

	key[]: "aca_msg_book1_2_08_cutscene2"
	val[]: "Entre no percurso com uma curva fechada de raio longo."

	key[]: "aca_msg_book1_2_08_cutscene3"
	val[]: "Em seguida, você encontrará uma série de obstáculos que o guiarão para um zigue-zague irregular."

	key[]: "aca_msg_book1_2_08_cutscene4"
	val[]: "Após completar algumas curvas de 90 graus fáceis, você encontrará uma curva fechada em Z. É importante se posicionar corretamente, tanto para completar a curva quanto para entrar suavemente na próxima seção."

	key[]: "aca_msg_book1_2_08_cutscene5"
	val[]: "Fique atento aos cones ao dirigir em curvas de raio longo, pois a visibilidade sobre o capô é limitada."

	key[]: "aca_msg_book1_2_08_cutscene6"
	val[]: "Outro conjunto de barreiras o guiará para um zigue-zague aberto."

	key[]: "aca_msg_book1_2_08_cutscene7"
	val[]: "A pista abre um pouco, mas não tenha pressa. Mais algumas curvas fáceis e você concluirá."

	key[]: "aca_msg_book1_2_08_cutscene8"
	val[]: "Pare na área indicada e acione o freio de mão."


#### 2_08 Driving Instructions

	key[]: "aca_msg_book1_2_08_start"
	val[]: "Para concluir este cenário, você não pode bater, sair da pista ou atropelar os cones.<br><br><font face=/font/big_bold.font>Prepare-se para partir. </font>"

	key[]: "aca_msg_book1_2_08_forward"
	val[]:"<font face=/font/big_bold.font>Siga até a curva fechada para entrar no percurso. </font>"

	key[]: "aca_msg_book1_2_08_check1"
	val[]: "<font face=/font/big_bold.font>Complete a curva fechada. </font>"

	key[]: "aca_msg_book1_2_08_check2"
	val[]: "Você está se aproximando de algumas barreiras que formam um zigue-zague.<br><br><font face=/font/big_bold.font>Ajuste sua velocidade conforme necessário e continue.</font>"

	key[]: "aca_msg_book1_2_08_check3"
	val[]: "Em seguida, você terá duas curvas fáceis de 90 graus seguidas por uma curva fechada em Z. Vá devagar. <br><br><font face=/font/big_bold.font>Continue para a curva fechada em Z.</font>"

	key[]: "aca_msg_book1_2_08_check4"
	val[]: "Saindo da curva fechada, você encontrará um caminho estreito através de uma curva. Você deve ficar longe da barreira interna, mas tenha cuidado para não bater em nenhum cone à sua frente.<br><br><font face=/font/big_bold.font>Continue pela curva. </font>"

	key[]: "aca_msg_book1_2_08_check6"
	val[]: "O caminho à frente tem algumas curvas apertadas e técnicas. Ajuste sua velocidade e navegue com cuidado pela seção. <br><br><font face=/font/big_bold.font>Continue dirigindo.</font>"

	key[]: "aca_msg_book1_2_08_check7"
	val[]: "A próxima seção é mais aberta com algumas curvas fáceis. Não tenha pressa.<br><br><font face=/font/big_bold.font>Continue dirigindo.</font>"
#!{
	key[]: "aca_msg_book1_2_08_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_08_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

#@}

