#+ Text deviations for American Truck Simulator. Please, use only terms appropriate for USA (i.e. culture specific nuances, not American English).
#@{

#+ Music/radio player
#@{

#+ Hint shown if no music files are found. Also shown as tooltip when hovering over music_player button.

	key[]: "music_player_hint"
	val[]: "Coloque suas músicas na pasta <color value=@@clr_sel@@>American Truck Simulator/music <color value=@@clr_txt@@>em <color value=@@clr_sel@@>Meus Documentos <color value=@@clr_txt@@>e você vai vê-las aqui."

#+ Tooltip shown when hovering over the radio_stream button.

	key[]: "radio_hint"
	val[]: "Edite <color value=@@clr_sel@@>live_streams.sii <color value=@@clr_txt@@>na pasta <color value=@@clr_sel@@>American Truck Simulator <color value=@@clr_txt@@>em <color value=@@clr_sel@@>Meus Documentos <color value=@@clr_txt@@>para ouvir a sua rádio online favorita no jogo!"

#+ Hint shown if no online radio streams are defined.

	key[]: "empty_radio_hint"
	val[]: "Consulte <color value=@@clr_sel@@>readme.rtf <color value=@@clr_txt@@>na pasta <color value=@@clr_sel@@>American Truck Simulator <color value=@@clr_txt@@>em  <color value=@@clr_sel@@>Meus Documentos <color value=@@clr_txt@@>para saber como adicionar suas músicas e streams de rádio."
#@}

