
    key[]: "hint_engine_title"
	val[]: "Ligue o motor"

    key[]: "hint_engine_text"
	val[]: "Use $KEY_engine$ para dar partida no motor."


    key[]: "hint_ignition_title"
	val[]: "Ligue a ignição"

    key[]: "hint_ignition_text"
	val[]: "Use $KEY_engineelect|KEY_engine$ para ligar a ignição."


    key[]: "hint_driv_arc_title"
	val[]: "Direção"

    key[]: "hint_driv_arc_text"
	val[]: "Use $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ e $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ para se deslocar para a frente ou para trás.<br><offset vshift=8>Use $SPECIAL_steering$ para esterçar."


    key[]: "hint_driv_auto_title"
	val[]: "Dirigindo"

    key[]: "hint_driv_auto_text"
	val[]: "Use $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ e $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ para se deslocar para a frente ou para trás.<br><offset vshift=8>Use $SPECIAL_steering$ para esterçar.<br><offset vshift=8>Pressione $KEY_gearup$ e $KEY_geardown$ para mudar de marcha."


    key[]: "hint_driv_seq_title"
	val[]: "Dirigindo"

    key[]: "hint_driv_seq_text"
	val[]: "Use $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ e $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ para se deslocar para a frente ou para trás.<br><offset vshift=8>Use $SPECIAL_steering$ para esterçar.<br><offset vshift=8>Pressione $KEY_gearup$ e $KEY_geardown$ para controlar a embreagem."


    key[]: "hint_driv_hshift_title"
	val[]: "Dirigindo"

    key[]: "hint_driv_hshift_text"
	val[]: "Use $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ e $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ para se deslocar para a frente ou para trás.<br><offset vshift=8>Use $SPECIAL_steering$ para esterçar.<br><offset vshift=8>Mude de marcha com o<color value=@@clr_sel@@>câmbio<color value=@@clr_txt@@>."


    key[]: "hint_depot_deliv_title"
    val[]: "Aproxime-se do destino"

    key[]: "hint_depot_deliv_text"
    val[]: "Pare na área marcada para selecionar a dificuldade da vaga final e ganhar a experiência correspondente."


    key[]: "hint_fin_deliv_title"
    val[]: "Finalize a entrega"

    key[]: "hint_fin_deliv_text"
    val[]: "Estacione na vaga selecionada. Você pode pressionar $KEY_activate$ para pular a ação quando estiver perto do ponto de entrega."


    key[]: "hint_fin_deliv2_title"
    val[]: "Finalize a entrega"

    key[]: "hint_fin_deliv2_text"
    val[]: "Estacione na vaga selecionada. Você pode ativar um widget nas @@desktop_menu_category_options@@ para permitir pular o estacionamento."


    key[]: "hint_lights_title"
    val[]: "Ligue os faróis"

    key[]: "hint_lights_text"
    val[]: "Use $KEY_light$ para ligar os faróis. Pressione repetidamente para alternar entre os diferentes modos."


    key[]: "hint_high_beam_title"
    val[]: "Acione o farol alto"

    key[]: "hint_high_beam_text"
    val[]: "Use $KEY_hblight$ para acionar o farol alto."


    key[]: "hint_wipers_title"
    val[]: "Ative os limpadores"

    key[]: "hint_wipers_text"
    val[]: "Use $KEY_wipers$ para ativar os limpadores de para-brisa e alternar entre as diferentes velocidades."


    key[]: "hint_zoom_title"
    val[]: "Observando de perto"

    key[]: "hint_zoom_text"
    val[]: "Use $KEY_camzoom$ para dar zoom enquanto estiver na câmera interior. Você pode configurar o modo de zoom para manter pressionado ou alternar nas @@desktop_menu_category_options@@."


    key[]: "hint_cam_int_title"
    val[]: "Observando ao redor"

    key[]: "hint_cam_int_text"
    val[]: "Use $KEY_cam1$ para mudar a câmera para a visão interna."


    key[]: "hint_cam_ext_title"
    val[]: "Observando ao redor"

    key[]: "hint_cam_ext_text"
    val[]: "Você pode alternar entre diferentes ângulos de câmera pressionando $KEY_camcycle$.<br><offset vshift=8>Use $KEY_cam2$ para mudar a câmera para a visão externa."


    key[]: "hint_indicators_title"
    val[]: "Setas"

    key[]: "hint_indicators_text"
    val[]: "Use $KEY_lblinker$ e $KEY_rblinker$ para ligar as luzes de seta."


    key[]: "hint_tow_title"
    val[]: "Serviço de reboque"

    key[]: "hint_tow_text"
    val[]: "Se não conseguir sair de uma situação difícil, você pode usar o serviço de reboque. Para acessá-lo, abra o menu @@quick_info_word@@ usando $KEY_advmouse$."


    key[]: "hint_diff_lock_title"
    val[]: "Bloqueio do diferencial"

    key[]: "hint_diff_lock_text"
    val[]: "Se não conseguir sair do local, talvez o bloqueio do diferencial ajude. Use $KEY_diflock$ para ativá-lo ou ligue o bloqueio automático do diferencial nas @@desktop_menu_category_options@@."


    key[]: "hint_diff_unlock_title"
    val[]: "Bloqueio do diferencial acionado"

    key[]: "hint_diff_unlock_text"
    val[]: "Você deve desbloquear o diferencial durante a condução normal, ou corre o risco de danificá-lo. Use $KEY_diflock$ para desativá-lo ou ative o bloqueio automático do diferencial nas @@desktop_menu_category_options@@."


    key[]: "hint_wipers_off_title"
    val[]: "Desative os limpadores"

    key[]: "hint_wipers_off_text"
    val[]: "Use $KEY_wipers$ para desativar os limpadores de para-brisa e alternar entre as diferentes velocidades."


    key[]: "hint_world_map_title"
    val[]: "Visualização do mapa"

    key[]: "hint_world_map_text"
    val[]: "Use $KEY_navmap$ para abrir o mapa."


    key[]: "hint_pause_title"
    val[]: "@@quick_info_word@@"

    key[]: "hint_pause_text"
    val[]: "Use $KEY_advmouse$ para abrir a @@quick_info_word@@ - visão geral do seu status com atalhos convenientes."


    key[]: "hint_pause_border_title"
    val[]: "Legislação local"

    key[]: "hint_pause_border_text"
    val[]: "Use $KEY_advmouse$ para abrir @@quick_info_word@@ e consultar a legislação da região em que você entrou."


    key[]: "hint_photo_trophy_title"
    val[]: "@@landmark_word@@"

    key[]: "hint_photo_trophy_text"
    val[]: "Abra @@quick_info_word@@ usando $KEY_advmouse$ para entrar no @@photo_mode_word@@ e capturar os @@landmark_word@@ próximos <img src=/material/ui/map/photo_sight_not_captured.mat width=20 height=20>."


    key[]: "hint_viewpoint_title"
    val[]: "@@viewpoint_title@@ próxima"

    key[]: "hint_viewpoint_text"
    val[]: "@@viewpoint_title@@ <img src=/material/ui/map/viewpoint_unseen.mat width=20 height=20> está próxima - encontre-a e ative-a para assistir à cena."


    key[]: "hint_resting_title"
    val[]: "Local de descanso próximo"

    key[]: "hint_resting_text"
    val[]: "Locais de descanso <img src=/material/ui/map/parking_ico.mat width=20 height=20> ajudam você a se recuperar do cansaço para continuar a viagem com segurança."


    key[]: "hint_gas_title"
    val[]: "Posto de abastecimento próximo"

    key[]: "hint_gas_text"
    val[]: "Os postos de abastecimento <img src=/material/ui/map/gas_ico.mat width=20 height=20> podem ser usados para reabastecer seu veículo."


    key[]: "hint_car_job_title"
    val[]: "Primeiro trabalho como entregador"

    key[]: "hint_car_job_text"
    val[]: "Realize a entrega - dirija com cuidado, cuide bem da carga e chegue no horário estipulado. Lembre-se que a prioridade do cliente afeta sua avaliação e recompensa.<br><offset vshift=8>Pressione $KEY_advmouse$ para ver os detalhes do trabalho."


    key[]: "hint_tour_board_title"
    val[]: "Placa turística"

    key[]: "hint_tour_board_text"
    val[]: "Há uma placa turística por perto. Ative-a para desbloquear o conteúdo dela em <color value=@@clr_sel@@>@@tourist_atlas_link@@</color> para guiar sua exploração de pontos turísticos e pontos de interesse nas proximidades."


    key[]: "hint_tb_first_title"
    val[]: "Primeiro local explorado"

    key[]: "hint_tb_first_text"
    val[]: "Você explorou o primeiro local de uma placa turística local. Você pode ver os detalhes em <color value=@@clr_sel@@>@@tourist_atlas_link@@</color>. Explore todos os locais para saber mais e ganhar recompensas."


    key[]: "hint_tb_bef_compl_title"
    val[]: "Um local restante"

    key[]: "hint_tb_bef_compl_text"
    val[]: "Falta apenas um local antes de você explorar por completo sua primeira placa turística local e receber seu cartão postal."


    key[]: "hint_tb_done_title"
    val[]: "Placa turística explorada"

    key[]: "hint_tb_done_text"
    val[]: "Você explorou com sucesso todos os locais de uma placa turística local. Você pode ver os detalhes em <color value=@@clr_sel@@>@@tourist_atlas_link@@</color>. Como recompensa, você agora pode exibir o cartão postal em seu veículo."


    key[]: "hint_vehicle_prio_title"
    val[]: "Prioridade do cliente – condição do veículo"

    key[]: "hint_vehicle_prio_text"
    val[]: "O cliente deu maior prioridade à condição do veículo – sua recompensa bônus ou penalidade serão consideravelmente afetadas pelo estado do seu veículo. Dirija com cuidado e cuide bem do seu veículo.<br><offset vshift=8>Pressione $KEY_advmouse$ para ver os detalhes do trabalho."


    key[]: "hint_cargo_prio_title"
    val[]: "Prioridade do cliente – manuseamento da carga"

    key[]: "hint_cargo_prio_text"
    val[]: "O cliente deu maior prioridade ao manuseamento da carga – sua recompensa bônus ou penalidade serão consideravelmente afetadas pelo estado da carga que entregar. Dirija com cuidado e cuide bem da carga.<br><offset vshift=8>Pressione $KEY_advmouse$ para ver os detalhes do trabalho."


    key[]: "hint_time_prio_title"
    val[]: "Prioridade do cliente – gestão de tempo"

    key[]: "hint_time_prio_text"
    val[]: "O cliente deu maior prioridade à gestão de tempo – sua recompensa bônus ou penalidade serão consideravelmente afetadas pela sua pontualidade. Dirija com cuidado e chegue no horário estipulado pelo cliente.<br><offset vshift=8>Pressione $KEY_advmouse$ para ver os detalhes do trabalho."


    key[]: "hint_car_deliv_title"
    val[]: "Aproxime-se do destino"

    key[]: "hint_car_deliv_text"
    val[]: "Pare na área indicada para finalizar a entrega.<br>Lembre-se: o cliente espera que a entrega seja feita em um determinado horário."


    key[]: "hint_car_early_title"
	val[]: "Chegada adiantada"

    key[]: "hint_car_early_text"
    val[]: "A entrega está prevista para um horário específico, e chegar adiantado causará a insatisfação do cliente. Planeje sua viagem e use as áreas de descanso disponíveis, se necessário."


#!{
    key[]: "hint_sm_throttle_title"
	val[]: "@@throttle_double_tap@@"
#!}

    key[]: "hint_sm_throttle_text"
    val[]: "Você pode ativar o controle inteligente do acelerador em @@desktop_menu_category_options@@. Ao ativá-lo, o veículo manterá uma aceleração mais baixa por padrão. Após pressionar rapidamente o botão de aceleração duas vezes, o veículo manterá a aceleração máxima até que o botão seja liberado."
