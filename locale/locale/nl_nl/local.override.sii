#+ Text deviations for American Truck Simulator. Please, use only terms appropriate for USA (i.e. culture specific nuances, not American English).
#@{

#+ Music/radio player
#@{

#+ Hint shown if no music files are found. Also shown as tooltip when hovering over music_player button.

	key[]: "music_player_hint"
	val[]: "Plaats je liedjes in <color value=@@clr_sel@@>American Truck Simulator/music <color value=@@clr_txt@@>map in <color value=@@clr_sel@@>Mijn Documenten <color value=@@clr_txt@@>en je zult ze hier zien."

#+ Tooltip shown when hovering over the radio_stream button.

	key[]: "radio_hint"
	val[]: "Bewerk <color value=@@clr_sel@@>live_streams.sii <color value=@@clr_txt@@>in <color value=@@clr_sel@@>American Truck Simulator <color value=@@clr_txt@@>map in <color value=@@clr_sel@@>Mijn Documenten <color value=@@clr_txt@@> en luister naar je favoriete internetradiozender in het spel!"

#+ Hint shown if no online radio streams are defined.

	key[]: "empty_radio_hint"
	val[]: "Zie alsjeblieft <color value=@@clr_sel@@>leesmij.rtf <color value=@@clr_txt@@>in <color value=@@clr_sel@@>American Truck Simulator <color value=@@clr_txt@@>map in <color value=@@clr_sel@@>Mijn Documenten <color value=@@clr_txt@@>over hoe je je eigen muziek en radiostreams kunt toevoegen."
#@}

