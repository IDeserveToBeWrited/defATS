
    key[]: "hint_engine_title"
	val[]: "Start the engine"

    key[]: "hint_engine_text"
	val[]: "Use $KEY_engine$ to start the engine."


    key[]: "hint_ignition_title"
	val[]: "Start the ignition"

    key[]: "hint_ignition_text"
	val[]: "Use $KEY_engineelect|KEY_engine$ to start the ignition."


    key[]: "hint_driv_arc_title"
	val[]: "Driving"

    key[]: "hint_driv_arc_text"
	val[]: "Use $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ and $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ to move forward or reverse.<br><offset vshift=8>Use $SPECIAL_steering$ to steer."


    key[]: "hint_driv_auto_title"
	val[]: "Driving"

    key[]: "hint_driv_auto_text"
	val[]: "Use $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ and $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ to move forward or reverse.<br><offset vshift=8>Use $SPECIAL_steering$ to steer.<br><offset vshift=8>Press $KEY_gearup$ and $KEY_geardown$ for gear selection."


    key[]: "hint_driv_seq_title"
	val[]: "Driving"

    key[]: "hint_driv_seq_text"
	val[]: "Use $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ and $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ to move forward or reverse.<br><offset vshift=8>Use $SPECIAL_steering$ to steer.<br><offset vshift=8>Press $KEY_gearup$ and $KEY_geardown$ for clutch control."


    key[]: "hint_driv_hshift_title"
	val[]: "Driving"

    key[]: "hint_driv_hshift_text"
	val[]: "Use $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ and $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ to move forward or reverse.<br><offset vshift=8>Use $SPECIAL_steering$ to steer.<br><offset vshift=8>Change gears with <color value=@@clr_sel@@>shifter<color value=@@clr_txt@@>."


    key[]: "hint_depot_deliv_title"
    val[]: "Approach the destination"

    key[]: "hint_depot_deliv_text"
    val[]: "Stop in the marked area to select the final parking spot difficulty and earn corresponding experience."


    key[]: "hint_fin_deliv_title"
    val[]: "Finish the delivery"

    key[]: "hint_fin_deliv_text"
    val[]: "Park in the selected parking spot. You can press $KEY_activate$ to skip it when close to the delivery point."


    key[]: "hint_fin_deliv2_title"
    val[]: "Finish the delivery"

    key[]: "hint_fin_deliv2_text"
    val[]: "Park in the selected parking spot. You can enable a widget in the @@desktop_menu_category_options@@ to allow you to skip parking."


    key[]: "hint_lights_title"
    val[]: "Turn on the lights"

    key[]: "hint_lights_text"
    val[]: "Use $KEY_light$ to activate lights. Cycle through different modes by pressing it repeatedly."


    key[]: "hint_high_beam_title"
    val[]: "Activate the high beams"

    key[]: "hint_high_beam_text"
    val[]: "Use $KEY_hblight$ to turn on the high beams."


    key[]: "hint_wipers_title"
    val[]: "Activate wipers"

    key[]: "hint_wipers_text"
    val[]: "Use $KEY_wipers$ to activate wipers and cycle through different speed settings."


    key[]: "hint_zoom_title"
    val[]: "Looking closer"

    key[]: "hint_zoom_text"
    val[]: "Use $KEY_camzoom$ to zoom while in the interior. You can set the zoom mode to hold or toggle in @@desktop_menu_category_options@@."


    key[]: "hint_cam_int_title"
    val[]: "Looking around"

    key[]: "hint_cam_int_text"
    val[]: "Use $KEY_cam1$ to change the camera to interior view."


    key[]: "hint_cam_ext_title"
    val[]: "Looking around"

    key[]: "hint_cam_ext_text"
    val[]: "You can cycle through different camera angles by pressing $KEY_camcycle$.<br><offset vshift=8>Use $KEY_cam2$ to switch the camera to exterior view."


    key[]: "hint_indicators_title"
    val[]: "Indicators"

    key[]: "hint_indicators_text"
    val[]: "Use $KEY_lblinker$ and $KEY_rblinker$ to turn on indicators."


    key[]: "hint_tow_title"
    val[]: "Tow service"

    key[]: "hint_tow_text"
    val[]: "If you can't get out of a difficult situation, you may use the towing service. To access it, open the @@quick_info_word@@ menu using $KEY_advmouse$."


    key[]: "hint_diff_lock_title"
    val[]: "Differential lock"

    key[]: "hint_diff_lock_text"
    val[]: "If you cannot start moving, maybe differential lock could help you. Use $KEY_diflock$ to activate it or turn on automatic differential lock in @@desktop_menu_category_options@@."


    key[]: "hint_diff_unlock_title"
    val[]: "Sperdifferentieel ingeschakeld"

    key[]: "hint_diff_unlock_text"
    val[]: "Je moet het sperdifferentieel uitschakelen tijdens het rijden op de gewone weg, anders bestaat er een kans dat je het beschadigt. Gebruik $KEY_diflock$om het uit te schakelen of kies voor het automatische sperdifferentieel in @@desktop_menu_category_options@@."


    key[]: "hint_wipers_off_title"
    val[]: "Schakel ruitenwissers uit"

    key[]: "hint_wipers_off_text"
    val[]: "Gebruik $KEY_wipers$ om de ruitenwissers uit te schakelen en de wissnelheid aan te passen."


    key[]: "hint_world_map_title"
    val[]: "Kaartweergave"

    key[]: "hint_world_map_text"
    val[]: "Gebruik $KEY_navmap$ om de wereldkaart te openen."


    key[]: "hint_pause_title"
    val[]: "@@quick_info_word@@"

    key[]: "hint_pause_text"
    val[]: "Gebruik $KEY_advmouse$ om @@quick_info_word@@ te openen."


    key[]: "hint_pause_border_title"
    val[]: "Lokale wetgeving"

    key[]: "hint_pause_border_text"
    val[]: "Gebruik $KEY_advmouse$ om @@quick_info_word@@ te openen en controleer de verkeersregels voor de lokale regio."


    key[]: "hint_photo_trophy_title"
    val[]: "@@landmark_word@@"

    key[]: "hint_photo_trophy_text"
    val[]: "Open @@quick_info_word@@ met $KEY_advmouse$ om de @@photo_mode_word@@ te openen en fotografeer @@landmark_word@@ <img src=/material/ui/map/photo_sight_not_captured.mat width=20 height=20>."


    key[]: "hint_viewpoint_title"
    val[]: "@@viewpoint_title@@ in de buurt"

    key[]: "hint_viewpoint_text"
    val[]: "@@viewpoint_title@@ <img src=/material/ui/map/viewpoint_unseen.mat width=20 height=20> is in de buurt. Zoek en activeer het om de cutscene te bekijken."


    key[]: "hint_resting_title"
    val[]: "Verzorgingsplaats in de buurt"

    key[]: "hint_resting_text"
    val[]: "Resting places <img src=/material/ui/map/parking_ico.mat width=20 height=20> help you recover from fatigue and take your mandatory break to safely continue your journey."


    key[]: "hint_gas_title"
    val[]: "Tankstation in de buurt"

    key[]: "hint_gas_text"
    val[]: "Tankstations <img src=/material/ui/map/gas_ico.mat width=20 height=20> kunnen worden gebruikt om je voertuig te tanken."


    key[]: "hint_car_job_title"
    val[]: "First courier job"

    key[]: "hint_car_job_text"
    val[]: "Voltooi de levering - rijd veilig, zorg goed voor de lading en kom op de afgesproken tijd aan. Houd rekening met de klantprioriteit die van invloed is op uw beoordeling en beloning.<br><offset vshift=8>Druk op $KEY_advmouse$ om de details van de opdracht te bekijken."


    key[]: "hint_tour_board_title"
    val[]: "Toeristisch Informatiebord"

    key[]: "hint_tour_board_text"
    val[]: "Een Toeristisch informatiebord is in de buurt. Activeer het om de content vrij te spelen in <color value=@@clr_sel@@>@@tourist_atlas_link@@</color> om je te begeleiden ij de verkenning van nabijgelegen bezienswaardigheden."


    key[]: "hint_tb_first_title"
    val[]: "First location explored"

    key[]: "hint_tb_first_text"
    val[]: "Je hebt de eerste locatie van een lokaal toeristisch informatiebord verkend. Je kan de details zien in <color value=@@clr_sel@@>@@tourist_atlas_link@@</color>. Verken alle locaties om er meer over te weten te komen en beloningen te verdienen."


    key[]: "hint_tb_bef_compl_title"
    val[]: "Nog één locatie over"

    key[]: "hint_tb_bef_compl_text"
    val[]: "Nog maar één locatie is over voordat je het lokale toeristische informatiebord volledig hebt verkend en je je ansichtkaart hebt verdiend."


    key[]: "hint_tb_done_title"
    val[]: "Toeristisch Informatiebord Verkend"

    key[]: "hint_tb_done_text"
    val[]: "Je hebt alle locaties van een lokale toeristisch informatiebord succesvol bezocht. Je kunt hun gegevens bekijken in <color value=@@clr_sel@@>@@tourist_atlas_link@@</color>. Als beloning kun je de ansichtkaart nu in je voertuig ophangen."


    key[]: "hint_vehicle_prio_title"
    val[]: "Klantprioriteit - voertuigconditie"

    key[]: "hint_vehicle_prio_text"
    val[]: "De klant hecht meer waarde aan de staat van het voertuig - jouw bonusbeloning of -straf zal sterk afhangen van de staat van het voertuig waarmee u aankomt. Rijd veilig en zorg goed voor je voertuig.<br><offset vshift=8>Druk op $KEY_advmouse$ om de details van de opdracht te bekijken."


    key[]: "hint_cargo_prio_title"
    val[]: "Klantprioriteit - vrachtafhandeling"

    key[]: "hint_cargo_prio_text"
    val[]: "De klant hecht meer waarde aan de afhandeling van de lading - jouw bonus of straf zal sterk afhangen van de staat van de lading die je aflevert. Rijd veilig en zorg goed voor je lading.<br><offset vshift=8>Druk op $KEY_advmouse$ om de details van de opdracht te bekijken."


    key[]: "hint_time_prio_title"
    val[]: "Klantprioriteit - tijdmanagement"

    key[]: "hint_time_prio_text"
    val[]: "De klant hecht veel waarde aan tijdmanagement - jouw bonus of straf zal sterk afhangen van uw punctualiteit. Rijd veilig en kom op het tijdstip aan dat de klant verwacht.<br><offset vshift=8>Druk op $KEY_advmouse$ om de details van de opdracht te bekijken."


    key[]: "hint_car_deliv_title"
    val[]: "Approach the destination"

    key[]: "hint_car_deliv_text"
    val[]: "Stop in the marked area to finish the delivery.<br>Remember that the customer expects delivery at a specific time."


    key[]: "hint_car_early_title"
	val[]: "Te vroege aankomst"

    key[]: "hint_car_early_text"
    val[]: "De levering staat gepland op een specifieke tijd, een te vroege aankomst zal de klantentevredenheid omlaag halen. Plan je reis goed en maak gebruik van de beschikbare parkeerplaatsen indien nodig."


#!{
    key[]: "hint_sm_throttle_title"
	val[]: "@@throttle_double_tap@@"
#!}

    key[]: "hint_sm_throttle_text"
    val[]: "You can enable smart throttle control in @@desktop_menu_category_options@@. By enabling it, the vehicle will hold lower throttle by default. After quickly pressing the throttle button twice, the vehicle will hold full throttle until the button is released."
