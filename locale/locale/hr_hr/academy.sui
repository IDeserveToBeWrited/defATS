#+ Book 1 intro
#@{

	key[]: "aca_scenario_book1_intro_title"
	val[]: "Osnove vožnje kamiona"

	key[]: "aca_msg_book1_intro_cutscene01"
	val[]: "Dobro došli u @@driving_academy@@."

	key[]: "aca_msg_book1_intro_cutscene02"
	val[]: "Sljedeći scenariji predstavljaju prvi korak na vašem putu do profesionalne vožnje kamiona."

	key[]: "aca_msg_book1_intro_cutscene03"
	val[]: "Ovdje ćete naučiti sve o osnovnim sustavima i kontrolama kamiona..."

	key[]: "aca_msg_book1_intro_cutscene04"
	val[]: "...za složeno upravljanje sa i bez prikolice."

	key[]: "aca_msg_book1_intro_cutscene05"
	val[]: "Pomoći ćemo vam da steknete navike koje će vam pomoći da se sigurno snađete u različitim situacijama,"

	key[]: "aca_msg_book1_intro_cutscene06"
	val[]: "i naučiti vas kako mudro iskoristiti raspoloživi prostor za učinkovito upravljanje kamionom."

	key[]: "aca_msg_book1_intro_cutscene07"
	val[]: "Dovršetkom svih scenarija i polaganjem završnih ispita,"

	key[]: "aca_msg_book1_intro_cutscene08"
	val[]: "bit ćete spremni krenuti cestama Amerike i pronaći nove izazove s kojima ćete se suočiti."

#@}

