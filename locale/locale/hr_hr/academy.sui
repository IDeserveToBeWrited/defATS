 #!}

#### 3_12 msg - intro text

	key[]: "aca_msg_book1_3_12_cutscene01"
	val[]: "In this scenario, we'll go over how to turn around in a tight space.<br>You won't always have a lot of room for manoeuvring the truck, and will have to adapt to less than ideal situations."

	key[]: "aca_msg_book1_3_12_cutscene02"
	val[]: "Drive through the alley towards the open area."

	key[]: "aca_msg_book1_3_12_cutscene03"
	val[]: "On the left is another alley you must reverse into. Set yourself up however you wish with this in mind.<br>It may be helpful to try and have the trailer pointed towards the alley before you start reversing."

	key[]: "aca_msg_book1_3_12_cutscene04"
	val[]: "Reverse towards the alley. Be careful to keep an eye on all sides of the tractor and trailer."

	key[]: "aca_msg_book1_3_12_cutscene05"
	val[]: "There are obstacles in the alley, so be sure to keep towards the driver's side."

	key[]: "aca_msg_book1_3_12_cutscene06"
	val[]: "Once you have finished reversing, you can proceed forwards and head back in the direction you came from."

	key[]: "aca_msg_book1_3_12_cutscene07"
	val[]: "You may have difficulty seeing your trailer in the passenger's side mirror as you exit, so use all the space available to your advantage."

	key[]: "aca_msg_book1_3_12_cutscene08"
	val[]: "Nastavite voziti prema izlazu."

	key[]: "aca_msg_book1_3_12_cutscene09"
	val[]: "Park in the designated area and secure the truck."
#!{
	key[]: "aca_msg_book1_3_12_cutscene10"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_12_cutscene11"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_12_cutscene12"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_12_cutscene13"
	val[]: "Unused"
#!}
#### 3_12 Driving Instructions

	key[]: "aca_msg_book1_3_12_start"
	val[]: "In front of you is an area representing a shipping company’s lot. Your task is to enter and turn the truck around to come back out. Be sure to make good use of the space around you.<br><br><font face=/font/big_bold.font>Prepare to set off. </font>"

	key[]: "aca_msg_book1_3_12_forward"
	val[]: "<font face=/font/big_bold.font>Proceed through the alley. </font>"

	key[]: "aca_msg_book1_3_12_check1"
	val[]: "Just past the building on the left, there is another alley which you must reverse into. Set yourself up with this in mind.<br><br><font face=/font/big_bold.font>Continue towards the barriers. </font>"



	key[]: "aca_msg_book1_3_12_check3"
	val[]: "Reverse and turn the trailer towards the alley, ensuring you don't hit anything on the right side with the tractor.<br><br><font face=/font/big_bold.font>Start reversing and turn the trailer into the alley. Stop in the marked area. </font>"

	key[]: "aca_msg_book1_3_12_check4"
	val[]: "You can now proceed out of the area in the same direction from which you came. Make good use of the space available to you.<br><br><font face=/font/big_bold.font>Drive forwards and turn right. </font>"


	key[]: "aca_msg_book1_3_12_check6"
	val[]: "Continue down the alley towards the designated area."
#!{
	key[]: "aca_msg_book1_3_12_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_12_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_12_check5"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_12_check2"
	val[]: "Unused"
#!}

#@}

#+ Book 1 Scenario 3_13
#@{

#### 3_13 common
	key[]: "aca_scenario_book1_3_13_title"
	val[]: "Offset Reversing Manoeuvre"

	key[]: "aca_scenario_book1_3_13_desc"
	val[]: "U ovom scenariju, imat ćete zadatak voziti unatrag na parkirno mjesto koje nije neposredno iza vas. Prostor za upravljanje je ograničen, pa ga mudro iskoristite."

#### 3_13 goal

#!{
	key[]: "aca_goal_book1_3_13_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_13_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_13_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_13_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

#!}

#### 3_13 msg - intro text

	key[]: "aca_msg_book1_3_13_cutscene01"
	val[]: "U ovom scenariju, vaš će zadatak biti parkirati na mjesto koje se nalazi pokraj vas. Nema puno prostora za manevriranje, pa ćete morati malo više poraditi kako biste prikolicu doveli gdje želite."

	key[]: "aca_msg_book1_3_13_cutscene02"
	val[]: "Vozite ravno do prepreke."

	key[]: "aca_msg_book1_3_13_cutscene03"
	val[]: "Zaustavite se prije prepreke."

	key[]: "aca_msg_book1_3_13_cutscene04"
	val[]: "Prije kretanja skroz okrenite volan prema vozačevoj strani. Na taj način počet ćete okretati prikolicu prema parkirnom mjestu čim krenete unatrag, štedeći tako dragocjeni prostor."

	key[]: "aca_msg_book1_3_13_cutscene05"
	val[]: "Nakon što prikolicu usmjerite kamo želite, postavite šleper/tegljač ispred prikolice i počnite je usmjeravati na parkirno mjesto."

	key[]: "aca_msg_book1_3_13_cutscene06"
	val[]: "Od ove točke pa nadalje, to se ne razlikuje toliko od uobičajenog parkiranja."

	key[]: "aca_msg_book1_3_13_cutscene07"
	val[]: "Nastavite voziti unatrag i promatrajte obje strane. Držite šleper/tegljač i prikolicu poravnate s parkirnim mjestom."

	key[]: "aca_msg_book1_3_13_cutscene08"
	val[]: "Zaustavite se na predviđenom području, osigurajte kamion i ugasite motor."


#### 3_13 Driving Instructions

	key[]: "aca_msg_book1_3_13_start"
	val[]: "Nalazite se na parkirnom mjestu, ali s vaše desne strane postoji drugo parkirno mjesto na koje se morate pomaknuti.<br><br><font face=/font/big_bold.font>Pripremite se za polazak. </font>"

	key[]: "aca_msg_book1_3_13_forward"
	val[]: "Ispred vas je označeno područje.<br><br><font face=/font/big_bold.font>Vozite naprijed. </font>"
#!{
	key[]: "aca_msg_book1_3_13_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

	key[]: "aca_msg_book1_3_13_check2"
	val[]: "Ne zaboravite odmah početi okretati, jer nema puno mjesta.<br><br><font face=/font/big_bold.font>Vozite unatrag do označenog mjesta iza vas. </font>"


#@}

#+ Book 1 Scenario 3_15
#@{

#### 3_15 common
	key[]: "aca_scenario_book1_3_15_title"
	val[]: "Jug Handle and Button Hook Turns"

	key[]: "aca_scenario_book1_3_15_desc"
	val[]: "In this scenario, you'll take a short drive through a training course that will help you learn to manoeuvre the trailer around tight corners with the help of two different cornering procedures."

#### 3_15 goal
#!{
	key[]: "aca_goal_book1_3_15_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_15_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_15_check6"
	val[]: "@@aca_goal_book1_3_11_check6@@"

	key[]: "aca_goal_book1_3_15_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_15_end"
	val[]: "@@aca_goal_book1_2_01_end@@"


 #!}
	key[]: "aca_goal_book1_3_15_check1"
	val[]: "Jug Handle Turn"

	key[]: "aca_goal_book1_3_15_check2"
	val[]: "Curve and Straight Section"

	key[]: "aca_goal_book1_3_15_check3"
	val[]: "Button Hook Turn"

	key[]: "aca_goal_book1_3_15_check4"
	val[]: "Straight Section and Curve"

	key[]: "aca_goal_book1_3_15_check5"
	val[]: "Combination Turn"



#### 3_15 msg - intro text

	key[]: "aca_msg_book1_3_15_cutscene01"
	val[]: "Ispred vas su uski zavoji s malo slobodnog prostora.<br>Pomoći će da naučite učinkovito upravljati prikolicom."

	key[]: "aca_msg_book1_3_15_cutscene02"
	val[]: "@@aca_msg_book1_3_15_cutscene02_img@@<br>The first turn requires a 'jug handle' manoeuvre. This term applies to turns where you have limited room on the road you’re turning into and must instead utilise extra space on the road you are currently on."

	key[]: "aca_msg_book1_3_15_cutscene03"
	val[]: "Follow the lane markings to swing the tractor far and wide from the inside kerb.<br>This will bring your trailer away from the kerb so that you have sufficient room to manoeuvre."

	key[]: "aca_msg_book1_3_15_cutscene04"
	val[]: "Keep close to the obstacle as you exit the turn so that the trailer continues to follow the widest arch possible."

	key[]: "aca_msg_book1_3_15_cutscene05"
	val[]: "As you enter the long curve, you must keep the tractor towards the centre of the road to keep the trailer wheels off of the kerb."

	key[]: "aca_msg_book1_3_15_cutscene06"
	val[]: "Nastavite cestom."

	key[]: "aca_msg_book1_3_15_cutscene07"
	val[]: "@@aca_msg_book1_3_15_cutscene07_img@@<br>The next turn requires the use of a 'button hook' manoeuvre. This is the preferred technique, as it doesn't open up the lane behind you for an inattentive motorist to sneak up on the right side. Always use it when you have enough space on the road you’re turning into."

	key[]: "aca_msg_book1_3_15_cutscene08"
	val[]: "Drive deep into the intersection and quickly make a sharp turn to the right."

	key[]: "aca_msg_book1_3_15_cutscene09"
	val[]: "As you come alongside the obstacle, you can straighten out and again keep towards the left side of your lane.<br>All of this serves to keep the trailer wheels away from the kerb."

	key[]: "aca_msg_book1_3_15_cutscene10"
	val[]: "Nastavite prema sljedećem zavoju."

	key[]: "aca_msg_book1_3_15_cutscene11"
	val[]: "Once again, keep towards the middle of the road to keep the trailer wheels away from the kerb."

	key[]: "aca_msg_book1_3_15_cutscene12"
	val[]: "The corner ahead is especially troublesome. In cases like this, you will not have ideal conditions for either a jug handle turn or a button hook turn and must combine both manoeuvres together to get where you need to go."

	key[]: "aca_msg_book1_3_15_cutscene13"
	val[]: "Swing wide before the turn, drive deep into the intersection, and quickly turn in. Once again, it's ideal to stay as close as possible to the obstacle to keep the turn as wide as possible."

	key[]: "aca_msg_book1_3_15_cutscene14"
	val[]: "Park in the designated area, secure the truck and shut down the engine."

	# Book 1 Scenario 3_15 formatting
#!{
	key[]: "aca_msg_book1_3_15_cutscene02_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/jug_handle.mat bottom=p256 right=p256 color=FFFFFFFF></align><offset vshift=256>"

	key[]: "aca_msg_book1_3_15_cutscene07_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/button_hook.mat bottom=p256 right=p256 color=FFFFFFFF></align><offset vshift=256>"

#!}


#### 3_15 Driving Instructions

	key[]: "aca_msg_book1_3_15_forward"
	val[]: "Remember to use all the room available to you to help you negotiate each turn.<br><br><font face=/font/big_bold.font>Set off and follow the road markings to the left. </font>"

	key[]: "aca_msg_book1_3_15_check1"
	val[]: "Use all the room available to swing wide and keep the trailer away from the inside kerb.<br><br><font face=/font/big_bold.font>Make a jug handle turn. </font>"

	key[]: "aca_msg_book1_3_15_check2"
	val[]: "Keep towards the centre of the road around the curve, then carry on straight towards the next turn.<br><br><font face=/font/big_bold.font>Continue Driving. </font>"

	key[]: "aca_msg_book1_3_15_check3"
	val[]: "There's limited room to the left, so you must drive far into the intersection to keep the trailer off the kerb.<br><br><font face=/font/big_bold.font>Make a button hook turn. </font>"

	key[]: "aca_msg_book1_3_15_check4"
	val[]: "Drive onwards to and around the next curve.<br><br><font face=/font/big_bold.font>Continue Driving. </font>"

	key[]: "aca_msg_book1_3_15_check5"
	val[]: "This turn is the tightest yet, and neither manoeuvre on its own will be sufficient.<br><br><font face=/font/big_bold.font>Make the turn, keep as wide as possible.</font>"

	key[]: "aca_msg_book1_3_15_check6"
	val[]: "<font face=/font/big_bold.font>Proceed to the parking spot ahead and to the right. </font>"
#!{
	key[]: "aca_msg_book1_3_15_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_15_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_15_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}


#@}

#+ Book 1 Scenario 3_16
#@{

#### 3_16 common
	key[]: "aca_scenario_book1_3_16_title"
	val[]: "Dijagonalno parkiranje unatrag"

	key[]: "aca_scenario_book1_3_16_desc"
	val[]: "In this scenario, we'll explore parking diagonally while reversing. This can occur at rest areas, truck stops, and even at shippers. Often there's little space because the lots are crowded with trucks, so parking is all the more difficult due to the lack of space."

#### 3_16 goal

	key[]: "aca_goal_book1_3_16_check1"
	val[]: "Okretanje prikolice"
#!{
	key[]: "aca_goal_book1_3_16_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_16_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_16_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_16_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
 #!}
#### 3_16 msg - intro text

	key[]: "aca_msg_book1_3_16_cutscene1"
	val[]: "Diagonal parking seems easier at a glance, but it can often be more challenging than typical 'alley parking' manoeuvres."

	key[]: "aca_msg_book1_3_16_cutscene2"
	val[]: "Vozite unatrag prema parkirnom mjestu. Za sada držite tegljač/šleper i prikolicu ravno."

	key[]: "aca_msg_book1_3_16_cutscene3"
	val[]: "As you get closer, let your trailer walk closer to the parked trucks. This will help you turn it into the spot when you reach it."

	key[]: "aca_msg_book1_3_16_cutscene4"
	val[]: "Start turning the trailer into the parking spot. Keep your trailer close to the truck on your driver's side, as you'll need the space on the other side."

	key[]: "aca_msg_book1_3_16_cutscene5"
	val[]: "Once the trailer is well into the parking spot, start turning the tractor to follow the trailer in."

	key[]: "aca_msg_book1_3_16_cutscene6"
	val[]: "Parkirajte na predviđenom području, osigurajte kamion i ugasite motor."

#### 3_16 Driving Instructions

	key[]: "aca_msg_book1_3_16_start"
	val[]: "Parkirajte kamion na mjesto iza sebe. Koristite oba retrovizora za navigaciju unatrag.<br><br><font face=/font/big_bold.font>Pripremite se za polazak. </font>"

	key[]: "aca_msg_book1_3_16_backward"
	val[]: "Provjerite svoju okolinu, a zatim krenite prema parkirnom mjestu.<br><br><font face=/font/big_bold.font>Počnite voziti unatrag.</font>"

	key[]: "aca_msg_book1_3_16_check1"
	val[]: "Start moving the trailer towards the trucks beside you. When you're ready, turn the trailer into the parking spot. Remember to consider the tail swing of the trailer.<br><br><font face=/font/big_bold.font>Turn into the parking spot. </font>"
#!{
	key[]: "aca_msg_book1_3_16_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_16_end"
	val[]: "@@aca_msg_book1_2_01_end@@"


 #!}


#@}

#+ Book 1 Scenario 3_17
#@{

#### 3_17 common
	key[]: "aca_scenario_book1_3_17_title"
	val[]: "Vožnja unatrag u zavoj"

	key[]: "aca_scenario_book1_3_17_desc"
	val[]: "U ovom ćemo scenariju po prvi put voziti unatrag s prikolicom u zavoj. Istražit ćemo osnovne principe vožnje unatrag i na što treba paziti prilikom skretanja unatrag."

#### 3_17 goal

	key[]: "aca_goal_book1_3_17_check1"
	val[]: "Okretanje prikolice"
#!{
	key[]: "aca_goal_book1_3_17_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_17_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_17_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_17_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
 #!}
#### 3_17 msg - intro text

	key[]: "aca_msg_book1_3_17_cutscene01"
	val[]: "U ovom scenariju, morat ćete voziti unatrag do parkirnog mjesta koje je iza vas sa vozačeve strane."

	key[]: "aca_msg_book1_3_17_cutscene02"
	val[]: "Imajte na umu nekoliko savjeta koji će vam puno pomoći s prikolicama pri vožnji unatrag. <br>Prvi je da će prikolica uvijek htjeti skrenuti u smjeru suprotnom od smjera kojim upravljate šleperom/tegljačem."

	key[]: "aca_msg_book1_3_17_cutscene03"
	val[]: "Drugo je da možete dobiti dobar osjećaj kamo ide prikolica promatrajući osovine kamiona i prikolice."

	key[]: "aca_msg_book1_3_17_cutscene04"
	val[]: "Treće, mali pomaci dovest će vas tamo gdje trebate ići, nema potrebe za pretjeranim radom."

	key[]: "aca_msg_book1_3_17_cutscene05"
	val[]: "Start turning the tractor away from the parking spot slightly, and the trailer will begin to point towards it."

	key[]: "aca_msg_book1_3_17_cutscene06"
	val[]: "Follow the trailer, making adjustments as you go to keep it on the right path."

	key[]: "aca_msg_book1_3_17_cutscene07"
	val[]: "Watch your trailer wheels and the rear wheel of the tractor. These will tell you where the trailer is pointed, and where the tractor is pushing it."

	key[]: "aca_msg_book1_3_17_cutscene08"
	val[]: "A fourth tip is that it's always easier to turn the trailer sharper than it is to try and straighten it out from a jackknife. Aim for the outside of the spot until you are closer to it, then you can turn a bit sharper to align your trailer."

	key[]: "aca_msg_book1_3_17_cutscene09"
	val[]: "As the trailer enters the parking spot, get the tractor in front of the trailer. Try to avoid too many adjustments inside the spot."

	key[]: "aca_msg_book1_3_17_cutscene10"
	val[]: "Vozite unatrag između barijera, provjerite obje strane dok vozite."

	key[]: "aca_msg_book1_3_17_cutscene11"
	val[]: "Osigurajte kamion i ugasite motor."

#### 3_17 Driving Instructions

	key[]: "aca_msg_book1_3_17_start"
	val[]: "Remember these tips when reversing into a turn with a trailer:<br><br>— The trailer turns opposite to how you steer the tractor<br><br>— Watch trailer's wheels to see where it's aiming<br><br>— Watch the tractor's rear wheel to see where it's pushing the trailer<br><br>— Let the trailer do the work, don't oversteer it<br><br>— It's always easier to turn the trailer sharper than it is to straighten it out<br><br><font face=/font/big_bold.font>Prepare to set off. </font>"

	key[]: "aca_msg_book1_3_17_backward"
	val[]: "Look behind you to find where you need to go. Always check your surroundings before you start reversing.<br><br><font face=/font/big_bold.font>Start reversing towards the parking spot.</font>"

	key[]: "aca_msg_book1_3_17_check1"
	val[]: "<font face=/font/big_bold.font>Start turning the trailer towards the parking spot and follow it in.</font>"

	key[]: "aca_msg_book1_3_17_stop"
	val[]: "<font face=/font/big_bold.font>Zaustavite se na označenom mjestu. </font>"
#!{
	key[]: "aca_msg_book1_3_17_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_18
#@{

#### 3_18 common
	key[]: "aca_scenario_book1_3_18_title"
	val[]: "Alley Parking Manoeuvre"

	key[]: "aca_scenario_book1_3_18_desc"
	val[]: "In this scenario, you'll be tasked with reversing the trailer into an alley off of a small roadway."

#### 3_18 goal

	key[]: "aca_goal_book1_3_18_check1"
	val[]: "Okretanje prikolice"
#!{
	key[]: "aca_goal_book1_3_18_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_18_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


	key[]: "aca_goal_book1_3_18_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_18_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

 #!}
#### 3_18 msg - intro text

	key[]: "aca_msg_book1_3_18_cutscene01"
	val[]: "Parking here requires an 'alley parking' manoeuvre.<br>This is a typical parking manoeuvre for truckers, as they will encounter this sort of parking situation almost daily in their careers, whether it's to load or unload a trailer or to park for the night in a truck stop."

	key[]: "aca_msg_book1_3_18_cutscene02"
	val[]: "This is a similar manoeuvre to the previous scenario, but you'll have less room to work so you will need to plan your moves accordingly and be careful not to hit anything."

	key[]: "aca_msg_book1_3_18_cutscene03"
	val[]: "Since there is less room, your timing is more important. Turn the trailer at the right time and watch the tractor and trailer wheels to see where it will go. Keep your tail swing in mind and remember not to jackknife - keep pushing the trailer."

	key[]: "aca_msg_book1_3_18_cutscene04"
	val[]: "Try to steer the trailer towards the alley earlier rather than later. This will give you room on the other side to swing the front of the trailer around and to get the tractor in front of it."

	key[]: "aca_msg_book1_3_18_cutscene05"
	val[]: "Once your trailer is in the alley, get the tractor in front of it. It's better to do this a bit earlier than your instinct might initially have you believe. You can always correct it as you reverse to your final position."

	key[]: "aca_msg_book1_3_18_cutscene06"
	val[]: "Poravnajte šleper/tegljač i prikolicu i zaustavite se na predviđenom području."

	key[]: "aca_msg_book1_3_18_cutscene07"
	val[]: "Osigurajte kamion i ugasite motor."


#### 3_18 Driving Instructions

	key[]: "aca_msg_book1_3_18_start"
	val[]: "Now we'll try turning a trailer in a much smaller area with an 'alley parking' manoeuvre. <br><br><font face=/font/big_bold.font>Prepare to set off. </font>"

	key[]: "aca_msg_book1_3_18_backward"
	val[]: "Provjerite svoju okolinu i potražite parkirno mjesto iza sebe. <br><br><font face=/font/big_bold.font>Počnite voziti unatrag prema parkirnom mjestu. </font>"

	key[]: "aca_msg_book1_3_18_check1"
	val[]: "<font face=/font/big_bold.font>Turn the trailer into the parking spot. </font>"
#!{
	key[]: "aca_msg_book1_3_18_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_18_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}


#@}

#+ Book 1 Scenario 3_19
#@{

#### 3_19 common
	key[]: "aca_scenario_book1_3_19_title"
	val[]: "Završni ispit (1. dio)"

	key[]: "aca_scenario_book1_3_19_desc"
	val[]: "The final exam awaits you, where all the skills you've learned from the previous scenarios will be put to the test. We'll take a drive around the entire training centre to see how well you've learned the situations you've encountered so far.<br><br>Once you've completed all sections and manoeuvres, you'll be one step closer to calling yourself a skilled trucker!"

#### 3_19 goal
