	key[]: "aca_goal_book1_3_06_check1"
	val[]: "Upravljanje na mjestu"


#### 3_06 msg - intro text

	key[]: "aca_msg_book1_3_06_cutscene01"
	val[]: "Parkiranje tijekom vožnje prema naprijed, ili 'uvlačenje', prilično je jednostavno što se tiče manevara parkiranja. <br>Morati ćete i dalje kompenzirati pomak prikolice."

	key[]: "aca_msg_book1_3_06_cutscene02"
	val[]: "Morat ćete se proći pokraj točke gdje biste inače okrenuli šleper/tegljač. To će vam omogućiti da bolje poravnate prikolicu."

	key[]: "aca_msg_book1_3_06_cutscene03"
	val[]: "Dok se približavate parkirnom mjestu, skrenite da dovedete tegljač/šleper ispred prikolice. Poravnajte se i nastavite do mjesta. <br>Zaustavite, parkirajte, osigurajte kamion i ugasite motor."

#### 3_06 Driving Instructions

	key[]: "aca_msg_book1_3_06_start"
	val[]: "Ahead of you, there is a parking spot that you'll need to drive to and park inside of.<br><br><font face=/font/big_bold.font>Prepare to set off. </font>"

	key[]: "aca_msg_book1_3_06_forward"
	val[]: "<font face=/font/big_bold.font>Počnite voziti i skrenite prema parkirnom mjestu.</font>"

	key[]: "aca_msg_book1_3_06_check1"
	val[]: "Provezite se pokraj parkirnog mjesta kako biste svoju prikolicu poravnali s označenim područjem, zatim dovedite šleper/tegljač na to mjesto i poravnajte se.<br><br><font face=/font/big_bold.font>Parkirajte na označenom području.  </font>"

	key[]: "aca_msg_book1_3_06_stop"
	val[]: "<font face=/font/big_bold.font>Zaustavite se u označenom području. </font>"

	key[]: "aca_msg_book1_3_06_end"
	val[]: "<font face=/font/big_bold.font>Osigurajte kamion i ugasite motor.</font>"
#@}

