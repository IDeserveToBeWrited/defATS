#+ Book 1 Scenario 3_03
#@{

#### 3_03 common
	key[]: "aca_scenario_book1_3_03_title"
	val[]: "Driving on a Road Course"

	key[]: "aca_scenario_book1_3_03_desc"
	val[]: "In this scenario, we'll explore manoeuvring the trailer through a short but complex obstacle course."

#### 3_03 goal
#!{
	key[]: "aca_goal_book1_3_03_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_03_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_03_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_03_end"
	val[]: "@@aca_goal_book1_2_01_end@@"


 #!}
	key[]: "aca_goal_book1_3_03_check1"
	val[]: "Prvo skretanje"

	key[]: "aca_goal_book1_3_03_check2"
	val[]: "Roundabout"

	key[]: "aca_goal_book1_3_03_check3"
	val[]: "90-degree Turn"

	key[]: "aca_goal_book1_3_03_check4"
	val[]: "Jug Handle Turn"

	key[]: "aca_goal_book1_3_03_check5"
	val[]: "Button Hook Turn"

	key[]: "aca_goal_book1_3_03_check6"
	val[]: "Tight Turn"


#### generic phrase

	key[]: "aca_goal_book1_3_03_chk_point"
	val[]: "Vožnja oko prepreka"

#### 3_03 msg - intro text

	key[]: "aca_msg_book1_3_03_cutscene01"
	val[]: "Pred vama su razni složeni zavoji i prepreke.<br>Uzmite u obzir sve što ste do sada naučili i ne bi trebalo biti previše teško."

	key[]: "aca_msg_book1_3_03_cutscene02"
	val[]: "The first corner is an easy button hook turn. Keep wide, and it shouldn't pose a problem."

	key[]: "aca_msg_book1_3_03_cutscene03"
	val[]: "Nastavite prema kružnom toku."

	key[]: "aca_msg_book1_3_03_cutscene04"
	val[]: "Keep the trailer away from the inside of the roundabout by driving the tractor as wide as possible around it."

	key[]: "aca_msg_book1_3_03_cutscene05"
	val[]: "The 90-degree turn to the left isn't particularly tight, but be sure not to hit any cones."

	key[]: "aca_msg_book1_3_03_cutscene06"
	val[]: "This turn is significantly tighter. Use a jug handle manoeuvre to complete it."

	key[]: "aca_msg_book1_3_03_cutscene07"
	val[]: "You can use a button hook manoeuvre on this turn, but there are some extra obstacles to avoid."

	key[]: "aca_msg_book1_3_03_cutscene09"
	val[]: "Once again, the final turn is very tight and will require a combination of both jug handle and button hook manoeuvres to complete."

	key[]: "aca_msg_book1_3_03_cutscene10"
	val[]: "Park in the designated area, secure the truck and shut down the engine."


#### 3_03 Driving Instructions



	key[]: "aca_msg_book1_3_03_forward"
	val[]: "<font face=/font/big_bold.font>Proceed to the first turn. </font>"

	key[]: "aca_msg_book1_3_03_check1"
	val[]: "The first turn is an easy button hook turn.<br><br><font face=/font/big_bold.font><color value=@@clr_txt@@>Proceed through the turn. </font>"

	key[]: "aca_msg_book1_3_03_check2"
	val[]: "Continue on to the roundabout. Remember to take a wide path around it.<br><br><font face=/font/big_bold.font>Drive to and around the roundabout.</font>"

	key[]: "aca_msg_book1_3_03_check3"
	val[]: "This 90-degree turn is a bit tighter, be careful not to hit any cones.<br><br><font face=/font/big_bold.font>Make the turn.</font>"

	key[]: "aca_msg_book1_3_03_check4"
	val[]: "This turn is best approached with a jug handle procedure. Swing wide before you enter the intersection.<br><br><font face=/font/big_bold.font>Make a jug handle turn. </font>"

	key[]: "aca_msg_book1_3_03_check5"
	val[]: "This turn is littered with several different obstacles, but it can be done with a button hook manoeuvre.<br><br><font face=/font/big_bold.font>Proceed carefully. </font>"

	key[]: "aca_msg_book1_3_03_check6"
	val[]: "This turn is the tightest yet, negotiate it as you see fit.<br><br><font face=/font/big_bold.font>Turn into the parking lot.</font>"
#!{
	key[]: "aca_msg_book1_3_03_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_03_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

#@}

#+ Book 1 Scenario 3_04
#@{

#### 3_04 common
	key[]: "aca_scenario_book1_3_04_title"
	val[]: "Napredni tečaj - prikolica"

	key[]: "aca_scenario_book1_3_04_desc"
	val[]: "U završnom scenariju u 3. poglavlju, odvest ćemo se na dužu obuku s nizom različitih zavoja da vidimo koliko ste dobro naučili upravljati s prikolicom."

#### 3_04 goal



	key[]: "aca_goal_book1_3_04_check1"
	val[]: "Easy Turns"

	key[]: "aca_goal_book1_3_04_check2"
	val[]: "Easy 90-degree Turn"

	key[]: "aca_goal_book1_3_04_check3"
	val[]: "Ulazak u dvostruki zavoj"

	key[]: "aca_goal_book1_3_04_check4"
	val[]: "Izlazak iz dvostrukog zavoja"

	key[]: "aca_goal_book1_3_04_check5"
	val[]: "Uski dio"

	key[]: "aca_goal_book1_3_04_check6"
	val[]: "Easy 90-degree Turn"

	key[]: "aca_goal_book1_3_04_check7"
	val[]: "Tight Hairpin"

	key[]: "aca_goal_book1_3_04_check8"
	val[]: "Tight 90-degree Turn"

	key[]: "aca_goal_book1_3_04_check9"
	val[]: "Complex Hairpin Turn"

	key[]: "aca_goal_book1_3_04_check10"
	val[]: "Final Turn"

	key[]: "aca_goal_book1_3_04_check11"
	val[]: "Nastavite do označenog područja"
#!{
	key[]: "aca_goal_book1_3_04_stop"
