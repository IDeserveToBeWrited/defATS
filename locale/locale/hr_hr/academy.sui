	key[]: "aca_goal_book1_3_04_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_04_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


 #!}
#### 3_04 msg - intro text

	key[]: "aca_msg_book1_3_04_cutscene01"
	val[]: "Remember to plan ahead for each turn and make good use of the space around you. Head around the first set of barriers and into the course."

	key[]: "aca_msg_book1_3_04_cutscene02"
	val[]: "The first few turns get progressively sharper as you go."

	key[]: "aca_msg_book1_3_04_cutscene03"
	val[]: "Remember that how you exit one turn can affect how you enter the next."

	key[]: "aca_msg_book1_3_04_cutscene04"
	val[]: "The first of the more challenging corners combines two hairpin turns into one. You will have to be very careful and deliberate in your driving and use the mirrors to your advantage."

	key[]: "aca_msg_book1_3_04_cutscene05"
	val[]: "Nastavite uskim dijelom."

	key[]: "aca_msg_book1_3_04_cutscene06"
	val[]: "Next are a couple of easy corners on your way towards a tight hairpin."

	key[]: "aca_msg_book1_3_04_cutscene07"
	val[]: "Keep your head on a swivel to make sure you don't hit any of the barriers. Go as slow as you need to."

	key[]: "aca_msg_book1_3_04_cutscene08"
	val[]: "Even when there appears to be a lot of room to manoeuvre, you can still end up in a tight situation."

	key[]: "aca_msg_book1_3_04_cutscene09"
	val[]: "The most complex turn is just ahead. Your entry into the turn will determine whether you make it through successfully or not."

	key[]: "aca_msg_book1_3_04_cutscene10"
	val[]: "Nastavite kroz posljednji zavoj."

	key[]: "aca_msg_book1_3_04_cutscene11"
	val[]: "Stop in the designated area, secure the truck and shut down the engine."
#!{
	key[]: "aca_msg_book1_3_04_cutscene12"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_04_cutscene13"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_04_cutscene14"
	val[]: "Unused"
#!}

#### 3_04 Driving Instructions



	key[]: "aca_msg_book1_3_04_forward"
	val[]: "<font face=/font/big_bold.font>Ubrzajte i vozite oko prepreka. </font>"

	key[]: "aca_msg_book1_3_04_check1"
	val[]: "Continue into the course and through the first two easy turns.<br><br><font face=/font/big_bold.font>Continue driving. </font>"

	key[]: "aca_msg_book1_3_04_check2"
	val[]: "<font face=/font/big_bold.font>Make the 90-degree turn.</font>"

	key[]: "aca_msg_book1_3_04_check3"
	val[]: "The next part of the course is a double hairpin. How you manoeuvre through the first part will directly affect your path through the second part.<br><br><font face=/font/big_bold.font>Continue with caution. </font>"

	key[]: "aca_msg_book1_3_04_check4"
	val[]: "As you exit the hairpins, keep left to prepare your entry into the narrow section.<br><br><font face=/font/big_bold.font>Continue driving. </font>"

	key[]: "aca_msg_book1_3_04_check5"
	val[]: "<font face=/font/big_bold.font>Continue driving through the narrow section. </font>"

	key[]: "aca_msg_book1_3_04_check6"
	val[]: "Ahead is a couple of easy 90-degree turns.<br><br><font face=/font/big_bold.font>Make the turns. </font>"

	key[]: "aca_msg_book1_3_04_check7"
	val[]: "You're approaching another hairpin. Monitor your trailer in the mirror as you approach. <br><br><font face=/font/big_bold.font>Drive through the hairpin. </font>"

	key[]: "aca_msg_book1_3_04_check8"
	val[]: "The 90-degree turn ahead is much tighter than it looks. Use your space wisely.<br><br><font face=/font/big_bold.font>Continue driving. </font>"

	key[]: "aca_msg_book1_3_04_check9"
	val[]: "The final hairpin is complex, with almost no room to spare. <br><br><font face=/font/big_bold.font>Proceed with caution.</font>"

	key[]: "aca_msg_book1_3_04_check10"
	val[]: "One final 90-degree turn awaits you.<br><br><font face=/font/big_bold.font>Continue Driving. </font>"

	key[]: "aca_msg_book1_3_04_check11"
	val[]: "Nastavite do označenog područja."
#!{
	key[]: "aca_msg_book1_3_04_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_04_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_04_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

#@}

