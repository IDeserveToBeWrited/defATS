#+ Book 1 Scenario 1_05
#@{

#### 1_05 common
	key[]: "aca_scenario_book1_1_05_title"
	val[]: "Svjetla i brisači"

	key[]: "aca_scenario_book1_1_05_desc"
	val[]: "U ovom scenariju istražit ćemo neke od osnovnih kontrola kamiona koje pomažu u održavanju jasnog pogleda na okolinu i čine vašu vožnju predvidljivom za druge sudionike u prometu.<br><br>Naučit ćete koristiti brisače za održavanje dobre vidljivosti prilikom lošeg vremena, kao i kontrole za svjetla i pokazivače smjera."

#### 1_05 goal

	key[]: "aca_goal_book1_1_05_start"
	val[]: "Pokretanje motora"

	key[]: "aca_goal_book1_1_05_parking"
	val[]: "Parkirna svjetla"

	key[]: "aca_goal_book1_1_05_low_beam"
	val[]: "Kratka svjetla"

	key[]: "aca_goal_book1_1_05_high_beam"
	val[]: "Duga svjetla"

	key[]: "aca_goal_book1_1_05_lblinkers"
	val[]: "Lijevi pokazivač smjera"

	key[]: "aca_goal_book1_1_05_rblinkers"
	val[]: "Desni pokazivač smjera"

	key[]: "aca_goal_book1_1_05_hazard"
	val[]: "Svjetla za opasnost"

	key[]: "aca_goal_book1_1_05_wipers"
	val[]: "Brisači vjetrobrana"

	key[]: "aca_goal_book1_1_05_end"
	val[]: "Gašenje motora"

#### 1_05 msg - intro text

	key[]: "aca_msg_book1_1_05_cutscene1"
	val[]: "U ovom scenariju, proći ćemo kroz neke značajke kamiona koje će osigurati da možete vidjeti i biti viđeni u isto vrijeme."

	key[]: "aca_msg_book1_1_05_cutscene2"
	val[]: "Aktivirat ćemo različite sustave rasvjete i naučiti kada je potrebno koristiti svaki od njih."

	key[]: "aca_msg_book1_1_05_cutscene3"
	val[]: "Upravljat ćemo lijevim i desnim žmigavcima."

	key[]: "aca_msg_book1_1_05_cutscene4"
	val[]: "I na kraju, objasnit ćemo kako prilagoditi brisače kako bi osigurali da učinkovito funkcioniraju u različitim jačinama padalina."



#### 1_05 Driving Instructions

	key[]: "aca_msg_book1_1_05_start"
	val[]: "Pogledajmo kako koristiti različite vrste svjetala i kako upravljati brisačima vjetrobrana.<br><br>Kratka i duga svjetla osiguravaju dobar pogled na cestu ispred. Pokazivači smjera i svjetla za opasnost koriste se kako bi drugi sudionici u prometu mogli predvidjeti vaše manevre.<br><br>Brisači se koriste kako bi vjetrobransko staklo bilo čisto od vode i drugih padalina.<font face=/font/big_bold.font><br> <br>Pokrenite motor, ali ne otpuštajte parkirnu kočnicu. </font>"

	key[]: "aca_msg_book1_1_05_parking"
	val[]: "Do sada ste koristili samo dnevna svjetla. Automatski se aktiviraju kada se uključi kontakt i koriste se za bolju vidljivost vozila u normalnim uvjetima. Međutim, sada kada su se uvjeti pogoršali, morat ćete koristiti puni sustav rasvjete.<font face=/font/big_bold.font><br><br>Pritisnite @@imv_nrm_light@@ za uključivanje parkirnih svjetala. </font>"

	key[]: "aca_msg_book1_1_05_low_beam"
	val[]: "@@aca_msg_book1_1_05_low_beam_img@@<br>Parkirna svjetla osvjetljavaju prednja, bočna i stražnja gabaritna svjetla. Koriste se kada ste parkirani u uvjetima lošeg osvjetljenja kako biste bili vidljivi drugim vozačima.<font face=/font/big_bold.font><br><br>Pritisnite @@imv_nrm_light@@ za prebacivanje na kratka svjetla. </font>"

	key[]: "aca_msg_book1_1_05_high_beam_on"
	val[]: "@@aca_msg_book1_1_05_high_beam_on_img@@<br>Kratka prednja svjetla osvjetljavaju cestu ispred vas i poboljšavaju vidljivost vašeg vozila u uvjetima lošeg osvjetljenja.<font face=/font/big_bold.font><br><br>Koristite @@ imv_nrm_hblight@@ za prebacivanje na duga svjetla. </font>"

	key[]: "aca_msg_book1_1_05_high_beam_off"
	val[]: "@@aca_msg_book1_1_05_high_beam_off_img@@<br>Duga svjetla omogućuju vam da vidite dalje niz cestu u uvjetima lošeg osvjetljenja.<br><br>Ipak, budite oprezni kada ih koristite, jer mogu zaslijepiti druge sudionike u prometu, posebno one koji dolaze ususret. Obavezno isključite duga svjetla dok se približavate drugim vozačima.<font face=/font/big_bold.font><br><br>Upotrijebite @@imv_nrm_hblight@@ da biste isključili duga svjetla. </font>"

	key[]: "aca_msg_book1_1_05_lblinker_on"
	val[]: "Sada, pogledajmo pokazivače smjera. Funkcija pokazivača smjera je pružiti vizualni signal drugim sudionicima u prometu o promjeni trake ili smjeru.<font face=/font/big_bold.font><br><br>Pritisnite @@imv_nrm_lblinker@@ za aktivaciju lijevog pokazivača smjera. </font>"

	key[]: "aca_msg_book1_1_05_lblinker_off"
	val[]: "@@aca_msg_book1_1_05_lblinker_off_img@@<br>Primijetit ćete da indikator lijevog signalnog svjetla treperi na kontrolnoj ploči. Lijevi pokazivači smjera također trepere na lijevoj strani kamiona.<font face=/font/big_bold.font><br><br>Sada pritisnite @@imv_nrm_lblinker@@ da biste isključili lijevi pokazivač smjera. </font>"

	key[]: "aca_msg_book1_1_05_rblinker_on"
	val[]: "Signale koji označavaju promjenu smjera treba dati pravodobno, tako da drugi sudionici u prometu imaju vremena predvidjeti vaš manevar i prilagoditi svoju vožnju u skladu s tim.<font face=/font/big_bold.font><br><br>Pritisnite @ @imv_nrm_rblinker@@ za aktiviranje desnog pokazivača smjera. </font>"

	key[]: "aca_msg_book1_1_05_rblinker_off"
	val[]: "@@aca_msg_book1_1_05_rblinker_off_img@@<br>Na kontrolnoj ploči, indikator desnog signalnog svjetla sada treperi. U isto vrijeme, pokazivači smjera trepću na desnoj strani kamiona.<font face=/font/big_bold.font><br><br>Sada pritisnite @@imv_nrm_rblinker@@ da biste isključili desni pokazivač smjera. </font>"

	key[]: "aca_msg_book1_1_05_hazard_on"
	val[]: "@@aca_msg_book1_1_05_hazard_on_img@@<br>Prekidač svjetla za opasnost označen je crvenim logotipom u obliku trokuta. Ova su svjetla važan dio sigurnosti na cesti i trebala bi se koristiti samo u nuždi. Ova funkcija istovremeno aktivira i lijevi i desni pokazivač smjera.<font face=/font/big_bold.font><br><br>Pritisnite @@imv_nrm_flasher4way@@ za uključivanje svjetala za opasnost.</font>"

	key[]: "aca_msg_book1_1_05_hazard_off"
	val[]: "@@aca_msg_book1_1_05_hazard_off_img@@<br>Oba pokazivača smjera sada trepću, što pokazuje da su svjetla opasnosti uključena. U isto vrijeme, pokazivači smjera trepću s obje strane kamiona.<br><br>Svjetla opasnosti obično se koriste kada je kamion zaustavljen na mjestu gdje inače ne bi bio, kao što je bočna strana ceste zbog tehničkih ili mehaničkih problema. Također se mogu koristiti za upozorenje vozačima iza vas na zaustavljeni promet ispred.<font face=/font/big_bold.font><br><br>Sada pritisnite @@imv_nrm_flasher4way@@ za isključivanje svjetala za opasnost. </font>"

	key[]: "aca_msg_book1_1_05_wipers_on"
	val[]: "Sada prijeđimo na brisače vjetrobrana. Brisači vjetrobrana koriste se za uklanjanje kiše i drugih nečistoća s vjetrobrana vozila. Njihova je glavna funkcija održavati vjetrobran čistim i vidljivim. Brisači imaju nekoliko postavki brzine.<br><br><font face=/font/big_bold.font>Pritisnite @@imv_nrm_wipers@@ za postavljanje brisača vjetrobrana na povremeno brisanje. </font>@@aca_goal_tip@@ U karijeri možete koristiti senzor za kišu za automatsko uključivanje brisača kada pada kiša. Postavke @@rain_sensor@@ možete pronaći na zaslonu s opcijama - 'Igranje'."

	key[]: "aca_msg_book1_1_05_wipers2"
	val[]: "Ova postavka omogućuje povremeno aktiviranje brisača. Ovo je korisno kada su oborine vrlo slabe.<br><br>Kao što vidite, kiša je prejaka, a brisači ne mogu pratiti količinu kiše koja pada na vjetrobran.<font face=/font /big_bold.font><br><br>Ponovno pritisnite @@imv_nrm_wipers@@ za prebacivanje brisača vjetrobrana na postavku male brzine. </font>"

	key[]: "aca_msg_book1_1_05_wipers3"
	val[]: "Sada brisači rade konstantnom brzinom kako bi uklonili kišu.<font face=/font/big_bold.font><br><br>Još jednom pritisnite @@imv_nrm_wipers@@ za postavljanje velike brzine. </font>"

	key[]: "aca_msg_book1_1_05_wipers_off"
	val[]: "You can see the wipers are working much faster now to clear the windscreen for maximum visibility. <font face=/font/big_bold.font><br><br>Press @@imv_nrm_wipers@@ to turn the wipers off. </font>@@aca_goal_tip@@ You can also use the @@o_im_wipers_back@@ function to cycle backwards through the wipers speed settings. Check the Options Screen - '@@options_bindings_screen@@' - to see and/or change corresponding controls."

	key[]: "aca_msg_book1_1_05_wipers_off_back"
	val[]: "Možete vidjeti kako brisači sada rade mnogo brže kako bi očistili vjetrobransko staklo za maksimalnu vidljivost. <font face=/font/big_bold.font><br><br>Pritisnite @@imv_nrm_wipersback@@ više puta dok se brisači ne isključe. </font>"

	key[]: "aca_msg_book1_1_05_end"
	val[]: "<font face=/font/big_bold.font>Ugasite svjetla i ugasite motor. </font>"
#@}

#+ Book 1 Scenario 2_01
