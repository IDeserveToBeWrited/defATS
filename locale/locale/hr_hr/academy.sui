	key[]: "aca_book_disclaimer"
	val[]: "<color value=@@clr_sel@@><font face=/font/big_bold.font>@@driving_academy@@ ne služi kao zamjena obuci za vozače.</font><br><br> <color value=@@clr_txt@@>Toplo preporučamo da stupite u kontakt s ovlaštenim ustanovama za obuku vozača kamiona prije nego što pokušate upravljati kamionom u stvarnom životu.<br><br>Ustanove za obuku zainteresirane za upotrebu @@driving_academy@@ kao dopunu u obuci taksista mogu nam se obratiti na academy@scssoft.com."

	key[]: "aca_book_book1_title"
	val[]: "Osnove vožnje kamiona"

	key[]: "aca_book_book1_desc"
