#### 2_01 common
	key[]: "aca_scenario_book1_2_01_title"
	val[]: "Slalom između prometnih čunjeva"

	key[]: "aca_scenario_book1_2_01_desc"
	val[]: "U ovom scenariju naučit ćemo kako upravljati kamionom oko nekih prometnih čunjeva uz pomoć retrovizora."

#### 2_01 goal

	key[]: "aca_goal_book1_2_01_summary"
	val[]: "Slijedeći upute"

	key[]: "aca_goal_book1_2_01_mirror"
	val[]: "Provjera ogledala"

	key[]: "aca_goal_book1_2_01_start"
	val[]: "Početak rada"

