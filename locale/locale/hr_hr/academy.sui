	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

	key[]: "aca_goal_book1_3_01_park_br_on"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

	key[]: "aca_goal_book1_3_01_stop5"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_01_disc6"
	val[]: "@@aca_goal_book1_1_03_stop@@"

#!}
#### 3_01 msg - intro text

	key[]: "aca_msg_book1_3_01_cutscene1"
	val[]: "U ovom ćemo scenariju prvi put pokušati spojiti i odspojiti prikolicu. Pripremite kamion za polazak, a zatim krenite unatrag ispod prikolice iza vas."

	key[]: "aca_msg_book1_3_01_cutscene2"
	val[]: "Spojite prikolicu i povucite je prema naprijed."

	key[]: "aca_msg_book1_3_01_cutscene3"
	val[]: "Zaustavite se u označenom području."

	key[]: "aca_msg_book1_3_01_cutscene4"
	val[]: "Odvojite prikolicu, krenite naprijed."

	key[]: "aca_msg_book1_3_01_cutscene5"
	val[]: "Zaustavite se na parkirnom mjestu i osigurajte kamion."


#### 3_01 Driving Instructions

	key[]: "aca_msg_book1_3_01_start"
	val[]: "U ovom scenariju, razgovarat ćemo o postupcima spajanja i odvajanja šlepera/tegljača i prikolice. Ovo je pojednostavljena procedura u usporedbi sa stvarnošću. <br><br><font face=/font/big_bold.font>Pripremite se za polazak. </font>"

	key[]: "aca_msg_book1_3_01_check_con"
	val[]: "Iza šlepera/tegljača nalazi se prikolica. Polako vozite unatrag ispod prikolice dok sedlo ne udari u spojni klin. Trenutno je kamion ispravno poravnat tako da nema potrebe za upravljanjem, samo krenite ravno unatrag.<br><br><font face=/font/big_bold.font>Polagano krenite unazad dok ne osjetite spoj. </font>"

	key[]: "aca_msg_book1_3_01_park_br_on"
	val[]: "Sedlo se spojilo sa spojnim klinom.<br><br><font face=/font/big_bold.font>Osigurajte kamion povlačenjem parkirne kočnice. </font>"

	key[]: "aca_msg_book1_3_01_connect"
	val[]: "U stvarnom životu, sedlo automatski zaključava spojni klin, a zatim bi vozač kamiona trebao izaći iz vozila kako bi uvukao nogare i spojio zračne i električne vodove. <br><br><font face=/font/big_bold.font>Za nas, jednostavnim pritiskom na @@imv_nrm_attach@@ spojit ćemo prikolicu. </font>"

	key[]: "aca_msg_book1_3_01_park_br_off"
	val[]: "Sada kada je šleper/tegljač sigurno spojen na prikolicu, spremni ste krenuti naprijed. Imajte na umu da je vaše vozilo sada znatno duže i teže te će zahtijevati nove vještine za upravljanje. <br><br><font face=/font/big_bold.font>Oslobodite parkirnu kočnicu i pripremite se za vožnju naprijed. </font>"

	key[]: "aca_msg_book1_3_01_check_discon"
	val[]: "Vozite naprijed.<br><br><font face=/font/big_bold.font>Zaustavite se na označenom području. </font>"

	key[]: "aca_msg_book1_3_01_parking_brake5"
	val[]: "<font face=/font/big_bold.font>Zategnite parkirnu kočnicu. </font>"

	key[]: "aca_msg_book1_3_01_stop5"
	val[]: "<font face=/font/big_bold.font>Aktivirajte parkirnu kočnicu. </font>"

	key[]: "aca_msg_book1_3_01_disc5"
	val[]: "Još jednom, u stvarnom životu, vozač kamiona bi morao izaći iz vozila, spustiti nogare, odvojiti zračne i električne vodove i osloboditi mehanizam za zaključavanje sedla. <br><br><font face=/font/big_bold.font>Pojednostavljujemo ovaj postupak za vas, tako da ćete pritiskom na @@imv_nrm_attach@@ odspojiti prikolicu. </font>"

	key[]: "aca_msg_book1_3_01_park_br_off2"
	val[]: "<font face=/font/big_bold.font>Otpustite parkirnu kočnicu. </font>"

	key[]: "aca_msg_book1_3_01_park_br_off3"
	val[]: "Izvucite šleper/tegljač ispod prikolice i krenite naprijed.<br><br><font face=/font/big_bold.font>Zaustavite se na označenom području. </font>"

	key[]: "aca_msg_book1_3_01_stop"
	val[]: "<font face=/font/big_bold.font>Zaustavite se u označenom području. </font>"
#!{
	key[]: "aca_msg_book1_3_01_end"
	val[]: "@@aca_msg_book1_2_01_end@@"


#!}

#@}

#+ Book 1 Scenario 3_02
#@{

#### 3_02 common
	key[]: "aca_scenario_book1_3_02_title"
	val[]: "Kočenje s prikolicom"

	key[]: "aca_scenario_book1_3_02_desc"
	val[]: "U ovom scenariju, dobit ćete osjećaj za vožnju i kočenje s pričvršćenom prikolicom."

#### 3_02 goal



	key[]: "aca_goal_book1_3_02_forward"
	val[]: "Polazak"

	key[]: "aca_goal_book1_3_02_check1"
	val[]: "Driving Down the Grade"

	key[]: "aca_goal_book1_3_02_check2"
	val[]: "Postizanje brzine od 60 km/h (37 mph)"

	key[]: "aca_goal_book1_3_02_check3"
	val[]: "Primjena kočnica"
#!{
	key[]: "aca_goal_book1_3_02_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_02_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_02_start"
	val[]: "@@aca_goal_book1_2_01_start@@"
 #!}
#### 3_02 msg - intro text

	key[]: "aca_msg_book1_3_02_cutscene01"
	val[]: "In this scenario, we'll take the truck for a short drive. You'll be able to get a feel for braking with a trailer as we descend the mild grade ahead. Prepare the truck and set off."

	key[]: "aca_msg_book1_3_02_cutscene06"
	val[]: "Dostignite brzinu od najmanje 60 km/h (37 mph). Budite spremni za zonu kočenja ispred vas."

	key[]: "aca_msg_book1_3_02_cutscene08"
	val[]: "Počnite kočiti do zaustavljanja. Pazite da ne čekate predugo, inače biste mogli udariti u prepreke ispred sebe!"

	key[]: "aca_msg_book1_3_02_cutscene10"
	val[]: "Parkirajte na predviđenom području, zatim osigurajte kamion i ugasite motor."


#### 3_02 Driving Instructions

	key[]: "aca_msg_book1_3_02_start"
	val[]: "During this drive, you'll get a feel for using the service brakes while descending a mild grade. The purpose of this drill is to become aware of the weight behind you and how it affects the braking distance of the vehicle.<br><br><font face=/font/big_bold.font>Prepare to set off. </font>"

	key[]: "aca_msg_book1_3_02_forward"
	val[]: "Start driving now, and keep in mind you will need to reach a speed of 60 km/h (37 mph) <font face=/font/big_bold.font>after</font> the turn ahead.<br><br><font face=/font/big_bold.font>Drive towards the turn ahead. </font>"

	key[]: "aca_msg_book1_3_02_check1"
	val[]: "Make the right turn, then accelerate to 60 km/h (37 mph).<br><br><font face=/font/big_bold.font>Continue driving. </font>"

	key[]: "aca_msg_book1_3_02_check2"
	val[]: "<font face=/font/big_bold.font>Postignite brzinu od najmanje 60 km/h (37 mph). </font>"

	key[]: "aca_msg_book1_3_02_check3"
	val[]: "Dostigli ste potrebnu brzinu.<br><br><font face=/font/big_bold.font>Zaustavite se na preprekama ispred vas. </font>"
#!{
	key[]: "aca_msg_book1_3_02_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_02_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

