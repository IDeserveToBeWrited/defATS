	#### diag common

	key[]: "aca_scenario_book3_diag_title"
	val[]: "Diagonal Parking with B-doubles"

	key[]: "aca_scenario_book3_diag_desc"
	val[]: "In this scenario, you'll park your B-double combination in a diagonal parking spot in a busy lot. "

#### diag msg - intro text

	key[]: "aca_msg_book3_diag_cutscene1"
	val[]: "Diagonal parking spots like this are very common. They're especially common in older truck stops, as well as the many rest areas across America's interstates."

	key[]: "aca_msg_book3_diag_cutscene2"
	val[]: "Vozite prema označenom parkirnom mjestu blizu kraja reda."

	key[]: "aca_msg_book3_diag_cutscene3"
	val[]: "Stay towards the outside of the lane, but not tight against the barriers as the rear of the trailer may strike them during the turn in."

	key[]: "aca_msg_book3_diag_cutscene4"
	val[]: "Drive past the parking spot to make room for both trailers to follow you in. Then dive towards the far side of the spot to bring your first trailer into position."

	key[]: "aca_msg_book3_diag_cutscene5"
	val[]: "Straighten out, then stop in the designated area and secure the truck."

#### diag Driving Instructions

#!{
	key[]: "aca_msg_book3_diag_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_diag_forward"
	val[]: "Proceed towards the end of the row and find your parking spot."

	key[]: "aca_msg_book3_diag_check1"
	val[]: "Drive past the parking spot to make sure your rear trailer will track correctly into the spot, then turn in while sharply ensuring the front of your lead trailer doesn't contact the truck next to you."

	key[]: "aca_msg_book3_diag_stop"
	val[]: "Continue slowly while straightening up the combination, then stop in the designated area."

#!{
	key[]: "aca_msg_book3_diag_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


