#+ Book 3 Scenario finex
#@{

#### finex common

	key[]: "aca_scenario_book3_finex_title"
	val[]: "Final Exam"

	key[]: "aca_scenario_book3_finex_desc"
	val[]: "In this scenario, you'll put your new skills to the test in a course designed to test your precision and understanding of driving with B-doubles."

#### finex goal

	key[]: "aca_goal_book3_finex_check0"
	val[]: "Reversing"

	key[]: "aca_goal_book3_finex_check1"
	val[]: "Entering The Course"

	key[]: "aca_goal_book3_finex_check2"
	val[]: "Getting To Speed"

	key[]: "aca_goal_book3_finex_check22"
	val[]: "Prepare to Brake"

	key[]: "aca_goal_book3_finex_speed"
	val[]: "Insufficient Speed"

