	key[]: "aca_msg_scenario_reverse_barriers"
	val[]: "Vozite unatrag između prepreka."

	key[]: "aca_msg_scenario_park_forward"
	val[]: "Parkirajte na predviđenom mjestu."

	key[]: "aca_msg_scenario_park_reverse"
	val[]: "Vozite unatrag i parkirajte na predviđenom mjestu."

	key[]: "aca_msg_scenario_checkpoint_reached_title"
	val[]: "Putna točka dosegnuta"

	key[]: "aca_msg_scenario_checkpoint_reached"
	val[]: "Nastavite sa scenarijem."

	key[]: "aca_msg_scenario_end_title"
	val[]: "Parkirno mjesto"

	key[]: "aca_msg_scenario_end"
	val[]: "<font face=/font/big_bold.font>Za kraj scenarija osigurajte kamion i ugasite motor.</font>"

	key[]: "aca_msg_parking_orientation_title"
	val[]: "@@aca_msg_scenario_end_title@@"

	key[]: "aca_msg_parking_orientation"
	val[]: "Na pravom ste mjestu, ali okrenuti u krivom smjeru.<br><br><font face=/font/big_bold.font>Okrenite kamion prije dovršetka scenarija.</font>"

