#+ Chapters general
#@{
	key[]: "aca_chapter_book1_1_title"
	val[]: "Osnovne kontrole i kretanje"

	key[]: "aca_chapter_book1_1_desc"
	val[]: "Naučite osnovne kontrole vozila i kako pomicati kamion naprijed i natrag."

	key[]: "aca_chapter_book1_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Čestitamo!<br>Završili ste 1. poglavlje: @@aca_chapter_book1_1_title@@.<br><br>Naučili ste kako pripremiti kamion prije vožnje,<br>vožnju unaprijed i unazad i kako koristiti svjetla i brisače.</font><br><br>"

	key[]: "aca_chapter_book1_2_title"
	val[]: "Osnovno upravljanje"

	key[]: "aca_chapter_book1_2_desc"
	val[]: "Naučite voziti, upravljati i parkirati s tegljačem. Istražite svrhu svake vrste ogledala i kako ga koristiti."

	key[]: "aca_chapter_book1_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Čestitamo!<br>Završili ste 2. poglavlje: @@aca_chapter_book1_2_title@@.<br><br>Naučili ste kako koristiti svaki retrovizor na kamionu, provjeriti prostor oko kamiona prije kretanja i izvesti osnovna i napredna upravljanja.</font>"

	key[]: "aca_chapter_book1_3_title"
	val[]: "Upravljanje prikolicom"

	key[]: "aca_chapter_book1_3_desc"
	val[]: "Naučite se spojiti i upravljati s prikolicom kroz različite situacije."

	key[]: "aca_chapter_book1_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Čestitamo!<br>Završili ste 3. poglavlje: @@aca_chapter_book1_3_title@@.<br><br>Naučili ste spajanje i odvajanje prikolice,<br>osjetiti težinu i dimenzije kamiona s prikolicom<br>i vožnju zahtjevnim putevima s prikolicom.</font><br><br>"

	key[]: "aca_chapter_book1_4_title"
	val[]: "Vožnja unatrag s prikolicom"

	key[]: "aca_chapter_book1_4_desc"
	val[]: "Naučite nove manevre za učinkovitu vožnju unatrag i parkiranje s prikolicom."

	key[]: "aca_chapter_book1_4_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Čestitamo!<br>Završili ste 4. poglavlje: @@aca_chapter_book1_4_title@@.<br><br>Naučili ste voziti unatrag s prikolicom<br>i razne parkirne tehnike.</font><br><br>"

	key[]: "aca_chapter_book1_5_title"
	val[]: "Završni ispit"

	key[]: "aca_chapter_book1_5_desc"
	val[]: "Pokažite svoje znanje i vještinu kako biste dokazali svoju sposobnost kao vozač kamiona!"

	key[]: "aca_chapter_book1_5_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Čestitamo!<br>Završili ste 5. poglavlje: @@aca_chapter_book1_5_title@@.<br><br>Dokazali ste to imate sve potrebne vještine<br>za vožnju, upravljanje i parkiranje kamiona!</font><br><br>"

	key[]: "aca_chapter_book2_0_title"
	val[]: "Warming Up the Engine"

	key[]: "aca_chapter_book2_0_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Završili ste obuku: @@aca_chapter_book2_0_title@@.<br><br>Naučili ste pravila i značajke vještine upravljanja vozilom.</font><br><br>"

	key[]: "aca_chapter_book2_1_title"
	val[]: "Back in Gear"

	key[]: "aca_chapter_book2_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Congratulations!<br>You've completed Chapter 2: @@aca_chapter_book2_1_title@@.<br><br>You have warmed up the engine, tested the gears, spun the wheels properly, and checked the brake efficiency. The next chapters will be more challenging.</font><br><br>"

	key[]: "aca_chapter_book2_2_title"
	val[]: "Wheels in Motion"

	key[]: "aca_chapter_book2_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Congratulations!<br>You've completed Chapter 3: @@aca_chapter_book2_2_title@@.<br><br>You have mastered difficult and varied scenarios. You have demonstrated skill and performance.</font><br><br>"

	key[]: "aca_chapter_book2_3_title"
	val[]: "The Home Stretch"

	key[]: "aca_chapter_book2_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Čestitamo!<br>Završili ste 4. poglavlje: @@aca_chapter_book2_3_title@@.<br><br>Uspješno ste svladali mnoge zahtjevne situacije pri manevriranju, parkiranju i vožnji unatrag s prikolicom. Dokazali ste da ste vješt vozač, sposoban nositi se sa svim izazovnim situacijama u vožnji kamiona."

	key[]: "aca_chapter_book3_1_title"
	val[]: "Going Forward"

	key[]: "aca_chapter_book3_1_desc"
	val[]: "Learn all the essential techniques for handling a B-double trailer when driving forward."

	key[]: "aca_chapter_book3_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Congratulations!<br>You've completed Chapter 1: @@aca_chapter_book3_1_title@@.<br><br>You have experienced how to drive and manoeuvre with B-double trailers effectively.</font><br><br>"

	key[]: "aca_chapter_book3_2_title"
	val[]: "Reverse Control"

	key[]: "aca_chapter_book3_2_desc"
	val[]: "Understand the necessary steps for handling B-double trailers when reversing."

	key[]: "aca_chapter_book3_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Congratulations!<br>You've completed Chapter 2: @@aca_chapter_book3_2_title@@.<br><br>You have learned the formidable skill of reversing with B-double trailers.</font><br><br>"

	key[]: "aca_chapter_book3_3_title"
	val[]: "Real World Preparation"

	key[]: "aca_chapter_book3_3_desc"
	val[]: "Primijenite svoje novo znanje u složenijim scenarijima."

	key[]: "aca_chapter_book3_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Congratulations!<br>You've completed Chapter 3: @@aca_chapter_book3_3_title@@.<br><br>You have handled many difficult situations in manoeuvring, parking, and reversing with B-double trailers. You've proven yourself here, now it's time to pull some B-doubles on the roads of American Truck Simulator!</font><br><br>"

#@}

