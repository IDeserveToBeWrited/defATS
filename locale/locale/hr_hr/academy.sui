#### 2_06 msg - intro text

	key[]: "aca_msg_book1_2_06_cutscene01"
	val[]: "Za konačni scenarij ovog poglavlja, vozit ćemo se po testnoj stazi sa složenom konfiguracijom."

	key[]: "aca_msg_book1_2_06_cutscene02"
	val[]: "Prvo je slalom kroz prepreke. Vozite kroza nj i ne zaboravite koristiti retrovizore."

	key[]: "aca_msg_book1_2_06_cutscene04"
	val[]: "Slijedi oštar zavoj. Držite se široko i to vam ne bi trebalo predstavljati probleme."

	key[]: "aca_msg_book1_2_06_cutscene05"
	val[]: "The path ahead narrows significantly. Proceed cautiously and use the side mirror to help you."

	key[]: "aca_msg_book1_2_06_cutscene06"
	val[]: "Next is a series of easy 90-degree turns."

	key[]: "aca_msg_book1_2_06_cutscene08"
	val[]: "Sljedeći dio mora biti odrađen unatrag. Pristupite preprekama ispred sebe imajući to na umu."

	key[]: "aca_msg_book1_2_06_cutscene09"
	val[]: "Follow the road markings back and around the curves."

	key[]: "aca_msg_book1_2_06_cutscene10"
	val[]: "Reverse to the barriers, then stop and proceed forwards to the right."

	key[]: "aca_msg_book1_2_06_cutscene11"
	val[]: "This passage through the cones is very narrow. Drive slowly and use your mirrors to orient yourself within the passage."

	key[]: "aca_msg_book1_2_06_cutscene13"
	val[]: "Ahead is a series of alternating left and right 90-degree turns."

	key[]: "aca_msg_book1_2_06_cutscene15"
	val[]: "You may encounter trains at this level crossing. If so, stop and wait. Afterward, you can turn right onto the service road."

	key[]: "aca_msg_book1_2_06_cutscene16"
	val[]: "Turn left onto the roadway. You can pick up some speed after completing your turn."

	key[]: "aca_msg_book1_2_06_cutscene18"
	val[]: "A few more left turns in the town and you'll be at your destination!"

	key[]: "aca_msg_book1_2_06_cutscene19"
	val[]: "Approach the barriers ahead and prepare to park in the parking spot on the right."

	key[]: "aca_msg_book1_2_06_cutscene20"
	val[]: "Reverse into the parking spot, then shut down the engine and secure the truck."

#### 2_06 Driving Instructions



	key[]: "aca_msg_book1_2_06_forward"
	val[]: "Pred vama je slalom sastavljen od prepreka.<br><br><font face=/font/big_bold.font>Vozite kroz slalom.</font>"

	key[]: "aca_msg_book1_2_06_forward2"
	val[]: "<font face=/font/big_bold.font>Follow the path around the hairpin turn. </font>"

	key[]: "aca_msg_book1_2_06_check1"
	val[]: "Put naprijed se znatno sužava. Možete koristiti bočni retrovizor da biste se lakše snašli.<br><br><font face=/font/big_bold.font>Nastavite oprezno. </font>"

	key[]: "aca_msg_book1_2_06_check2"
	val[]: "After the curve is a 90-degree turn.<br><br><font face=/font/big_bold.font>Adjust your speed accordingly.</font>"

	key[]: "aca_msg_book1_2_06_check3"
	val[]: "Ahead are a few more easy turns, continue to adjust your speed as necessary.<br><br><font face=/font/big_bold.font>Continue Driving. </font>"

	key[]: "aca_msg_book1_2_06_check4"
	val[]: "The following section must be completed in reverse. Stop at the barriers ahead so that you can reverse to the right afterwards.<br><br><font face=/font/big_bold.font>Stop at the barriers.</font>"

	key[]: "aca_msg_book1_2_06_check5"
	val[]: "Reverse towards the area behind you and to the right.<br><br><font face=/font/big_bold.font>Start reversing. </font>"

	key[]: "aca_msg_book1_2_06_reverse"
	val[]: "Follow the path around the turns.<br><br><font face=/font/big_bold.font>Keep reversing.</font>"

	key[]: "aca_msg_book1_2_06_check6"
	val[]: "Behind you to the left are some barriers. <br><br><font face=/font/big_bold.font>Turn towards the barriers and be prepared to stop.</font>"

	key[]: "aca_msg_book1_2_06_check7"
	val[]: "Stop and change into a forward gear, then continue to the right. <br><br><font face=/font/big_bold.font>Drive forwards. </font>"

	key[]: "aca_msg_book1_2_06_check8"
	val[]: "In front of you is a narrow winding path through some cones. Drive carefully and use your mirrors if necessary.<br><br><font face=/font/big_bold.font>Drive through the cones. </font>"

	key[]: "aca_msg_book1_2_06_check9"
	val[]: "Next are a combination of different 90-degree turns. Be sure to approach each turn with a wide berth.<br><br><font face=/font/big_bold.font>Continue driving. </font>"

	key[]: "aca_msg_book1_2_06_check10"
	val[]: "Observe the level crossing as you approach it. The signals may activate to indicate an oncoming train.<br><br><font face=/font/big_bold.font>Proceed with caution.</font>"

	key[]: "aca_msg_book1_2_06_check11"
	val[]: "The turn onto the service road is partially blocked by an obstacle, so keep to the left as you approach to give yourself more room.<br><br><font face=/font/big_bold.font>Make the turn. </font>"

	key[]: "aca_msg_book1_2_06_check12"
	val[]: "Možete odabrati hoćete li poslušati ili ignorirati znak stop. Područje je zatvoreno za našu upotrebu.<br><br><font face=/font/big_bold.font>Skrenite lijevo.</font>"

	key[]: "aca_msg_book1_2_06_check13"
	val[]: "You can pick some speed up here, but you will need to turn at the next intersection.<br><br><font face=/font/big_bold.font>Continue along the course. </font>"

	key[]: "aca_msg_book1_2_06_check14"
	val[]: "Nastavite u grad skretanjem lijevo, nakon čega slijede još dva skretanja lijevo do posljednjeg područja.<br><br><font face=/font/big_bold.font>Vozite kroz grad.</font>"

	key[]: "aca_msg_book1_2_06_check15"
	val[]: "On the far side of the lot are some barriers. Drive up to them. <br><br><font face=/font/big_bold.font>Stop near the barriers. </font>"

	key[]: "aca_msg_book1_2_06_check16"
	val[]: "Iza vas s desne strane nalazi se parkirno mjesto.<br><br><font face=/font/big_bold.font>Vozite unatrag na parkirno mjesto. </font>"
#!{
	key[]: "aca_msg_book1_2_06_check17"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_06_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_2_06_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

#@}

#+ Book 1 Scenario 2_08
#@{

#### 2_08 common
	key[]: "aca_scenario_book1_2_08_title"
	val[]: "Simple Training Course"

	key[]: "aca_scenario_book1_2_08_desc"
	val[]: "In this scenario, we'll take the skills you've learned so far and try them out on an easy drive through a simple training course."

#### 2_08 goal
#!{
	key[]: "aca_goal_book1_2_08_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_08_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_2_08_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
#!}
	key[]: "aca_goal_book1_2_08_forward"
	val[]: "Ulazak u stazu"

	key[]: "aca_goal_book1_2_08_check1"
	val[]: "Wide Hairpin Turn"

	key[]: "aca_goal_book1_2_08_check2"
	val[]: "Slalom vožnja"

	key[]: "aca_goal_book1_2_08_check3"
	val[]: "Uski oštri zavoj"

	key[]: "aca_goal_book1_2_08_check4"
	val[]: "Uski zavoj"

	key[]: "aca_goal_book1_2_08_check6"
	val[]: "Tehnički odjel"

	key[]: "aca_goal_book1_2_08_check7"
	val[]: "Otvoreni dio"



#### 2_08 msg - intro text

	key[]: "aca_msg_book1_2_08_cutscene1"
	val[]: "In this scenario, we'll take the tractor unit for a short drive to see how you handle it with your newly acquired skills.<br>There are various types and combinations of turns on the track. It's not a race and it's not about time. Be patient and adjust your driving speed to the turns and obstacles you encounter."

	key[]: "aca_msg_book1_2_08_cutscene2"
	val[]: "Enter the course with a wide hairpin turn."

	key[]: "aca_msg_book1_2_08_cutscene3"
	val[]: "Nadalje, naići ćete na niz prepreka koje će vas odvesti u nepravilan slalom."

	key[]: "aca_msg_book1_2_08_cutscene4"
	val[]: "After completing a couple of easy 90-degree turns, you'll encounter a tight hairpin turn. It's important to set yourself up properly, both to complete the turn and to enter smoothly into the next section."

	key[]: "aca_msg_book1_2_08_cutscene5"
	val[]: "Be mindful of the cones as you drive through the long curve as visibility over the hood is limited."

	key[]: "aca_msg_book1_2_08_cutscene6"
	val[]: "Another set of barriers will guide you into a wide slalom."

	key[]: "aca_msg_book1_2_08_cutscene7"
	val[]: "The track opens up a bit, but don't rush. A few more easy turns and you are done."

	key[]: "aca_msg_book1_2_08_cutscene8"
	val[]: "Stop in the designated area and secure the truck."


#### 2_08 Driving Instructions

	key[]: "aca_msg_book1_2_08_start"
	val[]: "Da biste uspješno dovršili ovaj scenarij, ne smijete se sudariti, skrenuti sa staze ili udariti u prometne čunjeve.<br><br><font face=/font/big_bold.font>Pripremite se za polazak. </font>"

	key[]: "aca_msg_book1_2_08_forward"
	val[]:"<font face=/font/big_bold.font>Proceed forwards into the wide hairpin turn to enter the course. </font>"

	key[]: "aca_msg_book1_2_08_check1"
	val[]: "<font face=/font/big_bold.font>Izvršite oštro skretanje. </font>"

	key[]: "aca_msg_book1_2_08_check2"
	val[]: "You're approaching some barriers arranged roughly into a slalom.<br><br><font face=/font/big_bold.font>Adjust your speed accordingly and continue.</font>"

	key[]: "aca_msg_book1_2_08_check3"
	val[]: "Next, you have two easy 90-degree turns followed by a tight hairpin turn. Take it slow.<br><br><font face=/font/big_bold.font>Continue into the tight hairpin turn.</font>"

	key[]: "aca_msg_book1_2_08_check4"
	val[]: "Exiting the hairpin, you'll encounter a narrow path through a curve. You must stay away from the inside barrier but be mindful not to hit any cones in front of you.<br><br><font face=/font/big_bold.font>Continue through the curve. </font>"

	key[]: "aca_msg_book1_2_08_check6"
	val[]: "Put ispred nas ima nekoliko uskih, tehničkih zavoja. Prilagodite brzinu i pažljivo navigirajte dionicom.<br><br><font face=/font/big_bold.font>Nastavite vožnju. </font>"

	key[]: "aca_msg_book1_2_08_check7"
	val[]: "Sljedeći dio je otvoreniji s nekoliko lakih zavoja. Nemojte žuriti.<br><br><font face=/font/big_bold.font>Nastavite vožnju. </font>"
#!{
	key[]: "aca_msg_book1_2_08_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_08_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

#@}

