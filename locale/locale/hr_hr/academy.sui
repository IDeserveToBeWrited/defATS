	key[]: "aca_goal_book1_2_06_reverse"
	val[]: "Reversing While Turning"

	key[]: "aca_goal_book1_2_06_check6"
	val[]: "Prilazak preprekama"

	key[]: "aca_goal_book1_2_06_check7"
	val[]: "Promjene smjera"

	key[]: "aca_goal_book1_2_06_check8"
