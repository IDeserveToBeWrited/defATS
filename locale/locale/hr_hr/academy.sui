#+ Book 1 Scenario 3_05
#@{

#### 3_05 common
	key[]: "aca_scenario_book1_3_05_title"
	val[]: "Vožnja unatrag s prikolicom"

	key[]: "aca_scenario_book1_3_05_desc"
	val[]: "U ovom ćete se scenariju po prvi put okušati u vožnji unatrag s prikolicom. To je prilično jednostavan manevar, ali ipak ćete morati pravilno upravljati kako biste postavili prikolicu u ispravan položaj."

	#### 3_05 goal



	key[]: "aca_goal_book1_3_05_check_con"
	val[]: "Vožnja unatrag do prikolice"

	key[]: "aca_goal_book1_3_05_connect"
	val[]: "Spajanje prikolice"

	key[]: "aca_goal_book1_3_05_park_br_off"
	val[]: "Otpuštanje parkirne kočnice"

	key[]: "aca_goal_book1_3_05_b_trailer"
	val[]: "Lining up with the Parking Area"

	key[]: "aca_goal_book1_3_05_check1"
	val[]: "Reversing Towards the Parking Area"

	key[]: "aca_goal_book1_3_05_check2"
	val[]: "Lining up with the Parking Area"
#!{
	key[]: "aca_goal_book1_3_05_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_05_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_05_park_br_on"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

	key[]: "aca_goal_book1_3_05_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_05_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"


#!}
#### 3_05 msg - intro text

	key[]: "aca_msg_book1_3_05_cutscene01"
	val[]: "Okušajmo se u vožnji unatrag s prikolicom. Lakše je nego što izgleda; samo trebate biti strpljivi."

	key[]: "aca_msg_book1_3_05_cutscene02"
	val[]: "Počnite voziti unatrag i poravnajte šleper/tegljač s prikolicom."

	key[]: "aca_msg_book1_3_05_cutscene03"
	val[]: "Provjerite jeste li ispravno poravnani ili nećete moći uspostaviti vezu. Ako nije u redu, uvijek se možete povući naprijed i pokušati ponovo."

	key[]: "aca_msg_book1_3_05_cutscene04"
	val[]: "Sedlo šlepera/tegljača zakačit će se na spojni klin prikolice."

	key[]: "aca_msg_book1_3_05_cutscene05"
	val[]: "Primijenite parkirnu kočnicu i spojite prikolicu. U stvarnom životu, morali biste izaći iz kamiona kako biste spojili zračne i električne vodove i podigli stajni trap, ali ovdje ćemo mi to učiniti za vas."

	key[]: "aca_msg_book1_3_05_cutscene05b"
	val[]: "Drive forward and follow the road markings to the right and into the marked lane."

	key[]: "aca_msg_book1_3_05_cutscene05c"
	val[]: "The goal is to line up with the parking area behind you. Once you feel you are relatively in line with it, you can begin reversing."

	key[]: "aca_msg_book1_3_05_cutscene06"
	val[]: "@@aca_msg_book1_3_05_cutscene06_img@@<br>Prikolica će uvijek okrenuti <color value=@@clr_sel@@>suprotno <color value=@@clr_txt@@>od šlepera/tegljača."

	key[]: "aca_msg_book1_3_05_cutscene07"
	val[]: "@@aca_msg_book1_3_05_cutscene07_img@@<br>Da biste okrenuli prikolicu, morat ćete upravljati šleperom/tegljačem u <color value=@@clr_sel@@> suprotnom <color value=@@clr_txt@@> smjeru u kojem želite da prikolica ide."

	key[]: "aca_msg_book1_3_05_cutscene08"
	val[]: "@@aca_msg_book1_3_05_cutscene08_img@@<br>Da ponovno poravnate prikolicu, okrenite šleper/tegljač <br><color value=@@clr_sel@@>prema<color value=@@clr_txt@@> prikolici."

	key[]: "aca_msg_book1_3_05_cutscene09"
	val[]: "Keep the trailer pointed towards the marked area, then try to keep the tractor somewhat aligned with the trailer - you'll have to make constant minor corrections."

	key[]: "aca_msg_book1_3_05_cutscene10"
	val[]: "Ispravite odstupanja od puta malim okretajima volana čim se dogode. Ako \n pretjerate, možete završiti daleko izvan željenog puta."

	key[]: "aca_msg_book1_3_05_cutscene11"
	val[]: "Zaustavite se na predviđenom području. Osigurajte kamion i ugasite motor."

#### 3_05 Driving Instructions

	key[]: "aca_msg_book1_3_05_start"
	val[]: "Iza vas i desno, vidjet ćete prikolicu. Vaš prvi zadatak bit će vožnja unatrag do nje.<br><br><font face=/font/big_bold.font>Pripremite kamion za vožnju unatrag. </font>"

	key[]: "aca_msg_book1_3_05_backward"
	val[]: "<font face=/font/big_bold.font>Počnite voziti unatrag prema prikolici. </font>"

	key[]: "aca_msg_book1_3_05_check_con"
	val[]: "Poravnajte se tako da budete u ravnini s prikolicom. Sedlo mora uhvatiti spojni klin. Povucite prema naprijed za podešavanje ako je potrebno.<br><br><font face=/font/big_bold.font>Nastavite s kretanjem unatrag dok ne osjetite spoj. </font>"

	key[]: "aca_msg_book1_3_05_park_br_on"
	val[]: "Sedlo je priključeno sa spojnim klinom i spremni ste završiti spajanje s prikolicom.<br><br><font face=/font/big_bold.font>Aktivirajte parkirnu kočnicu. </font>"

	key[]: "aca_msg_book1_3_05_connect"
	val[]: "<font face=/font/big_bold.font> Pritisnite @@imv_nrm_attach@@ za povezivanje prikolice. </font>"

	key[]: "aca_msg_book1_3_05_park_br_off"
	val[]: "Sada je prikolica sigurno spojena na šleper/tegljač, zračni i električni vodovi su spojeni, a stajni trap je podignut.<br><br><font face=/font/big_bold.font>Oslobodite parkirnu kočnicu. </font>"

	key[]: "aca_msg_book1_3_05_b_trailer"
	val[]: "To get lined up with the parking area on the left, pull forward and to the right. Use the road markings to help guide you.<br><br><font face=/font/big_bold.font>Drive forwards and line up with the parking area. </font>"

	key[]: "aca_msg_book1_3_05_check1"
	val[]: "Once you are lined up relatively straight with the parking area, you can begin reversing. <br><br><font face=/font/big_bold.font>Start reversing the trailer. </font>"

	key[]: "aca_msg_book1_3_05_check2"
	val[]: "Remember that the trailer will turn in the opposite direction to how you steer the tractor, and that a small turn of the steering wheel can result in significant movement of the trailer. <br><br><font face=/font/big_bold.font>Continue reversing the trailer. </font>"
#!{
	key[]: "aca_msg_book1_3_05_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_05_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

#@}

#+ Book 1 Scenario 3_06
#@{

#### 3_06 common
	key[]: "aca_scenario_book1_3_06_title"
	val[]: "Parkiranje na uskom mjestu"

	key[]: "aca_scenario_book1_3_06_desc"
	val[]: "U ovom scenariju, parkirat ćemo na uskom prostoru.<br><br>Morat ćete upravljati prikolicom da se poravna s pomaknutim parkirnim mjestom."

#### 3_06 goal
