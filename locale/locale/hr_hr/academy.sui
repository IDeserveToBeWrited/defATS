	key[]: "aca_goal_book1_2_09_stopmid"
	val[]: "Zaustavljanje ispred parkirnog mjesta"

	key[]: "aca_goal_book1_2_09_checkmirror"
	val[]: "Provjera retrovizora"

	key[]: "aca_goal_book1_2_09_backward"
	val[]: "Vožnja unatrag na parkirno mjesto"

	key[]: "aca_goal_book1_2_09_stop"
	val[]: "Poravnanje kamiona unutar parkirnog mjesta"

#!{
	key[]: "aca_goal_book1_2_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_09_check1"
	val[]: "@@aca_goal_book1_1_03_forward@@"


	key[]: "aca_goal_book1_2_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"



 #!}
#### 2_09 msg - intro text

	key[]: "aca_msg_book1_2_09_cutscene1"
	val[]: "Bočno parkiranje ključna je vještina koju svaki vozač kamiona treba znati.<br>Pripremite se za polazak."

	key[]: "aca_msg_book1_2_09_cutscene2"
	val[]: "Vozite prema parkirnom mjestu.<br>Obratite pozornost na okolinu."

	key[]: "aca_msg_book1_2_09_cutscene3"
	val[]: "Poravnajte se s kamionom ispred vašeg parkirnog mjesta. Nemojte mu biti preblizu, držite se na određenoj udaljenosti od njega kako biste imali prostora za rad."

	key[]: "aca_msg_book1_2_09_cutscene4"
	val[]: "Naglo skrenite prema mjestu i počnite voziti unatrag."

	key[]: "aca_msg_book1_2_09_cutscene5"
	val[]: "Kada gledate u retrovizor na vozačevoj strani, ciljajte na rubnik koji se nalazi točno ispred kamiona iza vas."

	key[]: "aca_msg_book1_2_09_cutscene6"
	val[]: "Once your front bumper clears the truck ahead of you, you can begin steering the front end of the truck into the spot, aligning the truck with the parking spot."

	key[]: "aca_msg_book1_2_09_cutscene7"
	val[]: "Ispravite kotač i poravnajte kamion unutar parkirnog mjesta.<br>Parkirajte i osigurajte kamion."

#### 2_09 Driving Instructions

	key[]: "aca_msg_book1_2_09_start"
	val[]: "Ispred vas su parkirani kamioni. Ostalo je jedno slobodno mjesto za parkiranje. <br><br><font face=/font/big_bold.font>Pripremite se za polazak. </font>"

	key[]: "aca_msg_book1_2_09_check1"
	val[]: "Ne zaboravite biti svjesni svoje okoline. Dobro koristite svoja retrovizore tijekom ovog manevra. <br><br><font face=/font/big_bold.font>Vozite naprijed. </font>"

	key[]: "aca_msg_book1_2_09_stopmid"
	val[]: "<color value=@@clr_white@@>Prođite pokraj parkirnog mjesta do označenog područja. Odatle možete započeti vožnju unazad.<br><br><font face=/font/big_bold.font>Zaustavite se na označenom mjestu. </font>"

	key[]: "aca_msg_book1_2_09_checkmirror"
	val[]: "Provjerite ima li u okolini prepreka i jeste li sigurni za vožnju unatrag.<br><br><font face=/font/big_bold.font>Pogledajte kroz retrovizor na suvozačevoj strani. </font>"

	key[]: "aca_msg_book1_2_09_backward"
	val[]: "Okrenite kotače i krenite unatrag do parkirnog mjesta.<br><br><font face=/font/big_bold.font>Počnite voziti unatrag. </font>"

	key[]: "aca_msg_book1_2_09_stop"
	val[]: "Počnite ispravljati kamion kada je to potrebno. Nemojte voziti preko rubnika!<br><br><font face=/font/big_bold.font>Poravnajte kamion na mjesto. </font>"
#!{
	key[]: "aca_msg_book1_2_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_01
