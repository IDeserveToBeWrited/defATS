
    key[]: "hint_engine_title"
	val[]: "Starte den Motor"

    key[]: "hint_engine_text"
	val[]: "Drücke $KEY_engine$, um den Motor zu starten."


    key[]: "hint_ignition_title"
	val[]: "Starte die Zündung"

    key[]: "hint_ignition_text"
	val[]: "Verwende $KEY_engineelect|KEY_engine$, um die Zündung zu starten."


    key[]: "hint_driv_arc_title"
	val[]: "Fahren"

    key[]: "hint_driv_arc_text"
	val[]: "Verwende $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ und $KEY_abackward+ALIAS_j_brake+KEY_dbackward$, um vorwärts oder rückwärts zu fahren. Verwende $SPECIAL_steering$, um zu lenken."


    key[]: "hint_driv_auto_title"
	val[]: "Fahren"

    key[]: "hint_driv_auto_text"
	val[]: "Verwende $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ und $KEY_abackward+ALIAS_j_brake+KEY_dbackward$, um vorwärts oder rückwärts zu fahren. <br><offset vshift=8>Verwende $SPECIAL_steering$, um zu lenken.<br><offset vshift=8>Drücke $KEY_gearup$ und $KEY_geardown$, um den Gang zu wählen."


    key[]: "hint_driv_seq_title"
	val[]: "Fahren"

    key[]: "hint_driv_seq_text"
	val[]: "Verwende $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ und $KEY_abackward+ALIAS_j_brake+KEY_dbackward$, um vorwärts oder rückwärts zu fahren. <br><offset vshift=8>Verwende $SPECIAL_steering$, um zu lenken.<br><offset vshift=8>Drücke $KEY_gearup$ und $KEY_geardown$, um die Kupplung zu betätigen."


    key[]: "hint_driv_hshift_title"
	val[]: "Fahren"

    key[]: "hint_driv_hshift_text"
	val[]: "Verwende $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ und $KEY_abackward+ALIAS_j_brake+KEY_dbackward$, um vorwärts oder rückwärts zu fahren. <br><offset vshift=8>Verwende $SPECIAL_steering$, um zu lenken.<br><offset vshift=8>Schalte mit dem <color value=@@clr_sel@@>Schalthebel<color value=@@clr_txt@@>."


    key[]: "hint_depot_deliv_title"
    val[]: "Nähere dich dem Ziel"

    key[]: "hint_depot_deliv_text"
    val[]: "Halte im markierten Bereich an, um den Schwierigkeitsgrad des endgültigen Parkplatzes auszuwählen und die entsprechende Erfahrung zu sammeln."


    key[]: "hint_fin_deliv_title"
    val[]: "Schließe die Lieferung ab"

    key[]: "hint_fin_deliv_text"
    val[]: "Parke auf dem ausgewählten Parkplatz. Du kannst $KEY_activate$ drücken, um diesen Schritt zu überspringen, wenn du dich in der Nähe des Lieferorts befindest."


    key[]: "hint_fin_deliv2_title"
    val[]: "Schließe die Lieferung ab"

    key[]: "hint_fin_deliv2_text"
    val[]: "Parke auf dem ausgewählten Parkplatz. Du kannst ein Widget in den @@desktop_menu_category_options@@ aktivieren, um das Parken zu überspringen."


    key[]: "hint_lights_title"
    val[]: "Schalte das Licht ein"

    key[]: "hint_lights_text"
    val[]: "Verwende $KEY_light$, um die Leuchten zu aktivieren. Durch wiederholtes Drücken kannst du zwischen verschiedenen Modi wechseln."


    key[]: "hint_high_beam_title"
    val[]: "Schalte das Fernlicht ein"

    key[]: "hint_high_beam_text"
    val[]: "Verwende $KEY_hblight$, um das Fernlicht einzuschalten."


    key[]: "hint_wipers_title"
    val[]: "Schalte die Scheibenwischer ein"

    key[]: "hint_wipers_text"
    val[]: "Verwende $KEY_wipers$, um die Scheibenwischer zu aktivieren und zwischen verschiedenen Geschwindigkeitseinstellungen zu wechseln."


    key[]: "hint_zoom_title"
    val[]: "Näher hinsehen"

    key[]: "hint_zoom_text"
    val[]: "Verwende $KEY_camzoom$, um im Innenbereich zu zoomen. Du kannst den Zoom-Modus in @@desktop_menu_category_options@@ auf „Halten” oder „Umschalten” einstellen."


    key[]: "hint_cam_int_title"
    val[]: "Umsehen"

    key[]: "hint_cam_int_text"
    val[]: "Verwende $KEY_cam1$, um die Kamera auf die Innenansicht umzuschalten."


    key[]: "hint_cam_ext_title"
    val[]: "Umsehen"

    key[]: "hint_cam_ext_text"
    val[]: "Du kannst durch Drücken von $KEY_camcycle$ zwischen verschiedenen Kamerawinkeln wechseln. <br><offset vshift=8> Verwende $KEY_cam2$, um die Kamera auf die Außenansicht umzuschalten."


    key[]: "hint_indicators_title"
    val[]: "Blinker"

    key[]: "hint_indicators_text"
    val[]: "Verwende $KEY_lblinker$ und $KEY_rblinker$, um die Blinker einzuschalten."


    key[]: "hint_tow_title"
    val[]: "Abschleppdienst"

    key[]: "hint_tow_text"
    val[]: "Wenn du aus einer schwierigen Situation nicht herauskommst, kannst du den Abschleppdienst in Anspruch nehmen. Um darauf zuzugreifen, öffne das @@quick_info_word@@-Menü mit $KEY_advmouse$."


    key[]: "hint_diff_lock_title"
    val[]: "Differentialsperre"

    key[]: "hint_diff_lock_text"
    val[]: "Wenn du dich nicht fortbewegen kannst, könnte dir die Differentialsperre helfen. Verwende $KEY_diflock$, um sie zu aktivieren, oder schalte die automatische Differentialsperre in @@desktop_menu_category_options@@ ein."


    key[]: "hint_diff_unlock_title"
    val[]: "Differentialsperre aktiviert"

    key[]: "hint_diff_unlock_text"
    val[]: "Du solltest das Differential während der normalen Fahrt ausschalten, sonst riskierst du, dass es kaputt geht. Benutze $KEY_diflock$, um es zu deaktivieren, oder schalte die automatische Differentialsperre in @@desktop_menu_category_options@@ ein."


    key[]: "hint_wipers_off_title"
    val[]: "Schalte die Scheibenwischer aus"

    key[]: "hint_wipers_off_text"
    val[]: "Verwende $KEY_wipers$, um die Scheibenwischer zu deaktivieren und zwischen verschiedenen Geschwindigkeitseinstellungen zu wechseln."


    key[]: "hint_world_map_title"
    val[]: "Kartenansicht"

    key[]: "hint_world_map_text"
    val[]: "Verwende $KEY_navmap$, um die Weltkarte zu öffnen."


    key[]: "hint_pause_title"
    val[]: "@@quick_info_word@@"

    key[]: "hint_pause_text"
    val[]: "Verwende $KEY_advmouse$, um @@quick_info_word@@ zu öffnen – eine Übersicht über deinen Status mit praktischen Tastenkombinationen."


    key[]: "hint_pause_border_title"
    val[]: "Lokale Vorschriften"

    key[]: "hint_pause_border_text"
    val[]: "Verwende $KEY_advmouse$, um @@quick_info_word@@ zu öffnen und die aktuellen Vorschriften für die von dir betretene Region anzuzeigen."


    key[]: "hint_photo_trophy_title"
    val[]: "@@landmark_word@@"

    key[]: "hint_photo_trophy_text"
    val[]: "Öffne @@quick_info_word@@ mit $KEY_advmouse$, um den @@photo_mode_word@@ aufzurufen und die nahegelegene @@landmark_word@@ <img src=/material/ui/map/photo_sight_not_captured.mat width=20 height=20> aufzunehmen."


    key[]: "hint_viewpoint_title"
    val[]: "@@viewpoint_title@@ in der Nähe"

    key[]: "hint_viewpoint_text"
    val[]: "@@viewpoint_title@@ <img src=/material/ui/map/viewpoint_unseen.mat width=20 height=20> befindet sich in der Nähe – finde es und aktiviere es, um die Zwischensequenz anzusehen."


    key[]: "hint_resting_title"
    val[]: "Rastplatz in der Nähe"

    key[]: "hint_resting_text"
    val[]: "Rastplätze <img src=/material/ui/map/parking_ico.mat width=20 height=20> helfen dir, wieder fit zu werden und deine Pflichtpause einzulegen, damit du deine Fahrt sicher fortsetzen kannst."


    key[]: "hint_gas_title"
    val[]: "Tankstelle in der Nähe"

    key[]: "hint_gas_text"
    val[]: "Tankstellen <img src=/material/ui/map/gas_ico.mat width=20 height=20> können zum Auftanken deines Fahrzeugs genutzt werden."


    key[]: "hint_car_job_title"
    val[]: "Erster Kurierauftrag"

    key[]: "hint_car_job_text"
    val[]: "Führe die Lieferung durch – fahre vorsichtig, gehe sorgsam mit der Fracht um und komme zur vereinbarten Zeit an. Achte auf die Priorität des Kunden, die die Bewertung und Vergütung beeinflussen.<br><offset vshift=8>Drücke $KEY_advmouse$, um dir die Details des Auftrags anzusehen."


    key[]: "hint_tour_board_title"
    val[]: "Touristen-Tafel"

    key[]: "hint_tour_board_text"
    val[]: "Es befindet sich eine Touristen-Tafel in der Nähe. Aktiviere es, um die Inhalte im <color value=@@clr_sel@@>@@tourist_atlas_link@@</color> freizuschalten und dich bei der Erkundung der Sehenswürdigkeiten und Attraktionen in der Umgebung leiten zu lassen."


    key[]: "hint_tb_first_title"
    val[]: "Erster Ort erkundet"

    key[]: "hint_tb_first_text"
    val[]: "Du hast den ersten Standort einer regionalen Touristen-Tafel erkundet. Du kannst dir die Details im <color value=@@clr_sel@@>@@tourist_atlas_link@@</color> ansehen. Erkunde alle Orte, um mehr zu erfahren und Belohnungen zu verdienen."


    key[]: "hint_tb_bef_compl_title"
    val[]: "Ein Ort übrig"

    key[]: "hint_tb_bef_compl_text"
    val[]: "Es ist nur noch ein Ort übrig, um deine erste Touristen-Tafel vollständig zu erkunden und deine Postkarte zu verdienen."


    key[]: "hint_tb_done_title"
    val[]: "Touristen-Tafel erkundet"

    key[]: "hint_tb_done_text"
    val[]: "Du hast alle Standorte einer regionalen Touristen-Tafel erkundet. Du kannst dir die Details im <color value=@@clr_sel@@>@@tourist_atlas_link@@</color> ansehen. Als Belohnung kannst du jetzt die Postkarte in deinem Fahrzeug ausstellen."


    key[]: "hint_vehicle_prio_title"
    val[]: "Kundenpriorität – Fahrzeugzustand"

    key[]: "hint_vehicle_prio_text"
    val[]: "Der Kunde hat eine höhere Priorität auf den Fahrzeugzustand gelegt – deine Bonusvergütung oder Strafe wird stark vom Zustand des Fahrzeugs abhängen, in dem du ankommst. Fahre vorsichtig und kümmere dich gut um dein Fahrzeug.<br><offset vshift=8>Drücke $KEY_advmouse$, um die Auftragsdetails anzusehen."


    key[]: "hint_cargo_prio_title"
    val[]: "Kundenpriorität – Frachthandhabung"

    key[]: "hint_cargo_prio_text"
    val[]: "Der Kunde hat eine höhere Priorität auf die Frachthandhabung gelegt – deine Bonusvergütung oder Strafe wird stark vom Zustand der Fracht abhängen. Fahre vorsichtig und kümmere dich gut um deine Fracht.<br><offset vshift=8>Drücke $KEY_advmouse$, um die Auftragsdetails anzusehen."


    key[]: "hint_time_prio_title"
    val[]: "Kundenpriorität – Zeitmanagement"

    key[]: "hint_time_prio_text"
    val[]: "Der Kunde hat eine höhere Priorität auf das Zeitmanagement gelegt – deine Bonusvergütung oder Strafe wird stark von deiner Pünktlichkeit abhängen. Fahre vorsichtig und erreiche das Ziel zur vereinbarten Zeit.<br><offset vshift=8>Drücke $KEY_advmouse$, um die Auftragsdetails anzusehen."


    key[]: "hint_car_deliv_title"
    val[]: "Nähere dich dem Zielort"

    key[]: "hint_car_deliv_text"
    val[]: "Halte im markierten Bereich an, um die Lieferung abzuschließen."


    key[]: "hint_car_early_title"
	val[]: "Frühzeitige Ankunft"

    key[]: "hint_car_early_text"
    val[]: "Die Lieferung wird zu einer bestimmten Uhrzeit erwartet, und eine vorzeitige Ankunft führt zu Unzufriedenheit beim Kunden. Plane deine Fahrt und nutze bei Bedarf die verfügbaren Rastplätze."


#!{
    key[]: "hint_sm_throttle_title"
	val[]: "@@throttle_double_tap@@"
#!}

    key[]: "hint_sm_throttle_text"
    val[]: "Du kannst die intelligente Gasregelung unter @@desktop_menu_category_options@@ aktivieren. Wenn du diese Funktion aktivierst, fährt das Fahrzeug standardmäßig mit geringem Gas. Nach zweimaligem schnellem Drücken der Gas-Taste fährt das Fahrzeug mit Vollgas, bis die Taste losgelassen wird."
