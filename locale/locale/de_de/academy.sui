#### 3_04 msg - intro text

	key[]: "aca_msg_book1_3_04_cutscene01"
	val[]: "Denke immer daran, vorausschauend in die Kurven zu fahren und den vorhandenen Platz optimal zu nutzen. Lenke um die erste Reihe von Absperrungen und folge dem Kurs."

	key[]: "aca_msg_book1_3_04_cutscene02"
	val[]: "Die ersten Kurven werden nach und nach immer enger."

	key[]: "aca_msg_book1_3_04_cutscene03"
	val[]: "Denke daran: Die Art, wie du aus einer Kurve herausfährst, beeinflusst deine Linie für die nächste Kurve."

	key[]: "aca_msg_book1_3_04_cutscene04"
	val[]: "Die erste der schwierigeren Kurven besteht aus zwei aufeinanderfolgenden Kehren. Fahre hier besonders konzentriert und nutze deine Spiegel, um die Übersicht zu behalten."

	key[]: "aca_msg_book1_3_04_cutscene05"
	val[]: "Fahre weiter durch den engen Abschnitt."

	key[]: "aca_msg_book1_3_04_cutscene06"
	val[]: "Als Nächstes kommen ein paar einfache Kurven, bevor du zu einer engen Kehre gelangst."

	key[]: "aca_msg_book1_3_04_cutscene07"
	val[]: "Behalte alles im Blick, damit du keine Absperrungen triffst. Fahre so langsam, wie es nötig ist."

	key[]: "aca_msg_book1_3_04_cutscene08"
	val[]: "Selbst wenn es nach viel Platz zum Manövrieren aussieht, kann es trotzdem schnell eng werden."

	key[]: "aca_msg_book1_3_04_cutscene09"
	val[]: "Die anspruchsvollste Kurve liegt direkt vor dir. Deine Anfahrt auf die Kurve entscheidet darüber, ob du sie erfolgreich meistern wirst oder nicht."

	key[]: "aca_msg_book1_3_04_cutscene10"
	val[]: "Fahre durch die letzte Kurve."

	key[]: "aca_msg_book1_3_04_cutscene11"
	val[]: "Halte im vorgesehenen Bereich an, sichere den Lkw und schalte den Motor aus."
#!{
	key[]: "aca_msg_book1_3_04_cutscene12"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_04_cutscene13"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_04_cutscene14"
	val[]: "Unused"
#!}

#### 3_04 Driving Instructions



	key[]: "aca_msg_book1_3_04_forward"
	val[]: "<font face=/font/big_bold.font>Beschleunige und fahre um die Absperrungen herum.</font>"

	key[]: "aca_msg_book1_3_04_check1"
	val[]: "Fahre weiter in den Kurs und durch die ersten beiden leichten Kurven.<br><br><font face=/font/big_bold.font>Fahre weiter.</font>"

	key[]: "aca_msg_book1_3_04_check2"
	val[]: "<font face=/font/big_bold.font>Nimm die 90-Grad-Kurve.</font>"

	key[]: "aca_msg_book1_3_04_check3"
	val[]: "Der nächste Abschnitt des Kurses ist eine doppelte Kehre. Wie du den ersten Abschnitt fährst, wirkt sich direkt auf deinen Weg durch den zweiten Abschnitt aus.<br><br><font face=/font/big_bold.font>Fahre vorsichtig weiter.</font>"

	key[]: "aca_msg_book1_3_04_check4"
	val[]: "Beim Verlassen der Kehren halte dich links, um optimal in den engen Abschnitt einzufahren.<br><br><font face=/font/big_bold.font>Fahre weiter.</font>"

	key[]: "aca_msg_book1_3_04_check5"
	val[]: "<font face=/font/big_bold.font>Fahre weiter durch den engen Abschnitt.</font>"

	key[]: "aca_msg_book1_3_04_check6"
	val[]: "Vor dir liegen ein paar einfache 90-Grad-Kurven.<br><br><font face=/font/big_bold.font>Nimm die Kurven.</font>"

	key[]: "aca_msg_book1_3_04_check7"
	val[]: "Du näherst dich einer weiteren Kehre. Behalte deinen Auflieger im Spiegel im Blick, während du heranfährst.<br><br><font face=/font/big_bold.font>Fahre durch die Kehre.</font>"

	key[]: "aca_msg_book1_3_04_check8"
	val[]: "Die 90-Grad-Kurve vor dir ist viel enger, als sie aussieht. Nutze den vorhandenen Platz gut.<br><br><font face=/font/big_bold.font>Fahre weiter.</font>"

	key[]: "aca_msg_book1_3_04_check9"
	val[]: "Die letzte Kehre ist anspruchsvoll und lässt kaum Spielraum.<br><br><font face=/font/big_bold.font>Fahre vorsichtig weiter.</font>"

	key[]: "aca_msg_book1_3_04_check10"
	val[]: "Eine letzte 90-Grad-Kurve erwartet dich.<br><br><font face=/font/big_bold.font>Fahre weiter.</font>"

	key[]: "aca_msg_book1_3_04_check11"
	val[]: "Fahre zum ausgewiesenen Bereich."
#!{
	key[]: "aca_msg_book1_3_04_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_04_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_04_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

