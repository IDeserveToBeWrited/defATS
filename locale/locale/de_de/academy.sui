	val[]: "Folge den Wegpunkten und achten auf deren Ausrichtung."

	key[]: "aca_msg_scenario_reverse_in_forward_out"
	val[]: "Fahre rückwärts in die markierte Stelle hinein und dann wieder vorwärts heraus."

	key[]: "aca_msg_scenario_forward_in_reverse_out"
	val[]: "Fahre vorwärts in die markierte Stelle hinein und dann rückwärts wieder heraus."

	key[]: "aca_msg_scenario_reverse_continue"
	val[]: "Weiter rückwärts fahren."

	key[]: "aca_msg_scenario_reverse_start"
	val[]: "Beginne mit dem Rückwärtsfahren."

	key[]: "aca_msg_scenario_reverse_barriers"
	val[]: "Fahre rückwärts zwischen den Barrieren hindurch."

	key[]: "aca_msg_scenario_park_forward"
	val[]: "Halte im vorgesehenen Bereich an."

	key[]: "aca_msg_scenario_park_reverse"
	val[]: "Rückwärts einparken und auf dem dafür vorgesehenen Platz parken."

	key[]: "aca_msg_scenario_checkpoint_reached_title"
	val[]: "Wegpunkt erreicht"

	key[]: "aca_msg_scenario_checkpoint_reached"
	val[]: "Fahre mit dem Szenario fort."

	key[]: "aca_msg_scenario_end_title"
	val[]: "Parkplatz"

	key[]: "aca_msg_scenario_end"
