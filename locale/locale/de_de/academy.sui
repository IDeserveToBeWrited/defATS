	key[]: "aca_msg_parking_orientation"
	val[]: "Du bist am richtigen Ort, aber in der falschen Richtung. <br><br><font face=/font/big_bold.font>Wende den Lkw, bevor du das Szenario abschließst. </font>"

#@}


#+ Book 1 intro
#@{

	key[]: "aca_scenario_book1_intro_title"
	val[]: "Grundlagen des\nLKW-Fahren"

	key[]: "aca_msg_book1_intro_cutscene01"
	val[]: "Willkommen in der @@Fahrschule@@."

	key[]: "aca_msg_book1_intro_cutscene02"
	val[]: "Die folgenden Lektionen repräsentieren den ersten Schritt deiner Entwicklung zum professionellem Lkw Fahren."

	key[]: "aca_msg_book1_intro_cutscene03"
	val[]: "Hier lernst du alles von den grundlegenden Systemen bis zu der Steuerung des Lkws..."

	key[]: "aca_msg_book1_intro_cutscene04"
	val[]: "...zu komplexen Manövern mit und ohne Auflieger."

	key[]: "aca_msg_book1_intro_cutscene05"
	val[]: "Wir helfen dir, Gewohnheiten zu entwickeln, die dir dabei helfen, eine Vielzahl von Situationen sicher zu meistern,"

	key[]: "aca_msg_book1_intro_cutscene06"
	val[]: "und zeigen dir, wie du den verfügbaren Raum klug nutzt, um deinen Lkw effektiv zu manövrieren."

	key[]: "aca_msg_book1_intro_cutscene07"
	val[]: "Indem du alle Lektionen abschließt und die Abschlussprüfungen bestehst,"

	key[]: "aca_msg_book1_intro_cutscene08"
	val[]: "wirst du bereit sein, die Straßen Amerikas zu erobern und dich neuen Herausforderungen zu stellen."

#@}

