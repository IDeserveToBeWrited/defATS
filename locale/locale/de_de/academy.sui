	#### diag common

	key[]: "aca_scenario_book3_diag_title"
	val[]: "Diagonales Parken mit B-Doubles"

	key[]: "aca_scenario_book3_diag_desc"
	val[]: "In diesem Szenario parken Sie Ihren B-Double-Sattelzug auf einem diagonalen Parkplatz in einem stark frequentierten Parkhaus. "

#### diag msg - intro text

	key[]: "aca_msg_book3_diag_cutscene1"
	val[]: "Diagonale Parkplätze wie dieser sind sehr verbreitet. Sie sind besonders häufig an älteren Raststätten sowie an den vielen Rastplätzen entlang der amerikanischen Autobahnen zu finden."

	key[]: "aca_msg_book3_diag_cutscene2"
	val[]: "Fahre in Richtung der vorgesehenen Parklücke am Ende der Reihe."

	key[]: "aca_msg_book3_diag_cutscene3"
	val[]: "Bleibe am äußeren Rand der Fahrspur, aber nicht zu nah an den Leitplanken, da das Heck des Anhängers beim Einbiegen gegen diese stoßen könnte."

	key[]: "aca_msg_book3_diag_cutscene4"
	val[]: "Fahre am Parkplatz vorbei, um Platz für die beiden Anhänger zu schaffen, die dir folgen. Halte dich dann auf der anderen Seite des Parkplatzes, um deinen ersten Anhänger in Position zu bringen."

	key[]: "aca_msg_book3_diag_cutscene5"
	val[]: "Richte das Fahrzeug aus, halte dann im dafür vorgesehenen Bereich an und sichere den Lkw."

#### diag Driving Instructions

#!{
	key[]: "aca_msg_book3_diag_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_diag_forward"
	val[]: "Fahre bis zum Ende der Reihe und suche dir einen Parkplatz."

	key[]: "aca_msg_book3_diag_check1"
	val[]: "Fahre am Parkplatz vorbei, um sicherzustellen, dass dein hinterer Anhänger korrekt in die Parklücke passt, und wende dann, wobei du darauf achtest, dass die Vorderseite deines vorderen Anhängers nicht mit dem neben dir stehenden Lkw in Berührung kommt."

	key[]: "aca_msg_book3_diag_stop"
	val[]: "Fahre langsam fort, während du die Kombination aufrichtest, und halte dann im dafür vorgesehenen Bereich an."

#!{
	key[]: "aca_msg_book3_diag_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


