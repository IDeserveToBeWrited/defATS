#+ Book 1 Scenario 2_04
#@{

#### 2_04 common
	key[]: "aca_scenario_book1_2_04_title"
	val[]: "Parken neben einem Hindernis"

	key[]: "aca_scenario_book1_2_04_desc"
	val[]: "In dieser Lektion lernen wir, mithilfe des Seitenspiegels neben einem Bordstein zu parken."

#### 2_04 goal

	key[]: "aca_goal_book1_2_04_mirror"
	val[]: "Überprüfe den Seitenspiegel"

	key[]: "aca_goal_book1_2_04_check1"
	val[]: "Auf den Bordstein zufahren"

#!{
	key[]: "aca_goal_book1_2_04_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_04_forward"
	val[]: "@@aca_goal_book1_1_03_forward@@"


	key[]: "aca_goal_book1_2_04_check2"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_2_04_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

 #!}

#### 2_04 msg - intro text

	key[]: "aca_msg_book1_2_04_cutscene1"
	val[]: "Der Seitenspiegel ist ein weiteres Hilfsmittel, das dir beim sicheren Manövrieren des Lkw hilft. Er befindet sich am oberen Rahmen der Beifahrertür."

	key[]: "aca_msg_book1_2_04_cutscene2"
	val[]: "Diese Holzplanken stellen einen Bordstein dar. Du musst daneben parken.<br>Lenke in Richtung des Bordsteins, um den Lkw in eine gute Position zu bringen und die Parklücke sauber anzufahren."

	key[]: "aca_msg_book1_2_04_cutscene3"
	val[]: "Bremse gut vor dem Bordstein ab und lenke in Richtung der Parklücke. Während du den Lkw geradeaus ausrichtest, kannst du den Seitenspiegel nutzen, um den Abstand zum Bordstein einzuschätzen."

	key[]: "aca_msg_book1_2_04_cutscene4"
	val[]: "Halte in der Parklücke an und sichere den Lkw."

#### 2_04 Driving Instructions

	key[]: "aca_msg_book1_2_04_mirror"
	val[]: "@@aca_msg_book1_2_04_mirror_img@@<br><font face=/font/big_bold.font>Schaue durch das Fenster auf der Beifahrerseite. Dort siehst du den Seitenspiegel.</font>@@aca_goal_tip@@ Du musst dich im Fahrzeug befinden."

	key[]: "aca_msg_book1_2_04_start"
	val[]: "@@aca_msg_book1_2_04_start_img@@<br>Der Seitenspiegel deckt den Bereich auf der Beifahrerseite ab, den der Fahrer nicht einsehen kann. Es ist einer der problematischsten toten Winkel am Lkw. Wenn der Winkel des Spiegels dir nicht zusagt, kannst du ihn in '@@adjust_link_t@@' anpassen.<br><br><font face=/font/big_bold.font>Bereite dich auf die Abfahrt vor.</font>"

	key[]: "aca_msg_book1_2_04_start_fail"
	val[]: "Der Lkw ist noch nicht abfahrbereit – hast du vielleicht etwas übersehen?<br><br>Ist der Motor eingeschaltet? Hast du die Feststellbremse gelöst?"

	key[]: "aca_msg_book1_2_04_forward"
	val[]: "Vor dir befindet sich eine Reihe von Planken, die einen Bordstein darstellen. Am Ende des Bordsteins liegt eine Parklücke, die du anfahren musst.<br><br><font face=/font/big_bold.font>Fahre los, wenn du bereit bist. </font>"

	key[]: "aca_msg_book1_2_04_check1"
	val[]: "Lenke in Richtung Bordstein. Nutze den Seitenspiegel, um deine Position im Verhältnis zum Bordstein zu überprüfen, achte jedoch darauf, keine Leitkegel zu überfahren.<br><br><font face=/font/big_bold.font>Fahre zum Bordstein und in die Parklücke.</font>"
#!{
	key[]: "aca_msg_book1_2_04_check2"
	val[]: "@@aca_msg_book1_2_01_stop@@"
#!}
	key[]: "aca_msg_book1_2_04_end"
	val[]: "<font face=/font/big_bold.font>Sichere den Lkw und schalte den Motor aus.</font>@@aca_goal_tip@@ Du kannst voreingestellte Innenansichten nutzen, um die Spiegel leichter im Blick zu behalten. Sieh dir im Optionsmenü unter „Tasten und Knöpfe“ die entsprechenden Steuerungen an oder ändere sie nach Bedarf."
#@}

#+ Book 1 Scenario 2_05
#@{

#### 2_05 common
	key[]: "aca_scenario_book1_2_05_title"
	val[]: "Rückwärtseinparken neben einem Hindernis"

	key[]: "aca_scenario_book1_2_05_desc"
	val[]: "In dieser Lektion werden wir den Lkw rückwärts in eine Parklücke neben einem Bordstein einparken."

#### 2_05 goal
	key[]: "aca_goal_book1_2_05_summary"
	val[]: "Anweisung"
#!{
	key[]: "aca_goal_book1_2_05_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_05_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

#!}
	key[]: "aca_goal_book1_2_05_backward"
	val[]: "Auf den Bordstein rückwärts fahren"

	key[]: "aca_goal_book1_2_05_stop"
	val[]: "Den Lkw parken"



#### 2_05 msg - intro text

	key[]: "aca_msg_book1_2_05_cutscene1"
	val[]: "In dieser Lektion führen wir eine Rückwärtsfahrt durch, um neben einem Bordstein zu parken."

	key[]: "aca_msg_book1_2_05_cutscene2"
	val[]: "Fahre rückwärts in Richtung des Bordsteins.<br>Sei dir deiner Umgebung beim Rückwärtsfahren bewusst und nutze deine Spiegel."

	key[]: "aca_msg_book1_2_05_cutscene3"
	val[]: "Wenn du näher kommst, kannst du beginnen, den Lkw mit der Parklücke auszurichten. Behalte beim Rückwärtsfahren beide Seiten des Lkw im Blick."

	key[]: "aca_msg_book1_2_05_cutscene4"
	val[]: "Halte in der Parklücke an und sichere den Lkw."

#### 2_05 Driving Instructions

	key[]: "aca_msg_book1_2_05_start"
	val[]: "Die Parklücke befindet sich hinter dir auf der Beifahrerseite. Nutze deine Spiegel, um den Weg zur Parklücke zu finden.<br><br><font face=/font/big_bold.font>Bereite dich auf die Abfahrt vor. </font>"

	key[]: "aca_msg_book1_2_05_backward"
	val[]: "Denke daran, deine Spiegel zu nutzen, um deine Umgebung zu überprüfen, bevor du den Lkw bewegst.<br><br><font face=/font/big_bold.font>Beginne, rückwärts in Richtung des Bordsteins zu fahren.</font>"

	key[]: "aca_msg_book1_2_05_stop"
	val[]: "Beobachte weiterhin deine Umgebung, während du rückwärts in die Parklücke fährst.<br><br><font face=/font/big_bold.font>Halte an der vorgesehenen Stelle an.</font>"
#!{
	key[]: "aca_msg_book1_2_05_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 2_06
#@{

#### 2_06 common
	key[]: "aca_scenario_book1_2_06_title"
	val[]: "Fortgeschrittener Trainingskurs"

	key[]: "aca_scenario_book1_2_06_desc"
	val[]: "Die letzte Lektion in diesem Kapitel ist eine Fahrt auf einem fortgeschrittenen Trainingskurs. Wir werden die Fähigkeiten, die du mit einer Zugmaschine erlernt hast, auf die Probe stellen!"

#### 2_06 goal
#!{
	key[]: "aca_goal_book1_2_06_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_06_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_2_06_check16"
	val[]: "@@aca_scenario_book1_1_04_title@@"

#!}
	key[]: "aca_goal_book1_2_06_forward"
	val[]: "Slalom"

	key[]: "aca_goal_book1_2_06_forward2"
	val[]: "Kehre"

	key[]: "aca_goal_book1_2_06_check1"
	val[]: "Enge Durchfahrt"

	key[]: "aca_goal_book1_2_06_check2"
	val[]: "90-Grad-Kurve"

	key[]: "aca_goal_book1_2_06_check3"
	val[]: "Offener Abschnitt"

	key[]: "aca_goal_book1_2_06_check4"
	val[]: "Annäherung an den Bereich zum Rückwärtsfahren"

	key[]: "aca_goal_book1_2_06_check5"
	val[]: "Richtungswechsel"

	key[]: "aca_goal_book1_2_06_reverse"
	val[]: "Rückwärtsfahren in der Kurve"

	key[]: "aca_goal_book1_2_06_check6"
	val[]: "Annäherung an Absperrungen"

	key[]: "aca_goal_book1_2_06_check7"
	val[]: "Richtungswechsel"

	key[]: "aca_goal_book1_2_06_check8"
	val[]: "Enge S-Kurve"

	key[]: "aca_goal_book1_2_06_check9"
	val[]: "90-Grad-Kurve"

	key[]: "aca_goal_book1_2_06_check10"
	val[]: "Bahnübergang"

	key[]: "aca_goal_book1_2_06_check11"
	val[]: "Rechts abbiegen auf die Zufahrtsstraße"

	key[]: "aca_goal_book1_2_06_check12"
	val[]: "Links abbiegen auf die Fahrbahn"

	key[]: "aca_goal_book1_2_06_check13"
	val[]: "Gerader Abschnitt"

	key[]: "aca_goal_book1_2_06_check14"
	val[]: "Links abbiegen"

	key[]: "aca_goal_book1_2_06_check15"
	val[]: "Annäherung an die Absperrungen"


	key[]: "aca_goal_book1_2_06_check17"
	val[]: "Parken in der ausgewiesenen Fläche"



#### 2_06 msg - intro text

	key[]: "aca_msg_book1_2_06_cutscene01"
	val[]: "Für die letzte Lektion dieses Kapitels fahren wir auf dem Prüfungsparcours mit einer komplexen Konfiguration."

	key[]: "aca_msg_book1_2_06_cutscene02"
	val[]: "Das erste Hindernis ist ein Slalom durch einige Absperrungen. Fahre hindurch und denke daran, deine Spiegel zu benutzen."

	key[]: "aca_msg_book1_2_06_cutscene04"
	val[]: "Als Nächstes folgt eine Kehre. Halte die Kurve weit, dann sollte sie dir keine Probleme bereiten."

	key[]: "aca_msg_book1_2_06_cutscene05"
	val[]: "Der Weg verengt sich deutlich. Fahre vorsichtig und nutze den Seitenspiegel zur Unterstützung."

	key[]: "aca_msg_book1_2_06_cutscene06"
	val[]: "Es folgt eine Reihe von einfachen 90-Grad-Kurven."

	key[]: "aca_msg_book1_2_06_cutscene08"
	val[]: "Der nächste Abschnitt muss rückwärts gefahren werden. Denke daran, wenn du dich den Absperrungen näherst."

	key[]: "aca_msg_book1_2_06_cutscene09"
	val[]: "Folge den Straßenmarkierungen zurück und um die Kurven."

	key[]: "aca_msg_book1_2_06_cutscene10"
	val[]: "Rückwärts bis zu den Absperrungen fahren, dann anhalten und vorwärts nach rechts weiterfahren."

	key[]: "aca_msg_book1_2_06_cutscene11"
	val[]: "Die Passage durch die Leitkegel ist sehr eng. Fahre langsam und nutze deine Spiegel, um dich innerhalb der Passage zu orientieren."

	key[]: "aca_msg_book1_2_06_cutscene13"
	val[]: "Vor dir liegt eine Reihe abwechselnder linker und rechter 90-Grad-Kurven."

	key[]: "aca_msg_book1_2_06_cutscene15"
	val[]: "An diesem Bahnübergang können dir Züge begegnen. Halte in diesem Fall an und warte. Danach kannst du rechts auf die Zufahrtsstraße abbiegen."

	key[]: "aca_msg_book1_2_06_cutscene16"
	val[]: "Biege links auf die Fahrbahn ab. Nach dem Abbiegen kannst du etwas Geschwindigkeit aufnehmen."

	key[]: "aca_msg_book1_2_06_cutscene18"
	val[]: "Noch ein paar Mal in der Stadt links abbiegen und du bist am Ziel!"

	key[]: "aca_msg_book1_2_06_cutscene19"
	val[]: "Fahre auf die Absperrungen zu und bereite dich darauf vor, auf dem Parkplatz auf der rechten Seite zu parken."

	key[]: "aca_msg_book1_2_06_cutscene20"
	val[]: "Fahre rückwärts in die Parklücke, stelle dann den Motor ab und sichere den Lkw."

#### 2_06 Driving Instructions



	key[]: "aca_msg_book1_2_06_forward"
	val[]: "Vor dir befindet sich ein Slalom aus Absperrungen.<br><br><font face=/font/big_bold.font>Fahre durch den Slalom.</font>"

	key[]: "aca_msg_book1_2_06_forward2"
	val[]: "<font face=/font/big_bold.font>Folge dem Weg um die Kehre.</font>"

	key[]: "aca_msg_book1_2_06_check1"
	val[]: "Der Weg vor dir verengt sich deutlich. Du kannst deinen Seitenspiegel zur Orientierung nutzen.<br><br><font face=/font/big_bold.font>Fahre vorsichtig weiter.</font>"

	key[]: "aca_msg_book1_2_06_check2"
	val[]: "Nach der Kurve folgt eine 90-Grad-Kurve.<br><br><font face=/font/big_bold.font>Passe deine Geschwindigkeit entsprechend an.</font>"

	key[]: "aca_msg_book1_2_06_check3"
	val[]: "Vor dir liegen noch ein paar einfache Kurven. Passe deine Geschwindigkeit weiterhin bei Bedarf an.<br><br><font face=/font/big_bold.font>Fahre weiter.</font>"

	key[]: "aca_msg_book1_2_06_check4"
	val[]: "Der nächste Abschnitt muss rückwärts gefahren werden. Halte an den Absperrungen vor dir an, damit du anschließend rückwärts nach rechts fahren kannst.<br><br><font face=/font/big_bold.font>Halte an den Absperrungen.</font>"

	key[]: "aca_msg_book1_2_06_check5"
	val[]: "Setze rückwärts in den Bereich hinter dir und dann nach rechts.<br><br><font face=/font/big_bold.font>Beginne mit dem Rückwärtsfahren.</font>"

	key[]: "aca_msg_book1_2_06_reverse"
	val[]: "Folge dem Weg durch die Kurven.<br><br><font face=/font/big_bold.font>Fahre weiter rückwärts.</font>"

	key[]: "aca_msg_book1_2_06_check6"
	val[]: "Hinter dir auf der linken Seite befinden sich einige Absperrungen.<br><br><font face=/font/big_bold.font>Lenke in Richtung der Absperrungen und sei bereit anzuhalten.</font>"

	key[]: "aca_msg_book1_2_06_check7"
	val[]: "Halte an und schalte in einen Vorwärtsgang, dann fahre weiter nach rechts.<br><br><font face=/font/big_bold.font>Fahre vorwärts.</font>"

	key[]: "aca_msg_book1_2_06_check8"
	val[]: "Vor dir liegt ein schmaler, kurviger Pfad durch einige Leitkegel. Fahre vorsichtig und nutze bei Bedarf deine Spiegel.<br><br><font face=/font/big_bold.font>Fahre durch die Leitkegel.</font>"

	key[]: "aca_msg_book1_2_06_check9"
	val[]: "Als Nächstes folgt eine Kombination aus verschiedenen 90-Grad-Kurven. Achte darauf, jede Kurve mit großzügigem Abstand anzufahren.<br><br><font face=/font/big_bold.font>Fahre weiter.</font>"

	key[]: "aca_msg_book1_2_06_check10"
	val[]: "Beobachte den Bahnübergang, während du dich ihm näherst. Die Warnsignale können aktiviert werden, um einen herannahenden Zug anzuzeigen.<br><br><font face=/font/big_bold.font>Fahre mit Vorsicht weiter.</font>"

	key[]: "aca_msg_book1_2_06_check11"
	val[]: "Die Abbiegung zur Zufahrtsstraße ist teilweise durch ein Hindernis versperrt. Halte dich beim Heranfahren links, um mehr Platz für die Kurve zu haben.<br><br><font face=/font/big_bold.font>Biege ab.</font>"

	key[]: "aca_msg_book1_2_06_check12"
	val[]: "Du kannst selbst entscheiden, ob du das Stoppschild beachtest oder nicht. Der Bereich ist exklusiv für uns gesperrt.<br><br><font face=/font/big_bold.font>Biege links ab.</font>"

	key[]: "aca_msg_book1_2_06_check13"
	val[]: "Hier kannst du etwas beschleunigen, aber an der nächsten Kreuzung musst du abbiegen.<br><br><font face=/font/big_bold.font>Folge dem Kurs weiter.</font>"

	key[]: "aca_msg_book1_2_06_check14"
	val[]: "Biege links ab, um in die Stadt zu kommen, und danach noch zweimal links, um zum Zielbereich zu gelangen.<br><br><font face=/font/big_bold.font>Fahre durch die Stadt.</font>"

	key[]: "aca_msg_book1_2_06_check15"
	val[]: "Auf der anderen Seite des Platzes befinden sich einige Absperrungen. Fahre bis dorthin.<br><br><font face=/font/big_bold.font>Halte in der Nähe der Absperrungen an.</font>"

	key[]: "aca_msg_book1_2_06_check16"
	val[]: "Hinter dir auf der rechten Seite ist eine Parklücke.<br><br><font face=/font/big_bold.font>Fahre rückwärts in die Parklücke.</font>"
#!{
	key[]: "aca_msg_book1_2_06_check17"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_06_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_2_06_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

#@}

#+ Book 1 Scenario 2_08
#@{

#### 2_08 common
	key[]: "aca_scenario_book1_2_08_title"
	val[]: "Einfacher Trainingskurs"

	key[]: "aca_scenario_book1_2_08_desc"
	val[]: "In dieser Lektion werden wir die bisher erlernten Fähigkeiten anwenden und sie auf einer einfachen Fahrt durch einen Trainingskurs ausprobieren."

#### 2_08 goal
#!{
	key[]: "aca_goal_book1_2_08_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_08_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_2_08_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
#!}
	key[]: "aca_goal_book1_2_08_forward"
	val[]: "Einfahrt in den Kurs"

	key[]: "aca_goal_book1_2_08_check1"
	val[]: "Weite Kehre"

	key[]: "aca_goal_book1_2_08_check2"
	val[]: "Fahren durch den Slalom"

	key[]: "aca_goal_book1_2_08_check3"
	val[]: "Enge Kehre"

	key[]: "aca_goal_book1_2_08_check4"
	val[]: "Enge Kurve"

	key[]: "aca_goal_book1_2_08_check6"
	val[]: "Technischer Abschnitt"

	key[]: "aca_goal_book1_2_08_check7"
	val[]: "Offener Abschnitt"



#### 2_08 msg - intro text

	key[]: "aca_msg_book1_2_08_cutscene1"
	val[]: "In dieser Lektion nehmen wir die Zugmaschine für eine kurze Fahrt, um zu sehen, wie du sie mit deinen neu erworbenen Fähigkeiten steuerst.<br>Auf der Strecke gibt es verschiedene Arten und Kombinationen von Kurven. Es ist kein Rennen, und es geht nicht um die Zeit. Sei geduldig und passe deine Fahrgeschwindigkeit an die Kurven und Hindernisse an, die du vor dir hast."

	key[]: "aca_msg_book1_2_08_cutscene2"
	val[]: "Fahre in den Kurs mit einer weiten Kehre ein."

	key[]: "aca_msg_book1_2_08_cutscene3"
	val[]: "Als Nächstes triffst du auf eine Reihe von Hindernissen, die dich in einen unregelmäßigen Slalom führen."

	key[]: "aca_msg_book1_2_08_cutscene4"
	val[]: "Nach ein paar einfachen 90-Grad-Kurven kommst du zu einer engen Kehre. Es ist wichtig, dich richtig zu positionieren, um die Kehre sauber zu nehmen und fließend in den nächsten Abschnitt überzugehen."

	key[]: "aca_msg_book1_2_08_cutscene5"
	val[]: "Achte auf die Leitkegel, während du die lange Kurve fährst, da die Sicht über die Motorhaube eingeschränkt ist."

	key[]: "aca_msg_book1_2_08_cutscene6"
	val[]: "Eine weitere Reihe an Absperrungen führt dich in einen weiten Slalom."

	key[]: "aca_msg_book1_2_08_cutscene7"
	val[]: "Die Strecke öffnet sich etwas, aber überstürze nichts. Noch ein paar einfache Kurven, und du bist am Ziel."

	key[]: "aca_msg_book1_2_08_cutscene8"
	val[]: "Halte im vorgesehenen Bereich an und sichere den Lkw."


#### 2_08 Driving Instructions

	key[]: "aca_msg_book1_2_08_start"
	val[]: "Um diese Lektion erfolgreich abzuschließen, darfst du weder einen Unfall verursachen, von der Strecke abkommen oder Leitkegel berühren.<br><br><font face=/font/big_bold.font>Bereite dich auf die Abfahrt vor.</font>"

	key[]: "aca_msg_book1_2_08_forward"
	val[]:"<font face=/font/big_bold.font>Fahre vorwärts in die weite Kehre, um den Kurs zu beginnen.</font>"

	key[]: "aca_msg_book1_2_08_check1"
	val[]: "<font face=/font/big_bold.font>Beende die Kehre.</font>"

	key[]: "aca_msg_book1_2_08_check2"
	val[]: "Vor dir sind einige Absperrungen wie ein Slalom angeordnet.<br><br><font face=/font/big_bold.font>Passe deine Geschwindigkeit entsprechend an und fahre weiter.</font>"

	key[]: "aca_msg_book1_2_08_check3"
	val[]: "Als Nächstes kommen zwei einfache 90-Grad-Kurven, gefolgt von einer engen Kehre. Nimm dir Zeit und fahre langsam.<br><br><font face=/font/big_bold.font>Fahre in die enge Kehre.</font>"

	key[]: "aca_msg_book1_2_08_check4"
	val[]: "Nach der Kehre geht es auf einem schmalen Weg durch eine Kurve weiter. Bleib von der inneren Absperrung fern und pass auf, dass du keine Leitkegel vor dir streifst.<br><br><font face=/font/big_bold.font>Fahre durch die Kurve.</font>"

	key[]: "aca_msg_book1_2_08_check6"
	val[]: "Der Weg vor dir enthält einige enge und anspruchsvolle Kurven. Passe deine Geschwindigkeit an und fahre vorsichtig durch diesen Abschnitt.<br><br><font face=/font/big_bold.font>Fahre weiter.</font>"

	key[]: "aca_msg_book1_2_08_check7"
	val[]: "Der nächste Abschnitt ist offener mit einigen leichten Kurven. Lass dir Zeit.<br><br><font face=/font/big_bold.font>Fahre weiter.</font>"
#!{
	key[]: "aca_msg_book1_2_08_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_08_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

#@}

#+ Book 1 Scenario 2_09
#@{

#### 2_09 common
	key[]: "aca_scenario_book1_2_09_title"
	val[]: "Längsparken"

	key[]: "aca_scenario_book1_2_09_desc"
	val[]: "In dieser Lektion schauen wir uns das Längsparken zwischen zwei anderen Lkw an."

#### 2_09 goal

	key[]: "aca_goal_book1_2_09_stopmid"
	val[]: "Anhalten vor der Parklücke"

	key[]: "aca_goal_book1_2_09_checkmirror"
	val[]: "Überprüfen des Rückspiegels"

	key[]: "aca_goal_book1_2_09_backward"
	val[]: "Rückwärts in die Parklücke einfahren"

	key[]: "aca_goal_book1_2_09_stop"
	val[]: "Lkw innerhalb der Parklücke ausrichten"

#!{
	key[]: "aca_goal_book1_2_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_09_check1"
	val[]: "@@aca_goal_book1_1_03_forward@@"


	key[]: "aca_goal_book1_2_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"



 #!}
#### 2_09 msg - intro text

	key[]: "aca_msg_book1_2_09_cutscene1"
	val[]: "Längsparken ist eine wichtige Fähigkeit, die jeder Lkw-Fahrer beherrschen sollte.<br>Bereite dich auf die Abfahrt vor."

	key[]: "aca_msg_book1_2_09_cutscene2"
	val[]: "Fahre zur Parklücke.<br>Achte auf deine Umgebung."

	key[]: "aca_msg_book1_2_09_cutscene3"
	val[]: "Stelle dich parallel zum Lkw vor deiner Parklücke auf. Halte ausreichend Abstand, damit du beim Einparken genug Platz zum Rangieren hast."

	key[]: "aca_msg_book1_2_09_cutscene4"
	val[]: "Lenke scharf in Richtung der Lücke ein und beginne rückwärts zu fahren."

	key[]: "aca_msg_book1_2_09_cutscene5"
	val[]: "Wenn du in den Spiegel auf der Fahrerseite schaust, richte dich am Bordstein knapp vor dem Lkw hinter dir aus."

	key[]: "aca_msg_book1_2_09_cutscene6"
	val[]: "Sobald dein vorderer Stoßfänger den Lkw vor dir passiert hat, kannst du beginnen, das vordere Ende des Lkw in die Lücke zu lenken, um den Lkw mit der Parklücke auszurichten."

	key[]: "aca_msg_book1_2_09_cutscene7"
	val[]: "Richte das Lenkrad gerade aus und zentriere den Lkw in der Parklücke.<br>Parke und sichere den Lkw."

#### 2_09 Driving Instructions

	key[]: "aca_msg_book1_2_09_start"
	val[]: "Vor dir stehen mehrere geparkte Lkw, und eine letzte freie Parklücke wartet auf dich.<br><br><font face=/font/big_bold.font>Mach dich startklar.</font>"

	key[]: "aca_msg_book1_2_09_check1"
	val[]: "Denke daran, auf deine Umgebung zu achten. Nutze deine Spiegel aufmerksam während des gesamten Manövers.<br><br><font face=/font/big_bold.font>Fahre vorwärts.</font>"

	key[]: "aca_msg_book1_2_09_stopmid"
	val[]: "<color value=@@clr_white@@>Fahre an der Parklücke vorbei und in den markierten Bereich. Von dort aus kannst du mit dem Rückwärtsfahren beginnen.<br><br><font face=/font/big_bold.font>Halte im markierten Bereich an.</font>"

	key[]: "aca_msg_book1_2_09_checkmirror"
	val[]: "Überprüfe deine Umgebung auf Hindernisse und stelle sicher, dass der Weg zum Rückwärtsfahren frei ist.<br><br><font face=/font/big_bold.font>Schau durch den Beifahrerspiegel.</font>"

	key[]: "aca_msg_book1_2_09_backward"
	val[]: "Lenke ein und fahre rückwärts in die Parklücke.<br><br><font face=/font/big_bold.font>Beginne mit dem Rückwärtsfahren.</font>"

	key[]: "aca_msg_book1_2_09_stop"
	val[]: "Beginne, den Lkw gerade auszurichten, sobald es passend ist. Fahre nicht über den Bordstein!<br><br><font face=/font/big_bold.font>Richte den Lkw in der Parklücke aus.</font>"
#!{
	key[]: "aca_msg_book1_2_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_01
#@{

#### 3_01 common
	key[]: "aca_scenario_book1_3_01_title"
	val[]: "Ankuppeln eines Aufliegers"

	key[]: "aca_scenario_book1_3_01_desc"
	val[]: "In dieser Lektion erklären wir die Grundlagen des Ankuppelns und Abkuppelns der Zugmaschine an einen Auflieger."

#### 3_01 goal

	key[]: "aca_goal_book1_3_01_check_con"
	val[]: "Rückwärtsfahren zum Auflieger"

	key[]: "aca_goal_book1_3_01_connect"
	val[]: "Auflieger ankuppeln"

	key[]: "aca_goal_book1_3_01_park_br_off"
	val[]: "Lösen der Feststellbremse"


	key[]: "aca_goal_book1_3_01_disc5"
	val[]: "Abkuppeln des Aufliegers"

	key[]: "aca_goal_book1_3_01_park_br_off2"
	val[]: "Abkuppeln des Aufliegers"

	key[]: "aca_goal_book1_3_01_disconnect"
	val[]: "Abkuppeln des Aufliegers"

	key[]: "aca_goal_book1_3_01_stop"
	val[]: "Anhalten im vorgesehenen Bereich"
#!{
	key[]: "aca_goal_book1_3_01_end"
