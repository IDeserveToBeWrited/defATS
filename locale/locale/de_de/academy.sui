#+ Book 2 intro
#@{

#### common
	key[]: "aca_scenario_book2_intro_title"
	val[]: "Lkw Fahr Kompetenz"


#### intro text

	key[]: "aca_scenario_book2_book2_intro_cutscene1"
	val[]: "Willkommen zurück in der @@driving_academy@@!"

	key[]: "aca_scenario_book2_book2_intro_cutscene2"
	val[]: "Die folgenden Szenarien stellen den nächsten Schritt auf deinem Weg zum professionellen Lkw-Fahrer dar."

	key[]: "aca_scenario_book2_book2_intro_cutscene3"
	val[]: "Dieses Mal werden wir dich nicht durch jede Aufgabe führen, daher liegt es an dir, deine Fähigkeiten und Erfahrungen einzusetzen."

	key[]: "aca_scenario_book2_book2_intro_cutscene4"
	val[]: "Du wirst vielleicht auf einige bekannte Manöver stoßen, aber diesmal in neuen Umgebungen, die eher wie reale Szenarien aussehen."

	key[]: "aca_scenario_book2_book2_intro_cutscene5"
	val[]: "Neu bei @@driving_academy@@ sind die Bedingungen „Bestanden“ und „Bonus“."

	key[]: "aca_scenario_book2_book2_intro_cutscene6"
	val[]: "Wie zuvor musst du auch weiterhin jedes Szenario abschließen, ohne etwas zu rammen, indem du erfolgreich parkst und den Lkw sicherstellst..."

	key[]: "aca_scenario_book2_book2_intro_cutscene7"
	val[]: "...aber jetzt musst du das auch innerhalb der vorgegebenen Zeit und mit einer Begrenzung der Anzahl der Richtungswechsel zwischen Vorwärts- und Rückwärtsfahrt tun."

	key[]: "aca_scenario_book2_book2_intro_cutscene8"
	val[]: "Die Bonusbedingungen können erfüllt werden, indem jedes Szenario mit noch anspruchsvolleren Bedingungen abgeschlossen wird..."

	key[]: "aca_scenario_book2_book2_intro_cutscene9"
	val[]: "... wie strengere Zeitvorgaben, weniger Richtungswechsel und die ausschließliche Verwendung der Innenkamera."

	key[]: "aca_scenario_book2_book2_intro_cutscene10"
	val[]: "Wenn du alle Szenarien abgeschlossen hast, kannst du dich als erfahrenen Trucker bezeichnen und bist bereit für die nächste Herausforderung auf der Straße. <br><br>Um dich selbst noch mehr herauszufordern, erfülle alle Bonusbedingungen für jedes Szenario. Dann bist du wirklich ein Trucking-Star!"


#@}



#+ Book 2 zero
#@{
#### zero common
	key[]: "aca_scenario_book2_zero_title"
	val[]: "Tutorial"

	key[]: "aca_scenario_book2_zero_desc"
	val[]: "In diesem Tutorial-Szenario helfen wir dir dabei, dich mit den neuen Funktionen von Truck Driving Proficiency vertraut zu machen."


#### zero info msg1

	key[]: "aca_msg_book2_scenario_zero1_title"
	val[]: "Lkw Fahr Kompetenz"

	key[]: "aca_msg_book2_scenario_zero1"
	val[]: "Zu Beginn jedes Szenarios wird das Fenster <color value=@@clr_sel@@>„Szenario-Einweisung“<color value=@@clr_txt@@> angezeigt. Hier findest du Informationen zu den neuen Pass- und Bonusbedingungen für das Szenario. <br><br>Die Passbedingungen müssen erfüllt sein, um das Szenario erfolgreich abzuschließen, während die Bonusbedingungen eine optionale zusätzliche Herausforderung für erfahrene und geübte Spieler darstellen. <br><br><font face=/font/big_bold.font>Um fortzufahren, schalte die Zündung ein.</font>"

#### zero info msg1b

	key[]: "aca_msg_book2_scenario_zero1b"
	val[]: "Eine der Bonusbedingungen verlangt, dass du das Szenario unter Verwendung der <color value=@@clr_sel@@>Innenkamera<color value=@@clr_txt@@> abschließst. Du kannst weiterhin die Außenkameras verwenden, um deine Umgebung zu überprüfen, jedoch nur, wenn der Lkw steht. <br><br>Du kannst dich umsehen, um sich zu orientieren, und dann wieder zur Innenkamera zurückwechseln. <br><br><font face=/font/big_bold.font>Wechsel zur Verfolgungskamera, um die Umgebung zu überprüfen</font>"


#### zero info msg1c


	key[]: "aca_msg_book2_scenario_zero1c"
	val[]: "Orientiere dich und wechseln dann zurück zur Innenkamera.<br><br><font face=/font/big_bold.font>Sehe dich im Lkw um</font>"


#### zero info msg1d


	key[]: "aca_msg_book2_scenario_zero1d"
	val[]: "<font face=/font/big_bold.font>Zurück zur Innenkamera wechseln</font>"
#### zero info msg2

	key[]: "aca_msg_book2_scenario_zero2_title"
	val[]: "Lkw Fahr Kompetenz"

	key[]: "aca_msg_book2_scenario_zero2"
	val[]: "<color value=@@clr_sel@@>Die Zeit<color value=@@clr_txt@@> ist ebenfalls ein Faktor für die Fahrkompetenz. Alle Szenarien haben ein individuelles Zeitlimit, innerhalb dessen das Szenario als Bestehensbedingung abgeschlossen werden muss, und viele haben zusätzlich ein strengeres Limit als Bonusbedingung. <br><br>Die Zeitmessung beginnt erst, nachdem der Lkw bewegt wurde. <br><br><font face=/font/big_bold.font>Starte den Motor und löse die Feststellbremse, um fortzufahren. </font>"


#### zero info msg3

	key[]: "aca_msg_book2_scenario_zero3_title"
	val[]: "Lkw Fahr Kompetenz"

	key[]: "aca_msg_book2_scenario_zero3"
	val[]: "Eine weitere Neuerung bei Truck Driving Proficiency sind Wegpunkte. Alle Wegpunkte müssen erreicht werden, bevor ein Szenario abgeschlossen werden kann. <br><br>Außerdem reagieren Wegpunkte empfindlich auf die Ausrichtung des Lkw beim Erreichen des Wegpunkts. Achte daher auf Bodenmarkierungen in der Nähe des Wegpunkts, um sich richtig zu orientieren. <br><br><font face=/font/big_bold.font>Fahre vorwärts zum Wegpunkt vor dir. </font>"


#### zero info msg4

	key[]: "aca_msg_book2_scenario_zero4_title"
	val[]: "Lkw Fahr Kompetenz"

	key[]: "aca_msg_book2_scenario_zero4"
	val[]: "Du hast den Wegpunkt erreicht und kannst nun mit dem nächsten Schritt fortfahren. <br><br>Hinter dir befindet sich ein weiterer Wegpunkt, in den du rückwärts einfahren musst. Beachte den Pfeil auf dem Boden, der angibt, in welche Richtung der Lkw zeigen sollte, wenn du den Wegpunkt erreichst. <br><br>Eine weitere Pass- und Bonusbedingung, die berücksichtigt werden muss, ist <color value=@@clr_sel@@>Richtungswechsel<color value=@@clr_txt@@>. Wir zählen, wie oft du zwischen Vorwärts- und Rückwärtsfahrt die Richtung wechselst. Bleibe unter dem Limit, um die Bedingung zu erfüllen.<br><br><font face=/font/big_bold.font>Rückwärts zum Wegpunkt fahren und anhalten.</font>"

#### zero info msg5

	key[]: "aca_msg_book2_scenario_zero5_title"
	val[]: "Lkw Fahr Kompetenz"

	key[]: "aca_msg_book2_scenario_zero5"
	val[]: "Bis jetzt solltest du also eine Richtungsänderung angesammelt haben. <br><br>Nehme den Anhänger hinter dir auf, um mit dem nächsten Schritt fortzufahren. <br><br><font face=/font/big_bold.font>Fahre rückwärts unter den Anhänger, um ihn anzukoppeln.</font>"

#### zero info msg6

	key[]: "aca_msg_book2_scenario_zero6_title"
	val[]: "Lkw Fahr Kompetenz"

	key[]: "aca_msg_book2_scenario_zero6"
	val[]: "Der endgültige Parkplatz befindet sich zu deiner Rechten. In einigen Szenarien gibt es nur einen Parkplatz, in anderen stehen mehrere zur Auswahl. Wenn du auf einem der Parkplätze korrekt parkst, kannst du das Szenario abschließen. <br><br><font face=/font/big_bold.font> Drücke @@imv_nrm_attach@@, um den Anhänger anzukoppeln. </font>"


#### zero info msg7

	key[]: "aca_msg_book2_scenario_zero7_title"
	val[]: "Lkw Fahr Kompetenz"

	key[]: "aca_msg_book2_scenario_zero7"
	val[]: "Die Parkplätze geben auch an, in welche Richtung der Lkw auf dem Parkplatz ausgerichtet sein soll. Wenn du in die falsche Richtung parkst, kannst du das Szenario erst abschließen, wenn du dies korrigiert hast, was dir Zeit und Richtungsänderungen kostet. <br><br><font face=/font/big_bold.font>Fahre zu einem der Parkplätze und parke korrekt. </font>"



#### zero info msg8

	key[]: "aca_msg_book2_scenario_zero8_title"
	val[]: "Lkw Fahr Kompetenz"

	key[]: "aca_msg_book2_scenario_zero8"
	val[]: "Du solltest nun mit den neuen Parametern für Passbedingungen und Bonusziele vertraut sein und bereit sein, die neuen Szenarien in Truck Driving Proficiency in Angriff zu nehmen!<br><br><font face=/font/big_bold.font>Sichere den Lkw, indem du die Feststellbremse anziehst und den Motor abstellst, um das Szenario abzuschließen.</font>"



#@}

#+ Book 2 trailer check
#@{

#### Mission instructions - trailer check

key[]: "aca_msg_book2_slopy_moments_title"
val[]: "Anweisungen folgen"

key[]: "aca_msg_book2_slopy_moments1"
val[]: "Um dieses Szenario erfolgreich abzuschließen, halte deinen Anhänger während der gesamten Fahrt angeschlossen. <br><br><font face=/font/big_bold.font>An den Anhänger anschließen.</font>"

key[]: "aca_msg_book2_slopy_moments2"
val[]: "Jetzt kannst du mit dem Szenario fortfahren"


#@}


#+ Book 2 slalom_nt
#@{
#### 3_21 common
	key[]: "aca_scenario_book2_slalom_nt_title"
	val[]: "Doppel-Slalom"

	key[]: "aca_scenario_book2_slalom_nt_desc"
	val[]: "In diesem Szenario musst du einen kurzen Parcours aus zwei miteinander verbundenen Slaloms bewältigen."

#### slalom_nt intro text

	key[]: "aca_scenario_book2_slalom_nt_cutscene1"
	val[]: "Dieses Szenario besteht aus zwei miteinander verbundenen Slaloms. Fahre durch den ersten Slalom, ohne einen Kegel zu berühren, und mache am Ende eine Kehrtwende."

	key[]: "aca_scenario_book2_slalom_nt_cutscene2"
	val[]: "Von dort aus fahre Sie durch den zweiten Slalom weiter zum letzten Parkplatz.<br><br>Deine Zeit wird gemessen, fahre also zielstrebig und vorsichtig!"



#@}

#+ Book 2 training_course
#@{
#### common
	key[]: "aca_scenario_book2_training_course_title"
	val[]: "Factory Frenzy"

	key[]: "aca_scenario_book2_training_course_desc"
	val[]: "In diesem Szenario fährst du durch einen industriellen Trainingsparcours."

#### intro text

	key[]: "aca_scenario_book2_training_course_cutscene1"
	val[]: "Der Schwierigkeitsgrad dieses Trainingskurses variiert im Laufe des Kurses."

	key[]: "aca_scenario_book2_training_course_cutscene2"
	val[]: "Fahre so schnell wie möglich und unter Beachtung der Sicherheitsvorschriften durch jeden Abschnitt und denke daran, die nächste Kurve im Voraus zu planen!"



#@}

#+ Book 2 reverse_parking
#@{
#### common
	key[]: "aca_scenario_book2_reverse_parking_title"
	val[]: "Rückwärts einparken um eine Ecke"

	key[]: "aca_scenario_book2_reverse_parking_desc"
	val[]: "In diesem Szenario musst du deinen Lkw um eine unübersichtliche Kurve herum und in eine Parklücke zurücksetzen."

#### intro text

	key[]: "aca_scenario_book2_reverse_parking_cutscene1"
	val[]: "Entladebereiche befinden sich nicht immer an einem idealen Ort. In diesem Fall wird er durch das Gebäude neben dir verdeckt."

	key[]: "aca_scenario_book2_reverse_parking_cutscene2"
	val[]: "Wende um das Gebäude herum und fahren auf den Parkplatz."

#@}


#+ Book 2 blindside_parking
#@{
#### common
	key[]: "aca_scenario_book2_blindside_parking_title"
	val[]: "Parken auf der Seite mit totem Winkel"

	key[]: "aca_scenario_book2_blindside_parking_desc"
	val[]: "In diesem Szenario werden wir uns erneut mit dem Rückwärtsfahren auf der blinden Seite befassen. Dies ist bereits unter idealen Bedingungen ein schwieriges Manöver, aber jetzt musst du dich mit noch strengeren Bedingungen auseinandersetzen."

#### intro text

	key[]: "aca_scenario_book2_blindside_parking_cutscene1"
	val[]: "Vor dir und zu deiner Rechten befindet sich ein Parkplatz, in den du rückwärts einparken musst. Fahre weit daran vorbei und führe dann ein Rückwärtsmanöver mit Blick auf die blinde Seite durch, um in die Parklücke einzuparken."

	key[]: "aca_scenario_book2_blindside_parking_cutscene2"
	val[]: "Es gibt weniger Platz zum Arbeiten als zuvor, daher musst du präzise und überlegt lenken."

#@}


#+ Book 2 advanced_alley_parking
#@{
#### common
	key[]: "aca_scenario_book2_advanced_alley_parking_title"
	val[]: "Fortgeschrittene Rückwärtsfahrt in einer Gasse"

	key[]: "aca_scenario_book2_advanced_alley_parking_desc"
	val[]: "In diesem Szenario musst du eine Reihe von Rückwärtsmanövern durchführen, um durch eine Gasse zu gelangen und auf den endgültigen Parkplatz zu fahren. "

#### intro text

	key[]: "aca_scenario_book2_advanced_alley_parking_cutscene1"
	val[]: "Du musst deinen Lkw durch diese Gasse manövrieren, um zum Parkplatz auf der anderen Seite zu gelangen."

	key[]: "aca_scenario_book2_advanced_alley_parking_cutscene2"
	val[]: "Fahre rückwärts durch die Gasse auf das leere Grundstück auf der anderen Straßenseite."

	key[]: "aca_scenario_book2_advanced_alley_parking_cutscene3"
	val[]: "Du kannst das abschließende Parkmanöver nach Belieben angehen, aber denk daran, dass du nur begrenzt Korrekturen vornehmen kannst und eine Zeitbegrenzung zu beachten hast."

#### inside scenario

	key[]: "aca_msg_book2_advanced_alley_check1"
	val[]: "Du kannst dich dem endgültigen Parkplatz so nähern, wie du es für richtig hältst – es gibt keinen richtigen oder falschen Weg, solange du nichts rammst!"

	key[]: "aca_msg_book2_advanced_alley_check1_title"
	val[]: "Erinnerung"


#@}

#+ Book 2 tight_long_backing
#@{
#### common
	key[]: "aca_scenario_book2_tight_long_backing_title"
	val[]: "Versetztes Parken auf einem überfüllten Parkplatz"

	key[]: "aca_scenario_book2_tight_long_backing_desc"
	val[]: "In diesem Szenario musst du deinen Lkw mithilfe einer versetzten Rückwärtsfahrt von einem Ladebereich zu einem sicheren Parkplatz auf einem stark frequentierten Parkplatz mit vielen Hindernissen bewegen."

#### intro text

	key[]: "aca_scenario_book2_tight_long_backing_cutscene1"
	val[]: "Dieses Szenario soll einen belebten Parkplatz bei einem Spediteur darstellen.<br><br>Der Parkplatz, den du benötigst, befindet sich direkt neben dir auf der rechten Seite."

	key[]: "aca_scenario_book2_tight_long_backing_cutscene2"
	val[]: "Fahre vorwärts in den leeren Teil des Parkplatzes und dann rückwärts in die Parklücke. <br><br>Wie du siehst, ist der Platz begrenzt und es gibt auch einige Hindernisse zu beachten."

#@}


#+ Book 2 reverse_slalom_nt
#@{
#### common
	key[]: "aca_scenario_book2_reverse_slalom_nt_title"
	val[]: "Rückwärtsslalom"

	key[]: "aca_scenario_book2_reverse_slalom_nt_desc"
