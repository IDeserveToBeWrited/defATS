	key[]: "aca_goal_book1_1_02_cam_window"
	val[]: "@@o_im_uppercam@@"

	key[]: "aca_goal_book1_1_02_cam_interior"
	val[]: "@@o_im_wincam@@"

	key[]: "aca_goal_book1_1_02_end"
	val[]: "@@o_im_insidecam@@"
#!}


#+ Book 1 Scenario 1_02
#@{

#### 1_02 common

	key[]: "aca_scenario_book1_1_02_title"
	val[]: "Kamera Steuerung"

	key[]: "aca_scenario_book1_1_02_desc"
	val[]: "In dieser Lektion lernen wir die verschiedenen Kameratypen kennen, die dir zur Verfügung stehen, und wie sie dir dabei helfen können, den Lkw zu steuern und zu manövrieren."

#### 1_02 goal

	key[]: "aca_goal_book1_1_02_seat"
	val[]: "Sitzposition"

	key[]: "aca_goal_book1_1_02_look_back"
	val[]: "Sicht nach hinten"

	key[]: "aca_goal_book1_1_02_mirrors"
	val[]: "Spiegel Check"

	key[]: "aca_goal_book1_1_02_cam_behind"
	val[]: "Wechsel zur Außenkamera"

	key[]: "aca_goal_book1_1_02_look_around"
	val[]: "Schau dich im Lkw um"


#### 1_02 msg - intro text

	key[]: "aca_msg_book1_1_02_cutscene1"
	val[]: "In dieser Lektion gehen wir die verschiedenen Kameras durch,<br>die dir zur Verfügung stehen."

	key[]: "aca_msg_book1_1_02_cutscene2"
	val[]: "Es gibt insgesamt sieben Kameras zur Auswahl. Wir werden jetzt einige davon durchgehen<br>und ihre vorgesehenen Funktionen erklären."

	key[]: "aca_msg_book1_1_02_cutscene3"
	val[]: "Die verschiedenen Kameras und ihre unterschiedlichen Blickwinkel können dir beim Manövrieren in engen Bereichen helfen."


#### 1_02 Driving Instructions

	key[]: "aca_msg_book1_1_02_seat"
	val[]: "Dorthin zu schauen, wo du hinfährst, ist die Grundlage für sicheres und professionelles Fahren. Wenn die aktuelle Sitzposition dir nicht passt, kannst du sie im '@@adjust_link_t@@' ändern (zugänglich über das Pausenmenü).<br><br><font face=/font/big_bold.font>Bestätige, wenn du bereit bist, mit @@imv_nrm_activate@@.</font>"

	key[]: "aca_msg_book1_1_02_look_back"
	val[]: "Beim Rückwärtsfahren bieten deine Spiegel nicht immer eine klare Sicht. Es kann notwendig sein, aus dem Fenster hinter dir zu schauen, um eine bessere Sicht zu erhalten.<br><br><font face=/font/big_bold.font>Drehe die Kamera vollständig zur Fahrerseite, um aus dem Fenster in Richtung des hinteren Teils des Aufliegers zu schauen.</font>@@aca_goal_tip@@ Du musst dich im Fahrzeug befinden."

	key[]: "aca_msg_book1_1_02_mirrors"
	val[]: "Nutze diese Ansicht, um den Auflieger während Rückwärtsmanövern im Blick zu behalten. Es ist immer besser, zur Fahrerseite rückwärts zu fahren, damit du diese Ansicht nutzen kannst. Beim Rückwärtsfahren zur Beifahrerseite hast du eine deutlich eingeschränktere Sicht auf das Geschehen hinter dir.<br><br><font face=/font/big_bold.font>Schaue zur Beifahrerseite.</font>"

	key[]: "aca_msg_book1_1_02_cam_behind"
	val[]: "Deshalb wird normalerweise nicht empfohlen, zur Beifahrerseite rückwärtszufahren; du kannst sehen, dass die Sicht dabei stark eingeschränkt ist. Zum Glück stehen dir auch sieben Außenkameras zur Verfügung.<br><br>Mit der Taste @@imv_nrm_camcycle@@ kannst du zur nächsten Kamera in der Reihenfolge wechseln. Nach dem Durchschalten aller sieben Kameras kehrst du wieder zum Anfang der Reihe zurück.<br><br><font face=/font/big_bold.font>Drücke @@imv_nrm_camcycle@@, um zur nächsten Kamera zu wechseln.</font>"

	key[]: "aca_msg_book1_1_02_look_around"
	val[]: "Die Außenkamera bietet die beste Perspektive auf das Geschehen rund um den Lkw.<br><br><font face=/font/big_bold.font>Schaue um den Lkw herum.</font>"

	key[]: "aca_msg_book1_1_02_cam_top"
	val[]: "<font face=/font/big_bold.font>Drücke erneut @@imv_nrm_camcycle@@, um zur nächsten Kamera zu wechseln.</font>"

	key[]: "aca_msg_book1_1_02_cam_cabin"
	val[]: "Die Ansicht von oben bietet eine hervorragende Übersicht über die Situation rund um den Lkw und vereinfacht das Einparken und Fahren in engen Bereichen erheblich.<br><br><font face=/font/big_bold.font>Drücke @@imv_nrm_camcycle@@, um zur nächsten Kamera zu wechseln.</font>"

	key[]: "aca_msg_book1_1_02_cam_window"
	val[]: "Die Dachkamera bietet eine klare Sicht auf die Straße weit vor dem Lkw, ohne viel Sichtbehinderung.<br><br><font face=/font/big_bold.font>Drücke @@imv_nrm_camcycle@@, um zur letzten Kamera zu wechseln, die wir uns vorerst ansehen.</font>"

	key[]: "aca_msg_book1_1_02_cam_interior"
	val[]: "Die Rückansicht ist eine schnellere Form der Ansicht, die du zuvor durch das Drehen der Innenkamera erhalten hast. Wie besprochen, ist sie hilfreich beim Rückwärtsfahren oder Einparken.<br><br>Im Spiel gibt es noch weitere Kameras, die du ausprobieren kannst, indem du wiederholt @@imv_nrm_camcycle@@ drückst.<br><br><font face=/font/big_bold.font>Drücke @@imv_nrm_cam1@@, um ins Innere zurückzukehren.</font>"

	key[]: "aca_msg_book1_1_02_end"
	val[]: "Für ein authentisches Fahrschul-Erlebnis empfehlen wir, während der Lektionen bei der „Innenkamera“-Ansicht zu bleiben.<br><br><font face=/font/big_bold.font>Drücke @@imv_nrm_activate@@, um zu bestätigen und die Lektion zu beenden.</font>@@aca_goal_tip@@ Du kannst die @@o_im_cam_zoom@@-Funktion nutzen, um eine bessere Sicht auf deine Umgebung zu erhalten. Das ist besonders hilfreich beim Blick in die Spiegel. Sieh dir den Optionsbildschirm unter „Tasten & Buttons“ an, um die entsprechenden Steuerungen zu sehen oder anzupassen."

#@}

#+ Book 1 Scenario 1_03
#@{

#### 1_03 common
	key[]: "aca_scenario_book1_1_03_title"
	val[]: "Erste Fahrt"

	key[]: "aca_scenario_book1_1_03_desc"
	val[]: "In dieser Lektion lernen wir, wie man den Lkw für die Fahrt vorbereitet und ihn dann zum ersten Mal vorwärts fährt."

#### 1_03 goal

	key[]: "aca_goal_book1_1_03_electrics"
	val[]: "Einschalten der Zündung"

	key[]: "aca_goal_book1_1_03_start"
	val[]: "Den Motor starten"

	key[]: "aca_goal_book1_1_03_look_mirror"
	val[]: "Umgebung kontrollieren"

	key[]: "aca_goal_book1_1_03_brake"
	val[]: "Betriebsbremse betätigen"

	key[]: "aca_goal_book1_1_03_gear"
	val[]: "Den Gang einlegen"

	key[]: "aca_goal_book1_1_03_park_br_off"
	val[]: "Lösen der Feststellbremse"

	key[]: "aca_goal_book1_1_03_forward"
	val[]: "Vorwärts fahren"

	key[]: "aca_goal_book1_1_03_stop"
	val[]: "Anhalten"

	key[]: "aca_goal_book1_1_03_park_br_on"
	val[]: "Feststellbremse betätigen"

	key[]: "aca_goal_book1_1_03_gear_n"
	val[]: "In Neutral schalten"

	key[]: "aca_goal_book1_1_03_end"
	val[]: "Abstellen des Motors"

#### 1_03 msg - intro text

	key[]: "aca_msg_book1_1_03_cutscene1"
	val[]: "Für deine ersten Fahrten werden wir nur die Zugmaschine verwenden.<br>Ein Lkw wird als Zugmaschine bezeichnet, wenn er keinen eigenen Aufbau für Fracht hat und stattdessen einen Auflieger nutzt, um Güter und Materialien zu transportieren."

	key[]: "aca_msg_book1_1_03_cutscene2"
	val[]: "Zugmaschinen sind weit verbreitet, weil sie große Vielseitigkeit bieten: Sie können einen leeren Auflieger abstellen und einen beladenen aufnehmen, ohne warten zu müssen, oder sogar auf eine andere Art von Auflieger wechseln."

	key[]: "aca_msg_book1_1_03_cutscene3"
	val[]: "Bei deiner ersten Fahrt besteht deine Aufgabe darin, vorwärts zu fahren und nach der gestrichelten Linie anzuhalten.<br>Starte den Motor und folge den Anweisungen, um den Lkw fahrbereit zu machen. Sobald alles vorbereitet ist, fahre geradeaus."

	key[]: "aca_msg_book1_1_03_cutscene4"
	val[]: "Fahre über die gestrichelte Linie, halte an, schalte den Motor ab und sichere den Lkw."

#### 1_03 Driving Instructions

	key[]: "aca_msg_book1_1_03_electrics"
	val[]: "Für den nächsten Schritt deiner Ausbildung wirst du den Lkw zum ersten Mal bewegen.<br><br>Natürlich funktioniert das nicht ohne laufenden Motor, daher musst du zuerst die Zündung einschalten.<br><br><font face=/font/big_bold.font>Drücke $input engineelect$, um die Zündung einzuschalten.</font>@@aca_goal_tip@@ In der Karriere wird der Motor standardmäßig zusammen mit der Elektrik automatisch gestartet. Du kannst dieses Verhalten für die Karriere im Optionsbildschirm unter „Gameplay“ – @@auto_engine_start@@ anpassen."

	key[]: "aca_msg_book1_1_03_start"
	val[]: "Die Zündung aktiviert die Elektronik des Lkws. Du hast vielleicht bemerkt, dass die Warnleuchten auf dem Armaturenbrett aufleuchten – das ist normal. Wenn sie jedoch nach dem Starten des Motors weiterhin leuchten, deutet das wahrscheinlich auf ein Problem mit dem Lkw hin. Die Ausnahme ist die Warnleuchte der Feststellbremse, die erlischt, sobald wir diese lösen.<br><br>Glücklicherweise ist dieser Lkw in gutem Zustand, und wir sind bereit, fortzufahren.<br><br><font face=/font/big_bold.font>Drücke @@imv_nrm_engine@@, um den Motor zu starten.</font>"

	key[]: "aca_msg_book1_1_03_look_mirror"
	val[]: "Jetzt, da der Motor gestartet ist, ist es wichtig, vor jeder Bewegung die Umgebung zu überprüfen.<br><br><font face=/font/big_bold.font>Schaue dich um den Lkw und überprüfe die Spiegel auf der Fahrer- und Beifahrerseite, um sicherzustellen, dass der Bereich um den Lkw frei ist.</font>@@aca_goal_tip@@ Du musst dich im Fahrzeug befinden."

	key[]: "aca_msg_book1_1_03_brake"
	val[]: "Es mag offensichtlich erscheinen, aber du solltest wissen, wie man anhält, bevor du dich in Bewegung setzt.<br><br><font face=/font/big_bold.font>Betätige die Betriebsbremse mit $input backward$.</font>"

	key[]: "aca_msg_book1_1_03_gear_arcade"
	val[]: "Als Nächstes wirst du lernen, wie du die Fahrtrichtung änderst.<br><br>Mit einem vereinfachten Automatikgetriebe ist es nicht notwendig, Gänge zu schalten, da alles automatisch für dich erledigt wird.<br><br><font face=/font/big_bold.font>Drücke $input forward$, um einen Vorwärtsgang einzulegen.</font>"

	key[]: "aca_msg_book1_1_03_gear_automatic"
	val[]: "Als Nächstes wirst du lernen, wie du die Fahrtrichtung änderst.<br><br>Das realistische Automatikgetriebe ermöglicht es dir, wie bei echten Automatikgetrieben zwischen Drive, Neutral und Rückwärts zu wechseln.<br><br><font face=/font/big_bold.font>Drücke @@imv_nrm_gearup@@, um einen Vorwärtsgang einzulegen.</font>"

	key[]: "aca_msg_book1_1_03_gear_manual"
	val[]: "Als Nächstes wirst du lernen, wie du die Fahrtrichtung änderst.<br><br>Das sequentielle Getriebe ermöglicht das Schalten in Stufen, genau wie bei echten sequentiellen Getrieben.<br><br>So wie du einen Vorwärtsgang einlegst, musst du während des Beschleunigens in höhere Gänge schalten.<br><br><font face=/font/big_bold.font>Drücke @@imv_nrm_gearup@@, um den ersten Gang einzulegen.</font>"

	key[]: "aca_msg_book1_1_03_gear_direct"
	val[]: "Als Nächstes wirst du lernen, wie du die Fahrtrichtung änderst.<br><br>Mit dem Schalthebel und der Kupplung erlebst du das gleiche Gefühl wie beim physischen Schalten eines echten Schaltgetriebes.<br><br>Drücke die Kupplung und die Betriebsbremse vollständig durch. <font face=/font/big_bold.font>Lege mit dem Schalthebel den ersten Gang ein. <color value=@@clr_txt@@>Halte die Kupplung und die Betriebsbremse weiterhin vollständig gedrückt.</font>"

	key[]: "aca_msg_book1_1_03_park_br_off"
	val[]: "Um loszufahren, musst du zuerst die Feststellbremse lösen.<br><br><font face=/font/big_bold.font>Drücke @@imv_nrm_parkingbrake@@, um die Feststellbremse zu lösen.</font> @@aca_goal_tip@@ In der Karriere ist die Feststellbremse anfangs deaktiviert. Du kannst dieses Verhalten im Optionsbildschirm unter „Gameplay“ – @@auto_park_brake@@ anpassen."

	key[]: "aca_msg_book1_1_03_forward_arcade"
	val[]: "Jetzt ist der Lkw bereit, vorwärts zu fahren. Setze ihn in Bewegung und überquere die gestrichelte Linie.<br><br><font face=/font/big_bold.font>Beginne die Fahrt, indem du das Gaspedal betätigst: $input forward$</font>"

	key[]: "aca_msg_book1_1_03_forward_automatic"
	val[]: "Jetzt ist der Lkw bereit, vorwärts zu fahren. Setze ihn in Bewegung und überquere die gestrichelte Linie.<br><br><font face=/font/big_bold.font>Beginne die Fahrt, indem du das Gaspedal betätigst: $input forward$</font>"

	key[]: "aca_msg_book1_1_03_forward_manual"
	val[]: "Jetzt ist der Lkw bereit, vorwärts zu fahren. Setze ihn in Bewegung und überquere die gestrichelte Linie.<br><br><font face=/font/big_bold.font>Beginne die Fahrt, indem du das Gaspedal betätigst: $input forward$</font>"

	key[]: "aca_msg_book1_1_03_forward_direct"
	val[]: "Jetzt ist der Lkw bereit, vorwärts zu fahren. Setze dich in Bewegung und überquere die gestrichelte Linie.<br><br><font face=/font/big_bold.font>Löse die Betriebsbremse, lass die Kupplung langsam kommen, um sie einzukuppeln, und betätige gleichzeitig das Gaspedal, um die Drehzahl hoch zu halten, damit der Lkw nicht abstirbt. Sobald die Kupplung vollständig losgelassen ist, kannst du beschleunigen und nach Bedarf schalten.</font>"

	key[]: "aca_msg_book1_1_03_stop_arcade"
	val[]: "Benutze die Betriebsbremse, um anzuhalten.<br><br><font face=/font/big_bold.font>Drücke $input backward$, um den Lkw anzuhalten.</font>"

	key[]: "aca_msg_book1_1_03_stop_automatic"
	val[]: "Benutze die Betriebsbremse, um anzuhalten.<br><br><font face=/font/big_bold.font>Drücke $input backward$, um den Lkw anzuhalten.</font>"

	key[]: "aca_msg_book1_1_03_stop_manual"
	val[]: "Benutze die Betriebsbremse, um anzuhalten.<br><br><font face=/font/big_bold.font>Drücke $input backward$, um den Lkw anzuhalten.</font>"

	key[]: "aca_msg_book1_1_03_stop_direct"
	val[]: "Wenn es Zeit ist anzuhalten, drücke die Kupplung vollständig durch <font face=/font/big_bold.font>und stoppe dann den Lkw mit der Betriebsbremse.<color value=@@clr_txt@@> Schalte mit dem Schalthebel in den Leerlauf, dann kannst du die Kupplung loslassen.</font>"

	key[]: "aca_msg_book1_1_03_park_br_on"
	val[]: "Sichere nun den Lkw. Die Feststellbremse sorgt dafür, dass der Lkw nach dem Parken nicht ungewollt rollt.<br><br><font face=/font/big_bold.font>Drücke @@imv_nrm_parkingbrake@@, um die Feststellbremse zu aktivieren.</font>"

	key[]: "aca_msg_book1_1_03_gear_n_arcade"
	val[]: "Mit einem vereinfachten Automatikgetriebe ist es nicht notwendig, Gänge zu schalten, da alles automatisch für dich erledigt wird.<br><br><font face=/font/big_bold.font>Drücke @@imv_nrm_activate@@, um zu bestätigen.</font>"

	key[]: "aca_msg_book1_1_03_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>Schalte in den Leerlauf, indem du @@imv_nrm_geardown@@ drückst.</font>"

	key[]: "aca_msg_book1_1_03_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>Schalte in den Leerlauf, indem du @@imv_nrm_geardown@@ drückst.</font>"

	key[]: "aca_msg_book1_1_03_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>Schalte den Schalthebel in den Leerlauf und lass dann die Kupplung los.</font>"

	key[]: "aca_msg_book1_1_03_end"
	val[]: "Du weißt jetzt, wie du den Lkw in Bewegung setzen und sicher zum Stehen bringen kannst.<br><br><font face=/font/big_bold.font>Drücke $input engineelect$, um den Motor auszuschalten.</font>"
#@}

#+ Book 1 Scenario 1_04
#@{

#### 1_04 common
	key[]: "aca_scenario_book1_1_04_title"
	val[]: "Rückwärtsfahren"

	key[]: "aca_scenario_book1_1_04_desc"
	val[]: "In dieser Lektion werden wir zum ersten Mal das Rückwärtsfahren ausprobieren. Wir sprechen auch darüber, wie du deine Spiegel nutzen kannst, um nach hinten zu sehen, worauf du achten musst und wie du dich auf die Rückwärtsbewegung vorbereitest."

#### 1_04 goal

	key[]: "aca_goal_book1_1_04_start"
	val[]: "Den Motor starten"

	key[]: "aca_goal_book1_1_04_look_mirror"
	val[]: "Kontrolle des Spiegels auf Beifahrer Seite"

	key[]: "aca_goal_book1_1_04_look_back"
	val[]: "Kontrolle des Spiegels auf Fahrer Seite"

	key[]: "aca_goal_book1_1_04_gear_r"
	val[]: "Den Gang einlegen"

	key[]: "aca_goal_book1_1_04_park_br_off"
	val[]: "Lösen der Feststellbremse"
#!{
	key[]: "aca_goal_book1_1_04_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_1_04_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_1_04_park_br_on"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

#!}
	key[]: "aca_goal_book1_1_04_gear_n"
	val[]: "In Neutral schalten"

	key[]: "aca_goal_book1_1_04_end"
	val[]: "Motor ausschalten"

#### 1_04 msg - intro text

	key[]: "aca_msg_book1_1_04_cutscene1"
	val[]: "Bei dieser Übung fahren wir in einer geraden Linie rückwärts. Fahre langsam rückwärts über die gestrichelte Linie und halte dort an."

	key[]: "aca_msg_book1_1_04_cutscene2"
	val[]: "Beim Rückwärtsfahren des Lkw ist es wichtig, ständig aufmerksam zu bleiben, alle Spiegel im Blick zu haben und sicherzustellen, dass der Bereich um dich herum und hinter dir frei ist."

	key[]: "aca_msg_book1_1_04_cutscene3"
	val[]: "Starte den Motor, schalte in den Rückwärtsgang und setze dich langsam in Bewegung."

	key[]: "aca_msg_book1_1_04_cutscene4"
	val[]: "Fahre rückwärts über die gestrichelte Linie, halte an, schalte den Motor aus und sichere den Lkw."

#### 1_04 Driving Instructions

	key[]: "aca_msg_book1_1_04_start"
	val[]: "Mache den Lkw fahrbereit, wie du es in der vorherigen Lektion gelernt hast.<br><br><font face=/font/big_bold.font>Wenn du bereit bist, starte den Motor.</font>"

	key[]: "aca_msg_book1_1_04_look_mirror"
	val[]: "Überprüfe deine Spiegel, um sicherzustellen, dass der Bereich um dich herum frei ist. Wenn du mit den Positionen nicht zufrieden bist, kannst du sie in '@@adjust_link_t@@' anpassen.<br><br><font face=/font/big_bold.font>Schaue in den Spiegel auf der Beifahrerseite.</font>@@aca_goal_tip@@ Du musst dich im Fahrzeug befinden."

	key[]: "aca_msg_book1_1_04_look_back"
	val[]: "Du wirst die gestrichelte Linie überqueren. Die Spur ist jetzt frei, aber beim regulären Fahren ist es wichtig, ständig die Umgebung im Blick zu behalten, indem du dich umsiehst und die Spiegel nutzt.<br><br><font face=/font/big_bold.font>Überprüfe den Spiegel auf der Fahrerseite.</font>"

	key[]: "aca_msg_book1_1_04_gear_r_arcade"
	val[]: "<font face=/font/big_bold.font>Drücke $input backward$, um den Rückwärtsgang einzulegen.</font> @@aca_goal_tip@@ Beim Rückwärtsfahren aktiviert sich bei den meisten Lkws automatisch das Rückfahrwarnsignal. Du kannst es im Optionsbildschirm unter „Audio“ – @@sound_of_reverse@@ ausschalten."

	key[]: "aca_msg_book1_1_04_gear_r_automatic"
	val[]: "<font face=/font/big_bold.font>Drücke @@imv_nrm_geardown@@, um in den Rückwärtsgang zu schalten.</font> @@aca_goal_tip@@ Beim Rückwärtsfahren aktiviert sich bei den meisten Lkw automatisch das Rückfahrwarnsignal. Du kannst es im Optionsbildschirm unter „Audio“ – @@sound_of_reverse@@ ausschalten."

	key[]: "aca_msg_book1_1_04_gear_r_manual"
	val[]: "<font face=/font/big_bold.font>Drücke @@imv_nrm_geardown@@, um in den Rückwärtsgang zu schalten.</font> @@aca_goal_tip@@ Beim Rückwärtsfahren aktiviert sich bei den meisten Lkw automatisch das Rückfahrwarnsignal. Du kannst es im Optionsbildschirm unter „Audio“ – @@sound_of_reverse@@ ausschalten."

	key[]: "aca_msg_book1_1_04_gear_r_direct"
	val[]: "<font face=/font/big_bold.font>Drücke die Kupplung vollständig und schalte den Schalthebel in den Rückwärtsgang.</font> @@aca_goal_tip@@ Beim Rückwärtsfahren aktiviert sich bei den meisten Lkw automatisch das Rückfahrwarnsignal. Du kannst es im Optionsbildschirm unter „Audio“ – @@sound_of_reverse@@ ausschalten."

	key[]: "aca_msg_book1_1_04_park_br_off"
	val[]: "Der Rückwärtsgang ist jetzt eingelegt.<br><br><font face=/font/big_bold.font>Löse die Feststellbremse mit @@imv_nrm_parkingbrake@@.</font>"

	key[]: "aca_msg_book1_1_04_backward_arcade"
	val[]: "Setze dich in Bewegung, indem du $input backward$ benutzt.<br><br><font face=/font/big_bold.font>Fahre rückwärts über die gestrichelte Linie.</font>"

	key[]: "aca_msg_book1_1_04_backward_automatic"
	val[]: "Setze dich in Bewegung, indem du das Gaspedal benutzt: $input forward$.<br><br><font face=/font/big_bold.font>Fahre rückwärts über die gestrichelte Linie.</font>"

	key[]: "aca_msg_book1_1_04_backward_manual"
	val[]: "Setze dich in Bewegung, indem du das Gaspedal betätigst: $input forward$.<br><br><font face=/font/big_bold.font>Fahre rückwärts über die gestrichelte Linie.</font>"

	key[]: "aca_msg_book1_1_04_backward_direct"
	val[]: "Lass die Kupplung langsam kommen, während du die Drehzahl des Motors mit dem Gaspedal hältst.<br><br><font face=/font/big_bold.font>Fahre rückwärts über die gestrichelte Linie.</font>"

	key[]: "aca_msg_book1_1_04_stop_arcade"
	val[]: "<font face=/font/big_bold.font>Halte den Lkw mit der Betriebsbremse an: $input forward$</font>"

	key[]: "aca_msg_book1_1_04_stop_automatic"
	val[]: "<font face=/font/big_bold.font>Halte den Lkw mit der Betriebsbremse an: $input backward$</font>"

	key[]: "aca_msg_book1_1_04_stop_manual"
	val[]: "<font face=/font/big_bold.font>Halte den Lkw mit der Betriebsbremse an: $input backward$</font>"

	key[]: "aca_msg_book1_1_04_stop_direct"
	val[]: "<font face=/font/big_bold.font>Drücke die Kupplung vollständig durch und halte den Lkw dann mit der Betriebsbremse an.</font>"

	key[]: "aca_msg_book1_1_04_park_br_on"
	val[]: "<font face=/font/big_bold.font>Aktiviere die Feststellbremse mit @@imv_nrm_parkingbrake@@.</font>"

	key[]: "aca_msg_book1_1_04_gear_n_arcade"
	val[]: "Mit einem vereinfachten Automatikgetriebe ist es nicht nötig, Gänge zu schalten, da alles automatisch für dich erledigt wird – anders als in der Realität.<br><br><font face=/font/big_bold.font>Drücke @@imv_nrm_activate@@, um zu bestätigen.</font>"

	key[]: "aca_msg_book1_1_04_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>Schalte in den Leerlauf, indem du @@imv_nrm_gearup@@ drückst.</font>@@aca_goal_tip@@ Moderne Lkw schalten automatisch in den Leerlauf, wenn die Feststellbremse betätigt wird. Es ist jedoch eine gute Angewohnheit, dies immer selbst zu tun. In den folgenden Lektionen wird dieser Schritt nicht mehr erforderlich sein."

	key[]: "aca_msg_book1_1_04_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>Schalte in den Leerlauf, indem du @@imv_nrm_gearup@@ drückst.</font> @@aca_goal_tip@@ Moderne Lkw schalten automatisch in den Leerlauf, wenn die Feststellbremse betätigt wird. Es ist jedoch eine gute Gewohnheit, dies immer selbst zu tun. In den folgenden Lektionen wird dieser Schritt nicht mehr erforderlich sein."

	key[]: "aca_msg_book1_1_04_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>Schalte den Wählhebel in den Leerlauf und lasse dann die Kupplung los.</font>@@aca_goal_tip@@ Moderne Lkws schalten automatisch in den Leerlauf, wenn die Feststellbremse angezogen wird. Es ist jedoch eine gute Angewohnheit, dies immer selbst zu tun. In den folgenden Lektionen wird dieser Schritt nicht erforderlich sein."

	key[]: "aca_msg_book1_1_04_end"
	val[]: "Denke daran, beim Rückwärtsfahren stets auf deine Umgebung zu achten, besonders in stark frequentierten Bereichen mit viel Verkehr.<br><br><font face=/font/big_bold.font>Schalte den Motor ab, indem du $input engineelect$ drückst.</font>"
#@}

