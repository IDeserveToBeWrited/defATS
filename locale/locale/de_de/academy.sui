#+ Chapters general
#@{
	key[]: "aca_chapter_book1_1_title"
	val[]: "Grundlegende Steuerungen und Bewegung"

	key[]: "aca_chapter_book1_1_desc"
	val[]: "Lerne grundlegende Fahrzeug Steuerung und wie man den Lkw nach vorne und hinten bewegt."

	key[]: "aca_chapter_book1_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Herzlichen Glückwunsch!<br>Du hast Kapitel 1 abgeschlossen: @@aca_chapter_book1_1_title@@.<br><br>Du hast gelernt, wie man den Lkw vor der Fahrt vorbereitet,<br>vorwärts und rückwärts fährt und wie man Scheinwerfer und Scheibenwischer verwendet.</font><br><br>"

	key[]: "aca_chapter_book1_2_title"
	val[]: "Grundlegende Manöver"

	key[]: "aca_chapter_book1_2_desc"
	val[]: "Lerne, mit einer Zugmaschine zu fahren, zu manövrieren und zu parken. Entdecke den Zweck der verschiedenen Spiegeltypen und wie man sie richtig einsetzt."

	key[]: "aca_chapter_book1_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Herzlichen Glückwunsch!<br>Du hast Kapitel 2 abgeschlossen: @@aca_chapter_book1_2_title@@.<br><br>Du hast gelernt, wie du jeden Spiegel am Lkw verwendest, den Bereich um den Lkw vor der Fahrt überprüfst und sowohl grundlegende als auch fortgeschrittene Manöver ausführst.</font>"

	key[]: "aca_chapter_book1_3_title"
	val[]: "Manövrieren mit einem Auflieger"

	key[]: "aca_chapter_book1_3_desc"
	val[]: "Lerne wie man einen Auflieger verbindet und mit einem durch verschiedene Situationen manövriert."

	key[]: "aca_chapter_book1_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Herzlichen Glückwunsch!<br>Du hast Kapitel 3 abgeschlossen: @@aca_chapter_book1_3_title@@.<br><br>Du hast gelernt, einen Auflieger anzukuppeln und abzukuppeln,<br>ein Gefühl für das Gewicht und die Abmessungen des Lkw mit Auflieger zu entwickeln<br>und auf anspruchsvollen Strecken mit einem Auflieger zu fahren.</font><br><br>"

	key[]: "aca_chapter_book1_4_title"
	val[]: "Rückwärtsfahren mit einem Auflieger"

	key[]: "aca_chapter_book1_4_desc"
	val[]: "Lerne neue Manöver zum effektiven Rückwärtsfahren und Einparken mit einem Auflieger."

	key[]: "aca_chapter_book1_4_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Herzlichen Glückwunsch!<br>Du hast Kapitel 4 abgeschlossen: @@aca_chapter_book1_4_title@@.<br><br>Du hast gelernt, mit einem Auflieger rückwärts zu fahren<br>und verschiedene Parktechniken anzuwenden.</font><br><br>"

	key[]: "aca_chapter_book1_5_title"
	val[]: "Abschlussprüfung"

	key[]: "aca_chapter_book1_5_desc"
	val[]: "Stelle dein Wissen und Können unter Beweis, um sich als Trucker zu beweisen!"

	key[]: "aca_chapter_book1_5_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Herzlichen Glückwunsch!<br>Du hast Kapitel 5 abgeschlossen: @@aca_chapter_book1_5_title@@.<br><br>Du hast bewiesen, dass du alle nötigen Fähigkeiten und Fertigkeiten<br>zum Fahren, Manövrieren und Parken eines Lkw beherrschst!</font><br><br>"

	key[]: "aca_chapter_book2_0_title"
	val[]: "Den Motor warmlaufen lassen"

	key[]: "aca_chapter_book2_0_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Du hast die Schulung abgeschlossen: @@aca_chapter_book2_0_title@@.<br><br>Du hast die Regeln und Funktionen von Driving Proficiency kennengelernt.</font><br><br>"

	key[]: "aca_chapter_book2_1_title"
	val[]: "Wieder voll dabei"

	key[]: "aca_chapter_book2_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Herzlichen Glückwunsch!<br>Du hast Kapitel 2: @@aca_chapter_book2_1_title@@ abgeschlossen.<br><br>Du hast den Motor warmlaufen lassen, die Gänge getestet, die Räder ordnungsgemäß gedreht und die Bremsleistung überprüft. Die nächsten Kapitel werden anspruchsvoller sein.</font><br><br>"

	key[]: "aca_chapter_book2_2_title"
	val[]: "Räder in Bewegung"

	key[]: "aca_chapter_book2_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Herzlichen Glückwunsch!<br>Du hast Kapitel 3: @@aca_chapter_book2_2_title@@ abgeschlossen.<br><br>Du hast schwierige und abwechslungsreiche Szenarien gemeistert. Du hast dein Können und deine Leistungsfähigkeit unter Beweis gestellt.</font><br><br>"

	key[]: "aca_chapter_book2_3_title"
	val[]: "Die Zielgerade"

	key[]: "aca_chapter_book2_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Herzlichen Glückwunsch!<br>Du hast Kapitel 4: @@aca_chapter_book2_3_title@@ abgeschlossen.<br><br>Du hast viele schwierige Situationen beim Manövrieren, Einparken und Rückwärtsfahren mit einem Anhänger gemeistert. Du hast bewiesen, dass du ein erfahrener Fahrer sind, der alle Herausforderungen des Lkw-Fahrens meistern kann."

	key[]: "aca_chapter_book3_1_title"
	val[]: "Weitermachen"

	key[]: "aca_chapter_book3_1_desc"
	val[]: "Lerne alle wichtigen Techniken für den Umgang mit einem B-Doppel-Anhänger beim Vorwärtsfahren."

	key[]: "aca_chapter_book3_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Herzlichen Glückwunsch!<br>Du hast Kapitel 1: @@aca_chapter_book3_1_title@@ abgeschlossen.<br><br>Du hast gelernt, wie man mit B-Doppel-Anhängern effektiv fährt und manövriert.</font><br><br>"

	key[]: "aca_chapter_book3_2_title"
	val[]: "Rückwärts Steuerung"

	key[]: "aca_chapter_book3_2_desc"
	val[]: "Verstehe die notwendigen Schritte für den Umgang mit B-Doppel-Anhängern beim Rückwärtsfahren."

	key[]: "aca_chapter_book3_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Herzlichen Glückwunsch!<br>Du hast Kapitel 2: @@aca_chapter_book3_2_title@@ abgeschlossen.<br><br>Du hast die anspruchsvolle Technik des Rückwärtsfahrens mit B-Doppel-Anhängern erlernt.</font><br><br>"

	key[]: "aca_chapter_book3_3_title"
	val[]: "Real World Preparation"

	key[]: "aca_chapter_book3_3_desc"
	val[]: "Wende dein neues Wissen in fortgeschritteneren Szenarien an."

	key[]: "aca_chapter_book3_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Herzlichen Glückwunsch!<br>Du hast Kapitel 3: @@aca_chapter_book3_3_title@@ abgeschlossen.<br><br>Du hast viele schwierige Situationen beim Manövrieren, Einparken und Rückwärtsfahren mit B-Doppel-Anhängern gemeistert. Du hast dich hier bewährt, jetzt ist es an der Zeit, einige B-Doppel-Anhänger auf den Straßen von American Truck Simulator zu ziehen!</font><br><br>"

#@}

