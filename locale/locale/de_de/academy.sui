#+ Book 3 Scenario urf
#@{

#### urf common
	key[]: "aca_scenario_book3_urf_title"
	val[]: "Zurücksetzen Sandbox"

	key[]: "aca_scenario_book3_urf_desc"
	val[]: "In diesem Szenario wirst du auf einen leeren Parkplatz gebracht, um das Rückwärtsfahren mit B-Doubles zu üben."

#### urf goal

	key[]: "aca_goal_book3_urf_start"
	val[]: "Anfangen"

	key[]: "aca_goal_book3_urf_move"
	val[]: "Experimentieren"

	key[]: "aca_goal_book3_urf_stop"
	val[]: "Fertigstellen"

	key[]: "aca_goal_book3_urf_end"
	val[]: "Das Szenario beenden"

	#### urf msg - intro text

	key[]: "aca_msg_book3_urf_cutscene1"
	val[]: "Das Rückwärtsfahren mit B-Doubles erfordert viel mehr Aufmerksamkeit als mit einem einzelnen Anhänger. Du musst im Voraus planen, wohin du den hinteren Anhänger lenken möchtest, während du gleichzeitig den vorderen Anhänger und die Kabine unter Kontrolle hältst. <br><br>Stell dir vor, du würdest den hinteren Anhänger mit dem vorderen Anhänger lenken. Wie auch immer du den vorderen Anhänger ausrichtest, ändert sich die Fahrtrichtung des hinteren Anhängers."

	key[]: "aca_msg_book3_urf_cutscene2"
	val[]: "In this case, we want to turn the rear trailer to the driver's side. <br><br>To do this, we steered the lead to the passenger's side."

	key[]: "aca_msg_book3_urf_cutscene3"
	val[]: "Hier machen die meisten Menschen ihren ersten Fehler. Sobald der hintere Anhänger zu drehen beginnt, musst du deinen Traktor mit der Deichsel gerade ausrichten..."

	key[]: "aca_msg_book3_urf_cutscene4"
	val[]: "...oder du landest am Ende so wie hier."

	key[]: "aca_msg_book3_urf_cutscene5"
	val[]: "Ein Jackknifing tritt auf, wenn der Winkel zwischen zwei Fahrzeugen der Kombination etwa 90 Grad beträgt. Sobald dies geschieht, gibt es kein Zurück mehr – Du musst vorwärts fahren und einen neuen Versuch starten. <br><br> Wie beim Rückwärtsfahren mit einem Anhänger sollte das Ziel immer sein, dass sich alle Räder der Anhänger bewegen. Sobald ein Rad zum Stillstand kommt und der Anhänger sich auf der Stelle dreht, ist es vorbei."

	key[]: "aca_msg_book3_urf_cutscene6"
	val[]: "Du kannst bis zu der Stelle vorfahren, an der du zuletzt richtig gelegen hast, oder besser gesagt, bis zu einer Position, an der du rückwärts weiterarbeiten kannst, ohne denselben Fehler erneut zu machen, oder einfach so weit vorfahren, bis du geradeaus fährst."

	key[]: "aca_msg_book3_urf_cutscene7"
	val[]: "Nochmal, sobald sich der hintere Anhänger dreht, bringst du den Traktor wieder vor den vorderen Anhänger und lässt den hinteren Anhänger einen Moment lang von selbst drehen."

	key[]: "aca_msg_book3_urf_cutscene8"
	val[]: "Nachdem sich der hintere Anhänger nun gut dreht, ist es an der Zeit, den vorderen Anhänger dazu zu bringen, ihm zu folgen. Du kannst den Winkel zwischen dem vorderen und dem hinteren Anhänger einstellen, um die Drehung zu steuern und sie enger oder weiter zu machen."

	key[]: "aca_msg_book3_urf_cutscene9"
	val[]: "Der letzte Teil des Manövers besteht darin, alles wieder gerade auszurichten. Bringe die Front vor das Heck."

	key[]: "aca_msg_book3_urf_cutscene10"
	val[]: "Es ist ratsam, die Zeit zu berücksichtigen, die zum Bewegen des Anhängers benötigt wird, und dass du auch den Traktor in Position bringen musst."

	key[]: "aca_msg_book3_urf_cutscene11"
	val[]: "Verbringe hier so viel Zeit, wie du möchtest, und probiere verschiedene Manöver aus, bis du eine ungefähre Vorstellung davon hast, wie man mit Anhängern rückwärts fährt."

#### urf Driving Instructions

	key[]: "aca_msg_book3_urf_start"
	val[]: "Bereite dich auf die Abfahrt vor."

	key[]: "aca_msg_book3_urf_move"
	val[]: "Nutze diesen Parkplatz, um ein Gefühl für das Rückwärtsfahren mit Anhängern zu bekommen. <br><br>@@aca_goal_tip@@ Du bist noch nicht so vertraut mit dem Rückwärtsfahren mit Anhängern? Dann solltest du vielleicht erst einmal „Grundlagen des Lkw-Fahrens“ spielen."

	key[]: "aca_msg_book3_urf_stop"
	val[]: "Nehme dir so viel Zeit zum Üben, wie du möchtest. <br><br>Wenn du zufrieden bist, kannst du anhalten und den Lkw sichern, um das Szenario zu beenden."

	key[]: "aca_msg_book3_urf_end"
	val[]: "Schalte den Motor aus, um das Szenario zu beenden."
#@}


#+ Book 3 Scenario sup
#@{

#### sup common
	key[]: "aca_scenario_book3_sup_title"
	val[]: "Einparken in einer engen Lücke"

	key[]: "aca_scenario_book3_sup_desc"
	val[]: "In diesem Szenario musst du deine B-Doppel-Kombination auf einem engen Parkplatz abstellen."

#### sup goal

	key[]: "aca_goal_book3_sup_start"
	val[]: "Anfangen"

	key[]: "aca_goal_book3_sup_forward"
	val[]: "Abfahrt"

	key[]: "aca_goal_book3_sup_check1"
	val[]: "Fahre weiter"

	key[]: "aca_goal_book3_sup_stop"
	val[]: "Anhalten"

	key[]: "aca_goal_book3_sup_end"
	val[]: "Das Fahrzeug sichern"

#### sup msg - intro text

	key[]: "aca_msg_book3_sup_cutscene1"
	val[]: "Das Fahren mit B-Doubles kann einschüchternd wirken, aber es unterscheidet sich nicht wesentlich vom Fahren mit einem einzelnen Anhänger – man muss lediglich auch die Spur des hinteren Anhängers berücksichtigen!"

	key[]: "aca_msg_book3_sup_cutscene2"
	val[]: "Vor dir befindet sich ein schmaler Parkplatz. Du hast nicht genug Platz, um vor dem Einfahren perfekt geradeaus zu stehen, daher musst du dir genau überlegen, wie du mit beiden Anhängern hinein kommst."

	key[]: "aca_msg_book3_sup_cutscene3"
	val[]: "Biege sofort in Richtung der gegenüberliegenden Seite des Parkplatzes ab und fahre weit über die Stelle hinaus, an der du normalerweise abbiegen würdest."

	key[]: "aca_msg_book3_sup_cutscene4"
	val[]: "Jetzt, da dein hinterer Anhänger auf der Spur ist, kannst du dich auf den Weg zum Zielort machen. Möglicherweise musst du noch einmal zur anderen Seite fahren, um deinen ersten Anhänger herumzudrehen."

	key[]: "aca_msg_book3_sup_cutscene5"
	val[]: "Fahre weiter in die Parklücke hinein, beide Anhänger folgen dir und richten sich dabei von selbst aus."

	key[]: "aca_msg_book3_sup_cutscene6"
	val[]: "Parke im vorgesehenen Bereich und sichere den Lkw."

#### sup Driving Instructions

	key[]: "aca_msg_book3_sup_start"
	val[]: "Bereite dich auf die Abfahrt vor."

	key[]: "aca_msg_book3_sup_forward"
	val[]: "Gehe weiter vorwärts und in den schmalen Raum hinein."

	key[]: "aca_msg_book3_sup_check1"
	val[]: "Fahre weiter."

	key[]: "aca_msg_book3_sup_stop"
	val[]: "Halte im vorgesehenen Bereich an."

	key[]: "aca_msg_book3_sup_end"
	val[]: "Sichere den Lkw und schalte den Motor aus."
#@}


