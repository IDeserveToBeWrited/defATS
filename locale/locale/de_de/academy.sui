	key[]: "aca_goal_book1_3_12_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"
 #!}

#### 3_12 msg - intro text

	key[]: "aca_msg_book1_3_12_cutscene01"
	val[]: "In dieser Lektion schauen wir uns an, wie man auf engem Raum wendet.<br>Du wirst nicht immer viel Platz zum Manövrieren des Lkw haben und musst dich oft an weniger ideale Gegebenheiten anpassen."

	key[]: "aca_msg_book1_3_12_cutscene02"
	val[]: "Fahre durch die Gasse in den offenen Bereich."

	key[]: "aca_msg_book1_3_12_cutscene03"
	val[]: "Links befindet sich eine weitere Gasse, in die du rückwärts einfahren musst. Positioniere dich entsprechend, wie es dir am besten passt.<br>Es kann hilfreich sein, den Auflieger schon vor dem Rückwärtsfahren in Richtung der Gasse auszurichten."

	key[]: "aca_msg_book1_3_12_cutscene04"
	val[]: "Setze rückwärts in Richtung der Gasse zurück. Achte dabei sorgfältig auf alle Seiten der Zugmaschine und des Aufliegers."

	key[]: "aca_msg_book1_3_12_cutscene05"
	val[]: "In der Gasse gibt es Hindernisse, daher solltest du dich möglichst nah an der Fahrerseite halten."

	key[]: "aca_msg_book1_3_12_cutscene06"
	val[]: "Sobald du das Rückwärtsfahren abgeschlossen hast, kannst du vorwärtsfahren und in die Richtung zurückkehren, aus der du gekommen bist."

	key[]: "aca_msg_book1_3_12_cutscene07"
	val[]: "Beim Herausfahren kann es schwierig sein, den Auflieger im Spiegel auf der Beifahrerseite zu sehen. Nutze daher den gesamten verfügbaren Platz zu deinem Vorteil."

	key[]: "aca_msg_book1_3_12_cutscene08"
	val[]: "Fahre weiter in Richtung Ausfahrt."

	key[]: "aca_msg_book1_3_12_cutscene09"
	val[]: "Parke im vorgesehenen Bereich und sichere den Lkw."
#!{
	key[]: "aca_msg_book1_3_12_cutscene10"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_12_cutscene11"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_12_cutscene12"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_12_cutscene13"
	val[]: "Unused"
#!}
#### 3_12 Driving Instructions

	key[]: "aca_msg_book1_3_12_start"
	val[]: "Vor dir befindet sich ein Bereich, der den Hof einer Spedition darstellt. Deine Aufgabe ist es, hineinzufahren und den Lkw zu wenden, um wieder herauszufahren. Nutze den vorhandenen Platz optimal aus.<br><br><font face=/font/big_bold.font>Mach dich bereit zur Abfahrt.</font>"

	key[]: "aca_msg_book1_3_12_forward"
	val[]: "<font face=/font/big_bold.font>Fahre durch die Gasse.</font>"

	key[]: "aca_msg_book1_3_12_check1"
	val[]: "Gleich hinter dem Gebäude auf der linken Seite befindet sich eine weitere Gasse, in die du rückwärts einfahren musst. Positioniere dich entsprechend.<br><br><font face=/font/big_bold.font>Fahre weiter in Richtung der Absperrungen.</font>"



	key[]: "aca_msg_book1_3_12_check3"
	val[]: "Setze rückwärts und lenke den Auflieger in Richtung der Gasse, achte dabei darauf, dass die Zugmaschine nichts auf der rechten Seite berührt.<br><br><font face=/font/big_bold.font>Beginne mit dem Rückwärtsfahren und lenke den Auflieger in die Gasse. Halte im markierten Bereich an.</font>"

	key[]: "aca_msg_book1_3_12_check4"
	val[]: "Du kannst nun den Bereich in der gleichen Richtung verlassen, aus der du gekommen bist. Nutze den verfügbaren Platz optimal.<br><br><font face=/font/big_bold.font>Fahre vorwärts und biege rechts ab.</font>"


	key[]: "aca_msg_book1_3_12_check6"
	val[]: "Fahre weiter durch die Gasse in Richtung des ausgewiesenen Bereichs."
#!{
	key[]: "aca_msg_book1_3_12_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_12_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_12_check5"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_12_check2"
	val[]: "Unused"
#!}

#@}

#+ Book 1 Scenario 3_13
#@{

#### 3_13 common
	key[]: "aca_scenario_book1_3_13_title"
	val[]: "Versetztes Rückwärtsfahr-Manöver"

	key[]: "aca_scenario_book1_3_13_desc"
	val[]: "In dieser Lektion besteht deine Aufgabe darin, rückwärts in eine Parklücke einzuparken, die sich nicht direkt hinter dir befindet. Der Platz zum Manövrieren ist begrenzt, daher musst du den vorhandenen Raum klug nutzen."

