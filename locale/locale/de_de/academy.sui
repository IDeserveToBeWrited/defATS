#+ Book 1 Scenario 3_03
#@{

#### 3_03 common
	key[]: "aca_scenario_book1_3_03_title"
	val[]: "Fahren auf dem Kurs"

	key[]: "aca_scenario_book1_3_03_desc"
	val[]: "In dieser Lektion werden wir das Manövrieren des Aufliegers durch einen kurzen, aber komplexen Hindernisparcours erkunden."

#### 3_03 goal
#!{
	key[]: "aca_goal_book1_3_03_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_03_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_03_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_03_end"
	val[]: "@@aca_goal_book1_2_01_end@@"


 #!}
	key[]: "aca_goal_book1_3_03_check1"
	val[]: "Erste Kurve"

	key[]: "aca_goal_book1_3_03_check2"
	val[]: "Kreisverkehr"

	key[]: "aca_goal_book1_3_03_check3"
	val[]: "90-Grad-Kurve"

	key[]: "aca_goal_book1_3_03_check4"
	val[]: "Jughandle-Kurve"

	key[]: "aca_goal_book1_3_03_check5"
	val[]: "Buttonhook-Kurve"

	key[]: "aca_goal_book1_3_03_check6"
	val[]: "Enge Kurve"


#### generic phrase

	key[]: "aca_goal_book1_3_03_chk_point"
	val[]: "Um die Absperrungen herumfahren"

#### 3_03 msg - intro text

	key[]: "aca_msg_book1_3_03_cutscene01"
	val[]: "Vor dir liegen verschiedene anspruchsvolle Kurven und Hindernisse.<br>Berücksichtige alles, was du bisher gelernt hast und es sollte nicht allzu schwierig sein."

	key[]: "aca_msg_book1_3_03_cutscene02"
	val[]: "Die erste Kurve ist eine einfache Buttonhook-Kurve. Halte dich weit außen, dann sollte sie kein Problem darstellen."

	key[]: "aca_msg_book1_3_03_cutscene03"
	val[]: "Fahre weiter in Richtung Kreisverkehr."

	key[]: "aca_msg_book1_3_03_cutscene04"
	val[]: "Halte den Auflieger vom inneren Rand des Kreisverkehrs fern, indem du die Zugmaschine so weit wie möglich außen herumführst."

	key[]: "aca_msg_book1_3_03_cutscene05"
	val[]: "Die 90-Grad-Linkskurve ist nicht besonders eng, aber achte darauf, keine Leitkegel zu berühren."

	key[]: "aca_msg_book1_3_03_cutscene06"
	val[]: "Diese Kurve ist deutlich enger. Nutze ein Jughandle-Manöver, um sie zu meistern."

	key[]: "aca_msg_book1_3_03_cutscene07"
	val[]: "Du kannst in dieser Kurve ein Buttonhook-Manöver nutzen, aber es gibt zusätzliche Hindernisse, denen du ausweichen musst."

	key[]: "aca_msg_book1_3_03_cutscene09"
	val[]: "Die letzte Kurve ist erneut sehr eng und erfordert eine Kombination aus Jughandle- und Buttonhook-Manövern, um sie zu meistern."

	key[]: "aca_msg_book1_3_03_cutscene10"
	val[]: "Parke im vorgesehenen Bereich, sichere den Lkw und schalte den Motor aus."


#### 3_03 Driving Instructions



	key[]: "aca_msg_book1_3_03_forward"
	val[]: "<font face=/font/big_bold.font>Fahre zur ersten Kurve.</font>"

	key[]: "aca_msg_book1_3_03_check1"
	val[]: "Die erste Kurve ist eine einfache Buttonhook-Kurve.<br><br><font face=/font/big_bold.font><color value=@@clr_txt@@>Fahre durch die Kurve.</font>"

	key[]: "aca_msg_book1_3_03_check2"
	val[]: "Fahre weiter bis zum Kreisverkehr. Denke daran, großzügig außen herumzufahren.<br><br><font face=/font/big_bold.font>Fahre zum Kreisverkehr und darum herum.</font>"

	key[]: "aca_msg_book1_3_03_check3"
	val[]: "Diese 90-Grad-Kurve ist etwas enger, achte darauf, keine Leitkegel zu berühren.<br><br><font face=/font/big_bold.font>Nimm die Kurve.</font>"

	key[]: "aca_msg_book1_3_03_check4"
	val[]: "Diese Kurve lässt sich am besten mit einem Jughandle-Manöver angehen. Schwenke weit aus, bevor du in die Kreuzung einfährst.<br><br><font face=/font/big_bold.font>Mache einen Jughandle-Turn.</font>"

	key[]: "aca_msg_book1_3_03_check5"
	val[]: "Diese Kurve ist mit verschiedenen Hindernissen gespickt, lässt sich jedoch mit einem Buttonhook-Manöver bewältigen.<br><br><font face=/font/big_bold.font>Fahre vorsichtig weiter.</font>"

	key[]: "aca_msg_book1_3_03_check6"
	val[]: "Diese Kurve ist die bisher engste, meistere sie auf die Weise, die dir am besten passt.<br><br><font face=/font/big_bold.font>Biege in den Parkplatz ein.</font>"
#!{
	key[]: "aca_msg_book1_3_03_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_03_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

#@}

#+ Book 1 Scenario 3_04
#@{

#### 3_04 common
	key[]: "aca_scenario_book1_3_04_title"
	val[]: "Fortgeschrittener Trainingskurs - Auflieger"

	key[]: "aca_scenario_book1_3_04_desc"
	val[]: "In der letzten Lektion von Kapitel 3 fahren wir auf einem längeren Trainingskurs mit verschiedenen Kurven, um zu sehen, wie gut du das Manövrieren mit einem Auflieger gelernt hast."

