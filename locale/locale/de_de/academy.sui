	key[]: "aca_book_disclaimer_topbar"
	val[]: "Dies ist kein zertifiziertes Trainingsprogramm."

	key[]: "aca_book_disclaimer"
	val[]: "<color value=@@clr_sel@@><font face=/font/big_bold.font>Diese simulierte Fahrschule soll keine realen Fahrstunden im Fahrerhaus ersetzen.</font><br><br> <color value=@@clr_txt@@>Wir empfehlen dringend, eine Schulung und Prüfung bei einer anerkannten Fahrschule für Lkw-Fahrer zu absolvieren, bevor du versuchst, in der Realität einen Lkw zu fahren.<br><br>Fahrschulen, die daran interessiert sind, unseren Fahrschulsimulator zur Ergänzung der Schulung im Fahrerhaus zu nutzen, können uns unter academy@scssoft.com kontaktieren."

	key[]: "aca_book_book1_title"
	val[]: "Lkw Fahr Basics"

	key[]: "aca_book_book1_desc"
	val[]: "Lerne die Basics des Lkw Fahrens, von grundlegenden Funktionen und der Steuerung um mit einem Auflieger zu manövrieren."

	key[]: "aca_book_book2_title"
	val[]: "Lkw Fahr Kompetenz"

	key[]: "aca_book_book2_desc"
	val[]: "Verbessere deine Lkw-Fahrfähigkeiten mit neuen Lektionen unter anspruchsvolleren Bedingungen."

	key[]: "aca_book_book3_title"
	val[]: "Doppelanhänger-Handling"

	key[]: "aca_book_book3_desc"
	val[]: "Stelle dich den spannenden Herausforderungen des Fahrens und Rückwärtsfahrens mit einem B-Doppel-Sattelzug."
#@}

