#@{

#### finex common

	key[]: "aca_scenario_book3_finex_title"
	val[]: "Abschlussprüfung"

	key[]: "aca_scenario_book3_finex_desc"
	val[]: "In diesem Szenario werden deine neuen Fähigkeiten in einem Kurs auf die Probe gestellt, der darauf ausgelegt ist, deine Präzision und dein Verständnis für das Fahren mit B-Doubles zu testen."

#### finex goal

	key[]: "aca_goal_book3_finex_check0"
	val[]: "Rückwärtsfahren"

	key[]: "aca_goal_book3_finex_check1"
	val[]: "Fahre in den Kurs ein"

	key[]: "aca_goal_book3_finex_check2"
	val[]: "Auf Geschwindigkeit kommen"

	key[]: "aca_goal_book3_finex_check22"
	val[]: "Bereite dich aufs bremsen vor"

	key[]: "aca_goal_book3_finex_speed"
	val[]: "Unzureichende Geschwindigkeit"

#!{
	key[]: "aca_goal_book3_finex_check4"
	val[]: "@@aca_goal_book3_sup_check1@@"
#!}
	key[]: "aca_goal_book3_finex_check5"
	val[]: "Parken"

#!{
	key[]: "aca_goal_book3_finex_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_finex_end"
	val[]: "@@aca_goal_book3_sup_end@@"

	key[]: "aca_goal_book3_finex_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_finex_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
#### finex msg - intro text

	key[]: "aca_msg_book3_finex_cutscene1"
	val[]: "Willkommen zur Abschlussprüfung. Wir haben einige realistische Situationen zusammengestellt, denen du unterwegs begegnen könntest, um zu sehen, wie du damit umgehst. Nimm dir wie immer Zeit und sei präzise. <br><br>Viel Glück!"

#### finex Driving Instructions

	key[]: "aca_msg_book3_finex_check0"
	val[]: "Der Weg ist versperrt, wende bitte auf dem dafür vorgesehenen Platz."

	key[]: "aca_msg_book3_finex_check1"
	val[]: "Fahre weiter in Richtung Stadtzentrum."

	key[]: "aca_msg_book3_finex_check2"
	val[]: "Erreiche beim Einfahren ins Stadtzentrum eine Geschwindigkeit von mindestens 37 mph (60 km/h)."

	key[]: "aca_msg_book3_finex_check22"
	val[]: "Bereite dich aufs bremsen vor."

	key[]: "aca_msg_book3_finex_speed"
	val[]: "Du hast es nicht geschafft, eine Geschwindigkeit von 37 mph (60 km/h) zu erreichen"

	key[]: "aca_msg_book3_finex_check4"
	val[]: "Fahre weiter auf dem Kurs."

	key[]: "aca_msg_book3_finex_check5"
	val[]: "Es gibt einen Parkplatz für dich in der Reihe der Lastwagen auf der linken Seite. Fahre rückwärts hinein und parke."

#!{
	key[]: "aca_msg_book3_finex_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_finex_forward"
	val[]: "Fahre fort, wenn du bereit bist."

#!{
	key[]: "aca_msg_book3_finex_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_finex_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


