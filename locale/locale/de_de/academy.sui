#!}
	key[]: "aca_msg_book3_straight_backing_forward"
	val[]: "Beginne langsam rückwärts zu fahren."

#!{
	key[]: "aca_msg_book3_straight_backing_check1"
	val[]: "@@aca_msg_book3_sup_check1@@"
#!}
	key[]: "aca_msg_book3_straight_backing_stop"
	val[]: "Richte dich aus und halte in dem dafür vorgesehenen Bereich an."

	key[]: "aca_msg_book3_straight_backing_end"
	val[]: "Sichere das Fahrzeug und stelle den Motor ab."

#@}


#+ Correcting Straight Backing
#@{

#### correcting_straight_backing common

	key[]: "aca_scenario_book3_correcting_straight_backing_title"
	val[]: "Gerade Zurücksetzen Korrektur"

	key[]: "aca_scenario_book3_correcting_straight_backing_desc"
	val[]: "In diesem Szenario übernimmst du das Steuer, nachdem jemand anderes bereits versucht hat, gerade rückwärts zu fahren. Korrigiere den Fehler und parke den Lkw an der vorgesehenen Stelle."

#### correcting_straight_backing goal

#!{
	key[]: "aca_goal_book3_correcting_straight_backing_start"
	val[]: "@@aca_goal_book3_sup_start@@"
#!}
	key[]: "aca_goal_book3_correcting_straight_backing_forward"
	val[]: "Aufrichten"

	key[]: "aca_goal_book3_correcting_straight_backing_check1"
	val[]: "Rückwärtsfahren"

#!{
	key[]: "aca_goal_book3_correcting_straight_backing_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_correcting_straight_backing_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### correcting_straight_backing - intro text

	key[]: "aca_msg_book3_correcting_straight_cutscene01"
	val[]: "Jemand hat versucht, mit diesem Fahrzeug rückwärts in die Parklücke zu fahren, und dabei ein kleines Problem gehabt. Jetzt liegt es an dir, das zu beheben!"

	key[]: "aca_msg_book3_correcting_straight_cutscene02"
	val[]: "Der erste Schritt besteht darin, vorwärts zu fahren und alles so auszurichten, dass wir damit arbeiten können. Es ist entscheidend, dass der hintere Anhänger in die Richtung zeigt, in die du fahren möchtest."

	key[]: "aca_msg_book3_correcting_straight_cutscene03"
	val[]: "In diesem Fall haben wir uns dafür entschieden, eher auf der Fahrerseite zu bleiben. So haben wir beim Rückwärtsfahren eine bessere Sicht auf das, was wir tun, und können von einer Seite aus arbeiten. <br><br>Denken daran, dass du den hinteren Anhänger mit der Deichsel lenkst, also konzentriere dich nicht so sehr auf den Traktor."

	key[]: "aca_msg_book3_correcting_straight_cutscene04"
	val[]: "Die Kombination ist mehr oder weniger dort, wo wir sie brauchen, aber lassen dich noch einmal nach vorne ziehen, um sie richtig zu zentrieren."

	key[]: "aca_msg_book3_correcting_straight_cutscene05"
	val[]: "Von hier aus werden wir sehr vorsichtig rückwärts einparken und dabei darauf achten, dass der hintere Anhänger perfekt in der Spur bleibt."

	key[]: "aca_msg_book3_correcting_straight_cutscene06"
	val[]: "Jetzt können wir den Anhänger und den Traktor selbst aneinanderreihen."

#### correcting_Straight_Backing Driving Instructions

#!{
	key[]: "aca_msg_book3_correcting_straight_backing_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_correcting_straight_backing_forward"
	val[]: "Fahre vorwärts und richte alles aus. <br><br>Wenn du zufrieden bist, fahre rückwärts in den ausgewiesenen Bereich."

	key[]: "aca_msg_book3_correcting_straight_backing_check1"
	val[]: "Fahre rückwärts in den ausgewiesenen Bereich."

#!{
	key[]: "aca_msg_book3_correcting_straight_backing_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"
#!}
	key[]: "aca_msg_book3_correcting_straight_backing_end"
	val[]: "Sichere das Fahrzeug und stelle den Motor ab."

#@}


#+ Book 3 Scenario backing_90_tight
#@{

#### backing_90_tight common
	key[]: "aca_scenario_book3_backing_90_tight_title"
	val[]: "90-Grad-Rückwärtsmanöver"

	key[]: "aca_scenario_book3_backing_90_tight_desc"
	val[]: "In diesem Szenario verwendest du ein 90-Grad-Rückwärtsmanöver, um in einer Reihe anderer Lkw zu parken."

#### backing_90_tight goal

	key[]: "aca_goal_book3_backing_90_tight_check1"
	val[]: "Umdrehen"

	key[]: "aca_goal_book3_backing_90_tight_check2"
	val[]: "Einrichten"

		key[]: "aca_goal_book3_backing_90_tight_check3"
	val[]: "Rückwärtsfahren"

#!{
		key[]: "aca_goal_book3_backing_90_tight_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_backing_90_tight_end"
	val[]: "@@aca_goal_book3_sup_end@@"

	key[]: "aca_goal_book3_backing_90_tight_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_backing_90_tight_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
#### backing_90_tight msg - intro text

	key[]: "aca_msg_book3_backing_90_tight_cutscene1"
	val[]: "Das Rückwärtsfahren zur Seite ist mit B-Doubles einfacher, da du durch das Seitenfenster einen besseren Überblick über alles hast, was um dich herum passiert."

	key[]: "aca_msg_book3_backing_90_tight_cutscene2"
	val[]: "Fahre zunächst vorwärts und mache am Ende der Reihe eine Kehrtwende. So kannst du dich auf der Sichtseite einrichten und hast aus dem Fahrerfenster eine bessere Sicht."

	key[]: "aca_msg_book3_backing_90_tight_cutscene3"
	val[]: "Sie kannst die Anhänger nach Belieben aufstellen, beispielsweise mit dem hinteren Anhänger bereits in Richtung der Stelle ausgerichtet. In diesem Fall beginnen wir aus einer geraden Position. <br><br>Denke daran, es einfach zu halten – lenke den hinteren Anhänger mit der Leine."

	key[]: "aca_msg_book3_backing_90_tight_cutscene4"
	val[]: "Lenke den vorderen Anhänger leicht vom Parkplatz weg, und der hintere Anhänger wird in Richtung Parkplatz ausgerichtet. Passen dann den Winkel zwischen dem vorderem und hinteren Anhänger an, um eine schöne, gleichmäßige Kurve in den Parkplatz hineinzufahren."

	key[]: "aca_msg_book3_backing_90_tight_cutscene5"
	val[]: "Denken daran, wenn der hintere Anhänger zu eng kommt, müssen Sie den Winkel der Kombination etwas begradigen. Wenn er zu weit kommt, müssen Sie den Winkel schärfer machen."

	key[]: "aca_msg_book3_backing_90_tight_cutscene6"
	val[]: "Die Einstellungen, die du am Traktor vornimmst, wirken sich nur halb so stark auf den hinteren Anhänger aus wie auf den vorderen. Du kannst also ruhig kräftig am Traktor drehen."

	key[]: "aca_msg_book3_backing_90_tight_cutscene7"
	val[]: "An dieser Stelle musst du mit der Vorausplanung beginnen. Du musst auch den vorderen Anhänger an die richtige Stelle bringen, also beginne mit der Planung, ihn direkt vor den hinteren zu stellen."

	key[]: "aca_msg_book3_backing_90_tight_cutscene8"
	val[]: "Es kommt sehr selten vor, dass man die Anhänger beim ersten Versuch richtig ausrichtet. In diesem Fall haben wir zu lange gewartet, um die Deichsel gerade auszurichten, und jetzt driftet das Heck vom Weg ab. <br><br>Kein Problem, fahre vorwärts und versuche es erneut."

	key[]: "aca_msg_book3_backing_90_tight_cutscene9"
	val[]: "Bediene das Lenkrad richtig und bringen die Anhänger dorthin, wo du sie haben willst. Du kannst so oft vorwärtsfahren."

	key[]: "aca_msg_book3_backing_90_tight_cutscene10"
	val[]: "Und einfach so haben wir erfolgreich B-Doubles geparkt."

#### backing_90_tight Driving Instructions

#!{
	key[]: "aca_msg_book3_backing_90_tight_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_backing_90_tight_forward"
	val[]: "Fahre bis zum Ende des Parkplatzes und wende."

	key[]: "aca_msg_book3_backing_90_tight_check1"
	val[]: "Denke daran, eine weite Kurve zu fahren."

	key[]: "aca_msg_book3_backing_90_tight_check2"
	val[]: "Fahre weiter vorwärts, bis du das Gefühl hast, ausreichend Platz zum Manövrieren zu haben, und beginne dann mit dem Rückwärtsfahren."

	key[]: "aca_msg_book3_backing_90_tight_check3"
	val[]: "Fahre rückwärts in die Parklücke."

#!{
	key[]: "aca_msg_book3_backing_90_tight_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_backing_90_tight_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


