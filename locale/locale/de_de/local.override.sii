#+ Text deviations for American Truck Simulator. Please, use only terms appropriate for USA (i.e. culture specific nuances, not American English).
#@{

#+ Music/radio player
#@{

#+ Hint shown if no music files are found. Also shown as tooltip when hovering over music_player button.

	key[]: "music_player_hint"
	val[]: "Platziere deine Musikstücke im <color value=@@clr_sel@@>American Truck Simulator/music <color value=@@clr_txt@@>-Ordner in deinen <color value=@@clr_sel@@>Dokumenten <color value=@@clr_txt@@>und du wirst sie hier sehen können."

#+ Tooltip shown when hovering over the radio_stream button.

	key[]: "radio_hint"
	val[]: "Bearbeite die Datei <color value=@@clr_sel@@>live_streams.sii <color value=@@clr_txt@@>im <color value=@@clr_sel@@><br>American Truck Simulator<color value=@@clr_txt@@>-Ordner deiner <color value=@@clr_sel@@>Dokumente <color value=@@clr_txt@@>und<br>höre deine Lieblings-Internetradiosender im Spiel!"

#+ Hint shown if no online radio streams are defined.

	key[]: "empty_radio_hint"
	val[]: "Bitte schau in der <color value=@@clr_sel@@>readme.rtf <color value=@@clr_txt@@>im <color value=@@clr_sel@@>American Truck Simulator <color value=@@clr_txt@@>Ordner in deinen <color value=@@clr_sel@@>Dokumenten <color value=@@clr_txt@@>nach, um zu sehen, wie man eigene Musik und Radiostreams hinzufügt."
#@}

