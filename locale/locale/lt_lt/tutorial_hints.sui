
    key[]: "hint_engine_title"
	val[]: "Išjunk variklį"

    key[]: "hint_engine_text"
	val[]: "Užvesti variklį gali su $KEY_engine$."


    key[]: "hint_ignition_title"
	val[]: "Įjunk degimą"

    key[]: "hint_ignition_text"
	val[]: "Įjungti degimą gali su $KEY_engineelect|KEY_engine$."


    key[]: "hint_driv_arc_title"
	val[]: "Važiavimas"

    key[]: "hint_driv_arc_text"
	val[]: "Spausk $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ ir $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ važiuoti pirmyn ar atgal.<br><offset vshift=8>Naudok $SPECIAL_steering$ vairuoti."


    key[]: "hint_driv_auto_title"
	val[]: "Važiavimas"

    key[]: "hint_driv_auto_text"
	val[]: "Spausk $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ ir $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ važiuoti pirmyn ar atgal.<br><offset vshift=8>Naudok $SPECIAL_steering$ vairuoti.<br><offset vshift=8>Spausk $KEY_gearup$ ir $KEY_geardown$ perjungti pavaras."


    key[]: "hint_driv_seq_title"
	val[]: "Važiavimas"

    key[]: "hint_driv_seq_text"
	val[]: "Spausk $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ ir $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ važiuoti pirmyn ar atgal.<br><offset vshift=8>Naudok $SPECIAL_steering$ vairuoti.<br><offset vshift=8>Spausk $KEY_gearup$ ir $KEY_geardown$ valdyti sankabą."


    key[]: "hint_driv_hshift_title"
	val[]: "Važiavimas"

    key[]: "hint_driv_hshift_text"
	val[]: "Spausk $KEY_aforward+ALIAS_j_throttle+KEY_dforward$ ir $KEY_abackward+ALIAS_j_brake+KEY_dbackward$ važiuoti pirmyn ar atgal.<br><offset vshift=8>Naudok $SPECIAL_steering$ vairuoti.<br><offset vshift=8>Pavaras keisk <color value=@@clr_sel@@>pavarų svirtimi<color value=@@clr_txt@@>."


    key[]: "hint_depot_deliv_title"
    val[]: "Artėk prie tikslo"

    key[]: "hint_depot_deliv_text"
    val[]: "Sustok pažymėtoje vietoje ir pasirink parkavimo sudėtingumą bei uždirbk atitinkamos patirties."


    key[]: "hint_fin_deliv_title"
    val[]: "Užbaik pristatymą"

    key[]: "hint_fin_deliv_text"
    val[]: "Sustok pasirinktoje parkavmo vietoje. Gali spausti $KEY_activate$ kad praleistum parkavimą, kai būsi netoli pristatymo vietos."


    key[]: "hint_fin_deliv2_title"
    val[]: "Užbaik pristatymą"

    key[]: "hint_fin_deliv2_text"
    val[]: "Sustok pasirinktoje parkavimo vietoje. Gali jungti programėlę iš @@desktop_menu_category_options@@, kur galėsi pasirinkti parkavimo praleidimą."


    key[]: "hint_lights_title"
    val[]: "Įjunk šviesas"

    key[]: "hint_lights_text"
    val[]: "Spausk $KEY_light$ įjungti šviesas. Spaudžiant dar kartą persijungs šviesų režimai."


    key[]: "hint_high_beam_title"
    val[]: "Įjunk tolimas šviesas"

    key[]: "hint_high_beam_text"
    val[]: "Spausk $KEY_hblight$ įjungti tolimas šviesas."


    key[]: "hint_wipers_title"
    val[]: "Įjunk valytuvus"

    key[]: "hint_wipers_text"
    val[]: "Spausk $KEY_wipers$ įjungti valytuvus ir keisti jų greičio režimus."


    key[]: "hint_zoom_title"
    val[]: "Žiūrėjimas iš arčiau"

    key[]: "hint_zoom_text"
    val[]: "Spausk $KEY_camzoom$ priartinti vaizdą, žiūrint iš vidaus. Meniu @@desktop_menu_category_options@@ gali pasirinkti priartinimo režimą laikant ar perjungiant."


    key[]: "hint_cam_int_title"
    val[]: "Dairymasis"

    key[]: "hint_cam_int_text"
    val[]: "Spausk $KEY_cam1$ įjungti kamerą iš vidaus."


    key[]: "hint_cam_ext_title"
    val[]: "Dairymasis"

    key[]: "hint_cam_ext_text"
    val[]: "Gali jungtinėti įvairias kameras spaudžiant $KEY_camcycle$.<br><offset vshift=8>Spausk $KEY_cam2$ įjungti išorės vaizdą."


    key[]: "hint_indicators_title"
    val[]: "Posūkių signalai"

    key[]: "hint_indicators_text"
    val[]: "Spausk $KEY_lblinker$ ir $KEY_rblinker$ įjungti posūkių signalus."


    key[]: "hint_tow_title"
    val[]: "Nutempimo paslauga"

    key[]: "hint_tow_text"
    val[]: "Jei patekai į sudėtingą situaciją, gali užsisakyti nutempimo paslaugą. Tam atidaryk @@quick_info_word@@ meniu spaudžiant $KEY_advmouse$."


    key[]: "hint_diff_lock_title"
    val[]: "Diferencialo užrakinimas"

    key[]: "hint_diff_lock_text"
    val[]: "Jei negali pajudėti iš vietos, gal padės diferencialo užrakinimas. Spausk $KEY_diflock$ jį įjungti arba įjunk automatinį diferencialą meniu @@desktop_menu_category_options@@."


    key[]: "hint_diff_unlock_title"
    val[]: "Diferencialo užraktas įjungtas"

    key[]: "hint_diff_unlock_text"
    val[]: "Turėtum atjungti diferencialo užrakinimą važiuojant normaliai, nes rizikuoji padaryti žalą. Spausk $KEY_diflock$ išjungti užraktą, arba įjunk automatinį diferencialo užraktą meniu @@desktop_menu_category_options@@."


    key[]: "hint_wipers_off_title"
    val[]: "Išjunk valytuvus"

    key[]: "hint_wipers_off_text"
    val[]: "Spausk $KEY_wipers$ išjungti valytuvus ir keisti jų greičio režimus."


    key[]: "hint_world_map_title"
    val[]: "Žemėlapis"

    key[]: "hint_world_map_text"
    val[]: "Spausk $KEY_navmap$ atidaryti žemėlapį."


    key[]: "hint_pause_title"
    val[]: "@@quick_info_word@@"

    key[]: "hint_pause_text"
    val[]: "Spausk $KEY_advmouse$ atidaryti @@quick_info_word@@ - trumpa peržiūra su patogiomis santrumpomis."


    key[]: "hint_pause_border_title"
    val[]: "Vietiniai reikalavimai"

    key[]: "hint_pause_border_text"
    val[]: "Spausk $KEY_advmouse$ atidaryti @@quick_info_word@@ ir pamatyti dabartinio regiono taisykles."


    key[]: "hint_photo_trophy_title"
    val[]: "@@landmark_word@@"

    key[]: "hint_photo_trophy_text"
    val[]: "Atidaryk @@quick_info_word@@ su $KEY_advmouse$ įjungti @@photo_mode_word@@ ir užfiksuoti greta esantį @@landmark_word@@ <img src=/material/ui/map/photo_sight_not_captured.mat width=20 height=20>."


    key[]: "hint_viewpoint_title"
    val[]: "@@viewpoint_title@@ netoliese"

    key[]: "hint_viewpoint_text"
    val[]: "@@viewpoint_title@@ <img src=/material/ui/map/viewpoint_unseen.mat width=20 height=20> netoliese - rask ir aktyvuok filmuką."


    key[]: "hint_resting_title"
    val[]: "Netoliese poilsio aikštelė"

    key[]: "hint_resting_text"
    val[]: "Poilsio aikštelės <img src=/material/ui/map/parking_ico.mat width=20 height=20> padės pailsėti, atlikti privalomą pertrauką ir saugiai tęsti kelionę."


    key[]: "hint_gas_title"
    val[]: "Degalinė netoliese"

    key[]: "hint_gas_text"
    val[]: "Degalinėse <img src=/material/ui/map/gas_ico.mat width=20 height=20> gali papildyti savo transporto priemonę kuru."


    key[]: "hint_car_job_title"
    val[]: "Pirmas kurjerio darbas"

    key[]: "hint_car_job_text"
    val[]: "Užbaik pristatymą - vairuok saugiai, prižiūrėk krovinį ir atvažiuok numatytu laiku. Atmink kliento prioritetą, kuris įtakos tavo įvertinimą ir atlygį.<br><offset vshift=8>Spausk $KEY_advmouse$ kad pamatytum užduoties detales."


    key[]: "hint_tour_board_title"
    val[]: "Stendas turistams"

    key[]: "hint_tour_board_text"
    val[]: "Netoliese yra stendas turistams. Aktyvuok jį atrakindamas jo turinį <color value=@@clr_sel@@>@@tourist_atlas_link@@</color> ir tyrinėk vietines įdomias ir gražias vietas."


    key[]: "hint_tb_first_title"
    val[]: "Aplankyta pirma lokacija"

    key[]: "hint_tb_first_text"
    val[]: "Aplankei pirmą lokaciją iš šio Stendo turistams. Gali pažiūrėti informaciąj apie ją <color value=@@clr_sel@@>@@tourist_atlas_link@@</color>. Ištirk visas lokacijas, kad gautum premiją."


    key[]: "hint_tb_bef_compl_title"
    val[]: "Liko viena lokacija"

    key[]: "hint_tb_bef_compl_text"
    val[]: "Liko tik viena lokacija, kad pilnai ištirtum pirmą vietinį Stendą turistams ir užsidirbtum atviruką."


    key[]: "hint_tb_done_title"
    val[]: "Stendas turismas ištirtas"

    key[]: "hint_tb_done_text"
    val[]: "Pilnai ištyrei visas lokacijas vietiniame Stende turistams. Gali peržiūrėti informaciją <color value=@@clr_sel@@>@@tourist_atlas_link@@</color>. O dabar gali savo transporte pasidėti atviruką."


    key[]: "hint_vehicle_prio_title"
    val[]: "Kliento prioritetas - transporto būklė"

    key[]: "hint_vehicle_prio_text"
    val[]: "Klientui svarbiausia transporto būklė - tavo premija ar bauda smarkiai priklausys nuo būsenos transporto, kuriuo atvažiuosi. Vairuok saugiai ir tausok savo transportą.<br><offset vshift=8>Spausk $KEY_advmouse$ kad pamatytum užduoties detales."


    key[]: "hint_cargo_prio_title"
    val[]: "Kliento prioritetas - elgesys su kroviniu"

    key[]: "hint_cargo_prio_text"
    val[]: "Klientui svarbiausia elgesys su kroviniu - tavo premija ar bauda smarkiai priklausys nuo pristatyto krovinio būklės. Vairuok saugiai ir tausok krovinį.<br><offset vshift=8>Spausk $KEY_advmouse$ kad pamatytum užduoties detales."


    key[]: "hint_time_prio_title"
    val[]: "Kliento prioritetas - laiko valdymas"

    key[]: "hint_time_prio_text"
    val[]: "Klientui svarbiausia laiko valdymas - tavo premija ar bauda smarkiai priklausys nuo tavo sugebėjimo būti punktualiu. Vairuok saugiai ir atvyk tada, kada tikisi klientas.<br><offset vshift=8>Spausk $KEY_advmouse$ kad pamatytum užduoties detales."


    key[]: "hint_car_deliv_title"
    val[]: "Privažiuok prie tikslo"

    key[]: "hint_car_deliv_text"
    val[]: "Sustok pažymėtoje zonoje, kad užbaigtum pristatymą."


    key[]: "hint_car_early_title"
	val[]: "Ankstyvas atvykimas"

    key[]: "hint_car_early_text"
    val[]: "Pristatymo laukiama konkrečiu laiku, ir atvykus per anksti klientas bus nepatenkintas. Planuok savo kelionę ir jei reikia pasinaudok poilsio vietomis."


#!{
    key[]: "hint_sm_throttle_title"
	val[]: "@@throttle_double_tap@@"
#!}

    key[]: "hint_sm_throttle_text"
    val[]: "Gali įjungti protingą akseleratoriaus valdymą čia: @@desktop_menu_category_options@@. Jį įjungus paprastai bus spaudžiama mažiau akseleratoriaus. Jei greitai paspausi akseleratoriaus klavišą du kartus, akseleratorius bus paspaustas iki galo kol laikysi nuspaustą klavišą."
