#+ Washington TBs and POIs localization.
#@{
	key[]: "tb_wa1"
	val[]: "Olimpinis pusiasalis"

	key[]: "tb_wa1_desc"
	val[]: "Olimpinis pusiasalis yra vieta, kur vandenynas, miškas ir kalnai kartu kuria nuolat besikeičiantį grožį. Rūkas uždengia akmeningus krantus, kriokliai krenta nuo aukštumų, slėniai slepia mažus istorinius miestelius."

	key[]: "poi_wa1_01"
	val[]: "Istorinis JAV Pašto skyrius"

	key[]: "poi_wa1_01_desc"
	val[]: "Užbaigtas 1893 ant stataus kranto prie Port Taunsendo šis pastatas buvo sukrutas kap federalinė įstaiga, atspindinti miesto ankstyvąsias ambicijas tapti tarptautinės prekybos centru."

	key[]: "poi_wa1_02"
	val[]: "Port Angeles"

	key[]: "poi_wa1_02_desc"
	val[]: "Port Angeles yra pakrantės miestas, 19-ame amžiuje įkurtas kaip uostas ir atsargų papildymo vieta. Šiandien jis yra vartai į Olimpinį Nacionalinį parką ir kelto uostas, jungiantis JAV ir Kanadą."

	key[]: "poi_wa1_03"
	val[]: "Pusmėnulio ežeras"

	key[]: "poi_wa1_03_desc"
	val[]: "Pusmėnulio ežeras, antras pagal gylį Vašingtono valstijoje, garsėja savo ryškia mėlynu tyru vandeniu dėl žemo azoto lygio. Populiarioje poilsioje zonoje esantis ežeras supamas pasivaikščiojimo takų ir seno miško."
	
	key[]: "poi_wa1_04"
	val[]: "Kalalocho paplūdimys"

	key[]: "poi_wa1_04_desc"
	val[]: "Kalalocho paplūdimys garsėja \"Gyvybės medžiu\", Sitkos egle su atidengtomis šaknimis prie nedidelio upelio. Kitaip nei paprastai aukštos eglės, ši yra žema ir stora, unikali ir populiari vietinė įžymybė."

	key[]: "poi_wa1_05"
	val[]: "Olimpinis nacionalinis parkas"

	key[]: "poi_wa1_05_desc"
	val[]: "Olimpinis nacionalinis parkas saugo įvairias ekosistemas, nuo Ramiojo vandenyno pakrantės iki miškų ir kalnų. 1909 jis buvo paskirtas Nacionaliniu monumentu, o 1938 pervadintas į Nacionalinį parką."

	key[]: "poi_wa1_06"
	val[]: "Greenhead Slough"

	key[]: "poi_wa1_06_desc"
	val[]: "Greenhead Slough yra nedidelės įlankos ir pelkės prie 101 greiteklio, greta Vilapa įlankos. Jis yra pakrantės apsaugos zonoje, kuri buvo atkurta palaikant lašišų nerštą ir gausybę vandens paukščių."

	key[]: "poi_wa1_07"
	val[]: "Dabobo įlanka"

	key[]: "poi_wa1_07_desc"
	val[]: "Dabobo įlanka yra gilus fjordas, kuriame yra daug lašišų, vėžiagyvių ir kitų laukinių gyvūnų. Dabobo įlankos gamtos zona, įkurta 1984 metais, saugo retas druskos pelkes ir smėlio augalų bendruomenes."


##########################################################################################

	key[]: "tb_wa2"
	val[]: "Centras"

	key[]: "tb_wa2_desc"
	val[]: "Vašingtono centrinė dalis kviečia keliautojus keliauti vaizdingais keliais pro visžalius miškus ir ramius kalnų ežerus. Reinyro kalnas dominuoja horizonte."

	key[]: "poi_wa2_01"
	val[]: "Reinyro kalnas"

	key[]: "poi_wa2_01_desc"
	val[]: "Reinyro kalnas, aukščiausias Vašingtone (4392 m), yra aktyvus stratovulkanas. Jo ledynas maitina upes, formuoja slėnius ir palaiko turtingus miškus."

	key[]: "poi_wa2_02"
	val[]: "Venačio nacionalinis miškas"

	key[]: "poi_wa2_02_desc"
	val[]: "Venačio nacionalinis miškas apima kalnus, upes ir kalnų slėnius. 1933 metais Civilinis išsaugojimo korpusas pastatė čia takelius ir gaisrų stebėjimo postus."

	key[]: "poi_wa2_03"
	val[]: "Beikerio - Snokalmio kalno nacionalinis miškas"

	key[]: "poi_wa2_03_desc"
	val[]: "Beikerio - Snokalmio kalno nacionalinis miške yra viena seniausių ledyno stebėjimo postų Amerikoje, sekanti vulkaninio ledo tekėjimą ir klimato pokyčius nuo 20 amžiaus pradžios."
	
	key[]: "poi_wa2_04"
	val[]: "Venačio upė"

	key[]: "poi_wa2_04_desc"
	val[]: "Prie Venačio upės likę 19-o amžiaus pradžios melioracijos kanalai ir malūnai rodo, kaip gyventojai išnaudojo jos vandenis. Vietinės gentys taip pat kliovėsi lašiša turtingu vandeniu gaudami maistą ir prekiaudami iki europiečių apsigyvenimo."

	key[]: "poi_wa2_05"
	val[]: "Klavačio viršūnė"

	key[]: "poi_wa2_05_desc"
	val[]: "Pirmą kartą įveikta 20-ojo amžiaus viduryje Klavačio viršūnė iki šiol retai užlipama dėl stačių ledinių šlaitų."

	key[]: "poi_wa2_06"
	val[]: "Sausųjų krioklių užtvanka"

	key[]: "poi_wa2_06_desc"
	val[]: "Pastatyta valdyti vietinius vandens kelius Sausųjų krioklų užtvanka stovi ant prieistorinių bazalto uolų ir valdo sezoninį vandens tekėjimą."

	key[]: "poi_wa2_07"
	val[]: "Baltos ugnies kalno aikštelė"

	key[]: "poi_wa2_07_desc"
	val[]: "Šioje aikštelėje yra stendas apie 1988 Baltojo kalno gaisrą, vieną didžiausių Vašingtono gamtos gaisrų."

	key[]: "wa_cut_helen_desc"
	val[]: "Iki 1980 metų Šventos Helenos kalnas buvo kūgio formos ir buvo vadinamas amerikietiškus Fudzi kalnu. 1980 metų išsiveržimas nutrynė 400 m jo viršūnės ir suformavo pasagos formos kraterį, dabar užlietą lavos ir ledyno."


##########################################################################################


	key[]: "tb_wa3"
	val[]: "Vyno kraštas"

	key[]: "tb_wa3_desc"
	val[]: "Į rytus nuo Kaskadinių kalnų Kolumbijos slėnyje driekiasi Vašingtono vyno kraštas. Jis apima Sela upelį, Liuiso ir Klarko valstijos parką ir žemes, kuriose istoriškai gyvena vietinės tautos."

	key[]: "poi_wa3_01"
	val[]: "Švaraus upelio kriokliai"

	key[]: "poi_wa3_01_desc"
	val[]: "Švaraus upelio krioklių aikštelė yra populiari vieta į rytus nuo Baltos perėjos viršūnės. Maždaug už pusantro kilometro į rytus yra posūkis į Tyro ežero poilsio vietą, garsėjančią žvejyba ir laukinės gamtos stebėjimu."

	key[]: "poi_wa3_02"
	val[]: "Sela upelio tiltas"

	key[]: "poi_wa3_02_desc"
	val[]: "Fredo G. Redmono tiltas arba Sela upelio tiltas yra dvigubos arkos struktūra Jakima apygardoje. Pastatymo metu jis buvo ilgiausias betoninis arkinis tiltas Amerikoje ir aukščiausias automobilių tiltas valstijoje."

	key[]: "poi_wa3_03"
	val[]: "Vynuogių laukai"
	
	key[]: "poi_wa3_03_desc"
	val[]: "Vašingtono slėniai ir derlinga žemė maitina daug vynuogynų, įskaitant Rislingą, Kaberne ir Merlo. Vynuogynai yra svarbi valstijos žemdirbystės ir peizažo dalis."

	key[]: "poi_wa3_04"
	val[]: "Edo Hendlerio tiltas"

	key[]: "poi_wa3_04_desc"
	val[]: "Pastatytas 1978 metais tiltas, kartais vadinamas Tarpmiesčio tiltu, kerta Kolumbijos upę tarp Pasko ir Keneviko pietryčių Vašingtone. Nuo atidarymo jis laikomas Trimiesčio simboliu."

	key[]: "poi_wa3_05"
	val[]: "Liuiso ir Klarko valstijos parkas"

	key[]: "poi_wa3_05_desc"
	val[]: "Vienas pirmųjų Vašingtono valstijos parkų šis parkas saugo senovinius miškus prie istorinio vietinių gyventojų kelio. Pavadintas Atradėjų korpuso garbei šis miškas primena tankius maiškus, kuriuso savo dienoraščiuose aprašė Meriveteris Liuisas."

	key[]: "poi_wa3_06"
	val[]: "Kolumbijos apygardos teismo rūmai"

	key[]: "poi_wa3_06_desc"
	val[]: "Kolumbijos apygardos teismo rūmai atpspindi laiką, kai apygardos vyriausybė buvo svarbiausia kasdieniame gyvenime. Greito augimo ir riboto kontakto su valstijos sostine metu teismo rūmai buvo pagrindinė valdžios vieta ir tvarkėsi su skubiausiais piliečių poreikiais."

	key[]: "poi_wa3_07"
	val[]: "Vietinės amerikiečių gentys"

	key[]: "poi_wa3_07_desc"
	val[]: "Kolumbijos slėnis ir aplinkinės vietos yra namai vietinėms gentims, pvz. Jakama, Vala Vala ir Umatila. Šiandien šios bendruomenės toliau gyvena regione, palaiko kultūrines tradicijas, valdo žemės ir vandens išteklius."

##########################################################################################

#@}




#+ Oregon TBs and POIs localization.
#@{
	key[]: "tb_or1"
	val[]: "Ramiojo vandenyno pakrantė"

	key[]: "tb_or1_desc"
	val[]: "Oregono Ramiojo vandenyno pakrantėje yra ir neprieinamų vietų, ir gražių poilsio aikštelių. Heketos švyturys stebi lūžtančias bangas, o Silver Pointas, Ofiro pakelė, Seserų akmenys ir Bučinio akmuo kyla kartu su bazalto uolomis."

	key[]: "landmark_or_astoria_b_desc"
	val[]: "Keturių mylių ilgo tiltas per Kolumbijos upę jungia Oregoną ir Vašingtoną."

	key[]: "poi_or1_01"
	val[]: "Silver Pointo aikštelė"

	key[]: "poi_or1_01_desc"
	val[]: "Šiek tiek į pietus nuo Kanono paplūdimio esanti aikštelė atskleidžia Kupetos akmenį ir grubią pakrantę."

	key[]: "or_cut_lighthouse_desc"
	val[]: "Aukščiausias Oregono švyturys, pastatytas 1873 metais, stovi ant bazalto liežuvio netoli Niuporto."

	key[]: "or_cut_newport_desc"
	val[]: "Jakinos įlankos tiltas, pastatytas 1936 metais, yra vienas garsiausių Oregono pakrantės objektų. Jį sukūrė garsus inžinierius Conde McCulloug. Jis kerta Jakinos įlanką ir yra viena žymiausių vietų 101 kelyje."

	key[]: "or_cut_thor_desc"
	val[]: "Natūrali smegduobė Perpetua iškyšulyje, į kurią krentą lūžtančios bangos ir sudaro iliuziją, kad vandenynas išteka."

	key[]: "poi_or1_02"
	val[]: "Ofyro pakelė"

	key[]: "poi_or1_02_desc"
	val[]: "Tyli aikštelė netoli Auksinio paplūdimio, kur keliautojai gali ištiesti kojas, stebėti bangas ir ieškoti smėlyje agatų."

	key[]: "poi_or1_03"
	val[]: "Seserų akmens aikštelė"

	key[]: "poi_or1_03_desc"
	val[]: "Dramatiški akmenys jūroje kyla iš bangų, o takeliai veda link mažų paplūdimių, besislepiančių tarp uolų."

	key[]: "poi_or1_04"
	val[]: "Bučinio akmuo"

	key[]: "poi_or1_04_desc"
	val[]: "Pakelės stotelė į pietus nuo Auksinio paplūdimio, kur du didžiulai akmenys remiasi viennas į kitą virš smėlio."


##########################################################################################

	key[]: "tb_or2"
	val[]: "Laukiniai rytai"

	key[]: "tb_or2_desc"
	val[]: "Šis regionas, dažnai vadinamas Oregono laukiniais rytais, atskleidžia peizažą, kurį geologinės jėgos formavo šimtus milijonų metų. Lyginant su šiuo laiku žmonijos istorija labai trumpa."

	key[]: "landmark_or_deadman_p_desc"
	val[]: "Ši aikštelė netoli Pendltono atskleidžia Negyvėlio perėją, pavadintą dėl 1870-ųjų incidento Banoko karo metu, kai čia buvo rastas negyvas vežimo važnyčiotojas. Daug dešimtmečių anksčiau begalė vežimų kirto šiuos kalnus Oregono Kelyje."

	key[]: "or_cut_395_desc"
	val[]: "Kadaise žinomas kaip Trijų vėliavų greitkelis JAV 395 kelias driekiasi nuo Kanados iki Meksikos ir sujungia dykumas, miškus ir kalnus. Šiandien jis baigiasi ties JAV 15 keliu Kalifornijoje, nors senojo kelio dalių yra likę prie San Diego."

	key[]: "poi_or2_01"
	val[]: "Malūro nacionalinis miškas"

	key[]: "poi_or2_01_desc"
	val[]: "Malūro nacionalinis parkas yra Mėlynuosiuose kalnuose. Daugiau nei prieš 150 milijonų metų dalis šių seniausių akmenų buvo vulkaninės salos Ramiajame vandenyne, vėliau susijungusios su žemynu."
	
	key[]: "poi_or2_02"
	val[]: "Laukiniai Bedlendai"

	key[]: "poi_or2_02_desc"
	val[]: "Laukiniai Bedlendai, į rytus nuo Bendo, yra grubus vulkaninis peizažas, suformuotas senovinių lavos srautų ir iškritusių pelenų. Vingiuoti lavos kanalai, smėlėta žemė ir grubi žemė yra viena unikaliausių dykumų aplinkų."

	key[]: "poi_or2_03"
	val[]: "Aberto ežeras"

	key[]: "poi_or2_03_desc"
	val[]: "Įtrauktas į žemėlapius 1843 metais Aberto ežeras palaikė žmonių populiaciją daugiau nei 10.000 metų. Per sūrus žuvims jis lieka svarbi vieta paukščiams, keliaujantiems Ramiojo vandenyno skrydžio keliu, ir traukiasi pastaraisiais dešimtmečiais dėl klimato pokyčio."

	key[]: "poi_or2_04"
	val[]: "Rytų Styno turo kelias"

	key[]: "poi_or2_04_desc"
	val[]: "Rytų Styno turo kelias seka 78 greitkeliu Styno kalnais ir Albordo dykuma. Jo pažiba - Alvordo dykumos išdžiuvęs ežeras, vienas didžiausių Oregone, kuris tam tikru metų laiku iš didžiulės dykumos virsta sekliu ežeru."

	key[]: "poi_or2_05"
	val[]: "Doherčio nuošliauža"

	key[]: "poi_or2_05_desc"
	val[]: "Mažiau nei valandą važiuojama greta Doherčio nuošliaužos, vulkaninės kilmės akmenų darinio, tačiau gamta forrmavo ją 16 milijonų metų."


##########################################################################################

	key[]: "tb_or3"
	val[]: "Ogdeno valstija"

	key[]: "tb_or3_desc"
	val[]: "Šis kelias seka Oregono šiaurės-pietų koridorių ir kerta miškus ir dykumas. Pirma ištyrinėtas kailių pirklio Peterio Skeno Ogdeno 1820-ais Antrojo pasaulinio karo metu jis tapo strategiškai svarbiu dėl medienos ir transporto."
	
	key[]: "poi_or3_01"
	val[]: "Springfildo liepsna"

	key[]: "poi_or3_01_desc"
	val[]: "Beveik 20 metrų aukščio skulptūra žymi Springfildo šiaurinę dalį, o liepsna yra lyg švyturys keliautojams."

	key[]: "poi_or3_02"
	val[]: "Santiamo vežimų kelias"

	key[]: "poi_or3_02_desc"
	val[]: "Perėja į rytus, kadaise vadinta Vailio perėja dėl Endriu Vailio, buvo ištyrinėta 1859 metais pionierių, ieškančių ganyklų. 1864 metais buvo suplanuotas karinis kelias, bet liko iš esmės nepastatytas. Mokamas kelias Santiamo vežimų kelias veikė nuo 1868 iki 1914."

	key[]: "poi_or3_03"
	val[]: "Veteranų istorinis greitkelis"

	key[]: "poi_or3_03_desc"
	val[]: "Šiaurinėje greitkelio dalyje 2012 metų lapkričio 9 dieną buvo pastatyti paskutiniai du iš 18 atminimo ženklų. Jie žymi Rufuso stovyklą kaip šiaurinį įvažiavimą į pirmą JAV greitkelį, dedikuotą Antrojo pasaulinio karo veteranams."

	key[]: "poi_or3_04"
	val[]: "Ogdeno valstijos aikštelė"

	key[]: "poi_or3_04_desc"
	val[]: "Ši pakelės aikštelė, pavadinta Peterio Skeno Ogdeno, 19-o amžiaus pradžios tyrinėtojo, Hadsono įlankos kompanijos pirklio garbei atmena jo ekspedicijas Gyvatės upe ir jo vaidmenį tyrinėjant Didįjį Sūrių ežerų baseiną."

	key[]: "landmark_or_fremont_b_desc"
	val[]: "Tiltas ir Portlendo Fremonto gatvė pavadintos dėl Džono C. Fremonto, ankstyvojo Los Kalifornijos ir Oregno apygardos tyrinėtojo. Jis turi ilgiausią Oregone tarpą ir yra antras pagal ilgį pasaulyje tokio tipo tiltas."

	
##########################################################################################

#@}



#+ California TBs and POIs localization.
#@{
	key[]: "tb_ca1"
	val[]: "Auksinis horizontas"

	key[]: "tb_ca1_desc"
	val[]: "Ikoniški tiltai kyla virš mirgančių vandenų ir sujungia Alkatrazą, Santa Kruzą ir regiono kalvas ir miestelius. Nuo ūžiančių gatvių ir istorinių vietovių iki saulėtų paplūdimių ir grąžių pakrančių - viską rasite Kalifornijos įlankos regione."

	key[]: "ca_cut_golden_gate_bridge_desc"
	val[]: "Tiltas, jungiantis San Francisko įlanką su Ramiuoju vandenynu yra ikoniškas San Francisko ir Kalifornijos simbolis. Atidarytas 1937 metais jis buvo rekordinis pakabinamas tiltas - ir pagal ilgš, ir pagal aukštį."

	key[]: "poi_ca1_01"
	val[]: "Alkatrazas"

	key[]: "poi_ca1_01_desc"
	val[]: "Alkatrazo saloje nuo 1934 iki 1963 metų veikė federalinis kalėjimas. Čia buvo laikomi garsiausi šalies nusikaltėliai, o dabar tai istorinė vieta ir populiarus turistų objektas."

	key[]: "ca_cut_richmond_desc"
	val[]: "Ričmondo - San Rafaelio tiltas jungia Ričmondą ir San Rafaelį per San Francisko įlanką. Atidarytas 1956 metais jis yra labai svarbus regiono transporto objektas."
	
	key[]: "poi_ca1_02"
	val[]: "Lobių sala"

	key[]: "poi_ca1_02_desc"
	val[]: "Lobių sala yra žmogaus supilta sala, 1939 metais pastatyta Auksinių vartų tarptautinei parodai. Anksčiau čia buvo karinio laivyno bazė, o dabar ji skirta gyventojams ir komercijai."

	key[]: "poi_ca1_03"
	val[]: "Serfingo miestas"

	key[]: "poi_ca1_03_desc"
	val[]: "Serfingo statula Santa Kruze pagerbia miesto serfingo kultūrą ir istoriją. Esanti netoli paplūdimio ji mini vietinius serferius ir sportą, suformavusius Santa Kruzo identitetą ir bendruomenę."

	key[]: "poi_ca1_04"
	val[]: "Madonos užeiga"

	key[]: "poi_ca1_04_desc"
	val[]: "Buvęs populiarus restoranas ir ten žymi viena 152 kelyje. Uždaryta nuo 2004 metų dėl greitkelio problemų ji lieka dažna tema vietinėje istorijoje ir vaiduoklių istorijų forumuose."



##########################################################################################

	key[]: "tb_ca2"
	val[]: "Šasta kelias"

	key[]: "tb_ca2_desc"
	val[]: "Šasta kelias vingiuoja pro pušynus ir kalnų ežerus prie Šasta kalno. Kelias kyla ir leidžiasi po slėnius ir veda keliautojus į pietus, kur kalnai atsitraukia ir užleidžią vietą šiaurės Kalifornijos senoviniam sekvojų miškui."

	key[]: "poi_ca2_01"
	val[]: "Šasta - Trejybės nacionalinis miškas"

	key[]: "poi_ca2_01_desc"
	val[]: "Šasta - Trejybės nacionalinis miškas, didžiausias Kalifornijoje, yra kertamas Trejybės palikimo panoraminio kelio, sekančio 19-o amžiaus aukso kasėjų ir naujakūrių keliais."

	key[]: "poi_ca2_02"
	val[]: "Didžioji Lagūna"

	key[]: "poi_ca2_02_desc"
	val[]: "Didžioji Lagūna yra didžiausia ir piečiausia iš trijų lagūnų Hambolto Lagūnų valstijos parke. Trys negilūs pakrantės baseinai yra tarp akmeningos žemės, o vandenyno banos pastatų smėlio barjerus, atskiriančius lagūnas nuo Ramiojo vandenyno."

	key[]: "or_cut_sequoia_desc"
	val[]: "Redvudo nacionalinis parkas saugo aukščiausias ir seniausias pasaulyje pakrantės sekvojas, viršijančias 120 m aukštį ir gyvenančias iki 2000 metų. kartu su gretimais valstijos parkais jis saugo 35% išlikusių seno augimo sekvojų miškų pasaulyje."
	
	key[]: "poi_ca2_03"
	val[]: "Smito upė"

	key[]: "poi_ca2_03_desc"
	val[]: "Šešių upių nacionaliniame miške Kalifornijos šiaurės vakaruose ši saugoma zona 1990 metais buvo apibrėžta Kongręso saugoti ekologines ir kultūrines vertybes. Smito upė yra vienintelė Kalifornijos upė be užtvankų."

	key[]: "poi_ca2_04"
	val[]: "Viskio upelio tiltas"

	key[]: "poi_ca2_04_desc"
	val[]: "Užbaigtas 1961 metais Viskio upelio tiltas yra trijų dalių suvirinta struktūrą. Jis garsus tuo, kad yra vienas pirmųjų tiltų, sukurtų naudojant trijų skirtingų rūšių plieną ir naujausius to meto virinimo metodus."

	key[]: "poi_ca2_05"
	val[]: "Šasta ežeras"

	key[]: "poi_ca2_05_desc"
	val[]: "Šasta ežeras, didžiausias Kalifornijos rezervuaras, buvo sukurtas Sakramento upėje pastačius Šasta užtvanką. 1945 metais pastatyta užtvanka tiekia vandenį bei hidroelektrą ir yra graži vieta poilsiui."

	key[]: "poi_ca2_06"
	val[]: "Šasta kalnas"

	key[]: "poi_ca2_06_desc"
	val[]: "Nuo 1820-ųjų Šasta kalnas, antras pagal aukštį Kaskadiniuose kalnuose, veda keliautojus Siskiju keliu papėdeje. Tas kelias vėliau virto 5 Interstate keliu, kuris dabar kiekvienais metais atveda prie kalno tūkstančius."



##########################################################################################

	key[]: "tb_ca3"
	val[]: "Siera perėja"

	key[]: "tb_ca3_desc"
	val[]: "Prie aukštųjų Nevados kalnų, tarp slėnių ir kalvų Bentone įsikūrė užeiga. Sieros perėja vingiuoja tyliais dykumos keliais, kur tolimi kalnai sukuria amžiną panoramą ir kviečią keliautojus tyrinėti atvirą peizažą."

	key[]: "ca_cut_olmsted_point_desc"
	val[]: "1890 metais įkurtas Josemičio nacionalinis parkas yra vienas iš labiausiai lankomų. Jis garsėja Josemičio kriokliu, aukščiausiu Šiaurės Amerikoje, taip pat gausiais takais ir daugiau nei 3000 metų amžiaus milžiniškomis sekvojomis"

	key[]: "poi_ca3_01"
	val[]: "Tioga kelias"

	key[]: "poi_ca3_01_desc"
	val[]: "Tiogas kelias yra gražus panoraminis kelias per Josemičio nacionalinį parką. Tai aukščiausia kalnų perėja greitkeliu Kalifornijoje, sujungianti vakarinę ir rytinę Nevados kalnų pusę."

	key[]: "poi_ca3_02"
	val[]: "Mono ežeras"

	key[]: "poi_ca3_02_desc"
	val[]: "Mono ežerui jau daugiau nei milijonas metų, ir tai vienas seniausių ežerų Šiaurės Amerikoje. Jis neturi ištekančios upės, todėl tūkstančius metų kaupia druską ir mineralus, tekančius žemyn nuo rytinių Nevados kalnų."
	
	key[]: "poi_ca3_03"
	val[]: "Taho ežeras"

	key[]: "poi_ca3_03_desc"
	val[]: "Taho ežeras susiformavo daugiau nei prieš 2 milijonus metų Taho baseine, o dabartinę jo formą sukūrė Ledynmečio ledynas. Tai didžiausias kalnų ežeras Šiaurės Amerikoje ir antras pagal gylį JAV."

	key[]: "poi_ca3_04"
	val[]: "Eldorado nacionalinis miškas"

	key[]: "poi_ca3_04_desc"
	val[]: "Eldorado nacionalinis miškas yra dalis vandens šaltinių sistemos, tiekiančios vandenį milijonams kaliforniečių ir palaikančių fermas, auginančias daugiau nei pusę valstybės vaisių ir daržovių."

	key[]: "poi_ca3_05"
	val[]: "Užeiga prie Bentono karštų šaltinių"

	key[]: "poi_ca3_05_desc"
	val[]: "Bentonas, vienas iš Mono apygardos seniausių miestų, buvo įkurtas Palute tautos prie karštų šaltinių. 1860-ais jis tapo stotele naujakuriams ir kasėjams. Užeiga, pastatyta 1940-ais metais iš vietinės pemzos, pakeitė 1904 metais statytą viešbutį su 10 kambarių ir viena vonia."



##########################################################################################

	key[]: "tb_ca4"
	val[]: "Saulė ir smėlis"

	key[]: "tb_ca4_desc"
	val[]: "Mirties slėnio dykuma driekiasi po begaliniu dangumi su kopomis, aštriomis viršūnėmis ir suskilinėjusiomis lygumomis. Kiškiai šokinėja po smėlį, kaukolės žymi tylius kelius, o vieniši keliai vingiuoja po neatlaidų peizažą, išbandantį ir žavintį keliautojus."

	key[]: "poi_ca4_01"
	val[]: "Loun Painas"

	key[]: "poi_ca4_01_desc"
	val[]: "Loun Painas yra mažas miestelis Kalifornijos Ovenso slėnyje, rytinėje Nevados kalnų papėdėje. Žinomas dėl gretimų Alabamos kalvų jis jau senai veikia kaip stotelė žygeiviams, alpinistams ir filmų kūrėjams, tyrinėjantiems aplinkinius kalnus ir dykumas."

	key[]: "poi_ca4_02"
	val[]: "Mirties slėnio nacionalinis parkas"

	key[]: "poi_ca4_02_desc"
	val[]: "Mirties slėnis yra viena ekstremaliausių vietų Amerikoje - žemiausia, karščiausia, sausiausia ir kartais aukščiausia. Gerokai iki 1800-ųjų pionierių čia gyveno vietinės gentys, medžiojo ir rinko gėrybes šioje atšiaurioje, bet istoriškai turtingoje vietovėje."

	key[]: "poi_ca4_03"
	val[]: "Tėvo Kraulio apžvalgos vieta"

	key[]: "poi_ca4_03_desc"
	val[]: "Ši apžvalgos vieta yra populiari keliautojų stotelė. Tėvas Džonas Kraulis, Dykumos tėvas, dažnai sustodavo čia. Netoli parko vakarinės ribos esanti vieta atskleidžia nuostabų Vaivorykštės Kanjono vaizdą."
	
	key[]: "poi_ca4_04"
	val[]: "Mohavės slėnio šuliniai"

	key[]: "poi_ca4_04_desc"
	val[]: "Slėnio šuliniuose Mohavėje senoviniai gruntiniai vandenys yra išlikę net nuo Ledynmečio. Šie istoriniai šuliniai atskleidžia, kaip gruntiniai vandenys kadaise palaikė pelkes ir gausią žalumą šiaip sausoje dykumoje."

	key[]: "poi_ca4_05"
	val[]: "Kolorado upės indėnų rezervatas"

	key[]: "poi_ca4_05_desc"
	val[]: "Šis rezervatas eina prie Kolorado upės Arizonoje ir Kalifornijoje. 1865 metais upės gentims įkurtame rezervate gyvena Mojavė, Čemehuevi, Hopių ir Navahų tautos."

##########################################################################################

#@}



#+ Idaho TBs and POIs localization.
#@{

    key[]: "tb_id1"
	val[]: "Lobių slėnis"

	key[]: "tb_id1_desc"
	val[]: "Lobių slėnis yra pietvakarių Aidahe. Jo turtingą istoriją formavo vietinių amerikiečių gentys, pirmieji kailių pirkliai ir Oregono kelio naujakuriai. Jo pavadinimas vaizduoja regiono išteklius ir galimybes, o vėliau aplink Boizio miestą išaugo žemdirbystės, geležinkeliai ir regioninė prekyba."

	key[]: "poi_id1_01"
	val[]: "Lašišų upė"

	key[]: "poi_id1_01_desc"
	val[]: "Lašišų upė Aidahe yra 685 kilometrus giliu kanjonu. Ji turi pravardę \"Negrįžimo upė\", nes anksčiau laivai nesugebėdavo plaukti prieš srovę dėl labai stiprios srovės."

	key[]: "poi_id1_02"
	val[]: "Boizio nacionalinis miškas"

	key[]: "poi_id1_02_desc"
	val[]: "Įsikūręs ant irstančio Aidaho batolito Boizio nacionalinis miškas yra vulkanų suformuotoje teritorijoje. Šis geologinis darinys geriausiai atsiskleidžia giliuose kanjonuose ir daugybėje karštų šaltinių."

	key[]: "poi_id1_03"
	val[]: "Pasagos Posūkis"

	key[]: "poi_id1_03_desc"
	val[]: "Kai Boizio baseine 1862 metais buvo rastas auksas prie upės žiemojantys kasėjai įkūrė Pasagos Posūkį. Anksčiau vadintas Vorinersviliu pagal vietinės lentpjūvės savininką miestelis pakeitė pavadinimą 1867 metais ir tapo svarbiausia kasėjų stotele."
	
	key[]: "poi_id1_04"
	val[]: "Mokami vartai"

	key[]: "poi_id1_04_desc"
	val[]: "1864 metais naujas kanjono kelias pakeitė statų Sirupo upelio kelią. 20 metų mokesčiai išlaikė jį, o Džeimso A. Porterio garsus viešbutis ir pieninė tapo svarbia stotele prieglobsčio ieškantiems keliautojams."

	key[]: "poi_id1_05"
	val[]: "Pilies Akmuo"

	key[]: "poi_id1_05_desc"
	val[]: "Pakeliui į Kamaso preriją Pilies akmens granito skardžiai buvo žymi vieta Oregono kelio migrantams. Naudotas nuo 1862 iki automobilių eros šis retas darinys džiugino keliautojų akis."

    key[]: "poi_id1_06"
	val[]: "Ančių slėnio indėnų rezervatas"

	key[]: "poi_id1_06_desc"
	val[]: "1886 metais prezidentas Klyvlendas išplėtė Ančių slėnį į Aidahą su \"Paddy Cap plėtiniu\". 1934 metais įvairios grupės, persikėlusios į rezervatą, gavo oficialų pripažinimą kaip susivienijusios Šošonų - Paiute gentys."


##########################################################################################

    key[]: "tb_id2"
	val[]: "Magiškas slėnis"

	key[]: "tb_id2_desc"
	val[]: "1900-ųjų pradžioje I. B. Perinas sausą Aidaho dykumą pavertė dirbama žeme pastatęs Milnerio užtvanką. Užbaigta 1905 metais užtvanka panaudojo Gyvatės upės vandenį \"magiškai\" transformuoti aplinką. Tai sukūrė Magišką slėnį, o fermerių miesteliai klesti iki šiol."

	key[]: "id_cut_perrine_desc"
	val[]: "Šošonų krioklys (62 m), aukštesnis už Niagaros krioklį, yra graži Gyvatės upės vieta prie pat Dvynių krioklio."

	key[]: "id_cut_galena_desc"
	val[]: "Įkurtas 1879 metais po švino ir sidabro atradimo šis kasėjų miestas sunyko 1890-aisiais, kai krito kainos. Šiandien ši vieta klesti kaip poilsio zona, prie labai gražios Galenos viršūnės."

	key[]: "poi_id2_01"
	val[]: "Bizono šuolis"

	key[]: "poi_id2_01_desc"
	val[]: "Bizono šuolis, esantis Čalise, yra istorinė vieta, kur vietinės tautos gindavo bizonus žemyn nuo skardžių. Naudota 2000 metų ši strateginė vieta pasakoja apie senovines bendruomeninės medžioklės tradicijas."
	
	key[]: "poi_id2_02"
	val[]: "Didžiojo Vaizdo kanjonas"

	key[]: "poi_id2_02_desc"
	val[]: "Didžiojo vaizdo kanjonas, esantis prie 93 kelio panoraminio aplinkkelio kraterių viršūnių, atskleidžia puikius vaizdus į Prarastosios upės kalnus. Šioje kalnų grandinėje yra devynios aukščiausios Aidaho viršūnės."

	key[]: "landmark_id_mackay_rs_desc"
	val[]: "Didžioji prarastoji upė, anksčiau vadinta Godeno upe pagal kailių medžiotoją Tieri Godeną, garsėja tuo, kad neria į lavą. Šis \"prarastas\" vanduo keliauja po žeme ir vėl išnyra nuostabiame Tūkstantyje Šaltinių netoli Gyvatės upės."

    key[]: "poi_id2_03"
	val[]: "Makėjaus vaiduoklių miestai"

	key[]: "poi_id2_03_desc"
	val[]: "Įsikūrę prie \"Kasyklų kalvos\" Balto mazgo kasimo regione tokie miestai kaip Baltas mazgas ir Uolos upelis varė vario, aukso ir sidabro bumą 20-ojo amžiaus viduryje. Šios vietos yra svarbūs prisiminimai apie Aidaho istorinę kasyklų pramonę."

	key[]: "id_cut_craters_desc"
	val[]: "Mėnulio krateriai, susikūrę per vulkanų išsiveržimus prieš 15.000 metų, buvo suformuoti lavos srautų. Šis nežemiškas peizažas toks unikalus, kad kadaise NASAS astronautai čia treniravosi Mėnulio misijoms."



##########################################################################################

#@}



#+ Montana TBs and POIs localization.
#@{

    key[]: "tb_mt1"
	val[]: "Ledyno kelias"

	key[]: "tb_mt1_desc"
	val[]: "Ledyno kelias turi vienus iš paskutinių likusių aktyvių ledynų Uolėtuose kalnuose. Per tūkstančius metų šios senovinės ledo masės išgraužė gilius slėnius, suformavo aštrias viršūnes ir tyrus ežerus."

	key[]: "poi_mt1_01"
	val[]: "Kutenai krioklys"

	key[]: "poi_mt1_01_desc"
	val[]: "Kutenai krioklys yra didžiausias neužtvenktas krioklys Montanoje. Kutenai upė krenta apie 100 metrų nedideliu atstumu ir sukuria galingas, gražias kaskadas, traukiančias keliautojus."

	key[]: "poi_mt1_02"
	val[]: "Berno pakelės parkas"

	key[]: "poi_mt1_02_desc"
	val[]: "Blogo akmens kanjonas buvo populiari stotelė keliaujantiems Flethedo upe, garsėjančia žvejyba, gražiais vaizdais ir natūraliais šaltiniais, kadaise naudotais aušinti perkaistančių automobilių radiatorius. 1956 metais jis tapo viena iš pirmųjų Montanos poilsio aikštelių, pavadinta Berno pakelės parku."

	key[]: "poi_mt1_03"
	val[]: "Dangiška viršūnė"

	key[]: "poi_mt1_03_desc"
	val[]: "Dangiška viršūnė, viena iš Ledyno nacionalinio parko žymiausių viršūnių, buvo pavadinta 1890-ais metais kasėjo Lui Mejerio, sužavėto jos grožio ir aukščio."

	key[]: "mt_cut_glacier_national_park_desc"
	val[]: "Ledyno nacionalinis parkas, laikomas \"Žemyno karūna\", buvo įkurtas 1910 metais. Suformuotas senovinių ledynų jis labiau išgarsėjo 1932 metais, kai buvo užbaigtas Kelio į Saulę kelias, istorinė inžinerinė įžymybė."

	key[]: "poi_mt1_04"
	val[]: "Juodos pėdos indėnų memorialas"

	key[]: "poi_mt1_04_desc"
	val[]: "Rytiniame Ledyno nacionalinio parko pakraštyje yra Juodosios pėdos tauta. Žinomi kaip \"lygumų kariai\" jie buvo pavadinti dėl mokasinų, nudažytų pelenais. Šiandien kelios vietos parke yra laikomos šventomis genčiai."

	key[]: "mt_cut_flathead_lake_desc"
	val[]: "Flethedo ežeras yra didžiausias gėlo vandens ežeras pagal plotą žemyninėje JAV dalyje. Maitinamas tirpstančio sniego nuo gretimų kalnų vandens jo ypatingai tyras vanduo pilnai pasikeičia kas keletą metų, dėl to tai vienas švariausių didelių ežerų pasaulyje."

	key[]: "mt_cut_thompson_falls_desc"
	val[]: "Pavadintas pagal britų-kanadiečių kailių pirklį ir kartografą Deividą Tompsoną miestas augo 1881 metais nutiesus geležinkelį. Jis dar labiau išsiplėtė per Coeur d'Alene aukso karštinę, nes tapo svarbia stotele kasėjams, keliaujantiems Murėjaus Keliu."

	key[]: "landmark_mt_missoula_desc"
	val[]: "Neoklasikiniai Misulos apygardos teismo rūmai, sukurti A. J. Gibsono ir 1910 metais pastatyti iš smiltainio pakeitė ankstesnį, mažesnį pastatą. Misulos apygarda, suformuota 1860 metais, yra vienas seniausių Montanos politinių regionų."

    key[]: "poi_mt1_05"
	val[]: "Lolo upelis"

	key[]: "poi_mt1_05_desc"
	val[]: "Koridorius tarp Lolo ir Lolo perėjos eina istoriniu keliu prie Lolo upelio. Kadaise įveiktas Nezo Perso, ankstyvųjų naujakurių, Liuiso ir Klarko ekspedicijos, jis lieka svarbiu kultūrai ir istorijai."

##########################################################################################

    key[]: "tb_mt2"
	val[]: "Didžiosios lygumos"

	key[]: "tb_mt2_desc"
	val[]: "Montanos Didžiosios Lygumos driekiasi rytinėje valstijos dalyje. Joms būdingos plačios pievos, prerijos ir atviras dangus. Šiame regione buvo rasta svarbiausios Šiaurės Amerikos dinozaurų fosilijos."

	key[]: "poi_mt2_01"
	val[]: "Pragaro upelio darinys"

	key[]: "poi_mt2_01_desc"
	val[]: "Pragaro upelio darinys, esantis aplink Pragaro upelė prie Džordano, Montanoje, išsaugo senovinį subtropinį upių, miškų ir pelkių peizažą. Siekiantis 67 - 66 milijonų metų amžių jis garsus gausybe dinozaurų fosilijų, įskaitant garsųjį Tiranozaurą Reks."

	key[]: "poi_mt2_02"
	val[]: "Jeloustouno upė"

	key[]: "poi_mt2_02_desc"
	val[]: "Jeloustouno upė yra ilgiausia neužtvenkta upė žemyninėje JAV. Prasidedanti Jeloustouno nacionaliniame parke ji 1090 kilometrų keliauja per Vajomingą ir Motaną, kur įsilieja į Misūrio upę."

	key[]: "poi_mt2_03"
	val[]: "Glendizauras"

	key[]: "poi_mt2_03_desc"
	val[]: "Glendizauras, tikro dydžio Triceratopso statula Glendaive, žymi turtingą regiono dinozaurų palikimą. Maždaug 3 metrų aukščio jis yra garsi vieta Dinozaurų kelyje."
	
	key[]: "poi_mt2_04"
	val[]: "Misūrio upė"

	key[]: "poi_mt2_04_desc"
	val[]: "Žinoma kaip \"Didžioji purvinoji\" Misūrio upė yra ilgiausia JAV upė. 3767 kilometrų ilgio nuo Montanos Uolėtųjų kalnų iki Misisipės upės ji buvo labai svarbi tyrinėjimams, prekybai ir Amerikos plėtrai į vakarus."

	key[]: "mt_cut_fort_peck_spillway_desc"
	val[]: "Forto Peko užtvanka, pastatyta per Didžiąją Depresiją, yra didžiausia pasaulyje vandens užpildyta žemės užtvanka. Vienas didžiausių Amerikos valstybinių projektų buvo skirtas suteikti darbo, valdyti potvynius ir gaminti elektros energiją."

    key[]: "poi_mt2_05"
	val[]: "Slėnio apygardos pionierių muziejus"

	key[]: "poi_mt2_05_desc"
	val[]: "Šis muziejus rodo šiaurės rytų Montanos istoriją per Asiniboine tautą, geležinkelius, žemdirbystę, Forto Peko užtvanką ir Liuiso ir Klarko ekspediciją. Čia taip pat yra vienas didžiausių Asiniboine tautos archyvų."

	key[]: "poi_mt2_06"
	val[]: "Miegančio bizono akmuo"

	key[]: "poi_mt2_06_desc"
	val[]: "Šie dideli ledyno akmenys buvo šventos vietos vietinėms gentims. Senovės ledynai aptrupino ir perkėlė juos. Mažesnis Bizono akmuo buvo išskaptuotas į bizono formą, o didesnis, Medicinos akmuo vaizduoja įvairius petroglifus."



##########################################################################################

#@}



#+ Wyoming TBs and POIs localization.
#@{

    key[]: "tb_wy1"
	val[]: "Bizono kelias"

	key[]: "tb_wy1_desc"
	val[]: "Einantis per Jeloustouną ir Didžiuosius Teutonų kalnus jis yra ant aktyvių vulkanų sistemos, varančius geizerius ir karštus šaltinius, o ledynai ir lūžiai formavo viršūnes ir slėnius. Dėl šių jėgų šiaurės vakarų Vajomingas yra viena iš geologiškai dinamiškiausių ir vaizdingiausių vietų Amerikos vakaruose."

	key[]: "landmark_wy_yellowsto_desc"
	val[]: "Jekloustounas, 1872 metais paskirtas pirmuoju pasaulyje nacionaliniu parku, yra ant didžiulio miegančio ugnikalnio. Čia yra daugiau nei pusė pasaulio aktyvių geizerių. Taip pat čia saugoma didžiausia ir sveikiausia vidutinio klimato ekosistema Žemėje."

	key[]: "poi_wy1_01"
	val[]: "Žemutinio geizerio baseinas"

	key[]: "poi_wy1_01_desc"
	val[]: "Žemutinio Geizerio baseinas yra didžiausias Jeloustouno geizerio baseinas, kuriame yra daug geizerių, karštų vandens ir garo šaltinių. Varoma gilios požeminės magmos karščio tai viena aktyviausių parke geoterminių vietų."

	key[]: "poi_wy1_02"
	val[]: "Jeloustouno ežeras"

	key[]: "poi_wy1_02_desc"
	val[]: "Jeloustouno ežeras yra didžiausias Šiaurės Amerikoje didelio aukščio ežeras, palaikantis didžiausią žemyne laukinio upėtakio populiaciją. Mokslininkai mano, kad kadaise jis tekėjo link Ramiojo vandenyno ir leido žuvims įveikti Kontinento padalijimą per Dviejų vandenynų perėją."
	
	key[]: "poi_wy1_03"
	val[]: "Bizonų Bilio užtvanka"

	key[]: "poi_wy1_03_desc"
	val[]: "Bizonų Bilio užtvanka, užbaigta 1910 metais, buvo viena pirmųjų betoninių užtvankų JAV. 99 metrų aukščio tuo metu ji buvo aukščiausia užtvanka pasaulyje."

	key[]: "poi_wy1_04"
	val[]: "Kolterio pragaras"

	key[]: "poi_wy1_04_desc"
	val[]: "Kolterio pragaras yra istorinė geoterminė vieta prie Šošonų upės, 1807 pavadinat keliautojo Džono Koletrio. Ankstyviesiems kalnų vyrams jos garai ir sieros kvapas priminė \"pragarą\". Šiandien aktyvūs liko tik karšti vandens ir garo šaltiniai."

	key[]: "wy_cut_grand_teton_desc"
	val[]: "Didžiųjų Teutonų nacionalinį parką apibūdina jo ledyno suformuotos viršūnės, kylančios virš Džeksono skylės. Kadaise kailiadirbių naudoti dėl didelio matomumo iš toli, kalnai lieka ikoniški Amerikos vakaruose."

	key[]: "poi_wy1_05"
	val[]: "Varno širdies kalnas"

	key[]: "poi_wy1_05_desc"
	val[]: "Varno širdies kalnas yra garsi vieta, 1866 metais pavadinta po mūšio tarp Šošonų ir Varnų genties. Pasak pasakojimų po pergalės Šošonų vadas Vašakis padėjo Varnų vado širdį ant kalno kaip perspėjimą."

##########################################################################################

    key[]: "tb_wy2"
	val[]: "Raudonoji dykuma"

	key[]: "tb_wy2_desc"
	val[]: "Vajomingo Raudonoji dykuma yra didžiulė aukšta dykuma, kurioje daug vėjo nešamo smėlio, krūmų ir raudonų akmenų darinių. Viena didžiausių negyvenamų vietų Šiaurės Amerikoje yra formuojama ekstremalaus klimato, išdžiuvusių senovinių ežerų ir nebenaudojamų migracijos kelių."

	key[]: "poi_wy2_01"
	val[]: "Raudonasis kanjonas"

	key[]: "poi_wy2_01_desc"
	val[]: "Raudonasis kanjonas buvo suformuotas prieš 60 milijonų metų tekant Vėjo upei. Jo raudonos uolos yra iš Čagvoterio akmens, kurio oksiduota geležis nudažo kanjoną ryškia spalva."

	key[]: "poi_wy2_02"
	val[]: "Galios peizažai"

	key[]: "poi_wy2_02_desc"
	val[]: "Šerno iltis, vulkaninis akmens darinys, daugiau nei 130 metrų kylantis Vajomingo Raudonojoje dykumoje, yra milijonų metų senumo apirusio ugnikalnio šerdis. Nuo jos matosi plačiosios Kilpekerio smėlio kopos, dalis didžiausio Šiaurės Amerikoje kopų lauko."

	key[]: "poi_wy2_03"
	val[]: "Rok Springsas"

	key[]: "poi_wy2_03_desc"
	val[]: "Rok Springsas, žinomas kaip \"56 tautybių miestas\" dėl daugybės įvairų imigrantų. 1800 pabaigoje žmonės iš viso pasaulio atvažiavo dirbti Union Pacific anglies kasyklose. Taip pat miestas siejamas su garsiuoju Buču Kesidžiu."
	
	key[]: "poi_wy2_04"
	val[]: "Bučo Kesidžio namelis"

	key[]: "poi_wy2_04_desc"
	val[]: "Bučas Kesidis buvo garsus Amerikos nusikaltėlis, vadovavęs \"Laukinei gaujai\", garsėjusiais traukinių ir bankų apiplėšimais Senuose Vakaruose. Jis užsidirbo savo pravardę dirbamas Rok Springso mėsinėje. Garsiausias jo apiplėšimas buvo Vilkokso traukini apiplėšimas 1899 metais."

	key[]: "wy_cut_evanston_desc"
	val[]: "1869 metais įkurtas Union Pacific Railroad kompanijos Evanstonas buvo pavadintas tyrinėtojo Džeimso A. Evanso vardu. Miestas augo kaip geležinkelio centras, o vėliau tapo žemdirbystės, naftos ir dujų regioniniu centru."

    key[]: "poi_wy2_05"
	val[]: "Lenderio kelias"

	key[]: "poi_wy2_05_desc"
	val[]: "Pastatytas po 1857 metų Pacific vežimų įstatymo Lenderoi kelias buvo vienas pirmųjų federaliniu būdu finansuoto vežimų kelio Amerikos vakaruose. Pavadintas inžinieriaus Frederiko V. Lenderio vardu tai buvo trumpesnis kelias į vakarus."

	

##########################################################################################

#@}


#+ South Dakota TBs and POIs localization.
#@{

    key[]: "tb_sd1"
	val[]: "Juodieji kalnai"

	key[]: "tb_sd1_desc"
	val[]: "Vakarinė Pietų Dakota apibrėžiama Juodųjų kalnų ir Bedlendsų. Čia plačias prerijas keičia pušynais padengti kalnai, granito viršūnės ir klajojančios bizonų bandos. Už jų Bedlendsai atskleidžia nuostabų peizažą, milijonus metų formuotą vandens ir vėjo."

	key[]: "poi_sd1_01"
	val[]: "Juodųjų kalnų nacionalinis parkas"

	key[]: "poi_sd1_01_desc"
	val[]: "Lakotos genčiai žinomame kaip Paha Sapa (\"Kalnai kurie yra juodi\") šiame pušynų regione yra Juodoji Elnio viršūnė, aukščiausias Pietų Dakotas taškas (2207 m). Pavadintas garsaus Lakotos gydytojo vardu tai yra ir aukščiausia viršūnė į rytus nuo Uolėtųjų kalnų."

	key[]: "sd_cut_rush_desc"
	val[]: "Rašmoro kalnas, dar vadinamas Amerikos \"Demokratijos šventykla\", buvo išskaptuotas Juoduosiuose Kalnuose tarp 1927 ir 1941 metų. Tai 20 metrų aukščio skulptūros - prezidentai Vašingtonas, Džefersonas, Ruzveltas ir Linkolnas - vaizduojančios valstybės gimimą, augimą, plėtrą ir išsaugojimą."

	key[]: "poi_sd1_02"
	val[]: "Bebro upelio tiltas"

	key[]: "poi_sd1_02_desc"
	val[]: "1929 metais pastatytas 68 metrų ilgio plieno ir betono arkinis tiltas kerta kanjoną netoli Vėjo olos nacionalinio parko. Pakilęs 35 metrus nuo kanjono dugno tai vienintelis tokio tipo tiltas Pietų Dakotoje, sukurtas kuo labiau susilieti su aplinkinėmis uolomis."

	key[]: "sd_cut_sturgis_desc"
	val[]: "Sturdžis garsėja didžiausiu pasaulyje motociklų susirinkimu. Jį 1938 metais pradėjo vietinis Indian motociklų pardavėjas Pepis Hoelis. Kasmet vykstanti 10 dienų trukmės šventė sukviečia motociklininkus iš viso pasaulio į parodas, lenktynes ir koncertus."

	key[]: "sd_cut_deadwood_desc"
	val[]: "Dedvudas iškilo per 1876 metų Juodųjų Kalnų aukso karštinę ir tapo vienu garsiausių Laukinių Vakarų miestų. 1961 metais pripažintas Nacionaline istorine įžymybe tai vienintelis JAV miestas turintis tokį statusą ir išlaikęs daugumą istorinio senamiesčio."

	key[]: "sd_cut_badlands_desc"
	val[]: "Bedlendsų nacionalinis parkas apima beveik 100.000 hektarų kalnų, viršūnių ir kalvų didžiausioje šalyje saugomoje prerijoje. Čia taip pat yra viena turtingiausių fosilijomis vietų, pasakojančių apie Didžiosiose Lygumose kadaise gyvenusius žinduolius."

	key[]: "poi_sd1_03"
	val[]: "Doano Robinsono tunelis"

	key[]: "poi_sd1_03_desc"
	val[]: "Doanas Robinsonas, žinomas kaip \"Rašmoro kalno tėvas\", sugalvojo didįjį monumentą Juoduosiuose Kalnuose pritraukti lankytojus į Pietų Dakotą. Šiandien jo palikimas tęsiasi, nes Rašmoro kalnas puikiai matosi pro vaizdingą Doano Robinsono tunelį."

	key[]: "sd_cut_hot_springs_desc"
	val[]: "Hot Springsas, pradžioje Sijų genties vadintas Minekahta (\"karšti vandenys\"), 1879 buvo įkurtas prie mineralinių šaltinių, tariamai turinčių gydomųjų galių. Pervadintas 1882 metais jis tapo sveikatingumo kurortu."

	key[]: "poi_sd1_04"
	val[]: "Mamutų vieta"

	key[]: "poi_sd1_04_desc"
	val[]: "Mamutų vieta yra visame pasaulyje garsi Ledynmečio fosilijų kasinėjimo vieta, kur buvo rastas 61 mamutas. Atrasta 1974 metais senovinė smegduobė išsaugojo didžiausią Kolumbijos mamutų likučių kolekciją Šiaurės Amerikoje, o kasinėjimai vyksta iki šiol."

##########################################################################################

    key[]: "tb_sd2"
	val[]: "Didysis padalijimas"

	key[]: "tb_sd2_desc"
	val[]: "Pietų Dakotos Misūrio upės regionas yra valstijos centrinis padalijimas, kurioje vienoje pusėje yra plačios lygumos, o kitoje - kalvos. Tai buvo svarbus koridorius vietinėms gentims, kailių pirkliams, Liuisui ir Klarkui, o vėliau čia buvo pastatytos didelės užtvankos ir miestai."

	key[]: "poi_sd2_01"
	val[]: "Keturi Didieji Ežerai"

	key[]: "poi_sd2_01_desc"
	val[]: "Sukurti Misūrio upės užtvankų 1940-ųjų pabaigoje Oahe, Šarpo, Francio Keiso ir Liuiso ir Klarko ežerai dabar labai svarbūs Pietų Dakotai. Kartu šie rezervuarai yra 710 kilometrų pakrantės poilsiui, žvejybai ir laivybai."

	key[]: "poi_sd2_02"
	val[]: "Bangoro vaiduoklių miestas"

	key[]: "poi_sd2_02_desc"
	val[]: "Bangoras kadaise buvo Volvorto apygardos centras, bet miestas nunyko, kai jo pastatai buvo perkelti į gretimąjį Selbį 1899 metais. Šiandien tik monumentas žymi vietą, kur kadaise buvo miestas."

	key[]: "landmark_sd_state_capitol_desc"
	val[]: "1880 metais įkurtas Pjeras tapo Pietų Dakotos sostine, kai valstija prisijungė prie Unijos 1889 metais. Parinktas dėl lokacijos centre ir Misūrio upės pakrantėje miestas buvo pavadintas prancūzų kilmės kailių pirklio Pjero Šuto jaunesniojo vardu."

	key[]: "sd_cut_corn_desc"
	val[]: "Kukurūzų rūmai Mičele yra vieninteliai rūmai pasaulyje, padabinti tik kukurūzais. Kasmet vietiniai menininkai ir žemdirbiai kuria naujus paveikslus naudodami natūralių spalvų kukurūzus, grūdus ir žoles, ir tai viena unikaliausių vietų Pietų Dakotoje."

	key[]: "landmark_sd_largest_pheasant_desc"
	val[]: "Hurone yra didžiausias pasaulyje fazanas, 13 metrų aukščio ir 22 tonų svorio plieno ir stiklo pluošto skulptūra, pastatyta 1959 metais. Ji žymi ilgametę regiono reputaciją kaip vieną pagrindinių Amerikoje fazanų medžioklės vietų."

	key[]: "landmark_sd_dignity_of_earth_and_sky_desc"
	val[]: "Žemės ir Dangaus orumas yra 17 metrų nerūdijančio plieno statulą prie Misūrio upės, netoli Čemberleno. Ją sukūrė menininkas Deilas Lamferas, ir ji pagerbia Lakotos ir Dakotos tautų palikimą, atsparumą ir kultūrą."

##########################################################################################

#@}
