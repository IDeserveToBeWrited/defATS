#+ Music/radio player
#@{

#+ Hint shown if no music files are found. Also shown as tooltip when hovering over music_player button.

	key[]: "music_player_hint"
	val[]: "Dėkite dainas į <color value=@@clr_sel@@>American Truck Simulator/music <color value=@@clr_txt@@>direktoriją prie savo<color value=@@clr_sel@@>Documents <color value=@@clr_txt@@>ir pamatysite juos čia."

#+ Tooltip shown when hovering over the radio_stream button.

	key[]: "radio_hint"
	val[]: "Redaguokite <color value=@@clr_sel@@>live_streams.sii <color value=@@clr_txt@@>direktorijoje <color value=@@clr_sel@@>American Truck Simulator <color value=@@clr_txt@@>prie Jūsų <color value=@@clr_sel@@>Documents <color value=@@clr_txt@@>ir žaidime klausykitės Jūsų mėgstamos interneto radijo!"

#+ Hint shown if no online radio streams are defined.

	key[]: "empty_radio_hint"
	val[]: "Informaciją apie tai, kaip pridėti savo muziką ir interneto radiją, rasite faile<color value=@@clr_sel@@>readme.rtf <color value=@@clr_txt@@> <color value=@@clr_sel@@>American Truck Simulator <color value=@@clr_txt@@>direktorijoje prie Jūsų <color value=@@clr_sel@@>Documents <color value=@@clr_txt@@>."
#@}

