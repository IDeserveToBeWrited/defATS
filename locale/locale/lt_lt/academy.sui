#### double_90 intro

	key[]: "aca_msg_book3_double_90_cutscene01"
	val[]: "Ši trasa padės jums susipažinti su B-dvigubų priekabų posūkiais 90 laipsnių kampu."

	key[]: "aca_msg_book3_double_90_cutscene02"
	val[]: "Pirmi keli posūkiai yra gana platūs, juose daug vietos. Naudok juos, kad pajustum priekabas."

	key[]: "aca_msg_book3_double_90_cutscene03"
	val[]: "Toliau posūkiai taps staigesni ir techniškesni. Artėk prie jų lėtai ir įsitikink, kad įvažiuojai giliai į posūkius, kad priekabos turėtų vietos važiuoti."

	key[]: "aca_msg_book3_double_90_cutscene04"
	val[]: "Tai vienas staigiausių posūkių trasoje. Gali būti naudinga išnaudoti nedidelę erdvę dešinėje, kad su priekabomis būtų lengviau apvažiuoti tuos erzinančius vidinius kūgius."

	key[]: "aca_msg_book3_double_90_cutscene05"
	val[]: "Visada reikia atminti kitą posūkį – išvažiuojant iš vieno posūkio sudaryk planą, kaip pasiruošti kitam."

	key[]: "aca_msg_book3_double_90_cutscene06"
	val[]: "Visada stebėk priekabas, kol jos pravažiuos kliūtis."

#### double_90 driving instructions

#!{
	key[]: "aca_msg_book3_double_90_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_double_90_forward"
	val[]: "Važiuok link pirmo posūkio."

	key[]: "aca_msg_book3_double_90_check1"
	val[]: "Stebėk veidrodėlius mokydamasis suprasti, kaip priekabos seka paskui sunkvežimį."

	key[]: "aca_msg_book3_double_90_check2"
	val[]: "Prieš kiekvieną posūkį važiuokite plačiau – tai labai svarbu, kad turėtum pakankamai vietos, jog priekabos apvažiuotų posūkio kampą."

	key[]: "aca_msg_book3_double_90_check3"
	val[]: "Pasiruošimas keliems kitiems posūkiams yra labai svarbus, nes po jų bus labai staigus posūkis. Klaida pradžioje gali jums kainuoti dar daugiau vėliau. <br><br>Važiuok lėtai ir atidžiai, stebėk aplinką."

	key[]: "aca_msg_book3_double_90_check4"
	val[]: "Šis posūkis yra itin staigus ir veda tiesiai į kitą staigų posūkį. Reikia apgalvoti ne tik tai, kaip įvažiuosi į posūkį, bet ir kaip išvažiuosi bei pasiruoši kitam."

	key[]: "aca_msg_book3_double_90_check5"
	val[]: "Važiuok toliau per paskuitnius posūkius link nurodytos zonos."

#!{
	key[]: "aca_msg_book3_double_90_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_double_90_end"
	val[]: "@@aca_msg_book3_sup_end@@"
