	key[]: "aca_msg_book3_correcting_90_cutscene2"
	val[]: "Jau teko pavažiuoti atbulai su keliomis priekabomis, todėl turėtum žinoti, ką dabar daryti."

	key[]: "aca_msg_book3_correcting_90_cutscene3"
