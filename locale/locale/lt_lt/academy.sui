	val[]: "Manevravimas į vietą"


#### 3_06 msg - intro text

	key[]: "aca_msg_book1_3_06_cutscene01"
	val[]: "Parkavimas važiuojant tiesiai yra gana lengvas parkavimo manevras.<br>Tačiau turi nepamiršti kompensuoti priekabos kampo kirtimą."

	key[]: "aca_msg_book1_3_06_cutscene02"
	val[]: "Turėsi pravažiuoti tašką, kuriame suktum įprastai, tik su vilkiku. Tai leis tau paprasčiau ištiesinti priekabą."

	key[]: "aca_msg_book1_3_06_cutscene03"
	val[]: "Kai artėsi prie parkavimo vietos, pasuk į ją plačiau. Išsitiesink ir važiuok iki vietos galo.<br>Sustok, įjunk stovėjimo stabdė ir išjung variklį."

#### 3_06 Driving Instructions

	key[]: "aca_msg_book1_3_06_start"
	val[]: "Priekyje yra stovėjimo vieta, į kurią reikia įvažiuoti.<br><br><font face=/font/big_bold.font>Pasiruošk važiuoti.</font>"

	key[]: "aca_msg_book1_3_06_forward"
	val[]: "<font face=/font/big_bold.font>Pradėk važiuoti ir pasuk link parkavimo vietos.</font>"

	key[]: "aca_msg_book1_3_06_check1"
	val[]: "Važiuok pro parkavimo vietą, kad priekaba galėtų įsukti, tada suk vilkiką į vietą ir ištiesink.<br><br><font face=/font/big_bold.font>Sustok nurodytoje vietoje.  </font>"

	key[]: "aca_msg_book1_3_06_stop"
	val[]: "<font face=/font/big_bold.font>Sustok nurodytoje vietoje. </font>"

	key[]: "aca_msg_book1_3_06_end"
	val[]: "<font face=/font/big_bold.font>Įjunk stovėjimo stabdį ir išjunk variklį. </font>"
