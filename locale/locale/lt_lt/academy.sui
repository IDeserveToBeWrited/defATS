#+ Book 1 Scenario 1_02
#@{

#### 1_02 common

	key[]: "aca_scenario_book1_1_02_title"
	val[]: "Kameros valdymas"

	key[]: "aca_scenario_book1_1_02_desc"
	val[]: "Šiame scenarijuje išmoksime apie įvairias kameras ir kaip jos gali padėti valdyti ir manevruoti sunkvežimį."

#### 1_02 goal

	key[]: "aca_goal_book1_1_02_seat"
	val[]: "Sėdėjimo padėtis"

	key[]: "aca_goal_book1_1_02_look_back"
	val[]: "Vaizdas atgal"

	key[]: "aca_goal_book1_1_02_mirrors"
	val[]: "Veidrodėlių patikrinimas"

	key[]: "aca_goal_book1_1_02_cam_behind"
	val[]: "Persijungti į išorinę kamerą"

	key[]: "aca_goal_book1_1_02_look_around"
	val[]: "Apsidairyti aplink sunkvežimį"


#### 1_02 msg - intro text

	key[]: "aca_msg_book1_1_02_cutscene1"
	val[]: "Šiame scenarijuje apžiūrėsime įvairias kameras<br>kurias galima naudoti."

	key[]: "aca_msg_book1_1_02_cutscene2"
	val[]: "Iš viso galima pasirinkti septynias kameras, dabar apžiūrėsime<br> kelias iš jų ir paaiškinsime jų paskirtį."

	key[]: "aca_msg_book1_1_02_cutscene3"
	val[]: "Įvairios kameros ir įvairūs jų kampai gali padėti manevruoti siaurose vietose."


#### 1_02 Driving Instructions

	key[]: "aca_msg_book1_1_02_seat"
	val[]: "Žiūrėti kur važiuoji yra būtina saugiam ir profesionaliam vairavimui. Jei dabartinė sėdėjimo padėtis tau netinka, gali pareguliuoti ją \"@@adjust_link_t@@\" (Atidaryk per pauzės meniu).<br><br><font face=/font/big_bold.font>Patvirtinka, kad galime judėti toliau su @@imv_nrm_activate@@. </font>"

	key[]: "aca_msg_book1_1_02_look_back"
	val[]: "Važiuojant atbulai veidrodėliai ne visada parodo visą vaizdą. gali būti būtina pasižiūrėti atgal pro langą.<br><br><font face=/font/big_bold.font>Pasuk kamerą vairuotojo pusėn iki galo ir pažiūrėsi pro langą į lauką, link priekabos galo.</font>@@aca_goal_tip@@ Turi būti sunkvežimyje."

	key[]: "aca_msg_book1_1_02_mirrors"
	val[]: "Naudok šį vaizdą patikrinti priekabą važiuojant atbulai. Visada geriausia atbulai važiuoti į vairuotojo pusę, kad galėtum naudoti šį vaizdą. Važiuojant atbulai į keleivio pusę turėsi gerokai labiau ribotą vaizdą atgal.<br><br><font face=/font/big_bold.font>Pažiūrėk į vairuotojo pusę. </font>"

	key[]: "aca_msg_book1_1_02_cam_behind"
	val[]: "Štai kodėl paprastai nerekomenduojama važiuoti atbulai į keleivio pusę, matai, kad matomumas ten gana ribotas. Laimei, gali pasinaudoti septyniomis išorinėmis kameromis. <br><br>Mygtukas @@imv_nrm_camcycle@@ įjungia sekančią kamerą iš eilės. Po paskutinės kameros vėl grįši į ciklo pradžią. <br><br><font face=/font/big_bold.font>Spausk @@imv_nrm_camcycle@@ ir įjunk kitą kamerą. </font>"

	key[]: "aca_msg_book1_1_02_look_around"
	val[]: "Išorinė kamera geriausiai parodo, kas vyksta aplink sunkvežimį.<br><br><font face=/font/big_bold.font>Apsidairyk aplink sunkvežimį.</font>"

	key[]: "aca_msg_book1_1_02_cam_top"
	val[]: "<font face=/font/big_bold.font>Spausk @@imv_nrm_camcycle@@ dar kartą ir perjunk kitą kamerą. </font>"

	key[]: "aca_msg_book1_1_02_cam_cabin"
	val[]: "Vaizdas iš viršaus puikiai parodo situaciją aplink sunkvežimį ir gerokai palengvina parkavimą ir vairavimą siaurose vietose.<br><br><font face=/font/big_bold.font>Spausk @@imv_nrm_camcycle@@ ir perjunk kitą kamerą.  </font>"

	key[]: "aca_msg_book1_1_02_cam_window"
	val[]: "Vaizdas nuo stogo gerai parodo kelią tolumoje.<br><br><font face=/font/big_bold.font>Spausk @@imv_nrm_camcycle@@ ir perjunk paskutinę kamerą, kurią kol kas aptarsime.</font>"

	key[]: "aca_msg_book1_1_02_cam_interior"
	val[]: "Vaizdas atgal yra tas pats, kaip pasukant vidinę kamerą iki galo. Kaip aptarėme, jis padeda važiuojant atbulai ar parkuojant.<br><br>Žaidime yra daugiau kamerų, kurias gali išbandyti dar kartą spaudžiant @@imv_nrm_camcycle@@.<br><br><font face=/font/big_bold.font>Spausk @@imv_nrm_cam1@@ grįžti į vidaus kamerą.</font>"

	key[]: "aca_msg_book1_1_02_end"
	val[]: "Autentiškai vairavimo patirčiai rekomenduojam likti Vidaus kameroje visuose scenarijuose.<br><br><font face=/font/big_bold.font>Spausk @@imv_nrm_activate@@ patvirtinti ir užbaigti scenarijų.</font>@@aca_goal_tip@@ Gali naudoti funkciją @@o_im_cam_zoom@@ kad geriau matytum aplinką. Tai ypatingai padeda žiūrint į veidodėlius. Spausk Opcijų ekrano \"@@options_bindings_screen@@\" skyrių ir rask ir/arba pakeisk atitinkamus mygtukus."

#@}

#+ Book 1 Scenario 1_03
#@{

#### 1_03 common
	key[]: "aca_scenario_book1_1_03_title"
	val[]: "Pirmas važiavimas"

	key[]: "aca_scenario_book1_1_03_desc"
	val[]: "Šiame scenarijuje išmoksime paruošti sunkvežimį važiavimui, ir pirmą kartą pavažiuosime priekin."

#### 1_03 goal

	key[]: "aca_goal_book1_1_03_electrics"
	val[]: "Degimo įjungimas"

	key[]: "aca_goal_book1_1_03_start"
	val[]: "Variklio užvedimas"

	key[]: "aca_goal_book1_1_03_look_mirror"
	val[]: "Aplinkos patikrinimas"

	key[]: "aca_goal_book1_1_03_brake"
	val[]: "Darbinio stabdžio nuspaudimas"

	key[]: "aca_goal_book1_1_03_gear"
	val[]: "Pavaros įjungimas"

	key[]: "aca_goal_book1_1_03_park_br_off"
	val[]: "Stovėjimo stabdžio išjungimas"

	key[]: "aca_goal_book1_1_03_forward"
	val[]: "Važiavimas pirmyn"

	key[]: "aca_goal_book1_1_03_stop"
	val[]: "Sustojimas"

	key[]: "aca_goal_book1_1_03_park_br_on"
	val[]: "Stovėjimo stabdžio įjungimas"

	key[]: "aca_goal_book1_1_03_gear_n"
	val[]: "Laisvos pavaros įjungimas"

	key[]: "aca_goal_book1_1_03_end"
	val[]: "Variklio išjungimas"

#### 1_03 msg - intro text

	key[]: "aca_msg_book1_1_03_cutscene1"
	val[]: "Keliems pirmiems važiavimams naudosime tik vilkiką.<br>Sunkvežimis vadinamas vilkiku, kai jis neturi savo kėbulo kroviniams, o tik tempia priekabas."

	key[]: "aca_msg_book1_1_03_cutscene2"
	val[]: "Vilkikai yra dažni, nes jie suteikia didesnį universalumą: jie gali atkabinti tuščią priekabą ir prisikabinti pilną, nelaukiant pakrovimo, arba net prisikabinti visai kito tipo priekabą."

	key[]: "aca_msg_book1_1_03_cutscene3"
	val[]: "Pirmo važiavimo užduotis bus pavažiuoti priekin ir sustoti už brūkšninės linijos.<br>Užvesk variklį ir laikykis nurodymų kaip važiuoti. Kai pasiruoši, važiuok tiesiai pirmyn."

	key[]: "aca_msg_book1_1_03_cutscene4"
	val[]: "Pravažiuok brūkšninę liniją, sustok, išjunk variklį ir pasirūpink sunkvežimiu."

#### 1_03 Driving Instructions

	key[]: "aca_msg_book1_1_03_electrics"
	val[]: "Kitame mokymų žingsnyje pirmą kartą važiuosi sunkvežimiu.<br><br>Žinoma, tai nepavyks su išjungti varikliu, todėl pirma reikia įjungti degimą.<br><br><font face=/font/big_bold.font>Spausk $input engineelect$ įjungti degimą.</font>@@aca_goal_tip@@ Karjeroje, su standartiniais nustatymais, variklis automatiškai užsiveda įjungus elektrą. Karjeroje šį elgesį galima pakeisti Nustatymuose - @@auto_engine_start@@."

	key[]: "aca_msg_book1_1_03_start"
	val[]: "Degimas įjungis sunkvežimio elektroniką. Pamatysi įvairias lemputes prie prietaisų - tai normalu. Jei jos neužges užvedus variklį, gali būti, kad sunkvežimyje kažkas sugedo. Išimtis yra stovėjimo stabdžio lemputė, kuri išsijungs kai išjungsi stovėjimo stabdį.<br><br>Laimei šis sunkvežimis geros būklės ir viskas paruošta.<br><br><font face=/font/big_bold.font>Spausk @@imv_nrm_engine@@ užvesti variklį.</font>"

	key[]: "aca_msg_book1_1_03_look_mirror"
	val[]: "Užvedus variklį, prieš važiuojant būtina gerai apsidairyti.<br><br><font face=/font/big_bold.font>Apsidairyk į visas puses, per visus veidrodėlius ir patikrink, ar sunkvežimis gali važiuoti.</font>@@aca_goal_tip@@ Turi būti sunkvežimio viduje."

	key[]: "aca_msg_book1_1_03_brake"
	val[]: "Gali atrodyti akivaizdu, bet prieš pradedant važiuoti turėtum sužinoti, kaip sustoti.<br><br><font face=/font/big_bold.font>Naudok darbinius stabdžius su $input backward$. </font>"

	key[]: "aca_msg_book1_1_03_gear_arcade"
	val[]: "Toliau išmoksi keisti judėjimo kryptį.<br><br>Supaprastintoje automatinėje pavarų dėžėje nereikia jungti pavarų, viskas atliekama automatiškai.<font face=/font/big_bold.font><br><br>Spausk $input forward$ jungti judėjimą priekin. </font>"

	key[]: "aca_msg_book1_1_03_gear_automatic"
	val[]: "Toliau išmoksi keisti judėjimo kryptį.<br><br>Realistiška automatinė pavarų dėžė leikdžia tau perjungti tarp Važiavimo (D), Laisvos (N) ir Atbulinės (R) pavarų, kaip tikroje automatinėje pavarų dėžėje.<br><br><font face=/font/big_bold.font>Spausk @@imv_nrm_gearup@@ įjungti Važiavimo pavarą. </font>"

	key[]: "aca_msg_book1_1_03_gear_manual"
	val[]: "Toliau išmoksi keisti judėjimo kryptį.<br><br>Sekvencinė pavarų dėžė leidžia jungti pavaras iš eilės, kaip tikrovėje.<br><br>Kaip įjungiant pirmą pavarą priekin, įsibėgėjant reikės įjungti aukštesnes pavaras.<br><br><font face=/font/big_bold.font>Spausk @@imv_nrm_gearup@@ įjungti pirmą pavarą.</font>"

	key[]: "aca_msg_book1_1_03_gear_direct"
	val[]: "Toliau išmoksi keisti judėjimo kryptį.<br><br>Su pavarų perjungimo svirtimi ir sankaba patirsi tą patį, kaip fiziškai perjungiant pavaras tikroje rankinėje pavarų dėžėje.<br><br>Nuspausk sankabą ir darbinius stabdžius. <font face=/font/big_bold.font>Pavarų perjungimo svirtimi įjunk pirmą pavarą. <color value=@@clr_txt@@>Sankabą ir darbinius stabdžius laikyk nuspaustus.</font>"

	key[]: "aca_msg_book1_1_03_park_br_off"
	val[]: "Pradedant judėti pirma reikia išjungti stovėjmo stabdį.<br><br><font face=/font/big_bold.font>Spausk @@imv_nrm_parkingbrake@@ išjungti stovėjimo stabdį.</font> @@aca_goal_tip@@ Karjeroje stovėjimo stabdis pradžioje būna neįjungtas. Galima tai pakeisti Nustatymuose - Žaidimas - @@auto_park_brake@@."

	key[]: "aca_msg_book1_1_03_forward_arcade"
	val[]: "Dabar sunkvežimis pasiruošęs judėti pirmyn. Pradėk judėti ir kirsk brūkšninę liniją. <br><br><font face=/font/big_bold.font>Judėti pradėk su akseleratoriumi: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_automatic"
	val[]: "Dabar sunkvežimis pasiruošęs judėti pirmyn. Pradėk judėti ir kirsk brūkšninę liniją. <br><br><font face=/font/big_bold.font>Judėti pradėk su akseleratoriumi: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_manual"
	val[]: "Dabar sunkvežimis pasiruošęs judėti pirmyn. Pradėk judėti ir kirsk brūkšninę liniją. <br><br><font face=/font/big_bold.font>Judėti pradėk su akseleratoriumi: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_direct"
	val[]: "Dabar sunkvežimis pasiruošęs judėti pirmyn. Pradėk judėti ir kirsk brūkšninę liniją. <br><br><font face=/font/big_bold.font>Atleisk darbinį stabdį, po truputį atleisk sankabą tuo pačiu truputį spaudžiant akseleratorių, kad variklis neužgęstų. Kai sankaba bus pilnai atleista, galėsi įsibėgėti ir toliau perjungti pavaras</font>"

	key[]: "aca_msg_book1_1_03_stop_arcade"
	val[]: "Sustok darbiniais stabdžiais.<br><br><font face=/font/big_bold.font>Spausk $input backward$ stabdyti sunkvežimį. </font>"

	key[]: "aca_msg_book1_1_03_stop_automatic"
	val[]: "Sustok darbiniais stabdžiais.<br><br><font face=/font/big_bold.font>Spausk $input backward$ stabdyti sunkvežimį. </font>"

	key[]: "aca_msg_book1_1_03_stop_manual"
	val[]: "Sustok darbiniais stabdžiais.<br><br><font face=/font/big_bold.font>Spausk $input backward$ stabdyti sunkvežimį. </font>"

	key[]: "aca_msg_book1_1_03_stop_direct"
	val[]: "Atėjus laikui sustoti nuspausk sankabą <font face=/font/big_bold.font>ir sustok darbiniais stabdžiais.<color value=@@clr_txt@@> Pavarų perjungimo svirtimi įjunk laisvą pavarą ir tada galėsi atleisti sankabą. </font>"

	key[]: "aca_msg_book1_1_03_park_br_on"
	val[]: "Dabar pasirūpink sunkvežimiu. Stovėjimo stabdis neleis sunkvežimiui pajudėti netyčia.<br><br><font face=/font/big_bold.font>Spausk @@imv_nrm_parkingbrake@@ įjungti stovėjimo stabdį.</font>"

	key[]: "aca_msg_book1_1_03_gear_n_arcade"
	val[]: "Supaprastintoje automatinėje pavarų dėžėje nereikia perjungti pavarų, tai daroma automatiškai.<br><br><font face=/font/big_bold.font>Spausk @@imv_nrm_activate@@ patvirtinti. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>Įjunk laisvą pavarą - spausk @@imv_nrm_geardown@@. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>Įjunk laisvą pavarą - spausk @@imv_nrm_geardown@@. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>Perjunk pavarų svirtį į laisvą pavarą ir atleisk sankabą. </font>"

	key[]: "aca_msg_book1_1_03_end"
	val[]: "Dabar žinai kaip važiuoti sunkvežimiu ir kaip saugiai sustoti<br><br><font face=/font/big_bold.font>Spausk $input engineelect$ išjungti variklį. </font>"
#@}

#+ Book 1 Scenario 1_04
#@{

#### 1_04 common
	key[]: "aca_scenario_book1_1_04_title"
	val[]: "Važiavimas atbulai"

	key[]: "aca_scenario_book1_1_04_desc"
	val[]: "Šiame scenarijuje pirmą kartą pabandysime važiuoti atbulai. Taip pat pakalbėsime apie tai, kaip veidrodėliais pamatyti, kas vyksta gale, ko saugotis ir kaip pasiruošti judėjimui atgal."

#### 1_04 goal

	key[]: "aca_goal_book1_1_04_start"
	val[]: "Variklio užvedimas"

	key[]: "aca_goal_book1_1_04_look_mirror"
	val[]: "Keleivio pusės veidrodėlių patikrinimas"

	key[]: "aca_goal_book1_1_04_look_back"
	val[]: "Vairuotojo pusės veidrodėlių patikrinimas"

	key[]: "aca_goal_book1_1_04_gear_r"
	val[]: "Pavaros įjungimas"

	key[]: "aca_goal_book1_1_04_park_br_off"
	val[]: "Stovėjimo stabdžio išjungimas"
#!{
	key[]: "aca_goal_book1_1_04_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_1_04_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_1_04_park_br_on"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

#!}
	key[]: "aca_goal_book1_1_04_gear_n"
	val[]: "Laisvos pavaros įjungimas"

	key[]: "aca_goal_book1_1_04_end"
	val[]: "Variklio išjungimas"

#### 1_04 msg - intro text

	key[]: "aca_msg_book1_1_04_cutscene1"
	val[]: "Šį kartą atbulai važiuosime tiesia linija. Turėsi nuvažiuoti už brūkšninės linijos ir ten sustoti."

	key[]: "aca_msg_book1_1_04_cutscene2"
	val[]: "Sunkvežimiu važiuojant atbulai būtina nuolat dairytis, stebėti visus veidrodėlius ir nuolat užtikrinti, kad erdvėje aplink sunkvežimį nėra kliūčių."

	key[]: "aca_msg_book1_1_04_cutscene3"
	val[]: "Užvesk variklį, įjunk atbulinę pavarą ir pradėk judėti."

	key[]: "aca_msg_book1_1_04_cutscene4"
	val[]: "Pravažiuok brūkšninę liniją, sustok, išjunk variklį ir pasirūpink sunkvežimiu."

#### 1_04 Driving Instructions

	key[]: "aca_msg_book1_1_04_start"
	val[]: "Paruošk sunkvežimį važiavimui kaip praeitame scenarijuje.<br><br><font face=/font/big_bold.font>Kai pasiruoši užvesk variklį. </font>"

	key[]: "aca_msg_book1_1_04_look_mirror"
	val[]: "Patikink veidrodėliuose, ar nėra kliūčių. Jei nepatinka jų padėtis, galima juos pareguliuoti \"@@adjust_link_t@@\".<br><br><font face=/font/big_bold.font>Pažiūrėk į keleivio pusės veidrodėlį.</font>@@aca_goal_tip@@ Turi būti sunkvežimio viduje."

	key[]: "aca_msg_book1_1_04_look_back"
	val[]: "Važiuosi už brūkšninės linijoss. Dabar juosta tuščia, bet įprastai vairuojant būtina nuolat stebėti aplinką dairantis ir per veidrodėlius.<br><br><font face=/font/big_bold.font>Patikrink keleivio pusės veirodėlį.</font>"

	key[]: "aca_msg_book1_1_04_gear_r_arcade"
	val[]: "<font face=/font/big_bold.font>Spausk $input backward$ įjungti atbulinę pavarą. </font>@@aca_goal_tip@@ Važiuojant atbulai daugumoje sunkvežimių įsijungia perspėjimo signalas. Jį išjungti galima Nustatymuose - Garsas - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_automatic"
	val[]: "<font face=/font/big_bold.font>Spausk @@imv_nrm_geardown@@ įjungti atbulinę pavarą. </font>@@aca_goal_tip@@ Važiuojant atbulai daugumoje sunkvežimių įsijungia perspėjimo signalas. Jį išjungti galima Nustatymuose - Garsas - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_manual"
	val[]: "<font face=/font/big_bold.font>Spausk @@imv_nrm_geardown@@ įjungti atbulinę pavarą. </font>@@aca_goal_tip@@ Važiuojant atbulai daugumoje sunkvežimių įsijungia perspėjimo signalas. Jį išjungti galima Nustatymuose - Garsas - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_gear_r_direct"
	val[]: "<font face=/font/big_bold.font>Nuspausk sankabą ir pavarų svirtį perjunk į atbulinę pavarą. </font>@@aca_goal_tip@@ Važiuojant atbulai daugumoje sunkvežimių įsijungia perspėjimo signalas. Jį išjungti galima Nustatymuose - Garsas - @@sound_of_reverse@@."

	key[]: "aca_msg_book1_1_04_park_br_off"
	val[]: "Dabar įjungta atbulinė pavara.<br><br><font face=/font/big_bold.font>Išjunk stovėjimo stabdį su @@imv_nrm_parkingbrake@@. </font>"

	key[]: "aca_msg_book1_1_04_backward_arcade"
	val[]: "Pradėk judėti spaudžiant $input backward$.<br><br><font face=/font/big_bold.font>Važiuok atbulai už brūkšninės linijos. </font>"

	key[]: "aca_msg_book1_1_04_backward_automatic"
	val[]: "Pradėk judėti spaudžiant akseleratorių: $input forwardd$.<br><br><font face=/font/big_bold.font>Važiuok atbulai už brūkšninės linijos. </font>"

	key[]: "aca_msg_book1_1_04_backward_manual"
	val[]: "Pradėk judėti spaudžiant akseleratorių: $input forwardd$.<br><br><font face=/font/big_bold.font>Važiuok atbulai už brūkšninės linijos. </font>"

	key[]: "aca_msg_book1_1_04_backward_direct"
	val[]: "Lėtai atleisk sankabą ir truputį nuspausk akseleratorių. <br><br><font face=/font/big_bold.font>Važiuok atbulai už brūkšninės linijos.</font>"

	key[]: "aca_msg_book1_1_04_stop_arcade"
	val[]: "<font face=/font/big_bold.font>Sustok darbiniais stabdžiais: $input forward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_automatic"
	val[]: "<font face=/font/big_bold.font>Sustok darbiniais stabdžiais: $input backward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_manual"
	val[]: "<font face=/font/big_bold.font>Sustok darbiniais stabdžiais: $input backward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_direct"
	val[]: "<font face=/font/big_bold.font>Nuspausk sankabą ir sustok darbiniais stabdžiais. </font>"

	key[]: "aca_msg_book1_1_04_park_br_on"
	val[]: "<font face=/font/big_bold.font>Įjunk stovėjimo stabdį su @@imv_nrm_parkingbrake@@. </font>"

	key[]: "aca_msg_book1_1_04_gear_n_arcade"
	val[]: "Supaprastintoje automatinėje pavarų dėžėje nereikia perjungti pavarų, tai daroma automatiškai, kitaip nei gyvenime.<br><br><font face=/font/big_bold.font>Spausk @@imv_nrm_activate@@ patvirtinti. </font>"

	key[]: "aca_msg_book1_1_04_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>Įjunk laisvą pavarą su @@imv_nrm_gearup@@.</font>@@aca_goal_tip@@ Šiuolaikiniai sunkvežimiai automatiškai įjungia laisvą pavarą įjungus stovėjimo stabdį. Tačiau geras įprotis yra visada padaryti tai savarankiškai. Kituose scenarijuose nereikalausime šio žingsnio."

	key[]: "aca_msg_book1_1_04_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>Įjunk laisvą pavarą su @@imv_nrm_gearup@@.</font>@@aca_goal_tip@@ Šiuolaikiniai sunkvežimiai automatiškai įjungia laisvą pavarą įjungus stovėjimo stabdį. Tačiau geras įprotis yra visada padaryti tai savarankiškai. Kituose scenarijuose nereikalausime šio žingsnio."

	key[]: "aca_msg_book1_1_04_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>Perjunk pavarų svirtį į laisvą pavarą ir atleisk sankabą.</font>@@aca_goal_tip@@ Šiuolaikiniai sunkvežimiai automatiškai įjungia laisvą pavarą įjungus stovėjimo stabdį. Tačiau geras įprotis yra visada padaryti tai savarankiškai. Kituose scenarijuose nereikalausime šio žingsnio."

	key[]: "aca_msg_book1_1_04_end"
	val[]: "Atmink nuolat stebėti aplinką važiuojant atbulai, ypač ten, kur didelis eismas.<br><br><font face=/font/big_bold.font>Išjunk variklį su $input engineelect$. </font>"
#@}

# Book 1 Scenario 1_05 formatting
#!{
	key[]: "aca_msg_book1_1_05_low_beam_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/parking_lights.mat width=336 height=76 color=FFFFFFFF></align><offset vshift=76>"

	key[]: "aca_msg_book1_1_05_high_beam_on_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/low_beam.mat width=336 height=76 color=FFFFFFFF></align><offset vshift=76>"

	key[]: "aca_msg_book1_1_05_high_beam_off_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/high_beam.mat width=336 height=76 color=FFFFFFFF></align><offset vshift=76>"

	key[]: "aca_msg_book1_1_05_lblinker_off_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/blinkers_left.mat width=336 height=76 color=FFFFFFFF></align><offset vshift=76>"

	key[]: "aca_msg_book1_1_05_rblinker_off_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/blinkers_right.mat width=336 height=76 color=FFFFFFFF></align><offset vshift=76>"

	key[]: "aca_msg_book1_1_05_hazard_on_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/hazard_lights.mat width=336 height=76 color=FFFFFFFF></align><offset vshift=76>"

	key[]: "aca_msg_book1_1_05_hazard_off_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/hazard_lights_blink.mat width=336 height=76 color=FFFFFFFF></align><offset vshift=76>"
#!}

#+ Book 1 Scenario 1_05
#@{

#### 1_05 common
	key[]: "aca_scenario_book1_1_05_title"
	val[]: "Šviesos ir valytuvai"

	key[]: "aca_scenario_book1_1_05_desc"
	val[]: "Šiame scenarijuje panagrinėsime sunkvežimio valdymą, padėsiantį gerai matyti aplinką, o tavo vairavimą - nuspėjamą kitiems vairuotojams.<br><br>Išmoksi naudotis valytuvais blogu oru, taip pat šviesomis ir posūkių signalais."

#### 1_05 goal

	key[]: "aca_goal_book1_1_05_start"
	val[]: "Variklio užvedimas"

	key[]: "aca_goal_book1_1_05_parking"
	val[]: "Gabaritų šviesos"

	key[]: "aca_goal_book1_1_05_low_beam"
	val[]: "Artimos šviesos"

	key[]: "aca_goal_book1_1_05_high_beam"
	val[]: "Tolimos šviesos"

	key[]: "aca_goal_book1_1_05_lblinkers"
	val[]: "Kairys posūkio signalas"

	key[]: "aca_goal_book1_1_05_rblinkers"
	val[]: "Dešinys posūkio signalas"

	key[]: "aca_goal_book1_1_05_hazard"
	val[]: "Avarinis signalas"

	key[]: "aca_goal_book1_1_05_wipers"
	val[]: "Valytuvai"

	key[]: "aca_goal_book1_1_05_end"
	val[]: "Variklio išjungimas"

#### 1_05 msg - intro text

	key[]: "aca_msg_book1_1_05_cutscene1"
	val[]: "Šiame scenarijuje išbandysime sunkvežimio funkcijas, padedančias geriau matyti tau ir kitiems geriau matyti tave."

	key[]: "aca_msg_book1_1_05_cutscene2"
	val[]: "Įjungsime įvairias apšvietimo sistemas ir išmoksime, kada jas reikia naudoti."

	key[]: "aca_msg_book1_1_05_cutscene3"
	val[]: "Mes junginėsime posūkių signalus."

	key[]: "aca_msg_book1_1_05_cutscene4"
	val[]: "Ir pagaliau pažiūrėsime, kaip reguliuoti valytuvus, kad jie veiktų efektyviai įvairiuose krituliuose."



#### 1_05 Driving Instructions

	key[]: "aca_msg_book1_1_05_start"
	val[]: "Apžvelkime, kaip naudoti įvairų apšvietimą bei valytuvus.<br><br>Artimos ir tolimos šviesos apšviečia kelią priekyje. Posūkių ir avarinis signalai naudojami, kad kiti vairuotojai galėtų suprasti tavo manevrus.<br><br>Valytuvai naudojami nuo priekinio stiklo nuvalyti vandenį ir nešvarumus.<font face=/font/big_bold.font><br><br>Užvesk variklį, bet neišjunk stovėjimo stabdžio. </font>"

	key[]: "aca_msg_book1_1_05_parking"
	val[]: "Iki šiol naudojai tik dienos žibintus. Jie automatiškai įsijungia įjungus degimą ir naudojami normaliomis sąlygomis. Tačiau dabar, kai oro sąlygos pablogėjo, reikia įjungti visas šviesas.<font face=/font/big_bold.font><br><br>Spausk @@imv_nrm_light@@ įjungti gabaritų šviesas. </font>"

	key[]: "aca_msg_book1_1_05_low_beam"
	val[]: "@@aca_msg_book1_1_05_low_beam_img@@<br>Gabaritų šviesos tai priekiniai, šoniniai ir galiniai žymekliai. Jie naudojami, kai sunkvežimis stovi prastai apšviestoje vietoje, kad būtų matomas kitiems vairuotojams.<font face=/font/big_bold.font><br><br>Spausk @@imv_nrm_light@@ įjungti artimas šviesas. </font>"

	key[]: "aca_msg_book1_1_05_high_beam_on"
	val[]: "@@aca_msg_book1_1_05_high_beam_on_img@@<br>Artimos šviesos apšviečia kelią priekyje bei pagerina tavo sunkvežimio matomumą tamsoje.<font face=/font/big_bold.font><br><br>Spausk @@imv_nrm_hblight@@ įjungti tolimas šviesas. </font>"

	key[]: "aca_msg_book1_1_05_high_beam_off"
	val[]: "@@aca_msg_book1_1_05_high_beam_off_img@@<br>Tolimos šviesos leidžia tamsoje pamatyti kelią toliau.<br><br>Tačiau reikia atminti, kad jos gali apakinti kitus vairuotojus, ypač atvažiuojančius iš priekio. Artėjant prie kitų vairuotojų būtinai reikia jas išjungti.<font face=/font/big_bold.font><br><br>Spausk @@imv_nrm_hblight@@ išjungti tolimas šviesas. </font>"

	key[]: "aca_msg_book1_1_05_lblinker_on"
	val[]: "Dabar pakalbėkime apie posūkių signalus. Posūkių signalų tikslas parodyti kitiems eismo dalyviams, kad nori persirikiuoti ar pasukti.<font face=/font/big_bold.font><br><br>Spausk @@imv_nrm_lblinker@@ įjungti kairį posūkio signalą. </font>"

	key[]: "aca_msg_book1_1_05_lblinker_off"
	val[]: "@@aca_msg_book1_1_05_lblinker_off_img@@<br>Pastebnėis, kad prie prietaisų mirksi kairio posūkio signalo lemputė. Taip pat mirksi posūkio signalai kairėje sunkvežimio pusėje.<font face=/font/big_bold.font><br><br>Dabar spausk @@imv_nrm_lblinker@@ išjungti kairį posūkio signalą. </font>"

	key[]: "aca_msg_book1_1_05_rblinker_on"
	val[]: "Posūkio signalus, rodančius krypties pakeitimą, turi būti įjungti pakankamai anksti, kad kiti eismo dalyviai galėtų pasiruošti tavo manevrui ir atitinkamai pakeisti savo vairavimą.<font face=/font/big_bold.font><br><br>Spausk @@imv_nrm_rblinker@@ įjungti dešinį posūkio signalą. </font>"

	key[]: "aca_msg_book1_1_05_rblinker_off"
	val[]: "@@aca_msg_book1_1_05_rblinker_off_img@@<br>Dabar prie prietaisų mirksi dešinys posūkio signalas. Tuo pat metu mirksi posūkio signalai dešinėje sunkvežimio pusėje.<font face=/font/big_bold.font><br><br>Dabar spausk @@imv_nrm_rblinker@@ išjungti dešinį posūkį signalą. </font>"

	key[]: "aca_msg_book1_1_05_hazard_on"
	val[]: "@@aca_msg_book1_1_05_hazard_on_img@@<br>Avarinio signalo mygtukas pažymėtas raudonu trikampio simboliu. Šis signalas yra svarbi kelių saugumo dalis ir turi būti naudojamas tik tada, kai būtina. Ši funkcija įjungia abiejų posūkių signalus vienu metu.<font face=/font/big_bold.font><br><br> Spausk @@imv_nrm_flasher4way@@ įjungti avarinį signalą.</font>"

	key[]: "aca_msg_book1_1_05_hazard_off"
	val[]: "@@aca_msg_book1_1_05_hazard_off_img@@<br>Dabar mirksi abiejų posūkių lemputės prietaisuose ir abiejose sunkvežimio pusėse.<br><br>Avarinis signalas paprastai naudojamas, kai sunkvežimis sustoja ten, kur paprastai nestovi, pavyzdžiui pakelėje, dėl techninio ar mechaninio gedimo. Taip pat jais galima perspėti vairuotojus apie priekyje sustojusį eismą.<font face=/font/big_bold.font><br><br>Dabar spausk @@imv_nrm_flasher4way@@ išjungti avarinį signalą. </font>"

	key[]: "aca_msg_book1_1_05_wipers_on"
	val[]: "Dabar pakalbėkime apie valytuvus. Valytuvai pašalina nuo lango lietų ir kitus nešvarumus. Pagrindinė jų užduotis - kad langas būtų švarus ir skaidrus. Valytuvai turi kelis greičius.<br><br><font face=/font/big_bold.font>Spausk @@imv_nrm_wipers@@ nustatyti valytuvus į veikimą su pauzėmis. </font>@@aca_goal_tip@@ Karjeroje galima naudoti automatinį lietaus daviklį, kuris automatiškai įjungia valytuvus pradėjus lyti. Jį galimarasti Nustatymuose - Žaidimas - @@rain_sensor@@."

	key[]: "aca_msg_book1_1_05_wipers2"
	val[]: "Šis nustatymas leidžia valytuvams veikti su pertraukomis. Tai naudinga, kai lyja labai silpnai.<br><br>Kaip matai, lietus per stiprus, ir valytuvai nespėja nuvalyti viso vandens.<font face=/font/big_bold.font><br><br>Spausk @@imv_nrm_wipers@@ dar kartą perjungti valytuvus į mažo greičio nustatymą. </font>"

	key[]: "aca_msg_book1_1_05_wipers3"
	val[]: "Dabar valytuvai veikia pastoviu greičiu.<font face=/font/big_bold.font><br><br>Spausk @@imv_nrm_wipers@@ dar kartą įjungti didelio greičio nustatymą. </font>"

	key[]: "aca_msg_book1_1_05_wipers_off"
	val[]: "Matai, kad valytuvai dabar veikia gerokai greičiau. <font face=/font/big_bold.font><br><br>Spausk @@imv_nrm_wipers@@ išjungti valytuvus. </font>@@aca_goal_tip@@ Taip pat gali naudoti funkciją @@o_im_wipers_back@@ perjungti valytuvų ciklą atgal. Atitinkamą klavišą rasti ar nustatyti gali Nustatymuose, skyriuje \"@@options_bindings_screen@@\"."

	key[]: "aca_msg_book1_1_05_wipers_off_back"
	val[]: "Dabar valytuvai veikia daug greičiau maksimaliai valydami stiklą.<font face=/font/big_bold.font><br><br>Spausk @@imv_nrm_wipersback@@ kelis kartus, kol valytuvai išsijungs.</font>"

	key[]: "aca_msg_book1_1_05_end"
	val[]: "<font face=/font/big_bold.font>Išjunk šviesas ir išjunk variklį. </font>"
#@}

#+ Book 1 Scenario 2_01
