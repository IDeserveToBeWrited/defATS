#### 3_04 Driving Instructions



	key[]: "aca_msg_book1_3_04_forward"
	val[]: "<font face=/font/big_bold.font>Įsibėgėk ir apvažiuok barjerus. </font>"

	key[]: "aca_msg_book1_3_04_check1"
	val[]: "Važiuok toliau pirmais dviem lengvais posūkiais.<br><br><font face=/font/big_bold.font>Važiuok toliau.</font>"

	key[]: "aca_msg_book1_3_04_check2"
	val[]: "<font face=/font/big_bold.font>Įveik 90 laipsnių posūkį.</font>"

	key[]: "aca_msg_book1_3_04_check3"
	val[]: "Toliau maršrute dvigubas apsisukimas. Tai, kaip įveiksi pirmą dalį, tiesiogiai paveiks tavo judėjimą antroje.<br><br><font face=/font/big_bold.font>Važiuok atsargiai.</font>"

	key[]: "aca_msg_book1_3_04_check4"
	val[]: "Po šių posūkių laikykis kairiau artėjant prie siauros dalies.<br><br><font face=/font/big_bold.font>Važiuok toliau.</font>"

	key[]: "aca_msg_book1_3_04_check5"
	val[]: "<font face=/font/big_bold.font>Toliau važiuok siaura dalimi. </font>"

	key[]: "aca_msg_book1_3_04_check6"
	val[]: "Priekyje keli paprasti 90 laipsnių posūkiai.<br><br><font face=/font/big_bold.font>Įveik posūkius.</font>"

	key[]: "aca_msg_book1_3_04_check7"
	val[]: "Artėji prie dar vieno apsisukimo. Stebėk priekabą veidrodėliuose.<br><br><font face=/font/big_bold.font>Įveik apsisukimą.</font>"

	key[]: "aca_msg_book1_3_04_check8"
	val[]: "90 laipsnių posūkis priekyje siauresnis nei atrodo. Išmintingai išnaudok erdvę.<br><br><font face=/font/big_bold.font>Važiuok toliau.</font>"

	key[]: "aca_msg_book1_3_04_check9"
	val[]: "Paskutinis apsisukimas sudėtingas, beveik be laisvos vietos.<br><br><font face=/font/big_bold.font>Važiuok atidžiai.</font>"

	key[]: "aca_msg_book1_3_04_check10"
	val[]: "Tavęs laukia paskutinis 90 laipsnių posūkis.<br><br><font face=/font/big_bold.font>Važiuok toliau.</font>"

	key[]: "aca_msg_book1_3_04_check11"
	val[]: "Važiuok į nurodytą vietą."
