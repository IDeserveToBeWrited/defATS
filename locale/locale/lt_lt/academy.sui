#+ Book 2 intro
#@{

#### common
	key[]: "aca_scenario_book2_intro_title"
	val[]: "Sunkvežimio vairavimo įgūdžiai"


#### intro text

	key[]: "aca_scenario_book2_book2_intro_cutscene1"
	val[]: "Sveikiname grįžus į @@driving_academy@@!"

	key[]: "aca_scenario_book2_book2_intro_cutscene2"
	val[]: "Šie scenarijai yra tollimesni žingsniai tavo kelionėje į profesionalų sunkvežimio valdymą."

	key[]: "aca_scenario_book2_book2_intro_cutscene3"
	val[]: "Šį kartą nevesime tavęs už rankos per kiekvieną užduotį, todėl tau teks parodyti savo įgūdžius ir patirtį."

	key[]: "aca_scenario_book2_book2_intro_cutscene4"
	val[]: "Pastebėsi jau pažįstamus manevrus, bet šį kartą naujoje aplinkoje, panašesnėje į tikrą gyvenimą."

	key[]: "aca_scenario_book2_book2_intro_cutscene5"
	val[]: "Naujovė @@driving_academy@@ - \"Įveikimo\" ir \"Papildomos\" sąlygos."

	key[]: "aca_scenario_book2_book2_intro_cutscene6"
	val[]: "Kaip ir anksčiau, vis dar reikia įveikti kiekvieną scenarijų į nieką neatsitrenkus, sėkmingai pastačius ir išjungus sunkvežimį..."

	key[]: "aca_scenario_book2_book2_intro_cutscene7"
	val[]: "...bet dabar turi atlikti tai per nustatytą laiką ir su ribotu judėjimo krypties keitimų kiekiu."

	key[]: "aca_scenario_book2_book2_intro_cutscene8"
	val[]: "Papildomas sąlygas atlikti galima įveikiant kiekvieną scenarijų su vis sunkesnėmis sąlygomis..."

	key[]: "aca_scenario_book2_book2_intro_cutscene9"
	val[]: "...pavyzdžiui vis mažiau laiko, mažiau krypties keitimų, naudojant tik vidaus kamerą."

	key[]: "aca_scenario_book2_book2_intro_cutscene10"
	val[]: "Įveikus visus scenarijus galėsi vadinti savo įgūdžius puikiais, ir ruoštis kitiems iššūkiams kelyje.<br><br>Gali pasistengti įveikti visų scenarijų visas papildomas sąlygas, tada tikrai būsi sunkvežimio valdymo žvaigždė!"


#@}



#+ Book 2 zero
#@{
#### zero common
	key[]: "aca_scenario_book2_zero_title"
	val[]: "Mokymai"

	key[]: "aca_scenario_book2_zero_desc"
	val[]: "Šiame mokymo scenarijuje padėsime susipažinti su Sunkvežimio valdymo įgūdžių naujovėmis."


#### zero info msg1

	key[]: "aca_msg_book2_scenario_zero1_title"
	val[]: "Sunkvežimio vairavimo įgūdžiai"

	key[]: "aca_msg_book2_scenario_zero1"
	val[]: "Kiekvieno scenarijaus pradžioje pamatysi <color value=@@clr_sel@@>\"Scenarijaus apžvalgą\"<color value=@@clr_txt@@>. Ten bus pateiktos įveikimo ir papildomos sąlygos.<br><br>Įveikimo sąlygas privalo būti atliktos sėkmingai pabaigai, o papildomos sąlygos yra papildomas, nebūtinas iššūkis. <br><br><font face=/font/big_bold.font>Įjunk sunkvežimio elektrą.</font>"

#### zero info msg1b

	key[]: "aca_msg_book2_scenario_zero1b"
	val[]: "Viena iš papildomų sąlygų yra įveikti scenarijų naudojant tik <color value=@@clr_sel@@>Vidaus kamerą<color value=@@clr_txt@@>. Gali panaudoti išorės kameras apsidairyti, bet tik kai sunkvežimis stovi.<br><br>Gali apsidairyti ir vėl persijungti į vidaus kamerą.<br><br><font face=/font/big_bold.font>Persijunk į išorės kamerą ir apsidairyk</font>"


#### zero info msg1c


	key[]: "aca_msg_book2_scenario_zero1c"
	val[]: "Apsidairyk ir persijunk į vidaus kamerą.<br><br><font face=/font/big_bold.font>Apsižvalgyk aplink sunkvežimį</font>"


#### zero info msg1d


	key[]: "aca_msg_book2_scenario_zero1d"
	val[]: "<font face=/font/big_bold.font>Persijunk į vidaus kamerą</font>"
#### zero info msg2

	key[]: "aca_msg_book2_scenario_zero2_title"
	val[]: "Sunkvežimio vairavimo įgūdžiai"

	key[]: "aca_msg_book2_scenario_zero2"
	val[]: "<color value=@@clr_sel@@>Laikas<color value=@@clr_txt@@> taip pat bus svarbus šiame Modulyje. Visi scenarijai turi savo laiko limitą scenarijaus įveikimui, taip pat yra papildomas, griežtesnis limitas Papildomoje sąlygoje.<br><br>Laikas pradeda eiti sunkvežimiui pajudėjus.<br><br><font face=/font/big_bold.font>Užvesk variklį ir išjunk stovėjimo stabdį.</font>"


#### zero info msg3

	key[]: "aca_msg_book2_scenario_zero3_title"
	val[]: "Sunkvežimio vairavimo įgūdžiai"

	key[]: "aca_msg_book2_scenario_zero3"
	val[]: "Kita naujovė yra tarpiniai taškai. Visi taškai turi būti pasiekti.<br><br>Papildomai, taškai turi savo įveikimo kryptį, todėl atkreipk dėmesį į žymėjimus ant kelio.<br><br><font face=/font/big_bold.font>Važiuok link taško priekyje.</font>"


#### zero info msg4

	key[]: "aca_msg_book2_scenario_zero4_title"
	val[]: "Sunkvežimio vairavimo įgūdžiai"

	key[]: "aca_msg_book2_scenario_zero4"
	val[]: "Pasiekei tašką ir gali imtis kito žingsnio.<br><br>Už tavęs yra kitas taškas, kurį reikia pasiekti atbulai. Pastebėk rodyklę ant kelio, rodančią judėjimo kryptį.<br><br>Dar viena Įveikimo ir Papildoma sąlyga yra <color value=@@clr_sel@@>Krypties keitimai<color value=@@clr_txt@@>. Mes skaičiuojame, kiek kartų keitei judėjimo kryptį - pirmyn ir atgal. Neviršyk ribos.<br><br><font face=/font/big_bold.font>Važiuok atbulai link taško ir sustok.</font>"

#### zero info msg5

	key[]: "aca_msg_book2_scenario_zero5_title"
	val[]: "Sunkvežimio vairavimo įgūdžiai"

	key[]: "aca_msg_book2_scenario_zero5"
	val[]: "Taigi dabar turėtum turėti vieną krypties pakeitimą.<br><br>Prikabink priekabą ir judėk į kitą žingsnį.<br><br><font face=/font/big_bold.font>Privažiuok prie priekabos ir prikabink ją.</font>"

#### zero info msg6

	key[]: "aca_msg_book2_scenario_zero6_title"
	val[]: "Sunkvežimio vairavimo įgūdžiai"

	key[]: "aca_msg_book2_scenario_zero6"
	val[]: "Galutinė stovėjimo vieta yra dešinėje. Kai kurie scenarijai turės tik vieną stovėjimo vietą, kituose jų gali būti daugiau. Teisingas sustojimas vienoje iš jų leis užbaigti scenarijų.<br><br><font face=/font/big_bold.font>Spausk @@imv_nrm_attach@@ ir prikabink priekabą.</font>"


#### zero info msg7

	key[]: "aca_msg_book2_scenario_zero7_title"
	val[]: "Sunkvežimio vairavimo įgūdžiai"

	key[]: "aca_msg_book2_scenario_zero7"
	val[]: "Stovėjimo vietos taip pat rodo, kuria kryptimi reikia pastatyti sunkvežimį. Sustok neteisingai ir negalėsi užbaigti scenarijaus kodėl nepasitaisysi, ir tai kainuos laiko ir krypties pakeitimų.<br><br><font face=/font/big_bold.font>Važiuok prie stovėjimo vietos ir sustok teisingai.</font>"



#### zero info msg8

	key[]: "aca_msg_book2_scenario_zero8_title"
	val[]: "Sunkvežimio vairavimo įgūdžiai"

	key[]: "aca_msg_book2_scenario_zero8"
	val[]: "Dabar turėtum žinoti naujus Įveikimo ir Papildomų sąlygų parametrus, ir gali imtis Sunkvežimio valdymo įgūdžių scenarijų!<br><br><font face=/font/big_bold.font>Įjunk stovėjimo stabdį ir išjunk variklį.</font>"



#@}

#+ Book 2 trailer check
#@{

#### Mission instructions - trailer check

key[]: "aca_msg_book2_slopy_moments_title"
val[]: "Nurodymų laikymasis"

key[]: "aca_msg_book2_slopy_moments1"
val[]: "Šis scenarijus reikalaus, kad priekaba būtų prikabinta visada.<br><br><font face=/font/big_bold.font>Prikabink priekabą.</font>"

key[]: "aca_msg_book2_slopy_moments2"
val[]: "Dabar gali tęsti scenarijų"


#@}


#+ Book 2 slalom_nt
#@{
#### 3_21 common
	key[]: "aca_scenario_book2_slalom_nt_title"
	val[]: "Dvigubas slalomas"

	key[]: "aca_scenario_book2_slalom_nt_desc"
	val[]: "Čia turėsi įveikti trumpą trasą iš dviejų slalomų."

#### slalom_nt intro text

	key[]: "aca_scenario_book2_slalom_nt_cutscene1"
	val[]: "Šį scenarijų sudaro du sujungti slalomai. Važiuok pirmu slalomu nepaliesdamas kūgių ir apsisuk pabaigoje."

	key[]: "aca_scenario_book2_slalom_nt_cutscene2"
	val[]: "Toliau važiuok antru slalomu į galutinę stovėjimo vietą.<br><br>Bus fiksuojamas laikas, todėl važiuok ryžtingai, bet atidžiai!"



#@}

#+ Book 2 training_course
#@{
#### common
	key[]: "aca_scenario_book2_training_course_title"
	val[]: "Gamyklos beprotystė"

	key[]: "aca_scenario_book2_training_course_desc"
	val[]: "Šioje užduotyje reikės įveikti pramoninę mokomąją trasą."

#### intro text

	key[]: "aca_scenario_book2_training_course_cutscene1"
	val[]: "Ši mokomoji trasa vis sudėtingės."

	key[]: "aca_scenario_book2_training_course_cutscene2"
	val[]: "Įveik kiekvieną dalį greitai ir saugiai, ir nepamiršk pasiruošti kitam posūkiui!"



#@}

#+ Book 2 reverse_parking
#@{
#### common
	key[]: "aca_scenario_book2_reverse_parking_title"
	val[]: "Atbulas parkavimas už kampo"

	key[]: "aca_scenario_book2_reverse_parking_desc"
	val[]: "Čia turėsi atbulai pastatyti sunkvežimį už aklo kampo."

#### intro text

	key[]: "aca_scenario_book2_reverse_parking_cutscene1"
	val[]: "Iškrovimo vietos ne visada būna idealios. Šiuo atveju ją užstoja gretimas pastatas."

	key[]: "aca_scenario_book2_reverse_parking_cutscene2"
	val[]: "Važiuok atbulai į stovėjimo vietą už pastato."

#@}


#+ Book 2 blindside_parking
#@{
#### common
	key[]: "aca_scenario_book2_blindside_parking_title"
	val[]: "Parkavimas akloje pusėje"

	key[]: "aca_scenario_book2_blindside_parking_desc"
	val[]: "Čia vėl reikės pastatyti sunkvežimį aklai ir atbulai. Tai sudėtingas manevras net idealiomis sąlygomis, bet dabar tavęs laukia dar griežtesni reikalavimai."

#### intro text

	key[]: "aca_scenario_book2_blindside_parking_cutscene1"
	val[]: "Priekyje dešiniau yra stovėjimo vieta, į kurią reikia įvažiuoti atbulai. Pravažiuok pro ją, o tada atbulai važiuok į vietą."

	key[]: "aca_scenario_book2_blindside_parking_cutscene2"
	val[]: "Dabar bus mažiau vietos nei anksčiau, todėl reikia vairuoti dar tiksliau."

#@}


