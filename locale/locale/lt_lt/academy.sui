#### 3_03 msg - intro text

	key[]: "aca_msg_book1_3_03_cutscene01"
	val[]: "Priekyje yra keli sudėtingi posūkiai ir kliūtys.<br>Jei panaudosi viską, ką išmokai iki šiol, neturėtų būti sunku."

	key[]: "aca_msg_book1_3_03_cutscene02"
	val[]: "Pirmas posūkis - paprastas sagos kablio posūkis. Laikykis plačiau ir neturėtų būti sunku."

	key[]: "aca_msg_book1_3_03_cutscene03"
	val[]: "Važiuok toliau link žiedo."

	key[]: "aca_msg_book1_3_03_cutscene04"
	val[]: "Laikyk priekabą toliau nuo žiedo vidaus vilkiku važiuodamas kuo plačiau."

	key[]: "aca_msg_book1_3_03_cutscene05"
	val[]: "90 laipsnių posūkis kairėn nėra labai staigus, bet atsargiai nepervažiuok kūgių."

	key[]: "aca_msg_book1_3_03_cutscene06"
	val[]: "Šis posūkis gerokai staigesnis. Jam įveikti panaudok ąsočio rankenos manevrą."

	key[]: "aca_msg_book1_3_03_cutscene07"
	val[]: "Šiame posūkyje gali panaudoti sagos kablio manevrą, bet čia yra papildomų kliūčių."

	key[]: "aca_msg_book1_3_03_cutscene09"
	val[]: "Ir vėl paskutinis posūkis labai siauras, ir jame reikės panaudoti ir ąsočio rankenos, ir sagos kablio manevrus."

	key[]: "aca_msg_book1_3_03_cutscene10"
	val[]: "Sustok pažymėtoje vietoje, įjunk stovėjimo stabdį ir išjunk variklį."


#### 3_03 Driving Instructions



	key[]: "aca_msg_book1_3_03_forward"
	val[]: "<font face=/font/big_bold.font>Važiuok į pirmą posūkį. </font>"

	key[]: "aca_msg_book1_3_03_check1"
	val[]: "Pirmas posūkis yra lengvas sagos kablio posūkis.<br><br><font face=/font/big_bold.font><color value=@@clr_txt@@>Važiuok posūkiu.</font>"

	key[]: "aca_msg_book1_3_03_check2"
	val[]: "Toliau žiedas. Atmink juo važiuoti plačiai.<br><br><font face=/font/big_bold.font>Važiuok į žiedą.</font>"

	key[]: "aca_msg_book1_3_03_check3"
	val[]: "Šis 90 laipsnių posūkis šiek tiek siauresnis, atsargiai, nepaliesk kūgių.<br><br><font face=/font/big_bold.font>Važiuok posūkiu.</font>"

	key[]: "aca_msg_book1_3_03_check4"
	val[]: "Šį posūkį geriausia įveikti ąsočio rankenos procedūra. Prieš sankryžą užsimok plačiai.<br><br><font face=/font/big_bold.font>Įveik ąsočio rankenos posūkį. </font>"

	key[]: "aca_msg_book1_3_03_check5"
	val[]: "Šiam posūkyje yra kitų kliūčių, bet jį galima įveikti sagos kablio manevru.<br><br><font face=/font/big_bold.font>Važiuok atsargiai.</font>"

	key[]: "aca_msg_book1_3_03_check6"
	val[]: "Šis posūkis siauriausias iki šiol, įveik jį taip, kaip manai tinkama.<br><br><font face=/font/big_bold.font>Pasuk į aikštelę.</font>"
#!{
