	#### diag common

	key[]: "aca_scenario_book3_diag_title"
	val[]: "Įstrižas parkavimas su B-dvigubais"

	key[]: "aca_scenario_book3_diag_desc"
	val[]: "Šiame scenarijuje reikės pastatyti B-dvigubas priekabas įstrižai. "

#### diag msg - intro text

	key[]: "aca_msg_book3_diag_cutscene1"
	val[]: "Tokios įstrižos stovėjimo vietos labai dažnos. Jos ypatingai dažnos senesnėse stovėjimo aikštelėse, taip pat daugumo poilsio aikštelių Amerikos keliuose."

	key[]: "aca_msg_book3_diag_cutscene2"
	val[]: "Važiuok link nurodytos stovėjimo vietos eilės pabaigoje."

	key[]: "aca_msg_book3_diag_cutscene3"
	val[]: "Lik juostos išorėje, bet ne per arti barjerų, nes priekabos galas gali paliesti juos įsukant."

	key[]: "aca_msg_book3_diag_cutscene4"
	val[]: "Pravažiuok pro stovėjimo vietą, kad atsirastų vietos abiem priekaboms. Tada nerk į tolimąją vietos pusę, kad pirmąją priekabą pastatytumėte į vietą."

	key[]: "aca_msg_book3_diag_cutscene5"
	val[]: "Ištiesink, sustok nurodytoje vietoje ir išjunk sunkvežimį."

#### diag Driving Instructions

#!{
	key[]: "aca_msg_book3_diag_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_diag_forward"
	val[]: "Važiuok link eilės pabaigos ir rask savo stovėjimo vietą."

	key[]: "aca_msg_book3_diag_check1"
	val[]: "Pravažiuok pro stovėjimo vietą, kad įsitikintum, jog galinė priekaba tinkamai įvažiuoja į ją, tada staigiai pasukite, bet atsargiai, kad priekinė priekaba neliestų šalia esančio sunkvežimio."

	key[]: "aca_msg_book3_diag_stop"
	val[]: "Lėtai tęsk ir ištiesink junginį, tada sustok nurodytoje vietoje."

