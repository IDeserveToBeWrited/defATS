#### 3_01 msg - intro text

	key[]: "aca_msg_book1_3_01_cutscene1"
	val[]: "Šiame scenarijuje pirmą kartą pabandysime prikabinti ir atkabinti priekabą. Paruošk sunkvežimį važiavimui, ir tada atbulai privažiuok prie priekabos už tavęs."

	key[]: "aca_msg_book1_3_01_cutscene2"
	val[]: "Prikabink priekabą ir pavažiuok pirmyn."

	key[]: "aca_msg_book1_3_01_cutscene3"
	val[]: "Sustok nurodytoje vietoje."

	key[]: "aca_msg_book1_3_01_cutscene4"
	val[]: "Atkabink priekabą ir pavažiuok pirmyn."

	key[]: "aca_msg_book1_3_01_cutscene5"
	val[]: "Sustok stovėjimo vietoje ir išjunk variklį."


#### 3_01 Driving Instructions

	key[]: "aca_msg_book1_3_01_start"
	val[]: "Šiame scenarijuje aptarsime, kaip prie vilkiko prikabinti priekabą. Palyginus su realiu gyvenimu, ši procedūra supaprastinta.<br><br><font face=/font/big_bold.font>Pasiruošk važiuoti.</font>"

	key[]: "aca_msg_book1_3_01_check_con"
	val[]: "Už vilkiko stovi priekaba. Lėtai atbulai privažiuok po priekaba, kol vilkiko balnas palies priekabos prikabinimo piršto. Dabar sunkvežimis stovi tiesiai, todėl vairuoti nereikia, tiesiog važiuok atbulai tiesiai.<br><br><font face=/font/big_bold.font>Lėtai važiuok atbul, kol pajausi prikabinimą. </font>"

	key[]: "aca_msg_book1_3_01_park_br_on"
	val[]: "Vilkiko balnas susikabino su priekaba.<br><br><font face=/font/big_bold.font>Įtvirtink sunkvežimį ir įjunk stovėjimo stabdį. </font>"

	key[]: "aca_msg_book1_3_01_connect"
	val[]: "Tikrame gyvenime balnas automatiškai užrakina pirštą, po to vairuotojas turi išlipti iš vilkiko ir pakelti priekabos atramą bei prijungti oro žarnas ir elektros kabelius. <br><br><font face=/font/big_bold.font>Mums užteks paspausti @@imv_nrm_attach@@ kad viskas prisijungtų. </font>"

	key[]: "aca_msg_book1_3_01_park_br_off"
	val[]: "Dabar, kai priekaba tvirtai prikabinta prie vilkiko, galima judėti. Atmink, kad tavo sunkvežimis dabar gerokai ilgesnis bei sunkesnis, ir jam valdyti reikės kitokių įgūdžių.<br><br><font face=/font/big_bold.font>Išjunk stovėjimo stabdį ir pasiruošk važiuoti pirmyn.</font>"

	key[]: "aca_msg_book1_3_01_check_discon"
	val[]: "Važiuok pirmyn.<br><br><font face=/font/big_bold.font>Sustok pažymėtoje zonoje priekyje. </font>"

	key[]: "aca_msg_book1_3_01_parking_brake5"
	val[]: "<font face=/font/big_bold.font>Įjunk stovėjimo stabdį. </font>"

	key[]: "aca_msg_book1_3_01_stop5"
	val[]: "<font face=/font/big_bold.font>Įjunk stovėjimo stabdį. </font>"

	key[]: "aca_msg_book1_3_01_disc5"
	val[]: "Tikrame gyvenime vairuotojas vėl turėtų išlipti iš sunkvežimio, nuleisti priekabos atramą, atjungti oro žarnas ir elektros kabelius bei atrakinti vilkiko balną. <br><br><font face=/font/big_bold.font>Čia šis procesas paprastesnis, todėl paspausdus @@imv_nrm_attach@@ priekaba bus atkabinta. </font>"

	key[]: "aca_msg_book1_3_01_park_br_off2"
	val[]: "<font face=/font/big_bold.font>Išjunk stovėjimo stabdį. </font>"

	key[]: "aca_msg_book1_3_01_park_br_off3"
	val[]: "Išvažiuok vilkiku iš po priekabos ir važiuok pirmyn.<br><br><font face=/font/big_bold.font>Sustok pažymėtoje vietoje.</font>"

	key[]: "aca_msg_book1_3_01_stop"
	val[]: "<font face=/font/big_bold.font>Sustok nurodytoje vietoje.</font>"
#!{
	key[]: "aca_msg_book1_3_01_end"
	val[]: "@@aca_msg_book1_2_01_end@@"


#!}

#@}

