	key[]: "aca_msg_book3_parallel_cutscene1"
	val[]: "Važiuok už kampo ir į greitkelį. Ten rasite sau skirtą laisvą vietą."

	key[]: "aca_msg_book3_parallel_cutscene2"
	val[]: "Įvažiuok į stovėjimo vietą ir pravažiuok pro ją; tai padės priekaboms priartėti prie reikiamos vietos."

	key[]: "aca_msg_book3_parallel_cutscene3"
	val[]: "Važiuok toliau stovėjimo vietos ir į priekį pakankamai, kad turėtum vietos manevruoti."

	key[]: "aca_msg_book3_parallel_cutscene4"
	val[]: "Naudojant priekinę priekabą vairavimui, įstumk galinę priekabą į reikiamą vietą. Reikės iš anksto suplanuoti, kad kiekviena priekaba atsidurtų ten, kur nori."

	key[]: "aca_msg_book3_parallel_cutscene5"
	val[]: "Gali tekti kelis kartus pavažiuoti pirmyn ir atgal, kad viskas būtų ten, kur nori."

	key[]: "aca_msg_book3_parallel_cutscene6"
	val[]: "Kai įsitikinsi kad stovi lygiai su kelio kraštu, pastatyk junginį stovėjimo vietos centre ir išjunk sunkvežimį."

