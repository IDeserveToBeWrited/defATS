#+ Chapters general
#@{
	key[]: "aca_chapter_book1_1_title"
	val[]: "Pagrindinis valdymas ir judėjimas"

	key[]: "aca_chapter_book1_1_desc"
	val[]: "Išmok sunkvežimio valdymą, kaip važiuoti pirmyn ir atgal."

	key[]: "aca_chapter_book1_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Sveikiname!<br>Įveikei Pirmą skyrių: @@aca_chapter_book1_1_title@@.<br><br>Išmokai, kaip paruošti sunkvežimį prieš važiuojant,<br>važiuoti pirmyn ir atgal, kaip valdyti šviesas ir valytuvus.</font><br><br>"

	key[]: "aca_chapter_book1_2_title"
	val[]: "Pagrindiniai manevrai"

	key[]: "aca_chapter_book1_2_desc"
	val[]: "Išmok vairuoti, manevruoti ir parkuoti sunkvežimį be priekabos. Išnagrinėk kiekvieno veidrodžio tikslą ir kaip jais naudotis."

	key[]: "aca_chapter_book1_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Sveikiname!<br>Įveikei Antrą skyrių: @@aca_chapter_book1_2_title@@.<br><br>Išmokai naudotis sunkvežimio veidrodėliais, patikrinti erdvę aplink sunkvežimį prieš pajudant, atlikti pagrindinius ir sudėtingesnius manevrus.</font>"

	key[]: "aca_chapter_book1_3_title"
	val[]: "Manevravimas su priekaba"

	key[]: "aca_chapter_book1_3_desc"
	val[]: "Išmok prikabinti ir manevruoti su priekaba įvairiose situacijose."

	key[]: "aca_chapter_book1_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Sveikiname!<br>Įveikei Trečią skyrių: @@aca_chapter_book1_3_title@@.<br><br>Išmokai prikabinti ir atkabinti priekabą,<br>jausti sunkvežimio su priekaba svorį ir matmenis<br>ir vairuoti su priekaba sudėtingose trasose.</font><br><br>"

	key[]: "aca_chapter_book1_4_title"
	val[]: "Važiavimas atbulai su priekaba"

	key[]: "aca_chapter_book1_4_desc"
	val[]: "Išmok naujų manevrų kad efektyviai važiuotum atbulai ir parkuotum su priekaba."

	key[]: "aca_chapter_book1_4_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Sveikiname!<br>Įveiki Ketvirtą skyrių: @@aca_chapter_book1_4_title@@.<br><br>Išmokai važiuoti atbulai su priekaba<br>ir įvairių parkavimo metodų.</font><br><br>"

	key[]: "aca_chapter_book1_5_title"
	val[]: "Baigiamasis egzaminas"

	key[]: "aca_chapter_book1_5_desc"
	val[]: "Parodyk savo žinias ir įgūdžius ir įrodyk, kad gali valdyti sunkvežimį!"

	key[]: "aca_chapter_book1_5_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><br><font face=/font/big.font>Sveikiname!<br>Įveikei Penktą skyrių: @@aca_chapter_book1_5_title@@.<br><br>Įrodei, kad turi visus įgūdžius, būtinus<br>vairuoti, manevruoti ir parkuoti sunkvežimį!</font><br><br>"

	key[]: "aca_chapter_book2_0_title"
	val[]: "Variklio pašildymas"

	key[]: "aca_chapter_book2_0_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Užbaigei mokymą: @@aca_chapter_book2_0_title@@.<br><br>Išmokai Vairavimo Įgūdžių taisykles ir ypatybes.</font><br><br>"

	key[]: "aca_chapter_book2_1_title"
	val[]: "Vėl su pavara"

	key[]: "aca_chapter_book2_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Sveikiname!<br>Užbaigei 2 Skyrių:@@aca_chapter_book2_1_title@@.<br><br>Pašildei variklį, patikrinai pavaras, prasukai ratus ir patikrinai stabdžius. Kiti skyriai bus sudėtingesni.</font><br><br>"

	key[]: "aca_chapter_book2_2_title"
	val[]: "Besisukantys ratai"

	key[]: "aca_chapter_book2_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Sveoikiname!<br>Užbaigei 3 skyrių: @@aca_chapter_book2_2_title@@.<br><br>Įvaldei sudėtingus ir įvairius scenarijus. Pademonstravai įgūdžius ir našumą.</font><br><br>"

	key[]: "aca_chapter_book2_3_title"
	val[]: "Finišo tiesioji"

	key[]: "aca_chapter_book2_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Sveikiname!<br>Užbaigei 4 skyrių: @@aca_chapter_book2_3_title@@.<br><br>Įveikei daug sudėtingų situacijų manevruojant, parkuojant ir važiuojant atbulai su priekaba. Įrodei, kad tavo vairavimo įgūdžiai labai geri, ir gali susitvarkyti su sudėtingomis padėtimis."

	key[]: "aca_chapter_book3_1_title"
	val[]: "Važiavimas pirmyn"

	key[]: "aca_chapter_book3_1_desc"
	val[]: "Išmok visus svarbiausius B-dvigubų priekabų valdymo būdus važiuojant į priekį."

	key[]: "aca_chapter_book3_1_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Sveikiname!<br>Įveikei 1 skyrių: @@aca_chapter_book3_1_title@@.<br><br>Supratai, ką reiškia efektyviai vairuoti ir manevruoti su B-dvigubomis priekabomis.</font><br><br>"

	key[]: "aca_chapter_book3_2_title"
	val[]: "Valdymas atbulai"

	key[]: "aca_chapter_book3_2_desc"
	val[]: "Suprask būtinus veiksmus manevruojant su B-dvigubomis priekabomis važiuojant atbuline eiga."

	key[]: "aca_chapter_book3_2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Sveikiname!<br>Įveikei 2 skyrių: @@aca_chapter_book3_2_title@@.<br><br>Išmokai gasdinančio įgūdžio: manevruoti su B-dvigubomis priekabomis atbulai.</font><br><br>"

	key[]: "aca_chapter_book3_3_title"
	val[]: "Pasiruošimas tikram pasauliui"

	key[]: "aca_chapter_book3_3_desc"
	val[]: "Pritaikyk savo naujas žinias sudėtingesniuose scenarijuose."

	key[]: "aca_chapter_book3_3_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Sveikiname!<br>Įveikei 3 skyrių: @@aca_chapter_book3_3_title@@.<br><br>Susidorojai su įvairiomis sudėtingomis situacijomis manevruojant, parkuojant ir atbulai važiuojant su B-dvigubomis priekabomis. Įrodei savo gabumus, dabar laikas tempti B-dvigubas priekabas American Truck Simulator keliuose!</font><br><br>"

#@}

