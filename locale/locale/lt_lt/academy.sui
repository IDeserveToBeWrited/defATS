#### 3_02 msg - intro text

	key[]: "aca_msg_book1_3_02_cutscene01"
	val[]: "Šiame scenarijuje truputį pavažiuosime. Galėsi pajausti stabdymą su priekaba kai leisimės nuo nedidelio kalno. Paruošk sunkvežimį ir pajudėk."

	key[]: "aca_msg_book1_3_02_cutscene06"
	val[]: "Pasiek bent 60 km/h (37 mylių/h) greitį. Pasiruošk stabdymo zonai priekyje."

	key[]: "aca_msg_book1_3_02_cutscene08"
	val[]: "Pradėk stabdyti. Nelauk per ilgai, nes gali atsitrenkti į barjerus priekyje!"

	key[]: "aca_msg_book1_3_02_cutscene10"
	val[]: "Sustok pažymėtoje vietoje, įjunk stovėjimo stabdį ir išjunk variklį."


#### 3_02 Driving Instructions

	key[]: "aca_msg_book1_3_02_start"
	val[]: "Šioje užduotyje pabandysi naudoti darbiniuis stabdžius leidžiantis nuo kalno. Tikslas - įvertinti svorį už tavęs ir kaip jis paveikia sunkvežimio stabdymo distanciją.<br><br><font face=/font/big_bold.font>Pasiruošk važiuoti.</font>"

	key[]: "aca_msg_book1_3_02_forward"
	val[]: "Pradėk važiuoti ir atmink kad turi pasiekti 60 km/h (37 mylių/h) greitį <font face=/font/big_bold.font>po</font> posūkio priekyje.<br><br><font face=/font/big_bold.font>Važiuok link posūkio priekyje.</font>"

	key[]: "aca_msg_book1_3_02_check1"
	val[]: "Įveik dešinį posūkį ir įsibėgėk iki 60 km/h (37 mylių/h).<br><br><font face=/font/big_bold.font>Važiuok toliau.</font>"

	key[]: "aca_msg_book1_3_02_check2"
	val[]: "<font face=/font/big_bold.font>Pasiek bent 60 km/h (37 mylių/h) greitį. </font>"

	key[]: "aca_msg_book1_3_02_check3"
	val[]: "Pasiekei reikalingą greitį.<br><br><font face=/font/big_bold.font>Sustok iki barjerų priekyje.</font>"
#!{
	key[]: "aca_msg_book1_3_02_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_02_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

