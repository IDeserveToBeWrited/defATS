	key[]: "aca_msg_book1_2_05_cutscene1"
	val[]: "Šiame scenarijuje atbulai pastatysime sunkvežimį prie šaligatvio."

	key[]: "aca_msg_book1_2_05_cutscene2"
	val[]: "Važiuok atbulai prie šaligatvio.<br>Važiuodamas atbulai turi stebėti aplinką, todėl naudok veidrodėlius."

	key[]: "aca_msg_book1_2_05_cutscene3"
	val[]: "Kai priartėsi pradėk išlyginti sunkvežimį pagal stovėjimo vietą. Stebėk abi sunkvežimio puses."

	key[]: "aca_msg_book1_2_05_cutscene4"
	val[]: "Sustok stovėjimo vietoje ir išjunk variklį."

#### 2_05 Driving Instructions

	key[]: "aca_msg_book1_2_05_start"
	val[]: "Stovėjimo vieta yra už tavęs, keleivio pusėje. Naudok veidrodėlius važiuojant link vietos.<br><br><font face=/font/big_bold.font>Pasiruošk važiuoti.</font>"

	key[]: "aca_msg_book1_2_05_backward"
	val[]: "Atmink naudoti veidrodėlius tikrinant aplinką prieš pajudant.<br><br><font face=/font/big_bold.font>Pradėk važiuoti atbulai link šaligatvio.</font>"

	key[]: "aca_msg_book1_2_05_stop"
	val[]: "Toliau stebėk aplinką atbulai judant link stovėjimo vietos.<br><br><font face=/font/big_bold.font>Sustok nurodytoje vietoje.</font>"
