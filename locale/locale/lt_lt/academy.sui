	key[]: "aca_msg_book3_correcting_90_cutscene4"
	val[]: "Nuo čia gali vairuoti galinę priekabą į vietą su priekine priekaba. Bandyk palaikyti vientisą posūkį visu junginiu."

	key[]: "aca_msg_book3_correcting_90_cutscene5"
