	key[]: "aca_goal_book1_3_15_check6"
	val[]: "@@aca_goal_book1_3_11_check6@@"

	key[]: "aca_goal_book1_3_15_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_15_end"
	val[]: "@@aca_goal_book1_2_01_end@@"


 #!}
	key[]: "aca_goal_book1_3_15_check1"
	val[]: "Ąsočio rankenos posūkis"

	key[]: "aca_goal_book1_3_15_check2"
	val[]: "Posūkis ir tiesi dalis"

	key[]: "aca_goal_book1_3_15_check3"
	val[]: "Sagos kablio posūkis"

	key[]: "aca_goal_book1_3_15_check4"
	val[]: "Tiesi dalis ir posūkis"

	key[]: "aca_goal_book1_3_15_check5"
	val[]: "Jungtinis posūkis"



#### 3_15 msg - intro text

	key[]: "aca_msg_book1_3_15_cutscene01"
	val[]: "Priekyje yra staigūs posūkiai su nedaug vietos.<br>Tai padės išmokti tau efektyviai manevruoti priekaba,."

	key[]: "aca_msg_book1_3_15_cutscene02"
	val[]: "@@aca_msg_book1_3_15_cutscene02_img@@<br>Pirmame posūkyje reikia atlikti ąsočio rankenos manevrą. Taip vadinami posūkiai, kai yra ribota vieta kelyje, į kurį reikia pasukti, ir todėl reikia panaudoti papildomą vietą kelyje, kuriame esi dabar."

	key[]: "aca_msg_book1_3_15_cutscene03"
	val[]: "Laikykis kelio žymėjimų ir vilkiku užsimok plačiai, toli nuo vidinio kampo.<br>Taip priekaba bus patraukta toli nuo kelio krašto, ir bus pakankamai vietos manevrui."

	key[]: "aca_msg_book1_3_15_cutscene04"
	val[]: "Laikykis arti kliūties išvažiuojant iš posūkio, kad priekaba galėtų važiuoti kuo platesniu lanku."

	key[]: "aca_msg_book1_3_15_cutscene05"
	val[]: "Ilgo posūkio pradžioje vilkikas turi būti arčiau kelio vidurio, kad priekabos ratai nenuvažiuotų nuo kelio."

	key[]: "aca_msg_book1_3_15_cutscene06"
	val[]: "Toliau važiuok keliu."

	key[]: "aca_msg_book1_3_15_cutscene07"
	val[]: "@@aca_msg_book1_3_15_cutscene07_img@@<br>Kitame posūkyje reikia panaudoti sagos kablio manevrą. Šis metodas labiau pageidaujamas, nes šiuo atveju pasukant neatsiveria juosta dešinėje, į kurią gali įvažiuoti neatidus vairuotojas. Visada naudok jį kai kelyje, į kurį suki, yra pakankamai vietos."

	key[]: "aca_msg_book1_3_15_cutscene08"
	val[]: "Įvažiuok giliai į sankryžą ir staigiai suk dešinėn."

	key[]: "aca_msg_book1_3_15_cutscene09"
	val[]: "Artėdamas prie kliūties gali išsitiesinti ir vėl laikytis kairėje juostos pusėje.<br>Visa tai padės priekabos ratams nenuvažiuoti nuo kelio."

	key[]: "aca_msg_book1_3_15_cutscene10"
	val[]: "Važiuok link kito posūkio."

	key[]: "aca_msg_book1_3_15_cutscene11"
	val[]: "Ir vėl laikykis kelio viduryje, kad priekaba nenuvažiuotų nuo kelio."

	key[]: "aca_msg_book1_3_15_cutscene12"
	val[]: "Posūkis priekyje ypatingai sudėtingas. Tokiais atvejais netinkamas nei ąsočio rankenai, nei sagos kabliui, todėl reikia sujungti abu manevrus."

	key[]: "aca_msg_book1_3_15_cutscene13"
	val[]: "Plačiai užsimok prieš posūkį, įvažiuok giliai į sankryžą ir staigiai pasuk. Kaip ir praeitą kartą, stenkis laikytis kuo arčiau kliūties, kad posūkis būtų kuo platesnis."

	key[]: "aca_msg_book1_3_15_cutscene14"
	val[]: "Sustok pažymėtoje vietoje, įjunk stovėjimo stabdį ir išjunk variklį."

	# Book 1 Scenario 3_15 formatting
#!{
	key[]: "aca_msg_book1_3_15_cutscene02_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/jug_handle.mat bottom=p256 right=p256 color=FFFFFFFF></align><offset vshift=256>"

	key[]: "aca_msg_book1_3_15_cutscene07_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/button_hook.mat bottom=p256 right=p256 color=FFFFFFFF></align><offset vshift=256>"

#!}


#### 3_15 Driving Instructions

	key[]: "aca_msg_book1_3_15_forward"
	val[]: "Atmink išnaudoti visą erdvę kiekviename posūkyje.<br><br><font face=/font/big_bold.font>Pajudėk ir laikykis kelio žymėjimų.</font>"

	key[]: "aca_msg_book1_3_15_check1"
	val[]: "Išnaudok visą vietą plačiai užsimoti, kad priekaba liktų kuo toliau nuo kelio krašto.<br><br><font face=/font/big_bold.font>Atlik ąsočio rankenos posūkį.</font>"

	key[]: "aca_msg_book1_3_15_check2"
	val[]: "Posūkyje laikykis kelio viduryje, po to važiuok tiesiai link kito posūkio.<br><br><font face=/font/big_bold.font>Važiuok toliau.</font>"

	key[]: "aca_msg_book1_3_15_check3"
	val[]: "Kairėje vietos nedaug, todėl turi kuo giliau įvažiuoti į sankryžą.<br><br><font face=/font/big_bold.font>Atlik sagos kablio posūkį.</font>"

	key[]: "aca_msg_book1_3_15_check4"
	val[]: "Važiuok toliau į kitą posūkį.<br><br><font face=/font/big_bold.font>Važiuok toliau.</font>"

	key[]: "aca_msg_book1_3_15_check5"
	val[]: "Šis posūkis staigiausias iki šiol, ir nei vieno manevro atskirai nepakaks.<br><br><font face=/font/big_bold.font>Atlik posūkį kuo plačiau.</font>"

	key[]: "aca_msg_book1_3_15_check6"
	val[]: "<font face=/font/big_bold.font>Važiuok į stovėjimo vietą priekyje dešinėje.</font>"
#!{
	key[]: "aca_msg_book1_3_15_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_15_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_15_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}


#@}

#+ Book 1 Scenario 3_16
#@{

#### 3_16 common
	key[]: "aca_scenario_book1_3_16_title"
	val[]: "Įstrižas parkavimas atbulai"

	key[]: "aca_scenario_book1_3_16_desc"
	val[]: "Šiame scenarijuje nagrinėsime įstrižą parkavimą atbulai. To prireikti poilsio aikštelėse ar net kompanijose. Dažnai vietos būna mažai dėl kitų sunkvežimių, todėl parkuoti bus dar sunkiau dėl erdvės stokos."

#### 3_16 goal

	key[]: "aca_goal_book1_3_16_check1"
	val[]: "Priekabos pasukimas"
#!{
	key[]: "aca_goal_book1_3_16_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_16_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_16_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_16_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
 #!}
#### 3_16 msg - intro text

	key[]: "aca_msg_book1_3_16_cutscene1"
	val[]: "Įstrižas parkavimas iš pirmo žvilgsnio atrodo paprastesnis, bet dažnai jis gali būti sudėtingesni už įprastus manevrus."

	key[]: "aca_msg_book1_3_16_cutscene2"
	val[]: "Važiuok atbulai link parkavimo vietos. Kol kas važiuok tiesiai."

	key[]: "aca_msg_book1_3_16_cutscene3"
	val[]: "Kai priartėsi, tegu priekaba artėja prie stovinčių sunkvežimių. Tai padės įsukti į vietą, kai ją pasieksi."

	key[]: "aca_msg_book1_3_16_cutscene4"
	val[]: "Pradėk sukti priekabą į parkavimo vietą. Laikyk priekabą arti sunkvežimio vairuotojo pusėje, nes prireiks vietos kitoje pusėje."

	key[]: "aca_msg_book1_3_16_cutscene5"
	val[]: "Kai priekaba nemažai įvažiuos į stovėjimo vietą, pradėk sukti vilkiką."

	key[]: "aca_msg_book1_3_16_cutscene6"
	val[]: "Sustok pažymėtoje vietoje, įjunk stovėjimo stabdį ir išjunk variklį."

#### 3_16 Driving Instructions

	key[]: "aca_msg_book1_3_16_start"
	val[]: "Pastatyk vilkiką vietoje už tavęs. Naudok abu veidrodėlius stebint kelią.<br><br><font face=/font/big_bold.font>Pasiruošk važiuoti.</font>"

	key[]: "aca_msg_book1_3_16_backward"
	val[]: "Patikrink aplinką ir judėk link stovėjimo vietos.<br><br><font face=/font/big_bold.font>Pradėk važiuoti atbulai.</font>"

	key[]: "aca_msg_book1_3_16_check1"
	val[]: "Pradėk sukti priekabą link sunkvežimių greta. Kai pasiruoši, suk priekabą į stovėjimo vietą. Nepamiršk įvertinti priekabos galo mosto.<br><br><font face=/font/big_bold.font>Suk į stovėjimo vietą.</font>"
#!{
	key[]: "aca_msg_book1_3_16_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_16_end"
	val[]: "@@aca_msg_book1_2_01_end@@"


 #!}


#@}

#+ Book 1 Scenario 3_17
#@{

#### 3_17 common
	key[]: "aca_scenario_book1_3_17_title"
	val[]: "Važiavimas atbulai į posūkį"

	key[]: "aca_scenario_book1_3_17_desc"
	val[]: "Šiame scenarijuje pirmą kartą atbulai važiuosime į posūkį. Panagrinėsime važiavimo atbulai principus ir ką reikia stebėti važiuojant atbulai."

#### 3_17 goal

	key[]: "aca_goal_book1_3_17_check1"
	val[]: "Priekabos pasukimas"
#!{
	key[]: "aca_goal_book1_3_17_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_17_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_17_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_17_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
 #!}
#### 3_17 msg - intro text

	key[]: "aca_msg_book1_3_17_cutscene01"
	val[]: "Šiame scenarijuje turėsi atbulai nuvažiuoti į stovėjimo vietą už tavęs, vairuotojo pusėje."

	key[]: "aca_msg_book1_3_17_cutscene02"
	val[]: "Keli patarimai važiuojant atbulai su priekabomis.<br>Pirma - priekaba visada suks priešinga kryptimi, nei suksi vilkiką."

	key[]: "aca_msg_book1_3_17_cutscene03"
	val[]: "Antra - gali gerai pajausti, kur važiuoja priekaba stebint vilkiko ir priekabos ašis."

	key[]: "aca_msg_book1_3_17_cutscene04"
	val[]: "Trečia - nedidelės korekcijos vairu viską pasieks, nereiki jo sukti per daug."

	key[]: "aca_msg_book1_3_17_cutscene05"
	val[]: "Pradėk šiek tiek sukti vilkiką nuo stovėjimo vietos, ir priekaba pasuks į ją."

	key[]: "aca_msg_book1_3_17_cutscene06"
	val[]: "Sek priekabą, koreguodamas vairu, kad ji liktų teisingame kelyje."

	key[]: "aca_msg_book1_3_17_cutscene07"
	val[]: "Stebėk priekabos ratus ir viliko galinius ratus. Jie pasakys tau, kur krypsta priekaba ir kur vilkikas ją stumia."

	key[]: "aca_msg_book1_3_17_cutscene08"
	val[]: "Ketvirtas patarimas - visuomet lengviau pasukti priekabą staigiau, nei išsitiesinti iš \"susiskersavimo\". Taikykis į išorinę vietos dalį kol priartėsi, o tada galėsi pasukti staigiau."

	key[]: "aca_msg_book1_3_17_cutscene09"
	val[]: "Priekabai įvažiuojant į stovėjimo vietą vilkiką pastatyk prieš priekabą. Stenkis per daug nemanevruoti pačioje stovėjimo vietoje."

	key[]: "aca_msg_book1_3_17_cutscene10"
	val[]: "Važiuk atbulai tarp barjerų, nuolat stebėdamas abi puses."

	key[]: "aca_msg_book1_3_17_cutscene11"
	val[]: "Įjunk stovėjimo stabdį ir išjunk variklį."

#### 3_17 Driving Instructions

	key[]: "aca_msg_book1_3_17_start"
	val[]: "Atmink šiuos patarimus sukdamas atbulai su priekaba:<br><br>— Priekaba suka į kitą pusę, nei suki vilkiką<br><br>— Stebėk priekabos ratus norint suprasti, kur ji krypsta<br><br>— Stebėk vilkiko galinius ratus norint suprasti, kur jis stumia priekabą<br><br>— Leisk priekabai viską daryti pačiai, nevairuok per daug<br><br>— Visuomet lengviau staigiau pasukti priekabą, nei ją ištiesinti<br><br><font face=/font/big_bold.font>Pasiruošk važiuoti. </font>"

	key[]: "aca_msg_book1_3_17_backward"
	val[]: "Žiūrėk už savęs, kur reikia važiuoti. Visuomet patikrink aplinką prieš pajudėdamas.<br><br><font face=/font/big_bold.font> Pradėk atbulai važiuoti link stovėjimo vietos.</font>"

	key[]: "aca_msg_book1_3_17_check1"
	val[]: "<font face=/font/big_bold.font>Pradėk sukti priekabą link stovėjimo vietos ir sek ją.</font>"

	key[]: "aca_msg_book1_3_17_stop"
	val[]: "<font face=/font/big_bold.font>Sustok nurodytoje vietoje. </font>"
#!{
	key[]: "aca_msg_book1_3_17_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_18
#@{

#### 3_18 common
	key[]: "aca_scenario_book1_3_18_title"
	val[]: "Manevras kampu"

	key[]: "aca_scenario_book1_3_18_desc"
	val[]: "Šiame scenarijuje turėsi atbulai pastatyti priekabą į skersgatvį."

#### 3_18 goal

	key[]: "aca_goal_book1_3_18_check1"
	val[]: "Priekabos pasukimas"
#!{
	key[]: "aca_goal_book1_3_18_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_18_backward"
