#### 2_06 msg - intro text

	key[]: "aca_msg_book1_2_06_cutscene01"
	val[]: "Paskutiniame šio skyriaus scenarijuje važiuosime sudėtinga trasa."

	key[]: "aca_msg_book1_2_06_cutscene02"
	val[]: "Pirma kliūtis yra slalomas tarp barjerų. Važiuok juo ir nepamiršk veidrodėlių."

	key[]: "aca_msg_book1_2_06_cutscene04"
	val[]: "Toliau - staigus apsisukimas. Važiuok plačiai, tada viskas turėtų pavykti."

	key[]: "aca_msg_book1_2_06_cutscene05"
	val[]: "Kelias priekyje smarkiai siaurėja. Važiuok atsargiai, naudok šoninius veidrodėlius."

	key[]: "aca_msg_book1_2_06_cutscene06"
	val[]: "Toliau bus lengvi 90 laipsnių posūkiai."

	key[]: "aca_msg_book1_2_06_cutscene08"
	val[]: "Kitą dalį reikia įveikti atbulai. Privažiuok prie barjerų priekyje tai atmindamas."

	key[]: "aca_msg_book1_2_06_cutscene09"
	val[]: "Sek kelio žymėjimu posūkiuose."

	key[]: "aca_msg_book1_2_06_cutscene10"
	val[]: "Atbulai važiuok iki barjerų, tada sustok ir važiuok į priekį dešinėn."

	key[]: "aca_msg_book1_2_06_cutscene11"
	val[]: "Šis pravažiavimas tarp kūgių labai siauras. Važiuok lėtai ir naudok veidrodėlius."

	key[]: "aca_msg_book1_2_06_cutscene13"
	val[]: "Priekyje bus keli 90 laipsnių posūkiai."

	key[]: "aca_msg_book1_2_06_cutscene15"
	val[]: "Šioje pervažoje gali važiuoti traukiniai. Tokiu atveju sustok ir palauk. Po to pasuk dešinėn į keliuką."

	key[]: "aca_msg_book1_2_06_cutscene16"
	val[]: "Pasuk kairėn į kelią. Po posūkio gali labiau įsibėgėti."

	key[]: "aca_msg_book1_2_06_cutscene18"
	val[]: "Dar keli posūkiai į kairę mieste ir atvažiuosi!"

	key[]: "aca_msg_book1_2_06_cutscene19"
	val[]: "Priartėk prie barjerų priekyje ir pasiruošk sustoti stovėjimo vietoje dešinėje."

	key[]: "aca_msg_book1_2_06_cutscene20"
	val[]: "Pravažiuok brūkšninę liniją, sustok, išjunk variklį ir pasirūpink sunkvežimiu."

#### 2_06 Driving Instructions



	key[]: "aca_msg_book1_2_06_forward"
	val[]: "Priekyje yra slalomas iš barjero.<br><br><font face=/font/big_bold.font>Važiuok slalomu.</font>"

	key[]: "aca_msg_book1_2_06_forward2"
	val[]: "<font face=/font/big_bold.font>Laikykis kelio šiame staigiame posūkyje. </font>"

	key[]: "aca_msg_book1_2_06_check1"
	val[]: "Kelias priekyje smarkiai susiaurės. Stebėk šoninį veidrodėlį..<br><br><font face=/font/big_bold.font>Važiuok atsargiai. </font>"

	key[]: "aca_msg_book1_2_06_check2"
	val[]: "Vėliau bus 90 laipsnių posūkis.<br><br><font face=/font/big_bold.font>Pasirink tinkamą greitį.</font>"

	key[]: "aca_msg_book1_2_06_check3"
	val[]: "Priekyj laukia keli lengvesni posūkiai, ir toliau pasirink tinkamą greitį.<br><br><font face=/font/big_bold.font>Važiuok toliau.</font>"

	key[]: "aca_msg_book1_2_06_check4"
	val[]: "Šią dalį reikia įveikti atbulai. Sustok prie barjerų priekyje taip, kad galėtum iš karto važiuoti atbulai dešinėn.<br><br><font face=/font/big_bold.font>Sustok prie barjerų.</font>"

	key[]: "aca_msg_book1_2_06_check5"
	val[]: "Važiuok atbulai į vietą už tavęs dešinėje.<br><br><font face=/font/big_bold.font>Pajudėk atbulai.</font>"

	key[]: "aca_msg_book1_2_06_reverse"
	val[]: "Važiuok posūkiu.<br><br><font face=/font/big_bold.font>Toliau važiuok atbulai.</font>"

	key[]: "aca_msg_book1_2_06_check6"
	val[]: "Už tavęs kairėje yra barjerai.<br><br><font face=/font/big_bold.font>Pasuk link barjerų ir pasiruošk sustoti.</font>"

	key[]: "aca_msg_book1_2_06_check7"
	val[]: "Sustok, įjunk pavarą pirmyn, ir važiuok dešinėn.<br><br><font face=/font/big_bold.font>Važiuok pirmyn.</font>"

	key[]: "aca_msg_book1_2_06_check8"
	val[]: "Priekyje yra siauras, vingiuojantis kelias tarp kūgių. Važiuok atsargiai ir naudok veidrodėlius.<br><br><font face=/font/big_bold.font>Važiuok tarp kūgių.</font>"

	key[]: "aca_msg_book1_2_06_check9"
	val[]: "Tolaiu bus keli 90 laipsnių posūkiai. Atsargiai važiuok prie jų plačiai užsimodamas.<br><br><font face=/font/big_bold.font>Važiuok toliau.</font>"

	key[]: "aca_msg_book1_2_06_check10"
	val[]: "Artėdamas stebėk pervažą. Gali įsijungti signalai, pranešantys apie artėjantį traukinį.<br><br><font face=/font/big_bold.font>Važiuok atidžiai.</font>"

	key[]: "aca_msg_book1_2_06_check11"
	val[]: "Posūkis į keliuką dalinai užstotas kliūties, todėl artėdamas laikykis kairiau, kad turėtum daugiau vietos.<br><br><font face=/font/big_bold.font>Įveik posūkį.</font>"

	key[]: "aca_msg_book1_2_06_check12"
	val[]: "Gali pasirinkti, laikytis ar ignoruoti ženklą \"Stop\". Ši zona uždara, skirta tik mums.<br><br><font face=/font/big_bold.font>Pasuk kairėn.</font>"

	key[]: "aca_msg_book1_2_06_check13"
	val[]: "Čia gali įsibėgėti, bet kitoje sankryžoje reikės pasukti.<br><br><font face=/font/big_bold.font>Važiuok toliau trasa.</font>"

	key[]: "aca_msg_book1_2_06_check14"
	val[]: "Važiuok į miestą sukdamas kairėn, o po to dar du kartus kairėn į galutinę zoną.<br><br><font face=/font/big_bold.font>Važiuok miestu.</font>"

	key[]: "aca_msg_book1_2_06_check15"
	val[]: "Kitame aikštelės gale yra barjerai. Privažiuok prie jų.<br><br><font face=/font/big_bold.font>Sustok prie barjerų.</font>"

	key[]: "aca_msg_book1_2_06_check16"
	val[]: "Už tavęs dešinėje yra stovėjimo vieta.<br><br><font face=/font/big_bold.font>Atbulai įvažiuok į stovėjimo vietą.</font>"
#!{
	key[]: "aca_msg_book1_2_06_check17"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_06_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_2_06_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

#@}

