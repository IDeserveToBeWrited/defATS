#+ Book 1 Scenario 3_09
#@{

#### 3_09 common
	key[]: "aca_scenario_book1_3_09_title"
	val[]: "Įstrižas parkavimas"

	key[]: "aca_scenario_book1_3_09_desc"
	val[]: "Šiame scenarijuje parkuosime įstrižoje stovėjimo vietoje judrioje aikštelėje.<br><br>Čia nėra daug vietos manevrui, todėl reikia vairuoti tiksliai ir ryžtingai."

#### 3_09 goal

	key[]: "aca_goal_book1_3_09_check1"
	val[]: "Priartėjimas prie stovėjimo vietos"
#!{
	key[]: "aca_goal_book1_3_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_09_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_09_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
 #!}
#### 3_09 msg - intro text

	key[]: "aca_msg_book1_3_09_cutscene1"
	val[]: "Tokios įstrižos parkavimo vietos labai dažnos. Gali sutikti jas poilsio aikštelėse visoje Amerikoje.<br>Čia taip pat reikės įvažiuoti priekiu."

	key[]: "aca_msg_book1_3_09_cutscene2"
	val[]: "Važiuok link nurodytos stovėjimo vietos eilės pabaigoje."

	key[]: "aca_msg_book1_3_09_cutscene3"
	val[]: "Laikykis juostos viduryje arba šiek tiek kairiau. Reikia pasilikti vietos priekabos manevrui."

	key[]: "aca_msg_book1_3_09_cutscene4"
	val[]: "Nemažai pravažiuok stovėjimo vietą, tada greitai ir smarkiai suk į ją. Turėsi stebėti veidrodėlį dešinėje pusėje, kad priekaba saugiai įvažiuotų į stovėjimo vietą."

	key[]: "aca_msg_book1_3_09_cutscene5"
	val[]: "Sustok pažymėtoje vietoje, įjunk stovėjimo stabdį ir išjunk variklį."


#### 3_09 Driving Instructions

	key[]: "aca_msg_book1_3_09_start"
	val[]: "@@aca_msg_book1_3_09_start_img@@<br>Kai parkuoji įstrižai, svarbu tiksliai įvertinti savo poziciją. Pradėjus posūkį bus sunku saugiai pavažiuoti atgal ir pasitaisyti, todėl geriausia palikti pakankamai vietos pirmu bandymu.<br><br><font face=/font/big_bold.font>Pasiruošk važiuoti.</font>"

	key[]: "aca_msg_book1_3_09_forward"
	val[]: "<font face=/font/big_bold.font>Pradėk važiuoti link parkavimo vietos.</font>"

	key[]: "aca_msg_book1_3_09_check1"
	val[]: "Pravažiuok stovėjimo vietą, kad priekabai užtektų vietos apvažiuoti posūkio viduje stovintį sunkvežimį.<br><br><font face=/font/big_bold.font>Suk į stovėjimo vietą.</font>"
#!{
	key[]: "aca_msg_book1_3_09_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}

#@}

#+ Book 1 Scenario 3_10
#@{

#### 3_10 common
	key[]: "aca_scenario_book1_3_10_title"
	val[]: "Važiavimas atbulai akloje pusėje"

	key[]: "aca_scenario_book1_3_10_desc"
	val[]: "Šiame scenarijuje bandysime pastatyti sunkvežimį atbulai į stovėjimo vietą akloje pusėje. Negalint per langą pažiūrėti, kur važiuoji, teks pasikliauti tik veidrodėliais."

#### 3_10 goal
#!{
	key[]: "aca_goal_book1_3_10_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_10_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_10_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_10_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

 #!}
#### 3_10 msg - intro text

	key[]: "aca_msg_book1_3_10_cutscene1"
	val[]: "Šiame scenarijuje išmoksi atbulai manevruoti akloje pusėje. Tokių manevrų paprastai reiktų vengti, nebent nėra kito pasirinkimo, nes tokiu atveju matomumas gerokai ribojamas. Neskubėk, ir būk labai atidus."

	key[]: "aca_msg_book1_3_10_cutscene2"
	val[]: "Pravažiuok pro parkavimo vietą, kad turėtum pakankamai vietos važiuojant atbulai."

	key[]: "aca_msg_book1_3_10_cutscene3"
	val[]: "Sustok, apsidairyk ir pradėk važiuoti atbulai."

	key[]: "aca_msg_book1_3_10_cutscene4"
	val[]: "Pasuk vilkiką nuo stovėjimo vietos. Tai pastums priekabos priekį, o priekabos galą pasuks link norimos stovėjimo vietos. Atsargiai, nepersistenk, nes gali \"suskersuoti\" vilkiką su priekaba."

	key[]: "aca_msg_book1_3_10_cutscene5"
	val[]: "Kai priekaba įsuks į stovėjimo vietą pradėk tiesinti vilkiką."

	key[]: "aca_msg_book1_3_10_cutscene6"
	val[]: "Sustok nurodytoje vietoje ir išjunk sunkvežimį."

#### 3_10 Driving Instructions

	key[]: "aca_msg_book1_3_10_start"
	val[]: "Važiavimas atbulai akloje pusėje naudoja tuos pačius veiksmus, kaip vairuotojo pusėje, bet trukdo prastas matomumas toje pusuėje. Naudok veidrodėlius ir savo įgūdžius.<br><br><font face=/font/big_bold.font>Pasiruošk važiuoti.</font>"

	key[]: "aca_msg_book1_3_10_forward"
	val[]: "Dešinėje pusėje yra stovėjimo vieta. Reikia pro ją pravažiuoti, kad turėtum vietos manevrui atbulomis.<br><br><font face=/font/big_bold.font>Važiuok pirmyn.</font>"
#!{
	key[]: "aca_msg_book1_3_10_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
	key[]: "aca_msg_book1_3_10_check2"
	val[]: "Atmink sukti vilkiką į priešingą nuo stovėjimo vietos pusę, kad priekaba pasuktų į ją. Naudok veidrodėlius stebėti padėtį.<br><br><font face=/font/big_bold.font>Pradėk važiuoti atbulai.</font>"


#@}

#+ Book 1 Scenario 3_11
#@{

#### 3_11 common
	key[]: "aca_scenario_book1_3_11_title"
	val[]: "Važiavimas žiedu"

	key[]: "aca_scenario_book1_3_11_desc"
	val[]: "Šiame scenarijuje panagrinėsime važiavimą žiedine sankryža.<br><br>Turėsi kreipti papildomą dėmesį priekabai, nes ji važiuos paskui tave skirtingai įvažiuojant į žiedą, jame, ir išvažiuojant iš jo."

#### 3_11 goal
#!{
	key[]: "aca_goal_book1_3_11_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_11_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


