 #!}

	key[]: "aca_goal_book1_3_11_check1"
	val[]: "Įvažiavimas į žiedą"

	key[]: "aca_goal_book1_3_11_check2"
	val[]: "Važiavimas žiedu"

	key[]: "aca_goal_book1_3_11_check3"
	val[]: "Važiavimas žiedu"

	key[]: "aca_goal_book1_3_11_check5"
	val[]: "Išvažiavimas iš žiedo"

	key[]: "aca_goal_book1_3_11_check6"
	val[]: "Važiavimas į nurodytą vietą"

#### 3_11 msg - intro text

	key[]: "aca_msg_book1_3_11_cutscene1"
	val[]: "Amerikoje žiedinės sankryžos vis dažnėje, todėl svarbu išmokti važiuoti jose."

	key[]: "aca_msg_book1_3_11_cutscene3"
	val[]: "Artėjant prie žiedo laikykis savo juostos išorėje. Tai padės priekabai įveikti pradinį įsukimą."

	key[]: "aca_msg_book1_3_11_cutscene4"
	val[]: "Įvažiuodamas taikykis į žiedo centrą. Įvažiavus reikės pasukti link išorės. Taip priekaba nevažiuos link žiedo vidurio."

	key[]: "aca_msg_book1_3_11_cutscene5"
	val[]: "Stebėk veidrodėlį, kad priekaba neartėtų prie barjerų žiedo viduryje."

	key[]: "aca_msg_book1_3_11_cutscene6"
	val[]: "Išvažiavimas iš žiedo nėra sudėtingas, nes tavo priekaba jau yra toliau nuo išvažiavimo vidauss. Išvažiuok plačiau ir priekaba turėtų tinkamai sekti iš paskos."

	key[]: "aca_msg_book1_3_11_cutscene7"
	val[]: "Sustok nurodytoje vietoje ir išjunk sunkvežimį."



#### 3_11 Driving Instructions
#!{
	key[]: "aca_msg_book1_3_11_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

	key[]: "aca_msg_book1_3_11_forward"
	val[]: "Priekyje tavęs laukia paruošta žiedinė sankryža.<br><br><font face=/font/big_bold.font>Lėtai privažiuok prie žiedinės sankryžos.</font>"

	key[]: "aca_msg_book1_3_11_check1"
	val[]: "Plačiau įvažiuok į žiedą, kad sankryža niekur neužkliūtų.<br><br><font face=/font/big_bold.font>Įvažiuok į žiedą.</font>"

	key[]: "aca_msg_book1_3_11_check2"
	val[]: "Važiuok link žiedo išorės. Turėsi laikytis kuo toliau nuo žiedo centro, kad priekaba neužkliudytų barjerų viduryje.<br><br><font face=/font/big_bold.font>Važiuok žiedu.</font>"

	key[]: "aca_msg_book1_3_11_check3"
	val[]: "Laikykis arčiau išorinių kūgių.<br><br><font face=/font/big_bold.font>Važiuok toliau.</font>"

	key[]: "aca_msg_book1_3_11_check5"
	val[]: "<font face=/font/big_bold.font>Išvažiuok iš žiedo.</font>"

	key[]: "aca_msg_book1_3_11_check6"
	val[]: "<font face=/font/big_bold.font>Važiuok į stovėjimo vietą priekyje.</font>"

	key[]: "aca_msg_book1_3_11_stop"
	val[]: "<font face=/font/big_bold.font>Sustok nurodytoje vietoje. </font>"

	key[]: "aca_msg_book1_3_11_end"
	val[]: "<font face=/font/big_bold.font>Įjunk stovėjimo stabdį ir išjunk variklį. </font>"
#@}

#+ Book 1 Scenario 3_12
#@{

#### 3_12 common
	key[]: "aca_scenario_book1_3_12_title"
	val[]: "Manevravimas mažoje erdvėje"

	key[]: "aca_scenario_book1_3_12_desc"
	val[]: "Šiame scenarijuje turėsi apsukti sunkvežimį mažoje erdvėje, ir tam reikės daug dėmesio aplinkai ir protingai išnaudoti erdvę."

#### 3_12 goal



	key[]: "aca_goal_book1_3_12_check1"
	val[]: "Pasiruošimas važiavimui atbulai"

	key[]: "aca_goal_book1_3_12_check2"
	val[]: "Išvažiavimas"

	key[]: "aca_goal_book1_3_12_check3"
	val[]: "Atbulas važiavimas į vietą"

	key[]: "aca_goal_book1_3_12_check4"
	val[]: "Aklos pusės manevro užbaigimas"
