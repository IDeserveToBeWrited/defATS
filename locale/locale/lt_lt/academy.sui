#+ Book 1 Scenario 3_20
#@{

#### 3_20 common
	key[]: "aca_scenario_book1_3_20_title"
	val[]: "Baigiamasis egzaminas (2 dalis)"

	key[]: "aca_scenario_book1_3_20_desc"
	val[]: "Laukia paskutinė baigiamojo egzamino dalis, kurioje įvertinsime anksčiau išmoktus parkavimo manevrus. Parkuok atidžiai ir tiksliai, ir galėsi traukti į Amerikos kelius!"

#### 3_20 goal
#!{
	key[]: "aca_goal_book1_3_20_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_20_stop"
