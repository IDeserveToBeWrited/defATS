#+ Book 3 Scenario urf
#@{

#### urf common
	key[]: "aca_scenario_book3_urf_title"
	val[]: "Važiavimo atbulai mokymas"

	key[]: "aca_scenario_book3_urf_desc"
	val[]: "Šiame scenarijuje būsi tuščioje stovėjimo aikštelėje, kur galėsi pasimokyti važiuoti atbulai su B-dvigubomis priekabomis."

#### urf goal

	key[]: "aca_goal_book3_urf_start"
	val[]: "Pradžia"

	key[]: "aca_goal_book3_urf_move"
	val[]: "Eksperimentai"

	key[]: "aca_goal_book3_urf_stop"
	val[]: "Užbaigimas"

	key[]: "aca_goal_book3_urf_end"
	val[]: "Scenarijaus pabaiga"

	#### urf msg - intro text

	key[]: "aca_msg_book3_urf_cutscene1"
	val[]: "Važiavimas atbuline eiga su B-dviguba priekaba reikalauja daug daugiau dėmesio nei su viena. Reikia iš anksto suplanuoti, kur norite važiuoti galine priekaba, tuo pačiu metu valdant priekinę ir sunkvežimį. <br><br>Galvok šitaip – su priekine priekaba turi vairuoti galinę priekabą."

	key[]: "aca_msg_book3_urf_cutscene2"
	val[]: "Šiuo atveju norime galinę priekabą pasukti į vairuotojo pusę. <br><br>Tam priekinę priekabą turime sukti į keleivio pusę."

	key[]: "aca_msg_book3_urf_cutscene3"
	val[]: "Čia dauguma žmonių ir padaro pirmąją klaidą. Kai galinė priekaba pradeda sukti, suknvežimį reikia ištiesinti su priekaba..."

	key[]: "aca_msg_book3_urf_cutscene4"
	val[]: "...arba suskersuosi junginį štai taip."

	key[]: "aca_msg_book3_urf_cutscene5"
	val[]: "Suskersavimas įvyksta, kai kampas tarp bet kurių dviejų junginio transporto priemonių tampa maždaug 90 laipsnių. Kai tai nutinka padėties pataisyti nebeįmanoma – reikia pajudėti į priekį ir bandyti iš naujo. <br><br> Kaip ir važiuojant atbuline eiga viena priekaba, tikslas visada turėtų būti užtikrinti, kad visi priekabų ratai judėtų. Kai vienas ratas sustoja ir priekaba sukasi vietoje, viskas baigta."

	key[]: "aca_msg_book3_urf_cutscene6"
	val[]: "Gali pajudėti į priekį iki ten, kur paskutinį kartą stovėjai teisingai, arba, tiksliau, iki padėties, kurioje galėsi tęsti judėjimą atbulai, nekartojant tos pačios klaidos, arba tiesiog važiuoti į priekį iki tiesios padėties."

	key[]: "aca_msg_book3_urf_cutscene7"
	val[]: "Dar kartą, kai galinė priekaba sukasi, ištiesink sunkvežimį su priekinės priekabos priekiu ir leisk galinei priekabai kurį laiką sukti pačiai."

	key[]: "aca_msg_book3_urf_cutscene8"
	val[]: "Dabar, kai galinė priekaba gražiai sukasi, laikas nukreipti priekinę dalį, kad ji ją sektų. Gali reguliuoti kampą tarp priekinės ir galinės dalies, kad valdytum posūkio staigumą."

	key[]: "aca_msg_book3_urf_cutscene9"
	val[]: "Paskutinė manevro dalis - visko ištiesinimas. Priekinę priekabą sulygink su galine."

	key[]: "aca_msg_book3_urf_cutscene10"
	val[]: "Gera mintis nepamiršti, kiek laiko užtrunka pasukti priekinę priekabą, ir kad dar reikės ištiesinti sunkvežimį."

	key[]: "aca_msg_book3_urf_cutscene11"
	val[]: "Gali čia praleisti tiek laiko, kiek nori, eksperimentuoti su skirtingais manevrais, kol galvosi, kad apytiksliai supranti, kaip valdyti priekabas važiuojant atbulai."

#### urf Driving Instructions

	key[]: "aca_msg_book3_urf_start"
	val[]: "Pasiruošk važiuoti."

	key[]: "aca_msg_book3_urf_move"
	val[]: "Šioje aikštelėje gali pabandyti atbulai valdyti priekabas. <br><br>@@aca_goal_tip@@ Iš viso neteko atbulai valdyti priekabos? Pagalvok apie Sunkvežimio valdymo pagrindų modulį."

	key[]: "aca_msg_book3_urf_stop"
	val[]: "Gali treniruotis kiek nori laiko. <br><br>Kai manysi, kad jau gana, gali sustoti ir išjungti sunkvežimį ir užbaigti scenarijų."

	key[]: "aca_msg_book3_urf_end"
	val[]: "Išjunk variklį, kad užbaigtum scenarijų."
#@}


