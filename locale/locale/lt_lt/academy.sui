	key[]: "aca_goal_book1_3_20_park1"
	val[]: "Manevras greta"

	key[]: "aca_goal_book1_3_20_park2"
	val[]: "Įstrižas parkavimas"

	key[]: "aca_goal_book1_3_20_park3"
	val[]: "Važiavimas aikštele"

	key[]: "aca_goal_book1_3_20_park4"
	val[]: "Lygiagretus parkavimas"

	key[]: "aca_goal_book1_3_20_park5"
	val[]: "Galutinis parkavimas"


#### 3_20 msg - intro text

	key[]: "aca_msg_book1_3_20_cutscene01"
	val[]: "Sveikiname antroje baigiamojo egzamino dalyje. Važiuosime į aikštelę netoliese ir išbandysime tavo parkavimo įgūdžius."

	key[]: "aca_msg_book1_3_20_cutscene02"
	val[]: "Tavo gebėjimai bus patikrinti keliuose parkavimo iššūkiuose."

	key[]: "aca_msg_book1_3_20_cutscene03"
	val[]: "Erdvės čia nedaug, todėl vairuok atidžiai ir neskubėk."

	key[]: "aca_msg_book1_3_20_cutscene04"
	val[]: "Gerai išnaudok visą erdvę ir stebėk veidrodėlius. Sėkmės!"




#### 3_20 outro text

	key[]: "aca_msg_book1_3_20_outro01"
	val[]: "Sveikiname, sėkmingai atliktai Sunkvežimio valdymo pagrindų egzaminus, ir išmokai visų įgūdžių, reikalingų tinkamai valdyti sunkvežimį."

	key[]: "aca_msg_book1_3_20_outro02"
	val[]: "Tai pirmas žingsnis kelyje į svajonę tapti profesionaliu sunkvežimio vairuotoju."

	key[]: "aca_msg_book1_3_20_outro03"
	val[]: "Tu pasiruošei keliauti į Amerikos kelius ir stoti prieš pirmus iššūkius..."

	key[]: "aca_msg_book1_3_20_outro04"
	val[]: "...bet nuotykiai tik prasideda."


#### 3_20 Driving Instructions

	key[]: "aca_msg_book1_3_20_start"
	val[]: "Atmink neskubėti. Nieko tokio, jei nepavyks pastatyti sunkvežimio iš pirmo karto, svarbiausia nepadaryti žalos sunkvežimiui ir kitiems aplink tave.<font face=/font/big_bold.font><br><br>Pasiruošk važiuoti.</font>"

	key[]: "aca_msg_book1_3_20_forward"
	val[]: "<font face=/font/big_bold.font>Važiuok į pirmą egzamino dalį.</font>"

	key[]: "aca_msg_book1_3_20_park1"
	val[]: "Tavo pirma užduotis yra pademonstruoti parkavimą ne tiesia linija. Vieta, kur reikia įvažiuoti su priekaba, yra kairėje.<br><br><font face=/font/big_bold.font>Atbulai įvažiuok į parkavimo vietą.</font>"

	key[]: "aca_msg_book1_3_20_park2"
	val[]: "Kita užduotis - atbulai įvažiuoti tarp stovinčių sunkvežimių. Atsargiai, nepaliesk kitų sunkvežimių!<br><br><font face=/font/big_bold.font>Atlik įstrižo parkavimo manevrą.</font>"

	key[]: "aca_msg_book1_3_20_park3"
	val[]: "Toliau važiuok aikštele. Saugokis netikėtų situacijų.<br><br><font face=/font/big_bold.font>Važiuok toliau.</font>"

	key[]: "aca_msg_book1_3_20_park4"
	val[]: "Dabar pabandykime lygiagretų parkavimą tarp dviejų sunkvežimių prie šaligatvio priekyje.<br><br><font face=/font/big_bold.font>Atlik lygiagretaus parkavimo manevrą.</font>"

	key[]: "aca_msg_book1_3_20_park5"
	val[]: "Liko paskutinis parkavimo manevras! Gali pasirinkti būdą, kaip jį atlikti.<br><br><font face=/font/big_bold.font>Atbulai įvažiuok į pažymėtą vietą.</font>"

	key[]: "aca_msg_book1_3_20_park6"
	val[]: "Beveik viskas. Išvažiuok iš bandymų zonos ir pastatyk sunkvežimį.<br><br><font face=/font/big_bold.font>Išvažiuok iš bandymų zonos į kairę.</font>"

	key[]: "aca_msg_book1_3_20_stop"
	val[]: "Gali sustoti dešinėje, prie kitų sunkvežimių.<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_20_end"
	val[]: "@@aca_msg_book1_2_01_end@@"


#!}

#@}


#+ Book 1 Scenario 3_22
#@{

#### 3_22 common
	key[]: "aca_scenario_book1_3_22_title"
	val[]: "Lygiagretus parkavimas su priekaba"

	key[]: "aca_scenario_book1_3_22_desc"
	val[]: "Šiame scenarijuje išbandysime lygiagretų parkavimą su priekaba."

#### 3_22 goal


	key[]: "aca_goal_book1_3_22_stopmid"
	val[]: "Sustojimas pažymėtoje vietoje"
#!{
	key[]: "aca_goal_book1_3_22_start"
