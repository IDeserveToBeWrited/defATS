	val[]: "Važiavimas atbulai link priekabos"

	key[]: "aca_goal_book1_3_05_connect"
	val[]: "Priekabos prikabinimas"

	key[]: "aca_goal_book1_3_05_park_br_off"
	val[]: "Stovėjimo stabdžio išjungimas"

	key[]: "aca_goal_book1_3_05_b_trailer"
	val[]: "Sustojimas prieš stovėjimo zoną"

	key[]: "aca_goal_book1_3_05_check1"
	val[]: "Važiavimas atbulai link stovėjimo zonos"

	key[]: "aca_goal_book1_3_05_check2"
	val[]: "Sustojimas prieš stovėjimo zoną"
