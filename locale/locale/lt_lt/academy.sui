#### 3_04 msg - intro text

	key[]: "aca_msg_book1_3_04_cutscene01"
	val[]: "Nepamiršk planuoti į priekį kiekviename posūkyje ir išnaudoti erdvę aplink. Apvažiuok pirmus barjerus."

	key[]: "aca_msg_book1_3_04_cutscene02"
	val[]: "Keli pirmi posūkiai vis staigės."

	key[]: "aca_msg_book1_3_04_cutscene03"
	val[]: "Atmink, kad išvažiavimas iš posūkio gali įtakoti įvažiavimą į kitą."

	key[]: "aca_msg_book1_3_04_cutscene04"
	val[]: "Pirmi sudėtingesni posūkiai bus dvigubas apsisukimas. Turėsi važiuoti labai atsargiai ir apgalvotai, naudoti veidrodėlius."

	key[]: "aca_msg_book1_3_04_cutscene05"
	val[]: "Toliau važiuok siaura dalimi."

	key[]: "aca_msg_book1_3_04_cutscene06"
	val[]: "Toliau - keli lengvi posūkiai kelyje link apsisukimo."

	key[]: "aca_msg_book1_3_04_cutscene07"
	val[]: "Nuolat dairykis, kad neatsitrenktum į jokį barjerą. Važiuok taip lėtai, kaip reikia."

	key[]: "aca_msg_book1_3_04_cutscene08"
	val[]: "Net jei pasirodys, kad vietos daug, vis tiek gali kilti problemų."

	key[]: "aca_msg_book1_3_04_cutscene09"
	val[]: "Sudėtingiausias posūkis prieš akis. Nuo įvažiavimo į posūkį priklausys, ar pavyks jį įveikti."

	key[]: "aca_msg_book1_3_04_cutscene10"
	val[]: "Važiuok paskutiniu posūkiu."

	key[]: "aca_msg_book1_3_04_cutscene11"
	val[]: "Sustok pažymėtoje vietoje, įjunk stovėjimo stabdį ir išjunk variklį."
