	key[]: "aca_goal_book1_2_08_check7"
	val[]: "Atvira dalis"



#### 2_08 msg - intro text

	key[]: "aca_msg_book1_2_08_cutscene1"
	val[]: "Šiame scenarijuje trumpai pasivažinėsime vilkiku ir patikrinsime tavo naujus įgūdžius.<br>Šiame maršrute bus įvairių posūkių. Čia ne lenktynės, ir laikas nesvarbu. Važiuok kantriai ir pasirink posūkiams ir kliūtims tinkamą greitį."

	key[]: "aca_msg_book1_2_08_cutscene2"
	val[]: "Pradėk trasą plačiu apsisukimu."

	key[]: "aca_msg_book1_2_08_cutscene3"
	val[]: "Toliau bus kelios kliūtys, vedančios į netaisyklingą slalomą."

	key[]: "aca_msg_book1_2_08_cutscene4"
	val[]: "Po kelių lengvų 90 laipsnių posūkių pamatysi siaurą apsisukimą. Svarbu tinkamai pasiruošti ir posūkiui, ir kitai daliai."

	key[]: "aca_msg_book1_2_08_cutscene5"
	val[]: "Važiuodamas ilgu vingiu nepamiršk kūgių, nes dėl kapoto jų nesimato."

	key[]: "aca_msg_book1_2_08_cutscene6"
	val[]: "Šie barjerai nukreips tave į platų slalomą."

	key[]: "aca_msg_book1_2_08_cutscene7"
	val[]: "Čia kelias šiek tiek išplatėja, bet neskubėk. Dar keli lengvi posūkiai ir viskas."

	key[]: "aca_msg_book1_2_08_cutscene8"
	val[]: "Sustok nurodytoje vietoje ir išjunk sunkvežimį."


#### 2_08 Driving Instructions

	key[]: "aca_msg_book1_2_08_start"
	val[]: "Scenarijaus užduotis - neatsitrenkti, neišvažiuoti iš trasos, nepervažiuoti kūgių.<br><br><font face=/font/big_bold.font>Pasiruošk važiuoti.</font>"

	key[]: "aca_msg_book1_2_08_forward"
	val[]:"<font face=/font/big_bold.font>Važiuok tiesiai į platų apsisukimą - trasos pradžią.</font>"

	key[]: "aca_msg_book1_2_08_check1"
	val[]: "<font face=/font/big_bold.font>Įveik apsisukimą. </font>"

	key[]: "aca_msg_book1_2_08_check2"
	val[]: "Artėji prie barjerų, iš kurių sudėliotas slalomas.<br><br><font face=/font/big_bold.font>Pasirink tinkamą greitį ir tęsk.</font>"

	key[]: "aca_msg_book1_2_08_check3"
	val[]: "Toliau du lengvi 90 laipsnių posūkiai ir staigus apsisukimas. Neskubėk.<br><br><font face=/font/big_bold.font>Važiuok į staigų apsisukimą.</font>"

	key[]: "aca_msg_book1_2_08_check4"
	val[]: "Išvažiavus iš posūkio bus siauras kelias vingiu. Turi laikytis toliau nuo vidinio barjero, bet nepervažiuoti kūgių priekyje.<br><br><font face=/font/big_bold.font>Važiuok vingiu.</font>"

	key[]: "aca_msg_book1_2_08_check6"
	val[]: "Kelyje priekyje bus siaurų, techniškų posūkių. Tinkamai pasirink greitį ir vairuok atidžiai.<br><br><font face=/font/big_bold.font>Važiuok toliau. </font>"

	key[]: "aca_msg_book1_2_08_check7"
	val[]: "Kita dalis atviresnė, su lengvais posūkiais. Neskubėk.<br><br><font face=/font/big_bold.font>Važiuok toliau.</font>"
#!{
	key[]: "aca_msg_book1_2_08_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_08_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

#@}

#+ Book 1 Scenario 2_09
#@{

#### 2_09 common
	key[]: "aca_scenario_book1_2_09_title"
	val[]: "Lygiagretus parkavimas"

	key[]: "aca_scenario_book1_2_09_desc"
	val[]: "Šiame scenarijuje išbandysime lygiagretų parkavimą tarp kių dviejų sunkvežimių."

#### 2_09 goal

	key[]: "aca_goal_book1_2_09_stopmid"
	val[]: "Sustojimas prieš stovėjimo vietą"

	key[]: "aca_goal_book1_2_09_checkmirror"
	val[]: "Galinio vaizdo veidrodėlio patikrinimas"

	key[]: "aca_goal_book1_2_09_backward"
	val[]: "Atbulas važiavimas į stovėjimo vietą"

	key[]: "aca_goal_book1_2_09_stop"
	val[]: "Sunkvežimio išlyginimas stovėjimo vietoje"

#!{
