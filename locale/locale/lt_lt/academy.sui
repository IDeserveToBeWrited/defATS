#### 3_05 msg - intro text

	key[]: "aca_msg_book1_3_05_cutscene01"
	val[]: "Pabandykime važiuoti atbulai su priekaba. Tai lengviau nei atrodo, tik reikia kantrybės."

	key[]: "aca_msg_book1_3_05_cutscene02"
	val[]: "Pradėk važiuoti atbulai ir išlygink vilkiką su priekaba."

	key[]: "aca_msg_book1_3_05_cutscene03"
	val[]: "Turi sustoti tiesiai, kitaip neprikabinsi priekabos. Jei nepataikei, gali pavažiuoti priekin ir pabandyti dar kartą."

	key[]: "aca_msg_book1_3_05_cutscene04"
	val[]: "Vilkiko balnas prisikabins prie priekabos."

	key[]: "aca_msg_book1_3_05_cutscene05"
	val[]: "Įjunk stovėjimo stabdį ir prijunk priekabą. Realiame gyvenime turėtum išlipti, prijungti oro žarnas ir elektros kabelius bei pakelti priekabos atramą, bet čia tai padarysime mes."

	key[]: "aca_msg_book1_3_05_cutscene05b"
	val[]: "Važiuok toliau ir laikykis kelio žymėjimų dešiniau, į pažymėtą juostą."

	key[]: "aca_msg_book1_3_05_cutscene05c"
	val[]: "Tikslas - sustoti lygiai su stovėjimo vieta už tavęs. Kai atrodys, kad sunkvežimis stovi pakankamai tiesiai, gali pradėti važiuoti atgal."

	key[]: "aca_msg_book1_3_05_cutscene06"
	val[]: "@@aca_msg_book1_3_05_cutscene06_img@@<br>Priekaba visada suka <color value=@@clr_sel@@>priešingai <color value=@@clr_txt@@>vilkikui."

	key[]: "aca_msg_book1_3_05_cutscene07"
	val[]: "@@aca_msg_book1_3_05_cutscene07_img@@<br>Norint pasukti priekabą, vilkiką reikia kreipti<color value=@@clr_sel@@> priešinga <color value=@@clr_txt@@> kryptimi, nei nori pasukti priekabą."

	key[]: "aca_msg_book1_3_05_cutscene08"
	val[]: "@@aca_msg_book1_3_05_cutscene08_img@@<br>Norint vėl ištiesinti priekabą, vilkiką reikia pasukti <br><color value=@@clr_sel@@>link<color value=@@clr_txt@@> priekabos."

	key[]: "aca_msg_book1_3_05_cutscene09"
	val[]: "Kreipk priekabą į pažymėtą vietą, po to bandyk vilkiką išlaikyti lygiai su priekaba - reikės nuolat koreguoti."

	key[]: "aca_msg_book1_3_05_cutscene10"
	val[]: "Pataisyk nukrypimus nuo kelio nedideliais vairo pasukimai iš karto, kai jie atsiranda. Jei vairą suksi per daug, gali toli nuklysti nuo norimo kelio."

	key[]: "aca_msg_book1_3_05_cutscene11"
	val[]: "Sustok pažymėtoje vietoje, įjunk stovėjimo stabdį ir išjunk variklį."

#### 3_05 Driving Instructions

	key[]: "aca_msg_book1_3_05_start"
	val[]: "Už tavęs, dešinėje stovi priekaba. Pirma užduotis yra atbulai privažiuoti prie jos.<br><br><font face=/font/big_bold.font>Paruošk sunkvežimį važiavimui atbulai. </font>"

	key[]: "aca_msg_book1_3_05_backward"
	val[]: "<font face=/font/big_bold.font>Pradėk važiuoti atbulai link priekabos. </font>"

	key[]: "aca_msg_book1_3_05_check_con"
	val[]: "Nusitaikyk taip, kad būtum tiesiai lygūs su priekaba. Vilkiko balnas turi prisikabinti priekabą. Jei reikia, pavažiuok priekin ir pakoreguok savo padėtį.<br><br><font face=/font/big_bold.font>Važiuok atbulai kol pajausi prikabinimą. </font>"

	key[]: "aca_msg_book1_3_05_park_br_on"
	val[]: "Vilkiko balnas prisikabino priekabą, ir gali užbaigti sukabinimą.<br><br><font face=/font/big_bold.font>Įjunk stovėjimo stabdį. </font>"

	key[]: "aca_msg_book1_3_05_connect"
	val[]: "<font face=/font/big_bold.font> Spausk @@imv_nrm_attach@@ prikabinti priekabą. </font>"

	key[]: "aca_msg_book1_3_05_park_br_off"
	val[]: "Dabar priekaba saugiai prikabinta, elektros kabeliai ir oro žarnos prijungtos, o priekabos atrama pakelta.<br><br><font face=/font/big_bold.font>Išjunk stovėjimo stabdį. </font>"

	key[]: "aca_msg_book1_3_05_b_trailer"
	val[]: "Kad susilygintum su stovėjimo vieta kairėje, pavažiuok priekin dešinėn. Stebėk kelio ženklinimą.<br><br><font face=/font/big_bold.font>Važiuok tiesiai ir susilygink su stovėjimo vieta.</font>"

	key[]: "aca_msg_book1_3_05_check1"
	val[]: "Kai stovėsi daugiau mažiau tiesiai su stovėjimo vieta, gali pradėti važiuoti atbulai.<br><br><font face=/font/big_bold.font>Pradėk judėti atbulai.</font>"

	key[]: "aca_msg_book1_3_05_check2"
	val[]: "Atmink, kad priekaba suks priešingai, nei suksi vilkiką, ir kad nedidelis vairo pasukimas gali smarkiai nukreipti priekabą.<br><br><font face=/font/big_bold.font>Toliau važiuok atbulai. </font>"
#!{
	key[]: "aca_msg_book1_3_05_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_05_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

#@}

