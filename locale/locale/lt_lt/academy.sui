#+ Book 3 Scenario justb
#@{

#### justb common
	key[]: "aca_scenario_book3_justb_title"
	val[]: "Pirmas atbulinis"

	key[]: "aca_scenario_book3_justb_desc"
	val[]: "Šiame scenarijuje pirmą kartą važiuosime atbulai su B-dvigubomis priekabomis."

#### justb goal

#!{
	key[]: "aca_goal_book3_justb_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_justb_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
	key[]: "aca_goal_book3_justb_check1"
	val[]: "Atsipalaiduok ir nesijaudink"

#!{
	key[]: "aca_goal_book3_justb_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_justb_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### justb msg - intro text

	key[]: "aca_msg_book3_justb_cutscene1"
	val[]: "Važiavimas atbuline eiga su B-dviguba priekaba reikalauja visiškai naujo mąstymo apie tai, ką darai. Užuot nukreipiant tik priekabą, dabar su savo priekaba nukreipiate kitą, važiuojančią už pirmos. <br><br> Pasinaudok šiuo scenarijumi, kad suprastum, kaip viskas veikia. Nėra konkretaus tikslo, tiesiog neskubėk ir pabandyk suprasti, kas vyksta."

	key[]: "aca_msg_book3_justb_cutscene2"
	val[]: "Iš tiesios padėties gali pasukti sunkvežimį ta pačia kryptimi, kuria nori, kad važiuotų galinė priekaba. <br><br>Nepersistenk; jums tereikia pasukti galinę priekabą norima kryptimi, o tada galite sulygiuoti vilkiką su pirma priekaba ir leisti galinei priekabai atlikti savo darbą."

	key[]: "aca_msg_book3_justb_cutscene3"
	val[]: "Kai galinė priekaba važiuos norima kryptimi, galite pasukti priekinę priekabą ta pačia kryptimi. <br><br>Kai priekinė priekaba seks galinę, sunkvežimiu reguliuok kampą tarp dviejų priekabų, kad posūkis būtų staigesnis arba platesnis."

	key[]: "aca_msg_book3_justb_cutscene4"
	val[]: "Nėra tikslios formulės, kaip tai padaryti teisingai, tereikia stebėti tai, kas vyksta, mokytis iš savo klaidų ir toliau praktikuotis. <br><br>Kai būsi patenkinti, galėsi vykti į nurodytą vietą ir išjungti savo sunkvežimį. <br><br>Nesivaržyk ir eksperimentuok čia tiek laiko, kiek manai, kad reikia."

#### justb Driving Instructions

#!{
	key[]: "aca_msg_book3_justb_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_justb_forward"
	val[]: "Pradėk lėtai važiuoti atbulai. Atmink, kad reikia pradėti nuo mažų judesių, nereikia visko iš karto staigiai keisti.<br><br>Pabandyk važiuoti tiesiai atgal arba pristumk priekabas prie vairuotojo pusės."

	key[]: "aca_msg_book3_justb_check1"
	val[]: "Neskubėk ir nenusimink. <br><br>Kiekvienas meistras kažkada buvo pradedantysis."

#!{
	key[]: "aca_msg_book3_justb_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_justb_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}

