#### 3_19 msg - intro text

	key[]: "aca_msg_book1_3_19_cutscene01"
	val[]: "Sveikiname pirmoje baigiamojo egzamino dalyje. Čia pamatysime, kaip gerai išmokai vairuoti sunkvežimį nuo Akademijos pradžios."

	key[]: "aca_msg_book1_3_19_cutscene02"
	val[]: "Pirma, prikabinsi priekabą. Tada važiuosi sunkvežimiu užduočių maršrute."

	key[]: "aca_msg_book1_3_19_cutscene03"
	val[]: "Pirma bandymo dalis nuves tave šalutiniais keliais į miesto centrą."

	key[]: "aca_msg_book1_3_19_cutscene04"
	val[]: "Šiame maršrute bus įvairūs posūkiai ir kliūtys."

	key[]: "aca_msg_book1_3_19_cutscene05"
	val[]: "Nedidelė maršruto dalis eis miesto centre."

	key[]: "aca_msg_book1_3_19_cutscene06"
	val[]: "Išbandysime tavo gebėjimus valdyti sunkvežimį įvairiose situacijose."

	key[]: "aca_msg_book1_3_19_cutscene07"
	val[]: "Sutiksi įvairias situacijas, kurios patikrins tavo dėmesingumą aplinkai."

	key[]: "aca_msg_book1_3_19_cutscene08"
	val[]: "Atbulai važiuosi pramonės zonoje."

	key[]: "aca_msg_book1_3_19_cutscene09"
	val[]: "Po kelių miesto centre ir pramonės zonoje važiuosi į štabą."

	key[]: "aca_msg_book1_3_19_cutscene10"
	val[]: "Trumpas pasivažinėjimas ir tu beveik vietoje."

	key[]: "aca_msg_book1_3_19_cutscene11"
	val[]: "Bandymo pabaidoje turi tiksliai pastatyti sunkvežimį. Manevrą galima pasirinkti laisvai."

	key[]: "aca_msg_book1_3_19_cutscene12"
	val[]: "Jaudintis nereikia, nes jau išmokai visko, ko reikės šiame egzamine.<br><br>Sėkmės!"

#### 3_19 Driving Instructions



	key[]: "aca_msg_book1_3_19_forward"
	val[]: "Pirma reikia rasti ir prikabinti priekabą. Ji stovie priekyje dešinėje.<br><br><font face=/font/big_bold.font>Važiuok link priekabos.</font>"

	key[]: "aca_msg_book1_3_19_coupling"
	val[]: "Pasuk kairėn, tada važiuok atbulai link priekabos.<br><br><font face=/font/big_bold.font>Važiuok atbulai link priekabos.</font>"

	key[]: "aca_msg_book1_3_19_park_br_on"
	val[]: "<font face=/font/big_bold.font>Įjunk stovėjimo stabdį. </font>"

	key[]: "aca_msg_book1_3_19_connect"
	val[]: "<font face=/font/big_bold.font>Spausk @@imv_nrm_attach@@ prikabinti priekabą. </font>"

	key[]: "aca_msg_book1_3_19_park_br_off"
	val[]: "Priekaba prikabinta, sunkvežimis paruoštas.<br><br><font face=/font/big_bold.font>Išjunk stovėjimo stabdį.</font>"

	key[]: "aca_msg_book1_3_19_b_trailer"
	val[]: "Kelias uždarytas testui. Gali laikytis kelio ženklų arba ne.<br><br><font face=/font/big_bold.font>Važiuok link kelio.</font>"

	key[]: "aca_msg_book1_3_19_check01"
	val[]: "Įveik pirmus kelis posūkius.<br><br><font face=/font/big_bold.font>Važiuok toliau.</font>"

	key[]: "aca_msg_book1_3_19_check02"
	val[]: "Po kito posūkio bus slalomas iš eismo kūgių.<br><br><font face=/font/big_bold.font>Atsargiai važiuok tarp kūgių.</font>"

	#key[]: "aca_msg_book1_3_19_check02a"
	#val[]: "Continue through the roundabout into the town.<br><br><font face=/font/big_bold.font>Negotiate the roundabout.</font>"

	key[]: "aca_msg_book1_3_19_check02b"
	val[]: "Tavęs laukia dar keli 90 laipsnių posūkiai.<br><br><font face=/font/big_bold.font>Važiuok toliau.</font>"

	key[]: "aca_msg_book1_3_19_check03"
	val[]: "Kitas posūkis ypatingai staigus, ir jam įveikti prireiks viso kelio pločio.<br><br><font face=/font/big_bold.font>Pasuk dešinėn ir važiuok skersgatviu.</font>"

	key[]: "aca_msg_book1_3_19_check04"
	val[]: "Pasuk dešinėn iš skersgatvio, tada dešinėn į pagrindinį kelią.<br><br><font face=/font/big_bold.font>Važiuok toliau.</font>"

	key[]: "aca_msg_book1_3_19_check05"
	val[]: "Gali šiek tiek atsipalaiduoti važiuodamas pagrindiniu keliu.<br><br><font face=/font/big_bold.font>Važiuok tiesiai.</font>"

	key[]: "aca_msg_book1_3_19_check06"
	val[]: "Priekyje keli staigūs posūkiai į keliuką.<br><br><font face=/font/big_bold.font>Atsargiai įveik posūkius.</font>"

	key[]: "aca_msg_book1_3_19_check07"
	val[]: "Artėji prie sudėtingesnio slalomo. Važiuok lėtai ir stebėk veidrodėlius.<br><br><font face=/font/big_bold.font>Važiuok toliau ir atsargiai įveik slalomą.</font>"

	key[]: "aca_msg_book1_3_19_check08"
	val[]: "Pasuk kairėn į pramonės zoną, saugokis apšvietimo stulpo.<br><br><font face=/font/big_bold.font>Pasuk kairėn.</font>"

	key[]: "aca_msg_book1_3_19_check09"
	val[]: "Pasiruošk važiuoti atbulai.<br><br><font face=/font/big_bold.font>Pasuk dešinėn ir sustok pažymėtoje zonoje.</font>"

	key[]: "aca_msg_book1_3_19_check10"
	val[]: "Važiuok atbulai ir laikykis kelio kairėje, už tavęs.<br><br><font face=/font/big_bold.font>Pradėk važiuoti atbulai.</font>"

	key[]: "aca_msg_book1_3_19_check11"
	val[]: "Laikykis kelio kairėje.<br><br><font face=/font/big_bold.font>Toliau važiuok atbulai.</font>"

	key[]: "aca_msg_book1_3_19_check12"
	val[]: "<font face=/font/big_bold.font>Važiuok tiesiai ir pasuk dešinėn.</font>"

	key[]: "aca_msg_book1_3_19_check13"
	val[]: "<font face=/font/big_bold.font>Važiuok link vartų. </font>"

	key[]: "aca_msg_book1_3_19_check14"
	val[]: "Palauk kol vartai atsidarys, tada važiuok į pagrindinį kelią.<br><br><font face=/font/big_bold.font>Važiuok toliau.</font>"

	key[]: "aca_msg_book1_3_19_check15"
	val[]: "Atsargiai, nepervažiuok ženklo.<br><br><font face=/font/big_bold.font>Įveik posūkį ir važiuok toliau.</font>"

	key[]: "aca_msg_book1_3_19_check16"
	val[]: "<font face=/font/big_bold.font>Pasuk kairėn į Akademiją. </font>"

	key[]: "aca_msg_book1_3_19_check17"
	val[]: "<font face=/font/big_bold.font>Važiuok tiesiai. </font>"

	key[]: "aca_msg_book1_3_19_check18"
	val[]: "Laikykis arčiau išorės, nes po vingio bus staigus posūkis.<br><br><font face=/font/big_bold.font>Važiuok vingiu.</font>"

	key[]: "aca_msg_book1_3_19_check19"
	val[]: "<font face=/font/big_bold.font>Pasuk kairėn ir pasiruošk sustoti kairėje.</font>"

	key[]: "aca_msg_book1_3_19_check20"
	val[]: "<font face=/font/big_bold.font>Atbulai važiuok į stovėjimo vietą.</font>"
#!{
	key[]: "aca_msg_book1_3_19_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_19_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_19_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
