	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
#### trckstp msg - intro text

	key[]: "aca_msg_book3_trckstp_cutscene1"
	val[]: "Nėra neįprasta atvažiuoti į jau beveik pilną aikštelę, kai lieka labai nedaug pasirinkimų parkavimui."

	key[]: "aca_msg_book3_trckstp_cutscene2"
	val[]: "Šiuo atveju yra tik viena likusi vieta, kur gali tilpti su savo B-dvigubomis priekabomis. <br><br>Važiuok aikštele ir sustok posūkyje netoli išvažiavimo."

#### trckstp Driving Instructions

#!{
	key[]: "aca_msg_book3_trckstp_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_trckstp_forward"
	val[]: "Važiuok per aikštelę ir sustok vingyje. <br><br>Važiuok kai pasiruoši."

	key[]: "aca_msg_book3_trckstp_check1"
	val[]: "Netilpsi šiam posūkyje. Turi važiuoti atgal ir rasti kitą kelią."

	key[]: "aca_msg_book3_trckstp_check2"
	val[]: "Sustok posūkyje priekyje."

	key[]: "aca_msg_book3_trckstp_stop"
	val[]: "Sustok nurodytoje vietoje."

	key[]: "aca_msg_book3_trckstp_end"
	val[]: "Įjunk stovėjimo stabdį ir išjunk variklį."

#@}


#+ Book 3 Scenario finex
#@{

#### finex common

	key[]: "aca_scenario_book3_finex_title"
	val[]: "Baigiamasis egzaminas"

	key[]: "aca_scenario_book3_finex_desc"
	val[]: "Šiame scenarijuje išbandys savo naujus įgūdžius trasoje, skirtoje tikslumui ir vairavimo su B-dvigubomis priekabomis supratimui patikrinti."

#### finex goal

	key[]: "aca_goal_book3_finex_check0"
	val[]: "Važiavimas atbulai"

	key[]: "aca_goal_book3_finex_check1"
	val[]: "Trasos pradžia"

	key[]: "aca_goal_book3_finex_check2"
	val[]: "Įsibėgėjimas"

	key[]: "aca_goal_book3_finex_check22"
	val[]: "Pasiruošk stabdyti"

	key[]: "aca_goal_book3_finex_speed"
	val[]: "Nepakankamas greitis"

#!{
	key[]: "aca_goal_book3_finex_check4"
	val[]: "@@aca_goal_book3_sup_check1@@"
#!}
	key[]: "aca_goal_book3_finex_check5"
	val[]: "Parkavimas"

#!{
	key[]: "aca_goal_book3_finex_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_finex_end"
	val[]: "@@aca_goal_book3_sup_end@@"

	key[]: "aca_goal_book3_finex_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_finex_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
#### finex msg - intro text

	key[]: "aca_msg_book3_finex_cutscene1"
	val[]: "Sveikiname baigiamąjame egzamine. Pateikėme keletą realių situacijų, su kuriomis gali susidurti kelyje, kad pamatytume, kaip su jomis susitvarkysi. Kaip visada, neskubėk ir būk tikslus. <br><br>Sėkmės!"

#### finex Driving Instructions

	key[]: "aca_msg_book3_finex_check0"
	val[]: "Kelias priekyje užblokuotas. Apsisuk šioje erdvėje."

	key[]: "aca_msg_book3_finex_check1"
	val[]: "Važiuok link miesto centro."

	key[]: "aca_msg_book3_finex_check2"
	val[]: "Pasiek bent 37 mph (60 km/h) greitį važiuojant link miesto centro."

	key[]: "aca_msg_book3_finex_check22"
	val[]: "Pasiruošk stabdyti."

	key[]: "aca_msg_book3_finex_speed"
	val[]: "Nepavyko pasiekti 37 mph (60 km/h) greičio"

	key[]: "aca_msg_book3_finex_check4"
	val[]: "Važiuok toliau trasa."

	key[]: "aca_msg_book3_finex_check5"
	val[]: "Sunkvežimių eilėje kairėje yra tau skirta stovėjimo vieta. Pastatyk junginį ten atbulai."

#!{
	key[]: "aca_msg_book3_finex_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_finex_forward"
	val[]: "Važiuok kai pasiruoši."

#!{
	key[]: "aca_msg_book3_finex_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_finex_end"
	val[]: "@@aca_msg_book3_sup_end@@"
