#### 3_22 msg - intro text

	key[]: "aca_msg_book1_3_22_cutscene1"
	val[]: "Lygiagretus parkavimas su priekaba yra visiems vairuotojams reikalingas įgūdis.<br>To gali prireikti tiek parkuojant gatvėje dideliame mieste, tiek stojant poilsio aikštelėje už miesto, ir tai turėtų mokėti kiekvienas vairuotojas."

	key[]: "aca_msg_book1_3_22_cutscene2"
	val[]: "Pravažiuodamas parkavimo vietą atidžiai įvertink, ar joje pakaks vietos vilkikui su priekaba. Čia mes užtikrinome, kad vietos užtektų."

	key[]: "aca_msg_book1_3_22_cutscene3"
	val[]: "Sustok prieš stovėjimo vietą. Nebūk per arti, kad turėtum laisvės manevravimui."

	key[]: "aca_msg_book1_3_22_cutscene4"
	val[]: "Staigiai pasuk nuo parkavimo vietos ir pajudėk atbulai. Reikia, kad priekaba įsuktų į stovėjimo vietą iš karto."

	key[]: "aca_msg_book1_3_22_cutscene5"
	val[]: "Kai priekaba įsuks į vietą, galėsi pradėti sekti ją."

	key[]: "aca_msg_book1_3_22_cutscene6"
	val[]: "Pradėk sukti priekabą nuo šaligatvio kol vairuotojo pusės priekabos ratai nepasiekė vietos."

	key[]: "aca_msg_book1_3_22_cutscene7"
	val[]: "Ištiesink vilkiką su priekaba ir atsistok stovėjimo vietos viduryje.<br><br>Sustok, įjunk stovėjimo stabdį ir išjunk variklį."

#### 3_22 Driving Instructions

	key[]: "aca_msg_book1_3_22_start"
	val[]: "Priekyje matai stovėjimo vietą tarp kitų sunkvežimių. Parkuojant reikia nuolat stebėti veidrodėlius ir išlaikyti saugų atstumą tarp sunkvežimio ir kliūčių aplink.<br><br><font face=/font/big_bold.font>Pasiruošk važiuoti.</font>"

	key[]: "aca_msg_book1_3_22_check1"
	val[]: "Judėk aikštele kol rasi vietą.<br><br><font face=/font/big_bold.font>Važiuok pirmyn.</font>"

	key[]: "aca_msg_book1_3_22_stopmid"
	val[]: "<color value=@@clr_white@@>Pravažiuok stovėjimo vietą į pažymėtą vietą. Iš jos galėsi pradėti važiavimą atbulai.<br><br><font face=/font/big_bold.font>Sustok pažymėtoje vietoje.</font>"

	key[]: "aca_msg_book1_3_22_backward"
	val[]: "Pasuk vilkiką nuo stovėjimo vietos ir pradėk sukti priekabą į ją. Nesuk per staigiai, nes važiuosi tiesiai į šaligatvį.<br><br><font face=/font/big_bold.font>Pradėk judėti atbulai.</font>"

	key[]: "aca_msg_book1_3_22_stop"
	val[]: "Ištiesink sunkvežimį su stovėjimo vieta. Jei reikia, pavažiuok pirmyn ar atgal reguliuojant savo padėtį.<br><br>@@aca_msg_book1_2_01_stop@@"
#!{
	key[]: "aca_msg_book1_3_22_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
 #!}

#@}

#+ Book 1 Scenario 3_21
#@{
#### 3_21 common
	key[]: "aca_scenario_book1_3_21_title"
	val[]: "Važiavimas atbulai nuo 45 laipsnio kampo pasiruošimo"

	key[]: "aca_scenario_book1_3_21_desc"
	val[]: "Šiame scenarijuje panagrinėsime 45 laipsnių pasiruošimą važiavimui atbulai."

#### 3_21 goal
#!{
	key[]: "aca_goal_book1_3_21_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_21_forward"
	val[]: "@@aca_goal_book1_1_03_forward@@"

	key[]: "aca_goal_book1_3_21_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}
	key[]: "aca_goal_book1_3_21_check1"
	val[]: "Tarpinis taškas"

	key[]: "aca_goal_book1_3_21_check2"
	val[]: "Tinkamas atstumas važiavimui atbulai"

	key[]: "aca_goal_book1_3_21_stop"
	val[]: "Sustojimas nurodytoje vietoje"



#### 3_21 msg - intro text

	key[]: "aca_msg_book1_3_21_cutscene1"
	val[]: "Šioje pamokoje panagrinėsime 45 laipsnių parkavimą. Kai situacija leidžia, tai daugelio mėgstamas metodas atbulai įvažiuoti į stovėjimo vietas. Pradedant su priekaba, jau nukreipta ten, kur reikia važiuoti, reikia atlikti mažiau manevravimo."

	key[]: "aca_msg_book1_3_21_cutscene2"
	val[]: "Toks pasiruošimas taip pat leidžia geriau matyti stovėjimo vietą."

	key[]: "aca_msg_book1_3_21_cutscene3"
	val[]: "Pravažiuok stovėjimo vietą ir pasuk maždaug 45 laipsnių kampu. Reikia, kad priekaba būtų nukreipta į sunkvežimį kitapus tavo pasirinktos stovėjimo vietos."

	key[]: "aca_msg_book1_3_21_cutscene4"
	val[]: "Pasuk vilkiką nuo stovėjimo vietos. Tai pastums priekabos priekį, o priekabos galą pasuks link norimos stovėjimo vietos. Atsargiai, nepersistenk - atmink, kad kai pradėsi sukti, bus lengviau pasukti staigiau, nei ištiesinti."

	key[]: "aca_msg_book1_3_21_cutscene5"
	val[]: "Kai priekaba įvažiuoja į stovėjimo vietą, pasuk vilkiką prieš ją ir ištiesink."

	key[]: "aca_msg_book1_3_21_cutscene6"
	val[]: "Sustok nurodytoje vietoje ir išjunk sunkvežimį."

#### 3_21 Driving Instructions
#!{
	key[]: "aca_msg_book1_3_21_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

	key[]: "aca_msg_book1_3_21_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
	key[]: "aca_msg_book1_3_21_forward"
	val[]: "Kairėje yra stovėjimo vieta. Pravažiuok ją ir pasuk 45 laipsnių kampu.<br><br><font face=/font/big_bold.font>Važiuok priekin.</font>"

	key[]: "aca_msg_book1_3_21_check1"
	val[]: "Pastatyk sunkvežimį pagal žymes.<br><br><font face=/font/big_bold.font>Sustok pažymėtoje vietoje.</font>"

	key[]: "aca_msg_book1_3_21_check2"
	val[]: "Naudodamas ankstesniuose scenarijuose gautas žinias, vairuok priekabą į stovėjimo vietą.<br><br><font face=/font/big_bold.font>Pradėk važiuoti atbulai.</font>"

	key[]: "aca_msg_book1_3_21_stop"
	val[]: "Toliau vairuok priekabą į stovėjimo vietą.<br><br>@@aca_msg_book1_2_01_stop@@"


#@}

