	key[]: "aca_goal_book3_sup_stop"
	val[]: "Sustojimas"

	key[]: "aca_goal_book3_sup_end"
	val[]: "Sunkvežimio išjungimas"

#### sup msg - intro text

	key[]: "aca_msg_book3_sup_cutscene1"
	val[]: "Vairavimas su B-dvigubomis priekabomis gali pasirodyti bauginantis, tačiau tai nelabai sudėtingiau nei vairavimas su viena priekaba – tereikia atsižvelgti ir į galinės priekabos kelią!"

	key[]: "aca_msg_book3_sup_cutscene2"
	val[]: "Priekyje yra siaura stovėjimo vieta. Neužteks vietos sustoti visiškai tiesiai prieš įvažiuojant, todėl reikės atidžiai apsvarstyti, kaip įvažiuoti su abiem priekabomis."

	key[]: "aca_msg_book3_sup_cutscene3"
	val[]: "Iš karto suk į tolimąją stovėjimo vietos pusę ir pravažiuok gerokai toliau nei įprastai."

	key[]: "aca_msg_book3_sup_cutscene4"
	val[]: "Dabar, kai galinė priekaba yra tiesiai, galite judėti link stovėjimo vietos; gali tek vėl pajudėti į tolimąją pusę, kad padėtum pasukti pirmąją priekabą."

	key[]: "aca_msg_book3_sup_cutscene5"
	val[]: "Toliau važiuok į vietą, ir abi priekabos seks paskui jus ir išsitiesins jums važiuojant."

	key[]: "aca_msg_book3_sup_cutscene6"
	val[]: "Sustok nurodytoje vietoje ir išjunk sunkvežimį."

#### sup Driving Instructions

	key[]: "aca_msg_book3_sup_start"
	val[]: "Pasiruošk važiuoti."

	key[]: "aca_msg_book3_sup_forward"
	val[]: "Važiuok tiesiai į siaurą vietą."

	key[]: "aca_msg_book3_sup_check1"
	val[]: "Važiuok toliau."

	key[]: "aca_msg_book3_sup_stop"
	val[]: "Sustok nurodytoje vietoje."

	key[]: "aca_msg_book3_sup_end"
	val[]: "Įjunk stovėjimo stabdį ir išjunk variklį."
#@}


