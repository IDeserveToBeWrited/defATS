	val[]: "@@aca_goal_book1_2_01_end@@"

 #!}
#### 3_18 msg - intro text

	key[]: "aca_msg_book1_3_18_cutscene01"
	val[]: "Parkavimas čia reikalauja manevro kampu.<br>Tai dažnas manevras, nes tokios parkavimo situacijos pasitaiko beveik kasdien, ar pakraunant ar iškraunant priekabą, ar stojant nakvynei poilsio aikštelėje."

	key[]: "aca_msg_book1_3_18_cutscene02"
	val[]: "Tai manevras, panašus į ankstesnį scenarijų, bet čia bus mažiau vietos, todėl reikės tinkamai suplanuoti veiksmus."

	key[]: "aca_msg_book1_3_18_cutscene03"
	val[]: "Kadangi vietos mažiau, tikslūs judesiai svarbesni. Pasuk priekabą tinkamu metu ir stebėk visus ratus, kur jie važiuoja. Atmink priekabos mostą ir pasistenk nesusiskersuoti."

	key[]: "aca_msg_book1_3_18_cutscene04"
	val[]: "Stenkis kreipti priekabą link skersgatvio geriau anksčiau, nei vėliau. Taip kitoje pusėje liks vietos įsukti priekabos priekį ir įvažiuoti vilkikui."

	key[]: "aca_msg_book1_3_18_cutscene05"
	val[]: "Kai priekaba bus skersgatvyje, pasuk vilkiką prieš ją. Geriau tai padaryti šiek tiek anksčiau nei atrodo. Visada galėsi pasitaisyti važiuodamas į galutinę vietą."

	key[]: "aca_msg_book1_3_18_cutscene06"
	val[]: "Ištiesink vilkiką ir priekabą ir sustok nurodytoje vietoje."

	key[]: "aca_msg_book1_3_18_cutscene07"
	val[]: "Įjunk stovėjimo stabdį ir išjunk variklį."


#### 3_18 Driving Instructions

	key[]: "aca_msg_book1_3_18_start"
	val[]: "Dabar pabandysime pasukti priekabą gerokai mažesnėje erdvėje.<br><br><font face=/font/big_bold.font>Pasiruošk važiuoti.</font>"

	key[]: "aca_msg_book1_3_18_backward"
	val[]: "Apsidairyk ir rask stovėjimo vietą už tavęs.<br><br><font face=/font/big_bold.font>Pradėk važiuoti atbulai į stovėjimo vietą.</font>"

	key[]: "aca_msg_book1_3_18_check1"
	val[]: "<font face=/font/big_bold.font>Įsuk priekabą į stovėjimo vietą. </font>"
#!{
	key[]: "aca_msg_book1_3_18_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_18_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}


#@}

#+ Book 1 Scenario 3_19
#@{

#### 3_19 common
	key[]: "aca_scenario_book1_3_19_title"
	val[]: "Baigiamasis egzaminas (1 dalis)"

	key[]: "aca_scenario_book1_3_19_desc"
	val[]: "Tavęs laukia baigiamasis egzaminas, kuriame bus išbandyti visi išmokti įgūdžiai. Važinėsime po visą mokymų centrą ir patikrinsime, kaip gerai išmokai iki šiol sutiktas situacijas.<br><br>Kai įveiksi visas dalis ir manevrus, būsi vienu žingsniu arčiau tikro sunkvežimio vairuotojo!"

