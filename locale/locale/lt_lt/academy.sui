#+ Book 1 Scenario 1_01
#@{

#### 1_01 common
	key[]: "aca_scenario_book1_1_01_title"
	val[]: "Prieš važiuojant"

	key[]: "aca_scenario_book1_1_01_desc"
	val[]: "Pirmame scenarijuje išnagrinėsime vairuotojo kabiną. Svarbu tinkamai susireguliuoti sėdynę, vairą ir veidrodėlius, nes tinkamas matomumas būtinas valdant sudėtingas ar įtemptas situacijas.<br><br>Apžiūrėsime šiuos reguliavimus po vieną."

#### 1_01 goal

	key[]: "aca_goal_book1_1_01_adjuster"
	val[]: "Sėdynės ir veidrodėlių reguliavimas"

	key[]: "aca_goal_book1_1_01_check_adj"
	val[]: "Veidrodėlių ir matomumo patikrinimas"

#### 1_01 msg - intro text

	key[]: "aca_msg_book1_1_01_cutscene1"
	val[]: "Sveikiname pirmoje pamokoje!<br>Pradėkime nuo sunkvežimio paruošimo keliui."

	key[]: "aca_msg_book1_1_01_cutscene2"
	val[]: "Būtina užtikrinti, kad tavo vairavimas būtų saugus, profesionalus ir visuomet valdomas.<br>Tinkamas sėdynių, vairo ir veidrodėlių sureguliavimas padės tau tai pasiekti."

	key[]: "aca_msg_book1_1_01_cutscene3"
	val[]: "Kiekvienoje sunkvežimio pusėje yra kelios mašinos.<br>Jos padės tau tinkamai susireguliuoti veidrodėlius."

	key[]: "aca_msg_book1_1_01_cutscene4"
	val[]: "Neskubėk ir sureguliuok viską taip, kaip tau patinka, nes šie nustatymai<br>labai smarkiai įtakos tavo gebėjimą valdyti sunkvežimį."

#### 1_01 Driving Instructions

	key[]: "adj_tut_title_0"
	val[]: "Sėdynės ir vairo reguliavimas"

	key[]: "adj_tut_title_1"
	val[]: "Pagrindinių veidrodėlių reguliavimas"

	key[]: "adj_tut_title_2"
	val[]: "Išgaubtų veidrodėlių reguliavimas"

	key[]: "adj_tut_title_3_hood"
	val[]: "Kapoto veidrodėlių reguliavimas"

	key[]: "adj_tut_title_3"
	val[]: "Matomumo patikrinimas ir galutinis veidrodėlių reguliavimas"

	key[]: "adj_tut_open_adj_keyboard"
	val[]: "spausk @@imv_nrm_adjuster@@ arba atidaryk iš sunkvežimio reguliavimų pauzės meniu"

	key[]: "adj_tut_open_adj_gamepad"
	val[]: "atidaryk iš sunkvežimio reguliavimų pauzės meniu"

	key[]: "adj_tut_open_adj"
	val[]: "Žaidimo metu \"@@adjust_link_t@@\" parodyti galima su $OPEN_ADJUSTER$."

	key[]: "adj_tut_open_seat"
	val[]: "Pirma sureguliuokime vairuotojo sėdynę ir vairą.<br><br><font face=/font/big_bold.font>Dabar atidaryk @@adj_seats@@.</font>"

	key[]: "adj_tut_open_mirrors"
	val[]: "<font face=/font/big_bold.font>Atidaryk @@adj_mirrors@@ kur pareguliuosi veidrodėlius. </font>"

	key[]: "adj_tut_open_adj_intro"
	val[]: "Pirmą kartą sėdant į sunkvežimį svarbu sureguliuoti sėdynę, vairą ir veidrodėlius.<br><br>Teisinga padėtis už vairo būtina geram matomumui. Visi mygtukai turi būti gerai pasiekiami, o vairuotojas turi aiškiai matyti į priekį, į šonus ir veidrodėlius.<br><br><font face=/font/big_bold.font>Reguliavimų meniu atidaryti galima su $OPEN_ADJUSTER$. </font>"

	key[]: "adj_tut_set_seat_and_back_adj"
	val[]: "@@adj_tut_set_seat_and_back_adj_img@@<br>Pareguliuok sėdynę taip, kad aiškiai matytum aplinką ir veidrodėlius, ir kad pasiektum visus mygtukus.<br><br>Sureguliuok vairą taip, kad jis būtų patogioje padėtyje ir neužstotų prietaisų.<br><br><font face=/font/big_bold.font>Kai viską sureguliuosi, spausk @@imv_nrm_back@@ ir grįši į reguliavimų meniu. </font>"

	key[]: "adj_tut_open_mirrors_intro"
	val[]: "@@adj_tut_open_mirrors_intro_img@@<br>Sunkvežimiai turi daug didelių aklų zonų, todėl jie turi kelis išorinius veidrodėlius, padedančių vairuotojui matyti kuo daugiau. <br><br>Tinkamas šių veidrodėlių reguliavimas leis tau gerai matyti aplinką.<br><br><font face=/font/big_bold.font>Toliau atidaryk @@adj_mirrors@@.</font>"

	key[]: "adj_tut_set_mirrors_t1_1_adj"
	val[]: "@@adj_tut_set_mirrors_t1_1_adj_img@@<br>Pagrindiniai veidrodėliai rodo vaizdą sunkvežimio ir priekabos šonuose.<br><br>Reguliuojant pagrindinių veidrodėlių vaizdą galima panaudoti greta sunkvežimio stovinčias mašinas.<br><br><font face=/font/big_bold.font>Toliau spausk @@imv_nrm_selectfcs@@.</font>"

	key[]: "adj_tut_set_mirrors_t1_2_adj"
	val[]: "Pagrindiniai veidrodžiai yra tavo pagrindinis įrankis matyti, kas vyksta greta ir už tavęs. Turėtum gerai matyti mašiną greta, bet taip pat ir truputį priekabos, kad galėtum tiksliai nuspręsti aplink esančių kliūčių padėtį."

	key[]: "adj_tut_set_mirrors_t1_2_adj_big"
	val[]: "Kai sureguliuosi šį veidrodėlį persijunk į keleivio pusės pagrindinį veidrodėlį."

	key[]: "adj_tut_set_mirrors_t1_2_adj_moved"
	val[]: "Turėtum veidrodėlyje gerai matyti greta stovintį automobilį, taip pat šiek tiek priekabos."

	key[]: "adj_tut_set_mirrors_t1_2_adj_moved_big"
	val[]: "Kai sureguliuosi šį veidrodėlį persijunk į vairuotojo pusės lenktąjį veidrodėlį."

	key[]: "adj_tut_set_mirrors_t1_3_adj"
	val[]: "@@adj_tut_set_mirrors_t1_3_adj_img@@<br>Išgaubti veidrodėliai parodo platesnį vaizdą šalia sunkvežimio.<br><br><font face=/font/big_bold.font>Toliau spausk @@imv_nrm_selectfcs@@.</font>"

	key[]: "adj_tut_set_mirrors_t1_4_adj"
	val[]: "Turėtum veidrodėlyje gerai matyti greta stovintį automobilį ir sunkvežimį, taip pat truputėlį savo sunkvežimio."

	key[]: "adj_tut_set_mirrors_t1_4_adj_big"
	val[]: "Kai sureguliuosi šį veidrodėlį persijunk į keleivio pusės lenktąjį veidrodėlį."

	key[]: "adj_tut_set_mirrors_t1_4_adj_moved"
	val[]: "Turėtum veidrodėlyje gerai matyti greta stovintį automobilį ir sunkvežimį, taip pat truputėlį savo sunkvežimio."

	key[]: "adj_tut_set_mirrors_t1_4_adj_moved_big"
	val[]: "Kai sureguliuosi šį veidrodėlį persijunk į variklio dangčio veidrodėlį."

	key[]: "adj_tut_set_mirrors_t1_5_adj"
	val[]: "@@adj_tut_set_mirrors_t1_5_adj_img@@<br>Kapoto veidrodėliai leidžia kitaip pažvelgti į aklas zonas abiejose sunkvežimio pusėse, pamatyti nedideles mašinas ir kliūtis, kurių kitaip nesimato dėl sunkvežimio dydžio.<br><br><font face=/font/big_bold.font>Spausk @@imv_nrm_selectfcs@@ tęsti.</font>"

	key[]: "adj_tut_set_mirrors_t1_6_adj"
	val[]: "@@adj_tut_set_mirrors_t1_6_adj_img@@<br>Kadangi turi kitus veidrodėlius, rodančius vaizdą už tavęs, šie yra skirti parodyti tai, kas yra šalia. Kapoto ir šoninių veidrodėlių rėmai yra geras atskaitos taškas, kiek turėtum matyti savo sunkvežimio. Pareguliuok veidrodėlius pagal diagramą.<br><br><font face=/font/big_bold.font>Kai sureguliuosi, persijunk į keleivio pusės kapoto veidrodėlį.. </font>"

	key[]: "adj_tut_set_mirrors_t1_6_adj_moved"
	val[]: "@@adj_tut_set_mirrors_t1_6_adj_moved_img@@<br>Lygiai taip pat pareguliuok šį veidrodėlį.<br><br><font face=/font/big_bold.font>Kai sureguliuosi, spausk @@imv_nrm_back@@ uždaryti veidrodėlių nustatymus. </font>"

	key[]: "adj_tut_back_adj"
	val[]: "<font face=/font/big_bold.font>Spausk @@imv_nrm_back@@ grįžti į konfigūravimo meniu. </font>"

	key[]: "adj_tut_close_adj"
	val[]: "Puiku, sureguliavus sėdynę ir veidrodėlius žengtas dar vienas žingsnis iki važiavimo!<br><br><font face=/font/big_bold.font>Uždaryk konfigūravimo meniu su @@imv_nrm_back@@. </font>"

	key[]: "adj_tut_open_con"
	val[]: "Dar kartą apsidaryk, patikrink ar gerai viską matai, ir kad veidrodėliuose matai sunkvežimio aplinką.<br><br>Jei kažkas netinka, gali pareguliuoti veidrodėlius \"@@adjust_link_t@@\" meniu.<br><br><font face=/font/big_bold.font>Spausk @@imv_nrm_activate@@ užbaigti pirmą scenarijų.</font> @@aca_goal_tip@@ Virtualius veidrodėlius parodyti ar paslėpti gali per \"@@adjust_link_t@@\" — \"@@adj_ui_mirrors@@\" pauzės meniu. Virtualūs veidrodėliai padeda matyti keleivio pusę."
#@}

