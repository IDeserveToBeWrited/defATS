#+ Book 1 intro
#@{

	key[]: "aca_scenario_book1_intro_title"
	val[]: "Sunkvežimio vairavimo pagrindai"

	key[]: "aca_msg_book1_intro_cutscene01"
	val[]: "Sveikiname, čia @@driving_academy@@."

	key[]: "aca_msg_book1_intro_cutscene02"
	val[]: "Šie scenarijai yra pirmi žingsniai tavo kelionėje į profesionalų sunkvežimio valdymą."

	key[]: "aca_msg_book1_intro_cutscene03"
	val[]: "Čia išmoksi visko nuo pagrindinių sistemų ir sunkvežimio valdymo..."

	key[]: "aca_msg_book1_intro_cutscene04"
	val[]: "...iki sudėtingų manevrų ir be, ir su priekaba."

	key[]: "aca_msg_book1_intro_cutscene05"
	val[]: "Padėsime išugdyti įpročius, kurie padės saugiai įveikti įvairias situacijas,"

	key[]: "aca_msg_book1_intro_cutscene06"
	val[]: "ir išmokysime išmintingai naudoti erdvę efektyviai manevruoti sunkvežimiu."

	key[]: "aca_msg_book1_intro_cutscene07"
	val[]: "Užbaigus visus scenarijus ir įveikus baigiamąjį egzaminą,"

	key[]: "aca_msg_book1_intro_cutscene08"
	val[]: "galėsi traukti į Amerikos kelius ir ieškoti naujų iššūkių."

#@}

