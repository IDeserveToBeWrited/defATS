#### night_slalom_double into text

	key[]: "aca_msg_book3_night_slalom_cutscene01"
	val[]: "Trasoje priekyje yra keli skirtingo sudėtingumo slalomai."

	key[]: "aca_msg_book3_night_slalom_cutscene02"
	val[]: "Neskubėk ir atmink planuoti į priekį."

	key[]: "aca_msg_book3_night_slalom_cutscene03"
	val[]: "Gali būti vietų, kur turėsi važiuoti labai lėtai ir tiksliai. <br><br>Neskubėk!"


#### night_slalom_double driving instructions

#!{
	key[]: "aca_msg_book3_night_slalom_double_check1"
	val[]: "@@aca_goal_book3_sup_check1@@"

	key[]: "aca_msg_book3_night_slalom_double_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
#!}
