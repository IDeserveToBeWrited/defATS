#### 3_03 msg - intro text

	key[]: "aca_msg_book1_3_03_cutscene01"
	val[]: "Edessä on erilaisia haastavia käännöksiä ja esteitä.<br>Tämän ei pitäisi olla liian vaikeaa, kunhan muistat kaiken aiemmin oppimasi."

	key[]: "aca_msg_book1_3_03_cutscene02"
	val[]: "Ensimmäinen käännös on helppo koukkukäännös. Sen pitäisi onnistua, kunhan otat leveän ajolinjan."

	key[]: "aca_msg_book1_3_03_cutscene03"
	val[]: "Jatka eteenpäin kohti liikenneympyrää."

	key[]: "aca_msg_book1_3_03_cutscene04"
	val[]: "Aja vetoautolla mahdollismman leveältä, jotta saat pidettyä perävaunun pois liikenneympyrän keskeltä."

	key[]: "aca_msg_book1_3_03_cutscene05"
	val[]: "The 90-degree turn to the left isn't particularly tight, but be sure not to hit any cones."

	key[]: "aca_msg_book1_3_03_cutscene06"
	val[]: "Tämä käännös on huomattavasti tiukempi. Tee kannunkahvakäännös selvitäksesi siitä."

	key[]: "aca_msg_book1_3_03_cutscene07"
	val[]: "Voit käyttää koukkukäännöstä tässä, mutta sinun tulee varoa muutamia ylimääräisiä esteitä."

	key[]: "aca_msg_book1_3_03_cutscene09"
	val[]: "Jälleen kerran, viimeinen käännös on erittäin tiukka ja vaatii onnistuakseen yhdistelmän kannunkahva- ja koukkukäännöksiä."

	key[]: "aca_msg_book1_3_03_cutscene10"
	val[]: "Park in the designated area, secure the truck and shut down the engine."


#### 3_03 Driving Instructions



	key[]: "aca_msg_book1_3_03_forward"
	val[]: "<font face=/font/big_bold.font>Jatka ensimmäiseen käännökseen. </font>"

	key[]: "aca_msg_book1_3_03_check1"
	val[]: "Ensimmäinen käännös on helppo koukkukäännös.<br><br><font face=/font/big_bold.font><color value=@@clr_txt@@>Jatka käännöksen läpi. </font>"

	key[]: "aca_msg_book1_3_03_check2"
	val[]: "Jatka liikenneympyrään. Muista ottaa leveä ajolinja.<br><br><font face=/font/big_bold.font>Aja liikenneympyrään.</font>"

	key[]: "aca_msg_book1_3_03_check3"
	val[]: "This 90-degree turn is a bit tighter, be careful not to hit any cones.<br><br><font face=/font/big_bold.font>Make the turn.</font>"

	key[]: "aca_msg_book1_3_03_check4"
	val[]: "Tätä käännöstä on paras lähestyä kannunkahvamaisesti. Koukkaa leveästi ennen risteysalueelle ajamista.<br><br><font face=/font/big_bold.font>Tee kannunkahvakäännös. </font>"

	key[]: "aca_msg_book1_3_03_check5"
	val[]: "Tässä käännöksessä on useita erilaisia esteitä, mutta voit selvitä siitä koukkukäännöksellä.<br><br><font face=/font/big_bold.font>Jatka varoen. </font>"

	key[]: "aca_msg_book1_3_03_check6"
	val[]: "Tämä on tiukin käännös tähän asti. Aja siitä kuten parhaaksi näet.<br><br><font face=/font/big_bold.font>Käänny pysäköintialueelle.</font>"
#!{
	key[]: "aca_msg_book1_3_03_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_03_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

