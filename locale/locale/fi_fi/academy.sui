#@{

#### 2_02 common
	key[]: "aca_scenario_book1_2_02_title"
	val[]: "Ajoliikkeiden yhdistelmä"

	key[]: "aca_scenario_book1_2_02_desc"
	val[]: "In this scenario, we'll combine your newly learned skills to negotiate a short but technical course that will involve reversing into a turn and managing a tight 90-degree corner."

#### 2_02 goal
#!{
	key[]: "aca_goal_book1_2_02_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_02_check1"
	val[]: "@@aca_goal_book1_1_03_forward@@"

	key[]: "aca_goal_book1_2_02_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

#!}
	key[]: "aca_goal_book1_2_02_check2"
	val[]: "Kuljettajan puolelle peruuttaminen"

	key[]: "aca_goal_book1_2_02_check3"
	val[]: "90 asteen käännös"

	key[]: "aca_goal_book1_2_02_check4"
	val[]: "Käännöksen suorittaminen"



#### 2_02 msg - intro text

	key[]: "aca_msg_book1_2_02_cutscene1"
	val[]: "Edessäsi on este. Aja sen luokse ja pysähdy."

	key[]: "aca_msg_book1_2_02_cutscene2"
	val[]: "Kuljettajan puolella kuorma-auton takana on toinen este. Peruuta kaarre sen luokse. Voit käyttää tiemerkintöjä apunasi."

	key[]: "aca_msg_book1_2_02_cutscene3"
	val[]: "Directly ahead, there is a sharp 90-degree turn. Drive towards it."

	key[]: "aca_msg_book1_2_02_cutscene4"
	val[]: "Sinun tulee ajaa pitkälle mutkaan, jotta takarenkaat eivät osu sisämutkan kartioon.<br>Käytä peilejäsi!"

	key[]: "aca_msg_book1_2_02_cutscene5"
	val[]: "Suorista, aja kohti viimeisiä esteitä, pysähdy sitten ja varmista kuorma-auto."

#### 2_02 Driving Instructions

	key[]: "aca_msg_book1_2_02_start"
	val[]: "<font face=/font/big_bold.font>Valmistaudu liikkeellelähtöön. </font>"

	key[]: "aca_msg_book1_2_02_start_fail"
	val[]: "Kuorma-auto ei vieläkään ole valmis lähtöön. Oletko kenties unohtanut jotain?<br><br>Onko moottori käynnissä? Oletko vapauttanut käsijarrun?"

	key[]: "aca_msg_book1_2_02_check1"
	val[]: "Suoraan edessäsi juuri ennen estettä on merkitty paikka.<br><br><font face=/font/big_bold.font>Aja eteenpäin ja pysähdy merkitylle paikalle. </font>"

	key[]: "aca_msg_book1_2_02_check2"
	val[]: "Katso taaksesi kuljettajan puolelle; Näet siellä toisen merkityn paikan. Sinun tulee peruuttaa ja kääntää samanaikaisesti.<br><br><font face=/font/big_bold.font>Peruuta kaarteen mukaisesti ja pysähdy merkittyyn paikkaan. </font>"

	key[]: "aca_msg_book1_2_02_check3"
	val[]: "@@aca_msg_book1_2_02_check3_img@@ <br>The course continues ahead of you through a 90-degree turn.<br><br>Stay to the left side before the turn, drive deep into the corner and turn quickly and sharply. Be sure not to hit the inside traffic cone.<br><br><font face=/font/big_bold.font>Drive forwards and make the turn. </font>"

	key[]: "aca_msg_book1_2_02_check4"
	val[]: "@@aca_msg_book1_2_02_check3_img@@ <br>Käytä sivupeilejä varmistaaksesi ettet osu mihinkään.<br><br><font face=/font/big_bold.font>Suorita käännös loppuun ja pysähdy kohdealueelle. </font>"

	key[]: "aca_msg_book1_2_02_end"
	val[]: "<font face=/font/big_bold.font>Varmista kuorma-auto ja sammuta moottori.</font>"
#@}

