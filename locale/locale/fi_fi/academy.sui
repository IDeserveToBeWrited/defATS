 #!}

	key[]: "aca_goal_book1_3_11_check1"
	val[]: "Liikenneympyrään ajaminen"

	key[]: "aca_goal_book1_3_11_check2"
	val[]: "Liikenneympyrässä ajaminen"

	key[]: "aca_goal_book1_3_11_check3"
	val[]: "Liikenneympyrässä ajaminen"

	key[]: "aca_goal_book1_3_11_check5"
	val[]: "Liikenneympyrästä poistuminen"

	key[]: "aca_goal_book1_3_11_check6"
	val[]: "Kohdealueelle ajaminen"

#### 3_11 msg - intro text

	key[]: "aca_msg_book1_3_11_cutscene1"
	val[]: "Liikenneympyrät alkavat yleistyä Amerikassa, joten on tärkeää tietää kuinka niistä ajetaan."

	key[]: "aca_msg_book1_3_11_cutscene3"
	val[]: "Pysy kaistan ulkoreunassa lähestyessäsi liikenneympyrää. Näin perävaunusi ei osu sisäkaarteeseen ensimmäisessä käännöksessä."

	key[]: "aca_msg_book1_3_11_cutscene4"
	val[]: "Aja kohti keskustaa ajaessasi liikenneympyrään. Kun olet ympyrässä, tulee sinun siirtyä kohti ulkoreunaa. Näin saat pidettyä perävaunusi poissa liikenneympyrän keskeltä."

	key[]: "aca_msg_book1_3_11_cutscene5"
	val[]: "Tarkkaile peilejäsi varmistuaksesi, että perävaunu ei ajaudu liian lähelle keskellä olevia esteitä."

	key[]: "aca_msg_book1_3_11_cutscene6"
	val[]: "Liikenneympyrästä poistuminen on melko helppoa, sillä perävaunusi osoittaa jo pois ympyrän keskustasta. Kaarra leveästi poistuessasi ja perävaunusi pitäisi seurata sinua hienosti."

	key[]: "aca_msg_book1_3_11_cutscene7"
	val[]: "Pysäköi kohdealueelle ja varmista kuorma-auto."



#### 3_11 Driving Instructions
#!{
	key[]: "aca_msg_book1_3_11_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

	key[]: "aca_msg_book1_3_11_forward"
	val[]: "Edessäsi on sinua varten tehty liikenneympyrä. <br><br><font face=/font/big_bold.font>Lähesty liikenneympyrää hitaasti. </font>"

	key[]: "aca_msg_book1_3_11_check1"
	val[]: "Tee laava käännös kun ajat liikenneympyrään, jotta perävaunusi seuraa perässäsi ongelmitta. <br><br><font face=/font/big_bold.font>Aja liikenneympyrään. </font>"

	key[]: "aca_msg_book1_3_11_check2"
	val[]: "Aja kohti liikenneympyrän ulkoreunaa. Sinun tulee pitää kuorma-auto mahdollisimman kaukana liikenneympyrän keskustasta estääksesi perävaunuasi osumasta esteisiin keskellä. <br><br><font face=/font/big_bold.font>Jatka liikenneympyrässä ajamista.</font>"

	key[]: "aca_msg_book1_3_11_check3"
	val[]: "Pysyttele ulkoreunan kartioiden lähellä. <br><br><font face=/font/big_bold.font>Jatka ajamista.</font>"

	key[]: "aca_msg_book1_3_11_check5"
	val[]: "<font face=/font/big_bold.font>Poistu liikenneympyrästä.</font>"

	key[]: "aca_msg_book1_3_11_check6"
	val[]: "<font face=/font/big_bold.font>Jatka kohti edessäsi olevaan pysäköintipaikkaa.</font>"

	key[]: "aca_msg_book1_3_11_stop"
	val[]: "<font face=/font/big_bold.font>Pysähdy kohdealueelle.</font>"

	key[]: "aca_msg_book1_3_11_end"
	val[]: "<font face=/font/big_bold.font>Varmista kuorma-auto ja sammuta moottori.</font>"
#@}

#+ Book 1 Scenario 3_12
#@{

#### 3_12 common
	key[]: "aca_scenario_book1_3_12_title"
	val[]: "Käsittely ahtaassa tilassa"

	key[]: "aca_scenario_book1_3_12_desc"
	val[]: "Tässä tehtävässä sinun tulee kääntää kuorma-auto ympäri ahtaassa paikassa, mikä vaatii ympäristön huomioimista sekä tilan järkevää hyödyntämistä."

#### 3_12 goal



	key[]: "aca_goal_book1_3_12_check1"
	val[]: "Peruuttamiseen valmistautuminen"

	key[]: "aca_goal_book1_3_12_check2"
	val[]: "Alueelta poistuminen"

	key[]: "aca_goal_book1_3_12_check3"
	val[]: "Paikkaan peruuttaminen"

	key[]: "aca_goal_book1_3_12_check4"
	val[]: "Peruuttaminen apukuskin puolelle"
