#### 3_04 msg - intro text

	key[]: "aca_msg_book1_3_04_cutscene01"
	val[]: "Muista suunnitella jokainen käännös etukäteen ja hyödynnä käytettävissäsi oleva tila. Jatka ensimmäisten esteiden ohi radalle."

	key[]: "aca_msg_book1_3_04_cutscene02"
	val[]: "Muutamat ensimmäiset käännökset muuttuvat vähitellen tiukemmiksi."

	key[]: "aca_msg_book1_3_04_cutscene03"
	val[]: "Muista että se, miten poistut käännöksestä vaikuttaa siihen, miten ajat seuraavaan käännökseen."

	key[]: "aca_msg_book1_3_04_cutscene04"
	val[]: "Ensimmäinen hieman haastavammista käännöksistä yhdistää kaksi neulansilmää yhdeksi. Sinun tulee ajaa erittäin varovaisesti ja harkitusti, sekä käyttää peilejä hyödyksesi."

	key[]: "aca_msg_book1_3_04_cutscene05"
	val[]: "Jatka kapean osuuden läpi."

	key[]: "aca_msg_book1_3_04_cutscene06"
	val[]: "Seuraavaksi on muutama helppo mutka ennen tiukkaa neulansilmää."

	key[]: "aca_msg_book1_3_04_cutscene07"
	val[]: "Katsele jatkuvasti ympärillesi varmistaaksesi, ettet törmää esteisiin. Etene niin hitaasti kuin tilanne vaatii."

	key[]: "aca_msg_book1_3_04_cutscene08"
	val[]: "Vaikka näyttäisi, että tilaa on paljon, saatat silti päätyä ahtaaseen tilanteeseen."

	key[]: "aca_msg_book1_3_04_cutscene09"
	val[]: "Edessä on hankalin käännös. Sisääntulosi käännökseen ratkaisee, selviätkö käännöksestä kunnialla vai et."

	key[]: "aca_msg_book1_3_04_cutscene10"
	val[]: "Jatka kohti viimeistä käännöstä."

	key[]: "aca_msg_book1_3_04_cutscene11"
	val[]: "Stop in the designated area, secure the truck and shut down the engine."
#!{
	key[]: "aca_msg_book1_3_04_cutscene12"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_04_cutscene13"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_04_cutscene14"
	val[]: "Unused"
#!}

#### 3_04 Driving Instructions



	key[]: "aca_msg_book1_3_04_forward"
	val[]: "<font face=/font/big_bold.font>Kiihdytä ja aja esteiden ympäri. </font>"

	key[]: "aca_msg_book1_3_04_check1"
	val[]: "Jatka radalle ja kahdesta ensimmäisestä helposta käännöksestä.<br><br><font face=/font/big_bold.font>Jatka ajamista. </font>"

	key[]: "aca_msg_book1_3_04_check2"
	val[]: "<font face=/font/big_bold.font>Suorita 90 asteen käännös.</font>"

	key[]: "aca_msg_book1_3_04_check3"
	val[]: "Radan seuraava osuus on kaksoisneulansilmä. Suoriutuminen ensimmäisestä osasta vaikuttaa suoraan ajolinjaasi seuraavassa osassa.<br><br><font face=/font/big_bold.font>Jatka varoen. </font>"

	key[]: "aca_msg_book1_3_04_check4"
	val[]: "Poistuessasi neulansilmistä, pysy vasemmalle valmistautuaksesi kapealle osuudelle siirtymiseen.<br><br><font face=/font/big_bold.font>Jatka ajamista. </font>"

	key[]: "aca_msg_book1_3_04_check5"
	val[]: "<font face=/font/big_bold.font>Jatka kapean osuuden läpiajamista. </font>"

	key[]: "aca_msg_book1_3_04_check6"
	val[]: "Ahead is a couple of easy 90-degree turns.<br><br><font face=/font/big_bold.font>Make the turns. </font>"

	key[]: "aca_msg_book1_3_04_check7"
	val[]: "Lähestyt jälleen neulansilmää. Seuraa peileistä perävaunuasi lähestyessäsi. <br><br><font face=/font/big_bold.font>Aja neulansilmästä. </font>"

	key[]: "aca_msg_book1_3_04_check8"
	val[]: "The 90-degree turn ahead is much tighter than it looks. Use your space wisely.<br><br><font face=/font/big_bold.font>Continue driving. </font>"

	key[]: "aca_msg_book1_3_04_check9"
	val[]: "Viimeinen neulansilmä on haastava, eikä ylimääräistä tilaa juuri ole. <br><br><font face=/font/big_bold.font>Jatka varovasti.</font>"

	key[]: "aca_msg_book1_3_04_check10"
	val[]: "One final 90-degree turn awaits you.<br><br><font face=/font/big_bold.font>Continue Driving. </font>"

	key[]: "aca_msg_book1_3_04_check11"
	val[]: "Jatka kohdealueelle."
