#### 3_02 msg - intro text

	key[]: "aca_msg_book1_3_02_cutscene01"
	val[]: "Tässä tehtävässä lähdemme pienelle ajelulle. Saat tuntumaa jarruttamiseen perävaunun kanssa kun laskeudumme loivaa mäkeä. Valmistele kuorma-auto ja lähde liikkeelle."

	key[]: "aca_msg_book1_3_02_cutscene06"
	val[]: "Saavuta vähintään 60km/h (37mph) nopeus. Valmistaudu edessä olevaan jarrutusalueeseen."

	key[]: "aca_msg_book1_3_02_cutscene08"
	val[]: "Aloita jarruttamaan pysähtyäksesi. Varo ettet odota liian pitkään tai saatat osua edessäsi oleviin esteisiin!"

	key[]: "aca_msg_book1_3_02_cutscene10"
	val[]: "Pysäköi kohdealueelle, varmista sitten kuorma-auto ja sammuta moottori."


#### 3_02 Driving Instructions

	key[]: "aca_msg_book1_3_02_start"
	val[]: "Tämän ajon aikana saat tuntuman käyttöjarrujen käyttämiseen alamäessä. Harjoituksen tarkoitus on ymmärtää takanasin oleva paino ja sen vaikutus kuorma-auton jarrutusmatkaan.<br><br><font face=/font/big_bold.font>Valmistaudu liikkeellelähtöön. </font>"

	key[]: "aca_msg_book1_3_02_forward"
	val[]: "Lähde liikkeelle nyt ja muista, että sinun tulee saavuttaa 60km/h (37pmh) nopeus edessä olevan käännöksen <font face=/font/big_bold.font>jälkeen</font>.<br><br><font face=/font/big_bold.font>Aja kohti edessä olevaa käännöstä. </font>"

	key[]: "aca_msg_book1_3_02_check1"
	val[]: "Käänny oikealle ja kiihdytä vauhtisi 60 km/h (37mph).<br><br><font face=/font/big_bold.font>Jatka ajamista. </font>"

	key[]: "aca_msg_book1_3_02_check2"
	val[]: "<font face=/font/big_bold.font>Saavuta vähintään 60 km/h (37 mph) nopeus. </font>"

	key[]: "aca_msg_book1_3_02_check3"
	val[]: "Olet saavuttanut tavoitenopeuden.<br><br><font face=/font/big_bold.font>Pysähdy edessä oleville esteille. </font>"
#!{
	key[]: "aca_msg_book1_3_02_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_02_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

