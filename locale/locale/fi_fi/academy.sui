#### common
	key[]: "aca_scenario_book2_training_course_title"
	val[]: "Tehtaan varjossa"

	key[]: "aca_scenario_book2_training_course_desc"
	val[]: "Tässä tehtävässä ajat teollisen harjoitteluradan läpi."

#### intro text

	key[]: "aca_scenario_book2_training_course_cutscene1"
	val[]: "Harjoitteluradan vaikeusaste vaihtelee radan edetessä."

	key[]: "aca_scenario_book2_training_course_cutscene2"
	val[]: "Aja jokaisen osion läpi niin nopeasti kuin se on turvallisesti mahdollista ja muista suunnitella seuraavat liikkeesi etukäteen!"



#@}

#+ Book 2 reverse_parking
#@{
#### common
	key[]: "aca_scenario_book2_reverse_parking_title"
	val[]: "Pysäköinti peruuttaen kulman taakse"

	key[]: "aca_scenario_book2_reverse_parking_desc"
	val[]: "Tässä tehtävässä sinun tulee peruuttaa kuorma-autosi pysäköintipaikkaan kulman takana apukuskin puolella."

#### intro text

	key[]: "aca_scenario_book2_reverse_parking_cutscene1"
	val[]: "Purkualueet eivät aina ole ihanteellisissa paikoissa. Tässä tapauksessa se on piilossa vieressäsi olevan rakennuksen takana."

	key[]: "aca_scenario_book2_reverse_parking_cutscene2"
	val[]: "Peruuta rakennuksen ympäri pysäköintipaikkaan."

#@}


#+ Book 2 blindside_parking
#@{
#### common
	key[]: "aca_scenario_book2_blindside_parking_title"
	val[]: "Peruuttaminen apukuskin puolelle"

	key[]: "aca_scenario_book2_blindside_parking_desc"
	val[]: "Tässä tehtävässä peruutamme jälleen apukuskin puolelle. Ihanteellisissakin olosuhteissa tämä on hankala toimenpide, mutta nyt joudut haastavampien säiden armoille."

#### intro text

	key[]: "aca_scenario_book2_blindside_parking_cutscene1"
	val[]: "Edessäsi oikealla on pysäköintipaikka, jonne sinun tulee peruuttaa. Aja reilusti sen ohi ja peruuta sitten pysäköintipaikkaan."

	key[]: "aca_scenario_book2_blindside_parking_cutscene2"
	val[]: "Sinulla on aikaisempaa vähemmän tilaa, joten ohjausliikkeesi tulee olla tarkkoja ja harkittuja."

#@}


#+ Book 2 advanced_alley_parking
#@{
#### common
	key[]: "aca_scenario_book2_advanced_alley_parking_title"
