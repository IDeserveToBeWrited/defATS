#### 2_05 msg - intro text

	key[]: "aca_msg_book1_2_05_cutscene1"
	val[]: "Tässä tehtävässä pysäköimme peruuttaen reunakiveyksen viereen."

	key[]: "aca_msg_book1_2_05_cutscene2"
	val[]: "Peruuta kohti reunakiveystä.<br>Sinun tulee tarkkailla ympäristöäsi peruuttaessa, joten käytä pelejäsi."

	key[]: "aca_msg_book1_2_05_cutscene3"
	val[]: "Kun lähestyt, voit alkaa kääntää kuorma-autoasi kohti pysäköintipaikkaa. Tarkkaile kuorma-autosi molempia sivuja peruuttaessasi."

	key[]: "aca_msg_book1_2_05_cutscene4"
	val[]: "Pysähdy pysäköintipaikkaan ja varmista kuorma-auto."

#### 2_05 Driving Instructions

	key[]: "aca_msg_book1_2_05_start"
	val[]: "Pysäköintipaikka on takanasi apukuskin puolella. Käytä peilejäsi ajaessasi kohti paikkaa.<br><br><font face=/font/big_bold.font>Valmistaudu liikkeellelähtöön. </font>"

	key[]: "aca_msg_book1_2_05_backward"
	val[]: "Muista tarkistaa peileistä ympäristösi ennen kuorma-auton siirtämistä.<br><br><font face=/font/big_bold.font>Lähde peruuttamaan kohti reunakiveystä. </font>"

	key[]: "aca_msg_book1_2_05_stop"
	val[]: "Jatka ympäristösi tarkkailemista kun peruutat pysäköintipaikkaan.<br><br><font face=/font/big_bold.font>Pysäytä kohdealueelle. </font>"
#!{
	key[]: "aca_msg_book1_2_05_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

