#+ Book 1 Scenario 3_09
#@{

#### 3_09 common
	key[]: "aca_scenario_book1_3_09_title"
	val[]: "Vinoparkkeeraus"

	key[]: "aca_scenario_book1_3_09_desc"
	val[]: "Tässä tehtävässä ajat vinoparkkiin vilkkaalla alueella. <br><br>Täällä ei ole ylimääräistä tilaa, joten sinun tulee ajaa tarkasti ja harkitusti."

#### 3_09 goal

	key[]: "aca_goal_book1_3_09_check1"
	val[]: "Pysäköintipaikan lähestyminen"
#!{
	key[]: "aca_goal_book1_3_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_09_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_09_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
 #!}
#### 3_09 msg - intro text

	key[]: "aca_msg_book1_3_09_cutscene1"
	val[]: "Tämänkaltaiset vinoparkit ovat erittäin yleisiä. Saatat nähdä sellaisia levähdysalueilla tai rekkaparkeissa ympäri Amerikkaa. <br>Meidän täytyy jälleen kerran ajaa keula edellä pysäköintipaikkaan."

	key[]: "aca_msg_book1_3_09_cutscene2"
	val[]: "Aja kohti merkittyä pysäköintipaikkaa lähellä rivin päätä."

	key[]: "aca_msg_book1_3_09_cutscene3"
	val[]: "Pysyttele kaistan keskellä tai hieman vasemmalla puolella. Sinun kannattaa jättää tilaa ohjata perävaunu pysäköintipaikkaan."

	key[]: "aca_msg_book1_3_09_cutscene4"
	val[]: "Aja reilusti pysäköintipaikan ohi ja käännä sitten tiukasti ja nopeasti kohti paikkaa. Sinun tulee varmistaa sivupeileistäsi, että perävaunusi osuu turvallisesti pysäköintiruutuun."

	key[]: "aca_msg_book1_3_09_cutscene5"
	val[]: "Pysähdy merkitylle alueelle, varmista kuorma-auto ja sammuta moottori."


#### 3_09 Driving Instructions

	key[]: "aca_msg_book1_3_09_start"
	val[]: "@@aca_msg_book1_3_09_start_img@@<br>Vinoon parkkeeratessa on tärkeä arvioida tarkasti sijaintisi. Kun olet puolimatkassa, on hankalaa peruuttaa ja sijoittautua uudelleen, joten heti aluksi on syytä varmistua, että sinulla on riittävästi tilaa.<br><br><font face=/font/big_bold.font>Valmistaudu liikkeellelähtöön. </font>"

	key[]: "aca_msg_book1_3_09_forward"
	val[]: "<font face=/font/big_bold.font>Lähde ajamaan kohti pysäköintipaikkaa. </font>"

	key[]: "aca_msg_book1_3_09_check1"
	val[]: "Aja pysäköintipaikan ohi niin, että perävaunullasi on tilaa kääntyä kuorma-autosi viereen.<br><br><font face=/font/big_bold.font>Käänny pysäköintipaikkaan. </font>"
#!{
	key[]: "aca_msg_book1_3_09_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}

#@}

#+ Book 1 Scenario 3_10
#@{

#### 3_10 common
	key[]: "aca_scenario_book1_3_10_title"
	val[]: "Peruuttaminen apukuskin puolelle"

	key[]: "aca_scenario_book1_3_10_desc"
	val[]: "Tässä tehtävässä harjoittelemme peruuttamista pysäköintipaikkaan apukuskin puolella. Sinun tulee luottaa peileihisi päästäksesi minne haluat, sillä et voi katsoa ulos ikkunasta."

#### 3_10 goal
#!{
	key[]: "aca_goal_book1_3_10_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_10_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_10_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_10_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

 #!}
#### 3_10 msg - intro text

	key[]: "aca_msg_book1_3_10_cutscene1"
	val[]: "Tässä tehtävässä opit peruuttamaan apukuskin puolelle. Tätä tulisi käyttää vain jos muuta vaihtoehtoa ei ole, sillä näkyvyytesi on erittäin rajoitettu. Aja rauhassa ja ole mieluummin liian varovainen."

	key[]: "aca_msg_book1_3_10_cutscene2"
	val[]: "Aja reilusti pysäköintipaikan ohi, jotta saat riittävästi tilaa aloittaessasi peruuttamisen."

	key[]: "aca_msg_book1_3_10_cutscene3"
	val[]: "Pysähdy, tarkista ympäristösi ja aloita sitten peruuttaminen."

	key[]: "aca_msg_book1_3_10_cutscene4"
	val[]: "Käännä vetoauto pois päin paikasta työntääksesi perävaunun etupäätä ohjaten takapään kohti haluamaasi pysäköintipaikkaa. Varo liioittelemasta ohjausliikettä tai saatat saada yhdistelmän linkkuun."

	key[]: "aca_msg_book1_3_10_cutscene5"
	val[]: "Aloita kuorma-auton oikaiseminen kun perävaunu osuu pysäköintipaikkaan."

	key[]: "aca_msg_book1_3_10_cutscene6"
	val[]: "Pysähdy kohdealueelle ja varmista kuorma-auto."

#### 3_10 Driving Instructions

	key[]: "aca_msg_book1_3_10_start"
	val[]: "Peruuttaminen apukuskin puolelle vaatii samat toimenpiteet kuin toisellekin puolelle peruutettaessa, mutta rajoitettu näkyvyys lisää haastetta. Käytä peilejäsi ja arviointikykyäsi pysäköidäksesi kuorma-auton.<br><br><font face=/font/big_bold.font>Valmistaudu liikkeellelähtöön. </font>"

	key[]: "aca_msg_book1_3_10_forward"
	val[]: "Edessäsi oikealla on pysäköintipaikka. Sinun tulee ajaa reilusti sen ohi, jotta sinulle jää riittävästi tilaa ohjata kun peruutat.<br><br><font face=/font/big_bold.font>Aja eteenpäin. </font>"
#!{
	key[]: "aca_msg_book1_3_10_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
	key[]: "aca_msg_book1_3_10_check2"
	val[]: "Muista, että kuorma-auton kääntäminen pois päin kääntää perävaunun kohti pysäköintipaikkaa. Käytä peilejäsi parhaasi mukaan, jotta pääset pysäköintipaikkaan.<br><br><font face=/font/big_bold.font>Aloita peruuttaminen. </font>"


#@}

#+ Book 1 Scenario 3_11
#@{

#### 3_11 common
	key[]: "aca_scenario_book1_3_11_title"
	val[]: "Ajaminen liikenneympyrässä"

	key[]: "aca_scenario_book1_3_11_desc"
	val[]: "Tässä tehtävässä opettelemme ajamaan liikenneympyrässä.<br><br>Sinun täytyy kinnittää erityistä huomiota perävaunuusi, sillä se seuraa sinua eri tavalla kun ajat liikenneympyrään, liikenneympyrässä ja kun poistut sieltä."

#### 3_11 goal
#!{
	key[]: "aca_goal_book1_3_11_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_11_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


	key[]: "aca_goal_book1_3_11_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_11_end"
