#### 2_06 msg - intro text

	key[]: "aca_msg_book1_2_06_cutscene01"
	val[]: "Tämän kappaleen viimeisessä tehtävässä ajamme testiradalla hankalissa tilanteissa."

	key[]: "aca_msg_book1_2_06_cutscene02"
	val[]: "Ensimmäinen haaste on pujottelu esteiden ympäri. Suorita se ja muista käyttää peilejäsi."

	key[]: "aca_msg_book1_2_06_cutscene04"
	val[]: "Seuraavaksi tulee neulansilmä. Selviät siitä ongelmitta pitämällä ajolinjasi leveänä."

	key[]: "aca_msg_book1_2_06_cutscene05"
	val[]: "Reitti kapenee merkittävästi. Etene varoen ja käytä kylkipeiliä hyödyksesi."

	key[]: "aca_msg_book1_2_06_cutscene06"
	val[]: "Seuraavaksi tulee sarja helppoja 90 asteen käännöksiä."

	key[]: "aca_msg_book1_2_06_cutscene08"
	val[]: "Seuraava osuus pitää suorittaa peruuttamalla. Pidä se mielessä lähestyessäsi edessä olevia esteitä."

	key[]: "aca_msg_book1_2_06_cutscene09"
	val[]: "Seuraa tiemerkintöjä takaisin kaarteiden läpi."

	key[]: "aca_msg_book1_2_06_cutscene10"
	val[]: "Peruuta esteiden luo, pysähdy ja jatka sitten eteenpäin oikealle."

	key[]: "aca_msg_book1_2_06_cutscene11"
	val[]: "This passage through the cones is very narrow. Drive slowly and use your mirrors to orient yourself within the passage."

	key[]: "aca_msg_book1_2_06_cutscene13"
	val[]: "Edessä on sarja 90 asteen käännöksiä vuorotellen vasemmalle ja oikealle."

	key[]: "aca_msg_book1_2_06_cutscene15"
	val[]: "Saatat kohdata junia tässä tasoristeyksessä. Jos niin käy, pysähdy ja odota. Sen jälkeen voit kääntyä huoltotielle oikealla."

	key[]: "aca_msg_book1_2_06_cutscene16"
	val[]: "Käänny tielle vasemmalla. Voit hieman kiihdyttää kääntymisen jälkeen."

	key[]: "aca_msg_book1_2_06_cutscene18"
	val[]: "Vielä muutama käännös vasemmalle kaupungissa ja olet saapunut määränpäähän!"

	key[]: "aca_msg_book1_2_06_cutscene19"
	val[]: "Lähesty edessäsi olevia esteitä ja valmistaudu pysäköimään oikealla olevalle pysäköintipaikalle."

	key[]: "aca_msg_book1_2_06_cutscene20"
	val[]: "Peruuta pysäköintipaikkaan, sammuta sen jälkeen moottori ja varmista kuorma-auto."

#### 2_06 Driving Instructions



	key[]: "aca_msg_book1_2_06_forward"
	val[]: "Edessäsi on esteistä tehty pujottelurata.<br><br><font face=/font/big_bold.font>Aja pujotteluradan läpi.</font>"

	key[]: "aca_msg_book1_2_06_forward2"
	val[]: "<font face=/font/big_bold.font>Seuraa reittiä neulansimämutkan läpi. </font>"

	key[]: "aca_msg_book1_2_06_check1"
	val[]: "Reitti kapenee merkittävästi. Voit käyttää sivupeilejäsi helpottaaksesi suuntaamista.<br><br><font face=/font/big_bold.font>Etene varoen. </font>"

	key[]: "aca_msg_book1_2_06_check2"
	val[]: "Kaarteen jälkeen on 90 asteen käännös.<br><br><font face=/font/big_bold.font>Säädä nopeutesi tilanteeseen sopivaksi.</font>"

	key[]: "aca_msg_book1_2_06_check3"
	val[]: "Edessä on vielä muutama helppo käännös, säädä edelleen nopeuttasi tarpeen mukaan.<br><br><font face=/font/big_bold.font>Jatka ajamista. </font>"

	key[]: "aca_msg_book1_2_06_check4"
	val[]: "The following section must be completed in reverse. Stop at the barriers ahead so that you can reverse to the right afterwards.<br><br><font face=/font/big_bold.font>Stop at the barriers.</font>"

	key[]: "aca_msg_book1_2_06_check5"
	val[]: "Peruuta kohti takanasi oikealla olevaa aluetta.<br><br><font face=/font/big_bold.font>Aloita peruuttaminen. </font>"

	key[]: "aca_msg_book1_2_06_reverse"
	val[]: "Seuraa reittiä mutkien läpi. <br><br><font face=/font/big_bold.font>Jatka peruuttamista.</font>"

	key[]: "aca_msg_book1_2_06_check6"
	val[]: "Takanasi vasemmalla on joitain esteitä. <br><br><font face=/font/big_bold.font>Käännä kohti esteitä ja valmistaudu pysähtymään.</font>"

	key[]: "aca_msg_book1_2_06_check7"
	val[]: "Pysähdy, vaihda ajovaihteelle ja jatka sitten oikealle. <br><br><font face=/font/big_bold.font>Aja eteenpäin. </font>"

	key[]: "aca_msg_book1_2_06_check8"
	val[]: "In front of you is a narrow winding path through some cones. Drive carefully and use your mirrors if necessary.<br><br><font face=/font/big_bold.font>Drive through the cones. </font>"

	key[]: "aca_msg_book1_2_06_check9"
	val[]: "Seuraavaksi on yhdistelmä erilaisia 90 asteen käännöksiä. Muista ottaa reilusti tilaa jokaiseen käännökseen.<br><br><font face=/font/big_bold.font>Jatka ajamista. </font>"

	key[]: "aca_msg_book1_2_06_check10"
	val[]: "Tarkkaile tasoristeystä lähestyessäsi sitä. Valot saattavat alkaa vilkkua merkiksi saapuvasta junasta.<br><br><font face=/font/big_bold.font>Jatka varoen.</font>"

	key[]: "aca_msg_book1_2_06_check11"
	val[]: "Käännös huoltotielle on osittain estetty, joten pysy vasemmalla lähestyessäsi, jotta sinulle jää riittävästi tilaa.<br><br><font face=/font/big_bold.font>Suorita käännös </font>"

	key[]: "aca_msg_book1_2_06_check12"
	val[]: "Voit halutessa jättää noudattamatta stop-merkkiä. Alue on suljettu vain meidän käyttöömme.<br><br><font face=/font/big_bold.font>Käänny vasemmalle.</font>"

	key[]: "aca_msg_book1_2_06_check13"
	val[]: "Voit kiihdyttää tässä hieman, mutta sinun tulee kääntyä seuraavasta risteyksestä.<br><br><font face=/font/big_bold.font>Jatka rataa eteenpäin. </font>"

	key[]: "aca_msg_book1_2_06_check14"
	val[]: "Jatka kaupunkiin kääntymällä vasemmalle, jonka jälkeen tulee vielä kaksi käännöstä vasemmalle viimeiselle alueelle.<br><br><font face=/font/big_bold.font>Aja kaupungin läpi.</font>"

	key[]: "aca_msg_book1_2_06_check15"
	val[]: "Alueen takalaidalla on joitain esteitä. Aja niiden luo. <br><br><font face=/font/big_bold.font>Pysähdy esteiden lähelle. </font>"

	key[]: "aca_msg_book1_2_06_check16"
	val[]: "Takanasi oikealla on pysäköintipaikka.<br><br><font face=/font/big_bold.font>Peruuta pysäköintipaikkaan. </font>"
#!{
	key[]: "aca_msg_book1_2_06_check17"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_06_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_2_06_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

#@}

#+ Book 1 Scenario 2_08
#@{

#### 2_08 common
	key[]: "aca_scenario_book1_2_08_title"
	val[]: "Helppo harjoittelurata"

	key[]: "aca_scenario_book1_2_08_desc"
	val[]: "Tässä tehtävässä otamme opitut taidot käyttöömme ja lähdemme ajelulle helpolle harjoitteluradalle."

#### 2_08 goal
#!{
	key[]: "aca_goal_book1_2_08_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_08_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_2_08_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
#!}
	key[]: "aca_goal_book1_2_08_forward"
	val[]: "Radalle saapuminen"

	key[]: "aca_goal_book1_2_08_check1"
	val[]: "Leveä neulansilmä"

	key[]: "aca_goal_book1_2_08_check2"
	val[]: "Pujotteluradan läpi ajaminen"

	key[]: "aca_goal_book1_2_08_check3"
	val[]: "Tiukka neulansilmä"

	key[]: "aca_goal_book1_2_08_check4"
	val[]: "Kapea kaarre"

	key[]: "aca_goal_book1_2_08_check6"
	val[]: "Tekninen osuus"

	key[]: "aca_goal_book1_2_08_check7"
	val[]: "Avoin osuus"



#### 2_08 msg - intro text

	key[]: "aca_msg_book1_2_08_cutscene1"
	val[]: "Tässä tehtävässä lähdemme vetoauton kanssa pienelle ajelulla katsomaan, miten käytät juuri oppimiasi taitoja.<br>Radalla on erilaisia käännöksiä ja niiden yhdistelmiä. Kyseessä ei ole kilpailu eikä ajalla ole merkitystä. Ole kärsivällinen ja valitse tilannenopeutesi kohtaamiesi käännösten ja esteiden mukaan."

	key[]: "aca_msg_book1_2_08_cutscene2"
	val[]: "Aja radalle leveästä neulansilmästä."

	key[]: "aca_msg_book1_2_08_cutscene3"
	val[]: "Seuraavaksi kohtaat joukon esteitä, jotka ohjaavat sinut epäsäännölliseen pujotteluun."

	key[]: "aca_msg_book1_2_08_cutscene4"
	val[]: "Kun olet suorittanut muutaman helpon 90 asteen käännöksen, tulet tiukkaan neulansilmään. On tärkeää sijoittua oikein jotta käännös, sekä seuraavaan osuuteen siirtyminen sujuvat sulavasti."

	key[]: "aca_msg_book1_2_08_cutscene5"
	val[]: "Muista huomioida kartiot ajaessasi pitkää kaarretta, sillä näkyvyys konepellin yli on rajallinen."

	key[]: "aca_msg_book1_2_08_cutscene6"
	val[]: "Toinen joukko esteitä johdattaa sinut leveään pujotteluun."

	key[]: "aca_msg_book1_2_08_cutscene7"
	val[]: "Rata levenee hieman, mutta älä hätäile. Pari helppoa käännöstä vielä ja olet valmis."

	key[]: "aca_msg_book1_2_08_cutscene8"
	val[]: "Stop in the designated area and secure the truck."


#### 2_08 Driving Instructions

	key[]: "aca_msg_book1_2_08_start"
	val[]: "Onnistuaksesi tässä tehtävässä, et saa kolaroida, ajaa ulos radalta tai osua yhteenkään liikennekartioon.<br><br><font face=/font/big_bold.font>Valmistaudu liikkeellelähtöön. </font>"

	key[]: "aca_msg_book1_2_08_forward"
	val[]:"<font face=/font/big_bold.font>Jatka kohti leveää neulansilmää ajaaksesi radalle. </font>"

	key[]: "aca_msg_book1_2_08_check1"
	val[]: "<font face=/font/big_bold.font>Aja neulansilmämutkasta. </font>"

	key[]: "aca_msg_book1_2_08_check2"
	val[]: "Lähestyt esteistä tehtyä karkeaa pujottelurataa.<br><br><font face=/font/big_bold.font>Säädä nopeutesi tilanteeseen sopivaksi ja aja eteenpäin.</font>"

	key[]: "aca_msg_book1_2_08_check3"
	val[]: "Next, you have two easy 90-degree turns followed by a tight hairpin turn. Take it slow.<br><br><font face=/font/big_bold.font>Continue into the tight hairpin turn.</font>"

	key[]: "aca_msg_book1_2_08_check4"
	val[]: "Poistuessasi neulansilmästä edessäsi on mutkan läpi kulkeva kapea reitti. Pysy etäällä sisäreunan esteistä, mutta varo myös törmäämästä edessäsi oleviin kartioihin.<br><br><font face=/font/big_bold.font>Jatka mukan läpi. </font>"

	key[]: "aca_msg_book1_2_08_check6"
	val[]: "Edessä olevalla reitillä on joitain tiukkoja, teknisiä käännöksiä. Sovita nopeutesi tilanteen mukaan ja aja varoen osuuden läpi.<br><br><font face=/font/big_bold.font>Jatka ajamista. </font>"

	key[]: "aca_msg_book1_2_08_check7"
	val[]: "Seuraava osuus on avoimempi ja käännökset ovat helppoja. Älä kiirehdi.<br><br><font face=/font/big_bold.font>Jatka ajamista. </font>"
#!{
	key[]: "aca_msg_book1_2_08_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_08_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

#@}

#+ Book 1 Scenario 2_09
#@{

#### 2_09 common
	key[]: "aca_scenario_book1_2_09_title"
	val[]: "Taskuparkkeeraus"

	key[]: "aca_scenario_book1_2_09_desc"
	val[]: "Tässä tehtävässä tutustumme taskuparkkeeraukseen kahden kuorma-auton väliin."

#### 2_09 goal

	key[]: "aca_goal_book1_2_09_stopmid"
	val[]: "Pysäköintipaikan eteen pysähtyminen"

	key[]: "aca_goal_book1_2_09_checkmirror"
	val[]: "Taustapeilin tarkistaminen"

	key[]: "aca_goal_book1_2_09_backward"
	val[]: "Pysäköintipaikkaan peruuttaminen"

	key[]: "aca_goal_book1_2_09_stop"
	val[]: "Kuorma-auton suoristaminen pysäköintipaikassa"

#!{
	key[]: "aca_goal_book1_2_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_09_check1"
	val[]: "@@aca_goal_book1_1_03_forward@@"


	key[]: "aca_goal_book1_2_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"



 #!}
#### 2_09 msg - intro text

	key[]: "aca_msg_book1_2_09_cutscene1"
	val[]: "Taskuparkkeeraus on elintärkeä taito, joka jokaisen rekkakuskin tulisi hallita.<br>Valmistaudu liikkeellelähtöön."

	key[]: "aca_msg_book1_2_09_cutscene2"
	val[]: "Aja kohti pysäköintipaikkaa.<br>Muista tarkkailla ympäristöäsi."

	key[]: "aca_msg_book1_2_09_cutscene3"
	val[]: "Aja pysäköintipaikan ohi edessä olevan kuorma-auton vierelle. Älä aja liian lähelle, jotta sinulle jää tilaa kääntää."

	key[]: "aca_msg_book1_2_09_cutscene4"
	val[]: "Käännä terävästi kohti paikkaa ja aloita peruuttaminen."

	key[]: "aca_msg_book1_2_09_cutscene5"
	val[]: "Katso kuljettajan puolen sivupeilistä ja tähtää reunakiveykseen juuri takanasi olevan kuorma-auton keulan etupuolelle."

	key[]: "aca_msg_book1_2_09_cutscene6"
	val[]: "Heti kun etupuskurisi on edessäsi olevan kuorma-auton takana, voit ryhtyä kääntämään kuorma-autosi keulaa kohti pysäköintipaikkaa. Suorista kuorma-autosi pysäköintipaikan mukaisesti."

	key[]: "aca_msg_book1_2_09_cutscene7"
	val[]: "Käännä ohjauspyörä suoraan ja aja kuorma-auto pysäköintipaikan keskelle.<br>Pysäköi ja varmista kuorma-auto."

#### 2_09 Driving Instructions

	key[]: "aca_msg_book1_2_09_start"
	val[]: "Edessäsi on pysäköityjä kuorma-autoja. Niiden välissä on yksi pysäköintipaikka sinulle. <br><br><font face=/font/big_bold.font>Valmistaudu liikkeellelähtöön. </font>"

	key[]: "aca_msg_book1_2_09_check1"
	val[]: "Muista tarkkailla ympäristöäsi. Käytä hyväksesi peilejäsi koko suorituksen ajan. <br><br><font face=/font/big_bold.font>Aja eteenpäin. </font>"

	key[]: "aca_msg_book1_2_09_stopmid"
	val[]: "<color value=@@clr_white@@>Aja pysäköintipaikan ohi merkitylle alueelle. Siitä voit aloittaa peruuttamisen.<br><br><font face=/font/big_bold.font>Pysähdy merkittyyn paikkaan. </font>"

	key[]: "aca_msg_book1_2_09_checkmirror"
	val[]: "Tarkista ympäristösi esteiden varalta ja varmistaaksesi, että voit peruuttaa.<br><br><font face=/font/big_bold.font>Katso apukuskin puolen sivupeiliin. </font>"

	key[]: "aca_msg_book1_2_09_backward"
	val[]: "Käännä renkaat ja peruuta pysäköintipaikkaan.<br><br><font face=/font/big_bold.font>Aloita peruuttaminen. </font>"

	key[]: "aca_msg_book1_2_09_stop"
	val[]: "Ryhdy oikaisemaan kuorma-autoa sitten kun haluat. Älä aja reunakiveykselle!<br><br><font face=/font/big_bold.font>Kohdista kuorma-auto paikkaan. </font>"
#!{
	key[]: "aca_msg_book1_2_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_01
