#+ Book 1 intro
#@{

	key[]: "aca_scenario_book1_intro_title"
	val[]: "Kuorma-auton ajamisen perusteet"

	key[]: "aca_msg_book1_intro_cutscene01"
	val[]: "Tervetuloa @@driving_academy@@an."

	key[]: "aca_msg_book1_intro_cutscene02"
	val[]: "Seuraavat tehtävät ovat ensimmäinen askeleesi matkallasi ammattikuljettajaksi."

	key[]: "aca_msg_book1_intro_cutscene03"
	val[]: "Täällä opit kaiken kuorma-auton perusjärjestelmistä ja hallintalaitteista..."

	key[]: "aca_msg_book1_intro_cutscene04"
	val[]: "...hankaliin ohjausliikkeisiin sekä perävaunun kanssa että ilman."

	key[]: "aca_msg_book1_intro_cutscene05"
	val[]: "Autamme luomaan sinulle tapoja, jotka auttavat sinua ajamaan turvallisesti erilaisissa tilanteissa,"

	key[]: "aca_msg_book1_intro_cutscene06"
	val[]: "sekä opetamme sinua ohjaamaan kuorma-autoa tehokkaasti hyödyntäen käytettävissä olevaa tilaa."

	key[]: "aca_msg_book1_intro_cutscene07"
	val[]: "Suorittamalla kaikki tehtävät ja läpäisemällä loppukokeet,"

	key[]: "aca_msg_book1_intro_cutscene08"
	val[]: "olet valmiina tien päälle Amerikkaan kohti uusia haasteita."

#@}

