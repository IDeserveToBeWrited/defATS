#+ Book 2 intro
#@{

#### common
	key[]: "aca_scenario_book2_intro_title"
	val[]: "Kuorma-auton ajotaidot"


#### intro text

	key[]: "aca_scenario_book2_book2_intro_cutscene1"
	val[]: "Tervetuloa takaisin @@driving_academy@@an!"

	key[]: "aca_scenario_book2_book2_intro_cutscene2"
	val[]: "Nämä tehtävät ovat seuraava askeleesi matkallasi ammattikuljettajaksi."

	key[]: "aca_scenario_book2_book2_intro_cutscene3"
	val[]: "Tällä kertaa emme opasta sinua jokaisessa tehtävässä, vaan sinun tulee luottaa taitoihisi ja kokemukseesi."

	key[]: "aca_scenario_book2_book2_intro_cutscene4"
	val[]: "Saatat kohdata joitakin tuttuja harjoituksia, mutta tällä kertaa uusissa ympäristöissä, jotka muistuttavat enemmän tosielämän tilanteita."

	key[]: "aca_scenario_book2_book2_intro_cutscene5"
	val[]: "Uutta @@driving_academy@@ssa ovat \"Läpäisytavoitteet\" ja \"Lisätavoitteet\"."

	key[]: "aca_scenario_book2_book2_intro_cutscene6"
	val[]: "Kuten ennenkin, sinun tulee edelleen suorittaa tehtävä ilman kolareita, pysäköimällä onnistuneesti ja varmistamalla rekkasi..."

	key[]: "aca_scenario_book2_book2_intro_cutscene7"
	val[]: "...mutta nyt sinun tulee tehdä se annetun ajan puitteissa, sekä käyttäen vain rajallisen määrän suunnanvaihdoksia eteen- ja taaksepäin."

	key[]: "aca_scenario_book2_book2_intro_cutscene8"
	val[]: "Lisätavoitteet voidaan saavuttaa suorittamalla tehtävä täyttäen haasteellisemmat ehdot..."

	key[]: "aca_scenario_book2_book2_intro_cutscene9"
	val[]: "...kuten tiukempi aikaraja, vähemmän suunnanvaihdoksia ja käyttäen vain sisäkuvakulmaa."

	key[]: "aca_scenario_book2_book2_intro_cutscene10"
	val[]: "Suorittamalla kaikki tehtävät, voit pitää itseäsi ammattikuljettajana ja valmiina matkalla kohtaamiisi uusiin haasteisiin.<br><br>Haastaaksesi itseäsi äärirajoille, suorita kaikki tehtävät täyttäen kaikki lisätavoitteet; silloin voit pitää itseäsi todellisena tähtikuljettajana!"


#@}



#+ Book 2 zero
#@{
#### zero common
	key[]: "aca_scenario_book2_zero_title"
	val[]: "Opastus"

	key[]: "aca_scenario_book2_zero_desc"
	val[]: "Tässä opetustehtävässä tutustut Kuorma-auton ajotaidot -kurssin uusiin ominaisuuksiin."


#### zero info msg1

	key[]: "aca_msg_book2_scenario_zero1_title"
	val[]: "Kuorma-auton ajotaidot"

	key[]: "aca_msg_book2_scenario_zero1"
	val[]: "Jokaisen tehtävän aluksi näet <color value=@@clr_sel@@>\"Tehtävän ohjeet\"<color value=@@clr_txt@@> -ikkunan. Tästä näet tiedot tehtävän uusista läpäisy- ja lisätavoitteista. <br><br>Läpäisytavoitteet tulee täyttää, jotta tehtävä voidaan suorittaa onnistuneesti, kun taas lisätavoitteet ovat vapaaehtoinen haaste kokeneille ja taitaville pelaajille. <br><br><font face=/font/big_bold.font>Kytke virrat päälle jatkaaksesi.</font>"

#### zero info msg1b

	key[]: "aca_msg_book2_scenario_zero1b"
	val[]: "Yksi lisätavoitteista vaatii, että suoritat tehtävän käyttäen <color value=@@clr_sel@@>Sisätilakameraa<color value=@@clr_txt@@>. Voit edelleen käyttää ulkokameroita tarkistaaksesi ympäristöäsi, mutta vain silloin kun kuorma-auto on pysäytettynä.<br><br>Voit nyt katsella ympärillesi hahmottaaksesi tilanteen ja vaihtaa sitten takaisin sisätilakameraan.<br><br><font face=/font/big_bold.font>Vaihda seurantakameraan tarkistaaksesi ympäristösi.</font>"


#### zero info msg1c


	key[]: "aca_msg_book2_scenario_zero1c"
	val[]: "Havainnoi tilanne ja vaihda sitten takaisin sisätilakameraan.<br><br><font face=/font/big_bold.font>Katso kuorma-auton ympärille</font>"


#### zero info msg1d


	key[]: "aca_msg_book2_scenario_zero1d"
	val[]: "<font face=/font/big_bold.font>Vaihta takaisin sisäkameraan</font>"
#### zero info msg2

	key[]: "aca_msg_book2_scenario_zero2_title"
	val[]: "Kuorma-auton ajotaidot"

	key[]: "aca_msg_book2_scenario_zero2"
	val[]: "<color value=@@clr_sel@@>Aika<color value=@@clr_txt@@> on myös yksi tekijä Kuorma-auton Ajotaidoissa. Kaikissa tehtävissä on aikaraja, jossa tehtävä tulee suorittaa. Useissa tehtävissä on lisätavoitteena myös toinen, tiukempi aikaraja.<br><br>Kello käynnistyy vasta kun kuorma-auto lähtee liikkeelle.<br><br><font face=/font/big_bold.font>Käynnistä moottori ja vapauta käsijarru jatkaaksesi.</font>"


#### zero info msg3

	key[]: "aca_msg_book2_scenario_zero3_title"
	val[]: "Kuorma-auton ajotaidot"

	key[]: "aca_msg_book2_scenario_zero3"
	val[]: "Toinen lisäys Kuorma-auton ajotaidot -kurssiin on välietapit. Kaikki välietapit tulee saavuttaa ennen kuin tehtävä voidaan lopettaa.<br><br>Välietapeilla on huomioitava miten päin kuorma-auto tulee niille saavuttaessa, joten tarkkaile maassa olevia merkintöjä välietapin lähellä suunnataksesi itsesi oikein.<br><br><font face=/font/big_bold.font>Aja eteenpäin edessäsi olevalle välietapille.</font>"


#### zero info msg4

	key[]: "aca_msg_book2_scenario_zero4_title"
	val[]: "Kuorma-auton ajotaidot"

	key[]: "aca_msg_book2_scenario_zero4"
	val[]: "Olet saavuttanut välietapin ja voit nyt jatkaa eteenpäin. <br><br>Takanasi on toinen välietappi, jonne sinun tulee peruuttaa. Huomaa maassa oleva nuoli joka kertoo miten päin kuorma-autosi tulee olla saapuessasi välietapille. <br><br>Toinen Läpäisy- ja Lisätavoite joka tulee huomioida, on <color value=@@clr_sel@@>Suunnanvaihdokset<color value=@@clr_txt@@>. Laskemme kuinka monta kertaa olet vaihtanut suuntaa ajamalla eteen- ja taaksepäin. Pysy rajan alapuolella saavuttaaksesi tavoitteen.<br><br><font face=/font/big_bold.font>Peruuta välietapille ja pysähdy.</font>"

#### zero info msg5

	key[]: "aca_msg_book2_scenario_zero5_title"
	val[]: "Kuorma-auton ajotaidot"

	key[]: "aca_msg_book2_scenario_zero5"
	val[]: "Tähän mennessä sinulla pitäisi olla kertynyt yksi suunnanvaihdos. <br><br>Kytke takanasi oleva perävaunu jatkaaksesi seuraavaan vaiheeseen. <br><br><font face=/font/big_bold.font>Peruuta perävaunun alle kytkeäksesi sen.</font>"

#### zero info msg6

	key[]: "aca_msg_book2_scenario_zero6_title"
	val[]: "Kuorma-auton ajotaidot"

	key[]: "aca_msg_book2_scenario_zero6"
	val[]: "Lopullinen pysäköintialue on oikealla puolellasi. Joissain tehtävissä käytettävissä on vain yksi pysäköintipaikka, kun taas joissain valittavana on useita. Saat suoritettua tehtävän onnistuneesti pysäköimällä oikein mihin tahansa näistä. <br><br><font face=/font/big_bold.font> Paina @@imv_nrm_attach@@ kytkeäksesi perävaunun. </font>"


#### zero info msg7

	key[]: "aca_msg_book2_scenario_zero7_title"
	val[]: "Kuorma-auton ajotaidot"

	key[]: "aca_msg_book2_scenario_zero7"
	val[]: "Pysäköintipaikat ilmaisevat myös, miten päin kuorma-auto tulee pysäköidä. Jos pysäköit väärin päin, et voi suorittaa tehtävää ennen kuin olet kääntänyt kuorma-auton kuluttaen arvokasta aikaa ja suunnanvaihdoksia.<br><br><font face=/font/big_bold.font>Aja yhteen pysäköintipaikoista ja pysäköi oikein.</font>"



#### zero info msg8

	key[]: "aca_msg_book2_scenario_zero8_title"
	val[]: "Kuorma-auton ajotaidot"

	key[]: "aca_msg_book2_scenario_zero8"
	val[]: "Olet nyt tutustunut uusiin läpäisy- ja lisätavoitteisiin ja olet valmis uusiin tehtäviin Kuorma-auton Ajotaidoissa!<br><br><font face=/font/big_bold.font>Varmista kuorma-auto kytkemällä käsijarru ja sammuttamalla moottori suorittaaksesi tehtävän loppuun.</font>"



#@}

#+ Book 2 trailer check
#@{

#### Mission instructions - trailer check

key[]: "aca_msg_book2_slopy_moments_title"
val[]: "Ohjeiden noudattaminen"

key[]: "aca_msg_book2_slopy_moments1"
val[]: "Suorittaaksesi tehtävän, pidä perävaunu kytkettynä koko tehtävän ajan.<br><br><font face=/font/big_bold.font>Kytke perävaunu.</font>"

key[]: "aca_msg_book2_slopy_moments2"
val[]: "Nyt voit jatkaa tehtävän suorittamista"


#@}


#+ Book 2 slalom_nt
#@{
#### 3_21 common
	key[]: "aca_scenario_book2_slalom_nt_title"
	val[]: "Tuplapujottelu"

	key[]: "aca_scenario_book2_slalom_nt_desc"
	val[]: "Tässä tehtävässä sinun tulee läpäistä kahdesta pujottelusta muodostuva rata."

#### slalom_nt intro text

	key[]: "aca_scenario_book2_slalom_nt_cutscene1"
	val[]: "Tämä tehtävä koostuu kahdesta peräkkäisestä pujottelusta. Aja ensimmäisen pujottelun läpi osumatta kartioihin ja tee lopussa U-käännös."

	key[]: "aca_scenario_book2_slalom_nt_cutscene2"
	val[]: "Sen jälkeen jatka toisen pujottelun läpi kohti lopullista pysäköintipaikkaa.<br><br>Kello käy, joten aja määrätietoisesti mutta varovasti!"



#@}

#+ Book 2 training_course
