#+ Book 1 Scenario 3_05
#@{

#### 3_05 common
	key[]: "aca_scenario_book1_3_05_title"
	val[]: "Peruuttaminen perävaunun kanssa"

	key[]: "aca_scenario_book1_3_05_desc"
	val[]: "Tässä tehtävässä pääset ensimmäistä kertaa kokeilemaan peruuttamista perävaunun kanssa. Se on melko yksinkertainen toimenpide, mutta sinut tulee silti kääntää rattia oikein saadaksesi perävaunun peruutettua oikeaan paikkaan."

	#### 3_05 goal



	key[]: "aca_goal_book1_3_05_check_con"
	val[]: "Perävaunua kohti peruuttaminen"

	key[]: "aca_goal_book1_3_05_connect"
	val[]: "Perävaunun kytkeminen"

	key[]: "aca_goal_book1_3_05_park_br_off"
	val[]: "Käsijarrun vapauttaminen"

	key[]: "aca_goal_book1_3_05_b_trailer"
	val[]: "Suuntaaminen pysäköintialueeseen"

	key[]: "aca_goal_book1_3_05_check1"
	val[]: "Pysäköintialuetta kohti peruuttaminen"

	key[]: "aca_goal_book1_3_05_check2"
	val[]: "Suuntaaminen pysäköintialueeseen"
#!{
	key[]: "aca_goal_book1_3_05_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_05_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_05_park_br_on"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

	key[]: "aca_goal_book1_3_05_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_05_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"


#!}
#### 3_05 msg - intro text

	key[]: "aca_msg_book1_3_05_cutscene01"
	val[]: "Koitetaan nyt peruuttamista perävaunun kanssa. Se on helpompaa kuin mitä näyttää; sinun tulee olla vain kärsivällinen."

	key[]: "aca_msg_book1_3_05_cutscene02"
	val[]: "Aloita peruuttaminen ja kohdista vetoauto samaan linjaan perävaunun kanssa."

	key[]: "aca_msg_book1_3_05_cutscene03"
	val[]: "Varmista, että olet oikeassa linjassa tai et voi kytkeä perävaunua. Jos et onnistu, voit aina ajaa eteenpäin ja yrittää uudestaan."

	key[]: "aca_msg_book1_3_05_cutscene04"
	val[]: "Vetoauton vetopöytä lukittuu perävaunun vetotappiin."

	key[]: "aca_msg_book1_3_05_cutscene05"
	val[]: "Kytke käsijarru ja yhdistä perävaunu. Oikeassa elämässä sinun pitäisi poistua kuorma-autosta ja yhdistää paineilmaletkut ja sähköjohdot sekä nostaa tukijalat, mutta tässä teemme ne puolestasi."

	key[]: "aca_msg_book1_3_05_cutscene05b"
	val[]: "Aja eteenpäin ja seuraa tiemerkintöjä oikealla olevalle merkitylle kaistalle."

	key[]: "aca_msg_book1_3_05_cutscene05c"
	val[]: "Tavoite on kohdistaa kuorma-auto pysäköintialueeseen takanasi. Kun olet mielestäsi sijoittunut oikein, voit aloittaa peruuttamisen."

	key[]: "aca_msg_book1_3_05_cutscene06"
	val[]: "@@aca_msg_book1_3_05_cutscene06_img@@<br>Perävaunu kääntyy aina <color value=@@clr_sel@@>vastakkaiseen <color value=@@clr_txt@@>suuntaan kuin vetoauto."

	key[]: "aca_msg_book1_3_05_cutscene07"
	val[]: "@@aca_msg_book1_3_05_cutscene07_img@@<br>Kääntääksesi perävaunua, sinun tulee kääntää vetoautoa<color value=@@clr_sel@@> vastakkaiseen <color value=@@clr_txt@@> suuntaan, jonne haluat perävaunun menevän."

	key[]: "aca_msg_book1_3_05_cutscene08"
	val[]: "@@aca_msg_book1_3_05_cutscene08_img@@<br>Suoristaaksesi perävaunun uudelleen, käännä vetoautoa <br><color value=@@clr_sel@@>kohti<color value=@@clr_txt@@> perävaunua."

	key[]: "aca_msg_book1_3_05_cutscene09"
	val[]: "Pidä perävaunu kohti merkittyä aluetta ja yritä sitten pitää vetoauto jotakuinkin linjassa perävaunun kanssa - sinun tulee tehdä jatkuvasti pieniä korjausliikkeitä."

	key[]: "aca_msg_book1_3_05_cutscene10"
	val[]: "Korjaa reitiltä poikkeamiset pienillä ohjausliikkeillä heti kun ne tapahtuvat. Jos käännät liikaa, voit päätyä kauas reitiltäsi."

	key[]: "aca_msg_book1_3_05_cutscene11"
	val[]: "Pysähdy kohdealueelle. Varmista kuorma-auto ja sammuta moottori."

#### 3_05 Driving Instructions

	key[]: "aca_msg_book1_3_05_start"
	val[]: "Takanasi oikealla näet perävaunun. Ensimmäinen tehtäväsi on peruuttaa sen luo.<br><br><font face=/font/big_bold.font>Valmistele kuorma-auto peruuttamista varten. </font>"

	key[]: "aca_msg_book1_3_05_backward"
	val[]: "<font face=/font/big_bold.font>Aloita peruuttaminen kohti perävaunua. </font>"

	key[]: "aca_msg_book1_3_05_check_con"
	val[]: "Kohdista itsesi niin, että olet samassa linjassa perävaunun kanssa. Vetopöydän tulee osua vetotappiin. Aja eteenpäin ja korjaa tarpeen mukaan.<br><br><font face=/font/big_bold.font>Jatka peruuttamista kunnes tunnet kytkennän. </font>"

	key[]: "aca_msg_book1_3_05_park_br_on"
	val[]: "Vetotappi on lukittunut vetopöytään ja olet valmiina viimeistelemään kytkennän.<br><br><font face=/font/big_bold.font>Kytke käsijarru. </font>"

	key[]: "aca_msg_book1_3_05_connect"
	val[]: "<font face=/font/big_bold.font>Paina @@imv_nrm_attach@@ kytkeäksesi perävaunun. </font>"

	key[]: "aca_msg_book1_3_05_park_br_off"
	val[]: "Nyt perävaunu on turvallisesti kiinnitetty vetoautoon, paineilmaletkut ja sähköjohdot on kytketty ja tukijalat nostettu.<br><br><font face=/font/big_bold.font>Vapauta käsijarru. </font>"

	key[]: "aca_msg_book1_3_05_b_trailer"
	val[]: "Aja eteenpäin ja oikealle päästäksesi linjaan vasemmalla olevan pysäköintialueen kanssa. Käytä tiemerkintöjä avuksesi.<br><br><font face=/font/big_bold.font>Aja eteenpäin ja kohdista itsesi pysäköintialueeseen. </font>"

	key[]: "aca_msg_book1_3_05_check1"
	val[]: "Voit aloittaa peruuttamisen, kun olet kohtuullisen suorassa linjassa pysäköintialueeseen nähden. <br><br><font face=/font/big_bold.font>Aloita perävaunun peruuttaminen. </font>"

	key[]: "aca_msg_book1_3_05_check2"
	val[]: "Muista, että perävaunu kääntyy eri suuntaan kuin mihin käännät vetoautoa ja pienikin ohjausliike saattaa aiheuttaa merkittävän liikkeen perävaunussa. <br><br><font face=/font/big_bold.font>Jatka perävaunun peruuttamista. </font>"
#!{
	key[]: "aca_msg_book1_3_05_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_05_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

#@}

