#### 3_04 common
	key[]: "aca_scenario_book1_3_04_title"
	val[]: "Haasteellinen harjoittelurata - Perävaunu"

	key[]: "aca_scenario_book1_3_04_desc"
	val[]: "Kolmannen kappaleen viimeisessä tehtävässä ajamme läpi pidemmän ajoharjoitteluradan, jossa on erilaisia käännöksiä, jotta näemme, kuinka hyvin olet oppinuut ajamaan perävaunun kanssa."

#### 3_04 goal



	key[]: "aca_goal_book1_3_04_check1"
	val[]: "Easy Turns"

	key[]: "aca_goal_book1_3_04_check2"
	val[]: "Helppo 90 asteen käännös"

	key[]: "aca_goal_book1_3_04_check3"
	val[]: "Kaksoisneulansilmään ajaminen"

	key[]: "aca_goal_book1_3_04_check4"
	val[]: "Kaksoisneulansilmästä poistuminen"

	key[]: "aca_goal_book1_3_04_check5"
	val[]: "Kapea osuus"

	key[]: "aca_goal_book1_3_04_check6"
	val[]: "Helppo 90 asteen käännös"

	key[]: "aca_goal_book1_3_04_check7"
	val[]: "Tiukka neulansilmä"

	key[]: "aca_goal_book1_3_04_check8"
	val[]: "Tiukka 90 asteen käännös"

	key[]: "aca_goal_book1_3_04_check9"
	val[]: "Haastava neulansilmä"

	key[]: "aca_goal_book1_3_04_check10"
	val[]: "Final Turn"

	key[]: "aca_goal_book1_3_04_check11"
	val[]: "Kohdealueelle jatkaminen"
