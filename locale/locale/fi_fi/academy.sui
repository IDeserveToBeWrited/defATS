#+ Book 1 Scenario 3_13
#@{

#### 3_13 common
	key[]: "aca_scenario_book1_3_13_title"
	val[]: "Sivuttaissiirtoliike peruuttamalla"

	key[]: "aca_scenario_book1_3_13_desc"
	val[]: "Tässä tehtävässä sinun tulee peruuttaa pysäköintipaikkaa, joka ei ole suoraan takanasi. Tilaa on rajoitetusti, joten sinun tulee käyttää sitä harkiten."

#### 3_13 goal

#!{
	key[]: "aca_goal_book1_3_13_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_13_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_13_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_13_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

#!}

#### 3_13 msg - intro text

	key[]: "aca_msg_book1_3_13_cutscene01"
	val[]: "Tässä tehtävässä sinun pitää pysäköidä vieressäsi olevaan pysäköintipaikkaan. Tilaa on rajoitetusti, joten sinun pitää nähdä hieman vaivaa saadaksesi perävaunun oikeaan paikkaan."

	key[]: "aca_msg_book1_3_13_cutscene02"
	val[]: "Aja suoraan esteen luokse."

	key[]: "aca_msg_book1_3_13_cutscene03"
	val[]: "Pysähdy ennen estettä."

	key[]: "aca_msg_book1_3_13_cutscene04"
	val[]: "Käännä rattia reilusti kuljettajan puolelle ennen liikkeellelähtöä. Näin heti kun lähden peruuttamaan, alkaa perävaunusi kääntyä kohti pysäköintipaikkaa säästäen kallisarvoista tilaa."

	key[]: "aca_msg_book1_3_13_cutscene05"
	val[]: "Heti kun perävaunusi osoittaa oikeaan suuntaan, ohjaa vetoauto perävaunun eteen ja ryhdy ohjaamaan kohti pysäköintipaikkaa."

	key[]: "aca_msg_book1_3_13_cutscene06"
	val[]: "Tästä eteenpäin, tämä on kuin mikä tahansa tavanomainen peruutusliike."

	key[]: "aca_msg_book1_3_13_cutscene07"
	val[]: "Jatka peruuttamista ja tarkkaile kumpaakin puolta. Pitä vetoauto ja perävaunu linjassa kohti pysäköintipaikkaa."

	key[]: "aca_msg_book1_3_13_cutscene08"
	val[]: "Pysähdy merkitylle alueelle, varmista kuorma-auto ja sammuta moottori."


#### 3_13 Driving Instructions

	key[]: "aca_msg_book1_3_13_start"
	val[]: "Olet pysäköintipaikassa, mutta oikealla puolella on toinen pysäköintipaikka, johon sinun tulee siirtyä.<br><br><font face=/font/big_bold.font>Valmistaudu liikkeellelähtöön. </font>"

	key[]: "aca_msg_book1_3_13_forward"
	val[]: "Edessäsi on merkitty alue.<br><br><font face=/font/big_bold.font>Aja eteenpäin. </font>"
#!{
	key[]: "aca_msg_book1_3_13_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

	key[]: "aca_msg_book1_3_13_check2"
	val[]: "Muista aloittaa kääntäminen heti, koska tilaa on rajoitetusti.<br><br><font face=/font/big_bold.font>Peruuta takanasi olevaan merkittyyn paikkaan. </font>"


#@}

#+ Book 1 Scenario 3_15
#@{

#### 3_15 common
	key[]: "aca_scenario_book1_3_15_title"
	val[]: "Kannunkahva- ja koukkukäännökset"

	key[]: "aca_scenario_book1_3_15_desc"
	val[]: "Tässä tehtävässä lähdet lyhyelle ajelulle harjoitteluradalle, jolla opit selviytymään perävaunun kanssa tiukoista mutkista kahden erilaisen käännöstyypin avulla."

#### 3_15 goal
#!{
	key[]: "aca_goal_book1_3_15_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_15_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_15_check6"
	val[]: "@@aca_goal_book1_3_11_check6@@"

	key[]: "aca_goal_book1_3_15_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_15_end"
	val[]: "@@aca_goal_book1_2_01_end@@"


 #!}
	key[]: "aca_goal_book1_3_15_check1"
	val[]: "Kannunkahvakäännös"

	key[]: "aca_goal_book1_3_15_check2"
	val[]: "Kaarre ja suora osuus"

	key[]: "aca_goal_book1_3_15_check3"
	val[]: "Koukkukäännös"

	key[]: "aca_goal_book1_3_15_check4"
	val[]: "Suora osuus ja kaarre"

	key[]: "aca_goal_book1_3_15_check5"
	val[]: "Yhdistelmäkäännös"



#### 3_15 msg - intro text

	key[]: "aca_msg_book1_3_15_cutscene01"
	val[]: "Edessäsi on joitain tiukkoja käännöksiä, joissa ei ole juuri ylimääräistä tilaa.<br> Nämä opettavat sinua kuljettamaan perävaunuyhdistelmää sujuvasti."

	key[]: "aca_msg_book1_3_15_cutscene02"
	val[]: "@@aca_msg_book1_3_15_cutscene02_img@@<br>Ensimmäisessä käännöksessä tarvitset kannunkahva-käännöstä. Tämä sopii käännöksiin, joissa tiellä jonne käännyt on rajoitetusti tilaa jolloin sinun tulee käyttää hyödyksesi tilaa tiellä, jolta olet tulossa."

	key[]: "aca_msg_book1_3_15_cutscene03"
	val[]: "Seuraa kaistamerkintöjä ja koukkaa vetoautolla mahdollisimman kauas reunakiveyksestä.<br>Näin saat myös perävaunusi kauas reunakiveyksestä ja sinulle jää riittävästi tilaa kääntyä."

	key[]: "aca_msg_book1_3_15_cutscene04"
	val[]: "Pysy lähellä estettä poistuessasi, jotta perävaunu seuraa edelleen leveintä mahdollista reittiä."

	key[]: "aca_msg_book1_3_15_cutscene05"
	val[]: "Kun ajat pitkään kaarteeseen, sinun tulee pitää kuorma-auto lähellä tien keskikohtaa pitääksesi perävaunun pyörät pois reunakiveykseltä."

	key[]: "aca_msg_book1_3_15_cutscene06"
	val[]: "Jatka tietä pitkin."

	key[]: "aca_msg_book1_3_15_cutscene07"
	val[]: "@@aca_msg_book1_3_15_cutscene07_img@@<br>Seuraavassa käännöksessä tarvitset koukkukäännöstä. Tämä on suositeltava tekniikka, sillä se ei avaa kaistaa takanasi tarkkaamattomalle motoristille, joka voi hiipiä vierellesi oikealta puolelta. Käytä sitä aina, kun sinulla on riittävästi tilaa tiellä, jonne olet kääntymässä."

	key[]: "aca_msg_book1_3_15_cutscene08"
	val[]: "Aja pitkälle risteykseen ja tee nopea, terävä käännös oikealle."

	key[]: "aca_msg_book1_3_15_cutscene09"
	val[]: "Kun tulet esteen viereen, voit suoristaa ja pysyttele taas kaistasi vasemmassa reunassa.<br>Kaikki tämä auttaa pitämään perävaunusi pyörät pois reunakiveykseltä."

	key[]: "aca_msg_book1_3_15_cutscene10"
	val[]: "Jatka eteenpäin kohti seuraavaa kaarretta."

	key[]: "aca_msg_book1_3_15_cutscene11"
	val[]: "Pysyttele jälleen kerran keskellä tietä pitääksesi perävaunun pyörät pois reunakiveykseltä."

	key[]: "aca_msg_book1_3_15_cutscene12"
	val[]: "Edessä oleva käännös on erityisen haasteellinen. Tämänkaltaisissa tilanteissa olosuhteet eivät ole sopivat kannunkahva- tai koukkukäännöksille, vaan tässä tulee yhdistellä molempia, päästäksesi sinne minne olet menossa."

	key[]: "aca_msg_book1_3_15_cutscene13"
	val[]: "Koukkaa leveästi ennen käännöstä, aja pitkälle risteykseen ja käännä nopeasti. Tälläkin kertaa on olennaista pysyä mahdollisimman lähellä estettä, jotta käännöksestä tulee mahdollisimman laaja."

	key[]: "aca_msg_book1_3_15_cutscene14"
	val[]: "Park in the designated area, secure the truck and shut down the engine."

	# Book 1 Scenario 3_15 formatting
#!{
	key[]: "aca_msg_book1_3_15_cutscene02_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/jug_handle.mat bottom=p256 right=p256 color=FFFFFFFF></align><offset vshift=256>"

	key[]: "aca_msg_book1_3_15_cutscene07_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/button_hook.mat bottom=p256 right=p256 color=FFFFFFFF></align><offset vshift=256>"

#!}


#### 3_15 Driving Instructions

	key[]: "aca_msg_book1_3_15_forward"
	val[]: "Muista käyttää kaikki käytettävissä oleva tila, jotta suoriudut kaikista käännöksistä.<br><br><font face=/font/big_bold.font>Lähde liikkeelle ja seuraa tiemerkintöjä vasemmalle. </font>"

	key[]: "aca_msg_book1_3_15_check1"
	val[]: "Koukkaa leveästi käyttäen kaikki mahdollinen tila, pitäen perävaunun pois sisäreunan reunakiveyksestä.<br><br><font face=/font/big_bold.font>Tee kannunkahvakäännös. </font>"

	key[]: "aca_msg_book1_3_15_check2"
	val[]: "Pysyttele tien keskellä ajaessasi kaarteessa ja jatka sitten suoraan kohti seuraavaa käännöstä.<br><br><font face=/font/big_bold.font>Jatka ajamista. </font>"

	key[]: "aca_msg_book1_3_15_check3"
	val[]: "Tilaa on rajoitetusti, joten sinun tulee ajaa pitkälle risteykseen jotta perävaunu ei osu reunakiveykseen.<br><br><font face=/font/big_bold.font>Tee koukkukäännös. </font>"

	key[]: "aca_msg_book1_3_15_check4"
	val[]: "Aja eteenpäin seuraavaan mutkaan.<br><br><font face=/font/big_bold.font>Jatka ajamista. </font>"

	key[]: "aca_msg_book1_3_15_check5"
	val[]: "Tämä on tiukin käännös tähän asti, eikä kumpikaan tapa yksinään toimi.<br><br><font face=/font/big_bold.font>Tee käännös niin leveästi kuin mahdollista.</font>"

	key[]: "aca_msg_book1_3_15_check6"
	val[]: "<font face=/font/big_bold.font>Jatka kohti edessäsi oikealla olevaa pysäköintipaikkaa. </font>"
#!{
	key[]: "aca_msg_book1_3_15_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_15_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_15_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}


#@}

#+ Book 1 Scenario 3_16
#@{

#### 3_16 common
	key[]: "aca_scenario_book1_3_16_title"
	val[]: "Vinoparkkeeraus peruuttamalla"

	key[]: "aca_scenario_book1_3_16_desc"
	val[]: "Tässä tehtävässä tutkimme vinoparkkeerausta peruuttamalla. Tällaisia tilanteita saattaa tulla levähdysalueilla, rekkaparkeissa tai jopa lähettäjien luona. Usein tilaa on vähän, koska kuorma-autoja on paljon, joten pysäköinti on vaikeampaa."

#### 3_16 goal

	key[]: "aca_goal_book1_3_16_check1"
	val[]: "Perävaunun kääntäminen"
#!{
	key[]: "aca_goal_book1_3_16_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_16_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_16_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_16_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
 #!}
#### 3_16 msg - intro text

	key[]: "aca_msg_book1_3_16_cutscene1"
	val[]: "Vinoparkkeeraus saattaa vaikuttaa helpolta, mutta se saattaa useasti olla haasteellisempi kuin perinteinen 'kujapysäköinti'."

	key[]: "aca_msg_book1_3_16_cutscene2"
	val[]: "Peruuta kohti pysäköintipaikkaa. Pidä vetoauto ja perävaunu suorassa toistaiseksi."

	key[]: "aca_msg_book1_3_16_cutscene3"
	val[]: "Kun pääset lähemmäs, anna perävaunun kulkea lähemmäs pysäköityjä kuorma-autoja. Tämä helpottaa sen kääntämistä pysäköintipaikkaan, kun pääset sinne asti."

	key[]: "aca_msg_book1_3_16_cutscene4"
	val[]: "Aloita perävaunun kääntäminen pysäköintipaikkaan. Pidä perävaunu lähellä kuljettajan puolella olevaa kuorma-autoa, sillä tarvitset kaiken tilan toiselta puolelta."

	key[]: "aca_msg_book1_3_16_cutscene5"
	val[]: "Kun perävaunu on riittävän pitkällä, aloita vetoauton kääntäminen perävaunun suuntaisesti."

	key[]: "aca_msg_book1_3_16_cutscene6"
	val[]: "Pysäköi kohdealueelle, varmista kuorma-auto ja sammuta moottori."

#### 3_16 Driving Instructions

	key[]: "aca_msg_book1_3_16_start"
	val[]: "Pysäköi kuorma-auto takanasin olevaan tilaan. Käytä molempia peilejäsi avuksesi peruuttaessasi.<br><br><font face=/font/big_bold.font>Valmistaudu liikkeellelähtöön. </font>"

	key[]: "aca_msg_book1_3_16_backward"
	val[]: "Tarkista ympäristösi ja jatka sitten kohti pysäköintipaikkaa.<br><br><font face=/font/big_bold.font>Aloita peruuttaminen.</font>"

	key[]: "aca_msg_book1_3_16_check1"
	val[]: "Aloita perävaunun ohjaaminen lähemmäs vieressäsi olevia kuorma-autoja. Kun olet valmis, käännä perävaunu pysäköintipaikkaan. Muista huomioda perävaunun perän heilahdus.<br><br><font face=/font/big_bold.font>Käännä pysäköintipaikkaan. </font>"
#!{
	key[]: "aca_msg_book1_3_16_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_16_end"
	val[]: "@@aca_msg_book1_2_01_end@@"


 #!}


#@}

#+ Book 1 Scenario 3_17
#@{

#### 3_17 common
	key[]: "aca_scenario_book1_3_17_title"
	val[]: "Peruuttaminen kaarteeseen"

	key[]: "aca_scenario_book1_3_17_desc"
	val[]: "Tässä tehtävässä peruutamme perävaunun kanssa käännökseen ensimmäistä kertaa. Tutkimme peruuttamisen perusperiaatteita ja mitä tulee huomioida käännökseen peruutettaessa."

#### 3_17 goal

	key[]: "aca_goal_book1_3_17_check1"
	val[]: "Perävaunun kääntäminen"
#!{
	key[]: "aca_goal_book1_3_17_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_17_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_17_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_17_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
 #!}
#### 3_17 msg - intro text

	key[]: "aca_msg_book1_3_17_cutscene01"
	val[]: "Tässä tehtävässä sinun tulee peruuttaa pysäköintipaikkaan joka on takanasi kuljettajan puolella."

	key[]: "aca_msg_book1_3_17_cutscene02"
	val[]: "On muutamia muistettavia vinkkejä, jotka helpottavat peruuttamista perävaunun kanssa. <br>Ensimmäinen on se, että perävaunu kääntyy aina vastakkaiseen suuntaan mihin käännät vetoautoa."

	key[]: "aca_msg_book1_3_17_cutscene03"
	val[]: "Toinen on se, että saat hyvän käsityksen mihin perävaunu on menossa tarkkailemalla vetoauton ja perävaunun akseleita."

	key[]: "aca_msg_book1_3_17_cutscene04"
	val[]: "Kolmanneksi, pääset pienillä ohjausliikkeille sinne minne tahdot, ei ole tarpeen liioitella."

	key[]: "aca_msg_book1_3_17_cutscene05"
	val[]: "Ala kääntää vetoautoa hieman poispäin pysäköintipaikasta, jolloin perävaunu alkaa kääntyä sitä kohti."

	key[]: "aca_msg_book1_3_17_cutscene06"
	val[]: "Seuraa perävaunua tehden korjauksia pitääksesi yhdistelmän oikealla reitillä."

	key[]: "aca_msg_book1_3_17_cutscene07"
	val[]: "Tarkkaile perävaunun pyöriä ja vetoauton takapyöriä. Näistä näet mihin suuntaan perävaunu osoittaa ja mihin suuntaan vetoauto sitä työntää."

	key[]: "aca_msg_book1_3_17_cutscene08"
	val[]: "Neljäs vinkki on se, että on aina helpompaa kääntää perävaunua terävämmin kuin yrittää suoristaa sitä linkusta. Tähtää paikan ulkoreunaan ja kun pääset lähemmäs, voit alkaa kääntää hieman jyrkemmin kohdistaaksesi perävaunun."

	key[]: "aca_msg_book1_3_17_cutscene09"
	val[]: "Ohjaa vetoauto perävaunun eteen, kun perävaunu osuu pysäköintipaikkaan. Vältä liiallisia säätöliikkeitä kun olet paikassa."

	key[]: "aca_msg_book1_3_17_cutscene10"
	val[]: "Peruuta esteiden väliin tarkkaillen samalla molempia puolia."

	key[]: "aca_msg_book1_3_17_cutscene11"
	val[]: "Varmista kuorma-auto ja sammuta moottori."

#### 3_17 Driving Instructions

	key[]: "aca_msg_book1_3_17_start"
	val[]: "Muista nämä vinkit peruuttaessasi perävaunulla käännökseen:<br><br>— Perävaunu kääntyy vastakkaiseen suuntaan kuin vetoauto<br><br>— Katso perävaunun pyöristä mihin suuntaan se osoittaa<br><br>— Katso vetoauton takapyöriä nähdäksesi mihin suuntaan työnnät perävaunua<br><br>— Anna perävaunun tehdä työ, älä yliohjaa.<br><br>— On aina helpompi kääntää enemmän kuin yrittää suoristaa<br><br><font face=/font/big_bold.font>Valmistaudu liikkeellelähtöön. </font>"

	key[]: "aca_msg_book1_3_17_backward"
	val[]: "Katso taakse nähdäksesi minne sinun tulee mennä. Tarkista aina ympäristösi ennen kuin aloitat peruuttamisen.<br><br><font face=/font/big_bold.font>Lähde peruuttamaan kohti pysäköintipaikkaa.</font>"

	key[]: "aca_msg_book1_3_17_check1"
	val[]: "<font face=/font/big_bold.font>Aloita perävaunun kääntäminen kohti pysäköintipaikkaa ja seuraa perässä.</font>"

	key[]: "aca_msg_book1_3_17_stop"
	val[]: "<font face=/font/big_bold.font>Pysähdy kohdealueelle. </font>"
#!{
	key[]: "aca_msg_book1_3_17_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_18
#@{

#### 3_18 common
	key[]: "aca_scenario_book1_3_18_title"
	val[]: "'Kujapysäköinti'"

	key[]: "aca_scenario_book1_3_18_desc"
	val[]: "Tässä tehtävässä tehtäväsi on peruuttaa perävaunu pieneltä tieltä kujalle."

#### 3_18 goal

	key[]: "aca_goal_book1_3_18_check1"
	val[]: "Perävaunun kääntäminen"
#!{
	key[]: "aca_goal_book1_3_18_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_18_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


	key[]: "aca_goal_book1_3_18_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_18_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

 #!}
#### 3_18 msg - intro text

	key[]: "aca_msg_book1_3_18_cutscene01"
	val[]: "Tänne pysäköinti vaatii 'kujapysäköinti' liikkeen.<br>Tämä on rekkamiehille tyypillinen pysäköintitapa, jonka he kohtaavat urallaan lähes päivittäin. Oli se sitten perävaunun lastaamista tai purkamista varten tai pysäköinti rekkaparkkiin yöpymistä varten."

	key[]: "aca_msg_book1_3_18_cutscene02"
	val[]: "Tämä on samanlainen kuin edellinen tehtävä, mutta sinulla on vähemmän työskentelytilaa, joten sinun tulee suunnitella liikkeesi ja varoa osumasta mihinkään."

	key[]: "aca_msg_book1_3_18_cutscene03"
	val[]: "Koska tilaa on vähemmän, ajoituksesi on tärkeämpi. Käännä perävaunu oikealla hetkellä ja katso vetoauton ja perävaunun pyöristä mihin yhdistelmä menee. Huomioi perän heilahdus äläkä aja linkkuun - jatka perävaunun työntämistä."

	key[]: "aca_msg_book1_3_18_cutscene04"
	val[]: "Koeta kääntää perävaunu kohti kujaa mieluummin ennemmin kuin myöhemmin. Näin saat tilaa toiselle puolelle kääntää perävaunun etupää ja saada vetoauto sen eteen."

	key[]: "aca_msg_book1_3_18_cutscene05"
	val[]: "Kun perävaunusi on kujalla, ohjaa vetoauto sen eteen. Tämä on parempi tehdä hieman aikaisemmin kuin vaistosi saattaisivat sanoa. Voit aina korjata sitä samalla kun peruutat lopulliseen sijaintiin."

	key[]: "aca_msg_book1_3_18_cutscene06"
	val[]: "Suorista vetoauto ja perävaunu ja pysähdy kohdealueelle."

	key[]: "aca_msg_book1_3_18_cutscene07"
	val[]: "Varmista kuorma-auto ja sammuta moottori."


#### 3_18 Driving Instructions

	key[]: "aca_msg_book1_3_18_start"
	val[]: "Nyt koetamme kääntää perävaunua paljon pienemmällä alueella 'kujapysäköinti' liikkeellä. <br><br><font face=/font/big_bold.font>Valmistaudu liikkeellelähtöön. </font>"

	key[]: "aca_msg_book1_3_18_backward"
	val[]: "Tarkista ympäristösi ja etsi pysäköintipaikka takaasi. <br><br><font face=/font/big_bold.font>Aloita peruuttaminen kohti pysäköintipaikkaa. </font>"

	key[]: "aca_msg_book1_3_18_check1"
	val[]: "<font face=/font/big_bold.font>Käännä perävaunu pysäköintipaikkaan. </font>"
#!{
	key[]: "aca_msg_book1_3_18_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_18_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}


#@}

#+ Book 1 Scenario 3_19
#@{

#### 3_19 common
	key[]: "aca_scenario_book1_3_19_title"
	val[]: "Loppukoe (Osa 1)"

	key[]: "aca_scenario_book1_3_19_desc"
	val[]: "Loppukoe odottaa sinua. Siinä pääset näyttämään taitosi kaikissa aikaisemmissa tehtävissä oppimissasi taidoissa. Ajamme ympäri koko harjoituskeskusta ja näemme miten hyvin selviät aikaisemmin kohtaamistasi tilanteista.<br><br>Kun olet suorittanut kaikki osuudet ja tilanteet, olet askeleen lähempänä voivasi kutsua itseäsi taitavaksi rekkakuskiksi!"

