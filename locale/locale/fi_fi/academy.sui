	key[]: "aca_msg_scenario_reverse_in_forward_out"
	val[]: "Peruuta merkittyyn paikkaan ja aja sitten eteenpäin."

	key[]: "aca_msg_scenario_forward_in_reverse_out"
	val[]: "Aja eteenpäin merkittyyn paikkaan ja sen jälkeen peruuta sieltä pois."

	key[]: "aca_msg_scenario_reverse_continue"
