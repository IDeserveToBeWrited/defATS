#+ Text deviations for American Truck Simulator. Please, use only terms appropriate for USA (i.e. culture specific nuances, not American English).
#@{

#+ Music/radio player
#@{

#+ Hint shown if no music files are found. Also shown as tooltip when hovering over music_player button.

	key[]: "music_player_hint"
	val[]: "Nähdäksesi omat musiikkikappaleesi täällä, laita ne <color value=@@clr_sel@@>American Truck Simulator/music <color value=@@clr_txt@@>-kansioon, jonka löydät <color value=@@clr_sel@@>Tiedostot<color value=@@clr_txt@@>-kansiostasi."

#+ Tooltip shown when hovering over the radio_stream button.

	key[]: "radio_hint"
	val[]: "Muokkaa <color value=@@clr_sel@@>live_streams.sii<color value=@@clr_txt@@>-tiedostoa <color value=@@clr_sel@@>American Truck Simulator<color value=@@clr_txt@@>-kansiosta, joka löytyy <color value=@@clr_sel@@>Tiedostot<color value=@@clr_txt@@>-kansiostasi, ja kuuntele suosikkinettiradiotasi pelissä!"

#+ Hint shown if no online radio streams are defined.

	key[]: "empty_radio_hint"
	val[]: "Katso <color value=@@clr_sel@@>readme.rtf <color value=@@clr_txt@@>miten lisäät peliin radiostriimejä ja musiikkia. Tiedosto on <color value=@@clr_sel@@>American Truck Simulator <color value=@@clr_txt@@>-kansiossa, joka löytyy <color value=@@clr_sel@@>Tiedostot<color value=@@clr_txt@@>-kansiostasi."
#@}

