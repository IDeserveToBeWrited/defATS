    val[]: "Asiakkaan painopiste - lastin käsittely"

    key[]: "hint_cargo_prio_text"
    val[]: "Asiakkaalle on tärkeintä miten lastia käsitellään - toimituksesi kunto vaikuttaa merkittävästi bonukseesi ja sakkoosi. Aja turvallisesti ja pidä huoli toimituksestasi.<br><offset vshift=8>Katso työn tiedot painamalla $KEY_advmouse$."


    key[]: "hint_time_prio_title"
    val[]: "Asiakkaan painopiste - ajanhallinta"

    key[]: "hint_time_prio_text"
    val[]: "Asiakkaalle on tärkeintä ajanhallinta - Täsmällisyytesi vaikuttaa merkittävästi bonukseesi ja sakkoosi. Aja turvallisesti ja saavu sovittuun aikaan.<br><offset vshift=8>Katso työn tiedot painamalla $KEY_advmouse$."


    key[]: "hint_car_deliv_title"
    val[]: "Lähesty määränpäätä"

    key[]: "hint_car_deliv_text"
    val[]: "Pysähdy merkitylle alueelle suorittaaksesi toimituksen loppuun.<br>Muista, että asiakas odottaa toimitusta sovittuun aikaan."


    key[]: "hint_car_early_title"
