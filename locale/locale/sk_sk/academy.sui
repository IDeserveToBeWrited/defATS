#### 3_03 msg - intro text

	key[]: "aca_msg_book1_3_03_cutscene01"
	val[]: "Pred tebou sú rôzne zložité zákruty a prekážky.<br>Vezmi do úvahy všetko, čo si sa doteraz naučil, a zvládnuť to by nemalo byť pre teba príliš zložité."

	key[]: "aca_msg_book1_3_03_cutscene02"
	val[]: "Ako prvá začína jednoduchá zákruta s nadbehnutím si typu „Button Hook“. Drž sa ďalej od vnútorného okraja a nemala by ti robiť problémy."

	key[]: "aca_msg_book1_3_03_cutscene03"
	val[]: "Pokračuj smerom ku kruhovému objazdu."

	key[]: "aca_msg_book1_3_03_cutscene04"
	val[]: "Udržuj náves ďalej od vnútornej strany kruhového objazdu tým, že budeš viesť ťahač čo najširšie okolo neho."

	key[]: "aca_msg_book1_3_03_cutscene05"
	val[]: "Ľavotočivá pravouhlá zákruta nie je príliš úzka, ale dávaj pozor, aby si nezhodil žiadne kužele."

	key[]: "aca_msg_book1_3_03_cutscene06"
	val[]: "Táto zákruta je jednoznačne užšia. Pre správny prechod zákrutou použi manéver s nadbehnutím si typu „Jug Handle“."

	key[]: "aca_msg_book1_3_03_cutscene07"
	val[]: "Pre túto zákrutu môžeš použiť nadbehnutie si typu „Button Hook“, ale dávaj si pozor na extra prekážky."

	key[]: "aca_msg_book1_3_03_cutscene09"
	val[]: "Posledná zákruta je opäť veľmi úzka a budeš musieť použiť kombináciu manévrov s nadbehnutím si „Jug Handle“ a „Button Hook“, aby si ju bezpečne zvládol."

	key[]: "aca_msg_book1_3_03_cutscene10"
	val[]: "Park in the designated area, secure the truck and shut down the engine."


#### 3_03 Driving Instructions



	key[]: "aca_msg_book1_3_03_forward"
	val[]: "<font face=/font/big_bold.font>Pokračuj k prvej zákrute. </font>"

	key[]: "aca_msg_book1_3_03_check1"
	val[]: "Ako prvá začína jednoduchá zákruta s nadbehnutím si typu „Button Hook“.<br><br><font face=/font/big_bold.font><color value=@@clr_txt@@>Postupuj cez zákrutu. </font>"

	key[]: "aca_msg_book1_3_03_check2"
	val[]: "Pokračuj ku kruhovému objazdu. Pri prechádzaní si nezabudni nadbehnúť.<br><br><font face=/font/big_bold.font>Prejdi kruhovým objazdom.</font>"

	key[]: "aca_msg_book1_3_03_check3"
	val[]: "Táto pravouhlá zákruta je o niečo užšia, preto dávaj pozor, aby si nezrazil žiadne kužele.<br><br><font face=/font/big_bold.font>Prejdi zákrutou.</font>"

	key[]: "aca_msg_book1_3_03_check4"
	val[]: "K tejto zákrute je najlepšie pristúpiť pomocou manévru s nadbehnutím. Nadbehni si naširoko pred vjazdom do križovatky.<br><br><font face=/font/big_bold.font>Zatoč pomocou manévru s nadbehnutím.</font>"

	key[]: "aca_msg_book1_3_03_check5"
	val[]: "Táto zákruta je posiata rôznymi prekážkami, ale dá sa zvládnuť pomocou manévru „button hook“.<br><br><font face=/font/big_bold.font>Postupuj opatrne. </font>"

	key[]: "aca_msg_book1_3_03_check6"
	val[]: "Táto zákruta je zatiaľ najužšia, prejdi ju podľa vlastného uváženia.<br><br><font face=/font/big_bold.font>Odboč na parkovisko.</font>"
#!{
	key[]: "aca_msg_book1_3_03_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_03_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

#@}

#+ Book 1 Scenario 3_04
#@{

#### 3_04 common
	key[]: "aca_scenario_book1_3_04_title"
	val[]: "Pokročilá tréningová trať - náves"

	key[]: "aca_scenario_book1_3_04_desc"
	val[]: "V záverečnom scenári 3. kapitoly nás čaká dlhšia tréningová trať s rôznymi zákrutami, na ktorej uvidíme, ako dobre si sa naučil manévrovať s návesom."

