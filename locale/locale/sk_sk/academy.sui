#### 2_06 msg - intro text

	key[]: "aca_msg_book1_2_06_cutscene01"
	val[]: "V poslednom scenári tejto kapitoly budeme jazdiť na testovacej trati s náročnou konfiguráciou."

	key[]: "aca_msg_book1_2_06_cutscene02"
	val[]: "Prvou prekážkou je slalom cez niekoľko bariér. Prejdi cez ne a nezabudni používať zrkadlá."

	key[]: "aca_msg_book1_2_06_cutscene04"
	val[]: "Nasleduje vlásenková zákruta. Drž si široký oblúk a nemal by ti robiť problémy."

	key[]: "aca_msg_book1_2_06_cutscene05"
	val[]: "Cesta vpredu sa výrazne zužuje. Pokračuj opatrne a ako pomôcku použi bočné zrkadlo."

	key[]: "aca_msg_book1_2_06_cutscene06"
	val[]: "Nasleduje séria ľahkých pravouhlých zákrut."

	key[]: "aca_msg_book1_2_06_cutscene08"
	val[]: "Ďalšiu časť musíš zvládnuť cúvaním. Prístup k prekážkam pred tebou s týmto vedomím."

	key[]: "aca_msg_book1_2_06_cutscene09"
	val[]: "Nasleduj dopravné značenie za tebou a v oblasti zákrut."

	key[]: "aca_msg_book1_2_06_cutscene10"
	val[]: "Cúvaj k prekážkam, potom zastav a pokračuj dopredu vpravo."

	key[]: "aca_msg_book1_2_06_cutscene11"
	val[]: "This passage through the cones is very narrow. Drive slowly and use your mirrors to orient yourself within the passage."

	key[]: "aca_msg_book1_2_06_cutscene13"
	val[]: "Pred tebou je séria striedavo ľavých a pravých pravouhlých zákrut."

	key[]: "aca_msg_book1_2_06_cutscene15"
	val[]: "Na tomto priecestí môžeš stretnúť vlaky. Ak ho stretneš, zastav a počkaj pokiaľ prejde. Potom môžeš odbočiť doprava na obslužnú cestu."

	key[]: "aca_msg_book1_2_06_cutscene16"
	val[]: "Odboč vľavo na vozovku. Po odbočení môžeš nabrať rýchlosť."

	key[]: "aca_msg_book1_2_06_cutscene18"
	val[]: "Ešte pár odbočení doľava v rámci mesta a budeš v cieli!"

	key[]: "aca_msg_book1_2_06_cutscene19"
	val[]: "Priblíž sa k prekážkam pred tebou a priprav sa zaparkovať na parkovacie miesto na pravej strane."

	key[]: "aca_msg_book1_2_06_cutscene20"
	val[]: "Zacúvaj na parkovacie miesto, potom vypni motor a zabezpeč ťahač."

#### 2_06 Driving Instructions



	key[]: "aca_msg_book1_2_06_forward"
	val[]: "Pred tebou sa nachádza slalom vytvorený z bariér.<br><br><font face=/font/big_bold.font>Prejdi cez slalom.</font>"

	key[]: "aca_msg_book1_2_06_forward2"
	val[]: "<font face=/font/big_bold.font>Nasleduj trasu cez vlásenkovú zákrutu. </font>"

	key[]: "aca_msg_book1_2_06_check1"
	val[]: "Trasa pred tebou sa výrazne zúžila. Pre orientáciu môžeš použiť bočné zrkadlá.<br><br><font face=/font/big_bold.font>Postupuj opatrne. </font>"

	key[]: "aca_msg_book1_2_06_check2"
	val[]: "Po tejto zákrute nasleduje pravouhlá zákruta.<br><br><font face=/font/big_bold.font>Prispôsob tomu rýchlosť.</font>"

	key[]: "aca_msg_book1_2_06_check3"
	val[]: "Pred tebou je ďalších pár jednoduchých zákrut, podľa potreby pokračuj v prispôsobovaním rýchlosti.<br><br><font face=/font/big_bold.font>Pokračuj v jazde. </font>"

	key[]: "aca_msg_book1_2_06_check4"
	val[]: "The following section must be completed in reverse. Stop at the barriers ahead so that you can reverse to the right afterwards.<br><br><font face=/font/big_bold.font>Stop at the barriers.</font>"

	key[]: "aca_msg_book1_2_06_check5"
	val[]: "Cúvaj smerom za seba a vpravo.<br><br><font face=/font/big_bold.font>Začni cúvať. </font>"

	key[]: "aca_msg_book1_2_06_reverse"
	val[]: "Nasleduj trasu okolo zákrut.<br><br><font face=/font/big_bold.font>Pokračuj v cúvaní.</font>"

	key[]: "aca_msg_book1_2_06_check6"
	val[]: "Za tebou po ľavej strane sú prekážky. <br><br><font face=/font/big_bold.font>Zatoč k prekážkam a buď pripravený zastaviť.</font>"

	key[]: "aca_msg_book1_2_06_check7"
	val[]: "Zastav a preraď dopredu, potom pokračuj vpravo. <br><br><font face=/font/big_bold.font>Pokračuj vpred. </font>"

	key[]: "aca_msg_book1_2_06_check8"
	val[]: "In front of you is a narrow winding path through some cones. Drive carefully and use your mirrors if necessary.<br><br><font face=/font/big_bold.font>Drive through the cones. </font>"

	key[]: "aca_msg_book1_2_06_check9"
	val[]: "Nasleduje kombinácia rôznych pravouhlých zákrut. Uisti sa, že si každú zákrutu dostatočne nadbehneš.<br><br><font face=/font/big_bold.font>Pokračuj v jazde. </font>"

	key[]: "aca_msg_book1_2_06_check10"
	val[]: "Sleduj železničné priecestie, keď sa k nemu približuješ. Signalizácia sa môže aktivovať, aby oznámila prichádzajúci vlak.<br><br><font face=/font/big_bold.font>Opatrne pokračuj.</font>"

	key[]: "aca_msg_book1_2_06_check11"
	val[]: "Odbočenie na servisnú cestu je čiastočne blokované prekážkou, takže sa pri približovaní drž vľavo, aby si mal viac miesta.<br><br><font face=/font/big_bold.font>Prejdi zákrutou. </font>"

	key[]: "aca_msg_book1_2_06_check12"
	val[]: "Môžeš si vybrať, či budeš značku stop poslúchneš alebo ju budeš ignorovať. Oblasť bola pre našu potrebu uzavretá.<br><br><font face=/font/big_bold.font>Zaboč doľava.</font>"

	key[]: "aca_msg_book1_2_06_check13"
	val[]: "V tejto časti môžeš zvýšiť rýchlosť, ale na ďalšej križovatke budeš musieť zabočiť.<br><br><font face=/font/big_bold.font>Pokračuj v trase. </font>"

	key[]: "aca_msg_book1_2_06_check14"
	val[]: "Pokračuj do mesta odbočkou doľava, po ktorej nasledujú ďalšie dve odbočky doľava do cieľovej oblasti.<br><br><font face=/font/big_bold.font>Prejdi cez mesto.</font>"

	key[]: "aca_msg_book1_2_06_check15"
	val[]: "Na druhej strane parkoviska sú prekážky. Prejdi k ním. <br><br><font face=/font/big_bold.font>Zastav v blízkosti prekážok. </font>"

	key[]: "aca_msg_book1_2_06_check16"
	val[]: "Za tebou na pravej strane sa nachádza parkovacie miesto.<br><br><font face=/font/big_bold.font>Nacúvaj do parkovacieho miesta. </font>"
#!{
	key[]: "aca_msg_book1_2_06_check17"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_06_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_2_06_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

#@}

#+ Book 1 Scenario 2_08
#@{

#### 2_08 common
	key[]: "aca_scenario_book1_2_08_title"
	val[]: "Jednoduchá tréningová trať"

	key[]: "aca_scenario_book1_2_08_desc"
	val[]: "V tomto scenári si vyskúšaš zručnosti, ktoré si sa doteraz naučil, na jednoduchom jazdení cez základný tréningový kurz."

#### 2_08 goal
#!{
	key[]: "aca_goal_book1_2_08_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_08_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_2_08_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
#!}
	key[]: "aca_goal_book1_2_08_forward"
	val[]: "Vstup na trať"

	key[]: "aca_goal_book1_2_08_check1"
	val[]: "Široká vlásenka"

	key[]: "aca_goal_book1_2_08_check2"
	val[]: "Jazda cez slalom"

	key[]: "aca_goal_book1_2_08_check3"
	val[]: "Úzka vlásenka"

	key[]: "aca_goal_book1_2_08_check4"
	val[]: "Úzka zákruta"

	key[]: "aca_goal_book1_2_08_check6"
	val[]: "Technická sekcia"

	key[]: "aca_goal_book1_2_08_check7"
	val[]: "Otvorený úsek"



#### 2_08 msg - intro text

	key[]: "aca_msg_book1_2_08_cutscene1"
	val[]: "V tomto scenári si vezmeš ťahač na krátku jazdu, aby si zistil, ako s ňou zvládaš svoje novonadobudnuté zručnosti.<br>Na trati sú rôzne typy a kombinácie zákrut. Nie je to pretekanie a nezáleží na čase. Buď trpezlivý a prispôsob svoju rýchlosť jazdy zákrutám a prekážkam, s ktorými sa stretneš."

	key[]: "aca_msg_book1_2_08_cutscene2"
	val[]: "Vstup na trať so širokou vlásenkovou zákrutou."

	key[]: "aca_msg_book1_2_08_cutscene3"
	val[]: "Ďalej sa stretneš so sériou prekážok, ktoré ťa zavedú do nepravidelného slalomu."

	key[]: "aca_msg_book1_2_08_cutscene4"
	val[]: "Po dokončení niekoľkých jednoduchých pravouhlých zákrut narazíš na ostrú vlásenkovú zákrutu. Je dôležité sa správne pripraviť, aby si dokončil zákrutu a plynule prešiel do ďalšej sekcie."

	key[]: "aca_msg_book1_2_08_cutscene5"
	val[]: "Dávaj pozor na kužele, keď prechádzaš dlhou zákrutou, pretože viditeľnosť cez kapotu je obmedzená."

	key[]: "aca_msg_book1_2_08_cutscene6"
	val[]: "Ďalšia skupina prekážok ťa navedie do širokého slalomu."

	key[]: "aca_msg_book1_2_08_cutscene7"
	val[]: "Trať sa trochu otvára, ale neponáhľaj sa. Ešte pár ľahkých zákrut a si hotový."

	key[]: "aca_msg_book1_2_08_cutscene8"
	val[]: "Stop in the designated area and secure the truck."


#### 2_08 Driving Instructions

	key[]: "aca_msg_book1_2_08_start"
	val[]: "Aby si úspešne zvládol tento scenár, nesmieš havarovať, zísť z trate ani naraziť do dopravných kužeľov.<br><br><font face=/font/big_bold.font>Priprav sa vyraziť. </font>"

	key[]: "aca_msg_book1_2_08_forward"
	val[]:"<font face=/font/big_bold.font>Pokračuj dopredu do širokej vlásenkovej zákruty, aby si vstúpil na trať. </font>"

	key[]: "aca_msg_book1_2_08_check1"
	val[]: "<font face=/font/big_bold.font>Prejdi vlásenkovou zákrutou. </font>"

	key[]: "aca_msg_book1_2_08_check2"
	val[]: "Blížiš sa k prekážkam usporiadaným priblížne do slalomu.<br><br><font face=/font/big_bold.font>Prispôsob tomu rýchlosť a pokračuj.</font>"

	key[]: "aca_msg_book1_2_08_check3"
	val[]: "Nasledujú dve jednoduché pravouhlé zákruty, na ktoré nadväzuje ostrá vlásenková zákruta. Choď pomaly.<br><br><font face=/font/big_bold.font>Pokračuj do úzkej vlásenkovej zákruty.</font>"

	key[]: "aca_msg_book1_2_08_check4"
	val[]: "Po výjazde z vlásenky narazíš na úzku cestu so zákrutou. Musíš sa vyhnúť vnútornej bariére, ale dávaj pozor, aby si nenarazil do žiadnych kužeľov pred tebou.<br><br><font face=/font/big_bold.font>Pokračuj v prejazde zákrutou. </font>"

	key[]: "aca_msg_book1_2_08_check6"
	val[]: "Cesta pred tebou má niekoľko tesných a technických zákrut. Prispôsob rýchlosť a opatrne sa prepracuj touto časťou.<br><br><font face=/font/big_bold.font>Pokračuj v jazde. </font>"

	key[]: "aca_msg_book1_2_08_check7"
	val[]: "Nasledujúca časť je otvorenejšia s niekoľkými jednoduchými zákrutami. Neponáhľaj sa.<br><br><font face=/font/big_bold.font>Pokračuj v jazde. </font>"
#!{
	key[]: "aca_msg_book1_2_08_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_08_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

#@}

#+ Book 1 Scenario 2_09
#@{

#### 2_09 common
	key[]: "aca_scenario_book1_2_09_title"
	val[]: "Pozdĺžne parkovanie"

	key[]: "aca_scenario_book1_2_09_desc"
	val[]: "V tomto scenári sa pozrieme na pozdĺžne parkovanie medzi dvoma ďalšími ťahačmi."

#### 2_09 goal

	key[]: "aca_goal_book1_2_09_stopmid"
	val[]: "Zastavenie pred parkovacím miestom"

	key[]: "aca_goal_book1_2_09_checkmirror"
	val[]: "Kontrola spätného zrkadla"

	key[]: "aca_goal_book1_2_09_backward"
	val[]: "Cúvanie na parkovacie miesto"

	key[]: "aca_goal_book1_2_09_stop"
	val[]: "Zarovnanie ťahača na parkovacom mieste"

#!{
	key[]: "aca_goal_book1_2_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_09_check1"
	val[]: "@@aca_goal_book1_1_03_forward@@"


	key[]: "aca_goal_book1_2_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"



 #!}
#### 2_09 msg - intro text

	key[]: "aca_msg_book1_2_09_cutscene1"
	val[]: "Pozdĺžne parkovanie je kľúčová zručnosť, ktorú by mal ovládať každý vodič kamiónu.<br>Priprav sa vyraziť."

	key[]: "aca_msg_book1_2_09_cutscene2"
	val[]: "Prejdi smerom k parkovaciemu miestu.<br>Venuj pozornosť svojmu okoliu."

	key[]: "aca_msg_book1_2_09_cutscene3"
	val[]: "Zrovnaj sa s ťahačom nachádzajúcim sa pred tvojím parkovacím miestom. Príliš sa nepribližuj, nechaj si priestor na manévrovanie."

	key[]: "aca_msg_book1_2_09_cutscene4"
	val[]: "Zatoč ostro smerom k parkovaciemu miestu a začni cúvať."

	key[]: "aca_msg_book1_2_09_cutscene5"
	val[]: "Keď sa pozeráš do ľavého spätného zrkadla, zameraj sa na obrubník tesne pred ťahačom za tebou."

	key[]: "aca_msg_book1_2_09_cutscene6"
	val[]: "Akonáhle predný nárazník prejde okolo ťahača pred tebou, môžeš začať zatáčať prednú časť ťahača do parkovacieho miesta a zarovnať ho."

	key[]: "aca_msg_book1_2_09_cutscene7"
	val[]: "Vyrovnaj volant a zarovnaj ťahač v parkovacom mieste.<br>Zaparkuj a zabezpeč vozidlo."

#### 2_09 Driving Instructions

	key[]: "aca_msg_book1_2_09_start"
	val[]: "Pred tebou je niekoľko zaparkovaných ťahačov. Zostalo jedno voľné miesto pre teba na parkovanie. <br><br><font face=/font/big_bold.font>Priprav sa vyraziť. </font>"

	key[]: "aca_msg_book1_2_09_check1"
	val[]: "Nezabúdaj byť stále v strehu všímať si svoje okolie. Pri tomto manévri dostatočne využívaj zrkadlá. <br><br><font face=/font/big_bold.font>Pokračuj vpred. </font>"

	key[]: "aca_msg_book1_2_09_stopmid"
	val[]: "<color value=@@clr_white@@>Prejdi okolo parkovacieho miesta do vyznačeného miesta. Odtiaľ môžeš začať cúvací manéver.<br><br><font face=/font/big_bold.font>Zastav na vyznačenom mieste. </font>"

	key[]: "aca_msg_book1_2_09_checkmirror"
	val[]: "Skontroluj okolie, či sa v tvojej ceste nenachádzajú prekážky, a uisti sa, že máš voľnú cestu k cúvaniu.<br><br><font face=/font/big_bold.font>Pozri sa cez bočné zrkadlo na strane spolujazdca. </font>"

	key[]: "aca_msg_book1_2_09_backward"
	val[]: "Otoč kolesá a zacúvaj do parkovacieho miesta.<br><br><font face=/font/big_bold.font>Začni cúvať. </font>"

	key[]: "aca_msg_book1_2_09_stop"
	val[]: "Začni vyrovnávať ťahač, keď to bude vhodné. Dávaj pozor, aby si neprešiel cez obrubník!<br><br><font face=/font/big_bold.font>Zarovnaj ťahač s parkovacím miestom. </font>"
#!{
	key[]: "aca_msg_book1_2_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

