#### 3_19 msg - intro text

	key[]: "aca_msg_book1_3_19_cutscene01"
	val[]: "Vitaj v prvej časti záverečnej skúšky. Tu uvidíme, ako dobre si sa naučil riadiť ťahač počas tvojho času stráveného v autoškole."

	key[]: "aca_msg_book1_3_19_cutscene02"
	val[]: "Najprv pripojíš náves. Po pripojení prejdeš s ťahačom po celej testovacej trase."

	key[]: "aca_msg_book1_3_19_cutscene03"
	val[]: "Prvá časť testu ťa zavedie po vedľajších cestách, ktorými sa dostaneš k centru mesta."

	key[]: "aca_msg_book1_3_19_cutscene04"
	val[]: "Testovacia trasa zahŕňa rôzne druhy zákrut a prekážok."

	key[]: "aca_msg_book1_3_19_cutscene05"
	val[]: "Malá časť trasy vedie cez centrum mesta."

	key[]: "aca_msg_book1_3_19_cutscene06"
	val[]: "Otestujeme tvoju schopnosť manévrovať s ťahačom cez rôzne prekážky a trate."

	key[]: "aca_msg_book1_3_19_cutscene07"
	val[]: "Stretneš sa s rôznymi situáciami, ktoré otestujú tvoju pozornosť voči okoliu."

	key[]: "aca_msg_book1_3_19_cutscene08"
	val[]: "Necháme ťa cúvať cez priemyselný objekt."

	key[]: "aca_msg_book1_3_19_cutscene09"
	val[]: "Po jazde po cestách, cez centrum mesta a v priemyselnom objekte zamieriš do sídla @@driving_academy@@."

	key[]: "aca_msg_book1_3_19_cutscene10"
	val[]: "Krátka jazda po ceste a už budeš skoro hotový."

	key[]: "aca_msg_book1_3_19_cutscene11"
	val[]: "Aby si dokončil test, budeš musieť presne zaparkovať. Môžeš si vybrať manéver, ktorý ti najviac vyhovuje."

	key[]: "aca_msg_book1_3_19_cutscene12"
	val[]: "Nebuď nervózny, už si sa naučil všetko, čo budeš potrebovať na úspešné zvládnutie testu.<br><br>Veľa šťastia!"

#### 3_19 Driving Instructions



	key[]: "aca_msg_book1_3_19_forward"
	val[]: "Najprv budeš musieť nájsť a pripojiť náves. Je zaparkovaný vpredu vpravo.<br><br><font face=/font/big_bold.font>Prejdi smerom k návesu. </font>"

	key[]: "aca_msg_book1_3_19_coupling"
	val[]: "Odboč doľava, potom cúvaj k návesu a zarovnaj sa s ním.<br><br><font face=/font/big_bold.font>Cúvaj k návesu. </font>"

	key[]: "aca_msg_book1_3_19_park_br_on"
	val[]: "<font face=/font/big_bold.font>Zabezpeč ťahač. </font>"

	key[]: "aca_msg_book1_3_19_connect"
	val[]: "<font face=/font/big_bold.font>Stlač @@imv_nrm_attach@@ pre pripojenie návesu. </font>"

	key[]: "aca_msg_book1_3_19_park_br_off"
	val[]: "Náves je pripojený a ťahač je pripravený na jazdu..<br><br><font face=/font/big_bold.font>Uvoľni parkovaciu brzdu. </font>"

	key[]: "aca_msg_book1_3_19_b_trailer"
	val[]: "Cesta bola uzavretá pre naše testovacie účely. Môžeš sa rozhodnúť, či budeš dodržiavať alebo ignorovať dopravné značky podľa toho, ako uznáš za vhodné.<br><br><font face=/font/big_bold.font>Prejdi smerom k ceste. </font>"

	key[]: "aca_msg_book1_3_19_check01"
	val[]: "Prejdi cez pár prvých zákrut. <br><br><font face=/font/big_bold.font>Pokračuj v jazde. </font>"

	key[]: "aca_msg_book1_3_19_check02"
	val[]: "Za ďalšou zákrutou sa nachádza slalom s dopravnými kužeľmi.<br><br><font face=/font/big_bold.font>Opatrne prejdi medzi dopravnými kužeľmi. </font>"

	#key[]: "aca_msg_book1_3_19_check02a"
	#val[]: "Continue through the roundabout into the town.<br><br><font face=/font/big_bold.font>Negotiate the roundabout.</font>"

	key[]: "aca_msg_book1_3_19_check02b"
	val[]: "Čaká ťa ešte niekoľko pravouhlých zákrut. <br><br><font face=/font/big_bold.font>Pokračuj v jazde. </font>"

	key[]: "aca_msg_book1_3_19_check03"
	val[]: "Nasledujúca zákruta je extrémne úzka a na jej úspešné zvládnutie budeš potrebovať celú cestu.<br><br><font face=/font/big_bold.font>Odboč doprava a prejdi cez uličku.</font>"

	key[]: "aca_msg_book1_3_19_check04"
	val[]: "Odboč doľava z uličky, potom odboč doprava na hlavnú cestu.<br><br><font face=/font/big_bold.font>Pokračuj v jazde. </font>"

	key[]: "aca_msg_book1_3_19_check05"
	val[]: "Môžeš si na chvíľu oddýchnuť, kým budeš pokračovať po hlavnej ceste. <br><br><font face=/font/big_bold.font>Pokračuj rovno. </font>"

	key[]: "aca_msg_book1_3_19_check06"
	val[]: "Na a z obslužnej cesty je viacero ostrých zákrut.<br><br><font face=/font/big_bold.font>Opatrne prejdi cez zákruty. </font>"

	key[]: "aca_msg_book1_3_19_check07"
	val[]: "Vchádzaš do zložitejšieho slalomu. Postupuj pomaly a používaj zrkadlá. <br><br><font face=/font/big_bold.font>Pokračuj v jazde a opatrne prejdi slalom.</font>"

	key[]: "aca_msg_book1_3_19_check08"
	val[]: "Odboč doľava do priemyselnej oblasti, dávaj pozor na stĺp verejného osvetlenia.<br><br><font face=/font/big_bold.font>Prejdi zákrutou vľavo. </font>"

	key[]: "aca_msg_book1_3_19_check09"
	val[]: "Priprav sa cúvať.<br><br><font face=/font/big_bold.font>Odboč doprava a zastav v ohraničenej oblasti. </font>"

	key[]: "aca_msg_book1_3_19_check10"
	val[]: "Cúvaj a nasleduj trasu doľava za tebou.<br><br><font face=/font/big_bold.font>Začni cúvať.</font>"

	key[]: "aca_msg_book1_3_19_check11"
	val[]: "Nasleduj trať naľavo. <br><br><font face=/font/big_bold.font>Pokračuj v cúvaní. </font>"

	key[]: "aca_msg_book1_3_19_check12"
	val[]: "<font face=/font/big_bold.font>Pokračuj vpred, potom zaboč doprava. </font>"

	key[]: "aca_msg_book1_3_19_check13"
	val[]: "<font face=/font/big_bold.font>Pokračuj k bráne. </font>"

	key[]: "aca_msg_book1_3_19_check14"
	val[]: "Počkaj, kým sa brána otvorí, potom pokračuj späť na hlavnú cestu.<br><br><font face=/font/big_bold.font>Pokračuj v jazde.</font>"

	key[]: "aca_msg_book1_3_19_check15"
	val[]: "Dávaj pozor, aby si nenarazil do značky.<br><br><font face=/font/big_bold.font>Dokonči prejazd zákrutou a pokračuj v jazde. </font>"

	key[]: "aca_msg_book1_3_19_check16"
	val[]: "<font face=/font/big_bold.font>Zaboč doľava do areálu autoškoly. </font>"

	key[]: "aca_msg_book1_3_19_check17"
	val[]: "<font face=/font/big_bold.font>Pokračuj rovno</font>"

	key[]: "aca_msg_book1_3_19_check18"
	val[]: "Drž sa vonkajšej strany, pretože za zakrivením trate je ďalšia ostrá zákruta.<br><br><font face=/font/big_bold.font>Pokračuj v prejazde zákrutou.</font>"

	key[]: "aca_msg_book1_3_19_check19"
	val[]: "<font face=/font/big_bold.font>Zaboč doľava a priprav sa zaparkovať naľavo.</font>"

	key[]: "aca_msg_book1_3_19_check20"
	val[]: "<font face=/font/big_bold.font>Nacúvaj do parkovacieho miesta</font>"
#!{
	key[]: "aca_msg_book1_3_19_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_19_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_19_start"
	val[]: "@@aca_msg_book1_2_02_start@@"
 #!}


#@}


#+ Book 1 Scenario 3_20
#@{

#### 3_20 common
	key[]: "aca_scenario_book1_3_20_title"
	val[]: "Záverečná skúška (2. časť)"

	key[]: "aca_scenario_book1_3_20_desc"
	val[]: "Posledná časť záverečnej skúšky ťa ešte len čaká. Budú v nej vyhodnotené tvoje parkovacie zručnosti, ktoré si sa naučil v predchádzajúcich scenároch. Parkuj opatrne a presne a budeš pripravený vyraziť na americké cesty ako skúsený kamionista!"

