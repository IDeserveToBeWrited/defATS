	key[]: "aca_goal_book1_3_06_check1"
	val[]: "Manévrovanie na miesto"


#### 3_06 msg - intro text

	key[]: "aca_msg_book1_3_06_cutscene01"
	val[]: "Parkovanie pri jazde vpred je pokiaľ ide o parkovacie manévre pomerne jednoduché.<br>Stále však budeš musieť kompenzovať posunutý pohyb návesu."

	key[]: "aca_msg_book1_3_06_cutscene02"
	val[]: "Budeš musieť prejsť za bod, pri ktorom by si začal zatáčať iba so samotným ťahačom bez návesu. To ti umožní účinnejšie zarovnať náves."

	key[]: "aca_msg_book1_3_06_cutscene03"
	val[]: "Pri približovaní sa k parkovaciemu miestu zatoč tak, aby si dostal ťahač pred náves. Zarovnaj sa a pokračuj na parkovacie miesto.<br> Zastav, zaparkuj, zabezpeč ťahač a vypni motor."

#### 3_06 Driving Instructions

	key[]: "aca_msg_book1_3_06_start"
	val[]: "Pred tebou je parkovacie miesto, na ktoré budeš musieť zájsť a zaparkovať.<br><br><font face=/font/big_bold.font>Priprav sa vyraziť.</font>"

	key[]: "aca_msg_book1_3_06_forward"
	val[]: "<font face=/font/big_bold.font>Pohni sa a zaboč smerom k parkovaciemu miestu.</font>"

	key[]: "aca_msg_book1_3_06_check1"
	val[]: "Prejdi okolo parkovacieho miesta, aby si náves zarovnal s vyznačeným miestom. Následne prejdi s ťahačom na miesto a vyrovnaj sa.<br><br><font face=/font/big_bold.font>Zaparkuj vo vyznačenom mieste.  </font>"

	key[]: "aca_msg_book1_3_06_stop"
	val[]: "<font face=/font/big_bold.font>Zastav v určenej oblasti.</font>"

	key[]: "aca_msg_book1_3_06_end"
	val[]: "<font face=/font/big_bold.font>Zabezpeč ťahač a vypni motor.</font>"
#@}

