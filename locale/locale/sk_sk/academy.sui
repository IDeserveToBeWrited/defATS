#+ Book 3 Scenario urf
#@{

#### urf common
	key[]: "aca_scenario_book3_urf_title"
	val[]: "Voľné cúvanie"

	key[]: "aca_scenario_book3_urf_desc"
	val[]: "V tomto scenári budeš na prázdnom parkovisku cvičiť cúvanie s B-double návesmi."

#### urf goal

	key[]: "aca_goal_book3_urf_start"
	val[]: "Začíname"

	key[]: "aca_goal_book3_urf_move"
	val[]: "Experimentovanie"

	key[]: "aca_goal_book3_urf_stop"
	val[]: "Posledné kroky"

	key[]: "aca_goal_book3_urf_end"
	val[]: "Ukončenie scenára"

	#### urf msg - intro text

	key[]: "aca_msg_book3_urf_cutscene1"
	val[]: "Cúvanie s B-double návesmi si vyžaduje oveľa viac pozornosti než s jedným návesom. Musíš si vopred naplánovať, kam chceš nasmerovať zadný náves, a zároveň si udržať kontrolu nad predným návesom s ťahačom.<br><br>Môžeš o tom premýšľať asi takto – je potrebné používať predný náves na riadenie zadného návesu. Takže kamkoľvek nasmeruješ predný náves, zmení sa aj trajektória zadného návesu."

	key[]: "aca_msg_book3_urf_cutscene2"
	val[]: "In this case, we want to turn the rear trailer to the driver's side. <br><br>To do this, we steered the lead to the passenger's side."

	key[]: "aca_msg_book3_urf_cutscene3"
	val[]: "Práve v tomto momente väčšina ľudí zvyčajne urobí prvú chybu. Keď sa zadný náves začne otáčať, je potrebné vyrovnať ťahač s predným návesom…"

	key[]: "aca_msg_book3_urf_cutscene4"
	val[]: "...inak skončíš takto zalomený."

	key[]: "aca_msg_book3_urf_cutscene5"
	val[]: "K zalomeniu dochádza, keď uhol medzi dvoma vozidlami v kombinácii dosiahne približne 90 stupňov. Akonáhle k nemu dôjde, nie je možné situáciu zachrániť. Jedinou možnosťou je posunúť sa dopredu a skúsiť to znova..<br><br>Rovnako ako pri cúvaní s jedným návesom je cieľom vždy zabezpečiť, aby sa všetky kolesá návesov pohybovali. Akonáhle sa jedno koleso zastaví a náves sa otáča na mieste, nemôžeš pokračovať."

	key[]: "aca_msg_book3_urf_cutscene6"
	val[]: "Môžeš sa vrátiť na miesto, kde si naposledy postupoval správne. To znamená do pozície, z ktorej môžeš pokračovať v cúvaní bez toho, aby si sa znovu dostal do rovnakej situácie, alebo sa jednoducho vyrovnaj jazdou dopredu."

	key[]: "aca_msg_book3_urf_cutscene7"
	val[]: "Akonáhle sa zadný náves začne otáčať, opäť posuň ťahač dopredu a nechaj na chvíľu otáčať sa iba samotný zadný náves."

	key[]: "aca_msg_book3_urf_cutscene8"
	val[]: "Teraz, keď sa zadný náves pekne otáča, je čas nasmerovať predný náves tak, aby ho nasledoval. Môžeš upravovať uhol medzi predným a zadným návesom počas prejazdu zákrutou a prejsť ju buď ostrejšie, alebo viac zoširoka."

	key[]: "aca_msg_book3_urf_cutscene9"
	val[]: "Poslednou časťou manévru je všetko vyrovnať. Dostaň prednú časť pred zadný náves."

	key[]: "aca_msg_book3_urf_cutscene10"
	val[]: "Maj na pamäti, koľko času zaberie presun predného návesu, a že budeš musieť vyrovnať aj ťahač."

	key[]: "aca_msg_book3_urf_cutscene11"
	val[]: "Tu môžeš stráviť toľko času, koľko len chceš. Vyskúšať si rôzne manévre, kým nezískaš hrubú predstavu o tom, ako pri cúvaní manipulovať s návesmi."

#### urf Driving Instructions

	key[]: "aca_msg_book3_urf_start"
	val[]: "Priprav sa vyraziť."

	key[]: "aca_msg_book3_urf_move"
	val[]: "Využi toto parkovisko na vyskúšanie cúvania s návesom.<br><br>@@aca_goal_tip@@ Si v cúvaní s návesom úplný začiatočník? Skús si najskôr zahrať časť Základy jazdy s kamiónom."

	key[]: "aca_msg_book3_urf_stop"
	val[]: "Skúšaj si to tak dlho, ako len budeš chcieť.<br><br>Keď budeš hotový, zastav a zaisti ťahač, čím scenár ukončíš."

	key[]: "aca_msg_book3_urf_end"
	val[]: "Pre ukončenie scenára vypni motor."
#@}


#+ Book 3 Scenario sup
#@{

#### sup common
	key[]: "aca_scenario_book3_sup_title"
	val[]: "Parkovanie na úzkom mieste"

	key[]: "aca_scenario_book3_sup_desc"
	val[]: "V tomto scenári máš za úlohu zaparkovať s B-double návesmi na úzkom mieste."

#### sup goal

	key[]: "aca_goal_book3_sup_start"
	val[]: "Začíname"

	key[]: "aca_goal_book3_sup_forward"
	val[]: "Vyrážame"

	key[]: "aca_goal_book3_sup_check1"
	val[]: "Pokračuj v jazde"

	key[]: "aca_goal_book3_sup_stop"
	val[]: "Zastavenie"

	key[]: "aca_goal_book3_sup_end"
	val[]: "Zabezpečenie vozidla"

#### sup msg - intro text

	key[]: "aca_msg_book3_sup_cutscene1"
	val[]: "Jazda s B-double návesom môže pôsobiť zastrašujúco, ale v skutočnosti sa až tak nelíši od jazdy s jedným návesom – musíš len navyše sledovať dráhu zadného návesu."

	key[]: "aca_msg_book3_sup_cutscene2"
	val[]: "Pred tebou je úzke parkovacie miesto. Nebudeš mať dostatok priestoru na to, aby si sa pred vjazdom dokonale vyrovnal, preto si musíš starostlivo premyslieť, ako sa tam dostaneš s oboma návesmi."

	key[]: "aca_msg_book3_sup_cutscene3"
	val[]: "Ihneď zatoč smerom k vzdialenejšej strane parkovacieho miesta a prejdi výrazne ďalej, než by si normálne začal zatáčať."

	key[]: "aca_msg_book3_sup_cutscene4"
	val[]: "Teraz, keď je tvoj zadný náves v správnej polohe, môžeš zamieriť k cieľovému miestu. Možno bude potrebné ísť smerom k opačnej strane, aby si pomohol natočiť prvý náves."

	key[]: "aca_msg_book3_sup_cutscene5"
	val[]: "Pokračuj na miesto, oba návesy ťa budú nasledovať a počas jazdy sa postupne vyrovnajú."

	key[]: "aca_msg_book3_sup_cutscene6"
	val[]: "Zaparkuj na určenom mieste a zabezpeč ťahač."

#### sup Driving Instructions

	key[]: "aca_msg_book3_sup_start"
	val[]: "Priprav sa vyraziť."

	key[]: "aca_msg_book3_sup_forward"
	val[]: "Pokračuj dopredu a vojdi do úzkeho priestoru."

	key[]: "aca_msg_book3_sup_check1"
	val[]: "Pokračuj v jazde."

	key[]: "aca_msg_book3_sup_stop"
	val[]: "Zastav v určenej oblasti."

	key[]: "aca_msg_book3_sup_end"
	val[]: "Zabezpeč ťahač a vypni motor."
#@}


