	key[]: "aca_goal_book3_parallel_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
#### parallel msg - intro text

	key[]: "aca_msg_book3_parallel_cutscene1"
	val[]: "Prejdi zákrutou a vyjdi na cestu. Tam nájdeš pre seba voľné miesto."

	key[]: "aca_msg_book3_parallel_cutscene2"
	val[]: "Zajdi na parkovacie miesto a prejdí ním. To ti pomôže dostať návesy bližšie k cieľu."

	key[]: "aca_msg_book3_parallel_cutscene3"
	val[]: "Pokračuj von z parkovacieho miesta a poriadne si nadbehni, aby si mal priestor na manévrovanie."

	key[]: "aca_msg_book3_parallel_cutscene4"
	val[]: "Pomocou prvého návesu zatlač zadný náves na miesto. Všetko si budeš musieť dopredu naplánovať, aby si sa uistil, že každý náves skončí tam, kde ho potrebuješ mať."

	key[]: "aca_msg_book3_parallel_cutscene5"
	val[]: "Možno sa budeš musieť niekoľkokrát pohnúť dopredu a dozadu, aby si všetko dostal tam, kam potrebuješ."

	key[]: "aca_msg_book3_parallel_cutscene6"
	val[]: "Akonáhle budeš spokojný so zarovnaním voči okraju vozovky, vyrovnaj súpravu do stredu parkovacieho miesta a zaisti vozidlo."

#### parallel Driving Instructions

#!{
	key[]: "aca_msg_book3_parallel_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_parallel_forward"
	val[]: "Pohni sa, nájdi svoje parkovacie miesto a priprav sa na cúvanie."

	key[]: "aca_msg_book3_parallel_check1"
	val[]: "Cúvanie na miesto."

	key[]: "aca_msg_book3_parallel_stop"
	val[]: "Zastav v určenej oblasti."

	key[]: "aca_msg_book3_parallel_end"
	val[]: "Zabezpeč ťahač a vypni motor."
#@}




