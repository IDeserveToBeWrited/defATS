#### 3_04 msg - intro text

	key[]: "aca_msg_book1_3_04_cutscene01"
	val[]: "Pamätaj si, že pri každej zákrute je potrebné plánovať dopredu a dobre využiť priestor okolo seba. Prejdi okolo prvých prekážok pred tebou a pokračuj na trať."

	key[]: "aca_msg_book1_3_04_cutscene02"
	val[]: "Prvé zákruty budú postupne ostrejšie."

	key[]: "aca_msg_book1_3_04_cutscene03"
	val[]: "Pamätaj, že výjazd z jednej zákruty môže ovplyvniť tvoj vjazd do ďalšej."

	key[]: "aca_msg_book1_3_04_cutscene04"
	val[]: "Prvá z náročnejších zákrut kombinuje dve ostré vlásenkové zákruty. Budeš musieť byť veľmi opatrný a rozvážny pri jazde a využiť zrkadlá vo svoj prospech."

	key[]: "aca_msg_book1_3_04_cutscene05"
	val[]: "Pokračuj cez úzky úsek."

	key[]: "aca_msg_book1_3_04_cutscene06"
	val[]: "Nasleduje niekoľko ľahkých zákrut na ceste k úzkej vlásenkovej zákrute."

	key[]: "aca_msg_book1_3_04_cutscene07"
	val[]: "Buď stále na pozore, aby si nenarazil do žiadnych prekážok. Choď tak pomaly, ako potrebuješ."

	key[]: "aca_msg_book1_3_04_cutscene08"
	val[]: "Aj keď sa zdá, že máš veľa priestoru na manévrovanie, môžeš sa stále ocitnúť v stiesnenej situácii."

	key[]: "aca_msg_book1_3_04_cutscene09"
	val[]: "Najzložitejšia zákruta je hneď pred tebou. Tvoj vjazd do zákruty určí, či ju úspešne zvládneš alebo nie."

	key[]: "aca_msg_book1_3_04_cutscene10"
	val[]: "Pokračuj k poslednej zákrute."

	key[]: "aca_msg_book1_3_04_cutscene11"
	val[]: "Stop in the designated area, secure the truck and shut down the engine."
#!{
	key[]: "aca_msg_book1_3_04_cutscene12"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_04_cutscene13"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_04_cutscene14"
	val[]: "Unused"
#!}

#### 3_04 Driving Instructions



	key[]: "aca_msg_book1_3_04_forward"
	val[]: "<font face=/font/big_bold.font>Zrýchli a prejdi okolo prekážok.</font>"

	key[]: "aca_msg_book1_3_04_check1"
	val[]: "Pokračuj na trať a cez prvé dve ľahké zákruty.<br><br><font face=/font/big_bold.font>Pokračuj v jazde. </font>"

	key[]: "aca_msg_book1_3_04_check2"
	val[]: "<font face=/font/big_bold.font>Prejdi pravouhlou zákrutou.</font>"

	key[]: "aca_msg_book1_3_04_check3"
	val[]: "Nasledujúca časť trate prechádza dvojitou vlásenkou. Spôsob, akým prejdeš prvou časťou, priamo ovplyvní tvoju dráhu cez druhú časť.<br><br><font face=/font/big_bold.font>Opatrne pokračuj.</font>"

	key[]: "aca_msg_book1_3_04_check4"
	val[]: "Keď vyjdeš z vlásenky drž sa vľavo, aby si sa pripravil na vstup do nasledujúceho úzkeho úseku.<br><br><font face=/font/big_bold.font>Pokračuj v jazde. </font>"

	key[]: "aca_msg_book1_3_04_check5"
	val[]: "<font face=/font/big_bold.font>Pokračuj v jazde cez úzky úsek. </font>"

	key[]: "aca_msg_book1_3_04_check6"
	val[]: "Pred tebou je niekoľko pravouhlých zákrut.<br><br><font face=/font/big_bold.font>Prejdi zákrutami. </font>"

	key[]: "aca_msg_book1_3_04_check7"
	val[]: "Blížiš sa k ďalšej vlásenke. Sleduj svoj náves v zrkadle. <br><br><font face=/font/big_bold.font>Prejdi vlásenkou. </font>"

	key[]: "aca_msg_book1_3_04_check8"
	val[]: "Pravouhlá zákruta pred tebou je oveľa užšia, ako sa zdá. Využi rozumne svoj priestor.<br><br><font face=/font/big_bold.font>Pokračuj v jazde. </font>"

	key[]: "aca_msg_book1_3_04_check9"
	val[]: "Záverečná vlásenka je náročná s takmer žiadnym priestorom naviac. <br><br><font face=/font/big_bold.font>Opatrne pokračuj.</font>"

	key[]: "aca_msg_book1_3_04_check10"
	val[]: "Čaká ťa posledná pravouhlá zákruta.<br><br><font face=/font/big_bold.font>Pokračuj v jazde. </font>"

	key[]: "aca_msg_book1_3_04_check11"
	val[]: "Pokračuj do určenej oblasti."
