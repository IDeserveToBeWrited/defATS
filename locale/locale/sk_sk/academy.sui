#### finex common

	key[]: "aca_scenario_book3_finex_title"
	val[]: "Záverečná skúška"

	key[]: "aca_scenario_book3_finex_desc"
	val[]: "V tomto scenári si svoje novo nadobudnuté zručnosti otestuješ na trati, ktorá preverí tvoju presnosť a porozumenie jazde s B-double návesmi."

#### finex goal

	key[]: "aca_goal_book3_finex_check0"
	val[]: "Cúvanie"

	key[]: "aca_goal_book3_finex_check1"
	val[]: "Vstup na trať"

	key[]: "aca_goal_book3_finex_check2"
	val[]: "Nabranie rýchlosti"

	key[]: "aca_goal_book3_finex_check22"
	val[]: "Príprava na brzdenie"

	key[]: "aca_goal_book3_finex_speed"
	val[]: "Nedostatočná rýchlosť"

