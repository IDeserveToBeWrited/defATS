	val[]: "V tomto scenári budeme precvičovať komplexné parkovanie."

	key[]: "aca_msg_scenario_start_reverse"
	val[]: "Tvojou úlohou je zacúvať na určené miesto."

	key[]: "aca_msg_scenario_turn_around_reverse"
	val[]: "V tejto časti sa otoč a začni cúvať."

	key[]: "aca_msg_scenario_continue_driving"
