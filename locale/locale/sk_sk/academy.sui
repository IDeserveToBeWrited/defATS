#+ Book 1 Scenario 1_05
#@{

#### 1_05 common
	key[]: "aca_scenario_book1_1_05_title"
	val[]: "Svetlá a stierače"

	key[]: "aca_scenario_book1_1_05_desc"
	val[]: "V tomto scenári preskúmame niektoré základné ovládacie prvky ťahača, ktoré pomáhajú udržať jasný výhľad na tvoje okolie a robia tvoju jazdu predvídateľnou pre ostatných účastníkov cestnej premávky.<br><br>Naučíš sa používať stierače na udržiavanie dobrej viditeľnosti v zlom počasí, ako aj ovládacie prvky pre svetlá a smerovky."

#### 1_05 goal

	key[]: "aca_goal_book1_1_05_start"
	val[]: "Naštartovanie motora"

	key[]: "aca_goal_book1_1_05_parking"
	val[]: "Parkovacie svetlá"

	key[]: "aca_goal_book1_1_05_low_beam"
	val[]: "Stretávacie svetlá"

	key[]: "aca_goal_book1_1_05_high_beam"
	val[]: "Diaľkové svetlá"

	key[]: "aca_goal_book1_1_05_lblinkers"
	val[]: "Ľavá smerovka"

	key[]: "aca_goal_book1_1_05_rblinkers"
	val[]: "Pravá smerovka"

	key[]: "aca_goal_book1_1_05_hazard"
	val[]: "Výstražné svetlá"

	key[]: "aca_goal_book1_1_05_wipers"
	val[]: "Stierače"

	key[]: "aca_goal_book1_1_05_end"
	val[]: "Vypnutie motora"

#### 1_05 msg - intro text

	key[]: "aca_msg_book1_1_05_cutscene1"
	val[]: "V tomto scenári si prejdeme niektoré funkcie ťahača, ktoré zabezpečia, že budeš vidieť a zároveň budeš viditeľný."

	key[]: "aca_msg_book1_1_05_cutscene2"
	val[]: "Aktivujeme rôzne systémy osvetlenia a naučíme sa, kedy je potrebné použiť každý z nich."

	key[]: "aca_msg_book1_1_05_cutscene3"
	val[]: "Budeme ovládať ľavé a pravé smerové svetlá."

	key[]: "aca_msg_book1_1_05_cutscene4"
	val[]: "A nakoniec si prejdeme, ako nastaviť stierače, aby účinne fungovali pri rôznej intenzite zrážok."



#### 1_05 Driving Instructions

	key[]: "aca_msg_book1_1_05_start"
	val[]: "Prejdime si používanie rôznych druhov svetiel, ako aj ovládanie stieračov čelného skla.<br><br>Stretávacie a diaľkové svetlá zabezpečujú dobrý výhľad na cestu pred tebou. Smerovky a výstražné svetlá slúžia na to, aby ostatní účastníci cestnej premávky vedeli predvídať tvoje manévre.<br><br>Stierače zabezpečujú, aby bolo čelné sklo očistené od vody a iných nečistôt.<font face=/font/big_bold.font><br><br>Naštartujte motor, ale neuvoľňujte parkovaciu brzdu.</font>"

	key[]: "aca_msg_book1_1_05_parking"
	val[]: "Doteraz si používal iba denné svietenie. To sa automaticky aktivuje pri zapnutí zapaľovania a slúži na lepšiu viditeľnosť vozidla za normálnych podmienok. Teraz sa však podmienky zhoršili, takže budeš musieť použiť všetky možnosti osvetlenia.<font face=/font/big_bold.font><br><br>Stlač @@imv_nrm_light@@ pre zapnutie parkovacích svetiel. </font>"

	key[]: "aca_msg_book1_1_05_low_beam"
	val[]: "@@aca_msg_book1_1_05_low_beam_img@@<br>Parkovacie svetlá zahŕňajú predné, bočné a zadné obrysové svetlá. Používajú sa pri parkovaní v zlých svetelných podmienkach, aby ťa ostatní vodiči videli.<font face=/font/big_bold.font><br><br>Stlač @@imv_nrm_light@@ pre zapnutie stretávacích svetiel. </font>"

	key[]: "aca_msg_book1_1_05_high_beam_on"
	val[]: "@@aca_msg_book1_1_05_high_beam_on_img@@<br>Stretávacie svetlá osvetľujú cestu pred tebou a zlepšujú viditeľnosť tvojho vozidla v zlých svetelných podmienkach.<font face=/font/big_bold.font><br><br>Stlač @@imv_nrm_hblight@@ pre zapnutie diaľkových svetiel. </font>"

	key[]: "aca_msg_book1_1_05_high_beam_off"
	val[]: "@@aca_msg_book1_1_05_high_beam_off_img@@<br>Diaľkové svetlá ti umožnia dovidieť ďalej v smere jazdy v horších svetelných podmienkach.<br><br>Dávaj si však pozor pri ich používaní, pretože môžu oslepiť ostatných účastníkov premávky, najmä tých v protismere. Uisti sa, že ich vypneš pri priblížení k iným vodičom.<font face=/font/big_bold.font><br><br>Stlač @@imv_nrm_hblight@@ pre vypnutie diaľkových svetiel. </font>"

	key[]: "aca_msg_book1_1_05_lblinker_on"
	val[]: "Teraz sa pozrime na smerovky. Ich funkcia je poskytnúť vizuálny signál ostatným účastníkom premávky o zmene jazdného pruhu alebo zmene smeru jazdy.<font face=/font/big_bold.font><br><br>Stlač @@imv_nrm_lblinker@@ pre zapnutie ľavej smerovky. </font>"

	key[]: "aca_msg_book1_1_05_lblinker_off"
	val[]: "@@aca_msg_book1_1_05_lblinker_off_img@@<br>Môžeš si všimnúť, že na prístrojovej doske bliká indikátor ľavého smerového svetla. Smerové svetlá tiež blikajú na ľavej strane ťahača.<font face=/font/big_bold.font><br><br>Teraz stlač @@imv_nrm_lblinker@@ pre vypnutie ľavej smerovky. </font>"

	key[]: "aca_msg_book1_1_05_rblinker_on"
	val[]: "Svetelné signály naznačujúce zmenu smeru je potrebné dávať včas, aby ostatní účastníci cestnej premávky mali čas predvídať tvoj manéver a následne prispôsobiť svoju jazdu.<font face=/font/big_bold.font><br><br>Stlač @@imv_nrm_rblinker@@ pre zapnutie pravého smerového svetla.</font>"

	key[]: "aca_msg_book1_1_05_rblinker_off"
	val[]: "@@aca_msg_book1_1_05_rblinker_off_img@@<br>Na prístrojovej doske teraz bliká kontrolka pravého smerového svetla. Zároveň smerové svetlá blikajú na pravej strane ťahača.<font face=/font/big_bold.font><br><br>Teraz stlač @@imv_nrm_rblinker@@ pre vypnutie pravej smerovky.</font>"

	key[]: "aca_msg_book1_1_05_hazard_on"
	val[]: "@@aca_msg_book1_1_05_hazard_on_img@@<br>Tlačidlo výstražných svetiel je označené červeným logom v tvare trojuholníka. Tieto svetlá sú dôležitou súčasťou bezpečnosti cestnej premávky a mali by sa používať iba v nevyhnutných prípadoch. Toto tlačidlo aktivuje ľavé aj pravé smerové svetlá naraz.<font face=/font/big_bold.font><br><br> Stlač @@imv_nrm_flasher4way@@ pre zapnutie výstražných svetiel. </font>"

	key[]: "aca_msg_book1_1_05_hazard_off"
	val[]: "@@aca_msg_book1_1_05_hazard_off_img@@<br>Obidve kontrolky smerových svetiel teraz blikajú a to značí, že sú zapnuté výstražné svetlá. Zároveň smerové svetlá blikajú na oboch stranách ťahača.<br><br>Výstražné svetlá sa obvykle používajú, ak vozidlo zastaví na mieste, kde by štandardne nestálo. Napríklad na okraji cesty kvôli technickej alebo mechanickej závade. Môžu byť tiež použité na varovanie vodičov idúcich za tebou, ak sa pred tebou zastaví premávka.<font face=/font/big_bold.font><br><br>Teraz stlač @@imv_nrm_flasher4way@@ pre vypnutie výstražných svetiel. </font>"

	key[]: "aca_msg_book1_1_05_wipers_on"
	val[]: "Teraz sa dostávame k stieračom. Stierače slúžia na odstraňovanie kvapiek dažďa a ďalších nečistôt z čelného skla vozidla. Ich hlavnou funkciou je zabezpečiť čistotu a priehľadnosť skla. Stierače majú niekoľko rýchlostí.<br><br><font face=/font/big_bold.font>Stlač @@imv_nrm_wipers@@ pre nastavenie prerušovaného stierania.</font>@@aca_goal_tip@@ V kariére môžeš použiť dažďový senzor pre automatickú funkciu stieračov za dažďa. @@rain_sensor@@ nájdeš na obrazovke nastavení - \"Hra\"."

	key[]: "aca_msg_book1_1_05_wipers2"
	val[]: "Toto nastavenie umožňuje periodické stieranie stieračov, čo sa hodí, keď sú veľmi slabé zrážky.<br><br>Ako môžeš vidieť, dážď je príliš hustý a stierače nestíhajú stierať všetky kvapky dopadajúce na čelné sklo.<font face=/font/big_bold.font><br><br>Stlač znovu @@imv_nrm_wipers@@ pre nastavenie nízkej rýchlosti stierania.</font>"

	key[]: "aca_msg_book1_1_05_wipers3"
	val[]: "Teraz stierače stierajú dážď stálou rýchlosťou.<font face=/font/big_bold.font><br><br>Stlač @@imv_nrm_wipers@@ ešte raz pre nastavenie vyššej rýchlosti.</font>"

	key[]: "aca_msg_book1_1_05_wipers_off"
	val[]: "You can see the wipers are working much faster now to clear the windscreen for maximum visibility. <font face=/font/big_bold.font><br><br>Press @@imv_nrm_wipers@@ to turn the wipers off. </font>@@aca_goal_tip@@ You can also use the @@o_im_wipers_back@@ function to cycle backwards through the wipers speed settings. Check the Options Screen - '@@options_bindings_screen@@' - to see and/or change corresponding controls."

	key[]: "aca_msg_book1_1_05_wipers_off_back"
	val[]: "Môžeš vidieť, že stierače teraz pracujú oveľa rýchlejšie, aby vyčistili čelné sklo pre maximálnu viditeľnosť. <font face=/font/big_bold.font><br><br>Stlač @@imv_nrm_wipersback@@ viackrát, kým sa úplne nevypnú strierače. </font>"

	key[]: "aca_msg_book1_1_05_end"
	val[]: "<font face=/font/big_bold.font>Vypni svetlá a zhasni motor. </font>"
#@}

#+ Book 1 Scenario 2_01
#@{

#### 2_01 common
	key[]: "aca_scenario_book1_2_01_title"
	val[]: "Slalom medzi dopravnými kuželami"

	key[]: "aca_scenario_book1_2_01_desc"
	val[]: "V tomto scenári sa naučíme ako manévrovať ťahač okolo dopravných kužeľov s pomocou zrkadiel."

#### 2_01 goal

	key[]: "aca_goal_book1_2_01_summary"
	val[]: "Nasledovanie pokynov"

	key[]: "aca_goal_book1_2_01_mirror"
	val[]: "Kontrolovanie zrkadiel"

	key[]: "aca_goal_book1_2_01_start"
	val[]: "Začíname"

	key[]: "aca_goal_book1_2_01_steering"
	val[]: "Riadenie ťahača"
#!{
	key[]: "aca_goal_book1_2_01_forward"
	val[]: "@@aca_goal_book1_1_03_forward@@"

	key[]: "aca_goal_book1_2_01_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

#!}
	key[]: "aca_goal_book1_2_01_check1"
	val[]: "Vjazd na slalom"

	key[]: "aca_goal_book1_2_01_check2"
	val[]: "Vyhýbanie sa dopravným kuželom"

	key[]: "aca_goal_book1_2_01_check_all"
	val[]: "Slalom medzi dopravnými kuželami"


	key[]: "aca_goal_book1_2_01_end"
	val[]: "Zabezpečenie vozidla"

#### 2_01 msg - intro text

	key[]: "aca_msg_book1_2_01_cutscene1"
	val[]: "V tomto scenári vezmeme ťahač na krátku jazdu cez slalom zložený z dopravných kužeľov."

	key[]: "aca_msg_book1_2_01_cutscene2"
	val[]: "Jazdi opatrne a všímaj si svoje okolie. Maj na očiach obe strany ťahača a nezabudni používať zrkadlá, ktoré ti pomôžu pri navigácií traťou."

	key[]: "aca_msg_book1_2_01_cutscene3"
	val[]: "Ku koncu sa trať zužuje, takže presnosť je kľúčová."

	key[]: "aca_msg_book1_2_01_cutscene4"
	val[]: "Zaparkuj na určenom mieste a zabezpeč ťahač."

#### 2_01 Driving Instructions

	key[]: "aca_msg_book1_2_01_summary"
	val[]: "Aby si dokončil tento scenár, musíš obísť všetky kužele bez toho, aby si do ktoréhokoľvek z nich narazil. <br><br><font face=/font/big_bold.font>Stlač @@imv_nrm_activate@@ pre zobrazenie. </font>"

	key[]: "aca_msg_book1_2_01_mirror"
	val[]: "Použi zrkadlá, aby si udržal viditeľnosť po oboch stranách ťahača.<br><br>Pre stranu spolujazdca môžu byť veľmi užitočné predné a bočné zrkadlá pri orientácii.<br><br><font face=/font/big_bold.font>Stlač @@imv_nrm_activate@@ pre potvrdenie.</font>"

	key[]: "aca_msg_book1_2_01_start"
	val[]: "Ak je to potrebné, nastav si zrkadlá v '@@adjust_link_t@@' (k nastaveniam pristúp cez úpravy vozidla pri pauznutí hry).<br><br><font face=/font/big_bold.font>Priprav sa vyraziť. </font>"

	key[]: "aca_msg_book1_2_01_start_fail"
	val[]: "Ťahač stále nie je pripravený na pohyb, možno si na niečo zabudol?<br><br>Je motor zapnutý? Uvoľnil si parkovaciu brzdu?"

	key[]: "aca_msg_book1_2_01_forward"
	val[]: "<font face=/font/big_bold.font>Postupuj pomaly dopredu a prejdi cez slalom. </font>"

	key[]: "aca_msg_book1_2_01_check2"
	val[]: "<font face=/font/big_bold.font>Pokračuj okolo kužeľov. Venuj osobitnú pozornosť strane spolujazdca.</font>"

	key[]: "aca_msg_book1_2_01_check_all"
	val[]: "<font face=/font/big_bold.font>Pokračuj v jazde cez slalom bez toho, aby si zrazil nejaké kužele. </font>"

	key[]: "aca_msg_book1_2_01_stop"
	val[]: "<font face=/font/big_bold.font>Zastav v určenej oblasti. </font>"

	key[]: "aca_msg_book1_2_01_end"
	val[]: "<font face=/font/big_bold.font>Zabezpeč ťahač a vypni motor. </font>"
#@}

