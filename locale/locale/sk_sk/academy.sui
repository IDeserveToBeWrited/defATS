#@}


#+ Book 2 industrial.parking
#@{
#### common
	key[]: "aca_scenario_book2_industrial_parking_title"
	val[]: "Priemyselná zákazka"

	key[]: "aca_scenario_book2_industrial_parking_desc"
	val[]: "V tomto scenári budeš musieť cúvať cez úzku uličku a okolo zákruty, aby si simuloval priemyselnú zákazku."

#### intro text

	key[]: "aca_scenario_book2_industrial_parking_cutscene1"
	val[]: "Táto trať predstavuje priemyselnú zónu, kde je často menej ideálny priestor na manévrovanie s návesom. <br><br>Zájdi vpred do areálu pred tebou, potom cúvaj do uličky smerom k záverečnej parkovacej oblasti."

#@}

#+ Book 2 crossroads.dash
