	key[]: "aca_book_book2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Blahoželám!<br><br>Úspešne si splnil všetky požadované podmienky v module Zručnosti ovládania kamióna a získal si odmeny pre svoj kariérny profil. Ak hľadáš ďalšiu výzvu a viac odmien, stále sa môžeš pokúsiť splniť všetky bonusové podmienky.</font><br><br>"

	key[]: "aca_book_book2_maxrank_t"
	val[]: "ZRUČNOSTI OVLÁDANIA KAMIÓNA DOKONČENÉ"

	key[]: "aca_book_book2_maxrank"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Blahoželám!<br><br>Úspešne si splnil všetky požadované aj bonusové podmienky v module Zručnosti ovládania kamióna a získal si odmeny pre svoj kariérny profil.</font><br><br>"

#@}

#+ Book 2 intro
#@{

#### common
	key[]: "aca_scenario_book2_intro_title"
	val[]: "Zručnosti ovládania kamióna"


#### intro text

	key[]: "aca_scenario_book2_book2_intro_cutscene1"
	val[]: "Vitaj späť v @@driving_academy@@!"

	key[]: "aca_scenario_book2_book2_intro_cutscene2"
	val[]: "Nasledujúce scenáre predstavujú ďalší krok na tvojej ceste k profesionálnemu riadeniu kamióna."

	key[]: "aca_scenario_book2_book2_intro_cutscene3"
	val[]: "Tentokrát ťa nebudeme viesť každou úlohou, takže je na tebe, aby si naplno využili svoje zručnosti a skúsenosti."

	key[]: "aca_scenario_book2_book2_intro_cutscene4"
	val[]: "Môžeš sa stretnúť s niektorými známymi manévrami, ale tentoraz v nových prostrediach, ktoré sú navrhnuté tak, aby viac pripomínali scenáre z reálneho sveta."

	key[]: "aca_scenario_book2_book2_intro_cutscene5"
	val[]: "Novinkou v @@driving_academy@@ je pridanie požadovaných a bonusových podmienok."

	key[]: "aca_scenario_book2_book2_intro_cutscene6"
	val[]: "Rovnako ako doteraz musíš každý scenár dokončiť bez toho, aby si do niečoho narazil, úspešne zaparkovať a zaistiť ťahač..."

	key[]: "aca_scenario_book2_book2_intro_cutscene7"
	val[]: "...no teraz musíš všetko stihnúť aj v stanovenom časovom limite a s obmedzeným počtom zmien smeru medzi jazdou dopredu a cúvaním."

	key[]: "aca_scenario_book2_book2_intro_cutscene8"
	val[]: "Bonusové podmienky môžeš splniť, ak dokončíš každý scenár za ešte náročnejších podmienok..."

	key[]: "aca_scenario_book2_book2_intro_cutscene9"
	val[]: "...ako sú prísnejšie časové limity, ešte menej zmien smeru či používanie výhradne interiérovej kamery."

	key[]: "aca_scenario_book2_book2_intro_cutscene10"
	val[]: "Ak zvládneš všetky scenáre, môžeš sa považovať za zdatného vodiča kamióna pripraveného na ďalšiu výzvu na ceste vpred.<br><br>Ak si chceš poriadne otestovať svoje schopnosti, splň aj všetky bonusové podmienky v každom scenári; následne sa staneš skutočnou hviezdou medzi kamionistami!"


#@}



#+ Book 2 zero
#@{
#### zero common
	key[]: "aca_scenario_book2_zero_title"
	val[]: "Tutoriál"

	key[]: "aca_scenario_book2_zero_desc"
	val[]: "V tomto úvodnom scenári ti pomôžeme oboznámiť sa s novými funkciami, ktoré nájdete v sekcii Zručnosti ovládania kamióna."


#### zero info msg1

	key[]: "aca_msg_book2_scenario_zero1_title"
	val[]: "Zručnosti ovládania kamióna"

	key[]: "aca_msg_book2_scenario_zero1"
	val[]: "Na začiatku každého scenára sa zobrazí okno <color value=@@clr_sel@@>„Zhrnutie scenára“<color value=@@clr_txt@@>. V ňom nájdeš informácie o nových požadovaných a bonusových podmienkach daného scenára.<br><br>Požadované podmienky musia byť splnené, aby si scenár úspešne dokončil, zatiaľ čo bonusové podmienky predstavujú voliteľnú výzvu pre skúsených a zručných hráčov.<br><br><font face=/font/big_bold.font>Na pokračovanie naštartuj motor.</font>"

#### zero info msg1b

	key[]: "aca_msg_book2_scenario_zero1b"
	val[]: "Jedna z bonusových podmienok vyžaduje, aby si scenár dokončil s použitím <color value=@@clr_sel@@>interiérovej kamery<color value=@@clr_txt@@>. Exteriérové kamery môžeš použiť na kontrolu okolia, ale iba keď vozidlo stojí.<br><br>Môžeš sa teraz rozhliadnuť, aby si získal prehľad, a potom sa prepnúť späť na interiérovú kameru.<br><br><font face=/font/big_bold.font>Prepni sa na kameru spoza vozidla, aby si skontroloval okolie</font>"


#### zero info msg1c


	key[]: "aca_msg_book2_scenario_zero1c"
	val[]: "Zorientuj sa, potom sa prepni späť na interiérovú kameru.<br><br><font face=/font/big_bold.font>Rozhliadni sa okolo kamióna</font>"


#### zero info msg1d


	key[]: "aca_msg_book2_scenario_zero1d"
	val[]: "<font face=/font/big_bold.font>Prepni naspäť na interiérovú kameru</font>"
#### zero info msg2

	key[]: "aca_msg_book2_scenario_zero2_title"
	val[]: "Zručnosti ovládania kamióna"

	key[]: "aca_msg_book2_scenario_zero2"
	val[]: "<color value=@@clr_sel@@>Čas<color value=@@clr_txt@@> bude taktiež hrať dôležitú rolu v Zručnosti ovládania kamióna. Všetky scenáre budú mať individuálny časový limit, v ktorom musí byť scenár dokončený ako požadovaná podmienka, a mnohé budú mať aj dodatočný, prísnejší limit ako bonusovú podmienku.<br><br>Časovač sa spustí až po pohnutí kamiónu.<br><br><font face=/font/big_bold.font>Pre pokračovanie naštartuj motor a uvoľní parkovaciu brzdu.</font>"


#### zero info msg3

	key[]: "aca_msg_book2_scenario_zero3_title"
	val[]: "Zručnosti ovládania kamióna"

	key[]: "aca_msg_book2_scenario_zero3"
	val[]: "Ďalšou novinkou v Zručnosti ovládania kamióna sú kontrolné body. Všetky kontrolné body musia byť dosiahnuté, aby bolo možné scenár dokončiť.<br><br>Navyše, kontrolné body sú citlivé na to, akým smerom je kamión otočený, keď sa k nemu priblížiš, takže dávaj pozor na akékoľvek značenie na zemi v blízkosti kontrolného bodu, aby si sa správne zorientoval.<br><br><font face=/font/big_bold.font>Pohni sa vpred ku kontrólnemu bodu pred tebou.</font>"


#### zero info msg4

	key[]: "aca_msg_book2_scenario_zero4_title"
	val[]: "Zručnosti ovládania kamióna"

	key[]: "aca_msg_book2_scenario_zero4"
	val[]: "Dosiahol si kontrolný bod a teraz môžeš prejsť na ďalší krok. <br><br>Za tebou je ďalší kontrolný bod, do ktorého musíš zacúvať. Všimni si šípku na zemi, ktorá naznačuje, akým smerom má byť kamión otočený, keď dosiahneš kontrolný bod. <br><br>Ďalšou požadovanou a bonusovou podmienkou, ktorú musíš zvážiť je <color value=@@clr_sel@@> Zmeny smeru jazdy<color value=@@clr_txt@@>. Počítame, koľkokrát zmeníš smer medzi jazdou vpred a cúvaním. Dodrž limit, aby si splnil podmienku.<br><br><font face=/font/big_bold.font>Cúvaj ku kontrolnému bodu a zastav.</font>"

#### zero info msg5

	key[]: "aca_msg_book2_scenario_zero5_title"
	val[]: "Zručnosti ovládania kamióna"

	key[]: "aca_msg_book2_scenario_zero5"
	val[]: "Takže doteraz by si mal mať jednu zmenu smeru. <br><br>Pripoj náves za tebou a pokračuj na ďalší krok.<br><br><font face=/font/big_bold.font>Cúvaj pod náves, aby si ho pripojil.</font>"

#### zero info msg6

	key[]: "aca_msg_book2_scenario_zero6_title"
	val[]: "Zručnosti ovládania kamióna"

	key[]: "aca_msg_book2_scenario_zero6"
	val[]: "Finálne parkovacie miesto je napravo od teba. Niektoré scenáre môžu mať len jedno parkovacie miesto, zatiaľ čo iné ich budú mať viac, z ktorých si môžeš vybrať. Správne zaparkovanie na ktoromkoľvek z miest ti umožní dokončiť scenár. <br><br><font face=/font/big_bold.font> Stlač @@imv_nrm_attach@@ pre pripojenie návesu. </font>"


#### zero info msg7

	key[]: "aca_msg_book2_scenario_zero7_title"
	val[]: "Zručnosti ovládania kamióna"

	key[]: "aca_msg_book2_scenario_zero7"
	val[]: "Parkovacie miesta tiež naznačujú, akým smerom má byť kamión na mieste otočený. Ak zaparkuješ v nesprávnom smere, nebudeš môcť scenár dokončiť, kým sa neopravíš, čo ťa bude stáť čas a zmeny smeru.<br><br><font face=/font/big_bold.font>Prejdi na jedno z parkovacích miest a správne zaparkuj.</font>"



#### zero info msg8

	key[]: "aca_msg_book2_scenario_zero8_title"
	val[]: "Zručnosti ovládania kamióna"

	key[]: "aca_msg_book2_scenario_zero8"
	val[]: "Teraz by si už mal byť oboznámený s novými parametrami pre požadované a bonusové podmienky a byť pripravený pustiť sa do nových scenárov v Zručnosti ovládania kamióna!<br><br><font face=/font/big_bold.font>Pre dokončenie scenára zabezpeč kamión zatiahnutím parkovacej brzdy a vypnutím motora.</font>"



#@}

#+ Book 2 trailer check
#@{

#### Mission instructions - trailer check

key[]: "aca_msg_book2_slopy_moments_title"
val[]: "Nasledovanie pokynov"

key[]: "aca_msg_book2_slopy_moments1"
val[]: "Aby si tento scenár úspešne dokončil, maj náves počas celej doby pripojený.<br><br><font face=/font/big_bold.font>Pripoj sa k návesu.</font>"

key[]: "aca_msg_book2_slopy_moments2"
val[]: "Teraz môžeš pokračovať v scenári"


#@}


#+ Book 2 slalom_nt
