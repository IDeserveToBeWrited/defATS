	key[]: "aca_scenario_book2_dirt_title"
	val[]: "Špinavé rodeo"

	key[]: "aca_scenario_book2_dirt_desc"
	val[]: "V tomto scenári budeš musieť prejsť off-road trať, ktorá obsahuje rôzne zložité zákruty a prekážky, ktorým sa treba vyhnúť."

#### intro text

	key[]: "aca_scenario_book2_dirt_cutscene1"
	val[]: "Jazda po nespevnených cestách prináša svoje vlastné výzvy; často sa tam nachádza úlomok, ktorý by mohol poškodiť tvoj kamión.<br><br>Prejdi trať, vyhni sa všetkým prekážkam a zaparkuj v záverečnej parkovacej oblasti."

#@}


#+ Book 2 early.bird
#@{
#### common
	key[]: "aca_scenario_book2_early_bird_title"
	val[]: "Skoré vtáča"

	key[]: "aca_scenario_book2_early_bird_desc"
	val[]: "V tomto scenári sa musíš prepliesť preplneným parkoviskom. Priestor je extrémne obmedzený, takže si skús vopred naplánovať svoje pohyby."


#### intro text

	key[]: "aca_scenario_book2_early_bird_cutscene1"
	val[]: "Niekedy je parkovacích miest tak málo, že ostatní vodiči parkujú kdekoľvek sa dá po celú noc. To môže ráno dosť sťažiť manévrovanie okolo nich.<br><br> Urob, čo môžeš, aby si sa dostal cez parkovisko na finálne parkovacie miesto."
#@}

