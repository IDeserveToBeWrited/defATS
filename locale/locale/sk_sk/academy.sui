	val[]: "Mestská výzva"

	key[]: "aca_scenario_book2_crossroads_dash_desc"
	val[]: "V tomto scenári musíš prejsť centrom mesta a otestovať svoje znalosti rôznych manévrov a zručností."

#@}

#+ Book 2 long.reverse
#@{
#### common
	key[]: "aca_scenario_book2_long_reverse_title"
	val[]: "Dlhé cúvanie"

	key[]: "aca_scenario_book2_long_reverse_desc"
	val[]: "V tomto scenári máš za úlohu cúvať do a potom po dlhej uličke. Toto otestuje tvoju schopnosť ovládať náves počas dlhších cúvacích manévrov."

#### intro text

	key[]: "aca_scenario_book2_long_reverse_cutscene1"
	val[]: "Počas tejto jazdy si budeš precvičovať rovné cúvanie.<br><br>Zarovnaj svoj kamión s uličkou vytvorenou kužeľmi a cúvaj rovno až na koniec.<br><br>Pamätaj, že aj malá korekcia riadenia môže výrazne zmeniť dráhu tvojho návesu."

#@}


#+ Book 2 night_parallel
#@{
#### common
	key[]: "aca_scenario_book2_night_parallel_title"
	val[]: "Pozdĺžne parkovanie v noci"

	key[]: "aca_scenario_book2_night_parallel_desc"
	val[]: "V tomto scenári musíš zaparkovať pozdĺžne vedľa obrubníka. Je noc, takže viditeľnosť bude obmedzená."

#### intro text

	key[]: "aca_scenario_book2_night_parallel_cutscene1"
	val[]: "Čas a počasie nie sú vždy ideálne, keď už konečne potrebuješ zaparkovať na noc, takže budeš musieť venovať zvýšenú pozornosť svojmu okoliu.<br><br>Nezabudni si zapnúť svetlá!"

#@}


#+ Book 2 blindside_parking_options
#@{
#### common
	key[]: "aca_scenario_book2_blindside_parking_options_title"
	val[]: "Slepé rozhodnutia"

	key[]: "aca_scenario_book2_blindside_parking_options_desc"
	val[]: "V tomto scenári budeš mať tri rôzne parkovacie miesta, do ktorých budeš cúvať zo strany s obmedzeným výhľadom; každé z nich ponúkne jedinečnú výzvu."

#### intro text

	key[]: "aca_scenario_book2_blindside_parking_options_cutscene1"
	val[]: "Na výber sú tri voľné parkovacie miesta. Každé má svoje výhody aj nevýhody, preto si vyber to, ktoré najviac vyhovuje tvojmu štýlu cúvania."

#@}


#+ Book 2 driving_course
#@{
#### common
	key[]: "aca_scenario_book2_driving_course_title"
	val[]: "Kľukaté"

	key[]: "aca_scenario_book2_driving_course_desc"
	val[]: "V tomto scenári je tvojou úlohou prejsť veľmi komplexná tréningová trať. Počas cesty musíš nájsť a pripojiť náves, a potom ho doviezť až na koniec."

#### intro text

	key[]: "aca_scenario_book2_driving_course_cutscene1"
	val[]: "Tento scenár preverí tvoje priestorové a situačné vnímanie. Trať pred tebou je plná prekážok, ktoré nebude vždy ľahko spozorovať."

	key[]: "aca_scenario_book2_driving_course_cutscene2"
	val[]: "Prejdi cez trať k návesu. Akonáhle ho nájdeš, pripoj sa k nemu a dotiahni ho na finálne parkovacie miesto."

#@}

#+ Book 2 saturday_night
#@{
#### common
	key[]: "aca_scenario_book2_saturday_night_title"
	val[]: "Únik z odpočívadla"

	key[]: "aca_scenario_book2_saturday_night_desc"
	val[]: "V tomto scenári musíš opatrne nájsť cestu z parkoviska uprostred noci."

#### intro text

	key[]: "aca_scenario_book2_saturday_night_cutscene1"
	val[]: "Unavení vodiči zaparkujú kdekoľvek, kde nájdu miesto, aj keď to môže byť nepríjemné pre ostatných vodičov. <br><br>Prejdi parkoviskom smerom k východu, ale dávaj pozor, aby si nezasiahol iné kamióny!"

#@}


