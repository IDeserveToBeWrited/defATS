#+ Book 1 Scenario 3_09
#@{

#### 3_09 common
	key[]: "aca_scenario_book1_3_09_title"
	val[]: "Diagonálne parkovanie"

	key[]: "aca_scenario_book1_3_09_desc"
	val[]: "V tomto scenári budeš parkovať na diagonálnom parkovacom mieste na rušnom parkovisku. <br><br>Nie je tu veľa priestoru na manévrovanie, takže budeš musieť byť veľmi presný a rozvážny pri svojej jazde."

#### 3_09 goal

	key[]: "aca_goal_book1_3_09_check1"
	val[]: "Priblíženie sa k parkovaciemu miestu"
#!{
	key[]: "aca_goal_book1_3_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_09_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_09_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
 #!}
#### 3_09 msg - intro text

	key[]: "aca_msg_book1_3_09_cutscene1"
	val[]: "Diagonálne parkovacie miesta, ako je toto, sú veľmi bežné. Môžeš sa s nimi stretnúť na odpočívadlách po celej Amerike.<br>Opäť budeme musieť zaparkovať čelom na parkovacie miesto pred tebou."

	key[]: "aca_msg_book1_3_09_cutscene2"
	val[]: "Prejdi k určenému parkovaciemu miestu na konci radu."

	key[]: "aca_msg_book1_3_09_cutscene3"
	val[]: "Drž sa v strede pruhu alebo mierne doľava. Chceš si nechať dostatok miesta na manévrovanie s návesom."

	key[]: "aca_msg_book1_3_09_cutscene4"
	val[]: "Prejdi o kúsok ďalej za parkovacie miesto a potom rýchlo a prudko zaboč smerom k miestu. Budeš musieť sledovať pravé bočné zrkadlo, aby si videl, že tvoj náves bezpečne vchádza na parkovacie miesto."

	key[]: "aca_msg_book1_3_09_cutscene5"
	val[]: "Zastav na určenom mieste, potom zabezpeč ťahač a vypni motor."


#### 3_09 Driving Instructions

	key[]: "aca_msg_book1_3_09_start"
	val[]: "@@aca_msg_book1_3_09_start_img@@<br>Pri diagonálnom parkovaní je dôležité presne odhadnúť svoju polohu. Keď si už v polovici zákruty, je ťažké cúvať a bezpečne zaujať novú pozíciu. Preto je ideálne uistiť sa, že máš dostatok miesta na prvý pokus.<br><br><font face=/font/big_bold.font>Priprav sa vyraziť. </font>"

	key[]: "aca_msg_book1_3_09_forward"
	val[]: "<font face=/font/big_bold.font>Pohni sa smerom k parkovaciemu miestu. </font>"

	key[]: "aca_msg_book1_3_09_check1"
	val[]: "Prejdi okolo parkovacieho miesta, aby mal tvoj náves dostatok miesta na otočenie po vnútornej strane okolo ťahača.<br><br><font face=/font/big_bold.font>Zaboč na parkovacie miesto. </font>"
#!{
	key[]: "aca_msg_book1_3_09_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"
#!}

#@}

#+ Book 1 Scenario 3_10
#@{

#### 3_10 common
	key[]: "aca_scenario_book1_3_10_title"
	val[]: "Cúvanie na stranu s obmedzeným výhľadom"

	key[]: "aca_scenario_book1_3_10_desc"
	val[]: "V tomto scenári sa pozrieme na cúvanie s ťahačom na parkovacie miesto na strane s obmedzeným výhľadom. Bez možnosti pozrieť sa z okna, aby si videl na cestu, sa budeš musieť spoliehať len na svoje zrkadlá pri navigácii na miesto, kam potrebuješ ísť."

#### 3_10 goal
#!{
	key[]: "aca_goal_book1_3_10_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_10_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_10_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_10_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_10_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

 #!}
#### 3_10 msg - intro text

	key[]: "aca_msg_book1_3_10_cutscene1"
	val[]: "V tomto scenári sa naučíš manéver cúvania na stranu s obmedzeným výhľadom. Tomuto manévru by si sam mal vo všeobecnosti vyhýbať, pokiaľ neexistuje žiadna iná alternatíva, pretože tvoja viditeľnosť je pri ňom výrazne obmedzená. Daj si načas a radšej sa prikloň k extrémnej opatrnosti."

	key[]: "aca_msg_book1_3_10_cutscene2"
	val[]: "Prejdi ďaleko za parkovacie miesto, aby si mal dostatok miesta na manipuláciu, keď začneš cúvať."

	key[]: "aca_msg_book1_3_10_cutscene3"
	val[]: "Zastav, skontroluj svoje okolie a potom začni cúvať."

	key[]: "aca_msg_book1_3_10_cutscene4"
	val[]: "Zaboč s ťahačom preč od miesta. Týmto otočíš prednú časť návesu a jeho zadná časť sa nasmeruje k parkovaciemu miestu, na ktoré chceš ísť. Dávaj pozor nech to nepreženieš, inak riskuješ „zalomenie“ súpravy."

	key[]: "aca_msg_book1_3_10_cutscene5"
	val[]: "Pri vchádzaní návesu na parkovacie miesto začni vyrovnávať ťahač."

	key[]: "aca_msg_book1_3_10_cutscene6"
	val[]: "Zastav na určenom mieste a zabezpeč ťahač."

#### 3_10 Driving Instructions

	key[]: "aca_msg_book1_3_10_start"
	val[]: "Cúvanie na stranu s obmedzeným výhľadom si vyžaduje rovnaké postupy ako cúvanie na opačnú stranu, ale budeš znevýhodnený nedostatkom viditeľnosti. Použi svoje zrkadlá a svoj najlepší úsudok, aby si zaparkoval ťahač.<br><br><font face=/font/big_bold.font>Priprav sa vyraziť.</font>"

	key[]: "aca_msg_book1_3_10_forward"
	val[]: "Pred tebou je parkovacie miesto na pravej strane. Budeš musieť zájsť ďaleko za neho, aby si mal dostatok priestoru na manévrovanie pri cúvaní.<br><br><font face=/font/big_bold.font>Pokračuj vpred. </font>"
#!{
	key[]: "aca_msg_book1_3_10_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_10_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}
	key[]: "aca_msg_book1_3_10_check2"
	val[]: "Pamätaj, že otočením ťahača preč od miesta otočíš náves smerom k nemu. Použi zrkadlá podľa tvojich najlepších schopností, aby si sa dostal na parkovacie miesto.<br><br><font face=/font/big_bold.font>Začni cúvať. </font>"


#@}

#+ Book 1 Scenario 3_11
#@{

#### 3_11 common
	key[]: "aca_scenario_book1_3_11_title"
	val[]: "Jazda po kruhovom objazde"

	key[]: "aca_scenario_book1_3_11_desc"
	val[]: "V tomto scenári sa pozrieme na to, ako zvládnuť prejazd kruhovým objazdom.<br><br>Budeš musieť venovať osobitnú pozornosť tvojmu návesu, pretože sa bude pohybovať inak pri vchádzaní, prechádzaní a opúšťaní kruhového objazdu."

#### 3_11 goal
#!{
	key[]: "aca_goal_book1_3_11_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_11_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


	key[]: "aca_goal_book1_3_11_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_11_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
 #!}

	key[]: "aca_goal_book1_3_11_check1"
	val[]: "Vjazd na kruhový objazd"

	key[]: "aca_goal_book1_3_11_check2"
	val[]: "Jazda po kruhovom objazde"

	key[]: "aca_goal_book1_3_11_check3"
	val[]: "Jazda po kruhovom objazde"

	key[]: "aca_goal_book1_3_11_check5"
	val[]: "Výjazd z kruhového objazdu"

	key[]: "aca_goal_book1_3_11_check6"
	val[]: "Jazda do určenej oblasti"

#### 3_11 msg - intro text

	key[]: "aca_msg_book1_3_11_cutscene1"
	val[]: "Kruhové objazdy sú na amerických cestách čoraz bežnejšie, preto je dôležité vedieť, ako ich zvládnuť."

	key[]: "aca_msg_book1_3_11_cutscene3"
	val[]: "Ako sa budeš približovať ku kruhovému objazdu, drž sa na vonkajšej strane svojho jazdného pruhu. To pomôže tvojmu návesu vyhnúť sa vnútru počiatočnej zákruty."

	key[]: "aca_msg_book1_3_11_cutscene4"
	val[]: "Prejdi smerom k stredu kruhového objazdu, keď do neho vchádzaš. Až budeš vo vnútri, budeš musieť smerovať k vonkajšej strane. Je to potrebné preto, aby tvoj náves nebol príliš blízko stredu kruhového objazdu."

	key[]: "aca_msg_book1_3_11_cutscene5"
	val[]: "Sleduj svoje zrkadlo a uisti sa, že náves nie je príliš blízko vnútorných prekážok."

	key[]: "aca_msg_book1_3_11_cutscene6"
	val[]: "Opustenie kruhového objazdu je pomerne jednoduché, pretože tvoj náves je už umiestnený ďalej od vnútornej strany výjazdu. Širokým zatočením pri výjazde by mal náves ťahač pekne nasledovať."

	key[]: "aca_msg_book1_3_11_cutscene7"
	val[]: "Zaparkuj na určenom mieste a zabezpeč ťahač."



#### 3_11 Driving Instructions
#!{
	key[]: "aca_msg_book1_3_11_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

	key[]: "aca_msg_book1_3_11_forward"
	val[]: "Pred tebou je kruhový objazd, pripravený na prejazd. <br><br><font face=/font/big_bold.font>Pomaly sa priblíž ku kruhovému objazdu. </font>"

	key[]: "aca_msg_book1_3_11_check1"
	val[]: "Pri vjazde na kruhový objazd si naširoko nadbehni, aby tvoj náves vošiel bez problémov za tebou. <br><br><font face=/font/big_bold.font>Vojdi do kruhového objazdu. </font>"

	key[]: "aca_msg_book1_3_11_check2"
	val[]: "Prejdi ku vonkajšej strane kruhového objazdu. Budeš musieť držať ťahač čo najďalej od stredu kruhového objazdu, aby si udržal náves ďalej od vnútorných prekážok. <br><br><font face=/font/big_bold.font>Pokračuj cez kruhový objazd.</font>"

	key[]: "aca_msg_book1_3_11_check3"
	val[]: "Ostaň blízko vonkajším kužeľom. <br><br><font face=/font/big_bold.font>Pokračuj v jazde.</font>"

	key[]: "aca_msg_book1_3_11_check5"
	val[]: "<font face=/font/big_bold.font>Opusti kruhový objazd.</font>"

	key[]: "aca_msg_book1_3_11_check6"
	val[]: "<font face=/font/big_bold.font>Pokračuj na parkovacie miesto pred tebou.</font>"

	key[]: "aca_msg_book1_3_11_stop"
	val[]: "<font face=/font/big_bold.font>Zastav v určenej oblasti.</font>"

	key[]: "aca_msg_book1_3_11_end"
	val[]: "<font face=/font/big_bold.font>Zabezpeč ťahač a vypni motor.</font>"
#@}

#+ Book 1 Scenario 3_12
#@{

#### 3_12 common
	key[]: "aca_scenario_book1_3_12_title"
	val[]: "Manévrovanie v tesnom priestore"

	key[]: "aca_scenario_book1_3_12_desc"
	val[]: "V tomto scenári budeš mať za úlohu otočiť ťahač v stiesnenom priestore, čo si vyžiada pozornosť na tvoje okolie a rozumné využitie priestoru."

#### 3_12 goal



	key[]: "aca_goal_book1_3_12_check1"
	val[]: "Príprava na cúvanie"

	key[]: "aca_goal_book1_3_12_check2"
	val[]: "Opustenie oblasti"

	key[]: "aca_goal_book1_3_12_check3"
	val[]: "Cúvanie na miesto"

	key[]: "aca_goal_book1_3_12_check4"
	val[]: "Dokončenie parkovania zo strany s obmedzeným výhľadom"
#!{
	key[]: "aca_goal_book1_3_12_check5"
	val[]: "Unused"

	key[]: "aca_goal_book1_3_12_check6"
	val[]: "@@aca_goal_book1_3_11_check6@@"

	key[]: "aca_goal_book1_3_12_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_12_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_12_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_12_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"
 #!}

#### 3_12 msg - intro text

	key[]: "aca_msg_book1_3_12_cutscene01"
	val[]: "V tomto scenári si prejdeme, ako sa otočiť v stiesnenom priestore.<br>Nebudeš vždy mať veľa miesta na manévrovanie súpravy a budeš sa musieť prispôsobiť menej ideálnym situáciám."

	key[]: "aca_msg_book1_3_12_cutscene02"
	val[]: "Prejdi cez uličku smerom k otvorenej oblasti."

	key[]: "aca_msg_book1_3_12_cutscene03"
	val[]: "Naľavo je ďalšia ulička, do ktorej musíš zacúvať. Priprav sa na to, ako uznáš za vhodné.<br>Môže byť užitočné mať náves nasmerovaný k uličke pred začatím cúvania."

	key[]: "aca_msg_book1_3_12_cutscene04"
	val[]: "Cúvaj smerom k uličke. Dbaj na to, aby si mal na očiach všetky strany ťahača a návesu."

	key[]: "aca_msg_book1_3_12_cutscene05"
	val[]: "V uličke sú prekážky, preto sa drž na strane vodiča."

	key[]: "aca_msg_book1_3_12_cutscene06"
	val[]: "Keď skončíš s cúvaním, môžeš pokračovať dopredu a vrátiť sa v smere, z ktorého si prišiel."

	key[]: "aca_msg_book1_3_12_cutscene07"
	val[]: "Pri výjazde môže byť ťažké vidieť náves v zrkadle na strane spolujazdca, takže využi všetok dostupný priestor vo svoj prospech."

	key[]: "aca_msg_book1_3_12_cutscene08"
	val[]: "Pokračuj v jazde smerom k východu."

	key[]: "aca_msg_book1_3_12_cutscene09"
	val[]: "Park in the designated area and secure the truck."
#!{
	key[]: "aca_msg_book1_3_12_cutscene10"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_12_cutscene11"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_12_cutscene12"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_12_cutscene13"
	val[]: "Unused"
#!}
#### 3_12 Driving Instructions

	key[]: "aca_msg_book1_3_12_start"
	val[]: "Pred tebou je oblasť reprezentujúca priestor prepravnej spoločnosti. Tvojou úlohou je vstúpiť a otočiť ťahač, aby si mohol vyjsť von. Nezabudni dobre využiť priestor okolo seba.<br><br><font face=/font/big_bold.font>Priprav sa vyraziť. </font>"

	key[]: "aca_msg_book1_3_12_forward"
	val[]: "<font face=/font/big_bold.font>Pokračuj cez uličku. </font>"

	key[]: "aca_msg_book1_3_12_check1"
	val[]: "Hneď za budovou naľavo je ďalšia ulička, do ktorej musíš zacúvať. Mysli na to pri príprave.<br><br><font face=/font/big_bold.font>Pokračuj smerom k bariéram. </font>"



	key[]: "aca_msg_book1_3_12_check3"
	val[]: "Cúvaj a otoč náves smerom k uličke. Uisti sa, že ťahačom nič nezasiahneš na pravej strane.<br><br><font face=/font/big_bold.font>Začni cúvať a otoč náves do uličky. Zastav na vyznačenom mieste.</font>"

	key[]: "aca_msg_book1_3_12_check4"
	val[]: "Teraz môžeš opustiť oblasť rovnakým smerom, ktorým si prišiel. Dobre využi dostupný priestor.<br><br><font face=/font/big_bold.font>Pokračuj vpred a odboč doprava. </font>"


	key[]: "aca_msg_book1_3_12_check6"
	val[]: "Pokračuj ďalej uličkou smerom k určenej oblasti."
#!{
	key[]: "aca_msg_book1_3_12_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_12_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_12_check5"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_12_check2"
	val[]: "Unused"
#!}

#@}

#+ Book 1 Scenario 3_13
#@{

#### 3_13 common
	key[]: "aca_scenario_book1_3_13_title"
	val[]: "Manéver cúvania s posunom"

	key[]: "aca_scenario_book1_3_13_desc"
	val[]: "V tomto scenári budeš mať za úlohu zacúvať na parkovacie miesto, ktoré nie je priamo za tebou. Možnosti pre manévrovanie sú obmedzené, takže budeš musieť rozumne využívať dostupný priestor."

#### 3_13 goal

#!{
	key[]: "aca_goal_book1_3_13_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_13_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_13_check1"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_check2"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_3_13_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_13_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

#!}

#### 3_13 msg - intro text

	key[]: "aca_msg_book1_3_13_cutscene01"
	val[]: "V tomto scenári bude tvojou úlohou zaparkovať na mieste vedľa teba. Nie je tu veľa priestoru na manévrovanie, takže budeš musieť urobiť trochu viac práce, aby si dostal náves kam potrebuješ."

	key[]: "aca_msg_book1_3_13_cutscene02"
	val[]: "Prejdi rovno dopredu k prekážke."

	key[]: "aca_msg_book1_3_13_cutscene03"
	val[]: "Zastav pred prekážkou."

	key[]: "aca_msg_book1_3_13_cutscene04"
	val[]: "Pred pohybom prudko otoč volant na stranu vodiča. Týmto spôsobom začneš otáčať náves smerom k parkovaciemu miestu, hneď ako začneš cúvať, čím ušetríš cenný priestor."

	key[]: "aca_msg_book1_3_13_cutscene05"
	val[]: "Až budeš mať náves nasmerovaný kam potrebuješ, dostaň ťahač pred náves a začni ho taktiež smerovať na parkovacie miesto."

	key[]: "aca_msg_book1_3_13_cutscene06"
	val[]: "Od tohoto bodu to už nebude príliš odlišné od bežného parkovacieho manévru."

	key[]: "aca_msg_book1_3_13_cutscene07"
	val[]: "Pokračuj v cúvaní a sleduj obe strany. Drž ťahač a náves zarovnaný s parkovacím miestom."

	key[]: "aca_msg_book1_3_13_cutscene08"
	val[]: "Zastav na určenom mieste, zabezpeč ťahač a vypni motor."


#### 3_13 Driving Instructions

	key[]: "aca_msg_book1_3_13_start"
	val[]: "Si na parkovacom mieste, ale musíš sa presunúť na druhé parkovacie miesto vpravo.<br><br><font face=/font/big_bold.font>Priprav sa vyraziť. </font>"

	key[]: "aca_msg_book1_3_13_forward"
	val[]: "Pred tebou je vyznačená oblasť.<br><br><font face=/font/big_bold.font>Pohni sa dopredu. </font>"
#!{
	key[]: "aca_msg_book1_3_13_check1"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_13_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

	key[]: "aca_msg_book1_3_13_check2"
	val[]: "Pamätaj, že musíš začať okamžite zatáčať, pretože nemáš veľa miesta.<br><br><font face=/font/big_bold.font>Cúvaj na označené miesto za tebou. </font>"


#@}

#+ Book 1 Scenario 3_15
#@{

#### 3_15 common
	key[]: "aca_scenario_book1_3_15_title"
	val[]: "Zákruty s nadbehnutím si typu „Jug Handle“ a „Button Hook“"

	key[]: "aca_scenario_book1_3_15_desc"
	val[]: "V tomto scenári sa vydáš na krátku jazdu po tréningovej trati, ktorá ti pomôže naučiť sa manévrovať s návesom v úzkych zákrutách pomocou dvoch rôznych postupov zatáčania."

#### 3_15 goal
#!{
	key[]: "aca_goal_book1_3_15_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_15_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_15_check6"
	val[]: "@@aca_goal_book1_3_11_check6@@"

	key[]: "aca_goal_book1_3_15_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_15_end"
	val[]: "@@aca_goal_book1_2_01_end@@"


 #!}
	key[]: "aca_goal_book1_3_15_check1"
	val[]: "Zákruta s nadbehnutím si typu „Jug Handle“"

	key[]: "aca_goal_book1_3_15_check2"
	val[]: "Zákruta a rovinka"

	key[]: "aca_goal_book1_3_15_check3"
	val[]: "Zákruta s nadbehnutím si typu „Button Hook“"

	key[]: "aca_goal_book1_3_15_check4"
	val[]: "Rovinka a zákruta"

	key[]: "aca_goal_book1_3_15_check5"
	val[]: "Kombinovaná zákruta"



#### 3_15 msg - intro text

	key[]: "aca_msg_book1_3_15_cutscene01"
	val[]: "Pred tebou je zopár ostrých zákrut s malým priestorom na manévrovanie.<br>Pomôžu ti naučiť sa efektívne manévrovať s návesom."

	key[]: "aca_msg_book1_3_15_cutscene02"
	val[]: "@@aca_msg_book1_3_15_cutscene02_img@@<br>Prvá zákruta vyžaduje manéver „jug handle“. Tento termín sa vzťahuje na zákruty, kde máš obmedzený priestor na ceste, na ktorú odbočuješ. Preto musíš namiesto toho využiť viac priestoru na ceste, na ktorej sa aktuálne nachádzaš."

	key[]: "aca_msg_book1_3_15_cutscene03"
	val[]: "Sleduj značenie jazdného pruhu, aby si ťahač široko odklonil od vnútorného obrubníka.<br>Týmto prenesieš náves preč od obrubníka, aby si mal dostatok priestoru na manévrovanie."

	key[]: "aca_msg_book1_3_15_cutscene04"
	val[]: "Keď vychádzaš zo zákruty, drž sa blízko prekážky, aby ťa náves nasledoval čo najširším oblúkom."

	key[]: "aca_msg_book1_3_15_cutscene05"
	val[]: "Keď vchádzaš do dlhej zákruty, musíš držať ťahač smerom k stredu cesty, aby sa kolesá návesu nedostali na obrubník."

	key[]: "aca_msg_book1_3_15_cutscene06"
	val[]: "Pokračuj popri ceste."

	key[]: "aca_msg_book1_3_15_cutscene07"
	val[]: "@@aca_msg_book1_3_15_cutscene07_img@@<br>Ďalšia zákruta vyžaduje použitie manévru „button hook“. Táto technika je preferovaná, pretože neotvára jazdný pruh za tebou pre nepozorného vodiča, ktorý sa môže dostať na pravú stranu. Používaj ju vždy, keď máš dostatok miesta na ceste, na ktorú odbočuješ."

	key[]: "aca_msg_book1_3_15_cutscene08"
	val[]: "Vojdi hlboko do križovatky a rýchlo zatoč ostro doprava."

	key[]: "aca_msg_book1_3_15_cutscene09"
	val[]: "Keď pôjdeš vedľa prekážky, môžeš sa znova vyrovnať a držať sa na ľavej strane svojho pruhu.<br>Za účelom toho, aby sa kolesá návesu nedostali na obrubník."

	key[]: "aca_msg_book1_3_15_cutscene10"
	val[]: "Pokračuj smerom k ďalšej zákrute."

	key[]: "aca_msg_book1_3_15_cutscene11"
	val[]: "Opäť sa drž v strede cesty, aby sa kolesá návesu nedostali na obrubník."

	key[]: "aca_msg_book1_3_15_cutscene12"
	val[]: "Nadchádzajúca zákruta je obzvlášť problematická. V takýchto prípadoch nebudeš mať ideálne podmienky ani na manéver „jug handle“, ani na „button hook“. Budeš musieť skombinovať oba manévre, aby si sa dostal tam, kam potrebuješ."

	key[]: "aca_msg_book1_3_15_cutscene13"
	val[]: "Pred zákrutou si poriadne nadbehni, vojdi hlboko do križovatky a rýchlo zatoč. Opäť je ideálne zostať čo najbližšie k prekážke, aby si zákrutu vybral čo najviac naširoko."

	key[]: "aca_msg_book1_3_15_cutscene14"
	val[]: "Park in the designated area, secure the truck and shut down the engine."

	# Book 1 Scenario 3_15 formatting
#!{
	key[]: "aca_msg_book1_3_15_cutscene02_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/jug_handle.mat bottom=p256 right=p256 color=FFFFFFFF></align><offset vshift=256>"

	key[]: "aca_msg_book1_3_15_cutscene07_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/button_hook.mat bottom=p256 right=p256 color=FFFFFFFF></align><offset vshift=256>"

#!}


#### 3_15 Driving Instructions

	key[]: "aca_msg_book1_3_15_forward"
	val[]: "Pamätaj si, že musíš využiť celý dostupný priestor, aby si ti podarilo prejsť každou zákrutou.<br><br><font face=/font/big_bold.font>Vyraz a sleduj cestné značenie doľava. </font>"

	key[]: "aca_msg_book1_3_15_check1"
	val[]: "Využi všetok dostupný priestor a poriadne si nadbehni tak, aby si držal náves mimo vnútorného obrubníka.<br><br><font face=/font/big_bold.font>Prejdi zákrutou pomocou manévra s nadbehnutím.</font>"

	key[]: "aca_msg_book1_3_15_check2"
	val[]: "Drž sa v strede cesty pri prejazde zákrutou, potom pokračuj rovno k ďalšej zákrute.<br><br><font face=/font/big_bold.font>Pokračuj v jazde. </font>"

	key[]: "aca_msg_book1_3_15_check3"
	val[]: "Naľavo je obmedzený priestor, takže musíš vojsť hlboko do križovatky, aby si udržal náves mimo obrubníka.<br><br><font face=/font/big_bold.font>Prejdi zákrutou pomocou manévru „button hook“.</font>"

	key[]: "aca_msg_book1_3_15_check4"
	val[]: "Pokračuj v jazde k a cez ďalšiu zákrutu.<br><br><font face=/font/big_bold.font>Pokračuj v jazde. </font>"

	key[]: "aca_msg_book1_3_15_check5"
	val[]: "Táto zákruta je zatiaľ najtesnejšia a iba jeden manéver sám osebe nebude stačiť.<br><br><font face=/font/big_bold.font>Prejdi zákrutou čo najviac zoširoka.</font>"

	key[]: "aca_msg_book1_3_15_check6"
	val[]: "<font face=/font/big_bold.font>Pokračuj na parkovanie miesto vpravo vpredu. </font>"
#!{
	key[]: "aca_msg_book1_3_15_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_15_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_15_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}


#@}

#+ Book 1 Scenario 3_16
#@{

#### 3_16 common
	key[]: "aca_scenario_book1_3_16_title"
	val[]: "Diagonálne parkovanie pri cúvaní"

	key[]: "aca_scenario_book1_3_16_desc"
	val[]: "V tomto scenári preskúmame parkovanie diagonálne pri cúvaní. K tomu môže prísť na parkoviskách, odpočívadlách a dokonca aj u prepravcov. Často je tam málo miesta, pretože parkoviská sú preplnené nákladnými vozidlami, takže parkovanie je o to náročnejšie kvôli nedostatku priestoru."

#### 3_16 goal

	key[]: "aca_goal_book1_3_16_check1"
	val[]: "Otáčanie návesu"
#!{
	key[]: "aca_goal_book1_3_16_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_16_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_16_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_16_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
 #!}
#### 3_16 msg - intro text

	key[]: "aca_msg_book1_3_16_cutscene1"
	val[]: "Diagonálne parkovanie vyzerá na prvý pohľad jednoduchšie, ale často môže byť náročnejšie ako typické „parkovanie v uličke“."

	key[]: "aca_msg_book1_3_16_cutscene2"
	val[]: "Cúvaj smerom k parkovaciemu miestu. Zatiaľ drž ťahač a náves rovno."

	key[]: "aca_msg_book1_3_16_cutscene3"
	val[]: "Keď sa priblížiš, nechaj náves priblížiť sa k zaparkovaným ťahačom. To ti pomôže otočiť ho na miesto, keď k nemu dorazíš."

	key[]: "aca_msg_book1_3_16_cutscene4"
	val[]: "Začni otáčať náves na parkovacie miesto. Drž náves blízko ťahača na strane vodiča, pretože budeš potrebovať priestor na druhej strane."

	key[]: "aca_msg_book1_3_16_cutscene5"
	val[]: "Až bude náves dobre umiestnený na parkovacom mieste, začni zatáčať s ťahačom, aby nasledoval náves."

	key[]: "aca_msg_book1_3_16_cutscene6"
	val[]: "Zaparkuj na určenom mieste, zabezpeč ťahač a vypni motor."

#### 3_16 Driving Instructions

	key[]: "aca_msg_book1_3_16_start"
	val[]: "Zaparkuj ťahač do priestoru za tebou. Používaj obe zrkadlá na navigáciu pri cúvaní.<br><br><font face=/font/big_bold.font>Priprav sa vyraziť. </font>"

	key[]: "aca_msg_book1_3_16_backward"
	val[]: "Skontroluj svoje okolie a potom sa nasmeruj k parkovaciemu miestu.<br><br><font face=/font/big_bold.font>Začni s cúvaním.</font>"

	key[]: "aca_msg_book1_3_16_check1"
	val[]: "Začni presúvať náves smerom k ťahačom vedľa teba. Keď budeš pripravený, zatoč náves na parkovacie miesto. Pamätaj na vybočenie zadnej časti návesu.<br><br><font face=/font/big_bold.font>Zatoč na parkovacie miesto. </font>"
#!{
	key[]: "aca_msg_book1_3_16_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_16_end"
	val[]: "@@aca_msg_book1_2_01_end@@"


 #!}


#@}

#+ Book 1 Scenario 3_17
#@{

#### 3_17 common
	key[]: "aca_scenario_book1_3_17_title"
	val[]: "Cúvanie do zákruty"

	key[]: "aca_scenario_book1_3_17_desc"
	val[]: "V tomto scenári budeme prvýkrát cúvať s návesom do zákruty. Preskúmame základné princípy cúvania a na čo si treba dávať pozor pri cúvaní do zákrut."

#### 3_17 goal

	key[]: "aca_goal_book1_3_17_check1"
	val[]: "Otáčanie návesu"
#!{
	key[]: "aca_goal_book1_3_17_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_17_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_17_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_17_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
 #!}
#### 3_17 msg - intro text

	key[]: "aca_msg_book1_3_17_cutscene01"
	val[]: "V tomto scenári budeš musieť zacúvať na parkovacie miesto, ktoré je za tebou na strane vodiča."

	key[]: "aca_msg_book1_3_17_cutscene02"
	val[]: "Existuje niekoľko tipov, ktoré si treba zapamätať a ktoré ti veľmi pomôžu pri cúvaní s návesmi.<br>Prvý je, že náves bude vždy chcieť zatočiť do opačného smeru, ako zatáčaš s ťahačom."

	key[]: "aca_msg_book1_3_17_cutscene03"
	val[]: "Druhý je, že sledovaním náprav ťahača a návesu môžeš získať dobrú predstavu kam tvoj náves smeruje."

	key[]: "aca_msg_book1_3_17_cutscene04"
	val[]: "Tretí, už malé pohyby volantom ti pomôžu dostať sa kam potrebuješ, netreba to preháňať."

	key[]: "aca_msg_book1_3_17_cutscene05"
	val[]: "Začni jemne zatáčať s ťahačom smerom od parkovacieho miesta a náves začne smerovať k nemu."

	key[]: "aca_msg_book1_3_17_cutscene06"
	val[]: "Nasleduj náves a upravuj smer počas jazdy, aby si náves udržiaval správnu dráhu."

	key[]: "aca_msg_book1_3_17_cutscene07"
	val[]: "Sleduj kolesá návesu a zadné koleso ťahača. Ukážu ti, kam je náves nasmerovaný a kam ho tlačí ťahač."

	key[]: "aca_msg_book1_3_17_cutscene08"
	val[]: "Štvrtý tip je, že vždy je jednoduchšie otočiť náves ostrejšie, než sa snažiť ho narovnať pri zalomení. Mier na vonkajšiu stranu miesta, kým nie si bližšie k nemu. Potom môžeš zatočiť o trochu ostrejšie, aby si zarovnal náves."

	key[]: "aca_msg_book1_3_17_cutscene09"
	val[]: "Keď náves vojde na parkovacie miesto, dostaň ťahač pred náves. Snaž sa vyhnúť prílišným korekciám vo vnútri miesta."

	key[]: "aca_msg_book1_3_17_cutscene10"
	val[]: "Cúvaj medzi bariéry, kontroluj obe strany počas jazdy."

	key[]: "aca_msg_book1_3_17_cutscene11"
	val[]: "Zabezpeč ťahač a vypni motor."

#### 3_17 Driving Instructions

	key[]: "aca_msg_book1_3_17_start"
	val[]: "Pamätaj na tieto tipy pri cúvaní do zákruty s návesom:<br><br>— Náves sa otáča opačne, ako zatáčaš s ťahačom<br><br>— Sleduj kolesá návesu, aby si videl, kam smeruje<br><br>— Sleduj zadné koleso ťahača, aby si videl, kam smeruje náves<br><br>— Nechaj náves pracovať, nepretáčaj ho<br><br>— Vždy je ľahšie otočiť náves ostrejšie, než ho narovnávať<br><br><font face=/font/big_bold.font>Priprav sa vyraziť. </font>"

	key[]: "aca_msg_book1_3_17_backward"
	val[]: "Pozri sa za seba, aby si zistil, kam potrebuješ ísť. Vždy skontroluj svoje okolie, než začneš cúvať.<br><br><font face=/font/big_bold.font>Začni cúvať smerom k parkovaciemu miestu.</font>"

	key[]: "aca_msg_book1_3_17_check1"
	val[]: "<font face=/font/big_bold.font>Začni otáčať náves smerom k parkovaciemu miestu a nasleduj ho.</font>"

	key[]: "aca_msg_book1_3_17_stop"
	val[]: "<font face=/font/big_bold.font>Zastav v určenej oblasti. </font>"
#!{
	key[]: "aca_msg_book1_3_17_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_18
#@{

#### 3_18 common
	key[]: "aca_scenario_book1_3_18_title"
	val[]: "Manéver parkovania v uličke"

	key[]: "aca_scenario_book1_3_18_desc"
	val[]: "V tomto scenári budeš mať za úlohu cúvať s návesom do uličky z malej cesty."

#### 3_18 goal

	key[]: "aca_goal_book1_3_18_check1"
	val[]: "Otáčanie návesu"
#!{
	key[]: "aca_goal_book1_3_18_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_18_backward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


	key[]: "aca_goal_book1_3_18_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_18_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

 #!}
#### 3_18 msg - intro text

	key[]: "aca_msg_book1_3_18_cutscene01"
	val[]: "Parkovanie tu vyžaduje manéver „parkovania v uličke“.<br>Tento manéver pozná každý kamionista, pretože sa s takouto parkovacou situáciou stretne takmer denne vo svojej kariére, či už ide o naloženie alebo vyloženie návesu, alebo o parkovanie na noc v rámci odpočívadla."

	key[]: "aca_msg_book1_3_18_cutscene02"
	val[]: "Tento manéver je podobný predchádzajúcemu scenáru, ale budeš mať menej priestoru na manévrovanie. Preto budeš musieť podľa toho naplánovať svoje kroky a dávať pozor, aby si nič nezasiahol."

	key[]: "aca_msg_book1_3_18_cutscene03"
	val[]: "Keďže je tu menej miesta, tvoje načasovanie bude dôležité. Otoč náves v správny čas a sleduj kolesá ťahača a návesu, aby si videl, kam pôjde. Pamätaj na vybočenie zadnej časti a dávaj si pozor, aby nedošlo k jeho zalomeniu - pokračuj v smerovaní návesu."

	key[]: "aca_msg_book1_3_18_cutscene04"
	val[]: "Snaž sa nasmerovať náves do uličky radšej skôr ako neskôr. To ti poskytne priestor na druhej strane na otočenie prednej časti návesu a na to, aby si dostal ťahač pred náves."

	key[]: "aca_msg_book1_3_18_cutscene05"
	val[]: "Keď je tvoj náves v uličke, dostaň ťahač pred neho. Je lepšie to urobiť o trochu skôr, než by ti tvoj inštinkt spočiatku naznačoval. Vždy to môžeš upraviť pri cúvaní do konečnej pozície."

	key[]: "aca_msg_book1_3_18_cutscene06"
	val[]: "Zarovnaj ťahač s návesom a zastav vo vyznačenej oblasti."

	key[]: "aca_msg_book1_3_18_cutscene07"
	val[]: "Zabezpeč ťahač a vypni motor."


#### 3_18 Driving Instructions

	key[]: "aca_msg_book1_3_18_start"
	val[]: "Teraz si vyskúšame otáčanie návesu v oveľa menšom priestore s manévrom „parkovania v uličke“. <br><br><font face=/font/big_bold.font>Priprav sa vyraziť. </font>"

	key[]: "aca_msg_book1_3_18_backward"
	val[]: "Skontroluj svoje okolie a nájdi parkovacie miesto za sebou. <br><br><font face=/font/big_bold.font>Začni cúvať smerom k parkovaciemu miestu. </font>"

	key[]: "aca_msg_book1_3_18_check1"
	val[]: "<font face=/font/big_bold.font>Zatoč náves do parkovacieho miesta. </font>"
#!{
	key[]: "aca_msg_book1_3_18_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_18_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}


#@}

#+ Book 1 Scenario 3_19
#@{

#### 3_19 common
	key[]: "aca_scenario_book1_3_19_title"
	val[]: "Záverečná skúška (1. časť)"

	key[]: "aca_scenario_book1_3_19_desc"
	val[]: "Čaká ťa záverečná skúška, kde sa otestujú všetky zručnosti, ktoré si sa naučil v predchádzajúcich scenároch. Jazdiť budeme po celom tréningovom centre, aby sme zistili, ako dobre si sa naučil situácie, s ktorými si sa doteraz stretol.<br><br>Po dokončení všetkých sekcií a manévrov budeš o krok bližšie k tomu, aby si sa mohol nazývať skúseným kamionistom!"

