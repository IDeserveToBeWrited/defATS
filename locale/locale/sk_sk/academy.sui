	key[]: "aca_scenario_book2_slalom_nt_title"
	val[]: "Dvojitý slalom"

	key[]: "aca_scenario_book2_slalom_nt_desc"
	val[]: "V tomto scenári musíš prejsť krátkou traťou tvorenou dvoma spojenými slalomami."

#### slalom_nt intro text

	key[]: "aca_scenario_book2_slalom_nt_cutscene1"
	val[]: "Tento scenár sa skladá z dvoch spojených slalomov. Prejdi prvým slalomom bez zrazenia kužeľov a na konci sa otoč."

	key[]: "aca_scenario_book2_slalom_nt_cutscene2"
	val[]: "Odtiaľ pokračuj druhým slalomom smerom k finálnemu parkovaciemu priestoru.<br><br>Bude sa merať čas, takže jazdi cieľavedome a opatrne!"



#@}

#+ Book 2 training_course
#@{
