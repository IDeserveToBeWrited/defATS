	key[]: "aca_book_book2_help_stars_desc"
	val[]: "Hviezdy sa získavajú dokončením bonusových podmienok"

	key[]: "aca_book_book2_help_conditions_t"
	val[]: "Podmienky"

	key[]: "aca_book_book2_help_direction_changes_desc"
	val[]: "Maximálny počet zmien smeru jazdy"

	key[]: "aca_book_book2_help_time_desc"
	val[]: "Maximálny povolený čas na dokončenie scenára pre danú podmienku"

	key[]: "aca_book_book2_help_camera_desc"
	val[]: "Výhradné používanie interiérových kamier - externé kamery sa môžu stále používať, keď vozidlo stojí"

	key[]: "aca_book_book2_completed_t"
