	#### intro text

	key[]: "aca_scenario_book2_slalom_trailer_cutscene1"
	val[]: "Tvojou prvou úlohou je dokončiť slalom, ktorý sa postupne stáva náročnejším."

	key[]: "aca_scenario_book2_slalom_trailer_cutscene2"
