#### 3_11 msg - intro text

	key[]: "aca_msg_book3_3_11_cutscene1"
	val[]: "Kruhové objazdy sa s B-double návesmi prechádzajú o niečo zložitejšie než s jedným návesom."

	key[]: "aca_msg_book3_3_11_cutscene2"
	val[]: "Musíš si dostatočne nadbehnúť tak, aby oba návesy úspešne vošli dovnútra. Potom ale musíš ísť po vonkajšej strane, aby návesy zostali mimo stredu."

	key[]: "aca_msg_book3_3_11_cutscene3"
	val[]: "Je v poriadku, ak sa oba návesy nezmestia do jedného pruhu – v skutočnosti môže byť dokonca lepšie zabrať oba pruhy, aby sa ťa nejaký príliš optimistický vodič nepokúšal predbehnúť."

	key[]: "aca_msg_book3_3_11_cutscene4"
	val[]: "Prejdi na vzdialenejšiu stranu svojho výjazdového pruhu, aby si sa opäť uistil, že oba návesy nemôžu do ničoho naraziť."

	key[]: "aca_msg_book3_3_11_cutscene5"
	val[]: "Pokračuj ku druhému kruhovému objazdu."

	key[]: "aca_msg_book3_3_11_cutscene6"
	val[]: "Tento kruhový objazd má iba jeden pruh, takže buď precízny a neponáhľaj sa."

	key[]: "aca_msg_book3_3_11_cutscene7"
	val[]: "Využi všetok dostupný priestor – skracovanie zákrut ti len skomplikuje prácu."

	key[]: "aca_msg_book3_3_11_cutscene8"
	val[]: "Prejdi výjazdom a pokračuj smerom k parkovaciemu miestu."

	key[]: "aca_msg_book3_3_11_cutscene9"
	val[]: "Zaparkuj a zabezpeč ťahač."

#### 3_11 infinite Fun Driving Instructions

#!{
	key[]: "aca_msg_book3_3_11_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_3_11_forward"
	val[]: "Nachádzaš sa na trati, ktorá ťa naučí prechádzať kruhovými objazdmi. Keď budeš pripravený, pohni sa vpred."

	key[]: "aca_msg_book3_3_11_check1"
	val[]: "Nadbehni si poriadne do kruhového objazdu skôr, než zamieriš k vonkajším kužeľom, aby oba návesy bezpečne vošli dovnútra."

	key[]: "aca_msg_book3_3_11_check2"
	val[]: "Budeš chcieť ísť na opačnú stranu výjazdu, aby sa tvoje návesy vyhli kužeľom.<br><br>Tesne pred výjazdom z kruhového objazdu môže byť užitočné zatočiť smerom k jeho stredu."

#!{
	key[]: "aca_msg_book3_3_11_check3"
	val[]: "@@aca_msg_book3_sup_check1@@"
#!}
	key[]: "aca_msg_book3_3_11_check4"
	val[]: "Všetko by si mal v pohode zvládnuť sám. Neponáhľaj sa a rozumne využívaj dostupný priestor."

	key[]: "aca_msg_book3_3_11_check5"
	val[]: "Opatrne opusti kruhový objazd."

