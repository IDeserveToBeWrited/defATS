#+ Book 1 intro
#@{

	key[]: "aca_scenario_book1_intro_title"
	val[]: "Základy jazdy s kamiónom"

	key[]: "aca_msg_book1_intro_cutscene01"
	val[]: "Vitajte v @@driving_academy@@."

	key[]: "aca_msg_book1_intro_cutscene02"
	val[]: "Nasledujúce scenáre predstavujú prvý krok na tvojej ceste k profesionálnemu riadeniu kamióna."

	key[]: "aca_msg_book1_intro_cutscene03"
	val[]: "Tu sa naučíte všetko od základných systémov a ovládania ťahača..."

	key[]: "aca_msg_book1_intro_cutscene04"
	val[]: "...až po zložité manévre s alebo bez návesu."

	key[]: "aca_msg_book1_intro_cutscene05"
	val[]: "Pomôžeme ti naučiť sa návyky, ktoré ti pomôžu bezpečne sa zachovať v rôznych situáciách,"

	key[]: "aca_msg_book1_intro_cutscene06"
	val[]: "a naučia ťa rozumne využívať dostupný priestor na efektívne manévrovanie s kamiónom."

	key[]: "aca_msg_book1_intro_cutscene07"
	val[]: "Dokončením všetkých scenárov a zložením záverečných skúšok,"

	key[]: "aca_msg_book1_intro_cutscene08"
	val[]: "budeš pripravený vydať sa na americké cesty a čeliť novým výzvam."

