#+ Book 1 Scenario 3_05
#@{

#### 3_05 common
	key[]: "aca_scenario_book1_3_05_title"
	val[]: "Cúvanie s návesom"

	key[]: "aca_scenario_book1_3_05_desc"
	val[]: "V tomto scenári si prvýkrát vyskúšaš cúvanie s návesom. Je to pomerne jednoduchý manéver, ale stále budeš musieť správne riadiť, aby si náves dostal na správne miesto."

	#### 3_05 goal



	key[]: "aca_goal_book1_3_05_check_con"
	val[]: "Cúvanie k návesu"

	key[]: "aca_goal_book1_3_05_connect"
	val[]: "Pripojenie návesu"

	key[]: "aca_goal_book1_3_05_park_br_off"
	val[]: "Povolenie parkovacej brzdy"

	key[]: "aca_goal_book1_3_05_b_trailer"
	val[]: "Zarovnanie sa s parkovacou plochou"

	key[]: "aca_goal_book1_3_05_check1"
	val[]: "Cúvanie smerom k parkovacej ploche"

	key[]: "aca_goal_book1_3_05_check2"
	val[]: "Zarovnanie sa s parkovacou plochou"
#!{
	key[]: "aca_goal_book1_3_05_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_05_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_05_park_br_on"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

	key[]: "aca_goal_book1_3_05_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_05_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"


#!}
#### 3_05 msg - intro text

	key[]: "aca_msg_book1_3_05_cutscene01"
	val[]: "Vyskúšajme si cúvanie s návesom. Je to jednoduchšie, ako to vyzerá. Stačí byť trpezlivý."

	key[]: "aca_msg_book1_3_05_cutscene02"
	val[]: "Začni cúvať a zarovnaj ťahač s návesom."

	key[]: "aca_msg_book1_3_05_cutscene03"
	val[]: "Uisti sa, že si správne narovnaný, inak sa ti nepodarí pripojiť náves. Ak poloha nie je správne, môžeš sa vždy pohnúť dopredu a skúsiť to znova."

	key[]: "aca_msg_book1_3_05_cutscene04"
	val[]: "Točnica ťahača sa uzamkne na pripájací čap návesu."

	key[]: "aca_msg_book1_3_05_cutscene05"
	val[]: "Zatiahni parkovaciu brzdu a pripoj náves. V reálnom živote by si musel vystúpiť z ťahača, aby si pripojil vzduchové a elektrické vedenia a zdvihol podvozok, ale tu to za teba urobíme my."

	key[]: "aca_msg_book1_3_05_cutscene05b"
	val[]: "Choď dopredu a sleduj cestné značenie doprava a do vyznačeného jazdného pruhu."

	key[]: "aca_msg_book1_3_05_cutscene05c"
	val[]: "Cieľom je zarovnať sa s parkovacou plochou za tebou. Keď budeš cítiť, že si relatívne v línii s ňou, môžeš začať cúvať."

	key[]: "aca_msg_book1_3_05_cutscene06"
	val[]: "@@aca_msg_book1_3_05_cutscene06_img@@<br>Náves bude vždy zatáčať <color value=@@clr_sel@@>opačne <color value=@@clr_txt@@>ako ťahač."

	key[]: "aca_msg_book1_3_05_cutscene07"
	val[]: "@@aca_msg_book1_3_05_cutscene07_img@@<br>Ak chceš natočiť náves, budeš musieť zatáčať s ťahačom v<color value=@@clr_sel@@> opačnom <color value=@@clr_txt@@> smere, ako chceš natočiť náves."

	key[]: "aca_msg_book1_3_05_cutscene08"
	val[]: "@@aca_msg_book1_3_05_cutscene08_img@@<br>Aby si náves znova narovnal, otoč ťahač <br><color value=@@clr_sel@@>smerom k<color value=@@clr_txt@@> návesu."

	key[]: "aca_msg_book1_3_05_cutscene09"
	val[]: "Nechaj náves nasmerovaný k vyznačenej oblasti, potom sa snaž držať ťahač relatívne zarovnaný s návesom – budeš musieť neustále robiť drobné korekcie."

	key[]: "aca_msg_book1_3_05_cutscene10"
	val[]: "Koriguj odchýlky od svojej trasy malými otočeniami volantu ešte v zárodku. Ak to s korekciou preženieš, môžeš skončiť ďaleko mimo svojej požadovanej trasy."

	key[]: "aca_msg_book1_3_05_cutscene11"
	val[]: "Zastav na určenom mieste, potom zabezpeč ťahač a vypni motor."

#### 3_05 Driving Instructions

	key[]: "aca_msg_book1_3_05_start"
	val[]: "Za tebou napravo si môžeš všimnúť náves. Tvojou prvou úlohou bude zacúvať k nemu.<br><br><font face=/font/big_bold.font>Priprav ťahač na cúvanie.</font>"

	key[]: "aca_msg_book1_3_05_backward"
	val[]: "<font face=/font/big_bold.font>Začni cúvať smerom k návesu.</font>"

	key[]: "aca_msg_book1_3_05_check_con"
	val[]: "Zarovnaj sa tak, aby si bol v rovine s návesom. Točnica musí zachytiť pripájací čap. Ak je to nevyhnutné, posuň sa dopredu a uprav zarovnanie.<br><br><font face=/font/big_bold.font>Pokračuj v cúvaní až kým nepocítiš, že došlo k spojeniu.</font>"

	key[]: "aca_msg_book1_3_05_park_br_on"
	val[]: "Točnica je spojená s pripájacím čapom návesu a si pripravený dokončiť pripojenie k návesu.<br><br><font face=/font/big_bold.font>Aplikuj parkovaciu brzdu. </font>"

	key[]: "aca_msg_book1_3_05_connect"
	val[]: "<font face=/font/big_bold.font> Stlač @@imv_nrm_attach@@ pre pripojenie návesu. </font>"

	key[]: "aca_msg_book1_3_05_park_br_off"
	val[]: "Teraz je náves bezpečne pripojený k ťahaču, vzduchové a elektrické vedenia sú pripojené a podvozok je zdvihnutý.<br><br><font face=/font/big_bold.font>Uvoľni parkovaciu brzdu.</font>"

	key[]: "aca_msg_book1_3_05_b_trailer"
	val[]: "Ak sa chceš zaradiť do parkovacej plochy naľavo, choď dopredu a doprava. Použi cestné značenie, ktoré ti pomôže navigovať sa.<br><br><font face=/font/big_bold.font>Pokračuj vpred a zarovnaj sa s parkovacou plochou. </font>"

	key[]: "aca_msg_book1_3_05_check1"
	val[]: "Keď budeš relatívne zarovnaný s parkovacou plochou, môžeš začať cúvať. <br><br><font face=/font/big_bold.font>Začni cúvať s návesom. </font>"

	key[]: "aca_msg_book1_3_05_check2"
	val[]: "Pamätaj, že náves sa bude otáčať v opačnom smere, ako zatáčaš s ťahačom a taktiež, že malé otočenie volantu môže mať za následok výrazný pohyb návesu<br><br><font face=/font/big_bold.font>Pokračuj v cúvaní s návesom. </font>"
#!{
	key[]: "aca_msg_book1_3_05_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_05_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

#@}

#+ Book 1 Scenario 3_06
