#### 3_02 msg - intro text

	key[]: "aca_msg_book1_3_02_cutscene01"
	val[]: "V tomto scenári zoberieme ťahač na krátku jazdu. Budeš môcť získať cit pre brzdenie s návesom pri schádzaní miernym klesaním pred tebou. Priprav ťahač a vyraz."

	key[]: "aca_msg_book1_3_02_cutscene06"
	val[]: "Dosiahni rýchlosť aspoň 60 km/h (37 mph). Buď pripravený na brzdnú zónu pred tebou."

	key[]: "aca_msg_book1_3_02_cutscene08"
	val[]: "Začni brzdiť až do zastavenia. Uisti sa, že nečakáš príliš dlho, inak by si mohol naraziť do prekážok pred sebou!"

	key[]: "aca_msg_book1_3_02_cutscene10"
	val[]: "Zaparkuj na určenom mieste, potom zabezpeč ťahač a vypni motor."


#### 3_02 Driving Instructions

	key[]: "aca_msg_book1_3_02_start"
	val[]: "Počas tejto jazdy získaš cit pre používanie prevádzkovej brzdy pri schádzaní miernym klesaním. Účelom tohto cvičenia je uvedomiť si váhu za tebou a ako ovplyvňuje brzdnú dráhu vozidla.<br><br><font face=/font/big_bold.font>Priprav sa vyraziť. </font>"

	key[]: "aca_msg_book1_3_02_forward"
	val[]: "Pohni sa a maj na pamäti, že potrebuješ dosiahnuť rýchlosť 60 km/h (37 mph)<font face=/font/big_bold.font>za</font> zákrutou pred tebou.<br><br><font face=/font/big_bold.font>Prejdi smerom k zákrute. </font>"

	key[]: "aca_msg_book1_3_02_check1"
	val[]: "Odboč doprava a potom zrýchli na 60 km/h (39 mph).<br><br><font face=/font/big_bold.font>Pokračuj v jazde. </font>"

	key[]: "aca_msg_book1_3_02_check2"
	val[]: "<font face=/font/big_bold.font>Dosiahni rýchlosť aspoň 60 km/h (37 mph). </font>"

	key[]: "aca_msg_book1_3_02_check3"
	val[]: "Dosiahol si požadovanú rýchlosť.<br><br><font face=/font/big_bold.font>Zastav pri bariérach pred tebou. </font>"
#!{
	key[]: "aca_msg_book1_3_02_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_02_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

