	key[]: "aca_scenario_book2_training_course_title"
	val[]: "Priemyselné šialenstvo"

	key[]: "aca_scenario_book2_training_course_desc"
	val[]: "V tomto scenári budeš jazdiť cez priemyselnú tréningovú trať."

#### intro text

	key[]: "aca_scenario_book2_training_course_cutscene1"
	val[]: "Náročnosť trate sa postupne zvyšuje."

	key[]: "aca_scenario_book2_training_course_cutscene2"
	val[]: "Prejdi každú časť čo najrýchlejšie, ale bezpečne, a nezabudni plánovať dopredu k ďalšej zákrute!"



#@}

#+ Book 2 reverse_parking
#@{
#### common
	key[]: "aca_scenario_book2_reverse_parking_title"
	val[]: "Cúvanie s parkovaním okolo rohu"

	key[]: "aca_scenario_book2_reverse_parking_desc"
	val[]: "V tomto scenári musíš cúvať s kamiónom okolo slepého rohu a do parkovacieho miesta."

#### intro text

	key[]: "aca_scenario_book2_reverse_parking_cutscene1"
	val[]: "Vykladacie priestory nie sú vždy na ideálnom mieste. V tomto prípade je miesto skryté pred výhľadom budovou vedľa teba."

	key[]: "aca_scenario_book2_reverse_parking_cutscene2"
	val[]: "Cúvaj okolo budovy a do parkovacieho miesta."

#@}


#+ Book 2 blindside_parking
#@{
#### common
	key[]: "aca_scenario_book2_blindside_parking_title"
	val[]: "Parkovanie naslepo"

	key[]: "aca_scenario_book2_blindside_parking_desc"
	val[]: "V tomto scenári sa opäť dostaneš k cúvaniu zo strany s obmedzeným výhľadom. Tento manéver je už za ideálnych podmienok náročný, no teraz budeš čeliť prísnejším podmienkam."

#### intro text

	key[]: "aca_scenario_book2_blindside_parking_cutscene1"
	val[]: "Pred tebou a napravo je parkovacie miesto, do ktorého musíš cúvať. Zájdi zaň, potom dokonči cúvanie zo strany s obmedzeným výhľadom do parkovacieho miesta."

	key[]: "aca_scenario_book2_blindside_parking_cutscene2"
	val[]: "Miesta pre manévrovanie je menej než predtým, preto musíš byť presný a dôsledný v riadení."

#@}


#+ Book 2 advanced_alley_parking
#@{
#### common
	key[]: "aca_scenario_book2_advanced_alley_parking_title"
	val[]: "Pokročilé cúvanie v uličke"

	key[]: "aca_scenario_book2_advanced_alley_parking_desc"
	val[]: "V tomto scenári musíš vykonať sériu cúvacích manévrov, aby si prešiel uličkou a dostal sa do záverečnej parkovacej oblasti. "

#### intro text

	key[]: "aca_scenario_book2_advanced_alley_parking_cutscene1"
	val[]: "Musíš manévrovať kamiónom cez túto uličku, aby si sa dostal na parkovisko na druhej strane."

	key[]: "aca_scenario_book2_advanced_alley_parking_cutscene2"
	val[]: "Cúvaj cez uličku do voľného priestoru na opačnej strane ulice."

	key[]: "aca_scenario_book2_advanced_alley_parking_cutscene3"
	val[]: "K záverečnému parkovaciemu manévru môžeš pristúpiť podľa vlastného uváženia, ale pamätaj, že máš obmedzené možnosti korekcií a časový limit."

#### inside scenario

	key[]: "aca_msg_book2_advanced_alley_check1"
	val[]: "K záverečnému parkovaniu môžeš pristúpiť akokoľvek - neexistuje správny alebo nesprávny spôsob, pokiaľ nič nezasiahneš!"

	key[]: "aca_msg_book2_advanced_alley_check1_title"
	val[]: "Pripomienka"


#@}

#+ Book 2 tight_long_backing
#@{
#### common
	key[]: "aca_scenario_book2_tight_long_backing_title"
	val[]: "Posunuté parkovanie v dave"

	key[]: "aca_scenario_book2_tight_long_backing_desc"
	val[]: "V tomto scenári máš za úlohu presunúť svoj kamión z nakladacej oblasti na bezpečné parkovacie miesto v rušnom areáli plnom prekážok pomocou cúvacieho manévru s posunom."

#### intro text

	key[]: "aca_scenario_book2_tight_long_backing_cutscene1"
	val[]: "Tento scenár má predstavovať rušné parkovisko u odosielateľa.<br><br>Parkovacie miesto, ktoré potrebuješ, je priamo vedľa teba napravo."

	key[]: "aca_scenario_book2_tight_long_backing_cutscene2"
	val[]: "Pokračuj vpred do voľnej časti parkoviska, potom cúvaj na parkovacie miesto.<br><br>Ako vidíš, miesto je obmedzené a treba brať do úvahy aj niekoľko prekážok."

#@}


