	#### diag common

	key[]: "aca_scenario_book3_diag_title"
	val[]: "Diagonálne parkovanie B-double návesmi"

	key[]: "aca_scenario_book3_diag_desc"
	val[]: "V tomto scenári zaparkuješ svoju B-double súpravu na diagonálnom mieste rušného parkoviska."

#### diag msg - intro text

	key[]: "aca_msg_book3_diag_cutscene1"
	val[]: "Diagonálne parkovacie miesta, ako je toto, sú veľmi bežné. Sú obzvlášť typické pre staršie parkoviská, ale aj pre mnohé odpočívadlá na amerických diaľniciach."

	key[]: "aca_msg_book3_diag_cutscene2"
	val[]: "Prejdi k určenému parkovaciemu miestu na konci radu."

	key[]: "aca_msg_book3_diag_cutscene3"
	val[]: "Drž sa na vonkajšej strane jazdného pruhu, ale nie úplne pri zvodidlách, pretože by do nich mohla pri zatáčaní naraziť zadná časť návesu."

	key[]: "aca_msg_book3_diag_cutscene4"
	val[]: "Prejdi popri parkovacom mieste tak, aby doň mohli vojsť oba návesy. Potom sa drž na vonkajšej strane, aby sa na parkovacie miesto dostal prvý náves."

	key[]: "aca_msg_book3_diag_cutscene5"
	val[]: "Vyrovnaj sa, zastav na vyznačenom mieste a zaisti ťahač."

#### diag Driving Instructions

#!{
	key[]: "aca_msg_book3_diag_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_diag_forward"
	val[]: "Pokračuj smerom na koniec radu a nájdi svoje parkovacie miesto."

	key[]: "aca_msg_book3_diag_check1"
	val[]: "Poriadne si nadbehni pred parkovacie miesto, aby si sa uistil, že sa doň zmestí aj zadný náves. Potom ostro zatoč a zároveň dávaj pozor, aby sa predná časť prvého návesu nezrazila s ťahačom vedľa teba."

	key[]: "aca_msg_book3_diag_stop"
	val[]: "Pomaly pokračuj v narovnávaní súpravy a potom zastav na vyznačenom mieste."

#!{
	key[]: "aca_msg_book3_diag_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


