	key[]: "aca_msg_book3_correcting_90_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_correcting_90_forward"
	val[]: "Pohni sa dopredu preč z tohoto chaosu, aby si mohol s návesmi lepšie vojsť na miesto."

	key[]: "aca_msg_book3_correcting_90_check1"
	val[]: "Nacúvaj do parkovacieho miesta."

#!{
	key[]: "aca_msg_book3_correcting_90_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_correcting_90_end"
	val[]: "@@aca_msg_book3_sup_end@@"
