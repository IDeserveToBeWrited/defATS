#### finex msg - intro text

	key[]: "aca_msg_book3_finex_cutscene1"
	val[]: "Vitaj na záverečnej skúške. Pripravili sme niekoľko realistických situácií, s ktorými sa môžeš stretnúť na cestách. Cieľom je zistiť, ako sa s nimi dokážeš vysporiadať. Ako vždy sa neponáhľaj a jazdi precízne.<br><br>Veľa šťastia!"

#### finex Driving Instructions

	key[]: "aca_msg_book3_finex_check0"
	val[]: "Cesta pred tebou je zablokovaná, otoč sa na dostupnom mieste."

	key[]: "aca_msg_book3_finex_check1"
	val[]: "Pokračuj smerom k centru mesta."

	key[]: "aca_msg_book3_finex_check2"
	val[]: "Dosiahni rýchlosť aspoň 60 km/h (37 mph) pri približovaní sa k centru mesta."

	key[]: "aca_msg_book3_finex_check22"
	val[]: "Priprav sa na brzdenie."

	key[]: "aca_msg_book3_finex_speed"
	val[]: "Nedosiahol si rýchlosť 60 km/h (37 mph)"

	key[]: "aca_msg_book3_finex_check4"
	val[]: "Pokračuj v jazde po trati."

	key[]: "aca_msg_book3_finex_check5"
	val[]: "V rade ťahačov naľavo je pre tebe parkovacie miesto. Začni cúvať a zaparkuj."

#!{
	key[]: "aca_msg_book3_finex_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_finex_forward"
	val[]: "Pokračuj vpred, keď budeš pripravený."

#!{
	key[]: "aca_msg_book3_finex_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_finex_end"
