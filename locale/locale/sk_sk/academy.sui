#+ Book 1 Scenario 1_01
#@{

#### 1_01 common
	key[]: "aca_scenario_book1_1_01_title"
	val[]: "Skôr ako vyrazíš"

	key[]: "aca_scenario_book1_1_01_desc"
	val[]: "V tvojom prvom scenári si prejdeme základy vodičskej kabíny. Je dôležité správne nastaviť tvoje sedadlo, volant a bočné zrkadlá, pretože správna viditeľnosť je kľúčová pre zvládanie stresových alebo nebezpečných situácií.<br><br>Prejdeme si ovládanie týchto komponentov jeden po druhom."

#### 1_01 goal

	key[]: "aca_goal_book1_1_01_adjuster"
	val[]: "Nastavenie sedadla a zrkadiel"

	key[]: "aca_goal_book1_1_01_check_adj"
	val[]: "Kontrola zrkadiel a viditeľnosti"

#### 1_01 msg - intro text

	key[]: "aca_msg_book1_1_01_cutscene1"
	val[]: "Vitaj na svojej prvej lekcii!<br> Začnime tým, že sa naučíme, ako pripraviť ťahač na cestu."

	key[]: "aca_msg_book1_1_01_cutscene2"
	val[]: "Je kľúčové zabezpečiť, aby bola tvoja jazda vždy bezpečná, profesionálna a pod kontrolou.<br>Správne nastavenie sedadla, volantu a zrkadiel ti pomôže dosiahnuť tento cieľ."

	key[]: "aca_msg_book1_1_01_cutscene3"
	val[]: "Na každej strane ťahača sú nejaké vozidlá.<br>Pomôžu ti správne nastaviť zrkadlá."

	key[]: "aca_msg_book1_1_01_cutscene4"
	val[]: "Nechaj si čas na to, aby si všetko nastavil podľa svojich predstáv, pretože tieto nastavenia<br>budú mať významný vplyv na tvoju schopnosť ovládať ťahač."

#### 1_01 Driving Instructions

	key[]: "adj_tut_title_0"
	val[]: "Nastavenie sedadla a volantu"

	key[]: "adj_tut_title_1"
	val[]: "Nastavenie hlavných zrkadiel"

	key[]: "adj_tut_title_2"
	val[]: "Nastavenie konvexných zrkadiel"

	key[]: "adj_tut_title_3_hood"
	val[]: "Nastavenie zrkadiel na kapote"

	key[]: "adj_tut_title_3"
	val[]: "Kontrola viditeľnosti a konečné nastavenie zrkadiel"

	key[]: "adj_tut_open_adj_keyboard"
	val[]: "stlač @@imv_nrm_adjuster@@ alebo k nastaveniam pristúp cez úpravy vozidla pri pauznutí hry"

	key[]: "adj_tut_open_adj_gamepad"
	val[]: "k nastaveniam pristúp cez úpravy vozidla pri pauznutí hry"

	key[]: "adj_tut_open_adj"
	val[]: "Pre zobrazenie '@@adjust_link_t@@' počas hrania, $OPEN_ADJUSTER$."

	key[]: "adj_tut_open_seat"
	val[]: "Najprv si nastav sedadlo vodiča a volant.<br><br><font face=/font/big_bold.font>Otvor '@@adj_seats@@' pre pokračovanie..</font>"

	key[]: "adj_tut_open_mirrors"
	val[]: "<font face=/font/big_bold.font>Otvor @@adj_mirrors@@ pre nastavenie zrkadiel.</font>"

	key[]: "adj_tut_open_adj_intro"
	val[]: "Keď sa prvýkrát posadíš do ťahača, je dôležité najprv si nastaviť sedadlo, volant a zrkadlá podľa svojich predstáv.<br><br>Správna poloha za volantom je kľúčová pre správnu viditeľnosť. Všetky ovládacie prvky musia byť na dosah a vodič musí mať jasný výhľad dopredu, do strán a na zrkadlá.<br><br><font face=/font/big_bold.font> Pre zobrazenie konfiguračného menu, $OPEN_ADJUSTER$. </font>"

	key[]: "adj_tut_set_seat_and_back_adj"
	val[]: "@@adj_tut_set_seat_and_back_adj_img@@<br>Uprav si sedadlo tak, aby si mal dobrý výhľad na svoje okolie, ako aj zrkadlá, a aby si dosiahol na všetky ovládacie prvky.<br><br>Uprav polohu volantu tak, aby bol v príjemnej polohe a nezakrýval ti žiadne prístroje.<br><br><font face=/font/big_bold.font>Keď budeš spokojný s tvojimi úpravami, stlač @@imv_nrm_back@@ pre návrat do konfiguračného menu. </font>"

	key[]: "adj_tut_open_mirrors_intro"
	val[]: "@@adj_tut_open_mirrors_intro_img@@<br>Ťahače majú mnoho veľkých mŕtvych uhlov, preto sú vybavené viacerými vonkajšími zrkadlami, aby vodič videl čo najviac. <br><br>Správne nastavenie týchto zrkadiel ti umožní mať najlepší možný prehľad o tvojom okolí.<br><br><font face=/font/big_bold.font>Otvor '@@adj_mirrors@@' pre pokračovanie.</font>"

	key[]: "adj_tut_set_mirrors_t1_1_adj"
	val[]: "@@adj_tut_set_mirrors_t1_1_adj_img@@<br>Hlavné zrkadlá pokrývajú priestor pozdĺž bokov ťahača a návesu.<br><br>Na nastavenie správnej polohy hlavných zrkadiel použi autá na oboch stranách vozidla ako referenciu.<br><br><font face=/font/big_bold.font>Stlač @@imv_nrm_selectfcs@@ pre pokračovanie.</font>"

	key[]: "adj_tut_set_mirrors_t1_2_adj"
	val[]: "Hlavné zrkadlá sú tvojím hlavným nástrojom na sledovanie všetkého, čo sa deje vedľa teba a za tebou. Mal by si mať dobrý výhľad na auto vedľa seba, ale tiež sa uisti, že v zrkadle vidíš aj časť návesu, aby si mohol presne posúdiť polohu prekážok okolo seba."

	key[]: "adj_tut_set_mirrors_t1_2_adj_big"
	val[]: "Keď si spokojný s nastavením, prepni na hlavné zrkadlo na strane spolujazdca."

	key[]: "adj_tut_set_mirrors_t1_2_adj_moved"
	val[]: "Opäť by si mal mať dobrý výhľad na auto vedľa seba, pričom by si mal v zrkadle vidieť aj časť návesu."

	key[]: "adj_tut_set_mirrors_t1_2_adj_moved_big"
	val[]: "Keď si spokojný s nastavením zrkadla, prepni na konvexné zrkadlo na strane vodiča."

	key[]: "adj_tut_set_mirrors_t1_3_adj"
	val[]: "@@adj_tut_set_mirrors_t1_3_adj_img@@<br>Konvexné zrkadlá poskytujú širšie zorné pole, čo ti umožňuje vidieť viac z toho, čo sa okolo teba deje.<br><br><font face=/font/big_bold.font>Stlač @@imv_nrm_selectfcs@@ pre pokračovanie.</font>"

	key[]: "adj_tut_set_mirrors_t1_4_adj"
	val[]: "Ideálne by si mal vidieť auto aj kamión zaparkovaný na strane, pričom by mala byť viditeľná aj veľmi malá časť tvojho vlastného kamiónu."

	key[]: "adj_tut_set_mirrors_t1_4_adj_big"
	val[]: "Keď si spokojný s nastavením zrkadla, prepni na konvexné zrkadlo na strane spolujazdca."

	key[]: "adj_tut_set_mirrors_t1_4_adj_moved"
	val[]: "Opäť by si mal vidieť auto aj kamión zaparkované na strane, pričom by mala byť viditeľná aj malá časť tvojho vlastného kamiónu."

	key[]: "adj_tut_set_mirrors_t1_4_adj_moved_big"
	val[]: "Keď si spokojný s nastavením zrkadla, prepni na zrkadlo na kapote."

	key[]: "adj_tut_set_mirrors_t1_5_adj"
	val[]: "@@adj_tut_set_mirrors_t1_5_adj_img@@<br>Predné zrkadlá poskytujú pohľad do mŕtvych uhlov na oboch stranách kabíny, čo ti umožní vidieť malé autá a prekážky, ktoré by inak mohli byť skryté kvôli veľkým rozmerom kamiónu.<br><br><font face=/font/big_bold.font>Stlač @@imv_nrm_selectfcs@@ pre pokračovanie.</font>"

	key[]: "adj_tut_set_mirrors_t1_6_adj"
	val[]: "@@adj_tut_set_mirrors_t1_6_adj_img@@<br>Keďže máš iné zrkadlá na pohľad dozadu, tieto zrkadlá sú určené iba na to, aby si videl, čo je vedľa teba. Ramena kapoty a bočných zrkadiel poskytujú dobrý referenčný rámec, ktorý ukazuje, koľko z tvojho ťahača by malo byť stále viditeľné. Nastav zrkadlá do správnej polohy, ako je znázornené na diagrame.<br><br><font face=/font/big_bold.font>Keď budeš spokojný s nastavením, prepni sa na predné zrkadlo na strane spolujazdca.</font>"

	key[]: "adj_tut_set_mirrors_t1_6_adj_moved"
	val[]: "@@adj_tut_set_mirrors_t1_6_adj_moved_img@@<br>Rovnako nastav polohu tohto zrkadla.<br><br><font face=/font/big_bold.font>Keď budeš spokojný s nastavením zrkadla, stlač @@imv_nrm_back@@ na zatvorenie nastavenia zrkadiel.</font>"

	key[]: "adj_tut_back_adj"
	val[]: "<font face=/font/big_bold.font>Stlač @@imv_nrm_back@@ pre návrat do konfiguračného menu. </font>"

	key[]: "adj_tut_close_adj"
	val[]: "Výborne, s nastaveným sedadlom a zrkadlami podľa tvojich predstáv si teraz o krok bližšie k vyrazeniu na cestu!<br><br><font face=/font/big_bold.font>Zavri konfiguračné menu pomocou @@imv_nrm_back@@. </font>"

	key[]: "adj_tut_open_con"
	val[]: "Ešte raz sa rozhliadni a uisti sa, že si spokojný s výhľadom z kabíny a že zrkadlá ti poskytujú dobrý prehľad o tom, čo sa deje okolo ťahača.<br><br>Ak ti niečo nevyhovuje, môžeš zrkadlá znovu nastaviť v '@@adjust_link_t@@' konfiguračnom menu. <br><br><font face=/font/big_bold.font>Stlač @@imv_nrm_activate@@ pre ukončenie scenára.</font> @@aca_goal_tip@@ Na zobrazenie alebo skrytie zrkadiel na obrazovke, môžeš ísť do '@@adjust_link_t@@' — '@@adj_ui_mirrors@@' v menu pri pauznutí hry. Zrkadlá na obrazovke uľahčujú sledovanie strany spolujazdca."
#@}

