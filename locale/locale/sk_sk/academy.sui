	key[]: "aca_msg_scenario_forward_barriers"
	val[]: "Pokračuj rovno medzi bariéry."

	key[]: "aca_msg_scenario_follow_checkpoints"
	val[]: "Sleduj kontrolné body a dbaj na ich orientáciu."

	key[]: "aca_msg_scenario_reverse_in_forward_out"
	val[]: "Cúvaj na vyznačené miesto a potom z neho vyjdi vpred."

	key[]: "aca_msg_scenario_forward_in_reverse_out"
	val[]: "Pokračuj vpred na vyznačené miesto a potom z neho vycúvaj."

	key[]: "aca_msg_scenario_reverse_continue"
