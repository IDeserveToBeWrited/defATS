#+ Book 3 Scenario parallel
#@{

#### parallel common
	key[]: "aca_scenario_book3_parallel_title"
	val[]: "Pozdĺžne parkovanie"

	key[]: "aca_scenario_book3_parallel_desc"
	val[]: "V tomto scenári zaparkujeme B-double návesy paralelne pri ceste."

#### parallel goal

	key[]: "aca_goal_book3_parallel_check1"
	val[]: "Cúvanie"

#!{
	key[]: "aca_goal_book3_parallel_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_parallel_end"
	val[]: "@@aca_goal_book3_sup_end@@"

	key[]: "aca_goal_book3_parallel_start"
