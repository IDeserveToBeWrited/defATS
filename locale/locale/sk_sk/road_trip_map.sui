#+ Washington TBs and POIs localization.
#@{
	key[]: "tb_wa1"
	val[]: "Olympijský polostrov"

	key[]: "tb_wa1_desc"
	val[]: "Olympijský polostrov odhaľuje miesto, kde oceán, les a hory spolunažívajú v neustále sa meniacej kráse. Nad skalnatým pobrežím sa prevaľuje hmla, zatiaľ čo z vysočiny padajú vodopády a skryté údolia ukrývajú malé historické mestečká."

	key[]: "poi_wa1_01"
	val[]: "Historická pošta Spojených štátov"

	key[]: "poi_wa1_01_desc"
	val[]: "Budova, dokončená v roku 1893 na útese nad nábrežím Port Townsend, bola navrhnutá ako federálne zariadenie s colnicou, čo odrážalo rané ambície mesta stať sa novým centrom medzinárodného obchodu."

	key[]: "poi_wa1_02"
	val[]: "Port Angeles"

	key[]: "poi_wa1_02_desc"
	val[]: "Port Angeles je prímorské mesto založené v 19. storočí ako prístav a zásobovacie miesto. Dnes slúži ako kľúčová vstupná brána do Národného parku Olympic a trajektový prístav spájajúci Spojené štáty a Kanadu."

	key[]: "poi_wa1_03"
	val[]: "Jazero Crescent"

	key[]: "poi_wa1_03_desc"
	val[]: "Jazero Crescent, druhé najhlbšie jazero vo Washingtone, je známe svojou sýtomodrou, krištáľovo čistou vodou v dôsledku nízkej hladiny dusíka. Nachádza sa v obľúbenej rekreačnej oblasti a je obklopené chodníkmi a pralesom."
	
	key[]: "poi_wa1_04"
	val[]: "Kalaloch Beach"

	key[]: "poi_wa1_04_desc"
	val[]: "Kalaloch Beach je známa vďaka „Stromu života“ (Tree of Life), smreku sitkanského s odhalenými koreňmi, ktoré sa tiahnu ponad malý potok k pobrežiu. Na rozdiel od typických vysokých smrekov je kratší, hrubší a ošľahaný vetrom, čo z neho robí jedinečnú a obľúbenú miestnu dominantu."

	key[]: "poi_wa1_05"
	val[]: "Národný park Olympic"

	key[]: "poi_wa1_05_desc"
	val[]: "Národný park Olympic chráni rozmanité ekosystémy, od drsného tichomorského pobrežia a dažďových lesov mierneho pásma až po horské vrcholy. Prvýkrát bol klasifikovaný ako národná pamiatka v roku 1909 a federálna vláda ho v roku 1938 premenovala na národný park."

	key[]: "poi_wa1_06"
	val[]: "Greenhead Slough"

	key[]: "poi_wa1_06_desc"
	val[]: "Greenhead Slough je malý záliv a kanál v mokradiach pozdĺž cesty Highway 101 neďaleko Willapa Bay. Nachádza sa v pobrežnom ústí rieky, ktoré bolo obnovené na podporu neresenia lososov a bohaté pozorovanie vodného vtáctva."

	key[]: "poi_wa1_07"
	val[]: "Dabob Bay"

	key[]: "poi_wa1_07_desc"
	val[]: "Dabob Bay je hlboký fjord, ktorý podporuje lososy, mäkkýše a divokú prírodu. Prírodná oblasť Dabob Bay, založená v roku 1984, chráni vzácne slaniská a rastlinné spoločenstvá na piesočných dunách v rámci vysoko funkčného systému prílivových mokradí."


##########################################################################################

	key[]: "tb_wa2"
	val[]: "Vnútrozemie"

	key[]: "tb_wa2_desc"
	val[]: "Vnútrozemie Washingtonu pozýva cestovateľov pozdĺž malebných ciest cez vždyzelené lesy a pokojné horské jazerá. Mount Rainier dominuje horizontu a ponúka ikonické výhľady a pokojnú cestu do prírodnej krajiny pacifického severozápadu."

	key[]: "poi_wa2_01"
	val[]: "Mount Rainier"

	key[]: "poi_wa2_01_desc"
	val[]: "Mount Rainier, najvyšší vrch Washingtonu s výškou 14 411 stôp, je aktívny stratovulkán. Jeho ľadovce napájajú rieky, formujú údolia a udržiavajú bohaté lesy a voľne žijúcu zver, vďaka čomu je dôležitým prírodným orientačným bodom."

	key[]: "poi_wa2_02"
	val[]: "Národný les Wenatchee"

	key[]: "poi_wa2_02_desc"
	val[]: "Národný les Wenatchee sa rozprestiera na horách, riekach a horských údolach. V roku 1933 tu organizácia Civilian Conservation Corps vybudovala chodníky a protipožiarne vyhliadky, čím zanechala trvalú stopu v rekreačnej a ochranárskej histórii lesa."

	key[]: "poi_wa2_03"
	val[]: "Národný les Mount Baker-Snoqualmie"

	key[]: "poi_wa2_03_desc"
	val[]: "Národný les Mount Baker-Snoqualmie hostí niektoré z najstarších miest na monitorovanie ľadovcov v Amerike, ktoré od začiatku 20. storočia sledujú toky sopečného ľadu a klimatické zmeny v celom pohorí Cascades."
	
	key[]: "poi_wa2_04"
	val[]: "Rieka Wenatchee"

	key[]: "poi_wa2_04_desc"
	val[]: "Zvyšky zavlažovacích kanálov a mlynov zo začiatku 19. storočia pozdĺž rieky Wenatchee ukazujú, ako osadníci využívali jej vodu. Domorodé kmene sa tiež spoliehali na jej vody bohaté na lososy ako na zdroj potravy a obchodu dlho pred príchodom Európanov."

	key[]: "poi_wa2_05"
	val[]: "Klawatti Peak"

	key[]: "poi_wa2_05_desc"
	val[]: "Klawatti Peak, prvýkrát zdolaný v polovici 20. storočia, zostáva zriedkavo navštevovaným vrcholom kvôli strmým, ľadovcom pokrytým svahom, čo z neho robí vyhľadávanú výzvu pre horolezcov hľadajúcich izoláciu v severnej časti Cascades."

	key[]: "poi_wa2_06"
	val[]: "Dry Falls Dam"

	key[]: "poi_wa2_06_desc"
	val[]: "Priehrada Dry Falls Dam, vybudovaná na reguláciu miestnych vodných tokov, stojí na pravekých čadičových útesoch. Usmerňuje sezónne toky a zároveň odhaľuje terasy a hlboké jazierka vyhĺbené povodňami v dobe ľadovej."

	key[]: "poi_wa2_07"
	val[]: "Vyhliadka White Mountain Fire"

	key[]: "poi_wa2_07_desc"
	val[]: "Na vyhliadke sa nachádzajú informačné tabule o požiari White Mountain Fire v roku 1988, ktorý bol jedným z najväčších lesných požiarov vo Washingtone v nedávnej histórii, a zobrazujú jazvy a vzorce obnovy lesa."

	key[]: "wa_cut_helen_desc"
	val[]: "Pred rokom 1980 mal Mount St. Helens kužeľovitý tvar a hovorilo sa mu americký Mount Fuji. Erupcia v roku 1980 odstránila 1 300 stôp z jeho vrcholu a vytvorila kráter v tvare podkovy, ktorý je dnes čiastočne zaplnený lávovým dómom a ľadovcom."


##########################################################################################


	key[]: "tb_wa3"
	val[]: "Vinárska oblasť"

	key[]: "tb_wa3_desc"
	val[]: "Východne od pohoria Cascades sa rozprestiera vinárska oblasť Washingtonu, Columbia Valley AVA. Tento región zahŕňa potok Selah Creek, štátny park Lewis and Clark a územia historicky obývané domorodým obyvateľstvom a vyznačuje sa suchou, slnečnou krajinou s vlnitými kopcami a riečnymi údoliami."

	key[]: "poi_wa3_01"
	val[]: "Vodopády Clear Creek"

	key[]: "poi_wa3_01_desc"
	val[]: "Vyhliadka na vodopády Clear Creek Falls je obľúbenou zastávkou kúsok na východ od priesmyku White Pass Summit. Približne o míľu ďalej na východ vedie odbočka do rekreačnej oblasti Clear Lake, ktorá je známa rybolovom a výbornými možnosťami na pozorovanie miestnej zveri."

	key[]: "poi_wa3_02"
	val[]: "Most Selah Creek"

	key[]: "poi_wa3_02_desc"
	val[]: "Most Fred G. Redmon Bridge, alebo most Selah Creek Bridge, je dvojklenbová konštrukcia v okrese Yakima County. Po dokončení išlo o najdlhší betónový oblúkový most v Amerike a najvyšší automobilový most v štáte."

	key[]: "poi_wa3_03"
	val[]: "Vinice"
	
	key[]: "poi_wa3_03_desc"
	val[]: "Údolia a úrodná pôda vo Washingtone podporujú pestovanie viniča vrátane odrôd Rizling, Cabernet a Merlot. Vinice sú významnou súčasťou poľnohospodárstva a miestnej krajiny tohto štátu."

	key[]: "poi_wa3_04"
	val[]: "Most Ed Hendler"

	key[]: "poi_wa3_04_desc"
	val[]: "Most postavený v roku 1978, niekedy nazývaný Intercity Bridge, prekleňuje rieku Columbia medzi mestami Pasco a Kennewick v juhovýchodnom Washingtone. Od svojho otvorenia je vnímaný ako dominanta a symbol oblasti Tri-Cities."

	key[]: "poi_wa3_05"
	val[]: "Štátny park Lewis and Clark"

	key[]: "poi_wa3_05_desc"
	val[]: "Jeden z prvých štátnych parkov vo Washingtone, štátny park Lewis and Clark, chráni starobylé lesy pozdĺž historickej cesty domorodých obyvateľov. Lesy, pomenované na počesť výpravy Corps of Discovery, pripomínajú husté lesy, ktoré Meriwether Lewis opísal vo svojich denníkoch."

	key[]: "poi_wa3_06"
	val[]: "Budova súdu okresu Columbia"

	key[]: "poi_wa3_06_desc"
	val[]: "Súdna budova okresu Columbia County odráža dobu, kedy bola okresná vláda ústredným bodom každodenného života. V období rýchleho rastu a obmedzeného kontaktu s hlavným mestom štátu slúžili súdne budovy ako hlavný zdroj autority a riešili bezprostredné potreby občanov."

	key[]: "poi_wa3_07"
	val[]: "Indiánske kmene"

	key[]: "poi_wa3_07_desc"
	val[]: "Údolie Columbia Valley a okolité oblasti boli domovom pôvodných obyvateľov, vrátane kmeňov Yakama, Walla Walla a Umatilla. Dnes tieto komunity naďalej žijú v regióne, udržiavajú kultúrne tradície a spravujú pôdne a vodné zdroje."

##########################################################################################

#@}




#+ Oregon TBs and POIs localization.
#@{
	key[]: "tb_or1"
	val[]: "Pacifické pobrežie"

	key[]: "tb_or1_desc"
	val[]: "Tichomorské pobrežie Oregonu sa otvára cez drsné mysy s malebnými vyhliadkami. Zatiaľ čo maják Heceta Head Lighthouse čelí narážajúcim vlnám, cesty lemujú čadičové útesy Silver Point, Ophir Wayside, Sisters Rocks a Kissing Rock, ktoré sa stretávajú s tichomorským príbojom."

	key[]: "landmark_or_astoria_b_desc"
	val[]: "Tento most s dĺžkou štyroch míľ prekleňuje rieku Columbia, spája Oregon a Washington a ponúka výhľady na ústie rieky a tichomorský horizont."

	key[]: "poi_or1_01"
	val[]: "Vyhliadka Silver Point"

	key[]: "poi_or1_01_desc"
	val[]: "Táto vyhliadka nachádzajúca sa južne od Cannon Beach ponúka úchvatné výhľady na Haystack Rock a drsné pobrežie, ktoré sú obzvlášť očarujúce pri západe slnka."

	key[]: "or_cut_lighthouse_desc"
	val[]: "Najvyšší maják v Oregone, postavený v roku 1873, stojí na čadičovom myse neďaleko mesta Newport."

	key[]: "or_cut_newport_desc"
	val[]: "Most Yaquina Bay Bridge, dokončený v roku 1936, je jednou z najikonickejších pobrežných pamiatok Oregonu. Navrhol ho renomovaný inžinier Conde McCullough a jeho elegantný oblúk sa klenie nad zálivom Yaquina Bay a zostáva charakteristickým znakom cesty U.S. Route 101."

	key[]: "or_cut_thor_desc"
	val[]: "Prírodný závrt na myse Cape Perpetua, kde sa rúcajú valiace sa vlny, čo vytvára ilúziu, že oceán odteká preč."

	key[]: "poi_or1_02"
	val[]: "Ophir Wayside"

	key[]: "poi_or1_02_desc"
	val[]: "Pokojná zastávka neďaleko Gold Beach, kde sa návštevníci môžu pretiahnuť, sledovať príboj alebo hľadať na pláži naplavené drevo a acháty."

	key[]: "poi_or1_03"
	val[]: "Vyhliadka Sisters Rock"

	key[]: "poi_or1_03_desc"
	val[]: "Z príboja sa týčia dramatické skalné útvary v mori a chodníky vedú k malým plážam ukrytým medzi útesmi."

	key[]: "poi_or1_04"
	val[]: "Kissing Rock"

	key[]: "poi_or1_04_desc"
	val[]: "Zastávka pri ceste južne od Gold Beach, kde nad pieskom o seba opierajú dva masívne skalné útvary, vďaka čomu je to obľúbené miesto na fotografovanie."


##########################################################################################

	key[]: "tb_or2"
	val[]: "Divoký východ"

	key[]: "tb_or2_desc"
	val[]: "Tento región, často nazývaný Divokým východom Oregonu, odhaľuje krajinu formovanú geologickými silami počas stoviek miliónov rokov, z ktorých mnohé sú aktívne aj dnes. V porovnaní s týmto obrovským časovým meradlom je ľudská história krátka, no poznačená momentmi takými dramatickými, ako samotná krajina."

	key[]: "landmark_or_deadman_p_desc"
	val[]: "Táto vyhliadková oblasť neďaleko Pendletonu ponúka výhľady na priesmyk Deadman Pass, pomenovaný podľa incidentu zo 70. rokov 19. storočia počas vojny Bannock War, keď tam našli mŕtveho vodiča voza. O desaťročia skôr prešli týmito kopcami nespočetné vozy na Oregonskej ceste (Oregon Trail)."

	key[]: "or_cut_395_desc"
	val[]: "Cesta US-395, kedysi známa ako diaľnica Three Flags Highway, sa tiahla z Kanady do Mexika a spájala púšte, lesy a pohoria. Dnes končí na diaľnici US-15 v Kalifornii, hoci pozostatky pôvodnej trasy sa zachovali neďaleko San Diega."

	key[]: "poi_or2_01"
	val[]: "Národný les Malheur"

	key[]: "poi_or2_01_desc"
	val[]: "Národný les Malheur leží v pohorí Blue Mountains. Pred viac ako 150 miliónmi rokov tvorili niektoré z najstarších hornín v tomto regióne súčasť sopečných ostrovov v Pacifiku, ktoré sa neskôr spojili s kontinentom."
	
	key[]: "poi_or2_02"
	val[]: "Badlands Wilderness"

	key[]: "poi_or2_02_desc"
	val[]: "Oblasť Badlands Wilderness východne od mesta Bend je drsná sopečná krajina vyformovaná dávnymi lávovými tokmi a vetrom nafúkaným popolom. Jej pokrútené lávové útvary, piesočnaté pôdy a holý terén vytvárajú jedno z najunikátnejších prostredí vysokej púšte v štáte."

	key[]: "poi_or2_03"
	val[]: "Jazero Abert"

	key[]: "poi_or2_03_desc"
	val[]: "Jazero Abert, prvýkrát zmapované v roku 1843, podporuje prítomnosť ľudí už viac ako 10 000 rokov. Hoci je pre ryby príliš slané, zostáva dôležitou zastávkou pre vtáky na trase Pacific Flyway a v posledných desaťročiach sa v dôsledku klimatických zmien zmenšuje."

	key[]: "poi_or2_04"
	val[]: "East Steens Tour Route"

	key[]: "poi_or2_04_desc"
	val[]: "Trasa East Steens Tour Route kopíruje cestu Highway 78 popri Steens Mountain a púšti Alvord Desert. Jej hlavným bodom je pláň púšte Alvord Desert, jedno z najväčších suchých jazerných korýt v Oregone, ktoré sa sezónne mení z plytkého jazera na obrovskú púštnu pláň."

	key[]: "poi_or2_05"
	val[]: "Doherty Slide"

	key[]: "poi_or2_05_desc"
	val[]: "Jazda popri Doherty Slide, skalnom útvare vzniknutom sopečnou činnosťou, trvá necelú hodinu. Prírode však trvalo približne 16 miliónov rokov, kým vyformovala krajinu do dnešnej podoby."


##########################################################################################

	key[]: "tb_or3"
	val[]: "Trasa Petra Skene Ogdena"

	key[]: "tb_or3_desc"
	val[]: "Táto trasa kopíruje vnútrozemský severo-južný koridor Oregonu, prechádza lesmi a vysokou púšťou. Prvýkrát ju v 20. rokoch 19. storočia preskúmal obchodník s kožušinami Peter Skene Ogden a neskôr počas druhej svetovej vojny získala strategický význam vďaka drevu a dopravným trasám."
	
	key[]: "poi_or3_01"
	val[]: "Plameň v Springfielde"

	key[]: "poi_or3_01_desc"
	val[]: "Táto socha s výškou takmer 65 stôp označuje severnú bránu Springfield a bola navrhnutá v tvare plameňa, aby slúžila ako maják pre cestovateľov a orientačný bod pre obyvateľov aj návštevníkov."

	key[]: "poi_or3_02"
	val[]: "Santiam Wagon Road"

	key[]: "poi_or3_02_desc"
	val[]: "Priesmyk východne odtiaľto, kedysi nazývaný Wiley Pass po Andrewovi Wileyovi, preskúmali v roku 1859 pionieri hľadajúci pastviny. V roku 1864 bola naplánovaná vojenská cesta, no väčšinou zostala nepostavená. Spoplatnená trasa Santiam Wagon Road fungovala v rokoch 1868 až 1914."

	key[]: "poi_or3_03"
	val[]: "Historická diaľnica veteránov"

	key[]: "poi_or3_03_desc"
	val[]: "Pri severnej bráne diaľnice boli 9. novembra 2012 južne od Biggs Junction nainštalované posledné dva z 18 pamätných znakov. Označujú Camp Rufus ako severný vstupný bod na prvú diaľnicu v krajine venovanú veteránom z druhej svetovej vojny."

	key[]: "poi_or3_04"
	val[]: "Vyhliadka Ogden State Scenic Viewpoint"

	key[]: "poi_or3_04_desc"
	val[]: "Táto zastávka, pomenovaná po Petrovi Skene Ogdenovi, prieskumníkovi zo začiatku 19. storočia a hlavnom obchodníkovi spoločnosti Hudson's Bay Company, vzdáva hold jeho expedíciám cez oblasť rieky Snake a jeho úlohe medzi prvými, ktorí preskúmali panvu Veľkého Slaného jazera."

	key[]: "landmark_or_fremont_b_desc"
	val[]: "Most aj Fremont Street v Portlande sú pomenované po Johnovi C. Frémontovi, ranom prieskumníkovi oblastí Las Californias a Oregon Country. Vyznačuje sa najdlhším hlavným rozpätím v Oregone a radí sa ako druhý najdlhší oblúkový most s ťahadlom na svete."

	
##########################################################################################

#@}



#+ California TBs and POIs localization.
#@{
	key[]: "tb_ca1"
	val[]: "Zlatý horizont"

	key[]: "tb_ca1_desc"
	val[]: "Ikonické mosty sa týčia nad trblietavou vodou a spájajú Alcatraz, Santa Cruz, tunajšie kopce a mestské štvrte. Od rušných ulíc a pamiatok až po slnkom zaliate pláže a pobrežia, oblasť Bay Area ponúka kalifornský zážitok ako žiadna iná."

	key[]: "ca_cut_golden_gate_bridge_desc"
	val[]: "Most spájajúci záliv San Francisco s Tichým oceánom je ikonickým symbolom San Francisca a Kalifornie. Keď ho v roku 1937 otvorili, držal rekord ako najdlhší aj najvyšší visutý most na svete."

	key[]: "poi_ca1_01"
	val[]: "Alcatraz"

	key[]: "poi_ca1_01_desc"
	val[]: "Ostrov Alcatraz bol v rokoch 1934 až 1963 domovom federálnej väznice. Známy tým, že v ňom boli uväznení niektorí z najznámejších zločincov, je dnes historickou pamiatkou a obľúbeným cieľom turistov."

	key[]: "ca_cut_richmond_desc"
	val[]: "Most Richmond–San Rafael sa klenie nad zálivom San Francisco a spája mestá Richmond a San Rafael. Bol otvorený v roku 1956, prevádza dopravu cez severnú časť zálivu, vyznačuje sa konzolovou a priehradovou konštrukciou a slúži ako kľúčové regionálne dopravné spojenie."
	
	key[]: "poi_ca1_02"
	val[]: "Treasure Island"

	key[]: "poi_ca1_02_desc"
	val[]: "Treasure Island je umelý ostrov postavený pre medzinárodnú výstavu Golden Gate v roku 1939. Po tom, čo slúžil ako námorná základňa, v súčasnosti prebieha jeho prestavba na rezidenčné a komerčné účely."

	key[]: "poi_ca1_03"
	val[]: "Mesto surfingu"

	key[]: "poi_ca1_03_desc"
	val[]: "Socha surfistu v Santa Cruz vzdáva hold surferskému dedičstvu a kultúre mesta. Je umiestnená neďaleko pláže a oslavuje miestnych surfistov a šport, ktorý formoval identitu Santa Cruz a jeho pobrežnú komunitu."

	key[]: "poi_ca1_04"
	val[]: "Madonna Inn"

	key[]: "poi_ca1_04_desc"
	val[]: "Bývalá populárna reštaurácia a pamiatka na vrchole diaľnice Highway 152. Od roku 2004 je zatvorená kvôli problémom s diaľnicou a zostáva častou témou na fórach o miestnej histórii a strašidelných príbehoch."



##########################################################################################

	key[]: "tb_ca2"
	val[]: "Trasa Shasta"

	key[]: "tb_ca2_desc"
	val[]: "Trasa Shasta sa vinie cez borovicové lesy a trblietavé jazerá pod vrchom Mount Shasta. Cesty stúpajú a klesajú cez skryté údolia a vedú cestovateľov na juh, pričom hory sa postupne strácajú a ustupujú sekvojovým pralesom severnej Kalifornie."

	key[]: "poi_ca2_01"
	val[]: "Národný les Shasta-Trinity"

	key[]: "poi_ca2_01_desc"
	val[]: "Národný les Shasta-Trinity, najväčší v Kalifornii, križuje vyhliadková cesta Trinity Heritage Scenic Byway, ktorá kopíruje trasy využívané zlatokopmi a osadníkmi v 19. storočí."

	key[]: "poi_ca2_02"
	val[]: "Big Lagoon"

	key[]: "poi_ca2_02_desc"
	val[]: "Big Lagoon je najväčšia a najjužnejšia z troch lagún v štátnom parku Humboldt Lagoons. Tieto plytké pobrežné panvy ležia medzi skalnatými mysmi, kde oceánske vlny vytvorili piesočné bariéry, ktoré oddeľujú lagúny od Tichého oceánu."

	key[]: "or_cut_sequoia_desc"
	val[]: "Národný park Redwood chráni jedny z najvyšších a najstarších sekvojí vždyzelených na svete, ktoré dosahujú výšku cez 370 stôp a dožívajú sa až 2 000 rokov. Spolu s neďalekými štátnymi parkami chráni približne 35 % zostávajúcich sekvojových pralesov na planéte."
	
	key[]: "poi_ca2_03"
	val[]: "Rieka Smith"

	key[]: "poi_ca2_03_desc"
	val[]: "V rámci národného lesa Six Rivers v severozápadnej Kalifornii bola táto chránená oblasť vyhlásená Kongresom v roku 1990 s cieľom zachovať malebné, ekologické a kultúrne hodnoty. Rieka Smith je jedinou veľkou kalifornskou riekou bez priehrad a s voľným tokom."

	key[]: "poi_ca2_04"
	val[]: "Most Whiskey Creek"

	key[]: "poi_ca2_04_desc"
	val[]: "Most Whiskey Creek, dokončený v roku 1961, je trojpoľový zváraný plnostenný nosníkový most. Je pozoruhodný ako skorý príklad konštrukcie mosta využívajúci tri rôzne druhy ocele, čo bola v tom čase inovatívna technika zvárania."

	key[]: "poi_ca2_05"
	val[]: "Jazero Shasta"

	key[]: "poi_ca2_05_desc"
	val[]: "Jazero Shasta, najväčšia kalifornská priehrada, vzniklo vybudovaním priehrady Shasta Dam na rieke Sacramento. Dokončené bolo v roku 1945 a poskytuje vodu, vodnú energiu a je malebným miestom na rekreáciu."

	key[]: "poi_ca2_06"
	val[]: "Mount Shasta"

	key[]: "poi_ca2_06_desc"
	val[]: "Od 20. rokov 19. storočia sprevádzal Mount Shasta, druhý najvyšší vrch v pohorí Cascade Range, cestovateľov po trase Siskiyou Trail na jeho úpätí. Táto trasa sa neskôr vyvinula na diaľnicu Interstate 5, ktorá dnes ročne privádza k vrchu tisíce ľudí."



##########################################################################################

	key[]: "tb_ca3"
	val[]: "Prechod cez Sierru"

	key[]: "tb_ca3_desc"
	val[]: "Pod týčiacim sa pohorím Sierra Nevada leží hostinec Inn at Benton uprostred otvorených údolí a zvlnených kopcov. Prechod cez Sierru sa vinie po pokojných cestách vo vysokej púšti, kde vzdialené vrcholy a drsné hrebene vytvárajú nadčasovú panorámu a pozývajú cestovateľov preskúmať šíru krajinu tohto regiónu."

	key[]: "ca_cut_olmsted_point_desc"
	val[]: "Národný park Yosemite, založený v roku 1890, patrí k najnavštevovanejším parkom. Je známy Yosemitskými vodopádmi, najvyššími v Severnej Amerike, rozsiahlymi sieťami chodníkov a obrími sekvojami starými vyše 3 000 rokov."

	key[]: "poi_ca3_01"
	val[]: "Tioga Road"

	key[]: "poi_ca3_01_desc"
	val[]: "Tioga Road je ikonická vyhliadková trasa vedúca srdcom Národného parku Yosemite. Je to najvyšší horský diaľničný priesmyk v Kalifornii, ktorý spája západnú a východnú stranu pohoria Sierra Nevada."

	key[]: "poi_ca3_02"
	val[]: "Jazero Mono"

	key[]: "poi_ca3_02_desc"
	val[]: "Jazero Mono je staré viac ako 1 milión rokov, čo z neho robí jedno z najstarších jazier v Severnej Amerike. Keďže nemá prirodzený odtok, hromadili sa v ňom soli a minerály prinášané potokmi tečúcimi z východnej Sierry Nevada počas tisícok rokov."
	
	key[]: "poi_ca3_03"
	val[]: "Jazero Tahoe"

	key[]: "poi_ca3_03_desc"
	val[]: "Jazero Tahoe vzniklo približne pred 2 miliónmi rokov v panve Tahoe Basin, pričom jeho súčasný tvar vyformovali ľadovce z doby ľadovej. Je to najväčšie horské jazero v Severnej Amerike a druhé najhlbšie v Spojených štátoch."

	key[]: "poi_ca3_04"
	val[]: "Národný les Eldorado"

	key[]: "poi_ca3_04_desc"
	val[]: "Národný les Eldorado tvorí časť hlavného povodia, ktoré zásobuje vodou milióny Kalifornčanov a podporuje farmy produkujúce takmer polovicu ovocia a zeleniny v krajine."

	key[]: "poi_ca3_05"
	val[]: "Inn at Benton Hot Springs"

	key[]: "poi_ca3_05_desc"
	val[]: "Benton, jedno z najstarších miest v okrese Mono, založili Indiáni kmeňa Pajutov, ktorí využívali miestne horúce pramene. V 60. rokoch 19. storočia sa stalo zastávkou pre osadníkov a baníkov. Hostinec Inn, postavený v 40. rokoch z miestnej pemzy, nahradil hotel z roku 1904 s 10 izbami so spoločnou kúpeľňou."



##########################################################################################

	key[]: "tb_ca4"
	val[]: "Slnko a piesok"

	key[]: "tb_ca4_desc"
	val[]: "Púšť v Údolí smrti sa rozprestiera pod nekonečným nebom s dunami, ostrými vrcholmi a popraskanými pláňami. Divoké králiky poskakujú po piesku zaliatom slnkom, lebky lemujú tiché cesty a osamotené cesty sa vinú drsnou, nehostinnou krajinou, ktorá preverí a ohúri každého, kto sa sem odváži."

	key[]: "poi_ca4_01"
	val[]: "Lone Pine"

	key[]: "poi_ca4_01_desc"
	val[]: "Lone Pine je malé mestečko v kalifornskom údolí Owens Valley, na východnom úpätí pohoria Sierra. Známe pre neďaleké kopce Alabama Hills, už dlho slúži ako vstupná brána pre turistov, horolezcov a filmárov objavujúcich okolité pohoria a púštne scenérie."

	key[]: "poi_ca4_02"
	val[]: "Národný park Údolie smrti"

	key[]: "poi_ca4_02_desc"
	val[]: "Údolie smrti je jednou z najextrémnejších krajín v Amerike – miestami najnižšia, najhorúcejšia, najsuchšia a najvyššia. Dlho pred priekopníkmi z 19. storočia tu žili domorodé kmene, ktoré v tomto drsnom, no historicky bohatom regióne lovili a zbierali potravu."

	key[]: "poi_ca4_03"
	val[]: "Vyhliadka Father Crowley"

	key[]: "poi_ca4_03_desc"
	val[]: "Táto vyhliadka je obľúbenou zastávkou cestovateľov. Často sa tu pristavoval otec John J. Crowley, známy ako púštny páter. V blízkosti západnej hranice parku ponúka úchvatné výhľady na Rainbow Canyon, pestrofarebný útvar vyformovaný dávnou sopečnou činnosťou."
	
	key[]: "poi_ca4_04"
	val[]: "Mojave Valley Wells"

	key[]: "poi_ca4_04_desc"
	val[]: "Vo Valley Wells v púšti Mojave zaznamenávajú dávne nánosy podzemnej vody minulé močaristé prostredia z doby ľadovej. Tieto historické studne ukazujú, ako podzemná voda kedysi podporovala močiare a bujnú vegetáciu v inak vyprahnutej púšti."

	key[]: "poi_ca4_05"
	val[]: "Indiánska rezervácia rieky Colorado"

	key[]: "poi_ca4_05_desc"
	val[]: "Rezervácia sa rozprestiera pozdĺž rieky Colorado v Arizone a Kalifornii. Bola založená v roku 1865 pre kmene žijúce pri rieke a je domovom kmeňov Mohavov, Čemehuevov, Hopi a Navahov, pričom dnes podporuje poľnohospodárstvo a komunitný život."

##########################################################################################

#@}



#+ Idaho TBs and POIs localization.
#@{

    key[]: "tb_id1"
	val[]: "Treasure Valley"

	key[]: "tb_id1_desc"
	val[]: "Údolie Treasure v juhozápadnom Idahu má bohatú históriu formovanú indiánskymi kmeňmi, ranými obchodníkmi s kožušinami a osadníkmi na Oregonskej ceste. Jeho názov odráža zdroje a príležitosti tejto oblasti, ktorá neskôr rástla vďaka poľnohospodárstvu, železniciam a regionálnemu obchodu so strediskom v meste Boise."

	key[]: "poi_id1_01"
	val[]: "Rieka Salmon"

	key[]: "poi_id1_01_desc"
	val[]: "Rieka Salmon v Idahu sa tiahne v dĺžke 425 míľ cez hlboký a drsný kaňon. Získala prezývku „Rieka bez návratu“, pretože rané lode sa nedokázali plaviť späť proti prúdu pre jej silné a náročné prúdy."

	key[]: "poi_id1_02"
	val[]: "Národný les Boise"

	key[]: "poi_id1_02_desc"
	val[]: "Národný les Boise sa rozprestiera na ľahko erodovateľnom útvare Idaho Batholith a vyznačuje sa drsnou krajinou vytvorenou sopečnou činnosťou. Toto geologické dedičstvo je najlepšie vidieť v jeho strmých kaňonoch a mnohých prírodných horúcich prameňoch ukrytých v celom teréne."

	key[]: "poi_id1_03"
	val[]: "Horseshoe Bend"

	key[]: "poi_id1_03_desc"
	val[]: "Po objavení zlata v panve Boise Basin v roku 1862 založili baníci zimujúci pri rieke osadu Horseshoe Bend. Mesto, pôvodne nazývané Warrinersville po majiteľovi miestnej píly, dostalo svoj súčasný názov v roku 1867, keď sa stalo kľúčovou zastávkou pre prospektorov."
	
	key[]: "poi_id1_04"
	val[]: "Mýtna brána"

	key[]: "poi_id1_04_desc"
	val[]: "V roku 1864 nahradila strmú cestu Syrup Creek nová trasa cez kaňon. Po dobu 20 rokov financovalo mýto jej údržbu, zatiaľ čo slávny hotel a mliekareň Jamesa A. Portera sa stali poprednou zastávkou pre cestujúcich hľadajúcich útočisko."

	key[]: "poi_id1_05"
	val[]: "Castle Rock"

	key[]: "poi_id1_05_desc"
	val[]: "Smerom k pláni Camas Prairie slúžili žulové výbežky Castle Rock ako ikonické orientačné body pre emigrantov na Oregonskej ceste na skratke Goodale's Cutoff. Tieto vzácne útvary, využívané od roku 1862 až do éry automobilov, ponúkali cestovateľom úchvatný pohľad na trasu."

    key[]: "poi_id1_06"
	val[]: "Indiánska rezervácia Duck Valley"

	key[]: "poi_id1_06_desc"
	val[]: "V roku 1886 prezident Cleveland rozšíril Duck Valley do Idaha prostredníctvom rozšírenia „Paddy Cap Extension“. Do roku 1934 získali rôzne skupiny, ktoré sa presídlili do rezervácie, oficiálne federálne uznanie ako zjednotené kmene Šošonov a Pajutov."


##########################################################################################

    key[]: "tb_id2"
	val[]: "Magic Valley"

	key[]: "tb_id2_desc"
	val[]: "Začiatkom 20. storočia premenil I. B. Perrine vyprahnutú púšť v Idahu na poľnohospodársku pôdu vybudovaním priehrady Milner Dam. Priehrada, dokončená v roku 1905, využívala vodu z rieky Snake na „magickú“ premenu krajiny. Tým vzniklo údolie Magic Valley, čo viedlo k vzniku prosperujúcich poľnohospodárskych miest, ktoré existujú dodnes."

	key[]: "id_cut_perrine_desc"
	val[]: "Vodopády Shoshone Falls, ktoré sú s výškou 212 stôp vyššie ako Niagarské vodopády, sú krásnou dominantou rieky Snake nachádzajúcou sa priamo na okraji mesta Twin Falls."

	key[]: "id_cut_galena_desc"
	val[]: "Toto banské mestečko, založené v roku 1879 po objavení olova a striebra, zaniklo v 90. rokoch 19. storočia v dôsledku poklesu cien. Dnes táto oblasť prosperuje ako rekreačné stredisko, domov historickej chaty Galena Lodge a blízkeho priesmyku Galena Summit."

	key[]: "poi_id2_01"
	val[]: "Bison Jump"

	key[]: "poi_id2_01_desc"
	val[]: "Bison Jump nachádzajúci sa v Challis je historické miesto, kde domorodí obyvatelia hnali bizóny cez útesy na účely ich lovu. Táto chránená krajina, využívaná viac ako 2 000 rokov, ponúka pohľad na starobylé spoločné lovecké tradície."
	
	key[]: "poi_id2_02"
	val[]: "Grand View Canyon"

	key[]: "poi_id2_02_desc"
	val[]: "Kaňon Grand View Canyon, nachádzajúci sa pozdĺž vyhliadkovej cesty Peaks to Craters Scenic Byway na ceste US-93, ponúka úchvatné výhľady na pohorie Lost River Range. Toto pohorie je domovom deviatich najvyšších vrcholov Idaha, vďaka čomu je kaňon jedným z hlavných bodov tejto vyhliadkovej trasy."

	key[]: "landmark_id_mackay_rs_desc"
	val[]: "Rieka Big Lost River, pôvodne nazývaná Goddin’s River po lovcovi kožušín Thyerym Goddinovi, je známa tým, že sa stráca v lávových poliach. Táto „stratená“ voda tečie pod zemou a nakoniec sa znova vynára pri veľkolepých prameňoch Thousand Springs neďaleko rieky Snake."

    key[]: "poi_id2_03"
	val[]: "Mestá duchov pri Mackay"

	key[]: "poi_id2_03_desc"
	val[]: "Mestečká ako White Knob a Cliff Creek, vybudované na kopci „Mine Hill“ v banskej oblasti White Knob, poháňali medený, zlatý a strieborný boom až do polovice 20. storočia. Tieto miesta zostávajú kľúčovými pozostatkami historického banského priemyslu v Idahu."

	key[]: "id_cut_craters_desc"
	val[]: "Oblasiť Craters of the Moon, vytvorená sopečnými erupciami pred 15 000 rokmi, sa vyznačuje rozsiahlou krajinou lávových tokov a troskových kužeľov. Jej nadpozemský terén je taký jedinečný, že ho astronauti z NASA kedysi využívali na výcvik na mesačné misie."



##########################################################################################

#@}



#+ Montana TBs and POIs localization.
#@{

    key[]: "tb_mt1"
	val[]: "Prechod cez Glacier"

	key[]: "tb_mt1_desc"
	val[]: "Oblasť Glacier Country je domovom jedných z posledných aktívnych ľadovcov v Skalnatých vrchoch. Počas tisícročí tieto starobylé ľadové masy vyformovali hlboké údolia, ostré štíty a priezračné jazerá a vytvorili krajinu, ktorá dnes charakterizuje západnú Montanu."

	key[]: "poi_mt1_01"
	val[]: "Vodopády Kootenai"

	key[]: "poi_mt1_01_desc"
	val[]: "Vodopády Kootenai Falls sú najväčšími neregulovanými vodopádmi v Montane a hlavnou regionálnou atrakciou. Rieka Kootenai tu na krátkom úseku klesá o približne 300 stôp, čím vytvára mohutnú panoramatickú kaskádu, ktorá láka návštevníkov svojimi nezabudnuteľnými výhľadmi."

	key[]: "poi_mt1_02"
	val[]: "Berne Roadside Park"

	key[]: "poi_mt1_02_desc"
	val[]: "Kaňon Bad Rock Canyon bol obľúbenou zastávkou pre cestujúcich pozdĺž rieky Flathead, známy rybolovom, malebnými výhľadmi a prírodným prameňom, ktorý sa kedysi používal na chladenie prehriatych chladičov áut. V roku 1956 sa stal jedným z prvých odpočívadiel v Montane s názvom Berne Roadside Park."

	key[]: "poi_mt1_03"
	val[]: "Heavens Peak"

	key[]: "poi_mt1_03_desc"
	val[]: "Heaven’s Peak, jedna z najikonickejších hôr Národného parku Glacier, pomenoval v 90. rokoch 19. storočia prospektor Louie Meyer. Prieskumníci, ohromení jej krásou a týčiacou sa skalnou stenou Garden Wall, ju videli ako niečo úplne iné, než s čím sa na svojej ceste doteraz stretli."

	key[]: "mt_cut_glacier_national_park_desc"
	val[]: "Národný park Glacier, oslavovaný ako „Koruna kontinentu“, bol založený v roku 1910. Bol formovaný starobylými ľadovcami a širší prístup získal v roku 1932 dokončením cesty Going-to-the-Sun Road, ktorá je dnes historickou inžinierskou pamiatkou."

	key[]: "poi_mt1_04"
	val[]: "Pamätník kmeňa Čiernohovcov"

	key[]: "poi_mt1_04_desc"
	val[]: "Na východnom okraji Národného parku Glacier sa rozprestiera územie kmeňa Čiernohovcov (Blackfeet Nation). Sú známi ako „bojovníci plání“ a predpokladá sa, že ich názov pochádza z mokasín stmavených popolom. Dodnes zostáva niekoľko miest v parku pre kmeň posvätných."

	key[]: "mt_cut_flathead_lake_desc"
	val[]: "Jazero Flathead Lake je podľa rozlohy najväčším prírodným sladkovodným jazerom v priľahlých Spojených štátoch. Voda z topiaceho sa snehu z okolitých hôr ho zásobuje výnimočne čistou vodou, ktorá sa každých niekoľko rokov úplne obnoví, čím patrí medzi najčistejšie veľké jazerá na svete."

	key[]: "mt_cut_thompson_falls_desc"
	val[]: "Mestečko, pomenované po britsko-kanadskom obchodníkovi s kožušinami a kartografovi Davidovi Thompsonovi, zažilo rozvoj po príchode železnice v roku 1881. Ďalej sa rozširovalo počas neďalekej zlatej horúčky v oblasti Coeur d’Alene, keď sa stalo kľúčovou zastávkou pre baníkov smerujúcich po trase Murray Trail."

	key[]: "landmark_mt_missoula_desc"
	val[]: "Neoklasicistická budova súdu okresu Missoula County, postavená z pieskovca a navrhnutá A. J. Gibsonom v roku 1910, nahradila staršiu, menšiu stavbu. Okres Missoula County, založený v roku 1860, je jednou z najstarších politických oblastí Montany, ktorá sa tiahne od pohoria Bitterroot až po Skalnaté vrchy."

    key[]: "poi_mt1_05"
	val[]: "Lolo Creek"

	key[]: "poi_mt1_05_desc"
	val[]: "Koridor medzi obcou Lolo a priesmykom Lolo Pass kopíruje historickú trasu pozdĺž potoka Lolo Creek. Kedysi tade putovali Indiáni kmeňa Nez Perce, raní osadníci a expedícia Lewisa a Clarka a dodnes zostáva dôležitou kultúrnou a historickou krajinou s informačnými tabuľami."

##########################################################################################

    key[]: "tb_mt2"
	val[]: "Veľké pláne"

	key[]: "tb_mt2_desc"
	val[]: "Veľké pláne (Great Plains) v Montane sa rozprestierajú vo východnej časti štátu a sú charakteristické rozľahlými trávnatými plochami, zvlnenými prériami a šírym nebom. Tento región poskytol jedny z najvýznamnejších fosílií dinosaurov v Severnej Amerike a ponúka pohľad do krajiny, ktorá existovala pred miliónmi rokov."

	key[]: "poi_mt2_01"
	val[]: "Formácia Hell Creek"

	key[]: "poi_mt2_01_desc"
	val[]: "Súvrstvie Hell Creek (Hell Creek Formation) so stredom pozdĺž potoka Hell Creek neďaleko mestečka Jordan v Montane zachováva dávnu subtropickú krajinu riek, lesov a močiarov. Datuje sa do obdobia pred 67 – 66 miliónmi rokov a je svetovo preslávené bohatým výskytom fosílií dinosaurov vrátane ikonického Tyrannosaura rexa."

	key[]: "poi_mt2_02"
	val[]: "Rieka Yellowstone"

	key[]: "poi_mt2_02_desc"
	val[]: "Rieka Yellowstone je najdlhšou voľne tečúcou riekou v priľahlých Spojených štátoch. Pramení v Národnom parku Yellowstone, preteká v dĺžke 676 míľ cez Wyoming a Montanu a následne sa vlieva do rieky Missouri. Celú svoju dĺžku preteká bez jedinej priehrady."

	key[]: "poi_mt2_03"
	val[]: "Glendisaurus"

	key[]: "poi_mt2_03_desc"
	val[]: "Glendisaurus, socha Triceratopsa v životnej veľkosti v meste Glendive, oslavuje bohaté dedičstvo dinosaurov v tomto regióne. Je vysoká približne 10 stôp a slúži ako obľúbený orientačný bod pozdĺž Dinosaurieho chodníka."
	
	key[]: "poi_mt2_04"
	val[]: "Rieka Missouri"

	key[]: "poi_mt2_04_desc"
	val[]: "Rieka Missouri, známa pod prezývkou „Big Muddy“ (Veľká zablatená), je najdlhšou riekou v Spojených štátoch. Preteká v dĺžke 2 341 míľ zo Skalnatých vrchov v Montane až do rieky Mississippi a zohrala kľúčovú úlohu pri prieskume, obchode a expanzii amerického pohraničia na západ."

	key[]: "mt_cut_fort_peck_spillway_desc"
	val[]: "Priehrada Fort Peck Dam, postavená počas Veľkej hospodárskej krízy, je najväčšou hydraulicky sypanou zemitou priehradou na svete. Bola dokončená ako jeden z najväčších projektov verejných prác v Amerike a jej cieľom bolo poskytnúť prácu, regulovať záplavy a vyrábať elektrickú energiu."

    key[]: "poi_mt2_05"
	val[]: "Múzeum priekopníkov v okrese Valley"

	key[]: "poi_mt2_05_desc"
	val[]: "Toto múzeum približuje históriu severovýchodnej Montany prostredníctvom expozícií o kmeni Assiniboinov, železniciach, poľnohospodárstve, priehrade Fort Peck Dam a expedícii Lewisa a Clarka. Nachádza sa tu aj rozsiahly archív a jedna z najväčších zbierok predmetov kmeňa Assiniboinov v krajine."

	key[]: "poi_mt2_06"
	val[]: "Skala Spiaci bizón"

	key[]: "poi_mt2_06_desc"
	val[]: "Tieto veľké ľadovcové balvany boli pre domorodé kmene posvätnými orientačnými bodmi. Vyformovali a prepravili ich staroveké ľadovce. Menšia skala „Buffalo Rock“ (Bizónia skala) bola vytesaná tak, aby pripomínala bizóna, zatiaľ čo väčšia skala „Medicine Rock“ (Liečivá skala) obsahuje rôzne petroglyfy."



##########################################################################################

#@}



#+ Wyoming TBs and POIs localization.
#@{

    key[]: "tb_wy1"
	val[]: "Bizónia cesta"

	key[]: "tb_wy1_desc"
	val[]: "Oblasť, v ktorej sa nachádzajú parky Yellowstone a Grand Teton, leží na aktívnom sopečnom systéme, ktorý poháňa gejzíry a horúce pramene, zatiaľ čo ľadovce a zlomy vyformovali jej vrcholy a údolia. Tieto sily spoločne robia zo severozápadného Wyomingu jednu z geologicky najdynamickejších a vizuálne najikonickejších krajín amerického Západu."

	key[]: "landmark_wy_yellowsto_desc"
	val[]: "Yellowstone, založený v roku 1872 ako prvý národný park na svete, leží na vrchole mohutnej spiacej sopky. Je domovom približne polovice aktívnych gejzírov na svete a chráni tiež jeden z najväčších a najneporušenejších ekosystémov mierneho pásma na Zemi."

	key[]: "poi_wy1_01"
	val[]: "Lower Geyser Basin"

	key[]: "poi_wy1_01_desc"
	val[]: "Lower Geyser Basin je najväčšia gejzírová panva v Yellowstone s obrovskou koncentráciou gejzírov, horúcich prameňov a parných prieduchov. Je poháňaná teplom z magmy hlboko pod zemou a predstavuje jednu z najaktívnejších geotermálnych oblastí parku."

	key[]: "poi_wy1_02"
	val[]: "Jazero Yellowstone"

	key[]: "poi_wy1_02_desc"
	val[]: "Jazero Yellowstone je najväčším vysokohorským jazerom v Severnej Amerike a je domovom najväčšej populácie divokého pstruha lososovitého (cutthroat trout) na kontinente. Vedci sa domnievajú, že kedysi odtekalo smerom k Tichému oceánu, čo rybám umožnilo prekonať kontinentálne rozvodie cez priesmyk Two Ocean Pass."
	
	key[]: "poi_wy1_03"
	val[]: "Buffalo Bill Dam"

	key[]: "poi_wy1_03_desc"
	val[]: "Priehrada Buffalo Bill Dam, dokončená v roku 1910, bola jednou z prvých betónových oblúkových priehrad v Spojených štátoch. S výškou 325 stôp bola v tom čase najvyššou priehradou na svete a stala sa významným bodom raných inžinierskych inovácií."

	key[]: "poi_wy1_04"
	val[]: "Colter's Hell"

	key[]: "poi_wy1_04_desc"
	val[]: "Colter’s Hell je historická geotermálna oblasť pozdĺž rieky Shoshone, ktorú v roku 1807 pomenoval prieskumník John Colter. Raní horali prirovnávali jej pariace sa prieduchy a sírový zápach k „peklu“. Dnes zostávajú aktívne už len horúce pramene a parné prieduchy."

	key[]: "wy_cut_grand_teton_desc"
	val[]: "Národný park Grand Teton je charakteristický svojimi ľadovcom vyformovanými vrcholmi, ktoré sa ostro týčia nad údolím Jackson Hole. Tieto vrchy, ktoré lovci kožušín kedysi nazývali „Pilot Knobs“ kvôli ich viditeľnosti z plání, zostávajú jednými z najikonickejších symbolov amerického Západu."

	key[]: "poi_wy1_05"
	val[]: "Crowheart Butte"

	key[]: "poi_wy1_05_desc"
	val[]: "Crowheart Butte je výrazný orientačný bod pomenovaný po bitke z roku 1866 medzi kmeňmi Šošonov a Crow. Podľa tradície náčelník Washakie po víťazstve Šošonov umiestnil na vrchol stolovej hory srdce náčelníka kmeňa Crow ako varovanie, čo dalo tomuto útvaru jeho trvalé meno."

##########################################################################################

    key[]: "tb_wy2"
	val[]: "Červená púšť"

	key[]: "tb_wy2_desc"
	val[]: "Červená púšť (Red Desert) vo Wyomingu je obrovská panva vysokej púšte, ktorú charakterizuje vetrom tvarovaný piesok, palinové pláne a výrazné červené skalné útvary. Je to jedna z najväčších neobývaných oblastí v Severnej Amerike a je formovaná extrémnym podnebím, starovekými jazernými korytami a dlhými migračnými trasami."

	key[]: "poi_wy2_01"
	val[]: "Červený kaňon"

	key[]: "poi_wy2_01_desc"
	val[]: "Červený kaňon (Red Canyon) bol vyformovaný počas vyzdvihnutia pohoria Wind River Range približne pred 60 miliónmi rokov. Jeho charakteristické červené útesy sú tvorené z horniny Chugwater, ktorej zoxidované železo dodáva kaňonu sýtu farbu, ktorá inšpirovala jeho názov."

	key[]: "poi_wy2_02"
	val[]: "Krajina plná sily"

	key[]: "poi_wy2_02_desc"
	val[]: "Boar’s Tusk, sopečný skalný útvar týčiaci sa viac ako 400 stôp nad Červenou púšťou vo Wyomingu, je erodovaným jadrom sopky, ktorá vznikla pred miliónmi rokov. Ponúka výhľad na rozsiahle piesočné duny Killpecker Sand Dunes, ktoré sú súčasťou najväčšieho aktívneho dunového poľa v Severnej Amerike."

	key[]: "poi_wy2_03"
	val[]: "Rock Springs"

	key[]: "poi_wy2_03_desc"
	val[]: "Rock Springs je známy ako „Mesto 56 národností“ vďaka svojmu rozmanitému prisťahovaleckému dedičstvu. Koncom 19. storočia sem prichádzali ľudia z celého sveta za prácou v uhoľných baniach spoločnosti Union Pacific. Mesto je spojené aj so slávnym vyhnancom Butchom Cassidym."
	
	key[]: "poi_wy2_04"
	val[]: "Chata Butcha Cassidyho"

	key[]: "poi_wy2_04_desc"
	val[]: "Butch Cassidy bol slávny americký vyhnanec a zbojník, ktorý viedol gang „Wild Bunch“, známy prepadávaním vlakov a bánk na Starom západe. Prezývku „Butch“ získal počas práce v mäsiarstve v Rock Springs. Ich najlegendárnejšou a najvplyvnejšou lúpežou bol prepad vlaku Wilcox v roku 1899."

	key[]: "wy_cut_evanston_desc"
	val[]: "Evanston, založený v roku 1869 železnicou Union Pacific Railroad, bol pomenovaný po geodetovi Jamesovi A. Evansovi. Mesto rástlo ako železničný uzol a neskôr sa stalo regionálnym centrom poľnohospodárstva, ropy a plynu."

    key[]: "poi_wy2_05"
	val[]: "Lander Cutoff"

	key[]: "poi_wy2_05_desc"
	val[]: "Skratka Lander Cutoff, vybudovaná po prijatí zákona Pacific Wagon Road Act z roku 1857, bola jednou z prvých federálne financovaných ciest pre vozy na americkom Západe. Pomenovaná bola po inžinierovi Frederickovi W. Landerovi a poskytovala kratšiu trasu pre emigrantov cestujúcich na západ."

	

##########################################################################################

#@}


#+ South Dakota TBs and POIs localization.
#@{

    key[]: "tb_sd1"
	val[]: "Black Hills"

	key[]: "tb_sd1_desc"
	val[]: "Západnú Južnú Dakotu charakterizujú oblasti Black Hills a Badlands. Rozľahlé prérie tu prechádzajú do borovicami porastených hôr, žulových veží a stád potulujúcich sa bizónov. Hneď za nimi odhaľuje drsná oblasť Badlands úchvatnú krajinu vyformovanú vetrom a vodou počas miliónov rokov."

	key[]: "poi_sd1_01"
	val[]: "Národný les Black Hills"

	key[]: "poi_sd1_01_desc"
	val[]: "Táto borovicami porastená oblasť, známa Lakotom ako Paha Sapa (čo znamená „Čierne kopce“), je domovom Black Elk Peak, najvyššieho bodu Južnej Dakoty vo výške 7 244 stôp. Vrchol, premenovaný na počesť slávneho lakotského liečiteľa, je tiež najvyšším vrcholom východne od Skalnatých vrchov."

	key[]: "sd_cut_rush_desc"
	val[]: "Mount Rushmore, známy ako americká „Svätyňa demokracie“, bol vytesaný do pohoria Black Hills v rokoch 1927 až 1941. Pamätník obsahuje 60 stôp vysoké sochy prezidentov Washingtona, Jeffersona, Roosevelta a Lincolna, ktoré predstavujú zrod, rast, rozvoj a zachovanie krajiny."

	key[]: "poi_sd1_02"
	val[]: "Most Beaver Creek"

	key[]: "poi_sd1_02_desc"
	val[]: "Tento 225 stôp dlhý oceľobetónový oblúkový most, postavený v roku 1929, sa klenie nad kaňonom neďaleko Národného parku Wind Cave. Týči sa 115 stôp nad dnom kaňonu, je jediným mostom svojho druhu v Južnej Dakote a bol navrhnutý tak, aby dokonale splýval s okolitou skalou."

	key[]: "sd_cut_sturgis_desc"
	val[]: "Mesto Sturgis je známe tým, že hostí najväčší motocyklový zraz na svete. Každoročné 10-dňové podujatie, ktoré v roku 1938 založil miestny predajca motocyklov Indian Pappy Hoel, privádza do Black Hills jazdcov z celého sveta na prehliadky motocyklov, preteky, hudbu a oslavy."

	key[]: "sd_cut_deadwood_desc"
	val[]: "Deadwood vyrástol počas zlatej horúčky v Black Hills v roku 1876 a stal sa jedným z najznámejších miest Divokého západu. V roku 1961 bol vyhlásený za národnú historickú pamiatku a je jediným mestom v USA s týmto statusom, pričom chráni veľkú časť svojho historického centra."

	key[]: "sd_cut_badlands_desc"
	val[]: "Národný park Badlands sa rozprestiera na rozlohe 244 000 akrov stolových hôr, veží a spišov vedľa najväčšej chránenej zmiešanej prérie v krajine. Zachováva tiež jedno z najbohatších nálezísk fosílií na svete, ktoré odhaľuje starodávne cicavce, ktoré sa kedysi potulovali po Veľkých pláňach."

	key[]: "poi_sd1_03"
	val[]: "Tunel Doane Robinson"

	key[]: "poi_sd1_03_desc"
	val[]: "Doane Robinson, známy ako „otec Mount Rushmore“, si predstavoval veľkolepý pamätník v Black Hills, ktorý by prilákal návštevníkov do Južnej Dakoty. Dnes jeho odkaz pokračuje, pričom Mount Rushmore je dokonale orámovaný panoramatickým tunelom Doane Robinson."

	key[]: "sd_cut_hot_springs_desc"
	val[]: "Hot Springs, pôvodne nazývané Minnekahta Siouxmi pre svoje „horúce vody“, bolo osídlené v roku 1879 okolo minerálnych prameňov, o ktorých sa predpokladalo, že majú liečivé účinky. Premenované v roku 1882, stalo sa kúpeľným strediskom a zostáva známe historickými kúpeľmi Evans Plunge."

	key[]: "poi_sd1_04"
	val[]: "The Mammoth Site"

	key[]: "poi_sd1_04_desc"
	val[]: "The Mammoth Site je svetoznáme nálezisko fosílií z doby ľadovej, kde bolo odkrytých 61 mamutov. Dávny závrt, objavený v roku 1974, uchováva najväčšiu zbierku pozostatkov mamuta kolumbijského v Severnej Amerike, pričom vykopávky pokračujú dodnes."

##########################################################################################

    key[]: "tb_sd2"
	val[]: "Veľký predel"

	key[]: "tb_sd2_desc"
	val[]: "Oblasť rieky Missouri v Južnej Dakote predstavuje centrálny predel štátu s rovinatými pláňami na jednej strane a zvlnenými kopcami na druhej. Bol to kľúčový koridor pre domorodé národy, obchodníkov s kožušinami a Lewisa a Clarka a neskôr sa stal domovom veľkých priehrad, pohraničných miest a bohatej riečnej histórie."

	key[]: "poi_sd2_01"
	val[]: "Štyri veľké jazerá"

	key[]: "poi_sd2_01_desc"
	val[]: "Jazerá Oahe, Sharpe, Francis Case a Lewis & Clark, vytvorené priehradami na rieke Missouri koncom 40. rokov 20. storočia, dnes definujú strednú časť Južnej Dakoty. Tieto priehrady spoločne poskytujú viac ako 440 míľ pobrežia na člnkovanie, rybolov a rekreáciu."

	key[]: "poi_sd2_02"
	val[]: "Mesto duchov Bangor"

	key[]: "poi_sd2_02_desc"
	val[]: "Bangor bol kedysi sídlom okresu Walworth, no po presťahovaní jeho budov do blízkeho Selby v roku 1899 sa stal mestom duchov. Dnes len pamätník označuje miesto, kde mesto kedysi stálo."

	key[]: "landmark_sd_state_capitol_desc"
	val[]: "Mesto Pierre, založené v roku 1880, sa stalo hlavným mestom Južnej Dakoty, keď štát v roku 1889 vstúpil do Únie. Vybrané pre svoju polohu v strede štátu a priechod cez rieku Missouri, mesto bolo pomenované po francúzsko-americkom obchodníkovi s kožušinami Pierrovi Chouteauovi Jr."

	key[]: "sd_cut_corn_desc"
	val[]: "Kukuričný palác (Corn Palace) v Mitchelli je jediným palácom na svete zdobeným výhradne kukuricou. Každý rok miestni umelci a poľnohospodári vytvárajú nové nástenné obrazy s použitím prirodzene zafarbenej kukurice, obilnín a tráv, čo z neho robí jednu z najunikátnejších pamiatok Južnej Dakoty."

	key[]: "landmark_sd_largest_pheasant_desc"
	val[]: "Mesto Huron je domovom najväčšieho bažanta na svete (World’s Largest Pheasant), 40 stôp vysokej sochy zo sklolaminátu a ocele postavenej v roku 1959. Váži 22 ton a oslavuje dlhoročnú povesť tohto regiónu ako jednej z popredných poľovníckych destinácií na lov bažantov v Amerike."

	key[]: "landmark_sd_dignity_of_earth_and_sky_desc"
	val[]: "Dignity Of Earth & Sky (Dôstojnosť zeme a neba) je 50 stôp vysoká socha z nehrdzavejúcej ocele s výhľadom na rieku Missouri neďaleko mesta Chamberlain. Vytvoril ju umelec Dale Lamphere a vzdáva hold dedičstvu, odolnosti a kultúre kmeňov Lakotov a Dakotov."

##########################################################################################

#@}
