#+ Text deviations for American Truck Simulator. Please, use only terms appropriate for USA (i.e. culture specific nuances, not American English).
#@{

#+ Music/radio player
#@{

#+ Hint shown if no music files are found. Also shown as tooltip when hovering over music_player button.

	key[]: "music_player_hint"
	val[]: "Dajte si svoje pesničky do zložky <color value=@@clr_sel@@>American Truck Simulator/music <color value=@@clr_txt@@>ktorú nájdete vo vašich <color value=@@clr_sel@@>Dokumentoch <color value=@@clr_txt@@>a uvidíte ju tu."

#+ Tooltip shown when hovering over the radio_stream button.

	key[]: "radio_hint"
	val[]: "Upravte <color value=@@clr_sel@@>live_streams.sii <color value=@@clr_txt@@>v zložke <color value=@@clr_sel@@>American Truck Simulator <color value=@@clr_txt@@>ktorú nájdete vo vašich <color value=@@clr_sel@@>Dokumentoch <color value=@@clr_txt@@>a počúvajte svoje obľúbené internetové rádio počas hrania!"

#+ Hint shown if no online radio streams are defined.

	key[]: "empty_radio_hint"
	val[]: "Ak si chcete pridať vlastnú hudbu a streamy na live rádiá, prosím pozrite si súbor <color value=@@clr_sel@@>readme.rtf <color value=@@clr_txt@@>v zložke  <color value=@@clr_sel@@>American Truck Simulator <color value=@@clr_txt@@> ktorú nájdete vo vašich <color value=@@clr_sel@@>Dokumentoch <color value=@@clr_txt@@>."
#@}

#+ Messages shown as part of the tutorial.
