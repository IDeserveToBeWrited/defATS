	key[]: "aca_msg_book1_2_03_mirror_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/front_mirror_possition_1.mat width=336 height=189 color=FFFFFFFF></align><offset vshift=189>"

	key[]: "aca_msg_book1_2_03_mirror_msg_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/front_mirror.mat width=336 height=189 color=FFFFFFFF></align><offset vshift=189>"

	key[]: "aca_msg_book1_2_03_check1_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/where_to_park.mat width=336 height=248 color=FFFFFFFF></align><offset vshift=248>"
#!}

#+ Book 1 Scenario 2_03
#@{

#### 2_03 common
	key[]: "aca_scenario_book1_2_03_title"
	val[]: "Parant a prop d'un obstacle"

	key[]: "aca_scenario_book1_2_03_desc"
	val[]: "En aquest escenari parlarem del mirall frontal, de la seva localització i de com usar-lo adequadament per parar-se a prop d'un obstacle."

#### 2_03 goal

	key[]: "aca_goal_book1_2_03_mirror"
	val[]: "Comprova el mirall frontal"

	key[]: "aca_goal_book1_2_03_check1"
	val[]: "Para't a prop de l'obstacle"

	key[]: "aca_goal_book1_2_03_mirror_msg"
	val[]: "Entendre la seva funció"
#!{
	key[]: "aca_goal_book1_2_03_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_03_check1_msg"
	val[]: "@@aca_goal_book1_1_03_forward@@"

	key[]: "aca_goal_book1_2_03_end"
	val[]: "@@aca_goal_book1_2_01_end@@"


 #!}
#### 2_03 msg - intro

	key[]: "aca_msg_book1_2_03_cutscene1"
	val[]: "Els camions tenen un gran angle mort a la part frontal de la tractora. És fàcil perdre de vista un vianant o un cotxe en aquesta àrea, per això els camions van equipats amb un mirall frontal que pot veure's a través del parabrisa."

	key[]: "aca_msg_book1_2_03_cutscene2"
	val[]: "El mirall frontal està dissenyat per donar al conductor una vista d'aquest angle mort.<br>És una eina essencial per evitar xocar amb cap obstacle quan maniobres en llocs estrets."

	key[]: "aca_msg_book1_2_03_cutscene3"
	val[]: "Comença a conduir, procedeix cap a la barrera del davant teu, llavors vés reduint la velocitat a mesura que t'hi aproximis.<br>No treguis la vista del mirall frontal."

	key[]: "aca_msg_book1_2_03_cutscene4"
	val[]: "Para't entre la línia i l'obstacle."

#### 2_03 Driving Instructions

	key[]: "aca_msg_book1_2_03_mirror"
	val[]: "@@aca_msg_book1_2_03_mirror_img@@<br> En aquest escenari, aprendrem a usar el mirall frontal indicat en el dibuix.<br><br><font face=/font/big_bold.font>Mira a través de la part superior del parabrisa per veure'l. </font>"

	key[]: "aca_msg_book1_2_03_mirror_msg"
	val[]: "@@aca_msg_book1_2_03_mirror_msg_img@@<br>El mirall frontal et permet veure què hi ha a l'angle mort del davant del camió. Et pot ajudar a tenir una conducció més segura i precisa.<br><br>Si no estàs satisfet amb els ajustos, obre \"@@adjust_link_t@@\" (hi pots accedir al menú de pausa) per ajustar-lo al teu gust.<br><br><font face=/font/big_bold.font>Prem @@imv_nrm_activate@@ per continuar. </font>"

	key[]: "aca_msg_book1_2_03_start"
	val[]: "Davant del camió hi ha un espai marcat. Hauràs vist que hi ha un obstacle just després d'aquest espai. Quan hi estiguis a prop, condueix molt a poc a poc i controla la distància amb l'obstacle en el mirall frontal.<br><br><font face=/font/big_bold.font>Prepara't per conduir. </font>"

	key[]: "aca_msg_book1_2_03_start_fail"
	val[]: "El camió encara no està llest per moure's, potser oblides quelcom?<br><br>El motor està engegat? Has alliberat el fre d'estacionament?"

	key[]: "aca_msg_book1_2_03_check1_msg"
	val[]: "<font face=/font/big_bold.font>Vés endavant fins a la zona d'aparcament. </font>"

	key[]: "aca_msg_book1_2_03_check1"
	val[]: "@@aca_msg_book1_2_03_check1_img@@<br><font face=/font/big_bold.font>Atura la part frontal del camió entre l'obstacle i la marca pintada a terra. </font>"
#!{
	key[]: "aca_msg_book1_2_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

# Book 1 Scenario 2_04 formatting
#!{
	key[]: "aca_msg_book1_2_04_mirror_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/side_mirror_posisiton_1.mat width=336 height=189 color=FFFFFFFF></align><offset vshift=189>"

	key[]: "aca_msg_book1_2_04_start_img"
	val[]: "<align vstyle=top hstyle=center><img src=/material/ui/academy/book/book1/illustration/side_mirror.mat width=336 height=189 color=FFFFFFFF></align><offset vshift=189>"
#!}

#+ Book 1 Scenario 2_04
#@{

#### 2_04 common
	key[]: "aca_scenario_book1_2_04_title"
	val[]: "Aparcar a prop d'un obstacle"

	key[]: "aca_scenario_book1_2_04_desc"
	val[]: "En aquest escenari, aprendrem a aparcar a prop d'una vorada utilitzant el mirall de vista lateral."

#### 2_04 goal

	key[]: "aca_goal_book1_2_04_mirror"
	val[]: "Comprova el mirall de vista lateral"

	key[]: "aca_goal_book1_2_04_check1"
	val[]: "Conduir a prop de la vorada"

#!{
	key[]: "aca_goal_book1_2_04_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_04_forward"
	val[]: "@@aca_goal_book1_1_03_forward@@"


	key[]: "aca_goal_book1_2_04_check2"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_2_04_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

 #!}

#### 2_04 msg - intro text

	key[]: "aca_msg_book1_2_04_cutscene1"
	val[]: "El mirall de vista lateral és una altra eina que t'ajudarà a maniobrar amb seguretat. Està ubicat a la part de dalt de la porta del passatger."

	key[]: "aca_msg_book1_2_04_cutscene2"
	val[]: "Aquests taulons de fusta representen una vorada. Hi has d'aparcar al costat. <br>Gira cap a la vorada per posar el camió en una bona posició, alineat amb la zona d'aparcament."

	key[]: "aca_msg_book1_2_04_cutscene3"
	val[]: "Minora la marxa abans de la vorada i gira cap a la zona d'aparcament. Mentre adreces el camió, pots usar el mirall de vista lateral per saber la distància entre el camió i la vorada."

	key[]: "aca_msg_book1_2_04_cutscene4"
	val[]: "Para a la zona d'aparcament i assegura el camió."

#### 2_04 Driving Instructions

	key[]: "aca_msg_book1_2_04_mirror"
	val[]: "@@aca_msg_book1_2_04_mirror_img@@<br><font face=/font/big_bold.font>Mira cap a la finestra del costat del passatger. Allà hi pots veure el mirall de vista lateral.</font>@@aca_goal_tip@@ Has d'estar dins el vehicle."

	key[]: "aca_msg_book1_2_04_start"
	val[]: "@@aca_msg_book1_2_04_start_img@@<br>El mirall de vista lateral cobreix l'àrea del costat del passatger, una zona que el conductor no pot veure. És un dels angles morts més problemàtics del camió. Si la inclinació del mirall no et satisfà, ajusta'l a \"@@adjust_link_t@@\".<br><br><font face=/font/big_bold.font>Prepara't per començar. </font>"

	key[]: "aca_msg_book1_2_04_start_fail"
	val[]: "El camió encara no està llest per moure's, potser oblides quelcom?<br><br>El motor està engegat? Has alliberat el fre d'estacionament?"

	key[]: "aca_msg_book1_2_04_forward"
	val[]: "Més endavant hi ha una línia de taulons que representen una vorada. Al final d'aquesta vorada hi ha l'aparcament. Has d'anar cap allà.<br><br><font face=/font/big_bold.font>Comença quan estiguis llest. </font>"

	key[]: "aca_msg_book1_2_04_check1"
	val[]: "Gira a prop de la vorada. Usa el mirall lateral per saber la teva posició en relació amb la vorada, però també vigila de no passar per sobre de cap con.<br><br><font face=/font/big_bold.font>Condueix cap a la vorada i cap a l'aparcament. </font>"
#!{
	key[]: "aca_msg_book1_2_04_check2"
	val[]: "@@aca_msg_book1_2_01_stop@@"
#!}
	key[]: "aca_msg_book1_2_04_end"
	val[]: "<font face=/font/big_bold.font>Assegura el camió i para el motor.</font>@@aca_goal_tip@@ Pots utilitzar les diferents vistes interiors per facilitar-te la visió dels miralls. A \"Opcions\" > \"Tecles i botons\" podràs veure o canviar els controls corresponents."
#@}

#+ Book 1 Scenario 2_05
#@{

#### 2_05 common
	key[]: "aca_scenario_book1_2_05_title"
	val[]: "Aparcar marxa enrere a prop d'un obstacle"

	key[]: "aca_scenario_book1_2_05_desc"
	val[]: "En aquest escenari, farem marxa enrere cap a un aparcament al costat d'una vorada."

#### 2_05 goal
	key[]: "aca_goal_book1_2_05_summary"
	val[]: "Instruccions"
#!{
	key[]: "aca_goal_book1_2_05_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_05_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

#!}
	key[]: "aca_goal_book1_2_05_backward"
	val[]: "Conduir marxa enrere a prop de la vorada"

	key[]: "aca_goal_book1_2_05_stop"
	val[]: "Aparcar el camió"



#### 2_05 msg - intro text

	key[]: "aca_msg_book1_2_05_cutscene1"
	val[]: "En aquest escenari, maniobrarem marxa enrere per aparcar al costat d'una vorada."

	key[]: "aca_msg_book1_2_05_cutscene2"
	val[]: "Vés marxa enrere cap a la vorada.<br>Has d'estar pendent del teu entorn quan fas marxa enrere, per tant fes servir els miralls."

	key[]: "aca_msg_book1_2_05_cutscene3"
	val[]: "A mesura que t'acostis a la vorada hauràs d'anar alineant el camió amb la zona d'aparcament. En fer marxa enrere, mira a banda i banda del camió."

	key[]: "aca_msg_book1_2_05_cutscene4"
	val[]: "Para a la zona d'aparcament i assegura el camió."

#### 2_05 Driving Instructions

	key[]: "aca_msg_book1_2_05_start"
	val[]: "L'àrea d'aparcament està darrere teu i pel costat del passatger. Utilitza els miralls per anar-hi.<br><br><font face=/font/big_bold.font>Prepara't per començar. </font>"

	key[]: "aca_msg_book1_2_05_backward"
	val[]: "Recorda d'utilitzar els miralls per verificar el teu entorn abans de moure el camió.<br><br><font face=/font/big_bold.font>Comença a fer marxa enrere cap a la vorada. </font>"

	key[]: "aca_msg_book1_2_05_stop"
	val[]: "Continua vigilant el teu voltant mentre vas enrere cap a l'aparcament.<br><br><font face=/font/big_bold.font>Para't a la zona indicada. </font>"
#!{
	key[]: "aca_msg_book1_2_05_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 2_06
#@{

#### 2_06 common
	key[]: "aca_scenario_book1_2_06_title"
	val[]: "Prova d'entrenament avançat"

	key[]: "aca_scenario_book1_2_06_desc"
	val[]: "L'últim escenari d'aquest capítol consisteix a conduir per una pista d'entrenament avançat. Hauràs de fer servir les habilitats que has après!"

#### 2_06 goal
