	key[]: "aca_msg_book3_train_check2"
	val[]: "Gira cap al magatzem i evita els obstacles, llavors segueix envoltant l'oficina."

	key[]: "aca_msg_book3_train_check3"
	val[]: "Segueix recte."

	key[]: "aca_msg_book3_train_check4"
	val[]: "Procedeix per l'itinerari marcat pels cons."

	key[]: "aca_msg_book3_train_check5"
	val[]: "Continua conduint cap a la zona d'aparcament final."

