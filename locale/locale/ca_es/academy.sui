	key[]: "aca_msg_book3_correcting_90_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}



#+ Book 3 Scenario parallel
#@{

#### parallel common
	key[]: "aca_scenario_book3_parallel_title"
	val[]: "Aparcament en paral·lel"

	key[]: "aca_scenario_book3_parallel_desc"
	val[]: "En aquest escenari, aparcarem en paral·lel amb doble remolc en una calçada."

#### parallel goal

	key[]: "aca_goal_book3_parallel_check1"
	val[]: "Marxa enrere"

#!{
	key[]: "aca_goal_book3_parallel_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_parallel_end"
	val[]: "@@aca_goal_book3_sup_end@@"

	key[]: "aca_goal_book3_parallel_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_parallel_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
#### parallel msg - intro text

	key[]: "aca_msg_book3_parallel_cutscene1"
	val[]: "Segueix pel revolt cap a la calçada. Allà trobaràs una plaça d'aparcament lliure per a tu."

	key[]: "aca_msg_book3_parallel_cutscene2"
	val[]: "Entra a l'aparcament i continua un tros endavant. Això ajudarà a apropar els remolcs al lloc a on han d'anar."

	key[]: "aca_msg_book3_parallel_cutscene3"
	val[]: "Segueix cap a fora de l'aparcament, una mica més enllà fins a tenir prou espai per maniobrar."

	key[]: "aca_msg_book3_parallel_cutscene4"
	val[]: "Utilitza el remolc davanter per fer girar el remolc posterior i portar-lo a lloc. Necessitaràs anticipar els teus moviments per assegurar-te que els remolcs acaben a on tu vols."

	key[]: "aca_msg_book3_parallel_cutscene5"
	val[]: "Potser hauràs d'anar endavant i endarrere unes quantes vegades per deixar-ho tot al seu lloc."

	key[]: "aca_msg_book3_parallel_cutscene6"
	val[]: "Quan estiguis satisfet amb l'alineat amb el voral, centra la combinació a la plaça d'aparcament i assegura el vehicle."

#### parallel Driving Instructions

#!{
	key[]: "aca_msg_book3_parallel_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_parallel_forward"
	val[]: "Segueix endavant, busca el teu aparcament i posiciona el vehicle per fer marxa enrere."

	key[]: "aca_msg_book3_parallel_check1"
	val[]: "Recula i entra a l'aparcament."

	key[]: "aca_msg_book3_parallel_stop"
	val[]: "Para't a l'àrea indicada."

	key[]: "aca_msg_book3_parallel_end"
	val[]: "Assegura el camió i para el motor."
#@}




