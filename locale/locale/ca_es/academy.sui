#+ Book 1 Scenario 3_05
#@{

#### 3_05 common
	key[]: "aca_scenario_book1_3_05_title"
	val[]: "Fer marxa enrere amb un remolc"

	key[]: "aca_scenario_book1_3_05_desc"
	val[]: "En aquest escenari, provaràs de fer marxa enrere amb un remolc per primera vegada. És una prova bastant simple, però encara necessitaràs maniobrar correctament per col·locar el remolc en la posició adequada."

	#### 3_05 goal



	key[]: "aca_goal_book1_3_05_check_con"
	val[]: "Marxa enrere cap al remolc"

	key[]: "aca_goal_book1_3_05_connect"
	val[]: "Connectar el remolc"

	key[]: "aca_goal_book1_3_05_park_br_off"
	val[]: "Alliberar el fre d'estacionament"

	key[]: "aca_goal_book1_3_05_b_trailer"
	val[]: "Alinea't amb l'aparcament"

	key[]: "aca_goal_book1_3_05_check1"
	val[]: "Marxa enrere cap a l'àrea d'aparcament"

	key[]: "aca_goal_book1_3_05_check2"
	val[]: "Alinea't amb l'aparcament"
#!{
	key[]: "aca_goal_book1_3_05_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_05_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_05_park_br_on"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

	key[]: "aca_goal_book1_3_05_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_05_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"


#!}
#### 3_05 msg - intro text

	key[]: "aca_msg_book1_3_05_cutscene01"
	val[]: "Posa a prova la teva destresa fent marxa enrere amb un remolc. És més fàcil del que sembla, només has de ser pacient."

	key[]: "aca_msg_book1_3_05_cutscene02"
	val[]: "Comença anant enrere i posa la tractora en línia amb el remolc."

	key[]: "aca_msg_book1_3_05_cutscene03"
	val[]: "Assegura't d'estar ben alineat, altrament no seràs capaç de fer la connexió. Si no ho aconsegueixes, sempre pots anar endavant i tornar-ho a provar."

	key[]: "aca_msg_book1_3_05_cutscene04"
	val[]: "La cinquena roda de la tractora bloquejarà el pern d'acoblament del remolc."

	key[]: "aca_msg_book1_3_05_cutscene05"
	val[]: "Aplica el fre d'estacionament i connecta el remolc. A la vida real, hauries de sortir del camió per connectar l'aire i els cables elèctrics i replegar les potes del remolc, però ara, nosaltres ho farem per tu."

	key[]: "aca_msg_book1_3_05_cutscene05b"
	val[]: "Continua endavant i segueix per la dreta les indicacions de la carretera, sense desviar-te del carril marcat."

	key[]: "aca_msg_book1_3_05_cutscene05c"
	val[]: "T'has d'alinear amb l'aparcament que hi ha darrere teu. Un cop ho hagis aconseguit, podràs començar a retrocedir."

	key[]: "aca_msg_book1_3_05_cutscene06"
	val[]: "@@aca_msg_book1_3_05_cutscene06_img@@<br>El remolc girarà sempre <color value=@@clr_sel@@>en el sentit oposat <color value=@@clr_txt@@>al de la tractora."

	key[]: "aca_msg_book1_3_05_cutscene07"
	val[]: "@@aca_msg_book1_3_05_cutscene07_img@@<br>Per girar el remolc, necessitaràs maniobrar la tractora en la direcció<color value=@@clr_sel@@> oposada <color value=@@clr_txt@@>a la que vols portar el remolc."

	key[]: "aca_msg_book1_3_05_cutscene08"
	val[]: "@@aca_msg_book1_3_05_cutscene08_img@@<br>Per redreçar el remolc, gira la tractora <br><color value=@@clr_sel@@>en el mateix sentit<color value=@@clr_txt@@> que el remolc."

	key[]: "aca_msg_book1_3_05_cutscene09"
	val[]: "Mantén el remolc encarat cap a l'àrea marcada, llavors intenta mantenir la tractora alineada amb el remolc. Hauràs de fer petites correccions constantment."

	key[]: "aca_msg_book1_3_05_cutscene10"
	val[]: "Corregeix les desviacions amb petits girs del volant tan aviat com es produeixin. Si gires massa, podries acabar fora del teu camí."

	key[]: "aca_msg_book1_3_05_cutscene11"
	val[]: "Para a l'àrea indicada. Assegura el camió i apaga el motor."

#### 3_05 Driving Instructions

	key[]: "aca_msg_book1_3_05_start"
	val[]: "Darrere teu a la dreta, veuràs un remolc. La teva primera tasca serà anar cap a ell fent marxa enrere.<br><br><font face=/font/big_bold.font>Prepara el camió per fer marxa enrere. </font>"

	key[]: "aca_msg_book1_3_05_backward"
	val[]: "<font face=/font/big_bold.font>Comença anant enrere cap al remolc. </font>"

	key[]: "aca_msg_book1_3_05_check_con"
	val[]: "Situa el camió de tal manera que quedi en línia amb el remolc. La cinquena roda ha de capturar el pern d'acoblament. Vés endavant si necessites reintentar-ho.<br><br><font face=/font/big_bold.font>Continua anant enrere fins que notis la connexió. </font>"

	key[]: "aca_msg_book1_3_05_park_br_on"
	val[]: "La cinquena roda ha capturat el pern d'acoblament i ara estàs llest per finalitzar l'operació.<br><br><font face=/font/big_bold.font>Activa el fre d'estacionament. </font>"

	key[]: "aca_msg_book1_3_05_connect"
	val[]: "<font face=/font/big_bold.font> Prem @@imv_nrm_attach@@ per connectar el remolc. </font>"

	key[]: "aca_msg_book1_3_05_park_br_off"
	val[]: "Ara ja tens connectat amb seguretat el remolc i la tractora. L'aire i els cables elèctrics estan connectats. Les potes del remolc estan enlaire.<br><br><font face=/font/big_bold.font>Allibera el fre d'estacionament. </font>"

	key[]: "aca_msg_book1_3_05_b_trailer"
	val[]: "Per alinear-te amb l'aparcament que tens a l'esquerra, avança una mica i gira cap a la dreta. Guia't amb les marques del terra.<br><br><font face=/font/big_bold.font>Mou-te i alinea't amb la zona d'aparcament. </font>"

	key[]: "aca_msg_book1_3_05_check1"
	val[]: "Una vegada situïs el remolc i la tractora relativament alineats amb l'aparcament, pots començar a retrocedir.<br><br><font face=/font/big_bold.font>Inicia la maniobra marxa enrere. </font>"

	key[]: "aca_msg_book1_3_05_check2"
	val[]: "Recorda que el remolc girarà en direcció oposada a com giris la tractora. Un petit gir del volant pot resultar en un moviment considerable del remolc. <br><br><font face=/font/big_bold.font>Continua retrocedint amb el remolc. </font>"
#!{
	key[]: "aca_msg_book1_3_05_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_05_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

#@}

#+ Book 1 Scenario 3_06
#@{

#### 3_06 common
	key[]: "aca_scenario_book1_3_06_title"
	val[]: "Aparcar en un espai ajustat"

	key[]: "aca_scenario_book1_3_06_desc"
	val[]: "En aquest escenari, aparcarem en un espai ajustat.<br><br>Hauràs de maniobrar per alinear el remolc amb la plaça d'aparcament."

#### 3_06 goal
#!{
	key[]: "aca_goal_book1_3_06_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

