#### finex common

	key[]: "aca_scenario_book3_finex_title"
	val[]: "Examen final"

	key[]: "aca_scenario_book3_finex_desc"
	val[]: "En aquest escenari, verificarem les teves noves habilitats en una prova pensada per examinar la teva precisió i destresa conduint amb doble remolc."

#### finex goal

	key[]: "aca_goal_book3_finex_check0"
	val[]: "Marxa enrere"

	key[]: "aca_goal_book3_finex_check1"
	val[]: "Entra a la pista d'entrenament"

	key[]: "aca_goal_book3_finex_check2"
	val[]: "Augmenta la velocitat"

	key[]: "aca_goal_book3_finex_check22"
	val[]: "Prepara't per frenar"

	key[]: "aca_goal_book3_finex_speed"
	val[]: "Velocitat insuficient"

