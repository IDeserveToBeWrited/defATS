#### 2_06 msg - intro text

	key[]: "aca_msg_book1_2_06_cutscene01"
	val[]: "Per l'escenari final d'aquest capítol, conduirem per una pista de proves variada."

	key[]: "aca_msg_book1_2_06_cutscene02"
	val[]: "El primer obstacle és un eslàlom amb barreres. Condueix per aquest eslàlom i recorda d'usar els miralls."

	key[]: "aca_msg_book1_2_06_cutscene04"
	val[]: "El següent obstacle, una paella. Fes un gir per l'exterior i no et donarà maldecaps."

	key[]: "aca_msg_book1_2_06_cutscene05"
	val[]: "Aquí davant el camí es fa més estret. Procedeix amb cautela i ajuda't amb el mirall lateral."

	key[]: "aca_msg_book1_2_06_cutscene06"
	val[]: "A continuació hi ha una sèrie de girs senzills de 90 graus."

	key[]: "aca_msg_book1_2_06_cutscene08"
	val[]: "En aquesta secció hauràs de fer marxa enrere. Tingue-ho en compte en aproximar-te a les barreres del davant."

	key[]: "aca_msg_book1_2_06_cutscene09"
	val[]: "Segueix les marques cap enrere, pel revolt."

	key[]: "aca_msg_book1_2_06_cutscene10"
	val[]: "Vés enrere fins a les barreres, llavors para't i procedeix endavant, per la dreta."

	key[]: "aca_msg_book1_2_06_cutscene11"
	val[]: "Aquest tram a través dels cons és molt estret. Condueix a poc a poc i fes servir els miralls per orientar-te mentre hi passes."

	key[]: "aca_msg_book1_2_06_cutscene13"
	val[]: "Al davant hi ha una sèrie de revolts a dretes i a esquerres de 90 graus."

	key[]: "aca_msg_book1_2_06_cutscene15"
	val[]: "Et pots trobar trens en aquest pas a nivell. Si és el cas, para i espera't. Després, gira a la dreta cap a la via de servei."

	key[]: "aca_msg_book1_2_06_cutscene16"
	val[]: "Gira a l'esquerra i segueix per l'autopista. Després del gir, pots agafar més velocitat."

	key[]: "aca_msg_book1_2_06_cutscene18"
	val[]: "Uns quants revolts més per dins el poble i ja hauràs arribat a la teva destinació!"

	key[]: "aca_msg_book1_2_06_cutscene19"
	val[]: "Apropa't a les barreres del davant i prepara't per aparcar a la dreta."

	key[]: "aca_msg_book1_2_06_cutscene20"
	val[]: "Retrocedeix cap a l'aparcament. Un cop allà, apaga el motor i assegura el camió."

#### 2_06 Driving Instructions



	key[]: "aca_msg_book1_2_06_forward"
	val[]: "Davant teu hi ha un eslàlom fet amb barreres.<br><br><font face=/font/big_bold.font>Condueix per l'eslàlom.</font>"

	key[]: "aca_msg_book1_2_06_forward2"
	val[]: "<font face=/font/big_bold.font>Segueix el recorregut per la paella. </font>"

	key[]: "aca_msg_book1_2_06_check1"
	val[]: "El camí es fa més estret. Utilitza el mirall lateral per ajudar-te a passar-hi.<br><br><font face=/font/big_bold.font>Procedeix amb cura. </font>"

	key[]: "aca_msg_book1_2_06_check2"
	val[]: "Després del revolt, n'hi ha un altre de 90 graus.<br><br><font face=/font/big_bold.font>Ajusta la teva velocitat.</font>"

	key[]: "aca_msg_book1_2_06_check3"
	val[]: "Davant teu hi ha uns quants girs senzills més, segueix i modifica la velocitat segons necessitis.<br><br><font face=/font/big_bold.font>Continua endavant. </font>"

	key[]: "aca_msg_book1_2_06_check4"
	val[]: "El proper tram s'ha de recórrer fent marxa enrere. Para a les barreres del davant, per tot seguit retrocedir per la dreta.<br><br><font face=/font/big_bold.font>Para't a les barreres.</font>"

	key[]: "aca_msg_book1_2_06_check5"
	val[]: "Retrocedeix pel camí de la dreta.<br><br><font face=/font/big_bold.font>Fes marxa enrere. </font>"

	key[]: "aca_msg_book1_2_06_reverse"
	val[]: "Segueix el camí fent els revolts.<br><br><font face=/font/big_bold.font>Segueix enrere.</font>"

	key[]: "aca_msg_book1_2_06_check6"
	val[]: "Darrere teu a l'esquerra hi ha algunes barreres. <br><br><font face=/font/big_bold.font>Gira cap a les barreres i estigues a punt per parar.</font>"

	key[]: "aca_msg_book1_2_06_check7"
	val[]: "Para i canvia a marxa endavant, llavors continua per la dreta. <br><br><font face=/font/big_bold.font>Segueix endavant. </font>"

	key[]: "aca_msg_book1_2_06_check8"
	val[]: "Davant teu hi ha un tram estret en ziga-zaga. Condueix amb compte i fes servir els miralls si ho necessites.<br><br><font face=/font/big_bold.font>Segueix el camí marcat amb cons. </font>"

	key[]: "aca_msg_book1_2_06_check9"
	val[]: "A continuació hi ha diferents girs de 90 graus. Assegura't d'aproximar-te a cada revolt per l'exterior.<br><br><font face=/font/big_bold.font>Segueix conduint. </font>"

	key[]: "aca_msg_book1_2_06_check10"
	val[]: "Observa el pas a nivell mentre t'hi apropes. Es poden activar els senyals indicant l'imminent pas d'un tren.<br><br><font face=/font/big_bold.font>Procedeix amb precaució.</font>"

	key[]: "aca_msg_book1_2_06_check11"
	val[]: "El revolt que porta a la via de servei està parcialment bloquejada per un obstacle, així que queda't a l'esquerra per deixar-te més espai en girar.<br><br><font face=/font/big_bold.font>Fes el revolt. </font>"

	key[]: "aca_msg_book1_2_06_check12"
	val[]: "Pots obeir o ignorar el senyal de Stop. L'àrea està tancada per a la nostra prova.<br><br><font face=/font/big_bold.font>Gira a l'esquerra.</font>"

	key[]: "aca_msg_book1_2_06_check13"
	val[]: "Aquí pots agafar més velocitat, però a la propera intersecció hauràs de girar.<br><br><font face=/font/big_bold.font>Segueix endavant per la pista. </font>"

	key[]: "aca_msg_book1_2_06_check14"
	val[]: "Entra al poble girant a l'esquerra, llavors fes dos girs a esquerres més i arriba a l'última zona.<br><br><font face=/font/big_bold.font>Condueix per dins el poble.</font>"

	key[]: "aca_msg_book1_2_06_check15"
	val[]: "A un costat d'aquesta zona hi ha unes barreres. Vés-hi. <br><br><font face=/font/big_bold.font>Para't davant de les barreres. </font>"

	key[]: "aca_msg_book1_2_06_check16"
	val[]: "Darrere teu a la dreta, hi ha una plaça d'aparcament.<br><br><font face=/font/big_bold.font>Retrocedeix cap a l'aparcament. </font>"
#!{
	key[]: "aca_msg_book1_2_06_check17"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_06_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_2_06_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

#@}

#+ Book 1 Scenario 2_08
#@{

#### 2_08 common
	key[]: "aca_scenario_book1_2_08_title"
	val[]: "Pista senzilla d'entrenament"

	key[]: "aca_scenario_book1_2_08_desc"
	val[]: "En aquest escenari, agafarem les habilitats que has après fins ara i les posarem a prova en una senzilla pista d'entrenament."

#### 2_08 goal
#!{
	key[]: "aca_goal_book1_2_08_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_08_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_2_08_end"
	val[]: "@@aca_goal_book1_2_01_end@@"
#!}
	key[]: "aca_goal_book1_2_08_forward"
	val[]: "Entra a la pista"

	key[]: "aca_goal_book1_2_08_check1"
	val[]: "Paella ampla"

	key[]: "aca_goal_book1_2_08_check2"
	val[]: "Passar per l'eslàlom"

	key[]: "aca_goal_book1_2_08_check3"
	val[]: "Paella estreta"

	key[]: "aca_goal_book1_2_08_check4"
	val[]: "Revolt estret"

	key[]: "aca_goal_book1_2_08_check6"
	val[]: "Tram tècnic"

	key[]: "aca_goal_book1_2_08_check7"
	val[]: "Tram obert"



#### 2_08 msg - intro text

	key[]: "aca_msg_book1_2_08_cutscene1"
	val[]: "En aquest escenari, agafarem la tractora i efectuarem un trajecte curt per veure com condueixes amb les habilitats que has adquirit.<br>Hi ha diversos tipus i combinacions de revolts a la pista. Això no és una cursa i no hi ha temps. Sigues pacient i adapta la teva velocitat als revolts i obstacles que et trobis."

	key[]: "aca_msg_book1_2_08_cutscene2"
	val[]: "Entra a la pista per aquesta ampla paella."

	key[]: "aca_msg_book1_2_08_cutscene3"
	val[]: "Seguidament, trobaràs una sèrie d'obstacles que et guiaran cap a un irregular eslàlom."

	key[]: "aca_msg_book1_2_08_cutscene4"
	val[]: "Després de completar uns quants revolts senzills de 90 graus, et trobaràs una paella estreta. És important preparar-se adequadament, per completar la paella i per entrar sense problemes al tram següent."

	key[]: "aca_msg_book1_2_08_cutscene5"
	val[]: "Vés amb compte amb els cons mentre passes per aquest revolt llarg, ja que la visibilitat més enllà del capó és limitada."

	key[]: "aca_msg_book1_2_08_cutscene6"
	val[]: "Unes altres barreres et guiaran cap a un eslàlom ample."

	key[]: "aca_msg_book1_2_08_cutscene7"
	val[]: "La pista s'obre una mica, però no corris. Unes poques corbes fàcils més i hauràs acabat."

	key[]: "aca_msg_book1_2_08_cutscene8"
	val[]: "Para a l'àrea indicada i assegura el camió."


#### 2_08 Driving Instructions

	key[]: "aca_msg_book1_2_08_start"
	val[]: "Per completar aquest escenari satisfactòriament no has de xocar, sortir-te de la pista o tocar cap con.<br><br><font face=/font/big_bold.font>Prepara't per sortir. </font>"

	key[]: "aca_msg_book1_2_08_forward"
	val[]:"<font face=/font/big_bold.font>Vés endavant per la paella ampla i entra a la pista. </font>"

	key[]: "aca_msg_book1_2_08_check1"
	val[]: "<font face=/font/big_bold.font>Completa la paella. </font>"

	key[]: "aca_msg_book1_2_08_check2"
	val[]: "T'estàs aproximant a unes barreres que formen un eslàlom.<br><br><font face=/font/big_bold.font>Adequa la teva velocitat i segueix endavant.</font>"

	key[]: "aca_msg_book1_2_08_check3"
	val[]: "A continuació, tens dos revolts senzills de 90 graus seguits per una paella estreta. Vés a poc a poc.<br><br><font face=/font/big_bold.font>Continua per la paella estreta.</font>"

	key[]: "aca_msg_book1_2_08_check4"
	val[]: "Sortint de la paella, trobaràs un camí estret que fa corba. Has de passar separat de la barrera interior però vigilant de no tocar els cons que tens davant.<br><br><font face=/font/big_bold.font>Segueix fent el revolt. </font>"

	key[]: "aca_msg_book1_2_08_check6"
	val[]: "El camí del davant té algun revolt tècnic estret. Ajusta la teva velocitat i passa per aquesta part amb precaució.<br><br><font face=/font/big_bold.font>Segueix conduint. </font>"

	key[]: "aca_msg_book1_2_08_check7"
	val[]: "La propera secció és més oberta amb alguns revolts simples. No tinguis pressa.<br><br><font face=/font/big_bold.font>Continua endavant. </font>"
#!{
	key[]: "aca_msg_book1_2_08_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_2_08_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

 #!}

#@}

#+ Book 1 Scenario 2_09
#@{

#### 2_09 common
	key[]: "aca_scenario_book1_2_09_title"
	val[]: "Aparcament en paral·lel"

	key[]: "aca_scenario_book1_2_09_desc"
	val[]: "En aquest escenari, donarem una ullada a l'aparcament en paral·lel entre dos altres camions."

#### 2_09 goal

	key[]: "aca_goal_book1_2_09_stopmid"
	val[]: "Para a davant de la plaça d'aparcament"

	key[]: "aca_goal_book1_2_09_checkmirror"
	val[]: "Comprova la part del darrere amb els miralls"

	key[]: "aca_goal_book1_2_09_backward"
	val[]: "Fes marxa enrere cap a l'aparcament"

	key[]: "aca_goal_book1_2_09_stop"
	val[]: "Alinea el camió dins de l'aparcament"

#!{
	key[]: "aca_goal_book1_2_09_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_2_09_check1"
	val[]: "@@aca_goal_book1_1_03_forward@@"


	key[]: "aca_goal_book1_2_09_end"
	val[]: "@@aca_goal_book1_2_01_end@@"



 #!}
#### 2_09 msg - intro text

	key[]: "aca_msg_book1_2_09_cutscene1"
	val[]: "L'aparcament en paral·lel és una habilitat essencial que qualsevol camioner ha de conèixer.<br>Prepara't per començar."

	key[]: "aca_msg_book1_2_09_cutscene2"
	val[]: "Condueix cap a l'aparcament.<br>Posa atenció al teu voltant."

	key[]: "aca_msg_book1_2_09_cutscene3"
	val[]: "Alinea't amb el camió del davant de la teva plaça d'aparcament. No t'hi acostis massa, deixa una mica d'espai per maniobrar."

	key[]: "aca_msg_book1_2_09_cutscene4"
	val[]: "Gira considerablement cap a l'aparcament i fes marxa enrere."

	key[]: "aca_msg_book1_2_09_cutscene5"
	val[]: "Quan miris al mirall del costat del conductor, apunta cap a la vorada que hi ha al davant del camió posterior."

	key[]: "aca_msg_book1_2_09_cutscene6"
	val[]: "Un cop el teu para-xocs davanter esquivi el camió del davant, pots començar a situar la part davantera del camió a l'aparcament, alineant el camió amb la vorada."

	key[]: "aca_msg_book1_2_09_cutscene7"
	val[]: "Adreça la direcció i centra el camió a la plaça d'aparcament.<br>Llavors para't i assegura el camió."

#### 2_09 Driving Instructions

	key[]: "aca_msg_book1_2_09_start"
	val[]: "Aquí al davant hi ha uns camions estacionats. Hauràs d'aparcar a l'espai lliure que hi ha. <br><br><font face=/font/big_bold.font>Prepara't per començar. </font>"

	key[]: "aca_msg_book1_2_09_check1"
	val[]: "Recorda't d'estar a l'aguait de què hi ha al teu voltant. Fes un bon ús dels miralls mentre maniobris. <br><br><font face=/font/big_bold.font>Condueix endavant. </font>"

	key[]: "aca_msg_book1_2_09_stopmid"
	val[]: "<color value=@@clr_white@@>Vés més enllà de la plaça d'aparcament, a la zona marcada. Des d'allà podràs començar la maniobra marxa enrere.<br><br><font face=/font/big_bold.font>Para't a la zona marcada. </font>"

	key[]: "aca_msg_book1_2_09_checkmirror"
	val[]: "Comprova el teu entorn localitzant obstacles i per estar segur que pots anar enrere.<br><br><font face=/font/big_bold.font>Mira el mirall del costat del passatger. </font>"

	key[]: "aca_msg_book1_2_09_backward"
	val[]: "Gira les rodes i vés enrere cap a l'aparcament.<br><br><font face=/font/big_bold.font>Comença a fer marxa enrere. </font>"

	key[]: "aca_msg_book1_2_09_stop"
	val[]: "Comença a adreçar el camió quan sigui apropiat. No pugis a sobre de la vorada!<br><br><font face=/font/big_bold.font>Alinea el camió amb l'aparcament. </font>"
#!{
	key[]: "aca_msg_book1_2_09_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

#+ Book 1 Scenario 3_01
#@{

#### 3_01 common
	key[]: "aca_scenario_book1_3_01_title"
	val[]: "Enganxar un remolc"

	key[]: "aca_scenario_book1_3_01_desc"
	val[]: "En aquest escenari, explicarem els conceptes bàsics per acoblar i desacoblar la tractora i un remolc."

#### 3_01 goal

	key[]: "aca_goal_book1_3_01_check_con"
	val[]: "Marxa enrere cap al remolc"

	key[]: "aca_goal_book1_3_01_connect"
	val[]: "Connectar el remolc"

	key[]: "aca_goal_book1_3_01_park_br_off"
	val[]: "Alliberar el fre d'estacionament"


	key[]: "aca_goal_book1_3_01_disc5"
	val[]: "Desconnectar el remolc"

	key[]: "aca_goal_book1_3_01_park_br_off2"
	val[]: "Desenganxar el remolc"

	key[]: "aca_goal_book1_3_01_disconnect"
	val[]: "Desenganxar el remolc"

	key[]: "aca_goal_book1_3_01_stop"
	val[]: "Parar a l'àrea indicada"
#!{
	key[]: "aca_goal_book1_3_01_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_01_check_discon"
	val[]: "@@aca_goal_book1_1_03_forward@@"

	key[]: "aca_goal_book1_3_01_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_01_park_br_off3"
	val[]: "@@aca_goal_book1_1_03_forward@@"
	key[]: "aca_goal_book1_3_01_parking_brake5"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

	key[]: "aca_goal_book1_3_01_park_br_on"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

	key[]: "aca_goal_book1_3_01_stop5"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_01_disc6"
	val[]: "@@aca_goal_book1_1_03_stop@@"

#!}
#### 3_01 msg - intro text

	key[]: "aca_msg_book1_3_01_cutscene1"
	val[]: "En aquest escenari, provarem de connectar i desconnectar un remolc per primera vegada. Prepara el camió i llavors vés enrere cap al remolc."

	key[]: "aca_msg_book1_3_01_cutscene2"
	val[]: "Enganxa el remolc, llavors estira'l endavant."

	key[]: "aca_msg_book1_3_01_cutscene3"
	val[]: "Para't a l'àrea indicada."

	key[]: "aca_msg_book1_3_01_cutscene4"
	val[]: "Desenganxa el remolc i vés endavant."

	key[]: "aca_msg_book1_3_01_cutscene5"
	val[]: "Aparca a l'àrea indicada i assegura el camió."


#### 3_01 Driving Instructions

	key[]: "aca_msg_book1_3_01_start"
	val[]: "En aquest escenari, aprendrem els procediments per enganxar i desenganxar la tractora i el remolc. El que veurem és una simplificació del que un camioner es trobaria a la vida real.<br><br><font face=/font/big_bold.font>Prepara't per començar. </font>"

	key[]: "aca_msg_book1_3_01_check_con"
	val[]: "Hi ha un remolc darrere la tractora. Fes marxa enrere lentament fins que la cinquena roda entri en contacte amb el pern d'acoblament. Ara, el camió ja està alineat i no necessites girar, simplement has d'anar enrere.<br><br><font face=/font/big_bold.font>Vés enrere a poc a poc fins que notis la connexió. </font>"

	key[]: "aca_msg_book1_3_01_park_br_on"
	val[]: "La cinquena roda s'ha acoblat al pern d'acoblament.<br><br><font face=/font/big_bold.font>Assegura el camió utilitzant el fre d'estacionament. </font>"

	key[]: "aca_msg_book1_3_01_connect"
	val[]: "A la vida real, la cinquena roda bloqueja automàticament el pern d'acoblament, llavors el camioner ha de sortir del vehicle per replegar les potes del remolc i connectar l'aire i els cables elèctrics. <br><br><font face=/font/big_bold.font>Per nosaltres, només prement @@imv_nrm_attach@@ es connectarà el remolc. </font>"

	key[]: "aca_msg_book1_3_01_park_br_off"
	val[]: "Ara que la tractora està connectada de forma segura al remolc, ja estàs a punt per moure't endavant. Tingues en compte que ara el teu vehicle és considerablement més llarg i pesat, cosa que requerirà noves habilitats. <br><br><font face=/font/big_bold.font>Allibera el fre d'estacionament i prepara't per anar endavant. </font>"

	key[]: "aca_msg_book1_3_01_check_discon"
	val[]: "Condueix cap endavant.<br><br><font face=/font/big_bold.font>Para't a l'àrea indicada. </font>"

	key[]: "aca_msg_book1_3_01_parking_brake5"
	val[]: "<font face=/font/big_bold.font>Aplica el fre d'estacionament. </font>"

	key[]: "aca_msg_book1_3_01_stop5"
	val[]: "<font face=/font/big_bold.font>Activa el fre d'estacionament. </font>"

	key[]: "aca_msg_book1_3_01_disc5"
	val[]: "Una altra vegada, a la vida real, el camioner hauria de sortir del vehicle, abaixar les potes del remolc, desconnectar l'aire i els cables elèctrics i alliberar el mecanisme de bloqueig de la cinquena roda.<br><br><font face=/font/big_bold.font>Simplificarem aquest procés. Prement @@imv_nrm_attach@@ es desconnectarà el remolc. </font>"

	key[]: "aca_msg_book1_3_01_park_br_off2"
	val[]: "<font face=/font/big_bold.font>Allibera el fre d'estacionament. </font>"

	key[]: "aca_msg_book1_3_01_park_br_off3"
	val[]: "Mou-te endavant i treu la tractora de sota el remolc.<br><br><font face=/font/big_bold.font>Para a la zona indicada. </font>"

	key[]: "aca_msg_book1_3_01_stop"
	val[]: "<font face=/font/big_bold.font>Para't a la zona indicada. </font>"
#!{
	key[]: "aca_msg_book1_3_01_end"
	val[]: "@@aca_msg_book1_2_01_end@@"


#!}

#@}

#+ Book 1 Scenario 3_02
#@{

#### 3_02 common
	key[]: "aca_scenario_book1_3_02_title"
	val[]: "Frenant amb un remolc"

	key[]: "aca_scenario_book1_3_02_desc"
	val[]: "En aquest escenari, experimentarem les sensacions de conduir i frenar portant un remolc."

#### 3_02 goal



	key[]: "aca_goal_book1_3_02_forward"
	val[]: "Mou-te"

	key[]: "aca_goal_book1_3_02_check1"
	val[]: "Baixa pel pendent"

	key[]: "aca_goal_book1_3_02_check2"
	val[]: "Arriba a 60 km/h (37 mph)"

	key[]: "aca_goal_book1_3_02_check3"
	val[]: "Frenada"
#!{
	key[]: "aca_goal_book1_3_02_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_02_end"
	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_02_start"
	val[]: "@@aca_goal_book1_2_01_start@@"
 #!}
#### 3_02 msg - intro text

	key[]: "aca_msg_book1_3_02_cutscene01"
	val[]: "En aquest escenari, agafarem el camió per fer un trajecte curt. Et permetrà experimentar la frenada en un descens suau portant un remolc. Prepara el camió i posa't en marxa."

	key[]: "aca_msg_book1_3_02_cutscene06"
	val[]: "Arriba almenys a una velocitat de 60 km/h (37 mph). Estigues a punt per quan arribis a la zona de frenada."

	key[]: "aca_msg_book1_3_02_cutscene08"
	val[]: "Comença a frenar. Assegura't de no tardar massa o podries xocar amb les barreres del davant!"

	key[]: "aca_msg_book1_3_02_cutscene10"
	val[]: "Aparca a l'àrea indicada, llavors assegura el camió i apaga el motor."


#### 3_02 Driving Instructions

	key[]: "aca_msg_book1_3_02_start"
	val[]: "En aquest trajecte, experimentarem la sensació de la frenada en baixada. El propòsit d'aquest exercici és que siguis conscient del pes que portes al darrere i com afecta a la distància de frenada del vehicle.<br><br><font face=/font/big_bold.font>Prepara't per començar. </font>"

	key[]: "aca_msg_book1_3_02_forward"
	val[]: "Comença a conduir, però recorda que has d'arribar almenys a una velocitat de 60 km/h (37 mph) <font face=/font/big_bold.font>després</font> del proper revolt.<br><br><font face=/font/big_bold.font>Condueix pel revolt. </font>"

	key[]: "aca_msg_book1_3_02_check1"
	val[]: "Fes el gir a la dreta, llavors accelera fins a 60 km/h (37 mph).<br><br><font face=/font/big_bold.font>Segueix conduint. </font>"

	key[]: "aca_msg_book1_3_02_check2"
	val[]: "<font face=/font/big_bold.font>Arriba almenys a una velocitat de 60 km/h (37 mph). </font>"

	key[]: "aca_msg_book1_3_02_check3"
	val[]: "Has arribat a la velocitat requerida.<br><br><font face=/font/big_bold.font>Para a les barreres del davant. </font>"
#!{
	key[]: "aca_msg_book1_3_02_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_02_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

#!}

#@}

