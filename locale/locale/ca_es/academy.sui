	key[]: "aca_book_book2_help"
	val[]: "<align hstyle=left vstyle=top><margin left=200 right=-30><color value=@@clr_white@@><font face=/font/big_bold.font>@@aca_book_book2_help_finish_requirments_t@@</font></margin></align><br><offset vshift=15><align hstyle=right vstyle=top right=-300><color value=@@clr_white@@><font face=/font/normal_bold.font><offset vshift=-2><img color=FFFFFFFF src=/material/ui/academy/icon/icon_success.mat width=22 height=22><offset vshift=2></font></align><align hstyle=left vstyle=top><margin left=200 right=-30><color value=@@clr_txt@@><font face=/font/normal.font>@@aca_book_book2_help_success_desc@@</font></margin></align><br><offset vshift=15><align hstyle=right vstyle=top right=-300><color value=@@clr_white@@><font face=/font/normal_bold.font><offset vshift=-2><img color=FFFFFFFF src=/material/ui/academy/icon/star.mat width=22 height=22><img color=FFFFFFFF src=/material/ui/academy/icon/star.mat width=22 height=22><img color=FFFFFFFF src=/material/ui/academy/icon/star_gray.mat width=22 height=22><offset vshift=2></font></align><align hstyle=left vstyle=top><margin left=200 right=-30><color value=@@clr_txt@@><font face=/font/normal.font>@@aca_book_book2_help_stars_desc@@</font></margin></align><br><offset vshift=15><align hstyle=left vstyle=top><margin left=200 right=-30><color value=@@clr_white@@><font face=/font/big_bold.font>@@aca_book_book2_help_conditions_t@@</font></margin></align><br><offset vshift=15><align hstyle=right vstyle=top right=-300><color value=@@clr_white@@><font face=/font/normal_bold.font><offset vshift=-2><img color=FFFFFFFF src=/material/ui/academy/icon/direction_change.mat width=22 height=22><offset vshift=2>@@aca_goal_direction_change@@</font></align><align hstyle=left vstyle=top><margin left=200 right=-30><color value=@@clr_txt@@><font face=/font/normal.font>@@aca_book_book2_help_direction_changes_desc@@</font></margin></align><br><offset vshift=15><align hstyle=right vstyle=top right=-300><color value=@@clr_white@@><font face=/font/normal_bold.font><offset vshift=-2><img color=FFFFFFFF src=/material/ui/academy/icon/time.mat width=22 height=22><offset vshift=2>@@aca_goal_time_limit@@</font></align><align hstyle=left vstyle=top><margin left=200 right=-30><color value=@@clr_txt@@><font face=/font/normal.font>@@aca_book_book2_help_time_desc@@</font></margin></align><br><offset vshift=15><align hstyle=right vstyle=top right=-300><color value=@@clr_white@@><font face=/font/normal_bold.font><offset vshift=-2><img color=FFFFFFFF src=/material/ui/academy/icon/camera.mat width=22 height=22><offset vshift=2>@@aca_goal_exterior_drive@@</font></align><align hstyle=left vstyle=top><margin left=200 right=-30><color value=@@clr_txt@@><font face=/font/normal.font>@@aca_book_book2_help_camera_desc@@</font></margin></align><br><offset vshift=15>"
#!}

#+ Book 2
#@{
	key[]: "aca_book_book2_help_title"
	val[]: "INFORMACIÓ DEL DOMINI DE LA CONDUCCIÓ DEL CAMIÓ" #+ Title of message box please keep in upper case where possible.

	key[]: "aca_book_book2_help_finish_requirments_t"
	val[]: "Requisits de finalització"

	key[]: "aca_book_book2_help_success_desc"
	val[]: "Els escenaris es completen en assolir totes les condicions d'aprovació"

	key[]: "aca_book_book2_help_stars_desc"
	val[]: "Guanyes estrelles en assolir correctament les bonificacions"

	key[]: "aca_book_book2_help_conditions_t"
	val[]: "Condicions"

	key[]: "aca_book_book2_help_direction_changes_desc"
	val[]: "Nombre màxim de canvis entre marxa endavant i marxa enrere"

	key[]: "aca_book_book2_help_time_desc"
	val[]: "Temps màxim permès per completar un escenari"

	key[]: "aca_book_book2_help_camera_desc"
	val[]: "Ús exclusiu de la càmera interior. Es poden usar les càmeres exteriors mentre estiguis parat"

	key[]: "aca_book_book2_completed_t"
	val[]: "DOMINI DE LA CONDUCCIÓ DEL CAMIÓ (PASSAT)"

	key[]: "aca_book_book2_completed"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Enhorabona!<br><br>Has completat correctament tots els passos del mòdul \"Domini de la conducció del camió\" i has obtingut recompenses per la teva carrera professional. Encara et pots exigir una mica més i guanyar més recompenses, completant les bonificacions.</font><br><br>"

	key[]: "aca_book_book2_maxrank_t"
	val[]: "DOMINI DE LA CONDUCCIÓ DEL CAMIÓ (COMPLETAT)"

	key[]: "aca_book_book2_maxrank"
	val[]: "@@aca_chapter3_finished_img@@<br><font face=/font/big.font>Enhorabona!<br><br>Has completat correctament tots els passos i bonificacions del mòdul \"Domini de la conducció del camió\" i has obtingut recompenses per la teva carrera professional.</font><br><br>"

#@}

#+ Book 2 intro
#@{

#### common
	key[]: "aca_scenario_book2_intro_title"
	val[]: "Domini de la conducció del camió"


#### intro text

	key[]: "aca_scenario_book2_book2_intro_cutscene1"
	val[]: "Benvingut/da una vegada més a la @@driving_academy@@!"

	key[]: "aca_scenario_book2_book2_intro_cutscene2"
	val[]: "Aquests escenaris representen el següent pas en el teu camí cap a la conducció professional de camions."

	key[]: "aca_scenario_book2_book2_intro_cutscene3"
	val[]: "Aquesta vegada no et guiarem per assolir les tasques, així que posa a treballar la teva habilitat i experiència."

	key[]: "aca_scenario_book2_book2_intro_cutscene4"
	val[]: "Trobaràs maniobres que et seran familiars, però aquesta vegada seran en entorns nous, fets per semblar-se més a la vida real."

	key[]: "aca_scenario_book2_book2_intro_cutscene5"
	val[]: "Hem afegit a la @@driving_academy@@ les condicions d'\"aprovació\" i les de \"bonificació\"."

	key[]: "aca_scenario_book2_book2_intro_cutscene6"
	val[]: "Com abans, has de completar cada escenari sense xocar amb qualsevol cosa, aparcant satisfactòriament i assegurant el camió..."

	key[]: "aca_scenario_book2_book2_intro_cutscene7"
	val[]: "... però ara també ho hauràs de fer dins del límit de temps i amb un nombre limitat de canvis entre conduir marxa endavant i marxa enrere."

	key[]: "aca_scenario_book2_book2_intro_cutscene8"
	val[]: "Les condicions de bonificació es poden aconseguir completant cada escenari amb uns requeriments encara més exigents..."

	key[]: "aca_scenario_book2_book2_intro_cutscene9"
	val[]: "... com ara límits de temps més estrictes, menys canvis de direcció i usant únicament la càmera interior."

	key[]: "aca_scenario_book2_book2_intro_cutscene10"
	val[]: "Completant tots els escenaris, et pots considerar un camioner expert i preparat pel següent repte a la carretera.<br><br>Per un desafiament més gran, completa totes les bonificacions de cada escenari. Llavors seràs una veritable estrella de la conducció de camions!"


#@}



#+ Book 2 zero
#@{
#### zero common
	key[]: "aca_scenario_book2_zero_title"
	val[]: "Tutorial"

	key[]: "aca_scenario_book2_zero_desc"
	val[]: "En aquest tutorial, t'ajudarem a familiaritzar-te amb les noves característiques del \"Domini de la conducció del camió\"."


#### zero info msg1

	key[]: "aca_msg_book2_scenario_zero1_title"
	val[]: "Domini de la conducció del camió"

	key[]: "aca_msg_book2_scenario_zero1"
	val[]: "En començar cada escenari, veuràs una finestra mostrant un <color value=@@clr_sel@@>\"Informe de l'escenari\"<color value=@@clr_txt@@>. Et proporcionarà informació sobre les noves condicions d'aprovació i de bonificació per l'escenari. <br><br>Les condicions d'aprovació s'han d'assolir per completar l'escenari, mentre que les condicions de bonificació són un repte extra i opcional reservat als jugadors més hàbils i experimentats. <br><br><font face=/font/big_bold.font>Per continuar, activa el contacte.</font>"

#### zero info msg1b

	key[]: "aca_msg_book2_scenario_zero1b"
	val[]: "Una de les condicions de bonificació et requereix completar l'escenari usant la <color value=@@clr_sel@@>Càmera interior<color value=@@clr_txt@@>. Encara podràs usar les càmeres exteriors per comprovar el teu voltant, però només mentre el camió estigui parat.<br><br>Ara pots mirar al teu entorn per orientar-te, llavors canvia a la càmera interior.<br><br><font face=/font/big_bold.font>Canvia a la càmera de persecució per verificar l'entorn</font>"


#### zero info msg1c


	key[]: "aca_msg_book2_scenario_zero1c"
	val[]: "Observa el teu voltant, llavors torna a la càmera interior.<br><br><font face=/font/big_bold.font>Mira al voltant del camió</font>"


#### zero info msg1d


	key[]: "aca_msg_book2_scenario_zero1d"
	val[]: "<font face=/font/big_bold.font>Torna a la càmera interior</font>"
#### zero info msg2

	key[]: "aca_msg_book2_scenario_zero2_title"
	val[]: "Domini de la conducció del camió"

	key[]: "aca_msg_book2_scenario_zero2"
	val[]: "El <color value=@@clr_sel@@>Temps<color value=@@clr_txt@@> també serà un element a respectar al \"Domini de la conducció del camió\". Tots els escenaris tindran un límit de temps propi que, com a condició d'aprovació, no es podrà superar. A més, alguns escenaris també tindran un límit de temps addicional i més estricte com a condició de bonificació.<br><br>El temps comença a comptar en moure el camió.<br><br><font face=/font/big_bold.font>Engega el motor i allibera el fre d'estacionament per continuar.</font>"


#### zero info msg3

	key[]: "aca_msg_book2_scenario_zero3_title"
	val[]: "Domini de la conducció del camió"

	key[]: "aca_msg_book2_scenario_zero3"
	val[]: "Una altra novetat del \"Domini de la conducció del camió\" són els punts de pas. Has d'arribar a tots els punts de pas per poder completar un escenari.<br><br>A part d'això, has d'arribar als punts de pas en la direcció correcta, de manera que presta atenció a qualsevol marca a prop del punt de pas i orienta't convenientment.<br><br><font face=/font/big_bold.font>Condueix endavant cap al punt de pas que hi ha davant teu.</font>"


#### zero info msg4

	key[]: "aca_msg_book2_scenario_zero4_title"
	val[]: "Domini de la conducció del camió"

	key[]: "aca_msg_book2_scenario_zero4"
	val[]: "Has arribat al punt de pas i ara ja pots seguir cap al proper.<br><br>Hi ha un altre punt de pas darrere teu, a on hauràs d'arribar fent marxa enrere. Fixa't en la fletxa que hi ha a terra indicant en quin sentit ha d'arribar el camió al punt de pas.<br><br>Una altra condició a tenir en compte, ja sigui d'aprovació o de bonificació, són els <color value=@@clr_sel@@>Canvis de direcció<color value=@@clr_txt@@>. Comptarem quantes vegades fas un canvi de direcció, entre marxa endavant i marxa enrere. Queda't per sota del límit per assolir la condició.<br><br><font face=/font/big_bold.font>Retrocedeix cap al punt de pas i llavors para't.</font>"

#### zero info msg5

	key[]: "aca_msg_book2_scenario_zero5_title"
	val[]: "Domini de la conducció del camió"

	key[]: "aca_msg_book2_scenario_zero5"
	val[]: "En aquests moments, hauries d'acumular només un canvi de direcció.<br><br>Recull el remolc de darrere teu i continua al pas següent.<br><br><font face=/font/big_bold.font>Retrocedeix cap al remolc i acobla'l.</font>"

#### zero info msg6

	key[]: "aca_msg_book2_scenario_zero6_title"
	val[]: "Domini de la conducció del camió"

	key[]: "aca_msg_book2_scenario_zero6"
	val[]: "A la teva dreta hi ha la zona d'aparcament final. Alguns escenaris només tenen un aparcament disponible, mentre que n'hi ha d'altres que en tindran més, podent triar el que més t'agradi. Aparcant correctament en qualsevol dels llocs permesos et permetrà completar l'escenari.<br><br><font face=/font/big_bold.font>Prem @@imv_nrm_attach@@ per connectar el remolc.</font>"


#### zero info msg7

	key[]: "aca_msg_book2_scenario_zero7_title"
	val[]: "Domini de la conducció del camió"

	key[]: "aca_msg_book2_scenario_zero7"
	val[]: "Els aparcaments també indiquen en quina orientació has de deixar el camió. Aparcar en la direcció equivocada, farà que no puguis completar l'escenari fins que esmenis el teu error, a costa de temps i canvis de direcció.<br><br><font face=/font/big_bold.font>Condueix cap a un dels aparcaments i aparca correctament.</font>"



#### zero info msg8

	key[]: "aca_msg_book2_scenario_zero8_title"
	val[]: "Domini de la conducció del camió"

	key[]: "aca_msg_book2_scenario_zero8"
	val[]: "Ara que ja hauries d'estar familiaritzat amb les noves condicions d'aprovació i de bonificació, també hauries d'estar a punt per abordar els nous escenaris del \"Domini de la conducció del camió\"!<br><br><font face=/font/big_bold.font>Assegura el camió per completar l'escenari, aplicant el fre d'estacionament i apagant el motor.</font>"



#@}

