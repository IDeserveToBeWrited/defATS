#+ Book 1 Scenario 3_03
#@{

#### 3_03 common
	key[]: "aca_scenario_book1_3_03_title"
	val[]: "Conduir per una zona urbana"

	key[]: "aca_scenario_book1_3_03_desc"
	val[]: "En aquest escenari, maniobrarem el camió a través d'una pista d'obstacles curta però complicada."

#### 3_03 goal
#!{
	key[]: "aca_goal_book1_3_03_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_03_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"

	key[]: "aca_goal_book1_3_03_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_3_03_end"
	val[]: "@@aca_goal_book1_2_01_end@@"


 #!}
	key[]: "aca_goal_book1_3_03_check1"
	val[]: "Primer revolt"

	key[]: "aca_goal_book1_3_03_check2"
	val[]: "Rotonda"

	key[]: "aca_goal_book1_3_03_check3"
	val[]: "Revolt de 90 graus"

	key[]: "aca_goal_book1_3_03_check4"
	val[]: "Gir de maneta"

	key[]: "aca_goal_book1_3_03_check5"
	val[]: "Gir de ganxo"

	key[]: "aca_goal_book1_3_03_check6"
	val[]: "Revolt estret"


#### generic phrase

	key[]: "aca_goal_book1_3_03_chk_point"
	val[]: "Conduir a prop de les barreres"

#### 3_03 msg - intro text

	key[]: "aca_msg_book1_3_03_cutscene01"
	val[]: "Aquí davant hi ha una varietat de girs i obstacles complexos.<br>Posa en pràctica tot el que has après fins ara i no t'hauria de resultar massa difícil."

	key[]: "aca_msg_book1_3_03_cutscene02"
	val[]: "El primer revolt és un senzill gir de ganxo. Vés per l'exterior i no tindràs problemes."

	key[]: "aca_msg_book1_3_03_cutscene03"
	val[]: "Continua cap a la rotonda."

	key[]: "aca_msg_book1_3_03_cutscene04"
	val[]: "Mantén el remolc lluny de l'interior de la rotonda fent passar la tractora per l'exterior."

	key[]: "aca_msg_book1_3_03_cutscene05"
	val[]: "El revolt de 90 graus a l'esquerra no és particularment estret, però assegura't de no tocar cap con."

	key[]: "aca_msg_book1_3_03_cutscene06"
	val[]: "Aquest revolt és significativament més ajustat. Fes una maniobra de gir de maneta per completar-lo."

	key[]: "aca_msg_book1_3_03_cutscene07"
	val[]: "En aquest revolt pots utilitzar la maniobra de gir de ganxo, però tens algun obstacle extra per evitar."

	key[]: "aca_msg_book1_3_03_cutscene09"
	val[]: "Una vegada més, el revolt final és molt ajustat i completar-lo requerirà una combinació de les maniobres de gir de maneta i de gir de ganxo."

	key[]: "aca_msg_book1_3_03_cutscene10"
	val[]: "Aparca a l'àrea indicada, assegura el camió i apaga el motor."


#### 3_03 Driving Instructions



	key[]: "aca_msg_book1_3_03_forward"
	val[]: "<font face=/font/big_bold.font>Procedeix cap al primer gir. </font>"

	key[]: "aca_msg_book1_3_03_check1"
	val[]: "El primer revolt és un senzill gir de ganxo.<br><br><font face=/font/big_bold.font><color value=@@clr_txt@@>Passa pel revolt. </font>"

	key[]: "aca_msg_book1_3_03_check2"
	val[]: "Continua cap a la rotonda. Recorda de passar-hi per l'exterior.<br><br><font face=/font/big_bold.font>Vés cap a la rotonda i supera-la.</font>"

	key[]: "aca_msg_book1_3_03_check3"
	val[]: "Aquest gir de 90 graus és una mica ajustat, vigila de no tocar cap con.<br><br><font face=/font/big_bold.font>Fes el revolt.</font>"

	key[]: "aca_msg_book1_3_03_check4"
	val[]: "Aquesta corba és el millor exemple de la maniobra de gir de maneta. Ocupa el carril adjacent abans d'entrar al revolt.<br><br><font face=/font/big_bold.font>Fes un gir de maneta. </font>"

	key[]: "aca_msg_book1_3_03_check5"
	val[]: "Aquest revolt té uns quants obstacles variats, però es pot superar amb la maniobra de gir de ganxo.<br><br><font face=/font/big_bold.font>Procedeix amb cautela. </font>"

	key[]: "aca_msg_book1_3_03_check6"
	val[]: "Aquest revolt és el més ajustat fins ara, tria la millor manera per passar-hi.<br><br><font face=/font/big_bold.font>Gira cap a l'aparcament.</font>"
#!{
	key[]: "aca_msg_book1_3_03_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_03_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_03_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

#@}

#+ Book 1 Scenario 3_04
#@{

#### 3_04 common
	key[]: "aca_scenario_book1_3_04_title"
	val[]: "Prova d'entrenament avançat - Remolc"

	key[]: "aca_scenario_book1_3_04_desc"
	val[]: "A l'escenari final del capítol 3, conduirem per una pista d'entrenament més llarga amb diversos girs i comprovarem què has après de maniobrar amb un remolc."

#### 3_04 goal



	key[]: "aca_goal_book1_3_04_check1"
	val[]: "Revolts senzills"

	key[]: "aca_goal_book1_3_04_check2"
	val[]: "Revolt senzill de 90 graus"

	key[]: "aca_goal_book1_3_04_check3"
	val[]: "Entrar a la paella doble"

	key[]: "aca_goal_book1_3_04_check4"
	val[]: "Sortir de la paella doble"

	key[]: "aca_goal_book1_3_04_check5"
	val[]: "Sector estret"

	key[]: "aca_goal_book1_3_04_check6"
	val[]: "Revolt senzill de 90 graus"

	key[]: "aca_goal_book1_3_04_check7"
	val[]: "Paella estreta"

	key[]: "aca_goal_book1_3_04_check8"
	val[]: "Revolt estret de 90 graus"

	key[]: "aca_goal_book1_3_04_check9"
	val[]: "Paella complicada"

	key[]: "aca_goal_book1_3_04_check10"
	val[]: "Últim revolt"

	key[]: "aca_goal_book1_3_04_check11"
	val[]: "Procedir a l'àrea designada"
#!{
	key[]: "aca_goal_book1_3_04_stop"
