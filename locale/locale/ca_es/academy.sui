#+ double_90
#@{

#### double_90 common

	key[]: "aca_scenario_book3_double_90_title"
	val[]: "Revolts de 90 graus"

	key[]: "aca_scenario_book3_double_90_desc"
	val[]: "En aquest escenari, la teva tasca serà conduir per una pista d'entrenament amb revolts de 90 graus de dificultat variable."

#### double_90 goal

	key[]: "aca_goal_book3_double_90_start"
	val[]: "Mou-te"

	key[]: "aca_goal_book3_double_90_forward"
	val[]: "Conduir cap endavant"

	key[]: "aca_goal_book3_double_90_check1"
	val[]: "Fes servir els miralls"

	key[]: "aca_goal_book3_double_90_check2"
	val[]: "Ocupa l'espai"

	key[]: "aca_goal_book3_double_90_check3"
	val[]: "Posa-ho a punt"

	key[]: "aca_goal_book3_double_90_check4"
	val[]: "Anticipa't"

#!{
	key[]: "aca_goal_book3_double_90_check5"
	val[]: "@@aca_goal_book3_sup_check1@@"

	key[]: "aca_goal_book3_double_90_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_double_90_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}

#### double_90 intro

	key[]: "aca_msg_book3_double_90_cutscene01"
	val[]: "L'entrenament que tens davant servirà per familiaritzar-te amb els revolts de 90 graus de dificultat variable, portant doble remolc."

	key[]: "aca_msg_book3_double_90_cutscene02"
	val[]: "Els primers girs són amples, amb molt d'espai. Utilitza'ls per veure com es comporten els remolcs en fer els revolts."

	key[]: "aca_msg_book3_double_90_cutscene03"
	val[]: "A partir d'aquí, els girs són més estrets i tècnics. Aproxima't-hi lentament i procura obrir-te per deixar suficient espai perquè els teus remolcs puguin passar pel revolt seguint la teva traçada."

	key[]: "aca_msg_book3_double_90_cutscene04"
	val[]: "Aquest és un dels girs més estrets del trajecte de prova. Et podria ser d'ajuda utilitzar el petit espai de la dreta per fer passar els teus remolcs al voltant d'aquests empipadors cons."

	key[]: "aca_msg_book3_double_90_cutscene05"
	val[]: "Hauries de tenir sempre present el proper revolt. En sortir d'un revolt, pensa com preparar-te pel següent."

	key[]: "aca_msg_book3_double_90_cutscene06"
	val[]: "Presta sempre atenció als teus remolcs, almenys fins que hagin passat tots els obstacles."

#### double_90 driving instructions

#!{
	key[]: "aca_msg_book3_double_90_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_double_90_forward"
	val[]: "Segueix endavant fins al primer gir."

	key[]: "aca_msg_book3_double_90_check1"
	val[]: "A mesura que avances, estigues atent als miralls per comprendre com tracen els remolcs."

	key[]: "aca_msg_book3_double_90_check2"
	val[]: "Fes una traçada oberta a cada gir, serà crucial per donar-te l'espai necessari per fer passar els remolcs pel revolt."

	key[]: "aca_msg_book3_double_90_check3"
	val[]: "Una bona preparació és vital pels propers revolts, ja que hi ha una corba ben estreta. Una equivocació al principi pot tenir un cost més tard.<br><br>Vés a poc a poc, sigues meticulós i vigila el teu entorn."

	key[]: "aca_msg_book3_double_90_check4"
	val[]: "Aquest gir és molt ajustat, a més et porta directament cap a un altre gir ajustat. No només hauràs de pensar com entrar al revolt, també com en surts i et prepares pel següent."

	key[]: "aca_msg_book3_double_90_check5"
	val[]: "Continua conduint pels últims girs cap a la zona indicada."

#!{
	key[]: "aca_msg_book3_double_90_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_double_90_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


#+ Book 3 Scenario justb
#@{

#### justb common
	key[]: "aca_scenario_book3_justb_title"
	val[]: "Retrocedint per primer cop"

	key[]: "aca_scenario_book3_justb_desc"
	val[]: "En aquest escenari, farem marxa enrere amb una doble combinació per primera vegada."

#### justb goal

#!{
	key[]: "aca_goal_book3_justb_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_justb_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
	key[]: "aca_goal_book3_justb_check1"
	val[]: "Relaxa't i no et preocupis"

#!{
	key[]: "aca_goal_book3_justb_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_justb_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### justb msg - intro text

	key[]: "aca_msg_book3_justb_cutscene1"
	val[]: "Fer marxa enrere amb remolc doble requereix tot un nou enfocament de què estàs fent. Més enllà de simplement fer girar un remolc, ara utilitzaràs el remolc davanter per fer-ne girar un altre, situat al seu darrere.<br><br>Usa aquest escenari per descobrir com funciona tot plegat. No hi ha cap més objectiu, només agafa't el temps que necessitis per entendre-ho."

	key[]: "aca_msg_book3_justb_cutscene2"
	val[]: "Des d'una posició recta, gira el teu camió en el mateix sentit que vols que giri el remolc posterior.<br><br>Però no et passis, només necessites que el remolc del darrere apunti cap allà on vols que vagi, llavors alinea la tractora amb el remolc del davant i deixa que el remolc posterior faci el seu camí."

	key[]: "aca_msg_book3_justb_cutscene3"
	val[]: "Quan ja tinguis el remolc posterior encaminat cap a on el vols portar, pots començar a dirigir el remolc davanter i que segueixi la mateixa direcció.<br><br>Un cop els dos remolcs vagin per bon camí, usa la tractora per ajustar l'angle entre els dos remolcs per fer un gir més obert o més tancat."

	key[]: "aca_msg_book3_justb_cutscene4"
	val[]: "No hi ha una manera exacta per fer-ho bé. Simplement has d'estar atent al que passa, aprenent de les equivocacions i seguir practicant.<br><br>Quan n'estiguis satisfet, dirigeix-te a l'àrea designada i assegura el vehicle.<br><br>Estiga't-hi tant temps com et calgui, experimentant tan com necessitis."

#### justb Driving Instructions

#!{
	key[]: "aca_msg_book3_justb_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_justb_forward"
	val[]: "Comença a retrocedir a poc a poc. Recorda que no cal girar massa el volant, no necessites fer la tisora per ara.<br><br>Intenta retrocedir en línia recta o porta els remolcs cap al costat del conductor."

	key[]: "aca_msg_book3_justb_check1"
	val[]: "No et desesperis, tens tant temps com vulguis.<br><br>Tot mestre va ser aprenent."

#!{
	key[]: "aca_msg_book3_justb_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_justb_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}

#+ Book 3 Scenario justc
#@{

#### justc common
	key[]: "aca_scenario_book3_justc_title"
	val[]: "Primera correcció retrocedint"

	key[]: "aca_scenario_book3_justc_desc"
	val[]: "En aquest escenari, haurem de continuar allà a on algú altre ho va deixar."

#### justc goal

#!{
	key[]: "aca_goal_book3_justc_start"
	val[]: "@@aca_goal_book3_sup_start@@"

	key[]: "aca_goal_book3_justc_forward"
	val[]: "@@aca_goal_book3_sup_forward@@"
#!}
	key[]: "aca_goal_book3_justc_check1"
	val[]: "Marxa enrere"

#!{
	key[]: "aca_goal_book3_justc_stop"
	val[]: "@@aca_goal_book3_sup_stop@@"

	key[]: "aca_goal_book3_justc_end"
	val[]: "@@aca_goal_book3_sup_end@@"
#!}
#### justc msg - intro text

	key[]: "aca_msg_book3_justc_cutscene1"
	val[]: "Vaja, algú n'ha quedat ben fart mentre maniobrava i ha abandonat el camió al bell mig."

	key[]: "aca_msg_book3_justc_cutscene2"
	val[]: "Inevitablement, hi haurà ocasions que quedaràs amb la combinació ben plegada. No pateixis, vés endavant desfent la tisora fins que puguis seguir amb la feina.<br><br>Si no ho tens clar, alinea tota la combinació i comença des de zero."

	key[]: "aca_msg_book3_justc_cutscene3"
	val[]: "Aquesta és una posició bastant decent per començar. El remolc posterior està apuntant cap a on ha d'anar i pots adreçar la tractora amb el remolc davanter amb facilitat, llavors només cal conduir tota la combinació al seu destí."

	key[]: "aca_msg_book3_justc_cutscene4"
	val[]: "Procedeix cap a l'àrea designada i assegura el camió.<br><br>Una vegada més, practica en aquest escenari fins que et trobis confortable amb aquest tipus de maniobra."

#### justc Driving Instructions

#!{
	key[]: "aca_msg_book3_justc_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_justc_forward"
	val[]: "No hi ha manera de sortir d'aquest embolic. Vés endavant fins que hi puguis fer alguna cosa."

	key[]: "aca_msg_book3_justc_check1"
	val[]: "Comença a retrocedir."

#!{
	key[]: "aca_msg_book3_justc_stop"
	val[]: "@@aca_msg_book3_sup_stop@@"

	key[]: "aca_msg_book3_justc_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


#+ Straight Backing
#@{

#### straight_backing common

	key[]: "aca_scenario_book3_straight_backing_title"
	val[]: "Marxa enrere en línia recta"

	key[]: "aca_scenario_book3_straight_backing_desc"
	val[]: "En aquest escenari, hauràs de fer marxa enrere en línia recta amb remolc doble."

#### straight_backing goal

#!{
	key[]: "aca_goal_book3_straight_backing_start"
	val[]: "@@aca_goal_book3_sup_start@@"
#!}
	key[]: "aca_goal_book3_straight_backing_forward"
	val[]: "Marxa enrere"

#!{
