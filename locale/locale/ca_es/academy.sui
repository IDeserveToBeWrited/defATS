	val[]: "@@aca_goal_book1_2_01_end@@"

	key[]: "aca_goal_book1_3_04_start"
	val[]: "@@aca_goal_book1_2_01_start@@"

	key[]: "aca_goal_book1_3_04_forward"
	val[]: "@@aca_goal_book1_3_02_forward@@"


 #!}
#### 3_04 msg - intro text

	key[]: "aca_msg_book1_3_04_cutscene01"
	val[]: "Recorda de planificar amb antelació cada gir i de fer un bon ús de l'espai que t'envolta. Vés cap a les primeres barreres i entra a la pista."

	key[]: "aca_msg_book1_3_04_cutscene02"
	val[]: "Els primers revolts es van tancant a mesura que avances."

	key[]: "aca_msg_book1_3_04_cutscene03"
	val[]: "Recorda que com surtis d'un revolt pot afectar a com entris en el proper."

	key[]: "aca_msg_book1_3_04_cutscene04"
	val[]: "El primer dels revolts més desafiants és una combinació de dues paelles. Hauràs de ser molt curós i reflexiu en maniobrar. Et resultarà més senzill si t'ajudes amb els miralls."

	key[]: "aca_msg_book1_3_04_cutscene05"
	val[]: "Segueix per aquesta secció estreta."

	key[]: "aca_msg_book1_3_04_cutscene06"
	val[]: "Ara trobaràs uns quants girs fàcils de camí cap a la paella."

	key[]: "aca_msg_book1_3_04_cutscene07"
	val[]: "Mira els miralls a banda i banda i assegura't de no xocar amb cap de les barreres. Vés tan a poc a poc com ho necessitis."

	key[]: "aca_msg_book1_3_04_cutscene08"
	val[]: "A vegades sembla que hi ha molt de lloc per maniobrar, però pots acabar en una situació ben ajustada."

	key[]: "aca_msg_book1_3_04_cutscene09"
	val[]: "El revolt més complicat és aquí al davant. La teva entrada al revolt determinarà si la superes satisfactòriament o no."

	key[]: "aca_msg_book1_3_04_cutscene10"
	val[]: "Continua cap a l'últim gir."

	key[]: "aca_msg_book1_3_04_cutscene11"
	val[]: "Aparca a l'àrea indicada, assegura el camió i apaga el motor."
#!{
	key[]: "aca_msg_book1_3_04_cutscene12"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_04_cutscene13"
	val[]: "Unused"

	key[]: "aca_msg_book1_3_04_cutscene14"
	val[]: "Unused"
#!}

#### 3_04 Driving Instructions



	key[]: "aca_msg_book1_3_04_forward"
	val[]: "<font face=/font/big_bold.font>Accelera i passa pel costat de les barreres. </font>"

	key[]: "aca_msg_book1_3_04_check1"
	val[]: "Continua per la pista i passa per les dues primeres corbes senzilles.<br><br><font face=/font/big_bold.font>Segueix conduint. </font>"

	key[]: "aca_msg_book1_3_04_check2"
	val[]: "<font face=/font/big_bold.font>Fes el revolt de 90 graus.</font>"

	key[]: "aca_msg_book1_3_04_check3"
	val[]: "El proper tram de la prova és una paella doble. Com facis la maniobra a la primera part afectarà directament a la teva traçada per la segona part.<br><br><font face=/font/big_bold.font>Continua amb precaució. </font>"

	key[]: "aca_msg_book1_3_04_check4"
	val[]: "En sortir de la paella doble, posa't a l'esquerra per preparar l'entrada a la secció estreta.<br><br><font face=/font/big_bold.font>Segueix endavant. </font>"

	key[]: "aca_msg_book1_3_04_check5"
	val[]: "<font face=/font/big_bold.font>Segueix per la secció estreta. </font>"

	key[]: "aca_msg_book1_3_04_check6"
	val[]: "Davant teu hi ha un parell de revolts fàcils de 90 graus.<br><br><font face=/font/big_bold.font>Fes els girs. </font>"

	key[]: "aca_msg_book1_3_04_check7"
	val[]: "T'estàs acostant a una altra paella. En aproximar-t'hi, vigila el teu remolc amb els miralls. <br><br><font face=/font/big_bold.font>Passa per la paella. </font>"

	key[]: "aca_msg_book1_3_04_check8"
	val[]: "El proper gir de 90 graus és més estret del que sembla. Aprofita l'espai sàviament.<br><br><font face=/font/big_bold.font>Segueix conduint. </font>"

	key[]: "aca_msg_book1_3_04_check9"
	val[]: "L'última paella és complicada, gairebé sense espai de sobres. <br><br><font face=/font/big_bold.font>Avança amb precaució.</font>"

	key[]: "aca_msg_book1_3_04_check10"
	val[]: "Un últim revolt de 90 graus t'està esperant.<br><br><font face=/font/big_bold.font>Continua endavant. </font>"

	key[]: "aca_msg_book1_3_04_check11"
	val[]: "Vés cap a l'àrea designada."
#!{
	key[]: "aca_msg_book1_3_04_stop"
	val[]: "@@aca_msg_book1_2_01_stop@@"

	key[]: "aca_msg_book1_3_04_end"
	val[]: "@@aca_msg_book1_2_01_end@@"

	key[]: "aca_msg_book1_3_04_start"
	val[]: "@@aca_msg_book1_2_02_start@@"

#!}

#@}

