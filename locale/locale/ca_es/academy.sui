	val[]: "No podràs passar per aquest revolt. Fes marxa enrere i troba una altra via."

	key[]: "aca_msg_book3_trckstp_check2"
	val[]: "Aparca al revolt del davant."

	key[]: "aca_msg_book3_trckstp_stop"
