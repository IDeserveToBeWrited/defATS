	key[]: "aca_msg_book3_diag_start"
	val[]: "@@aca_msg_book3_sup_start@@"
#!}
	key[]: "aca_msg_book3_diag_forward"
	val[]: "Vés cap al final de la fila i busca la teva plaça d'aparcament."

	key[]: "aca_msg_book3_diag_check1"
	val[]: "Condueix una mica més endavant del teu aparcament per fer que el remolc posterior hi entri correctament, llavors gira pronunciadament vigilant que el remolc davanter no contacti amb el camió del costat."

	key[]: "aca_msg_book3_diag_stop"
	val[]: "Segueix lentament mentre adreces la combinació, llavors para't a l'àrea designada."

#!{
	key[]: "aca_msg_book3_diag_end"
	val[]: "@@aca_msg_book3_sup_end@@"
#!}
#@}


