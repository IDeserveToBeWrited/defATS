#+ Book 1 Scenario 1_02
#@{

#### 1_02 common

	key[]: "aca_scenario_book1_1_02_title"
	val[]: "Controls de la càmera"

	key[]: "aca_scenario_book1_1_02_desc"
	val[]: "En aquest escenari, veurem els diferents tipus de càmeres disponibles i com et poden ajudar a controlar i a maniobrar el camió."

#### 1_02 goal

	key[]: "aca_goal_book1_1_02_seat"
	val[]: "La teva posició en el seient"

	key[]: "aca_goal_book1_1_02_look_back"
	val[]: "Mirar enrere"

	key[]: "aca_goal_book1_1_02_mirrors"
	val[]: "Comprova els miralls"

	key[]: "aca_goal_book1_1_02_cam_behind"
	val[]: "Canvia a la càmera exterior"

	key[]: "aca_goal_book1_1_02_look_around"
	val[]: "Mira al voltant del camió"


#### 1_02 msg - intro text

	key[]: "aca_msg_book1_1_02_cutscene1"
	val[]: "En aquest escenari, anirem canviant per les càmeres<br>que estan disponibles."

	key[]: "aca_msg_book1_1_02_cutscene2"
	val[]: "Hi ha un total de set càmeres per triar, ara en veurem unes<br>quantes i explicarem les seves funcions."

	key[]: "aca_msg_book1_1_02_cutscene3"
	val[]: "La varietat de càmeres i els seus diferents angles t'ajudaran quan maniobris en llocs estrets."


#### 1_02 Driving Instructions

	key[]: "aca_msg_book1_1_02_seat"
	val[]: "Veure cap a on estàs anant és fonamental per una conducció segura i professional. Si la teva posició en el seient no et satisfà, la pots canviar a \"@@adjust_link_t@@\" (accedeix-hi via el menú de pausa).<br><br><font face=/font/big_bold.font>Confirma que estàs llest amb @@imv_nrm_activate@@. </font>"

	key[]: "aca_msg_book1_1_02_look_back"
	val[]: "Quan fas marxa enrere, els miralls no sempre ofereixen una vista clara. Potser et caldria mirar cap enrere traient el cap per la finestra per veure-hi millor.<br><br><font face=/font/big_bold.font>Gira la càmera del tot cap al costat del conductor per treure el cap per la finestra i mirar cap enrere.</font>@@aca_goal_tip@@ Has d'estar dins el vehicle."

	key[]: "aca_msg_book1_1_02_mirrors"
	val[]: "Fes servir aquesta vista per controlar el remolc mentre maniobres marxa enrere. Sempre és millor fer marxa enrere cap al costat del conductor per poder utilitzar aquesta vista. Quan facis marxa enrere cap al costat del passatger, tindràs una vista més limitada del que passa darrere teu.<br><br><font face=/font/big_bold.font>Mira cap al costat del passatger. </font>"

	key[]: "aca_msg_book1_1_02_cam_behind"
	val[]: "Aquesta és la raó de per què normalment no és recomanable fer marxa enrere pel costat del passatger; pots veure que la visibilitat és molt limitada. Per sort, tens set càmeres exteriors disponibles.<br><br>Pots usar el botó @@imv_nrm_camcycle@@ per canviar a la càmera següent. Després de passar per les set càmeres, tornaràs al principi del cicle. <br><br><font face=/font/big_bold.font>Prem @@imv_nrm_camcycle@@ per canviar a la càmera següent. </font>"

	key[]: "aca_msg_book1_1_02_look_around"
	val[]: "La càmera externa proporciona la millor perspectiva del que està passant al voltant del camió.<br><br><font face=/font/big_bold.font>Mira al voltant del camió.</font>"

	key[]: "aca_msg_book1_1_02_cam_top"
	val[]: "<font face=/font/big_bold.font>Prement @@imv_nrm_camcycle@@ novament, pots canviar a la càmera següent. </font>"

	key[]: "aca_msg_book1_1_02_cam_cabin"
	val[]: "La càmera de vista superior proporciona una visió excel·lent de la situació del camió i del seu entorn, simplificant significativament l'aparcament i la conducció en espais estrets.<br><br><font face=/font/big_bold.font>Prem @@imv_nrm_camcycle@@ per canviar a la càmera següent. </font>"

	key[]: "aca_msg_book1_1_02_cam_window"
	val[]: "La càmera de sostre proporciona una visió clara i amb pocs obstacles de la carretera al teu davant.<br><br><font face=/font/big_bold.font>Prem @@imv_nrm_camcycle@@ per canviar a l'última càmera que veurem per ara.</font>"

	key[]: "aca_msg_book1_1_02_cam_interior"
	val[]: "La vista enrere és una drecera a la vista que hem vist abans, girant la càmera interior per treure el cap per la finestra. Tal com hem dit, és útil per fer marxa enrere o aparcar.<br><br>En el joc, podràs provar més càmeres prement repetidament @@imv_nrm_camcycle@@.<br><br><font face=/font/big_bold.font>Prem @@imv_nrm_cam1@@ per tornar a l'interior.</font>"

	key[]: "aca_msg_book1_1_02_end"
	val[]: "Per una experiència fidel a una autoescola, et recomanem mantenir-te a la vista de \"Càmera interior\" en avançar per cada un dels escenaris.<br><br><font face=/font/big_bold.font>Prem @@imv_nrm_activate@@ per confirmar i finalitzar l'escenari.</font>@@aca_goal_tip@@ Pots utilitzar el @@o_im_cam_zoom@@ per tenir una millor vista del teu voltant. És especialment útil quan mires pels miralls. Dóna una ullada a \"Opcions\" > \"Tecles i botons\" per veure o canviar aquests controls."

#@}

#+ Book 1 Scenario 1_03
#@{

#### 1_03 common
	key[]: "aca_scenario_book1_1_03_title"
	val[]: "Conduir per primer cop"

	key[]: "aca_scenario_book1_1_03_desc"
	val[]: "En aquest escenari, aprendrem a preparar el camió per la conducció, llavors farem els primers metres."

#### 1_03 goal

	key[]: "aca_goal_book1_1_03_electrics"
	val[]: "Girar el contacte"

	key[]: "aca_goal_book1_1_03_start"
	val[]: "Engegar el motor"

	key[]: "aca_goal_book1_1_03_look_mirror"
	val[]: "Comprovar l'entorn"

	key[]: "aca_goal_book1_1_03_brake"
	val[]: "Aplicar el fre de servei"

	key[]: "aca_goal_book1_1_03_gear"
	val[]: "Engranar la marxa endavant"

	key[]: "aca_goal_book1_1_03_park_br_off"
	val[]: "Alliberar el fre d'estacionament"

	key[]: "aca_goal_book1_1_03_forward"
	val[]: "Conduir cap endavant"

	key[]: "aca_goal_book1_1_03_stop"
	val[]: "Parar"

	key[]: "aca_goal_book1_1_03_park_br_on"
	val[]: "Aplicar el fre d'estacionament"

	key[]: "aca_goal_book1_1_03_gear_n"
	val[]: "Canviar a punt mort"

	key[]: "aca_goal_book1_1_03_end"
	val[]: "Parar el motor"

#### 1_03 msg - intro text

	key[]: "aca_msg_book1_1_03_cutscene1"
	val[]: "Per les teves primeres lliçons, utilitzaràs només la unitat tractora.<br>Ens referim a un camió com a tractora quan no porta un cos propi per la càrrega, sinó que depèn de l'ús d'un remolc pel transport de béns i materials."

	key[]: "aca_msg_book1_1_03_cutscene2"
	val[]: "Les tractores són comunes perquè permeten una gran versatilitat: Poden deixar un remolc buit i recollir-ne un altre de carregat sense esperes, o fins i tot canviar a un altre tipus de remolc totalment diferent."

	key[]: "aca_msg_book1_1_03_cutscene3"
	val[]: "Per la teva primera conducció, hauràs de conduir endavant i parar-te després de la línia discontínua.<br>Engega el motor i segueix les indicacions per moure't amb el camió. Un cop preparat, condueix endavant."

	key[]: "aca_msg_book1_1_03_cutscene4"
	val[]: "Condueix més enllà de la línia discontínua, para't, apaga el motor i assegura el camió."

#### 1_03 Driving Instructions

	key[]: "aca_msg_book1_1_03_electrics"
	val[]: "El proper pas en el teu entrenament serà moure el camió per primera vegada.<br><br>Naturalment, sense engegar el motor això no funciona, i primer de tot hauràs d'activar el contacte.<br><br><font face=/font/big_bold.font>Prem $input engineelect$ per activar el contacte.</font>@@aca_goal_tip@@ Per defecte, quan s'engega el motor també s'activa automàticament l'electricitat. Pots modificar aquest funcionament a Opcions > Joc > @@auto_engine_start@@."

	key[]: "aca_msg_book1_1_03_start"
	val[]: "El contacte activa l'electrònica del camió. Potser has notat uns indicadors lluminosos en el quadre d'instruments, això és normal. Si es mantenen encesos un cop engegat el motor, podrien indicar un problema en el camió. L'excepció és el llumet del fre d'estacionament, que s'apagarà en alliberar-lo.<br><br>Per sort, aquest camió es troba en bones condicions i podem seguir endavant.<br><br><font face=/font/big_bold.font>Prem @@imv_nrm_engine@@ per engegar el motor. </font>"

	key[]: "aca_msg_book1_1_03_look_mirror"
	val[]: "Ara que el motor ja està engegat, és crucial comprovar l'entorn abans d'iniciar qualsevol moviment.<br><br><font face=/font/big_bold.font>Mira al voltant del camió i als miralls de cada costat per confirmar que l'àrea propera al camió està lliure d'obstacles.</font>@@aca_goal_tip@@ Has d'estar dins el vehicle."

	key[]: "aca_msg_book1_1_03_brake"
	val[]: "Pot semblar obvi, però has de saber com frenar el camió abans d'iniciar qualsevol moviment.<br><br><font face=/font/big_bold.font>Activa el fre de servei usant $input backward$. </font>"

	key[]: "aca_msg_book1_1_03_gear_arcade"
	val[]: "Ara, sabrem com canviar el sentit de la marxa.<br><br>Amb una transmissió automàtica simple no necessites canviar marxes, tot funciona automàticament.<font face=/font/big_bold.font><br><br>Utilitza $input forward$ per activar la marxa endavant. </font>"

	key[]: "aca_msg_book1_1_03_gear_automatic"
	val[]: "Ara, sabrem com canviar el sentit de la marxa.<br><br>La transmissió automàtica real et permet canviar entre Conduir (D), Punt Mort (N) i Marxa Enrere (R) igual que una transmissió automàtica a la vida real.<br><br><font face=/font/big_bold.font>Prem @@imv_nrm_gearup@@ per activar la marxa endavant. </font>"

	key[]: "aca_msg_book1_1_03_gear_manual"
	val[]: "Ara, sabrem com canviar el sentit de la marxa.<br><br>La transmissió seqüencial et permet canviar de forma escalonada, igual que en una transmissió seqüencial a la vida real.<br><br>De la mateixa manera com engranes la marxa endavant, a mesura que acceleres has de canviar a marxes més altes.<br><br><font face=/font/big_bold.font>Prem @@imv_nrm_gearup@@ per engranar la primera marxa.</font>"

	key[]: "aca_msg_book1_1_03_gear_direct"
	val[]: "Ara, sabrem com canviar el sentit de la marxa.<br><br>Amb una palanca de canvis i un embragatge, en canviar de marxes experimentaràs la mateixa sensació que en una transmissió manual a la vida real.<br><br>Prem del tot l'embragatge i el fre de servei. <font face=/font/big_bold.font>Utilitza la palanca de canvis per engranar la primera marxa. <color value=@@clr_txt@@>Mantén l'embragatge i el fre premuts.</font>"

	key[]: "aca_msg_book1_1_03_park_br_off"
	val[]: "Per començar a moure't, primer has d'alliberar el fre d'estacionament.<br><br><font face=/font/big_bold.font>Usa @@imv_nrm_parkingbrake@@ per alliberar el fre d'estacionament.</font> @@aca_goal_tip@@ En el joc, el fre d'estacionament automàtic està inicialment desactivat. Pots canviar aquesta funció a \"Opcions\" > \"Joc\" > \"@@auto_park_brake@@\"."

	key[]: "aca_msg_book1_1_03_forward_arcade"
	val[]: "Ara el camió ja està a punt per moure's. Ves endavant i travessa la línia discontínua.<br><br><font face=/font/big_bold.font>Comença a moure't prement l'accelerador: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_automatic"
	val[]: "Ara el camió ja està a punt per moure's. Ves endavant i travessa la línia discontínua.<br><br><font face=/font/big_bold.font>Comença a moure't prement l'accelerador: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_manual"
	val[]: "Ara el camió ja està a punt per moure's. Ves endavant i travessa la línia discontínua.<br><br><font face=/font/big_bold.font>Comença a moure't prement l'accelerador: $input forward$ </font>"

	key[]: "aca_msg_book1_1_03_forward_direct"
	val[]: "Ara el camió ja està a punt per moure's. Ves endavant i travessa la línia discontínua.<br><br><font face=/font/big_bold.font>Allibera el fre de servei, allibera gradualment l'embragatge mentre simultàniament prems l'accelerador per mantenir les revolucions del motor prou altes per tal que no es cali. Un cop l'embragatge estigui alliberat al complet, ja pots accelerar i canviar de marxa segons necessitis. </font>"

	key[]: "aca_msg_book1_1_03_stop_arcade"
	val[]: "Utilitza el fre de servei per parar.<br><br><font face=/font/big_bold.font>Utilitza $input backward$ per parar el camió. </font>"

	key[]: "aca_msg_book1_1_03_stop_automatic"
	val[]: "Utilitza el fre de servei per parar.<br><br><font face=/font/big_bold.font>Utilitza $input backward$ per parar el camió. </font>"

	key[]: "aca_msg_book1_1_03_stop_manual"
	val[]: "Utilitza el fre de servei per parar.<br><br><font face=/font/big_bold.font>Utilitza $input backward$ per parar el camió. </font>"

	key[]: "aca_msg_book1_1_03_stop_direct"
	val[]: "Quan és hora de parar, prem l'embragatge al complet <font face=/font/big_bold.font>i llavors atura el camió utilitzant el fre de servei.<color value=@@clr_txt@@> Canvia a punt mort movent la palanca de canvis i allibera l'embragatge. </font>"

	key[]: "aca_msg_book1_1_03_park_br_on"
	val[]: "Ara, assegura el camió. El fre d'estacionament garanteix que el camió no es mourà involuntàriament després d'aparcar-lo.<br><br><font face=/font/big_bold.font>Usa @@imv_nrm_parkingbrake@@ per activar el fre d'estacionament.</font>"

	key[]: "aca_msg_book1_1_03_gear_n_arcade"
	val[]: "Amb una transmissió automàtica simple no necessites canviar marxes, tot funciona automàticament.<br><br><font face=/font/big_bold.font>Prem @@imv_nrm_activate@@ per continuar. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>Canvia a punt mort prement @@imv_nrm_geardown@@. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>Canvia a punt mort prement @@imv_nrm_geardown@@. </font>"

	key[]: "aca_msg_book1_1_03_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>Canvia a punt mort movent la palanca de canvis, llavors allibera l'embragatge. </font>"

	key[]: "aca_msg_book1_1_03_end"
	val[]: "Ara ja coneixes com moure el camió i com parar-lo amb seguretat.<br><br><font face=/font/big_bold.font>Prem $input engineelect$ per apagar el motor. </font>"
#@}

#+ Book 1 Scenario 1_04
#@{

#### 1_04 common
	key[]: "aca_scenario_book1_1_04_title"
	val[]: "Marxa enrere"

	key[]: "aca_scenario_book1_1_04_desc"
	val[]: "En aquest escenari provarem de fer marxa enrere per primer cop. També parlarem de com utilitzar els miralls per saber què hi ha darrere, què s'ha de vigilar i com preparar-se pel moviment cap enrere."

#### 1_04 goal

	key[]: "aca_goal_book1_1_04_start"
	val[]: "Engegar el motor"

	key[]: "aca_goal_book1_1_04_look_mirror"
	val[]: "Comprovar el mirall del costat del passatger"

	key[]: "aca_goal_book1_1_04_look_back"
	val[]: "Comprovar el mirall del costat del conductor"

	key[]: "aca_goal_book1_1_04_gear_r"
	val[]: "Engranar la marxa enrere"

	key[]: "aca_goal_book1_1_04_park_br_off"
	val[]: "Alliberar el fre d'estacionament"
#!{
	key[]: "aca_goal_book1_1_04_backward"
	val[]: "@@aca_scenario_book1_1_04_title@@"

	key[]: "aca_goal_book1_1_04_stop"
	val[]: "@@aca_goal_book1_1_03_stop@@"

	key[]: "aca_goal_book1_1_04_park_br_on"
	val[]: "@@aca_goal_book1_1_03_park_br_on@@"

#!}
	key[]: "aca_goal_book1_1_04_gear_n"
	val[]: "Canviar a punt mort"

	key[]: "aca_goal_book1_1_04_end"
	val[]: "Parar el motor"

#### 1_04 msg - intro text

	key[]: "aca_msg_book1_1_04_cutscene1"
	val[]: "Per aquesta prova, farem marxa enrere en línia recta. Has d'anar cap enrere fins a passar la línia discontínua i parar-te."

	key[]: "aca_msg_book1_1_04_cutscene2"
	val[]: "Quan fas marxa enrere amb el camió, és essencial mirar al voltant constantment, observar tots els miralls i assegurar-se que l'espai dels costats i de darrere teu estan lliures d'obstacles."

	key[]: "aca_msg_book1_1_04_cutscene3"
	val[]: "Encén el motor, canvia a marxa enrere i comença a moure't."

	key[]: "aca_msg_book1_1_04_cutscene4"
	val[]: "Condueix marxa enrere més enllà de la línia discontínua, para't, apaga el motor i assegura el camió."

#### 1_04 Driving Instructions

	key[]: "aca_msg_book1_1_04_start"
	val[]: "Prepara el camió per a la conducció tal com has après en un escenari anterior.<br><br><font face=/font/big_bold.font>Quan estiguis a punt, engega el motor. </font>"

	key[]: "aca_msg_book1_1_04_look_mirror"
	val[]: "Comprova els miralls per assegurar-te que no hi ha cap obstacle al teu entorn. Si no estàs satisfet amb la posició dels miralls, els pots ajustar a \"@@adjust_link_t@@\".<br><br><font face=/font/big_bold.font>Mira el mirall del costat del passatger.</font>@@aca_goal_tip@@ Has d'estar dins el vehicle."

	key[]: "aca_msg_book1_1_04_look_back"
	val[]: "Ens hem de moure fins després de la línia discontínua. Ara no hi ha cap entrebanc a prop, però mentre condueixis regularment és essencial vigilar constantment el teu entorn fent ús dels miralls.<br><br><font face=/font/big_bold.font>Mira el mirall del costat del conductor.</font>"

	key[]: "aca_msg_book1_1_04_gear_r_arcade"
	val[]: "<font face=/font/big_bold.font>Usa $input backward$ per engranar la marxa enrere. </font>@@aca_goal_tip@@ Quan reculis, en molts camions s'activa automàticament l'avisador de marxa enrere. El pots desactivar a \"Opcions\" > \"So\" > \"@@sound_of_reverse@@\"."

	key[]: "aca_msg_book1_1_04_gear_r_automatic"
	val[]: "<font face=/font/big_bold.font>Prem @@imv_nrm_geardown@@ per canviar a marxa enrere. </font>@@aca_goal_tip@@ Quan reculis, en molts camions s'activa automàticament l'avisador de marxa enrere. El pots desactivar a \"Opcions\" > \"So\" > \"@@sound_of_reverse@@\"."

	key[]: "aca_msg_book1_1_04_gear_r_manual"
	val[]: "<font face=/font/big_bold.font>Prem @@imv_nrm_geardown@@ per canviar a marxa enrere. </font>@@aca_goal_tip@@ Quan reculis, en molts camions s'activa automàticament l'avisador de marxa enrere. El pots desactivar a \"Opcions\" > \"So\" > \"@@sound_of_reverse@@\"."

	key[]: "aca_msg_book1_1_04_gear_r_direct"
	val[]: "<font face=/font/big_bold.font>Prem del tot l'embragatge i mou la palanca de canvis a marxa enrere. </font>@@aca_goal_tip@@ Quan reculis, en molts camions s'activa automàticament l'avisador de marxa enrere. El pots desactivar a \"Opcions\" > \"So\" > \"@@sound_of_reverse@@\"."

	key[]: "aca_msg_book1_1_04_park_br_off"
	val[]: "Ara tens la marxa enrere engranada.<br><br><font face=/font/big_bold.font>Allibera el fre d'estacionament usant @@imv_nrm_parkingbrake@@. </font>"

	key[]: "aca_msg_book1_1_04_backward_arcade"
	val[]: "Comença a moure't utilitzant $input backward$.<br><br><font face=/font/big_bold.font>Vés enrere fins a sobrepassar la línia discontínua. </font>"

	key[]: "aca_msg_book1_1_04_backward_automatic"
	val[]: "Comença a moure't utilitzant l'accelerador: $input forward$.<br><br><font face=/font/big_bold.font>Vés enrere fins a sobrepassar la línia discontínua. </font>"

	key[]: "aca_msg_book1_1_04_backward_manual"
	val[]: "Comença a moure't utilitzant l'accelerador: $input forward$.<br><br><font face=/font/big_bold.font>Vés enrere fins a sobrepassar la línia discontínua. </font>"

	key[]: "aca_msg_book1_1_04_backward_direct"
	val[]: "Allibera l'embragatge lentament mentre uses l'accelerador per mantenir les revolucions del motor.<br><br><font face=/font/big_bold.font>Vés enrere fins a sobrepassar la línia discontínua. </font>"

	key[]: "aca_msg_book1_1_04_stop_arcade"
	val[]: "<font face=/font/big_bold.font>Para el camió amb el fre de servei: $input forward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_automatic"
	val[]: "<font face=/font/big_bold.font>Para el camió amb el fre de servei: $input backward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_manual"
	val[]: "<font face=/font/big_bold.font>Para el camió amb el fre de servei: $input backward$ </font>"

	key[]: "aca_msg_book1_1_04_stop_direct"
	val[]: "<font face=/font/big_bold.font>Pressiona completament l'embragatge i llavors para el camió amb el fre de servei. </font>"

	key[]: "aca_msg_book1_1_04_park_br_on"
	val[]: "<font face=/font/big_bold.font>Activa el fre d'estacionament utilitzant @@imv_nrm_parkingbrake@@. </font>"

	key[]: "aca_msg_book1_1_04_gear_n_arcade"
	val[]: "Amb una transmissió automàtica simple no necessites canviar marxes, tot funciona automàticament.<br><br><font face=/font/big_bold.font>Prem @@imv_nrm_activate@@ per continuar. </font>"

	key[]: "aca_msg_book1_1_04_gear_n_automatic"
	val[]: "<font face=/font/big_bold.font>Canvia a punt mort pressionant @@imv_nrm_gearup@@.</font>@@aca_goal_tip@@ Els camions moderns canviaran automàticament a punt mort quan activis el fre d'estacionament. Tot i això, és un bon hàbit que ho facis sempre manualment. En els escenaris següents, no et requerirem aquest pas."

	key[]: "aca_msg_book1_1_04_gear_n_manual"
	val[]: "<font face=/font/big_bold.font>Canvia a punt mort pressionant @@imv_nrm_gearup@@.</font>@@aca_goal_tip@@  Els camions moderns canviaran automàticament a punt mort quan activis el fre d'estacionament. Tot i això, és un bon hàbit que ho facis sempre manualment. En els escenaris següents, no et requerirem aquest pas."

	key[]: "aca_msg_book1_1_04_gear_n_direct"
	val[]: "<font face=/font/big_bold.font>Canvia la palanca de canvis a punt mort, llavors allibera l'embragatge.</font>@@aca_goal_tip@@ Els camions moderns canviaran automàticament a punt mort quan activis el fre d'estacionament. Tot i això, és un bon hàbit que ho facis sempre manualment. En els escenaris següents, no et requerirem aquest pas."

	key[]: "aca_msg_book1_1_04_end"
	val[]: "Recorda que has d'estar sempre vigilant el teu entorn en fer marxa enrere, especialment en llocs estrets o amb trànsit.<br><br><font face=/font/big_bold.font>Apaga el motor prement $input engineelect$. </font>"
#@}

