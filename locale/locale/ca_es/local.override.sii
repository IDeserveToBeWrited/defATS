#+ Text deviations for American Truck Simulator. Please, use only terms appropriate for USA (i.e. culture specific nuances, not American English).
#@{

#+ Music/radio player
#@{

#+ Hint shown if no music files are found. Also shown as tooltip when hovering over music_player button.

	key[]: "music_player_hint"
	val[]: "Posa les teves cançons a la carpeta <color value=@@clr_sel@@>American Truck Simulator/music <color value=@@clr_txt@@>dins de la de <color value=@@clr_sel@@>Documents <color value=@@clr_txt@@>i les veuràs aquí."

#+ Tooltip shown when hovering over the radio_stream button.

	key[]: "radio_hint"
	val[]: "Edita l'arxiu <color value=@@clr_sel@@>live_streams.sii <color value=@@clr_txt@@>a la carpeta <color value=@@clr_sel@@>American Truck Simulator <color value=@@clr_txt@@>a <color value=@@clr_sel@@>Documents <color value=@@clr_txt@@>i escolta les teves emissores de ràdio preferides al joc!"

#+ Hint shown if no online radio streams are defined.

	key[]: "empty_radio_hint"
	val[]: "Si us plau, comprova l'arxiu <color value=@@clr_sel@@>readme.rtf <color value=@@clr_txt@@>a la carpeta <color value=@@clr_sel@@>American Truck Simulator <color value=@@clr_txt@@>a <color value=@@clr_sel@@>Documents <color value=@@clr_txt@@>per afegir la teva pròpia música i emissores de ràdio."
#@}

