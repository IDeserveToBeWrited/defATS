# Configuration of the chassis sounds for the specific truck.
# If you need override any sound you need add string "sound_name|sound_id" to the 'sounds' array.
#
# The 'sound_id' parameter must be one of:
# "" (empty string) or ("-") means 'none' sound
# "[filename].soundref" configuration file of the sound
# "[bank filename]#[event name]" id of the sound
#

sounds:1

sounds[]: "noise_suspension|/sound/truck/car/noise_suspension_car.soundref"
