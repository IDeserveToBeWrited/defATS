# Configuration of the interior sounds for the specific truck interior.
# If you need override any sound of the interior you need add string "sound_name|sound_id" to the 'sounds' array.
#
# The 'sound_id' parameter must be one of:
# "" (empty string) or ("-") means 'none' sound
# "[filename].soundref" configuration file of the sound
# "[bank filename]#[event name]" id of the sound 
#
	sounds:16

	sounds[]: "blinker_off|/def/vehicle/car/ford.mustang_67/interior/sound_blinker_off.soundref"
	sounds[]: "blinker_on|/def/vehicle/car/ford.mustang_67/interior/sound_blinker_on.soundref"
	sounds[]: "noise|/def/vehicle/car/ford.mustang_67/interior/interior_noise.soundref"
	sounds[]: "stick_blinker|/def/vehicle/car/ford.mustang_67/interior/sound_stick_blinker.soundref"
	sounds[]: "stick_blinker_off|/def/vehicle/car/ford.mustang_67/interior/sound_stick_blinker_off.soundref"
	sounds[]: "stick_hazard_warning|/sound/truck/default/interior_stick_hazard_warning.soundref"
	sounds[]: "stick_high_beam|/sound/truck/default/interior_stick_high_beam.soundref"
	sounds[]: "stick_light_horn|/sound/truck/default/interior_stick_light_horn.soundref"
	sounds[]: "stick_lights|/sound/truck/default/interior_stick_lights.soundref"
	sounds[]: "stick_park_brake|/def/vehicle/car/ford.mustang_67/interior/sound_stick_park_brake.soundref"
	sounds[]: "stick_park_brake_off|/def/vehicle/car/ford.mustang_67/interior/sound_stick_park_brake_off.soundref"
	sounds[]: "stick_wipers|/sound/truck/default/interior_stick_wipers.soundref"
	sounds[]: "window_click|/def/vehicle/car/ford.mustang_67/interior/interior_window_click.soundref"
	sounds[]: "window_move|/def/vehicle/car/ford.mustang_67/interior/interior_window_move.soundref"
	sounds[]: "wipers_down|/sound/truck/car/interior_wipers_car_oldtimer_down.soundref"
	sounds[]: "wipers_up|/sound/truck/car/interior_wipers_car_oldtimer_up.soundref"

