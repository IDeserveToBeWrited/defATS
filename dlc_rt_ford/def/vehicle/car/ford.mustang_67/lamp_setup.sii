SiiNunit
{
vehicle_lamp_setup  : .lamp_setup {

	# Red Green Blue (linear color space)
	# Use 'Sgfx presets' tool to grab them.
	#
	# See http://wiki.scs/cgi-bin/twiki/view/EuroTrucks2/LampEffect#Vehicle_Lamps
	color_front_positional: (7.1, 4.9, 0.0)			# 0. front positional
	color_rear_positional: (4.0, 0.1, 0.004)		# 1. rear positional
	color_side_positional: (4.0, 4.0, 4.0)			# 2. side positional
	color_low_beam: (34.0, 27.5, 13.4)				# 3. low beam
	color_high_beam: (87.0, 70.4, 34.3)				# 4. high beam
	color_front_turn_signal: (26.05, 14.15, 0.0)	# 5. front turn signal
	color_rear_turn_signal: (32.0, 0.30, 0.02)		# 6. rear turn signal
	color_brake: (35.0, 0.35, 0.025)				# 7. brake
	color_reverse: (11.0, 11.0, 11.0)				# 8. reverse
	color_daytime_running: (34.0, 27.5, 13.4)		# 9. daytime running


	wire_composites[0]: .comp_fl
	wire_composites[1]: .comp_fr
	wire_composites[2]: .comp_rl
	wire_composites[3]: .comp_rr
	wire_composites[4]: .comp_ml
	wire_composites[5]: .comp_mr
}

vehicle_lamp_wire_composite : .comp_fl {
	channel_r_wire: front_left_turn_signal
	channel_g_wire: high_beam
	channel_b_wire: low_beam
	channel_a_wire: front_positional
}

vehicle_lamp_wire_composite : .comp_fr {
	channel_r_wire: front_right_turn_signal
	channel_g_wire: high_beam
	channel_b_wire: low_beam
	channel_a_wire: front_positional
}

vehicle_lamp_wire_composite : .comp_rl {
	channel_r_wire: rear_left_turn_signal
	channel_g_wire: brake
	channel_b_wire: reverse
	channel_a_wire: rear_positional
}

vehicle_lamp_wire_composite : .comp_rr {
	channel_r_wire: rear_right_turn_signal
	channel_g_wire: brake
	channel_b_wire: reverse
	channel_a_wire: rear_positional
}

vehicle_lamp_wire_composite : .comp_ml {
	channel_r_wire: front_left_turn_signal
	channel_g_wire: none
	channel_b_wire: daytime_running
	channel_a_wire: side_positional
}

vehicle_lamp_wire_composite : .comp_mr {
	channel_r_wire: front_right_turn_signal
	channel_g_wire: none
	channel_b_wire: daytime_running
	channel_a_wire: side_positional
}

}